mod tile_merge_case
use tensor

fn checksum(x: tensor<i32, [24]>) -> i32 {
  var sum = i32(0)
  var count = i32(0)
  for batch in 1..3, row in 2..5, column in 4..8 {
    let offset = (batch - 1) * 12 + (row - 2) * 4 + (column - 4)
    if (batch + row + column) % 2 == 0 {
      sum += x[offset]
      count += i32(1)
    }
  }
  return sum + count
}

fn dynamic(n: index) -> i32 {
  var count = i32(0)
  for i in 0..n, j in 0..2 {
    count += i32(1)
  }
  return count
}
