mod range_c
use tensor
use nn

// Four uses retain a shared helper; each call must keep its own argument bound.
fn cap10(x: tensor<i32, []>) -> tensor<i32, []> {
  return nn.minimum(x, tensor<i32, []>(i32(10)))
}
fn cap20(x: tensor<i32, []>) -> tensor<i32, []> {
  return nn.minimum(x, tensor<i32, []>(i32(20)))
}
fn cap30(x: tensor<i32, []>) -> tensor<i32, []> {
  return nn.minimum(x, tensor<i32, []>(i32(30)))
}

fn capped(x: tensor<i32, []>) -> tensor<i32, [_]> {
  let cap: tensor<i32, []> = hex"64000000"
  let stop = nn.minimum(cap, x)
  return tensor.range(tensor<i32, []>(i32(0)), stop, tensor<i32, []>(i32(1)))
}

fn descending(x: tensor<i32, []>) -> tensor<i32, [_]> {
  let cap: tensor<i32, []> = hex"9cffffff"
  let stop = nn.maximum(x, cap)
  return tensor.range(tensor<i32, []>(i32(0)), stop, tensor<i32, []>(i32(-1)))
}

fn main() -> tensor<i32, [_]> {
  let start = tensor<i32, []>(i32(9))
  let stop = tensor<i32, []>(i32(-2))
  let step = tensor<i32, []>(i32(-3))
  let out: tensor<i32, [_]> = tensor.range<4>(start, stop, step)
  return out
}

fn fractional() -> tensor<f32, [_]> {
  let start = tensor<f32, []>(f32(0.5))
  let stop = tensor<f32, []>(f32(2.0))
  let step = tensor<f32, []>(f32(0.6))
  let out: tensor<f32, [_]> = tensor.range<3>(start, stop, step)
  return out
}

fn bounded(choose: bool) -> tensor<i32, [_]> {
  var end = i32(2)
  if choose { end = i32(7) }
  let start = tensor<i32, []>(i32(0))
  let stop = tensor<i32, []>(end)
  let step = tensor<i32, []>(i32(2))
  let out: tensor<i32, [_]> = tensor.range(start, stop, step)
  return out
}
