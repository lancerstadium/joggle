mod dynamic_slice_c
use tensor
use onnx

fn main(
  x: tensor<i32, [4, 5]>,
  starts: tensor<i64, [2]>, ends: tensor<i64, [2]>,
  axes: tensor<i64, [2]>, steps: tensor<i64, [2]>
) -> tensor<i32, [_, _]> {
  return tensor.slice(x, starts, ends, axes, steps)
}

fn reverse(x: tensor<i32, [4, 5]>) -> tensor<i32, [4, 3]> {
  return tensor.slice(x, [9223372036854775807, -1], [-2, -1], [-1, -2])
}

// Constant controls do not make the input's logical row count static.
fn prefix(x: tensor<i32, [4, 5]>, rows: index) -> tensor<i32, [_, 2]> {
  var shape = tensor<index, [2]>(index(5))
  shape[0] = rows
  let data: tensor<i32, [_, 5]> = tensor.view(x, shape)
  let starts: tensor<i64, [2]> = onnx.tensor(7, [2], hex"00000000000000000100000000000000")
  let ends: tensor<i64, [2]> = onnx.tensor(7, [2], hex"ffffffffffffff7fffffffffffffff7f")
  let axes: tensor<i64, [2]> = onnx.tensor(7, [2], hex"00000000000000000100000000000000")
  let steps: tensor<i64, [2]> = onnx.tensor(7, [2], hex"01000000000000000200000000000000")
  let result: tensor<i32, [_, 2]> = onnx.Slice(data, starts, ends, axes, steps)
  return result
}
