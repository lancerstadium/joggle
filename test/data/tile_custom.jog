module tile.custom
use base

fn + (left: index, right: index) -> index {
  return left - right
}

fn buf<N: int>() -> Ty;
fn []<N: int>(x: buf<N>, i: index) -> i32;
fn []=<N: int>(x: buf<N>, i: index, value: i32) -> buf<N>;

fn work() -> int {
  var total = 0
  for i in 0..4 {
    let location = i + index(1)
    total += int(location)
  }
  return total
}

fn access(x: buf<4>) -> buf<4> {
  var out = x
  for i in 0..4 {
    out[i] = x[i] + i32(1)
  }
  return out
}
