module bounds.resolved
use base
use tensor

fn dimension(x: tensor<f32, [2, 3, 4]>) -> index {
  return tensor.dim(x, index(1))
}

fn mixed() -> int {
  var total = 0
  for i in 2..6 {
    let j = i * 4 - 1
    if j < 10 {
      total += j
    }
  }
  return total
}

fn guarded() -> int {
  var total = 0
  for i in 2..6 {
    if i >= 2 && i < 6 && i != 9 && i <= 5 && i > 1 {
      total += i
    } else {
      total += 100
    }
  }
  return total
}

fn excluded() -> int {
  var rejected = 0
  for i in 2..6 {
    if i == 9 || i < 0 {
      rejected += 100
    } else {
      rejected += i
    }
  }
  return rejected
}
