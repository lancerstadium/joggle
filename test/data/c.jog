module kernel
use math
use nn
use tensor

fn twice(x: f32) -> f32 {
  return x + x
}

[c: {name: "affine_kernel"}]
fn affine(x: f32) -> f32 {
  let doubled = twice(x)
  return doubled + f32(1)
}

fn direct(x: f32) -> f32 {
  return twice(x)
}

fn relu(x: f32) -> f32 {
  if x < f32(0) {
    return f32(0)
  }
  return x
}

fn logical(a: i64, b: i64) -> bool {
  return a > i64(0) && (b > i64(0) || a == b)
}

fn root(x: f32) -> f32 {
  return math.sqrt(x) + f32(1)
}

fn unary_math(x: f64) -> f64 {
  return math.abs(x) + math.floor(x) + math.log(x) + math.erf(x) +
         math.exp(x) + math.ceil(x) + math.tanh(x) + math.round_even(x)
}

fn power(x: f64, y: f64) -> f64 {
  return math.pow(x, y)
}

fn nearest(x: f64) -> f64 {
  return math.round_even(x)
}

fn split(x: i64) -> (i64, i64) {
  return x / i64(2), x % i64(2)
}

fn recombine(x: i64) -> i64 {
  let quotient, remainder = split(x)
  return quotient * i64(2) + remainder
}

fn duplicate(
  x: tensor<f32, [2]>
) -> (tensor<f32, [2]>, f32) {
  let first = x[0]
  return x, first
}

fn duplicate_sum(x: tensor<f32, [2]>) -> f32 {
  let copy, first = duplicate(x)
  return copy[1] + first
}

local fn relay(x: tensor<f32, [2]>) -> tensor<f32, [2]> {
  return x
}

fn nested_tensor(x: tensor<f32, [2]>) -> tensor<f32, [2]> {
  let first = relay(x)
  return relay(first)
}

local fn noop() -> () {
  return
}

fn call_noop() -> i64 {
  noop()
  return i64(1)
}

fn abi_probe(i: index, n: int, x: i32) -> i64 {
  return i64(i) + i64(n) + i64(x)
}

fn steps() -> i64 {
  var count: i64 = i64(0)
  for i in 0..3 {
    count += i64(1)
  }
  return count
}

fn select() -> i64 {
  var value: i64 = i64(1)
  for i in 0..4 {
    if i >= 2 {
      value = i64(7)
    }
  }
  return value
}

fn captured_steps() -> i64 {
  let values = [1, 2, 3]
  var sum: i64 = i64(0)
  for i in 0..3 {
    sum += i64(values[i])
  }
  return sum
}

fn assign_literal() -> bool {
  var value = false
  value = true
  return value
}

fn byte_weights() -> tensor<i8, [3]> {
  let values: tensor<i8, [3]> = hex"ff007f"
  return values
}

fn weights() -> tensor<f32, [2]> {
  let values: tensor<f32, [2]> = hex"0000803f00000040"
  return values
}

fn forwarded_weight() -> f32 {
  let values = weights()
  return values[1]
}

fn data_weights() -> i64 {
  return i64(0)
}

fn int_add(
  a: tensor<i64, [2, 3]>,
  b: tensor<i64, [2, 3]>
) -> tensor<i64, [2, 3]> {
  var out = tensor<i64, [2, 3]>(i64(0))
  for i in 0..2, j in 0..3 {
    out[i, j] = a[i, j] + b[i, j]
  }
  return out
}

fn int_matmul(
  a: tensor<i64, [2, 3]>,
  b: tensor<i64, [3, 2]>
) -> tensor<i64, [2, 2]> {
  var out = tensor<i64, [2, 2]>(i64(0))
  for i in 0..2, j in 0..2 {
    var sum: i64 = i64(0)
    for k in 0..3 {
      sum += a[i, k] * b[k, j]
    }
    out[i, j] = sum
  }
  return out
}

fn transpose(
  x: tensor<i64, [2, 3]>
) -> tensor<i64, [3, 2]> {
  return tensor.permute(x, [1, 0])
}

fn broadcast_scalar(
  x: tensor<f32, []>
) -> tensor<f32, [2, 3]> {
  return tensor.broadcast(x)
}

fn broadcast_identity(
  x: tensor<f32, [2, 3]>
) -> tensor<f32, [2, 3]> {
  return tensor.broadcast(x)
}

fn extrema(
  left: tensor<f32, [2, 1]>,
  right: tensor<f32, [1, 3]>
) -> (tensor<f32, [2, 3]>, tensor<f32, [2, 3]>) {
  let high: tensor<f32, [2, 3]> = nn.maximum(left, right)
  let low: tensor<f32, [2, 3]> = nn.minimum(left, right)
  return high, low
}

fn list_branch(dim: int) -> bool {
  var selected = false
  for axis in [2] {
    if axis == dim {
      selected = true
    }
  }
  return selected
}

fn matmul(
  a: tensor<f32, [2, 3]>,
  b: tensor<f32, [3, 2]>
) -> tensor<f32, [2, 2]> {
  var out = tensor<f32, [2, 2]>(f32(0))
  for i in 0..2, j in 0..2 {
    var sum: f32 = f32(0)
    for k in 0..3 {
      sum += a[i, k] * b[k, j]
    }
    out[i, j] = sum
  }
  return out
}
