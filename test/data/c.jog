module kernel
use math
use tensor

fn twice(x: f32) -> f32 {
  return x + x
}

fn affine(x: f32) -> f32 {
  let doubled = twice(x)
  return doubled + f32(1)
}

fn direct(x: f32) -> f32 {
  return twice(x)
}

fn relu(x: f32) -> f32 {
  if x < f32(0) {
    return f32(0)
  }
  return x
}

fn logical(a: i64, b: i64) -> bool {
  return a > i64(0) && (b > i64(0) || a == b)
}

fn root(x: f32) -> f32 {
  return math.sqrt(x) + f32(1)
}

fn unary_math(x: f64) -> f64 {
  return math.exp(x) + math.ceil(x) + math.tanh(x) + math.round_even(x)
}

fn power(x: f64, y: f64) -> f64 {
  return math.pow(x, y)
}

fn steps() -> i64 {
  var count: i64 = i64(0)
  for i in 0..3 {
    count += i64(1)
  }
  return count
}

fn select() -> i64 {
  var value: i64 = i64(1)
  for i in 0..4 {
    if i >= 2 {
      value = i64(7)
    }
  }
  return value
}

fn weights() -> tensor<f32, [2]> {
  let values: tensor<f32, [2]> = tensor.literal(hex"0000803f00000040")
  return values
}

fn int_add(
  a: tensor<i64, [2, 3]>,
  b: tensor<i64, [2, 3]>
) -> tensor<i64, [2, 3]> {
  var out = tensor<i64, [2, 3]>(i64(0))
  for i in 0..2, j in 0..3 {
    out[i, j] = a[i, j] + b[i, j]
  }
  return out
}

fn int_matmul(
  a: tensor<i64, [2, 3]>,
  b: tensor<i64, [3, 2]>
) -> tensor<i64, [2, 2]> {
  var out = tensor<i64, [2, 2]>(i64(0))
  for i in 0..2, j in 0..2 {
    var sum: i64 = i64(0)
    for k in 0..3 {
      sum += a[i, k] * b[k, j]
    }
    out[i, j] = sum
  }
  return out
}

fn matmul(
  a: tensor<f32, [2, 3]>,
  b: tensor<f32, [3, 2]>
) -> tensor<f32, [2, 2]> {
  var out = tensor<f32, [2, 2]>(f32(0))
  for i in 0..2, j in 0..2 {
    var sum: f32 = f32(0)
    for k in 0..3 {
      sum += a[i, k] * b[k, j]
    }
    out[i, j] = sum
  }
  return out
}
