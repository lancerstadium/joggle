module open
use base
use nn
use tensor

local fn offset(x: i64) -> i64 {
  return x + i64(7)
}

[entry]
fn carry(seed: i64) -> i64 {
  var value: i64 = base.copy(seed)
  for i in 0..2 {
    if i >= 1 {
      value = offset(seed)
    }
  }
  return value
}

[entry]
fn add(
  a: tensor<f32, [4]>,
  b: tensor<f32, [4]>
) -> tensor<f32, [4]> {
  return a + b
}

[entry]
fn sigmoid(
  x: tensor<f32, [4]>
) -> tensor<f32, [4]> {
  return nn.sigmoid(x)
}
