module tiled

fn sum(n: int) -> int {
  var total = 0
  for i in 0..n {
    total += i
  }
  return total
}

fn grid(rows: int, cols: int) -> int {
  var total = 0
  for row in 0..rows, column in 2..cols {
    if column < cols - 1 {
      total += row * 100 + column
    }
  }
  return total
}

fn fixed_grid() -> int {
  var total = 0
  for row in 0..2, column in 2..6 {
    total = total * 10 + row * 4 + column - 1
  }
  return total
}
