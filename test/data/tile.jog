module tiled

fn sum(n: int) -> int {
  var total = 0
  for i in 0..n {
    total += i
  }
  return total
}

fn grid(rows: int, cols: int) -> int {
  var total = 0
  for row in 0..rows, column in 2..cols {
    let inside = column < cols - 1
    let product = row * column
    let coordinate = row * 100 + column
    if inside || product < 0 {
      total += coordinate
    }
  }
  return total
}

fn fixed_grid() -> int {
  var total = 0
  for row in 0..2, column in 2..6 {
    total = total * 10 + row * 4 + column - 1
  }
  return total
}
