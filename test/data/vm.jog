module vm_case
use base
use math

fn main(x: i64, y: i64, flag: bool) -> i64 {
  var value = x + y
  if flag {
    value *= 2
  } else {
    value -= 1
  }
  return value
}

fn shift(x: i64, amount: i64) -> i64 {
  return x >> amount
}

fn divide(x: i64, y: i64) -> i64 {
  return x / y
}

fn convert(x: f32) -> f64 {
  let value: f64 = f64(x)
  return value + 0.25
}

fn truncate(x: f64) -> i64 {
  let value: i64 = i64(x)
  return value
}

fn truth() -> bool {
  return true
}

fn root(x: f32) -> f32 {
  return math.sqrt(x)
}

fn unary_math(x: f64) -> f64 {
  return math.abs(x) + math.floor(x) + math.log(x) + math.erf(x) +
         math.exp(x) + math.ceil(x) + math.tanh(x) + math.round_even(x)
}

fn power(x: f64, y: f64) -> f64 {
  return math.pow(x, y)
}

fn nearest(x: f64) -> f64 {
  return math.round_even(x)
}

fn pick(at: index) -> int {
  let values = [3, 5, 8]
  return values[at]
}
