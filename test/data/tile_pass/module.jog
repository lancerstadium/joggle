module tile_pass
use tile

fn first(m: Mod, factor: int) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      return tile.split(m, op, factor)
    }
  }
  return false
}

fn named(m: Mod, name: str, factor: int) -> bool {
  let selected = ir.find(m, name)
  assert(ir.live(selected), "tile_pass.named could not find the function")
  for op in ir.ops(selected) {
    if ir.kind(op) == "loop" {
      return tile.split(m, op, factor)
    }
  }
  return false
}

fn fuse_first(m: Mod) -> bool {
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "tile_pass.fuse_first requires two loops")
  return tile.fuse(m, loops[0], loops[1])
}

fn can_first(m: Mod) -> bool {
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "tile_pass.can_first requires two loops")
  let before = ir.revision(m)
  let result = tile.can_fuse(m, loops[0], loops[1])
  assert(ir.revision(m) == before,
         "tile.can_fuse changed the module")
  return result
}

fn all(m: Mod) -> bool {
  return tile.fuse(m)
}

fn allow_pair(m: Mod, pair: list<Op>) -> bool {
  return len(pair) == 2
}

fn permitted(m: Mod) -> bool {
  return tile.fuse(m, ir.find("tile_pass.allow_pair"))
}

fn mutating_policy(m: Mod, pair: list<Op>) -> bool {
  return ir.set(m, pair[0], "policy.mutated", true)
}

fn reject_mutating_policy(m: Mod) -> bool {
  return tile.fuse(m, ir.find("tile_pass.mutating_policy"))
}
