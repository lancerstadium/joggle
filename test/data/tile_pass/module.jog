mod tile_pass
use base
use ir
use tile

fn check_axes(m: Mod) -> bool {
  let before = ir.revision(m)
  let function = ir.find(m, "grid")
  assert(ir.live(function), "axis check requires grid")
  var loops: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) == 1, "axis check requires one loop")
  let loop = loops[0]
  assert(len(tile.state_axes(m, loop)) == 0 &&
         len(tile.reduction_axes(m, loop)) == 0,
         "unsupported loop reported reorder roles")
  let body = ir.blks(loop)[0]
  let body_args = ir.args(body)
  assert(len(body_args) == 3, "axis check found an invalid loop body")

  let row_axes = tile.axes(loop, body_args[0])
  let column_axes = tile.axes(loop, body_args[1])
  assert(len(row_axes) == 1 && row_axes[0] == 0 &&
         len(column_axes) == 1 && column_axes[0] == 1,
         "loop arguments have the wrong axes")

  var inside_found = false
  var coordinate_found = false
  var product_found = false
  for value in ir.vals(function) {
    if ir.name(value) == "inside" {
      let axes = tile.axes(loop, value)
      assert(len(axes) == 1 && axes[0] == 1 &&
             !tile.depends(value, body_args[0]) &&
             tile.depends(value, body_args[1]),
             "condition has the wrong axis dependence")
      assert(len(tile.affine(m, loop, value)) == 0,
             "condition was incorrectly accepted as affine")
      inside_found = true
    }
    if ir.name(value) == "coordinate" {
      let axes = tile.axes(loop, value)
      assert(len(axes) == 2 && axes[0] == 0 && axes[1] == 1 &&
             tile.depends(value, body_args[0]) &&
             tile.depends(value, body_args[1]),
             "coordinate has the wrong axis dependence")
      assert(tile.affine(m, loop, value) == [0, 100, 1],
             "coordinate has the wrong affine form")
      coordinate_found = true
    }
    if ir.name(value) == "product" {
      let axes = tile.axes(loop, value)
      assert(len(axes) == 2 && axes[0] == 0 && axes[1] == 1 &&
             len(tile.affine(m, loop, value)) == 0,
             "nonlinear product was accepted as affine")
      product_found = true
    }
  }
  assert(inside_found && coordinate_found && product_found,
         "axis check could not find the named values")
  let body_ops = ir.ops(body)
  let yielded = ir.args(body_ops[len(body_ops) - 1])
  assert(len(yielded) == 1, "axis check found an invalid loop yield")
  let carried_axes = tile.axes(loop, yielded[0])
  assert(len(carried_axes) == 2 && carried_axes[0] == 0 &&
         carried_axes[1] == 1,
         "nested branch result has the wrong axis dependence")

  let quotient = ir.find(m, "fixed_grid")
  assert(ir.live(quotient), "axis check requires fixed_grid")
  var quotient_loops: list<Op> = []
  var quotient_coordinates: list<Val> = []
  var varying_quotients: list<Val> = []
  for op in ir.ops(quotient) {
    if ir.kind(op) == "loop" {
      quotient_loops += [op]
    }
    for value in ir.outs(op) {
      if ir.name(value) == "quotient" {
        quotient_coordinates += [value]
      }
      if ir.name(value) == "varying_quotient" {
        varying_quotients += [value]
      }
    }
  }
  assert(len(quotient_loops) == 1 && len(quotient_coordinates) == 1,
         "axis check requires the range-proven quotient")
  assert(tile.affine(m, quotient_loops[0], quotient_coordinates[0]) ==
           [0, 0, 1],
         "range-proven quotient has the wrong affine form")
  assert(len(varying_quotients) == 1 &&
         len(tile.affine(m, quotient_loops[0], varying_quotients[0])) == 0,
         "varying integer quotient was incorrectly accepted as affine")
  assert(ir.revision(m) == before,
         "axis dependence queries changed the module")
  return true
}

fn check_forms(m: Mod) -> bool {
  let before = ir.revision(m)
  let function = ir.find(m, "stencil")
  assert(ir.live(function), "form check requires stencil")
  var loops: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) == 1, "form check requires one loop")
  let loop = loops[0]
  let params = ir.params(function)
  let body_args = ir.args(ir.blks(loop)[0])
  assert(len(params) == 1 && len(body_args) == 3,
         "form check found an invalid signature")
  assert(tile.read_forms(m, loop, params[0]) == [[0, 3, 1]],
         "form check found the wrong row-major read address")
  assert(tile.write_forms(m, loop, body_args[2]) == [[0, 3, 1]],
         "form check found the wrong row-major write address")
  assert(tile.read_forms(m, loop) == [[0, 3, 1]] &&
         tile.write_forms(m, loop) == [[0, 3, 1]],
         "whole-loop form check found the wrong stencil accesses")

  let nonlinear = ir.find(m, "nonlinear")
  assert(ir.live(nonlinear), "form check requires nonlinear")
  var nonlinear_loops: list<Op> = []
  for op in ir.ops(nonlinear) {
    if ir.kind(op) == "loop" {
      nonlinear_loops += [op]
    }
  }
  let nonlinear_params = ir.params(nonlinear)
  assert(len(nonlinear_loops) == 1 && len(nonlinear_params) == 1 &&
         tile.read_forms(m, nonlinear_loops[0], nonlinear_params[0]) == [[]],
         "form check did not preserve an unproved access")
  assert(tile.read_forms(m, nonlinear_loops[0]) == [[]],
         "whole-loop form check did not preserve an unproved access")

  let pair = ir.find(m, "pair")
  assert(ir.live(pair), "form check requires pair")
  var pair_loops: list<Op> = []
  for op in ir.ops(pair) {
    if ir.kind(op) == "loop" {
      pair_loops += [op]
    }
  }
  assert(len(pair_loops) == 1 &&
         tile.read_forms(m, pair_loops[0]) ==
           [[0, 3, 1], [0, 3, 1]] &&
         tile.write_forms(m, pair_loops[0]) == [[0, 3, 1]],
         "whole-loop form check lost or reordered an access")
  assert(ir.revision(m) == before,
         "access-form queries changed the module")
  return true
}

fn check_custom_affine(m: Mod) -> bool {
  let function = ir.find(m, "work")
  assert(ir.live(function), "custom affine check requires work")
  var loops: list<Op> = []
  var locations: list<Val> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
    for value in ir.outs(op) {
      if ir.name(value) == "location" {
        locations += [value]
      }
    }
  }
  assert(len(loops) == 1 && len(locations) == 1,
         "custom affine check requires its loop and location")
  assert(len(tile.affine(m, loops[0], locations[0])) == 0,
         "custom addition inherited base affine semantics")

  let access = ir.find(m, "access")
  assert(ir.live(access), "custom access check requires access")
  var access_loops: list<Op> = []
  for op in ir.ops(access) {
    if ir.kind(op) == "loop" {
      access_loops += [op]
    }
  }
  assert(len(access_loops) == 1,
         "custom access check requires one loop")
  let access_loop = access_loops[0]
  let params = ir.params(access)
  let body_args = ir.args(ir.blks(access_loop)[0])
  assert(len(params) == 1 && len(body_args) == 2,
         "custom access check found an invalid signature")
  assert(len(tile.reads(m, access_loop, params[0])) == 1 &&
         len(tile.writes(m, access_loop, body_args[1])) == 1,
         "custom indexing did not retain access semantics")
  assert(tile.can_split(m, access_loop, 2),
         "custom-container loop could not be split")
  let split = tile.split(m, access_loop, 2)
  assert(ir.live(split), "custom-container loop could not be split")
  for op in ir.ops(ir.blks(split)[0]) {
    assert(ir.kind(op) != "branch",
           "exact split retained an unnecessary tail guard")
  }
  var exact_adds = 0
  var custom_adds = 0
  for op in ir.ops(access) {
    if ir.kind(op) == "call" && ir.callee(op) == "base.operator +" {
      assert(ir.target(m, op) == "base.operator +",
             "split lost its exact base addition target")
      exact_adds += 1
    }
    if ir.kind(op) == "call" && ir.callee(op) == "operator +" {
      assert(ir.target(m, op) == "tile.custom.operator +",
             "split rebound the user's addition")
      custom_adds += 1
    }
  }
  assert(exact_adds > 0 && custom_adds > 0,
         "split did not preserve distinct operator implementations")
  return true
}

local fn expect_axes(loop: Op, value: Val, expected: list<int>) -> bool {
  let actual = tile.axes(loop, value)
  if len(actual) != len(expected) {
    return false
  }
  for i in 0..len(actual) {
    if actual[i] != expected[i] {
      return false
    }
  }
  return true
}

fn check_reorder(m: Mod) -> bool {
  let function = ir.find(m, "main")
  assert(ir.live(function), "reorder check requires main")
  var loops: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" &&
       len(ir.args(op)) - len(ir.outs(op)) == 7 {
      loops += [op]
    }
  }
  assert(len(loops) == 1, "reorder check requires one seven-axis loop")
  let loop = loops[0]
  let before = ir.revision(m)
  assert(tile.extents(m, loop) == [1, 1, 2, 2, 1, 2, 2],
         "reorder found the wrong static loop extents")
  assert(tile.state_axes(m, loop) == [0, 1, 2, 3] &&
         tile.reduction_axes(m, loop) == [4, 5, 6],
         "reorder classified the wrong axis roles")
  assert(len(tile.reorderable(m, [0, 1, 4, 5, 6, 2, 3])) == 2,
         "reorderable returned the wrong candidate set")
  assert(tile.can_reorder(m, loop, [0, 1, 4, 5, 6, 2, 3]),
         "legal reduction-preserving order was rejected")
  assert(tile.reorder_issue(m, loop, [0, 1, 5, 4, 6, 2, 3]) ==
           "must preserve the relative order of reduction axes",
         "reordered reduction axes reported the wrong issue")
  assert(tile.reorder_issue(m, loop, [0, 1, 4, 5, 6, 2, 2]) ==
           "contains a duplicate axis",
         "duplicate order reported the wrong issue")
  assert(tile.reorder(m, loop, [0, 1, 2, 3, 4, 5, 6]) == loop,
         "identity reorder did not preserve the loop")

  let reduce = ir.find(m, "reduce5")
  assert(ir.live(reduce), "reorder check requires reduce5")
  var reductions: list<Op> = []
  for op in ir.ops(reduce) {
    if ir.kind(op) == "loop" {
      reductions += [op]
    }
  }
  assert(len(reductions) == 1,
         "reorder check requires one five-axis reduction")
  let reduction = reductions[0]
  assert(tile.state_axes(m, reduction) == [0, 1, 2, 3] &&
         tile.reduction_axes(m, reduction) == [4] &&
         tile.can_reorder(m, reduction, [0, 1, 4, 2, 3]),
         "five-axis reduction has the wrong roles or legality")
  assert(ir.revision(m) == before,
         "reorder queries or identity changed the module")
  return true
}

fn check_multidimensional_reorder(m: Mod) -> bool {
  let function = ir.find(m, "contraction")
  assert(ir.live(function),
         "multidimensional reorder check requires contraction")
  var loops: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) == 1,
         "multidimensional reorder check requires one loop")
  let loop = loops[0]
  let before = ir.revision(m)
  assert(tile.state_axes(m, loop) == [0, 1] &&
         tile.reduction_axes(m, loop) == [2],
         "multidimensional state address produced the wrong axis roles")
  assert(tile.can_reorder(m, loop, [0, 2, 1]),
         "multidimensional state address rejected a legal reorder")
  assert(ir.revision(m) == before,
         "multidimensional reorder queries changed the module")
  let reordered = tile.reorder(m, loop, [0, 2, 1])
  let arguments = ir.args(ir.blks(reordered)[0])
  assert(len(arguments) == 4 &&
         ir.name(arguments[0]) == "row" &&
         ir.name(arguments[1]) == "depth" &&
         ir.name(arguments[2]) == "column",
         "multidimensional reorder produced the wrong axis order")
  assert(tile.scalar_cost(m, reordered, 3) > 0,
         "multidimensional state could not be scalarized")
  let scalarized = tile.scalarize(m, reordered, 3)
  assert(ir.live(scalarized),
         "multidimensional scalarization did not produce a loop")
  return true
}

fn check_scalarize(m: Mod) -> bool {
  let before = ir.revision(m)
  let main = ir.find(m, "main")
  let reduce = ir.find(m, "reduce5")
  assert(ir.live(main) && ir.live(reduce),
         "scalarize check requires main and reduce5")
  for fn in [main, reduce] {
    var found = false
    for op in ir.ops(fn) {
      if ir.kind(op) == "loop" &&
         len(ir.args(op)) - len(ir.outs(op)) > 1 {
        let issue = tile.scalarize_issue(m, op)
        assert(issue == "", ir.name(fn) + ": " + issue)
        assert(tile.scalar_cost(m, op) > 0,
               "scalarize cost omitted a legal loop")
        found = true
      }
    }
    assert(found, "scalarize check requires a reduction loop")
  }
  assert(ir.revision(m) == before,
         "scalarize cost changed the module")
  return true
}

local fn scalarized_loop(
  m: Mod, function: Fn, outer_axes: int, inner_axes: int
) -> bool {
  var outers: list<Op> = []
  var inners: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      let axes = len(ir.args(op)) - len(ir.outs(op))
      if axes == outer_axes && len(outers) == 0 {
        outers += [op]
      } else {
        if axes == inner_axes && len(inners) == 0 {
          inners += [op]
        }
      }
    }
  }
  if len(outers) != 1 || len(inners) != 1 ||
     ir.blk(inners[0]) != ir.blks(outers[0])[0] {
    return false
  }
  let outer = outers[0]
  let inner = inners[0]
  let outer_args = ir.args(ir.blks(outer)[0])
  let inner_args = ir.args(ir.blks(inner)[0])
  if len(outer_args) != outer_axes + 1 ||
     len(inner_args) != inner_axes + 1 ||
     ir.type(inner_args[inner_axes]) != ty("f32") {
    return false
  }
  let reads = tile.reads(m, outer, outer_args[outer_axes])
  let writes = tile.writes(m, outer, outer_args[outer_axes])
  return len(reads) == 1 && len(writes) == 1
}

fn check_scalarized(m: Mod) -> bool {
  let before = ir.revision(m)
  assert(len(tile.scalarizable(m)) == 0,
         "scalarized module still contains a promotable reduction")
  let main = ir.find(m, "main")
  let reduce = ir.find(m, "reduce5")
  assert(ir.live(main) && ir.live(reduce),
         "scalarized check requires main and reduce5")
  assert(scalarized_loop(m, main, 4, 3),
         "convolution did not become a scalar reduction nest")
  assert(scalarized_loop(m, reduce, 4, 1),
         "generic reduction did not become a scalar reduction nest")
  assert(ir.revision(m) == before,
         "scalarized checks changed the module")
  return true
}

fn check_spatial_scalarize(m: Mod, budget: int) -> bool {
  let before = ir.revision(m)
  let main = ir.find(m, "main")
  assert(ir.live(main), "spatial scalarize check requires main")
  var selected: list<Op> = []
  for op in ir.ops(main) {
    if ir.kind(op) == "loop" &&
       len(ir.args(op)) - len(ir.outs(op)) == 7 {
      selected += [op]
    }
  }
  assert(len(selected) == 1,
         "spatial scalarize check requires one seven-axis loop")
  assert(tile.scalarize_issue(m, selected[0], 0) ==
           "requires a positive scalar budget",
         "zero scalar budget reported the wrong issue")
  assert(tile.scalarize_issue(m, selected[0], budget - 1) ==
           "exceeds the scalar budget",
         "small scalar budget reported the wrong issue")
  assert(tile.can_scalarize(m, selected[0], budget) &&
         tile.scalarize_issue(m, selected[0], budget) == "",
         "spatial scalar tile was not accepted")
  let cost = tile.scalar_cost(m, selected[0], budget)
  assert(cost > 0 && cost % budget == 0 &&
         tile.scalar_cost(m, selected[0], budget - 1) == 0,
         "scalar cost disagrees with scalarize legality or lanes")
  assert(ir.revision(m) == before,
         "spatial scalarize queries changed the module")
  return true
}

local fn same_state_address(m: Mod, loop: Op) -> bool {
  let body = ir.blks(loop)[0]
  let args = ir.args(body)
  let reads = tile.reads(m, loop, args[8])
  let writes = tile.writes(m, loop, args[8])
  return len(reads) == 1 && len(writes) == 1 &&
         len(reads[0]) == 1 && len(writes[0]) == 1 &&
         reads[0][0] == writes[0][0] &&
         len(tile.affine(m, loop, reads[0][0])) == 9 &&
         tile.affine(m, loop, reads[0][0]) ==
           tile.affine(m, loop, writes[0][0])
}

fn check_scalarize_tail(m: Mod) -> bool {
  let main = ir.find(m, "main")
  assert(ir.live(main), "scalar tail check requires main")
  var selected: list<Op> = []
  for op in ir.ops(main) {
    if ir.kind(op) == "loop" &&
       len(ir.args(op)) - len(ir.outs(op)) == 7 {
      selected += [op]
    }
  }
  assert(len(selected) == 1,
         "scalar tail check requires one seven-axis loop")
  let source = selected[0]
  let split = tile.split(m, source, 3, 3)
  assert(ir.live(split) && !ir.live(source) &&
         len(ir.args(split)) - len(ir.outs(split)) == 8,
         "scalar tail check could not split the state axis")
  var guarded = false
  for op in ir.ops(ir.blks(split)[0]) {
    if ir.kind(op) == "branch" {
      guarded = true
    }
  }
  assert(guarded, "padded split lost its tail guard")
  assert(same_state_address(m, split),
         "split tail changed the state address")
  assert(tile.reorder_issue(
           m, split, [0, 1, 2, 3, 5, 6, 7, 4]
         ) == "cannot prove that state coordinates have distinct addresses",
         "reorder accepted an aliasing padded state tile")
  return true
}

fn check_peel(m: Mod) -> bool {
  let function = ir.find(m, "reduce5")
  assert(ir.live(function), "peel check requires reduce5")
  var loops: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) == 1, "peel check requires one loop")
  let source = loops[0]
  let before = ir.revision(m)
  assert(tile.peel_issue(m, source, 3, 2) == "" &&
         tile.can_peel(m, source, 3, 2),
         "peel rejected a static non-divisible state axis")
  assert(tile.peel_issue(m, source, 4, 2) ==
           "requires the selected axis and its outer axes to be state axes" &&
         !tile.can_peel(m, source, 4, 2),
         "peel accepted a reduction axis")
  assert(!tile.can_peel(m, source, 3, 1) &&
         !tile.can_peel(m, source, 3, 5) &&
         !tile.can_peel(m, source, 3, 10),
         "peel accepted a no-op factor")
  assert(ir.revision(m) == before,
         "peel legality queries changed the module")

  let parts = tile.peel(m, source, 3, 2)
  assert(len(parts) == 2 && ir.live(parts[0]) && ir.live(parts[1]) &&
         !ir.live(source),
         "peel did not replace the source with prefix and tail loops")
  assert(tile.extents(m, parts[0]) == [2, 3, 4, 4, 6] &&
         tile.extents(m, parts[1]) == [2, 3, 4, 1, 6],
         "peel produced the wrong prefix or tail extent")
  for part in parts {
    for op in ir.ops(ir.blks(part)[0]) {
      assert(ir.kind(op) != "branch",
             "peel introduced a masked tail branch")
    }
  }
  return true
}

fn scalarize_budget(m: Mod, budget: int) -> bool {
  return tile.scalarize(m, budget)
}

fn check_spatial_scalarized(m: Mod, lanes: int) -> bool {
  let before = ir.revision(m)
  let main = ir.find(m, "main")
  assert(ir.live(main), "tiled scalarized check requires main")
  var outer: list<Op> = []
  var inner: list<Op> = []
  for op in ir.ops(main) {
    if ir.kind(op) == "loop" {
      let axes = len(ir.args(op)) - len(ir.outs(op))
      if axes == 3 && len(ir.outs(op)) == 1 {
        outer += [op]
      }
      if axes == 3 && len(ir.outs(op)) == lanes {
        inner += [op]
      }
    }
  }
  assert(len(outer) == 1 && len(inner) == 1 &&
         ir.blk(inner[0]) == ir.blks(outer[0])[0],
         "spatial scalar tile has the wrong loop structure")
  let outer_args = ir.args(ir.blks(outer[0])[0])
  assert(len(outer_args) == 4,
         "spatial scalar tile has the wrong outer state")
  assert(len(tile.reads(m, outer[0], outer_args[3])) == lanes &&
         len(tile.writes(m, outer[0], outer_args[3])) == lanes,
         "spatial scalar tile has the wrong state traffic")
  assert(ir.revision(m) == before,
         "tiled scalarized checks changed the module")
  return true
}

fn check_split_scalarized(m: Mod, outer_axes: int, lanes: int) -> bool {
  let before = ir.revision(m)
  let main = ir.find(m, "main")
  assert(ir.live(main), "split scalarized check requires main")
  var outer: list<Op> = []
  var inner: list<Op> = []
  for op in ir.ops(main) {
    if ir.kind(op) == "loop" {
      let axes = len(ir.args(op)) - len(ir.outs(op))
      if axes == outer_axes && len(ir.outs(op)) == 1 {
        outer += [op]
      }
      if axes == 3 && len(ir.outs(op)) == lanes {
        inner += [op]
      }
    }
  }
  assert(len(outer) == 1 && len(inner) == 1 &&
         ir.blk(inner[0]) == ir.blks(outer[0])[0],
         "split scalar tile has the wrong loop structure")
  assert(ir.revision(m) == before,
         "split scalarized checks changed the module")
  return true
}

fn mutating_reorder_policy(m: Mod, op: Op) -> list<int> {
  ir.set(m, op, "policy.mutated", true)
  return []
}

fn reject_mutating_reorder_policy(m: Mod) -> bool {
  return tile.reorder(
    m, ir.find("tile_pass.mutating_reorder_policy")
  )
}

fn configured_reorder_policy(
  m: Mod, op: Op, enabled: bool
) -> list<int> {
  let state = tile.state_axes(m, op)
  let reduction = tile.reduction_axes(m, op)
  var order: list<int> = []
  if len(state) > 2 && len(reduction) != 0 {
    for i in 0..len(state) - 2 {
      order += [state[i]]
    }
    order += reduction
    for i in len(state) - 2..len(state) {
      order += [state[i]]
    }
  }
  if enabled && len(order) != 0 && tile.can_reorder(m, op, order) {
    return order
  }
  return []
}

fn reorder_configured(m: Mod, enabled: bool) -> bool {
  return tile.reorder(
    m, ir.find("tile_pass.configured_reorder_policy"), enabled
  )
}

fn check_spatial_axes(m: Mod) -> bool {
  let before = ir.revision(m)
  let function = ir.find(m, "main")
  assert(ir.live(function), "spatial axis check requires main")
  var loops: list<Op> = []
  for op in ir.ops(function) {
    if ir.kind(op) == "loop" {
      let inputs = ir.args(op)
      if len(inputs) - len(ir.outs(op)) == 7 {
        loops += [op]
      }
    }
  }
  assert(len(loops) == 1, "spatial axis check requires one seven-axis loop")
  let loop = loops[0]
  let params = ir.params(function)
  let body_args = ir.args(ir.blks(loop)[0])
  assert(len(params) == 2 && len(body_args) == 8,
         "spatial axis check found an invalid function or loop signature")
  let x_reads = tile.reads(m, loop, params[0])
  let weight_reads = tile.reads(m, loop, params[1])
  let out_reads = tile.reads(m, loop, body_args[7])
  let out_writes = tile.writes(m, loop, body_args[7])
  assert(tile.state_axes(m, loop) == [0, 1, 2, 6] &&
         tile.reduction_axes(m, loop) == [3, 4, 5],
         "scheduled loop has the wrong axis roles")
  assert(len(x_reads) == 1 && len(x_reads[0]) == 1 &&
         len(weight_reads) == 1 && len(weight_reads[0]) == 1 &&
         len(out_reads) == 1 && len(out_reads[0]) == 1 &&
         len(out_writes) == 1 && len(out_writes[0]) == 1,
         "spatial access query found the wrong accesses")
  assert(expect_axes(loop, x_reads[0][0], [0, 1, 2, 3, 4, 5, 6]),
         "spatial input access has the wrong axes")
  assert(expect_axes(loop, weight_reads[0][0], [1, 3, 4, 5]),
         "spatial weight access has the wrong axes")
  assert(expect_axes(loop, out_reads[0][0], [0, 1, 2, 6]) &&
         expect_axes(loop, out_writes[0][0], [0, 1, 2, 6]),
         "spatial output accesses have the wrong axes")
  assert(tile.affine(m, loop, x_reads[0][0]) ==
           [0, 9, 9, 3, 9, 3, 1, 1],
         "spatial input index has the wrong affine form")
  assert(tile.affine(m, loop, weight_reads[0][0]) ==
           [0, 0, 4, 0, 4, 2, 1, 0],
         "spatial weight index has the wrong affine form")
  assert(tile.affine(m, loop, out_reads[0][0]) ==
           [0, 4, 4, 2, 0, 0, 0, 1] &&
         tile.affine(m, loop, out_writes[0][0]) ==
           [0, 4, 4, 2, 0, 0, 0, 1],
         "spatial output accesses have the wrong affine form")

  let reduce = ir.find(m, "reduce5")
  assert(ir.live(reduce), "spatial axis check requires reduce5")
  var reductions: list<Op> = []
  for op in ir.ops(reduce) {
    if ir.kind(op) == "loop" {
      reductions += [op]
    }
  }
  assert(len(reductions) == 1,
         "spatial axis check requires one five-axis reduction")
  let reduction = reductions[0]
  let reduction_args = ir.args(ir.blks(reduction)[0])
  assert(len(reduction_args) == 6 &&
         ir.name(reduction_args[0]) == "a" &&
         ir.name(reduction_args[1]) == "b" &&
         ir.name(reduction_args[2]) == "c" &&
         ir.name(reduction_args[3]) == "k" &&
         ir.name(reduction_args[4]) == "d",
         "spatial policy did not reorder the generic reduction")
  assert(tile.state_axes(m, reduction) == [0, 1, 2, 4] &&
         tile.reduction_axes(m, reduction) == [3],
         "generic reduction has the wrong scheduled roles")
  assert(ir.revision(m) == before,
         "spatial axis queries changed the module")
  return true
}

fn first(m: Mod, factor: int) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      return ir.live(tile.split(m, op, factor))
    }
  }
  return false
}

fn named(m: Mod, name: str, factor: int) -> bool {
  let selected = ir.find(m, name)
  assert(ir.live(selected), "tile_pass.named could not find the function")
  for op in ir.ops(selected) {
    if ir.kind(op) == "loop" {
      return ir.live(tile.split(m, op, factor))
    }
  }
  return false
}

fn named_axis(m: Mod, name: str, axis: int, factor: int) -> bool {
  let selected = ir.find(m, name)
  assert(ir.live(selected), "tile_pass.named_axis could not find the function")
  for op in ir.ops(selected) {
    if ir.kind(op) == "loop" {
      return ir.live(tile.split(m, op, axis, factor))
    }
  }
  return false
}

fn check_splittable(m: Mod, factor: int, expected: int) -> bool {
  let before = ir.revision(m)
  let candidates = tile.splittable(m, factor)
  let first_axis = tile.splittable(m, 0, factor)
  assert(ir.revision(m) == before,
         "tile.splittable must be read-only")
  assert(len(candidates) == expected,
         "unexpected split candidate count")
  assert(len(first_axis) == expected,
         "unexpected first-axis split candidate count")
  for loop in candidates {
    assert(tile.can_split(m, loop, factor) &&
           tile.split_issue(m, loop, factor) == "",
           "tile.splittable returned an illegal loop")
  }
  for loop in first_axis {
    assert(tile.can_split(m, loop, 0, factor) &&
           tile.split_issue(m, loop, 0, factor) == "",
           "axis-aware tile.splittable returned an illegal loop")
  }
  return true
}

fn check_split_issue(m: Mod) -> bool {
  let before = ir.revision(m)
  let candidates = tile.splittable(m, 2)
  assert(len(candidates) > 0,
         "split issue check requires a candidate")
  assert(tile.split_issue(m, candidates[0], 2) == "",
         "legal split reported an issue")
  assert(tile.split_issue(m, candidates[0], 0) ==
         "requires a positive factor",
         "illegal split reported the wrong issue")
  assert(tile.split_issue(m, candidates[0], -1, 2) ==
         "requires an axis within the loop rank",
         "negative split axis reported the wrong issue")
  assert(tile.split_issue(m, candidates[0], 1, 2) ==
         "requires an axis within the loop rank",
         "large split axis reported the wrong issue")
  assert(ir.revision(m) == before,
         "tile.split_issue must be read-only")
  return true
}

fn check_split_noop(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      let before = ir.revision(m)
      assert(tile.split(m, op, 1) == op,
             "factor-one split did not preserve the loop")
      assert(ir.revision(m) == before,
             "factor-one split changed the module")
      return true
    }
  }
  assert(false, "split no-op check requires a loop")
  return false
}

fn check_mergeable(m: Mod) -> bool {
  let before = ir.revision(m)
  let candidates = tile.mergeable(m)
  let second_pair = tile.mergeable(m, 1)
  let outside = tile.mergeable(m, 2)
  assert(ir.revision(m) == before,
         "tile.mergeable must be read-only")
  assert(len(candidates) == 1 && len(second_pair) == 1 &&
         len(outside) == 0,
         "unexpected merge candidate set")
  let loop = candidates[0]
  assert(tile.can_merge(m, loop) && tile.can_merge(m, loop, 0) &&
         tile.merge_issue(m, loop) == "" &&
         tile.merge_issue(m, loop, 2) ==
           "requires an adjacent axis pair within the loop rank",
         "merge legality and rejection reasons disagree")
  let dynamic = ir.find(m, "dynamic")
  assert(ir.live(dynamic), "merge check requires the dynamic fixture")
  var saw_dynamic = false
  for op in ir.ops(dynamic) {
    if ir.kind(op) == "loop" {
      saw_dynamic = true
      assert(!tile.can_merge(m, op) &&
             tile.merge_issue(m, op) ==
               "requires static integer bounds",
             "dynamic merge boundary was not reported")
    }
  }
  assert(saw_dynamic, "merge check did not find the dynamic loop")
  assert(ir.revision(m) == before,
         "tile merge queries changed the module")
  return true
}

fn merge_first(m: Mod) -> bool {
  let candidates = tile.mergeable(m)
  assert(len(candidates) > 0,
         "tile_pass.merge_first requires a mergeable loop")
  let first = tile.merge(m, candidates[0])
  assert(ir.live(first), "first adjacent-axis merge failed")
  let second = tile.merge(m, first)
  return ir.live(second)
}

fn unroll_first(m: Mod, factor: int) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      return ir.live(tile.unroll(m, op, factor))
    }
  }
  return false
}

fn unroll_named(m: Mod, name: str, factor: int) -> bool {
  let selected = ir.find(m, name)
  assert(ir.live(selected), "tile_pass.unroll_named could not find the function")
  for op in ir.ops(selected) {
    if ir.kind(op) == "loop" {
      return ir.live(tile.unroll(m, op, factor))
    }
  }
  return false
}

fn small_factor(m: Mod, loop: Op, limit: int) -> int {
  if ir.kind(loop) != "loop" {
    return 1
  }
  let inputs = ir.args(loop)
  let axes = len(inputs) - len(ir.outs(loop))
  if axes <= 0 {
    return 1
  }
  let range = ir.def(inputs[axes - 1])
  if !ir.live(range) || ir.callee(range) != "operator .." {
    return 1
  }
  let bounds = ir.args(range)
  if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
     !ir.is_const(bounds[1]) ||
     base.kind(ir.constant(bounds[0])) != "int" ||
     base.kind(ir.constant(bounds[1])) != "int" {
    return 1
  }
  let trip = base.int(ir.constant(bounds[1])) -
             base.int(ir.constant(bounds[0]))
  if trip > 1 && trip <= limit && tile.can_unroll(m, loop, trip) {
    return trip
  }
  return 1
}

fn unroll_small(m: Mod, limit: int) -> bool {
  return tile.unroll(m, ir.find("tile_pass.small_factor"), limit)
}

fn mutating_unroll_policy(m: Mod, loop: Op) -> int {
  ir.set(m, loop, "policy.mutated", true)
  return 2
}

fn reject_mutating_unroll_policy(m: Mod) -> bool {
  return tile.unroll(m, ir.find("tile_pass.mutating_unroll_policy"))
}

fn check_unrollable(m: Mod, factor: int, expected: int) -> bool {
  let before = ir.revision(m)
  let candidates = tile.unrollable(m, factor)
  assert(ir.revision(m) == before,
         "tile.unrollable must be read-only")
  assert(len(candidates) == expected,
         "unexpected unroll candidate count")
  return true
}

fn check_unroll_issue(m: Mod) -> bool {
  let before = ir.revision(m)
  let candidates = tile.unrollable(m, 2)
  assert(len(candidates) == 1,
         "unroll issue check requires one candidate")
  assert(tile.unroll_issue(m, candidates[0], 2) == "",
         "legal unroll reported an issue")
  assert(tile.unroll_issue(m, candidates[0], 3) ==
         "requires the trip count to be divisible by the factor",
         "illegal unroll reported the wrong issue")
  assert(ir.revision(m) == before,
         "tile.unroll_issue must be read-only")
  return true
}

fn fuse_first(m: Mod) -> bool {
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "tile_pass.fuse_first requires two loops")
  return ir.live(tile.fuse(m, loops[0], loops[1]))
}

fn can_first(m: Mod) -> bool {
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "tile_pass.can_first requires two loops")
  let before = ir.revision(m)
  let result = tile.can_fuse(m, loops[0], loops[1])
  assert(ir.revision(m) == before,
         "tile.can_fuse changed the module")
  return result
}

fn all(m: Mod) -> bool {
  return tile.fuse(m)
}

fn allow_pair(m: Mod, pair: list<Op>) -> bool {
  return len(pair) == 2
}

fn permitted(m: Mod) -> bool {
  return tile.fuse(m, ir.find("tile_pass.allow_pair"))
}

fn mutating_policy(m: Mod, pair: list<Op>) -> bool {
  return ir.set(m, pair[0], "policy.mutated", true)
}

fn reject_mutating_policy(m: Mod) -> bool {
  return tile.fuse(m, ir.find("tile_pass.mutating_policy"))
}

fn check_fusible(m: Mod, expected: int) -> bool {
  let before = ir.revision(m)
  let candidates = tile.fusible(m)
  assert(ir.revision(m) == before,
         "tile.fusible must be read-only")
  assert(len(candidates) == expected,
         "unexpected fusion candidate count")
  for pair in candidates {
    assert(len(pair) == 2 && tile.can_fuse(m, pair[0], pair[1]) &&
           tile.fuse_issue(m, pair[0], pair[1]) == "",
           "tile.fusible returned an illegal pair")
  }
  return true
}

fn check_fuse_issue(m: Mod, expected: str) -> bool {
  let before = ir.revision(m)
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "fusion issue check requires two loops")
  assert(tile.fuse_issue(m, loops[0], loops[1]) == expected,
         "fusion reported the wrong issue")
  assert(ir.revision(m) == before,
         "tile.fuse_issue must be read-only")
  return true
}
