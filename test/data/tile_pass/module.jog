module tile_pass
use base
use tile

fn first(m: Mod, factor: int) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      return tile.split(m, op, factor)
    }
  }
  return false
}

fn named(m: Mod, name: str, factor: int) -> bool {
  let selected = ir.find(m, name)
  assert(ir.live(selected), "tile_pass.named could not find the function")
  for op in ir.ops(selected) {
    if ir.kind(op) == "loop" {
      return tile.split(m, op, factor)
    }
  }
  return false
}

fn unroll_first(m: Mod, factor: int) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      return tile.unroll(m, op, factor)
    }
  }
  return false
}

fn unroll_named(m: Mod, name: str, factor: int) -> bool {
  let selected = ir.find(m, name)
  assert(ir.live(selected), "tile_pass.unroll_named could not find the function")
  for op in ir.ops(selected) {
    if ir.kind(op) == "loop" {
      return tile.unroll(m, op, factor)
    }
  }
  return false
}

fn small_factor(m: Mod, loop: Op, limit: int) -> int {
  if ir.kind(loop) != "loop" {
    return 1
  }
  let inputs = ir.args(loop)
  let axes = len(inputs) - len(ir.outs(loop))
  if axes <= 0 {
    return 1
  }
  let range = ir.def(inputs[axes - 1])
  if !ir.live(range) || ir.callee(range) != "operator .." {
    return 1
  }
  let bounds = ir.args(range)
  if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
     !ir.is_const(bounds[1]) ||
     base.kind(ir.constant(bounds[0])) != "int" ||
     base.kind(ir.constant(bounds[1])) != "int" {
    return 1
  }
  let trip = base.int(ir.constant(bounds[1])) -
             base.int(ir.constant(bounds[0]))
  if trip > 1 && trip <= limit && tile.can_unroll(m, loop, trip) {
    return trip
  }
  return 1
}

fn unroll_small(m: Mod, limit: int) -> bool {
  return tile.unroll(m, ir.find("tile_pass.small_factor"), limit)
}

fn mutating_unroll_policy(m: Mod, loop: Op) -> int {
  ir.set(m, loop, "policy.mutated", true)
  return 2
}

fn reject_mutating_unroll_policy(m: Mod) -> bool {
  return tile.unroll(m, ir.find("tile_pass.mutating_unroll_policy"))
}

fn fuse_first(m: Mod) -> bool {
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "tile_pass.fuse_first requires two loops")
  return tile.fuse(m, loops[0], loops[1])
}

fn can_first(m: Mod) -> bool {
  var loops: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      loops += [op]
    }
  }
  assert(len(loops) >= 2,
         "tile_pass.can_first requires two loops")
  let before = ir.revision(m)
  let result = tile.can_fuse(m, loops[0], loops[1])
  assert(ir.revision(m) == before,
         "tile.can_fuse changed the module")
  return result
}

fn all(m: Mod) -> bool {
  return tile.fuse(m)
}

fn allow_pair(m: Mod, pair: list<Op>) -> bool {
  return len(pair) == 2
}

fn permitted(m: Mod) -> bool {
  return tile.fuse(m, ir.find("tile_pass.allow_pair"))
}

fn mutating_policy(m: Mod, pair: list<Op>) -> bool {
  return ir.set(m, pair[0], "policy.mutated", true)
}

fn reject_mutating_policy(m: Mod) -> bool {
  return tile.fuse(m, ir.find("tile_pass.mutating_policy"))
}
