mod loop_c
use onnx

fn scan(start: tensor<i32, []>, condition: tensor<bool, []>,
        delta: tensor<i32, []>, limit: tensor<i32, []>)
    -> (tensor<i32, []>, tensor<i32, [_]>) {
  let trip: tensor<i64, []> = hex"0400000000000000"
  [onnx: {body: {fn: "body", inputs: 3, captures: [3, 4]}}]
  let final, history = onnx.Loop(trip, condition, start, delta, limit)
  let inferred: tensor<i64, [1]> = hex"ffffffffffffffff"
  let flat = onnx.Reshape(history, inferred)
  return final, flat
}

fn reshape(x: tensor<i32, [2, 3]>, requested: tensor<i64, [2]>)
    -> tensor<i32, [_, _]> {
  return onnx.Reshape(x, requested)
}

fn reshape_empty(x: tensor<i32, [0, 3]>, requested: tensor<i64, [2]>)
    -> tensor<i32, [_, _]> {
  [onnx: {allowzero: 1}]
  let y = onnx.Reshape(x, requested)
  return y
}

fn reshape_rank(x: tensor<i32, [6]>, requested: tensor<i64, [3]>)
    -> tensor<i32, [_, _, _]> {
  return onnx.Reshape(x, requested)
}

fn body(iteration: tensor<i64, []>, keep_going: tensor<bool, []>,
        previous: tensor<i32, []>, delta: tensor<i32, []>,
        limit: tensor<i32, []>)
    -> (tensor<bool, []>, tensor<i32, []>, tensor<i32, []>) {
  let current = onnx.Add(previous, delta)
  let condition_out = onnx.Less(current, limit)
  [onnx: {to: 6}]
  let index = onnx.Cast(iteration)
  // Read the previous carried value, not the newly assigned current value.
  let sample = onnx.Add(previous, index)
  return condition_out, current, sample
}
