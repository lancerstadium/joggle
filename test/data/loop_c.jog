mod loop_c
use onnx
use tensor

fn scan(start: tensor<i32, []>, condition: tensor<bool, []>,
        delta: tensor<i32, []>, limit: tensor<i32, []>)
    -> (tensor<i32, []>, tensor<i32, [_]>) {
  let trip: tensor<i64, []> = hex"0400000000000000"
  [onnx: {body: {fn: "body", inputs: 3, captures: [3, 4]}}]
  let final, history = onnx.Loop(trip, condition, start, delta, limit)
  let inferred: tensor<i64, [1]> = hex"ffffffffffffffff"
  let flat = onnx.Reshape(history, inferred)
  return final, flat
}

fn reshape(x: tensor<i32, [2, 3]>, requested: tensor<i64, [2]>)
    -> tensor<i32, [_, _]> {
  return onnx.Reshape(x, requested)
}

// An ONNX Loop may contain an If whose branch already has structured control
// flow. Function block enumeration includes those nested blocks.
fn nested_scan(start: tensor<i32, []>, condition: tensor<bool, []>,
               delta: tensor<i32, []>, limit: tensor<i32, []>)
    -> (tensor<i32, []>, tensor<i32, [_]>) {
  let trip: tensor<i64, []> = hex"0400000000000000"
  [onnx: {body: {fn: "nested_body", inputs: 3, captures: [3, 4]}}]
  let final, history = onnx.Loop(trip, condition, start, delta, limit)
  return final, history
}

fn nested_body(iteration: tensor<i64, []>, keep_going: tensor<bool, []>,
               previous: tensor<i32, []>, delta: tensor<i32, []>,
               limit: tensor<i32, []>)
    -> (tensor<bool, []>, tensor<i32, []>, tensor<i32, []>) {
  let advance = onnx.Less(previous, limit)
  [onnx: {then_branch: {fn: "nested_then", inputs: 0, captures: [1, 2]},
          else_branch: {fn: "nested_else", inputs: 0, captures: [1]}}]
  let current = onnx.If(advance, previous, delta)
  return keep_going, current, current
}

fn nested_then(previous: tensor<i32, []>, delta: tensor<i32, []>)
    -> tensor<i32, []> {
  var current = previous
  if delta[index(0)] > i32(0) {
    current = onnx.Add(previous, delta)
  } else {
    current = onnx.Sub(previous, delta)
  }
  return current
}

fn nested_else(previous: tensor<i32, []>) -> tensor<i32, []> {
  return previous
}

// A condition-terminated scan uses a huge maximum trip count, but its
// shape-derived limit and exact counter recurrence prove a two-row capacity.
fn bounded_scan(x: tensor<i32, [5]>, condition: tensor<bool, []>)
    -> (tensor<i32, []>, tensor<i32, [_]>) {
  let trip: tensor<i64, []> = hex"ffffffffffffff7f"
  let start: tensor<i32, []> = hex"01000000"
  let step: tensor<i32, []> = hex"02000000"
  let shape = onnx.Shape(x)
  [onnx: {axes: [0]}]
  let limit = onnx.Squeeze(shape)
  [onnx: {body: {fn: "bounded_body", inputs: 3, captures: [3, 4]}}]
  let final, history = onnx.Loop(trip, condition, start, step, limit)
  return final, history
}

fn bounded_body(iteration: tensor<i64, []>, keep_going: tensor<bool, []>,
                previous: tensor<i32, []>, step: tensor<i32, []>,
                limit: tensor<i64, []>)
    -> (tensor<bool, []>, tensor<i32, []>, tensor<i32, []>) {
  let current = onnx.Add(previous, step)
  [onnx: {to: 1}]
  let as_float = onnx.Cast(current)
  [onnx: {to: 1}]
  let stop = onnx.Cast(limit)
  let next = onnx.Less(as_float, stop)
  return next, current, current
}

fn reshape_empty(x: tensor<i32, [0, 3]>, requested: tensor<i64, [2]>)
    -> tensor<i32, [_, _]> {
  [onnx: {allowzero: 1}]
  let y = onnx.Reshape(x, requested)
  return y
}

fn reshape_rank(x: tensor<i32, [6]>, requested: tensor<i64, [3]>)
    -> tensor<i32, [_, _, _]> {
  return onnx.Reshape(x, requested)
}

fn shape_pipeline(x: tensor<i32, [4]>, full: bool) -> tensor<i32, [_, 6]> {
  var length = index(2)
  if full { length = index(4) }
  let source_shape = tensor<index, [1]>(length)
  let source: tensor<i32, [_]> = tensor.view(x, source_shape)
  let column: tensor<i64, [2]> = hex"ffffffffffffffff0100000000000000"
  let matrix = onnx.Reshape(source, column)
  let once: tensor<i64, [1]> = hex"0100000000000000"
  let thrice: tensor<i64, [1]> = hex"0300000000000000"
  [onnx: {axis: -1}]
  let repeats = onnx.Concat(once, thrice)
  let tiled = onnx.Tile(matrix, repeats)
  [onnx: {axis: -1}]
  let joined = onnx.Concat(tiled, tiled)
  return joined
}

fn cast_view(x: tensor<i32, [4]>, nonempty: bool) -> tensor<f32, [1, _, 1]> {
  var length = index(0)
  if nonempty { length = index(4) }
  let source_shape = tensor<index, [1]>(length)
  let source: tensor<i32, [_]> = tensor.view(x, source_shape)
  [onnx: {axes: [-1, 0]}]
  let expanded = onnx.Unsqueeze(source)
  [onnx: {to: 1}]
  let converted = onnx.Cast(expanded)
  let copied = base.copy(converted)
  return copied
}

fn squeeze_view(x: tensor<i32, [4]>, requested: tensor<index, [3]>)
    -> tensor<i32, [_]> {
  let source: tensor<i32, [_, _, 1]> = tensor.view(x, requested)
  [onnx: {axes: [-1, 0]}]
  let squeezed = onnx.Squeeze(source)
  return squeezed
}

fn body(iteration: tensor<i64, []>, keep_going: tensor<bool, []>,
        previous: tensor<i32, []>, delta: tensor<i32, []>,
        limit: tensor<i32, []>)
    -> (tensor<bool, []>, tensor<i32, []>, tensor<i32, []>) {
  let current = onnx.Add(previous, delta)
  let condition_out = onnx.Less(current, limit)
  [onnx: {to: 6}]
  let index = onnx.Cast(iteration)
  // Read the previous carried value, not the newly assigned current value.
  let sample = onnx.Add(previous, index)
  return condition_out, current, sample
}
