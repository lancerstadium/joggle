mod nms_c
use nn

fn main(
  boxes: tensor<f32, [1, 4, 4]>,
  scores: tensor<f32, [1, 2, 4]>,
  maximum: tensor<i64, []>,
  overlap: tensor<f32, []>,
  threshold: tensor<f32, []>
) -> tensor<i64, [_, 3]> {
  return nn.nms(boxes, scores, maximum, overlap, threshold, 0)
}

fn dynamic(
  boxes: tensor<f32, [1, 4, 4]>,
  scores: tensor<f32, [1, 2, 4]>,
  maximum: tensor<i64, []>,
  overlap: tensor<f32, []>,
  threshold: tensor<f32, []>,
  mode: int
) -> tensor<i64, [_, 3]> {
  var count = index(0)
  if mode == 1 { count = index(2) }
  if mode == 2 { count = index(4) }
  var box_shape = tensor<index, [3]>(index(0))
  box_shape[0] = index(1)
  box_shape[1] = count
  box_shape[2] = index(4)
  var score_shape = tensor<index, [3]>(index(0))
  score_shape[0] = index(1)
  score_shape[1] = index(2)
  score_shape[2] = count
  let runtime_boxes: tensor<f32, [1, _, 4]> = tensor.view(boxes, box_shape)
  let runtime_scores: tensor<f32, [1, 2, _]> = tensor.view(scores, score_shape)
  return nn.nms(runtime_boxes, runtime_scores, maximum, overlap, threshold, 0)
}
