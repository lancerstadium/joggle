mod script
use alternate
use c
use opt
use stat
use tensor
use tile
use onnx.nn

local fn hidden(m: Mod) -> bool {
  return ir.revision(m) >= 0
}

local fn hidden_type<T: Ty>() -> Ty;

fn local_probe(m: Mod) -> bool {
  return hidden(m)
}

fn fn_revision(m: Mod, name: str) -> int {
  return ir.revision(ir.find(m, name))
}

fn fn_op_count(m: Mod, name: str) -> int {
  return len(ir.ops(ir.find(m, name)))
}

fn package_count(m: Mod) -> int {
  return len(ir.uses(m))
}

fn observe_packages(m: Mod) -> bool {
  return len(ir.uses(m)) >= 0
}

fn observe_packages_named(m: Mod, name: str) -> bool {
  return len(ir.uses(m)) >= 0
}

fn sync_package(m: Mod, name: str) -> bool {
  let target = ir.find(m, name)
  if ir.has(target, "package.base") {
    return ir.use(m, "base")
  }
  return ir.use(m, "alternate")
}

fn bind_c_target(m: Mod, name: str, binding: str) -> bool {
  return c.bind(m, ir.find(m, name), binding)
}

local fn recursive_local(x: i32) -> i32 {
  return recursive_local(x)
}

fn recursive_local_probe(x: i32) -> i32 {
  return recursive_local(x)
}

fn own_local_visible(m: Mod) -> bool {
  for fn in ir.fns("script") {
    if ir.name(fn) == "hidden" {
      return ir.local(fn)
    }
  }
  return false
}

fn imported_locals_hidden(m: Mod) -> bool {
  for fn in ir.fns("onnx.nn") {
    if ir.local(fn) {
      return false
    }
  }
  return true
}

fn nn.relu<S: list<int>>(x: tensor<i8, S>) -> tensor<i8, S> {
  return mid.relu(x)
}

fn nn.relu(x: tensor<i8, [4]>) -> tensor<i8, [4]> {
  return edge.relu4(x)
}

fn mid.relu<S: list<int>>(x: tensor<i8, S>) -> tensor<i8, S> {
  return edge.relu(x)
}

fn loop.relu<S: list<int>>(x: tensor<i8, S>) -> tensor<i8, S> {
  return loop.relu(x)
}

fn external_select.external(x: i32) -> i32;

[c: {name: "mixed_external"}]
fn mixed<T: Ty, N: int>(x: tensor<T, [N]>) -> tensor<T, [N]>;

fn typed_caps() -> list<Fn> {
  return ir.fns("script")
}

fn emit_name(m: Mod) -> str {
  return ir.name(ir.find(m, "matmul"))
}

fn emit_wrong_type(m: Mod) -> bool {
  return ir.revision(m) >= 0
}

fn emit_bytes(m: Mod) -> bytes {
  assert(ir.revision(m) >= 0, "invalid module revision")
  return hex"00410aff"
}

fn text_probe(m: Mod) -> bool {
  let payload = hex"0041" + hex"0aff"
  return ir.revision(m) >= 0 &&
         "joggle" + "-" + "emit" == "joggle-emit" &&
         text(-12) == "-12" && text(true) == "true" &&
         text("quoted") == "\"quoted\"" && text(ty("i32")) == "i32" &&
         replace("a.b.b", "b", "cc") == "a.cc.cc" &&
         base.ident("edge.matmul") == "edgeZDmatmul" &&
         base.ident("edge_matmul") == "edge_matmul" &&
         base.ident("ZD_ZX_ZU") == "ZZD_ZZX_ZZU" &&
         base.ident("__") == "ZUZU" && base.size(payload) == 4 &&
         base.byte(payload, 1) == 65 && base.byte(payload, 3) == 255 &&
         base.ident("9/x-y") == "9ZX2fxZX2dy" &&
         base.ident("é") == "ZXc3ZXa9"
}

local fn partial<A: Ty, B: Ty>(value: B) -> B {
  return value
}

fn partial_generic_probe(m: Mod) -> bool {
  return partial<i32>(7) == 7 && partial<i32>("edge") == "edge"
}

fn integer_cost(m: Mod, subject: int) -> int {
  return subject + 1
}

fn operation_count(m: Mod, subject: list<Op>) -> int {
  return len(subject)
}

fn generic_invoke_probe(m: Mod) -> bool {
  let empty: list<Op> = []
  return ir.invoke<int>(m, 3, ir.find("script.integer_cost")) == 4 &&
         ir.invoke<int>(m, empty, ir.find("script.operation_count")) == 0 &&
         ir.invoke<bool>(m, ir.find("script.local_probe")) &&
         ir.invoke<bytes>(m, ir.find("script.emit_bytes")) == hex"00410aff"
}

fn invoke_summary(m: Mod) -> dict {
  return ir.invoke<dict>(m, ir.find("stat.summary"))
}

fn invoke_name(m: Mod) -> str {
  return ir.invoke<str>(m, ir.find("script.emit_name"))
}

fn derive_emitter(m: Mod) -> bool {
  let original = ir.find("script.emit_bytes")
  let copy = ir.clone(m, original, "derived")
  assert(ir.live(copy), "could not derive emitter")
  assert(ir.invoke<bytes>(m, copy) == hex"00410aff", "copy changed output")
  var changed = false
  for op in ir.ops(copy) {
    if ir.kind(op) == "return" {
      let value = ir.constant(m, op, hex"fe", ty("bytes"))
      changed = ir.replace(m, ir.args(op)[0], value, op)
    }
  }
  assert(changed, "derived body was not edited")
  assert(ir.invoke<bytes>(m, copy) == hex"fe", "derived invocation used old body")
  assert(ir.invoke<bytes>(m, original) == hex"00410aff", "source body changed")
  return true
}

fn reject_invoke_arity(m: Mod) -> bool {
  let copy = ir.clone(m, ir.find("script.integer_cost"), "rejected")
  return ir.invoke<int>(m, copy) == 0
}

fn reject_invoke_result(m: Mod) -> bool {
  let copy = ir.clone(m, ir.find("script.emit_bytes"), "rejected")
  return ir.invoke<int>(m, copy) == 0
}

[on: "opaque"]
fn mark_rule(m: Mod, op: Op) -> bool {
  return ir.set(m, op, "matched", true)
}

fn apply_rules(m: Mod) -> bool {
  var changed = false
  let rules = ir.fns("script")
  for op in ir.ops(m) {
    for rule in ir.where(rules, "on", ir.callee(op)) {
      changed = ir.invoke<bool>(m, op, rule) || changed
    }
  }
  return changed
}

fn where_probe(m: Mod) -> bool {
  return len(ir.where(ir.fns(m), "mark", "fn")) == 1 &&
         len(ir.where(ir.fns(m), "mark", "entry")) == 1 &&
         len(ir.where(ir.ops(m), "mark", "op")) == 1 &&
         len(ir.where(ir.ops(m), "missing", true)) == 0 &&
         len(ir.where(ir.vals(m), "mark", "param")) == 1 &&
         len(ir.where(ir.vals(m), "mark", "val")) == 1
}

fn configured_rule(m: Mod, op: Op, config: dict) -> bool {
  let key = str(get(config, "key"))
  return ir.set(m, op, key, get(config, "value"))
}

fn apply_configured_rule(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "call" && ir.callee(op) == "opaque" {
      return ir.invoke<bool>(
        m, op, ir.find("script.configured_rule"),
        {key: "configured", value: 7}
      )
    }
  }
  return false
}

fn reject_configured_rule(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "call" && ir.callee(op) == "opaque" {
      return ir.invoke<bool>(
        m, op, ir.find("script.configured_rule"), "not a dictionary"
      )
    }
  }
  return false
}

fn configured_cap(m: Mod, op: Op, config: dict) -> bool {
  return ir.callee(op) == str(get(config, "callee"))
}

fn configured_frontier(m: Mod, callee: str) -> list<str> {
  var config: dict = {}
  config["callee"] = callee
  return opt.frontier(m, ir.find("script.configured_cap"), config)
}

fn op_cost(m: Mod, op: Op) -> int {
  if ir.kind(op) == "call" {
    return 2
  }
  return 1
}

fn model_cost(m: Mod) -> int {
  return stat.sum(m, ir.find("script.op_cost"))
}

fn bad_cost(m: Mod, op: Op) -> bool {
  return ir.live(op)
}

fn reject_bad_cost(m: Mod) -> int {
  return stat.sum(m, ir.find("script.bad_cost"))
}

[case: "bad"]
fn bad_rule(m: Mod) -> bool {
  return false
}

fn reject_bad_rule(m: Mod) -> bool {
  let rules = ir.where(ir.fns("script"), "case", "bad")
  for op in ir.ops(m) {
    for rule in rules {
      return ir.invoke<bool>(m, op, rule)
    }
  }
  return false
}

[phase: "infer", on: "onnx.Custom"]
fn infer_custom_onnx(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  return ir.type(m, outputs[0], ir.type(inputs[0]))
}

[phase: "compute", on: "onnx.Custom"]
fn custom_onnx(m: Mod, op: Op) -> bool {
  if !ir.retarget(m, op, "base.copy", ir.args(op)) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

fn extend_onnx(m: Mod) -> bool {
  let rules = ir.fns("onnx.nn") + ir.fns("script")
  return onnx.nn.convert(m, rules)
}

fn typed_frontier(m: Mod) -> list<str> {
  return opt.frontier(m, typed_caps())
}

fn typed_legalize(m: Mod) -> bool {
  return opt.legalize(m, typed_caps(), 1)
}

fn apply_impls(m: Mod) -> bool {
  return opt.apply(m, typed_caps())
}

fn candidate_count(m: Mod) -> int {
  var count = 0
  let impls = typed_caps()
  for op in ir.ops(m) {
    count += len(opt.candidates(m, op, impls + impls))
  }
  return count
}

fn concrete_impl(m: Mod, op: Op, impl: Fn) -> bool {
  return len(ir.generics(impl)) == 0
}

fn apply_concrete(m: Mod) -> bool {
  return opt.apply(
    m, typed_caps(), ir.find("script.concrete_impl")
  )
}

fn choose_first(m: Mod, op: Op, impls: list<Fn>) -> list<Fn> {
  if len(impls) == 0 {
    return []
  }
  return [impls[0]]
}

fn choose_none(m: Mod, op: Op, impls: list<Fn>) -> list<Fn> {
  return []
}

fn choose_foreign(m: Mod, op: Op, impls: list<Fn>) -> list<Fn> {
  return [ir.find("script.emit_wrong_type")]
}

fn choose_mutating(m: Mod, op: Op, impls: list<Fn>) -> list<Fn> {
  ir.set(m, op, "policy_edit", true)
  return [impls[0]]
}

fn choose_many(m: Mod, op: Op, impls: list<Fn>) -> list<Fn> {
  return impls
}

fn choose_bad(m: Mod, op: Op, impls: list<Fn>) -> int {
  return len(impls)
}

fn apply_selected(m: Mod) -> bool {
  let impls = typed_caps() + ir.fns("alternate")
  return opt.apply(
    m, impls, ir.find("script.choose_first")
  )
}

fn apply_none(m: Mod) -> bool {
  return opt.apply(m, typed_caps(), ir.find("script.choose_none"))
}

fn apply_foreign(m: Mod) -> bool {
  return opt.apply(m, typed_caps(), ir.find("script.choose_foreign"))
}

fn apply_mutating_choice(m: Mod) -> bool {
  return opt.apply(m, typed_caps(), ir.find("script.choose_mutating"))
}

fn apply_many(m: Mod) -> bool {
  let impls = typed_caps() + ir.fns("alternate")
  return opt.apply(m, impls, ir.find("script.choose_many"))
}

fn apply_bad_policy(m: Mod) -> bool {
  return opt.apply(m, typed_caps(), ir.find("script.choose_bad"))
}

fn mutating_impl(m: Mod, op: Op, impl: Fn) -> bool {
  return ir.set(m, op, "predicate_edit", ir.name(impl))
}

fn apply_mutating(m: Mod) -> bool {
  return opt.apply(
    m, typed_caps(), ir.find("script.mutating_impl")
  )
