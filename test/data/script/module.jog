fn kernel.scale<S: list<int>>(
  x: tensor<i8, S>
) -> tensor<i8, S> {
  return base.copy(x)
}

fn instantiate_scale(m: Mod) -> bool {
  return opt.instantiate(m, [ir.find("script.kernel.scale")])
}

fn instantiate_selected(m: Mod) -> bool {
  let impl = ir.find("script.kernel.scale")
  let alternate = ir.find("alternate.kernel.scale")
  return opt.instantiate(
    m, [impl, alternate], ir.find("script.choose_first")
  )
}

fn apply_external(m: Mod) -> bool {
  return opt.apply(m, [ir.find("script.external_select.external")])
}

fn apply_ambiguous(m: Mod) -> bool {
  return opt.apply(m, typed_caps() + ir.fns("alternate"))
}

fn apply_cycle(m: Mod) -> bool {
  return opt.apply(m, typed_caps(), 2)
}

fn fail_after_edit(m: Mod) -> bool {
  let changed = fold_add_zero(m)
  assert(false, "forced failure after edit")
  return changed
}

fn probe(x: int) -> bool {
  return true
}

fn probe(x: str) -> bool {
  return missing(x)
}

fn overload_probe(m: Mod) -> bool {
  return probe(1)
}

fn short_circuit_probe(m: Mod) -> bool {
  return !(false && missing(true)) && (true || missing(false))
}

fn short_circuit_edit(m: Mod) -> bool {
  let before = len(ir.uses(m))
  false && ir.use(m, "skipped")
  true || ir.use(m, "skipped")
  return len(ir.uses(m)) == before
}

fn below<N: int>(x: int) -> bool {
  return x < N
}

fn extent<S: list<int>>() -> int {
  return len(S)
}

fn type_same<T: Ty>() -> bool {
  return T == T
}

fn generic_probe(m: Mod) -> bool {
  let exact = ir.find("script.probe", [ty("int")])
  return below<4>(3) && extent<[2, 3]>() == 2 && type_same<i32>() &&
         ir.live(exact) && len(ir.params(exact)) == 1 &&
         ir.type(ir.params(exact)[0]) == ty("int")
}

fn tensor_type_probe(m: Mod) -> bool {
  let original = tensor.type(ty("f32"), [2, 3, 5])
  let dynamic = ty("tensor<f32, [N, 3]>")
  let dims = tensor.dims(dynamic)
  let reversed = tensor.permuted(dims, [1, 0])
  let broadcast = tensor.broadcast_shape(dims, [ty(1), ty(3)])
  let empty: list<Ty> = []
  let empty_broadcast = tensor.broadcast_shape(empty, empty)
  let inferred_broadcast = tensor.broadcast_shape(
    [ty(1), ty(784), ty("_")], [ty(1), ty(784), ty(192)]
  )
  return ir.revision(m) >= 0 &&
         tensor.valid(original) && tensor.static(original) &&
         tensor.elem(original) == ty("f32") &&
         tensor.shape(original) == [2, 3, 5] &&
         tensor.valid(dynamic) && !tensor.static(dynamic) &&
         tensor.type(ty("f32"), dims) == dynamic &&
         reversed == [ty(3), ty("N")] && broadcast == dims &&
         inferred_broadcast == [ty(1), ty(784), ty(192)] &&
         tensor.broadcastable(
           [ty(1), ty(784), ty("_")], inferred_broadcast
         ) &&
         len(empty_broadcast) == 0 &&
         tensor.refined(ty("tensor<f32, [_, 3]>"), dynamic) == dynamic &&
         tensor.refined(ty("tensor<i32, [_, 3]>"), dynamic) == ty("_") &&
         tensor.product([ty("_"), ty(2)], 0, 2) == ty("_") &&
         tensor.product(dims, 0, 1) == ty("N") &&
         tensor.product(dims, 1, 2) == ty(3) &&
         tensor.quotient([ty("N"), ty(256)], [ty(256)]) == ty("N") &&
         tensor.quotient(
           [ty("N"), ty(256)], [ty("N"), ty(64)]
         ) == ty(4) &&
         tensor.inserted(dims, 1, ty(2)) == [ty("N"), ty(2), ty(3)] &&
         tensor.replaced(dims, 0, ty(4)) == [ty(4), ty(3)] &&
         tensor.gathered(dims, [ty(5), ty(6)], 1) ==
           [ty("N"), ty(5), ty(6)] &&
         tensor.concatenated(
           [ty("_"), ty(4)], [ty("_"), ty(4)], 0
         ) == [ty("_"), ty(4)] &&
         tensor.matmul_offset([7, 3, 4], [2, 7, 3, 5], 11, 2, 3) == 59 &&
         tensor.matmul_offset([2, 1, 4, 5], [2, 7, 3, 5], 11, 2, 4) == 34 &&
         tensor.line_offset([2, 3, 4], 1, 6, 1) == 18 &&
         tensor.line_offset([2, 3, 4], 0, 11, 1) == 23 &&
         tensor.valid_axes([1, 2], 3) &&
         !tensor.valid_axes([1, 1], 3) &&
         tensor.reduced([ty("N"), ty(2), ty(3)], [1], true) ==
           [ty("N"), ty(1), ty(3)] &&
         tensor.reduce_offset([2, 3, 4], [1], 5, 2) == 21 &&
         tensor.reduce_offset([2, 3, 4], [0, 2], 1, 7) == 19 &&
         !tensor.valid(ty("tensor"))
}

fn byte_probe(m: Mod) -> bool {
  let data = hex"00ff80"
  return base.size(data) == 3 && base.byte(data, 0) == 0 &&
         base.byte(data, 1) == 255 && base.byte(data, 2) == 128 &&
         base.hex(data, "-") == "00-ff-80" && base.hex(hex"", "-") == ""
}

fn def_probe(m: Mod) -> bool {
  for op in ir.ops(m) {
    let outputs = ir.outs(op)
    if len(outputs) != 0 {
      return ir.def(outputs[0]) == op
    }
  }
  return false
}

fn divmod(x: int, y: int) -> (int, int) {
  return x / y, x % y
}

fn multi_probe(m: Mod) -> bool {
  let quotient, remainder = divmod(7, 3)
  return quotient == 2 && remainder == 1
}

fn compound_probe(m: Mod) -> bool {
  var x = 8
  x -= 3
  x *= 2
  x /= 2
  x %= 3
  x |= 8
  x ^= 3
  x &= 7
  x <<= 3
  x >>= 2
  return x == 2
}

fn collection_update_probe(m: Mod) -> bool {
  var values = [1, 2, 3]
  values[1] = 7
  var fields = {first: 1}
  fields["first"] = values[1]
  fields["second"] = 9
  return values == [1, 7, 3] && int(fields["first"]) == 7 &&
         int(fields["second"]) == 9
}

fn value_alias_probe(m: Mod) -> bool {
  var text_value = "a"
  let text_before = text_value
  text_value += "b"
  var items = [1]
  let items_before = items
  items += [2]
  var fields = {value: 1}
  let fields_before = fields
  fields["value"] = 2
  return text_before == "a" && text_value == "ab" &&
         items_before == [1] && items == [1, 2] &&
         int(fields_before["value"]) == 1 && int(fields["value"]) == 2
}

fn numel_probe(m: Mod) -> bool {
  return tensor.numel<[2, 3, 4]>() == 24
}

fn make_pair(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.callee(op) == "operator +" {
      let pair = ir.call(
        m, op, "test.pair", ir.args(op), [ty("i32"), ty("i32")]
      )
      let outs = ir.outs(pair)
      var named = ir.rename(m, outs[0], "left")
      named = ir.rename(m, outs[1], "right")
      return named
    }
  }
  return false
}

fn insert_observe(m: Mod) -> bool {
  for f in ir.fns(m) {
    if ir.name(f) == "run" && len(ir.params(f)) == 1 {
      for op in ir.ops(f) {
        if ir.kind(op) == "return" {
          let call = ir.call(
            m, op, "observe", [ir.params(f)[0]], []
          )
          return ir.live(call) && len(ir.outs(call)) == 0
        }
      }
    }
  }
  return false
}

fn mark_add(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.callee(op) == "operator +" {
      var changed = ir.set(m, op, "place", "edge")
      changed = ir.set(m, op, "tile", [4, 8])
      return changed && ir.has(op, "place") &&
             ir.meta(op, "place") == "edge"
    }
  }
  return false
}

[memo]
local fn memo_sum(values: list<int>) -> int {
  var out = 0
  for value in values {
    out += value
  }
  return out
}

fn memo_probe(m: Mod) -> bool {
  let before = ir.revision(m)
  let first = memo_sum([1, 2, 3, 4])
  let second = memo_sum([1, 2, 3, 4])
  assert(ir.revision(m) == before,
         "script.memo_probe changed the module")
  return first == 10 && second == 10
}

[memo]
local fn memo_name(value: Val) -> str {
  return ir.name(value)
}

fn memo_handle_probe(m: Mod) -> bool {
  for f in ir.fns(m) {
    let params = ir.params(f)
    if len(params) != 0 {
      let value = params[0]
      let before = memo_name(value)
      assert(memo_name(value) == before,
             "script.memo_handle_probe could not reuse a pure query")
      assert(ir.rename(m, value, "memo_handle"),
             "script.memo_handle_probe could not rename a value")
      return before != memo_name(value) && ir.name(value) == "memo_handle"
    }
  }
  return false
}

fn fresh_rename_probe(m: Mod) -> bool {
  for f in ir.fns(m) {
    for terminator in ir.ops(f) {
      if ir.kind(terminator) == "return" {
        let first = ir.constant(m, terminator, 0, ty("i32"))
        assert(ir.rename(m, first, "scratch_", 0) &&
               ir.name(first) == "scratch_0",
               "first fresh binding was not scratch_0")
        let second = ir.constant(m, terminator, 1, ty("i32"))
        assert(ir.rename(m, second, "scratch_1"),
               "explicit binding rename failed")
        let third = ir.constant(m, terminator, 2, ty("i32"))
        assert(ir.rename(m, third, "scratch_", 0) &&
               ir.name(third) == "scratch_2",
               "fresh binding did not observe an explicit rename")
        let copy = ir.clone(m, ir.def(first), terminator)
        assert(ir.live(copy) && ir.name(ir.outs(copy)[0]) == "scratch_0_1",
               "cloned binding did not receive its expected suffix")
        let fourth = ir.constant(m, terminator, 3, ty("i32"))
        return ir.rename(m, fourth, "scratch_0_", 1) &&
               ir.name(fourth) == "scratch_0_2"
      }
    }
  }
  return false
}

fn mark_first_param(m: Mod) -> bool {
  for f in ir.fns(m) {
    let values = ir.params(f)
    if len(values) != 0 {
      let value = values[0]
      return ir.set(m, value, "layout", "packed") &&
             ir.has(value, "layout") &&
             ir.meta(value, "layout") == "packed"
    }
  }
  return false
}

fn replace_first_use(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.callee(op) == "operator +" {
      let args = ir.args(op)
      let outs = ir.outs(op)
      if len(args) == 2 && len(outs) == 1 {
        if ir.is_const(args[1]) && ir.constant(args[1]) == 0 {
          let users = ir.users(outs[0])
          if len(users) > 1 {
            return ir.replace(m, outs[0], args[0], users[0])
          }
        }
      }
    }
  }
  return false
}

fn clone_loop(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      let copy = ir.clone(m, op, op)
      let old = ir.outs(op)
      let next = ir.outs(copy)
      if len(old) == 1 && len(next) == 1 {
        var changed = ir.replace(m, old[0], next[0])
        changed = ir.erase(m, op)
        return changed
      }
    }
  }
  return false
}

fn clone_remapped_loop(m: Mod) -> bool {
  for fn in ir.fns(m) {
    let params = ir.params(fn)
    if len(params) == 3 {
      for op in ir.ops(fn) {
        if ir.kind(op) == "loop" {
          let copy = ir.clone(m, op, op, [params[1]], [params[2]])
          return ir.live(copy)
        }
      }
    }
  }
  return false
}

fn reject_internal_clone(m: Mod) -> bool {
  for fn in ir.fns(m) {
    let params = ir.params(fn)
    if len(params) >= 3 {
      for op in ir.ops(fn) {
        if ir.kind(op) == "loop" {
          let args = ir.args(ir.blks(op)[0])
          if len(args) != 0 {
            let before = ir.revision(m)
            let copy = ir.clone(m, op, op, [args[0]], [params[2]])
            return !ir.live(copy) && ir.revision(m) == before
          }
        }
      }
    }
  }
  return false
}

fn split_first_loop(m: Mod, factor: int) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      return ir.live(tile.split(m, op, factor))
    }
  }
  return false
}

fn clone_relu(m: Mod) -> bool {
  for fn in ir.fns("nn") {
    if ir.name(fn) == "relu" {
      return ir.live(ir.clone(m, fn, "relu"))
    }
  }
  return false
}

fn clone_relu4(m: Mod) -> bool {
  for fn in ir.fns("nn") {
    if ir.name(fn) == "relu" {
      return ir.live(ir.clone(
        m, fn, "relu4", [ty("f32"), ty("[4]")]
      ))
    }
  }
  return false
}

fn clone_matched(m: Mod) -> bool {
  for op in ir.ops(m) {
    let fn = ir.resolve(m, op)
    if ir.live(fn) && ir.symbol(fn) == "nn.relu" {
      let generics = ir.match(op, fn)
      if len(generics) == 2 {
        let local = ir.clone(m, fn, "relu_matched", generics)
        assert(ir.live(local), "could not materialize matched function")
        assert(
          ir.rename(m, op, ir.symbol(local)),
          "could not retarget matched call"
        )
        return true
      }
    }
  }
  return false
}

fn clone_then_fail(m: Mod) -> bool {
  for op in ir.ops(m) {
    let fn = ir.resolve(m, op)
    if ir.live(fn) && ir.symbol(fn) == "nn.relu" {
      let local = ir.clone(m, fn, "orphan", ir.match(op, fn))
      assert(ir.live(local), "could not materialize matched function")
      assert(ir.rename(m, op, "invalid target"), "forced retarget failure")
      return true
    }
  }
  return false
}

fn rename_helper(m: Mod) -> bool {
  return ir.rename(m, ir.find(m, "helper"), "renamed")
}

fn erase_main(m: Mod) -> bool {
  return ir.erase(m, ir.find(m, "main"))
}

fn erase_renamed(m: Mod) -> bool {
  return ir.erase(m, ir.find(m, "renamed"))
}

fn retype_identity(m: Mod) -> bool {
  let f = ir.find(m, "identity")
  let params = ir.params(f)
  base.assert(len(params) == 1, "identity must have one parameter")
  ir.type(m, params[0], ty("i64"))
  return ir.returns(m, f, [ty("i64")])
}

fn type_batch(m: Mod) -> bool {
  var values: list<Val> = []
  for op in ir.ops(m) {
    if ir.callee(op) == "seed_x" {
      values += ir.outs(op)
    }
  }
  for op in ir.ops(m) {
    if ir.callee(op) == "seed_y" {
      values += ir.outs(op)
    }
  }
  assert(len(values) == 2, "type_batch requires two seed values")
  return ir.type(m, values, [ty("i32"), ty("f32")])
}

fn break_identity_return(m: Mod) -> bool {
  return ir.returns(m, ir.find(m, "identity"), [ty("bool")])
}

fn rewrite_call_generics(m: Mod) -> bool {
  let helper = ir.find(m, "helper")
  base.assert(len(ir.generics(helper)) == 1,
              "helper must declare one generic")
  for op in ir.ops(m) {
    let applied = ir.generics(op)
    if len(applied) == 1 && applied[0] == ty("4") {
      return ir.generics(m, op, [ty("5")])
    }
  }
  return false
}

fn return_three(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "return" {
      let args = ir.args(op)
      if len(args) == 1 {
        let three = ir.constant(m, op, 3, ty("i32"))
        var changed = ir.rename(m, three, "three")
        changed = ir.replace(m, args[0], three, op)
        return changed
      }
    }
  }
  return false
}

fn move_second_first(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.callee(op) == "second" {
      for before in ir.ops(m) {
        if ir.callee(before) == "first" {
          return ir.move(m, op, before)
        }
      }
    }
  }
  return false
}

fn reflect_fn(m: Mod) -> bool {
  let f = ir.find(m, "add_zero")
  return ir.live(f) && len(ir.params(f)) == 1 &&
         ir.returns(f) == [ty("i32")] &&
         !ir.live(ir.find(m, "missing"))
}

fn build_control(m: Mod) -> bool {
  for f in ir.fns(m) {
    let params = ir.params(f)
    if len(params) == 2 {
      for op in ir.ops(f) {
        if ir.kind(op) == "return" {
          let returned = ir.args(op)
          if len(returned) == 1 {
            let zero = ir.constant(m, op, 0, ty("int"))
            var changed = ir.rename(m, zero, "total")
            let range = ir.call(
              m, op, "operator ..", [zero, returned[0]], ty("range")
            )
            let loop = ir.loop(m, op, ["i"], [range], [zero])
            let body = ir.blks(loop)[0]
            let values = ir.args(body)
            let outer_yield = ir.ops(body)[0]
            let inner_range = ir.call(
              m, outer_yield, "operator ..", [zero, values[0]], ty("range")
            )
            let inner_loop = ir.loop(
              m, outer_yield, ["j"], [inner_range], [values[1]]
            )
            let inner_body = ir.blks(inner_loop)[0]
            let inner_values = ir.args(inner_body)
            let inner_yield = ir.ops(inner_body)[0]
            let sum_value = ir.call(
              m, inner_yield, "operator +",
              [inner_values[1], inner_values[0]], ty("int")
            )
            let sum = ir.assign(
              m, inner_yield, inner_values[1], sum_value
            )
            changed = ir.args(m, inner_yield, [sum])
            changed = ir.args(m, outer_yield, ir.outs(inner_loop))
            let branch = ir.branch(m, op, params[1], ir.outs(loop))
            let then = ir.blks(branch)[0]
            let then_yield = ir.ops(then)[0]
            let one = ir.constant(m, then_yield, 1, ty("int"))
            changed = ir.rename(m, one, "one")
            let increment_value = ir.call(
              m, then_yield, "operator +", [ir.args(then)[0], one], ty("int")
            )
            let increment = ir.assign(
              m, then_yield, ir.args(then)[0], increment_value
            )
            changed = ir.args(m, then_yield, [increment])
            changed = ir.args(m, op, ir.outs(branch))
            return changed
          }
        }
      }
    }
  }
  return false
}

fn rename_control(m: Mod) -> bool {
  var changed = false
  var first = true
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      if first {
        changed = ir.rename(m, ir.args(ir.blks(op)[0])[0], "outer")
        first = false
      } else {
        changed = ir.rename(m, ir.args(ir.blks(op)[0])[0], "inner")
      }
    }
    if ir.kind(op) == "branch" {
      changed = ir.rename(m, ir.args(ir.blks(op)[0])[0], "acc")
    }
  }
  return changed
}

fn clean_pure(m: Mod) -> bool {
  return opt.fix(m, ["pure"], 8)
}

fn affected_count(m: Mod) -> int {
  var roots: list<Val> = []
  for op in ir.ops(m) {
    if len(roots) == 0 && ir.callee(op) == "pure" {
      roots = ir.outs(op)
    }
  }
  return len(ir.affected(roots))
}

fn mark_affected_op(m: Mod, op: Op) -> bool {
  var changed = false
  for value in ir.outs(op) {
    if ir.name(value) != "" {
      changed = ir.set(m, value, "affected", true) || changed
    }
  }
  return changed
}

fn reject_affected_op(m: Mod, op: Op) -> bool {
  return ir.set(m, op, "rejected", true)
}

fn mark_affected(m: Mod) -> bool {
  var roots: list<Val> = []
  for op in ir.ops(m) {
    let outputs = ir.outs(op)
    if len(outputs) != 0 && ir.name(outputs[0]) == "a" {
      roots = outputs
    }
  }
  return opt.update(m, roots, ir.find("script.mark_affected_op"))
}

fn reject_affected(m: Mod) -> bool {
  var roots: list<Val> = []
  for op in ir.ops(m) {
    let outputs = ir.outs(op)
    if len(outputs) != 0 && ir.name(outputs[0]) == "a" {
      roots = outputs
    }
  }
  return opt.update(m, roots, ir.find("script.reject_affected_op"))
}

fn pure_op(m: Mod, op: Op) -> bool {
  return ir.callee(op) == "pure"
}

fn hoist_pure(m: Mod) -> bool {
  return opt.hoist(m, ir.find("script.pure_op"))
}

fn hoist_named(m: Mod) -> bool {
  return opt.hoist(m, ["pure"])
}

fn clean_tight(m: Mod) -> bool {
  return opt.fix(m, ["pure"], 1)
}

fn fold_controls(m: Mod) -> bool {
  var controls: list<Op> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" || ir.kind(op) == "branch" {
      controls += [op]
    }
  }
  return ir.fold(m, controls, ir.fns("base"))
}

fn reject_mixed_fold(m: Mod) -> bool {
  return ir.fold(m, ir.ops(m), ir.fns("base"))
}

fn trim(m: Mod) -> bool {
  return ir.trim(m)
}

fn prepare(m: Mod) -> bool {
  var changed = opt.fold_add_zero(m)
  changed = mark_add(m) || changed
  return changed
}

fn expand_network(m: Mod) -> bool {
  return opt.expand(m, ["operator +", "nn.relu"])
}

fn keep_relu(m: Mod) -> bool {
  return opt.legalize(m, typed_caps(), 8)
}

fn expose_network(m: Mod) -> bool {
  let caps: list<Fn> = []
  return opt.legalize(m, caps, 1)
}

fn network_frontier(m: Mod) -> list<str> {
  let caps: list<Fn> = []
  return opt.frontier(m, caps)
}

fn bridge_relu(m: Mod) -> bool {
  var changed = ir.use(m, "nn")
  changed = opt.rename(m, [["onnx.Relu", "nn.relu"]]) || changed
  return changed
}

fn has_use(m: Mod, module: str) -> bool {
  var found = false
  for dependency in ir.uses(m) {
    if dependency == module {
      found = true
    }
  }
  return found
}

fn type_opaque(m: Mod) -> bool {
  let shape = ty("[]", [ty(2), ty(3)])
  let tensor_type = ty("tensor", [ty("f32"), shape])
  for op in ir.ops(m) {
    if ir.callee(op) == "opaque" {
      return ir.type(m, ir.outs(op)[0], tensor_type)
    }
  }
  return false
}

fn elements(m: Mod, callee: str) -> int {
  var total = 0
  for op in ir.ops(m) {
    if ir.callee(op) == callee {
      let type = ir.type(ir.outs(op)[0])
      if name(type) == "tensor" && len(args(type)) == 2 {
        total = 1
        for dim in args(args(type)[1]) {
          total *= int(dim)
        }
      }
    }
  }
  return total
}

fn bad_entry(m: Mod) -> int {
  return 0
}

fn selected_entry(value: int) -> bool {
  return false
}

fn selected_entry(m: Mod) -> bool {
  return true
}

fn mutating_query(m: Mod, callee: str) -> int {
  let changed = opt.dce(m, [callee])
  return 0
}

fn handle_query(m: Mod) -> Fn {
  return ir.fns(m)[0]
}

fn attr_query(m: Mod, attrs: dict) -> int {
  if has(attrs, "axis") {
    return int(attrs["axis"])
  }
  return int(get(attrs, "axis", -1))
}

fn attr_mode(m: Mod, attrs: dict) -> str {
  return str(get(attrs, "mode", "none"))
}

fn attr_keys(m: Mod, attrs: dict) -> list<str> {
  return keys(attrs)
}

fn attr_sum(m: Mod, attrs: dict) -> int {
  var total = 0
  for value in attrs["values"] {
    total += value
  }
  return total
}

fn fail_after_control_rename(m: Mod) -> bool {
  let changed = rename_control(m)
  return missing(changed)
}

fn invalidate_call(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.callee(op) == "pure" {
      return ir.rename(m, op, "base.len")
    }
  }
  return false
}

fn duplicate_local(m: Mod) -> bool {
  for f in ir.fns(m) {
    for value in ir.vals(f) {
      if ir.name(value) == "right" {
        return ir.rename(m, value, "left")
      }
    }
  }
  return false
}

fn hide_loop_input(m: Mod) -> bool {
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      let body_args = ir.args(ir.blks(op)[0])
      if len(body_args) != 0 {
        return ir.rename(m, body_args[0], "n")
      }
    }
  }
  return false
}

fn rebuild_tagged(m: Mod) -> bool {
  var changed = false
  for f in ir.fns(m) {
    if ir.has(f, "rename") {
      let target = ir.meta(f, "rename")
      for b in ir.blks(f) {
        for op in ir.ops(b) {
          if ir.callee(op) == "operator +" {
            let outs = ir.outs(op)
            if len(outs) == 1 && len(ir.users(outs[0])) == 1 {
              let next = ir.call(
                m, op, str(target), ir.args(op), ir.type(outs[0])
              )
              changed = ir.replace(m, outs[0], next)
              changed = ir.erase(m, op)
            }
          }
        }
      }
    }
  }
  return changed
}

fn owner_probe(m: Mod) -> bool {
  for f in ir.fns(m) {
    let bodies = ir.blks(f)
    if len(bodies) != 0 {
      assert(!ir.live(ir.op(bodies[0])), "root block must not have an owner op")
      for i in 1..len(bodies) {
        let owner = ir.op(bodies[i])
        assert(ir.live(owner), "nested block must have an owner op")
        var found = false
        for body in ir.blks(owner) {
          found = found || body == bodies[i]
        }
        assert(found, "block owner must contain the nested block")
      }
    }
  }
  return true
}

fn op_kind_counts(m: Mod) -> list<int> {
  return [
    len(ir.ops(m, ["call"])),
    len(ir.ops(m, ["loop", "branch"])),
    len(ir.ops(m, []))
  ]
}

fn unused_probe(m: Mod, name: str) -> list<int> {
  let blocks = ir.blks(ir.find(m, name))
  assert(len(blocks) == 1, "unused probe requires one root block")
  let operations = ir.ops(blocks[0])
  var removable: list<Op> = []
  for op in operations {
    let kind = ir.kind(op)
    if kind == "constant" || kind == "call" {
      removable += [op]
    }
  }
  return [len(operations), len(removable),
          len(ir.unused(operations, removable))]
}

fn call_filter_counts(m: Mod, name: str) -> list<int> {
  let blocks = ir.blks(ir.find(m, name))
  assert(len(blocks) == 1, "call filter probe requires one root block")
  let calls = ir.ops(blocks[0], ["call"])
  return [
    len(ir.calls(m, calls, ["base.operator +"])),
    len(ir.calls(m, calls, ["operator +"])),
    len(ir.calls(m, calls, ["script.missing"]))
  ]
}

fn path_roundtrip(m: Mod, name: str) -> bool {
  let fn = ir.find(m, name)
  if !ir.live(fn) {
    return false
  }
  for op in ir.ops(fn) {
    let path = ir.path(m, op)
    if len(path) == 0 || ir.at(m, fn, path) != op {
      return false
    }
  }
  return true
}

fn mutating_cap(m: Mod, op: Op) -> bool {
  return ir.set(m, op, "invalid_capability_side_effect", true)
}

fn schedule_mark_a(m: Mod, name: str) -> bool {
  let target = ir.find(m, name)
  assert(ir.live(target), "schedule target not found: " + name)
  return ir.set(m, target, "schedule.a", ir.revision(target))
}

fn schedule_mark_b(m: Mod, name: str) -> bool {
  let target = ir.find(m, name)
  assert(ir.live(target), "schedule target not found: " + name)
  return ir.set(m, target, "schedule.b", ir.revision(target))
}

local fn schedule_root(m: Mod, owner: str, name: str) -> Val {
  let values = ir.vals(ir.find(m, owner))
  assert(len(values) != 0, "schedule function has no values: " + owner)
  for value in values {
    if ir.live(value) && ir.name(value) == name {
      return value
    }
  }
  assert(false, "schedule value not found: " + name)
  return values[0]
}

local fn schedule_cone(m: Mod, owner: str, name: str, key: str) -> bool {
  var changed = false
  for op in ir.affected([schedule_root(m, owner, name)]) {
    changed = ir.set(m, op, key, true) || changed
  }
  return changed
}

fn schedule_cone_a(m: Mod, owner: str, name: str) -> bool {
  return schedule_cone(m, owner, name, "schedule.cone.a")
}

fn schedule_cone_b(m: Mod, owner: str, name: str) -> bool {
  return schedule_cone(m, owner, name, "schedule.cone.b")
}

fn schedule_constant(m: Mod, owner: str, index: int) -> bool {
  let operations = ir.ops(ir.find(m, owner))
  assert(index >= 0 && index < len(operations),
         "schedule constant index is out of range")
  let op = operations[index]
  assert(ir.kind(op) == "constant" && len(ir.outs(op)) == 1,
         "schedule target is not a constant")
  ir.constant(ir.outs(op)[0])
  return false
}

fn schedule_forward(m: Mod, source: str, target: str) -> bool {
  let input = ir.find(m, source)
  let output = ir.find(m, target)
  assert(ir.live(input) && ir.live(output), "schedule endpoint not found")
  return ir.set(m, output, "schedule.forward", ir.revision(input))
}

fn schedule_consume(m: Mod, source: str, target: str) -> bool {
  let unused = source
  let input = ir.find(m, target)
  assert(ir.live(input), "schedule target not found: " + target)
  return ir.set(m, input, "schedule.consume", ir.revision(input))
}

fn schedule_fail(m: Mod, name: str) -> bool {
  let target = ir.find(m, name)
  assert(ir.live(target), "schedule target not found: " + name)
  ir.set(m, target, "schedule.failed", true)
  assert(false, "scheduled failure")
  return false
}

fn expose_with_mutating_cap(m: Mod) -> bool {
  return opt.expose(m, ir.find("script.mutating_cap"), 4)
}

[entry]
fn fuse_onnx(m: Mod) -> bool {
  return opt.fuse(
    m,
    ["onnx.Conv", "onnx.BatchNormalization", "onnx.Relu"],
    "test.conv_bn_relu"
  )
}
