mod dynamic_c
use tensor

fn static_result(x: tensor<i32, [3]>) -> tensor<i32, [_]> {
  return x
}

fn prefix() -> tensor<i32, [_, 2]> {
  let rows: index = index(3)

  var capacity_shape = tensor<index, [2]>(index(0))
  capacity_shape[0] = index(4)
  capacity_shape[1] = index(2)
  var data: tensor<i32, [_, 2]> = tensor.make(i32(0), capacity_shape)
  for i in index(0)..index(4), j in index(0)..index(2) {
    data[i, j] = i32(7)
  }

  var result_shape = tensor<index, [2]>(index(0))
  result_shape[0] = rows
  result_shape[1] = index(2)
  return tensor.view(data, result_shape)
}

fn sum(x: tensor<i32, [_, 2]>) -> i32 {
  let rows = tensor.dim(x, index(0))
  var total = i32(0)
  for i in index(0)..rows, j in index(0)..index(2) {
    total += x[i, j]
  }
  return total
}

fn gather_last(x: tensor<i32, [_, 2]>) -> tensor<i32, [1, 2]> {
  let indices = tensor<index, [1]>(index(-1))
  return tensor.gather(x, indices, -2)
}

fn gather_middle(
  x: tensor<i32, [2, _, 2]>, indices: tensor<index, [_]>
) -> tensor<i32, [2, 2, 2]> {
  return tensor.gather(x, indices, 1)
}

fn gather_scalar(x: tensor<i32, [_, 2]>) -> tensor<i32, [2]> {
  let index = tensor<index, []>(index(-1))
  return tensor.gather(x, index, 0)
}

fn gather_i32(x: tensor<i32, [_, 2]>) -> tensor<i32, [1, 2]> {
  let indices = tensor<i32, [1]>(i32(-1))
  return tensor.gather(x, indices, 0)
}

fn shape(x: tensor<i32, [_, 2]>) -> tensor<i64, [2]> {
  return tensor.shape(x)
}

fn updated(x: tensor<i32, [3]>) -> tensor<i32, [3]> {
  let y: tensor<i32, [3]> = tensor.[]=(x, index(1), i32(9))
  return y
}

fn tile(x: tensor<i32, [2, 3]>, repeats: tensor<i64, [2]>)
    -> tensor<i32, [4, 6]> {
  return tensor.tile(x, repeats)
}

fn tile_empty(x: tensor<i32, [2, 3]>, repeats: tensor<i64, [2]>)
    -> tensor<i32, [0, 6]> {
  return tensor.tile(x, repeats)
}

fn tile_bounded(x: tensor<i32, [2, 3]>, twice: bool)
    -> tensor<i32, [_, _]> {
  var factor = index(1)
  if twice { factor = index(2) }
  var repeats = tensor<index, [2]>(index(1))
  repeats[0] = factor
  repeats[1] = factor
  return tensor.tile(x, repeats)
}
