joggle 1;

module prelude@2.0.0 {
  interface scalar: type {
    storage_bits: int;
  }
  interface numeric: type;
  interface integer: type;
  interface signed_integer: type;
  interface unsigned_integer: type;
  interface floating_point: type;
  interface logical: type;
  interface index_type: type;
  interface literal: fn;

  type type();
  type int();
  type real();
  type bool();
  type string();
  type attr();
  type bytes();
  type function();
  type module();
  type callable(inputs: list<type>, results: list<type>);
  type list(element: type);
  type i1() : scalar, logical {
    storage_bits = 1;
  }
  type i8() : scalar, numeric, integer, signed_integer {
    storage_bits = 8;
  }
  type i16() : scalar, numeric, integer, signed_integer {
    storage_bits = 16;
  }
  type i32() : scalar, numeric, integer, signed_integer {
    storage_bits = 32;
  }
  type i64() : scalar, numeric, integer, signed_integer {
    storage_bits = 64;
  }
  type u8() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 8;
  }
  type u16() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 16;
  }
  type u32() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 32;
  }
  type u64() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 64;
  }
  type f16() : scalar, numeric, floating_point {
    storage_bits = 16;
  }
  type bf16() : scalar, numeric, floating_point {
    storage_bits = 16;
  }
  type f32() : scalar, numeric, floating_point {
    storage_bits = 32;
  }
  type f64() : scalar, numeric, floating_point {
    storage_bits = 64;
  }
  type index() : numeric, integer, unsigned_integer, index_type;

  fn positive(value: int) -> int as +;
  fn positive(value: real) -> real as +;
  fn negative(value: int) -> int as -;
  fn negative(value: real) -> real as -;
  fn add(lhs: int, rhs: int) -> int as +;
  fn add(lhs: real, rhs: real) -> real as +;
  fn subtract(lhs: int, rhs: int) -> int as -;
  fn subtract(lhs: real, rhs: real) -> real as -;
  fn multiply(lhs: int, rhs: int) -> int as *;
  fn multiply(lhs: real, rhs: real) -> real as *;
  fn divide(lhs: int, rhs: int) -> int as /;
  fn divide(lhs: real, rhs: real) -> real as /;
  fn floor_divide(lhs: int, rhs: int) -> int as //;
  fn floor_divide(lhs: real, rhs: real) -> real as //;
  fn remainder(lhs: int, rhs: int) -> int as %;
  fn less(lhs: int, rhs: int) -> bool as <;
  fn less(lhs: real, rhs: real) -> bool as <;
  fn less_equal(lhs: int, rhs: int) -> bool as <=;
  fn less_equal(lhs: real, rhs: real) -> bool as <=;
  fn greater(lhs: int, rhs: int) -> bool as >;
  fn greater(lhs: real, rhs: real) -> bool as >;
  fn greater_equal(lhs: int, rhs: int) -> bool as >=;
  fn greater_equal(lhs: real, rhs: real) -> bool as >=;
  fn equal(lhs: int, rhs: int) -> bool as ==;
  fn equal(lhs: real, rhs: real) -> bool as ==;
  fn equal(lhs: bool, rhs: bool) -> bool as ==;
  fn equal(lhs: string, rhs: string) -> bool as ==;
  fn not_equal(lhs: int, rhs: int) -> bool as !=;
  fn not_equal(lhs: real, rhs: real) -> bool as !=;
  fn not_equal(lhs: bool, rhs: bool) -> bool as !=;
  fn not_equal(lhs: string, rhs: string) -> bool as !=;
  fn logical_not(value: bool) -> bool as !;
  fn logical_and(lhs: bool, rhs: bool) -> bool as &&;
  fn logical_or(lhs: bool, rhs: bool) -> bool as ||;
  fn ceildiv(lhs: int, rhs: int) -> int;
  fn min(lhs: int, rhs: int) -> int;
  fn min(lhs: real, rhs: real) -> real;
  fn max(lhs: int, rhs: int) -> int;
  fn max(lhs: real, rhs: real) -> real;
  fn range(stop: int) -> list<int>;
  fn range(start: int, stop: int) -> list<int>;
  fn range(start: int, stop: int, step: int) -> list<int>;
}
