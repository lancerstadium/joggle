joggle 1;

module prelude@3.0.0 {
  interface scalar: type {
    storage_bits: int;
  }
  interface numeric: type;
  interface integer: type;
  interface signed_integer: type;
  interface unsigned_integer: type;
  interface floating_point: type;
  interface logical: type;
  interface index_type: type;
  interface literal: fn;

  type type();
  type int();
  type real();
  type bool();
  type string();
  type attr();
  type bytes();
  type function();
  type module();
  type callable(inputs: list<type>, results: list<type>);
  type list(element: type);
  type i1() : scalar, logical {
    storage_bits = 1;
  }
  type i8() : scalar, numeric, integer, signed_integer {
    storage_bits = 8;
  }
  type i16() : scalar, numeric, integer, signed_integer {
    storage_bits = 16;
  }
  type i32() : scalar, numeric, integer, signed_integer {
    storage_bits = 32;
  }
  type i64() : scalar, numeric, integer, signed_integer {
    storage_bits = 64;
  }
  type u8() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 8;
  }
  type u16() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 16;
  }
  type u32() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 32;
  }
  type u64() : scalar, numeric, integer, unsigned_integer {
    storage_bits = 64;
  }
  type f16() : scalar, numeric, floating_point {
    storage_bits = 16;
  }
  type bf16() : scalar, numeric, floating_point {
    storage_bits = 16;
  }
  type f32() : scalar, numeric, floating_point {
    storage_bits = 32;
  }
  type f64() : scalar, numeric, floating_point {
    storage_bits = 64;
  }
  type index() : numeric, integer, unsigned_integer, index_type;

  fn (+)(value: int) -> int;
  fn (+)(value: real) -> real;
  fn (-)(value: int) -> int;
  fn (-)(value: real) -> real;
  fn (+)(lhs: int, rhs: int) -> int;
  fn (+)(lhs: real, rhs: real) -> real;
  fn (-)(lhs: int, rhs: int) -> int;
  fn (-)(lhs: real, rhs: real) -> real;
  fn (*)(lhs: int, rhs: int) -> int;
  fn (*)(lhs: real, rhs: real) -> real;
  fn (/)(lhs: int, rhs: int) -> int;
  fn (/)(lhs: real, rhs: real) -> real;
  fn (//)(lhs: int, rhs: int) -> int;
  fn (//)(lhs: real, rhs: real) -> real;
  fn (%)(lhs: int, rhs: int) -> int;
  fn (<)(lhs: int, rhs: int) -> bool;
  fn (<)(lhs: real, rhs: real) -> bool;
  fn (<=)(lhs: int, rhs: int) -> bool;
  fn (<=)(lhs: real, rhs: real) -> bool;
  fn (>)(lhs: int, rhs: int) -> bool;
  fn (>)(lhs: real, rhs: real) -> bool;
  fn (>=)(lhs: int, rhs: int) -> bool;
  fn (>=)(lhs: real, rhs: real) -> bool;
  fn (==)(lhs: int, rhs: int) -> bool;
  fn (==)(lhs: real, rhs: real) -> bool;
  fn (==)(lhs: bool, rhs: bool) -> bool;
  fn (==)(lhs: string, rhs: string) -> bool;
  fn (!=)(lhs: int, rhs: int) -> bool;
  fn (!=)(lhs: real, rhs: real) -> bool;
  fn (!=)(lhs: bool, rhs: bool) -> bool;
  fn (!=)(lhs: string, rhs: string) -> bool;
  fn (!)(value: bool) -> bool;
  fn (&&)(lhs: bool, rhs: bool) -> bool;
  fn (||)(lhs: bool, rhs: bool) -> bool;
  fn ceildiv(lhs: int, rhs: int) -> int;
  fn min(lhs: int, rhs: int) -> int;
  fn min(lhs: real, rhs: real) -> real;
  fn max(lhs: int, rhs: int) -> int;
  fn max(lhs: real, rhs: real) -> real;
  fn range(stop: int) -> list<int>;
  fn range(start: int, stop: int) -> list<int>;
  fn range(start: int, stop: int, step: int) -> list<int>;
  fn length(values: list<int>) -> int;
  fn length(values: list<real>) -> int;
  fn length(values: list<bool>) -> int;
  fn length(values: list<string>) -> int;
  fn length(values: list<type>) -> int;
  fn length(values: list<attr>) -> int;
  fn at(values: list<int>, index: int) -> int;
  fn at(values: list<real>, index: int) -> real;
  fn at(values: list<bool>, index: int) -> bool;
  fn at(values: list<string>, index: int) -> string;
  fn at(values: list<type>, index: int) -> type;
  fn at(values: list<attr>, index: int) -> attr;
  fn append(values: list<int>, value: int) -> list<int>;
  fn append(values: list<real>, value: real) -> list<real>;
  fn append(values: list<bool>, value: bool) -> list<bool>;
  fn append(values: list<string>, value: string) -> list<string>;
  fn append(values: list<type>, value: type) -> list<type>;
  fn append(values: list<attr>, value: attr) -> list<attr>;
}
