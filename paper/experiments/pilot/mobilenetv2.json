{
  "schema": 1,
  "study": "mobilenetv2",
  "trials": 20,
  "subjects": [
    {
      "name": "joggle-c",
      "command": [
        "build-app/examples/mobilenet/model-blob",
        "build-app/examples/mobilenet/input.bin",
        "build-app/examples/mobilenet/model.bin",
        "build-app/examples/mobilenet/expected.bin",
        "3",
        "1"
      ],
      "artifacts": {
        "source": "build-app/examples/mobilenet/model-blob.c",
        "header": "build-app/examples/mobilenet/model-blob.h",
        "executable": "build-app/examples/mobilenet/model-blob",
        "input": "build-app/examples/mobilenet/input.bin",
        "weights": "build-app/examples/mobilenet/model.bin",
        "reference": "build-app/examples/mobilenet/expected.bin"
      },
      "version_command": [
        "/usr/bin/clang",
        "--version"
      ]
    },
    {
      "name": "onnxruntime",
      "command": [
        "python3",
        "paper/bench_onnxruntime.py",
        ".cache/onnx-zoo/app/mobilenetv2-7/mobilenetv2-7.onnx",
        "build-app/examples/mobilenet/input.bin",
        "build-app/examples/mobilenet/expected.bin",
        "--warmup",
        "3",
        "--repetitions",
        "1",
        "--atol",
        "0.0001",
        "--rtol",
        "0.0001",
        "--protocol"
      ],
      "artifacts": {
        "model": ".cache/onnx-zoo/app/mobilenetv2-7/mobilenetv2-7.onnx",
        "input": "build-app/examples/mobilenet/input.bin",
        "reference": "build-app/examples/mobilenet/expected.bin"
      },
      "version_command": [
        "python3",
        "-c",
        "import onnxruntime as ort; print(ort.__version__)"
      ]
    }
  ]
}
