{
  "schema": 2,
  "study": "mobilenetv2-fusion",
  "trials": 20,
  "subjects": [
    {
      "system": "joggle",
      "command": [
        "build-fusion/fused/model",
        "build-app/examples/mobilenet/input.bin",
        "build-fusion/fused/model.bin",
        "build-app/examples/mobilenet/expected.bin",
        "3", "1"
      ],
      "artifacts": {
        "source": "build-fusion/fused/model.c",
        "header": "build-fusion/fused/model.h",
        "executable": "build-fusion/fused/model",
        "input": "build-app/examples/mobilenet/input.bin",
        "weights": "build-fusion/fused/model.bin",
        "reference": "build-app/examples/mobilenet/expected.bin"
      },
      "version_command": ["cc", "--version"]
    },
    {
      "system": "onnxruntime",
      "command": [
        "python3", "paper/scripts/bench_onnxruntime.py",
        ".cache/onnx-zoo/app/mobilenetv2-7/mobilenetv2-7.onnx",
        "build-app/examples/mobilenet/input.bin",
        "build-app/examples/mobilenet/expected.bin",
        "--warmup", "3", "--repetitions", "1",
        "--atol", "0.0001", "--rtol", "0.0001", "--protocol"
      ],
      "artifacts": {
        "model": ".cache/onnx-zoo/app/mobilenetv2-7/mobilenetv2-7.onnx",
        "input": "build-app/examples/mobilenet/input.bin",
        "reference": "build-app/examples/mobilenet/expected.bin"
      },
      "version_command": [
        "python3", "-c",
        "import onnxruntime as ort; print(ort.__version__)"
      ]
    }
  ]
}
