module main
use ir
use tensor

// A minimal reproduction of the failure that strands SSD-MobileNetV1's
// preparation. A tensor.cast whose result is used more than once leaves a call
// with an empty callee name behind, and preparation stops on it.
//
//   return tensor.cast(x)                  prepares
//   let f = tensor.cast(x)  return f       prepares
//   let f = tensor.cast(x)  return f + f   fails: "c: unsupported call remains: _"
//
// The model's first operation is the same shape of thing: one cast of the entry
// tensor from u8 to f32, consumed by tensor.shape and by everything downstream.
fn main(x: tensor<u8, [4]>) -> tensor<f32, [4]> {
  let f = tensor.cast(x)
  return f + f
}
