{
  "schema": 2,
  "study": "tflite-mobilenetv2",
  "trials": 20,
  "subjects": [
    {
      "system": "joggle",
      "command": [
        "build-tflite-study/model",
        "build-tflite-study/input.bin",
        "build-tflite-study/model.bin",
        "build-tflite-study/expected.bin",
        "3", "1"
      ],
      "artifacts": {
        "source": "build-tflite-study/model.c",
        "header": "build-tflite-study/model.h",
        "executable": "build-tflite-study/model",
        "input": "build-tflite-study/input.bin",
        "weights": "build-tflite-study/model.bin",
        "reference": "build-tflite-study/expected.bin"
      },
      "version_command": ["cc", "--version"]
    },
    {
      "system": "litert",
      "command": [
        "python3", "paper/scripts/bench_litert.py",
        ".cache/models/mobilenet_v2.tflite",
        "build-tflite-study/input.bin",
        "build-tflite-study/expected.bin",
        "--warmup", "3", "--repetitions", "1",
        "--atol", "0.0001", "--rtol", "0.0001", "--protocol"
      ],
      "artifacts": {
        "model": ".cache/models/mobilenet_v2.tflite",
        "input": "build-tflite-study/input.bin",
        "reference": "build-tflite-study/expected.bin"
      },
      "version_command": [
        "python3", "-c",
        "import ai_edge_litert; print(ai_edge_litert.__version__)"
      ]
    }
  ]
}
