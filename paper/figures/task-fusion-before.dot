  edge [arrowsize=0.48, penwidth=0.65, color="#52616B",
        fontname="DejaVu Sans Mono", fontsize=6];
x [label="x\nNHWC / i8",shape=ellipse,fillcolor="#E9F3FF"];
w [label="w\nHWIO / i8",shape=ellipse,fillcolor="#E9F3FF"];
c [label="qconv"];
