    "system_revision": "string",
    "subject": "string",
    "subject_hash": "string",
    "total_ops": "uint64",
    "affected_ops": "uint64",
    "fanout": "uint64",
    "stages": "uint64",
    "edit_class": "enum:no_op|operation_metadata|value_type",
    "edit_scope": "enum:none|affected|unrelated",
    "edit_site": "string",
    "policy": "enum:full|reactive|whole-mod|no-plan-cache",
    "cache_state": "enum:warm",
    "iteration": "uint64",
    "wall_ns": "uint64",
    "select_ns": "uint64",
    "evaluate_ns": "uint64",
    "verify_ns": "uint64",
    "executed_stages": "uint64",
    "reused_stages": "uint64",
    "observed_ops": "uint64",
    "observed_values": "uint64",
    "changed_functions": "uint64",
    "evaluated_ops": "uint64",
    "plan_compiles": "uint64",
    "plan_hits": "uint64",
    "miss_reason": "string",
    "output_digest": "hex64",
    "correct": "bool",
    "seed": "uint64"
