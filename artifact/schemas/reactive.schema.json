{
  "name": "reactive-update",
  "version": 2,
  "primary_key": [
    "system",
    "system_revision",
    "subject",
    "subject_hash",
    "edit_class",
    "edit_scope",
    "edit_site",
    "stages",
    "policy",
    "cache_state",
    "iteration",
    "seed"
  ],
  "columns": {
