        {"id": "dot4", "input": {"target": "generic64-dot4", "pointer_bits": 64, "little_endian": true, "features": ["dot4", "simd128"], "intrinsics": ["dot4_i8(vector<4xi8>,vector<4xi8>,i32)->i32"]}, "expect": {"canonical_sha256": "oracle-computed"}},
        {"id": "sorted-portable", "input": {"target": "generic32-be", "pointer_bits": 32, "little_endian": false, "features": ["simd128", "dot4", "atomics"], "intrinsics": ["zext(i8)->i32", "add(i32,i32)->i32"], "host_path": "/temporary/host-only", "timestamp": "2030-01-01T00:00:00Z"}, "expect": {"canonical_sha256": "oracle-computed"}},
        {"id": "duplicate-names", "input": {"target": "generic64", "pointer_bits": 64, "little_endian": true, "features": ["simd128", "dot4", "simd128"], "intrinsics": ["zext(i8)->i32", "add(i32,i32)->i32", "add(i32,i32)->i32"]}, "expect": {"canonical_sha256": "oracle-computed"}}
      ],
      "negative_cases": [],
      "oracle": {"phases": ["build", "semantic"], "comparison": "exact-json"}
    },
    {
      "id": "vert-int4",
      "family": "vertical",
      "title": "Four-bit numeric format",
      "footprint": true,
      "required_roles": ["definition", "analysis", "conversion", "emission"],
      "contract": "Add signed qint4 values in [-8,7], packed low nibble first; provide range analysis, lower elementwise add through i8 with saturation, and emit packed bytes.",
      "positive_cases": [
