        {"id": "even-count", "input": {"lhs": [2, -3, 4, -5], "rhs": [3, 1, -2, -4]}, "expect": {"values": [5, -2, 2, -8], "bytes_hex": "e5 82", "range": [-8, 7]}}
      ],
      "negative_cases": [
        {"id": "literal-out-of-range", "input": {"values": [0, 8]}, "expect": {"error": "literal-out-of-range", "phase": "build"}}
      ],
      "oracle": {"phases": ["parse", "type", "build", "semantic"], "comparison": "exact-json"}
    },
    {
      "id": "vert-fused-op",
