    {
      "id": "vert-input-format",
      "family": "vertical",
      "title": "Graph input format",
      "footprint": false,
      "required_roles": ["definition", "conversion"],
      "contract": "Add a line-oriented graph format with typed inputs, constants, add, mul, relu, and return; parse it into the common graph, preserve semantics through canonical round-trip, and reject undefined values.",
      "positive_cases": [
        {"id": "linear", "input": {"text": "input %x tensor<4xf32>\n%z = const 0.0 tensor<4xf32>\n%y = add %x %z\nreturn %y"}, "expect": {"node_ops": ["input", "const", "add", "return"], "roundtrip_stable": true}},
        {"id": "branched", "input": {"text": "input %x tensor<2xf32>\n%a = relu %x\n%b = mul %a %a\nreturn %b"}, "expect": {"node_ops": ["input", "relu", "mul", "return"], "roundtrip_stable": true}}
      ],
      "negative_cases": [
        {"id": "undefined-value", "input": {"text": "input %x tensor<2xf32>\n%y = add %x %missing\nreturn %y"}, "expect": {"error": "undefined-value", "phase": "build"}},
        {"id": "syntax", "input": {"text": "input %x tensor<2xf32\nreturn %x"}, "expect": {"error": "syntax-error", "phase": "parse"}}
      ],
      "oracle": {"phases": ["parse", "type", "build", "semantic"], "comparison": "canonical-graph"}
    }
  ]
