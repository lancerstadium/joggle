    {
      "id": "emit-storage-plan",
      "family": "emission",
      "title": "Storage plan report",
      "footprint": false,
      "required_roles": ["emission"],
      "contract": "Emit deterministic JSON allocations and peak occupied bytes for statically sized temporaries in topological order. Assign the lowest available nonnegative offset aligned to 16 bytes; closed live intervals sharing an endpoint overlap, and zero-byte values occupy no storage. Reuse storage across non-overlapping live intervals.",
      "positive_cases": [
        {"id": "reuse", "input": {"values": [{"id": "v0", "bytes": 16, "live": [0, 1]}, {"id": "v1", "bytes": 16, "live": [2, 3]}]}, "expect": {"allocations": [{"id": "v0", "offset": 0}, {"id": "v1", "offset": 0}], "peak_bytes": 16}},
        {"id": "overlap", "input": {"values": [{"id": "v0", "bytes": 20, "live": [0, 3]}, {"id": "v1", "bytes": 8, "live": [1, 2]}]}, "expect": {"allocations": [{"id": "v0", "offset": 0}, {"id": "v1", "offset": 32}], "peak_bytes": 40}},
        {"id": "shared-endpoint", "input": {"values": [{"id": "v0", "bytes": 16, "live": [0, 1]}, {"id": "v1", "bytes": 16, "live": [1, 2]}]}, "expect": {"allocations": [{"id": "v0", "offset": 0}, {"id": "v1", "offset": 16}], "peak_bytes": 32}},
        {"id": "first-fit-hole", "input": {"values": [{"id": "v0", "bytes": 16, "live": [0, 6]}, {"id": "v1", "bytes": 32, "live": [1, 2]}, {"id": "v2", "bytes": 16, "live": [2, 5]}, {"id": "v3", "bytes": 24, "live": [3, 4]}]}, "expect": {"allocations": [{"id": "v0", "offset": 0}, {"id": "v1", "offset": 16}, {"id": "v2", "offset": 48}, {"id": "v3", "offset": 16}], "peak_bytes": 64}},
        {"id": "zero-storage", "input": {"values": [{"id": "v0", "bytes": 32, "live": [0, 3]}, {"id": "v1", "bytes": 0, "live": [1, 2]}]}, "expect": {"allocations": [{"id": "v0", "offset": 0}, {"id": "v1", "offset": 0}], "peak_bytes": 32}},
        {"id": "empty", "input": {"values": []}, "expect": {"allocations": [], "peak_bytes": 0}}
      ],
      "negative_cases": [
        {"id": "dynamic-size", "input": {"values": [{"id": "v0", "bytes": "dynamic", "live": [0, 1]}]}, "expect": {"error": "dynamic-storage-size", "phase": "build"}}
      ],
      "oracle": {"phases": ["build", "semantic"], "comparison": "exact-json"}
    },
    {
      "id": "emit-target-capability",
      "family": "emission",
