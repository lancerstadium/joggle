        {"id": "relu-clamp", "input": {"x": [[[[1]]]], "w": [[[[-2]]]], "bias": [0], "scales": {"acc": 0.5, "out": 0.5}, "output_zero": 0}, "expect": {"values": [[[[0]]]], "node_ops": ["fused_qconv_relu"]}}
      ],
