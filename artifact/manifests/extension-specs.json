        {"id": "scalar-fallback", "input": {"op": "add(a,b)", "length": 6, "a": [0, 1, 2, 3, 4, 5], "b": [5, 4, 3, 2, 1, 0]}, "expect": {"forbidden_ops": ["vload4"], "values": [5, 5, 5, 5, 5, 5]}}
      ],
