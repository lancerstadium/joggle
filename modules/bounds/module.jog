mod bounds
use base
use ir
use tensor

local fn integer(type: Ty) -> bool {
  let name = base.name(type)
  return name == "bool" || name == "int" || name == "index" ||
         name == "i8" || name == "i16" || name == "i32" || name == "i64" ||
         name == "u8" || name == "u16" || name == "u32" || name == "u64"
}

local fn limits(type: Ty) -> list<int> {
  let name = base.name(type)
  let values = {
    "bool.lo": 0, "bool.hi": 1,
    "i8.lo": -128, "i8.hi": 127,
    "i16.lo": -32768, "i16.hi": 32767,
    "i32.lo": -2147483648, "i32.hi": 2147483647,
    "i64.lo": -9223372036854775808, "i64.hi": 9223372036854775807,
    "index.lo": -9223372036854775808,
    "index.hi": 9223372036854775807,
    "int.lo": -9223372036854775808,
    "int.hi": 9223372036854775807,
    "u8.lo": 0, "u8.hi": 255,
    "u16.lo": 0, "u16.hi": 65535,
    "u32.lo": 0, "u32.hi": 4294967295
  }
  if !base.has(values, name + ".lo") {
    return []
  }
  return [base.int(values[name + ".lo"]), base.int(values[name + ".hi"])]
}

local fn id(value: Val) -> str {
  return text(ir.key(value))
}

fn get(known: dict, value: Val) -> list<int> {
  let value_id = id(value)
  if !base.has(known, value_id + ".lo") ||
     !base.has(known, value_id + ".hi") {
    return []
  }
  return [
    base.int(known[value_id + ".lo"]),
    base.int(known[value_id + ".hi"])
  ]
}

local fn add_value(left: int, right: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if (right > 0 && left > high - right) ||
     (right < 0 && left < low - right) {
    return []
  }
  return [left + right]
}

local fn sub_value(left: int, right: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if (right < 0 && left > high + right) ||
     (right > 0 && left < low + right) {
    return []
  }
  return [left - right]
}

local fn mul_value(left: int, right: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if left > 0 {
    if (right > 0 && left > high / right) ||
       (right < 0 && right < low / left) {
      return []
    }
  } else {
    if left < 0 {
      if (right > 0 && left < low / right) ||
         (right < 0 && right < high / left) {
        return []
      }
    }
  }
  return [left * right]
}

local fn add(left: list<int>, right: list<int>) -> list<int> {
  if len(left) != 2 || len(right) != 2 {
    return []
  }
  let lo = add_value(left[0], right[0])
  let hi = add_value(left[1], right[1])
  if len(lo) == 0 || len(hi) == 0 {
    return []
  }
  return [lo[0], hi[0]]
}

local fn sub(left: list<int>, right: list<int>) -> list<int> {
  if len(left) != 2 || len(right) != 2 {
    return []
  }
  let lo = sub_value(left[0], right[1])
  let hi = sub_value(left[1], right[0])
  if len(lo) == 0 || len(hi) == 0 {
    return []
  }
  return [lo[0], hi[0]]
}

local fn mul(left: list<int>, right: list<int>) -> list<int> {
  if len(left) != 2 || len(right) != 2 {
    return []
  }
  let aa = mul_value(left[0], right[0])
  let ab = mul_value(left[0], right[1])
  let ba = mul_value(left[1], right[0])
  let bb = mul_value(left[1], right[1])
  if len(aa) == 0 || len(ab) == 0 || len(ba) == 0 || len(bb) == 0 {
    return []
  }
  var lo = aa[0]
  var hi = aa[0]
  for value in [ab[0], ba[0], bb[0]] {
    if value < lo {
      lo = value
    }
    if value > hi {
      hi = value
    }
  }
  return [lo, hi]
}

local fn neg(value: list<int>) -> list<int> {
  if len(value) != 2 || value[0] == -9223372036854775807 - 1 {
    return []
  }
  return [0 - value[1], 0 - value[0]]
}

local fn quotient(left: list<int>, right: list<int>) -> list<int> {
  if len(left) != 2 || len(right) != 2 ||
     (right[0] <= 0 && right[1] >= 0) { return [] }
  // Integer division truncates toward zero. With a fixed-sign divisor,
  // endpoint pairs enclose the quotient; MIN / -1 must never be evaluated.
  if left[0] == -9223372036854775807 - 1 &&
     right[0] <= -1 && right[1] >= -1 { return [] }
  var low = left[0] / right[0]
  var high = low
  for a in left {
    for b in right {
      let value = a / b
      if value < low { low = value }
      if value > high { high = value }
    }
  }
  return [low, high]
}

local fn exact(value: bool) -> list<int> {
  if value {
    return [1, 1]
  }
  return [0, 0]
}

local fn compare(
  name: str, left: list<int>, right: list<int>
) -> list<int> {
  if len(left) != 2 || len(right) != 2 {
    return []
  }
  if name == "operator ==" {
    if left[1] < right[0] || right[1] < left[0] {
      return exact(false)
    }
    if left[0] == left[1] && right[0] == right[1] &&
       left[0] == right[0] {
      return exact(true)
    }
  }
  if name == "operator !=" {
    let equal = compare("operator ==", left, right)
    if len(equal) == 2 && equal[0] == equal[1] {
      return exact(equal[0] == 0)
    }
  }
  if name == "operator <" {
    if left[1] < right[0] {
      return exact(true)
    }
    if left[0] >= right[1] {
      return exact(false)
    }
  }
  if name == "operator <=" {
    if left[1] <= right[0] {
      return exact(true)
    }
    if left[0] > right[1] {
      return exact(false)
    }
  }
  if name == "operator >" {
    return compare("operator <", right, left)
  }
  if name == "operator >=" {
    return compare("operator <=", right, left)
  }
  return [0, 1]
}

local fn logical(
  name: str, left: list<int>, right: list<int>
) -> list<int> {
  if len(left) != 2 || len(right) != 2 {
    return []
  }
  if name == "operator &&" {
    if left[1] == 0 || right[1] == 0 {
      return exact(false)
    }
    if left[0] == 1 && right[0] == 1 {
      return exact(true)
    }
  }
  if name == "operator ||" {
    if left[0] == 1 || right[0] == 1 {
      return exact(true)
    }
    if left[1] == 0 && right[1] == 0 {
      return exact(false)
    }
  }
  return [0, 1]
}

local fn base_call(m: Mod, op: Op) -> str {
  let symbol = ir.target(m, op)
  let name = base.replace(symbol, "base.", "")
  if symbol != "base." + name {
    return ""
  }
  return name
}

// Shape vectors built from scalar expressions retain their element intervals.
// Do not guess through parameters, unknown indices, or unsupported producers.
// Tensor payloads encode fixed-width elements in little-endian order. Decode
// only the requested element; model weights must not become an analysis table.
local fn literal_element(value: Val, at: int, count: int) -> list<int> {
  let data = ir.constant(value)
  if base.kind(data) != "bytes" { return [] }
  let name = base.name(tensor.elem(ir.type(value)))
  let widths = {i8: 1, u8: 1, i16: 2, u16: 2, i32: 4, u32: 4, i64: 8, u64: 8}
  if !base.has(widths, name) { return [] }
  let width = base.int(widths[name])
  let size = base.size(data)
  if size % width != 0 || size / width != count { return [] }
  let offset = at * width
  var result = base.byte(data, offset + width - 1)
  let signed = name == "i8" || name == "i16" || name == "i32" || name == "i64"
  if signed && result >= 128 { result -= 256 }
  // Bounds use signed 64-bit metadata; unrepresentable u64 values stay unknown.
  if !signed && width == 8 && result >= 128 { return [] }
  for reverse in 1..width {
    result = result * 256 + base.byte(data, offset + width - reverse - 1)
  }
  return [result, result]
}

local fn vector_element(m: Mod, value: Val, at: int, known: dict) -> list<int> {
  let type = ir.type(value)
  if !tensor.valid(type) || !integer(tensor.elem(type)) { return [] }
  let dims = tensor.dims(type)
  var count = 1
  if len(dims) != 0 {
    if len(dims) != 1 || base.kind(dims[0]) != "int" { return [] }
    count = base.int(dims[0])
  }
  if at < 0 || at >= count { return [] }
  let binding = id(value) + ".element." + text(at)
  if base.has(known, binding + ".lo") && base.has(known, binding + ".hi") {
    return [base.int(known[binding + ".lo"]), base.int(known[binding + ".hi"])]
  }
  let source = ir.def(value)
  if !ir.live(source) { return [] }
  if ir.kind(source) == "constant" { return literal_element(value, at, count) }
  if ir.kind(source) != "call" { return [] }
  let inputs = ir.args(source)
  let target = ir.target(m, source)
  if target == "tensor.tensor" && len(inputs) == 1 {
    return get(known, inputs[0])
  }
  if target == "base.copy" && len(inputs) == 1 {
    return vector_element(m, inputs[0], at, known)
  }
  if target == "tensor.operator []=" && len(inputs) == 3 {
    let index = get(known, inputs[1])
    if len(index) != 2 { return [] }
    if index[0] == at && index[1] == at { return get(known, inputs[2]) }
    if index[1] < at || index[0] > at {
      return vector_element(m, inputs[0], at, known)
    }
  }
  let outputs = ir.outs(source)
  for i in 0..len(outputs) {
    if outputs[i] == value { return call_result(m, source, i, at, known) }
  }
  return []
}

// Analyze an owned function in a call-local environment. Only the requested
// tensor element and statically indexed reads are bound, never an entire tensor.
// Recursion has no finite summary here and remains unknown.
local fn call_result(
  m: Mod, call: Op, position: int, element: int, known: dict
) -> list<int> {
  let target = ir.resolve(m, call)
  if !ir.live(target) || !ir.owned(m, target) { return [] }
  let bodies = ir.blks(target)
  let params = ir.params(target)
  let inputs = ir.args(call)
  if len(bodies) == 0 || len(params) != len(inputs) ||
     len(ir.generics(target)) != 0 { return [] }
  let active = base.get(known, "bounds.active", [])
  for prior in active { if base.int(prior) == ir.key(target) { return [] } }
  let ops = ir.ops(bodies[0])
  if len(ops) == 0 || ir.kind(ops[len(ops) - 1]) != "return" { return [] }
  let returned = ir.args(ops[len(ops) - 1])
  if position >= len(returned) { return [] }
  var local = constants(ir.vals(target))
  local["bounds.active"] = active + [ir.key(target)]
  let ordered = ir.ops(target)
  // Bind scalar arguments before deriving indices. Scalar-only functions need
  // no preliminary traversal, especially along nested helper-call chains.
  for i in 0..len(params) {
    let key = id(params[i])
    if integer(ir.type(params[i])) {
      let bound = scoped_value(m, inputs[i], ir.blk(call), known)
      if len(bound) == 2 {
        local[key + ".lo"] = bound[0]
        local[key + ".hi"] = bound[1]
      }
    }
  }
  var needs_indices = false
  for op in ordered {
    let args = ir.args(op)
    if ir.kind(op) == "call" && ir.target(m, op) == "tensor.operator []" &&
       len(args) == 2 {
      for param in params {
        if args[0] == param {
          let at = get(local, args[1])
          if len(at) != 2 || at[0] != at[1] { needs_indices = true }
        }
      }
    }
  }
  var indices = local
  if needs_indices { indices = infer_operations(m, ordered, local) }
  for i in 0..len(params) {
    let key = id(params[i])
    if tensor.valid(ir.type(params[i])) {
      var requested: list<int> = []
      if element >= 0 { requested += [element] }
      for op in ordered {
        let args = ir.args(op)
        if ir.kind(op) == "call" && ir.target(m, op) == "tensor.operator []" &&
           len(args) == 2 && args[0] == params[i] {
          let at = get(indices, args[1])
          if len(at) == 2 && at[0] == at[1] { requested += [at[0]] }
        }
      }
      for at in requested {
        let bound = vector_element(m, inputs[i], at, known)
        if len(bound) == 2 {
          let slot = key + ".element." + text(at)
          local[slot + ".lo"] = bound[0]
          local[slot + ".hi"] = bound[1]
        }
      }
    }
  }
  local = infer_operations(m, ordered, local)
  if element >= 0 { return vector_element(m, returned[position], element, local) }
  return get(local, returned[position])
}

local fn result(m: Mod, op: Op, known: dict) -> list<int> {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return []
  }
  let inputs = ir.args(op)
  if ir.target(m, op) == "tensor.operator []" && len(inputs) == 2 &&
     integer(ir.type(outputs[0])) {
    let at = get(known, inputs[1])
    if len(at) == 2 && at[0] == at[1] {
      return vector_element(m, inputs[0], at[0], known)
    }
    return []
  }
  if ir.target(m, op) == "tensor.dim" && len(inputs) == 2 {
    let source = ir.type(inputs[0])
    var axis = get(known, inputs[1])
    if len(axis) != 2 {
      let cast = ir.def(inputs[1])
      if ir.live(cast) && ir.kind(cast) == "call" &&
         len(ir.args(cast)) == 1 && ir.is_const(ir.args(cast)[0]) &&
         base.kind(ir.constant(ir.args(cast)[0])) == "int" {
        let exact = base.int(ir.constant(ir.args(cast)[0]))
        axis = [exact, exact]
      }
    }
    if tensor.valid(source) && len(axis) == 2 &&
       axis[0] == axis[1] && axis[0] >= 0 &&
       axis[0] < len(tensor.dims(source)) {
      let dim = tensor.dims(source)[axis[0]]
      if base.kind(dim) == "int" {
        let extent = base.int(dim)
        return [extent, extent]
      }
    }
    return []
  }
  var type = ir.type(outputs[0])
  var name = base_call(m, op)
  if name == "" && len(inputs) == 1 {
    let written = ir.callee(op)
    if written == base.name(type) || integer(base.ty(written)) {
      name = written
      if !integer(type) {
        type = base.ty(written)
      }
    }
  }
  if !integer(type) {
    return []
  }
  if name == "" {
    return call_result(m, op, 0, -1, known)
  }
  if (name == "copy" || name == "operator +") && len(inputs) == 1 {
    return scoped_value(m, inputs[0], ir.blk(op), known)
  }
  if name == "operator -" && len(inputs) == 1 {
    return neg(scoped_value(m, inputs[0], ir.blk(op), known))
  }
  if name == "operator !" && len(inputs) == 1 {
    let value = scoped_value(m, inputs[0], ir.blk(op), known)
    if len(value) == 2 && value[0] == value[1] {
      return exact(value[0] == 0)
    }
    if len(value) == 2 {
      return [0, 1]
    }
  }
  if len(inputs) == 2 {
    let left = scoped_value(m, inputs[0], ir.blk(op), known)
    let right = scoped_value(m, inputs[1], ir.blk(op), known)
    if name == "operator +" {
      return add(left, right)
    }
    if name == "operator -" {
      return sub(left, right)
    }
    if name == "operator *" {
      return mul(left, right)
    }
    if name == "operator /" {
      let value = quotient(left, right)
      let allowed = limits(type)
      if len(value) == 2 && len(allowed) == 2 &&
         value[0] >= allowed[0] && value[1] <= allowed[1] { return value }
      return []
    }
    if name == "operator ==" || name == "operator !=" ||
       name == "operator <" || name == "operator <=" ||
       name == "operator >" || name == "operator >=" {
      return compare(name, left, right)
    }
    if name == "operator &&" || name == "operator ||" {
      return logical(name, left, right)
    }
  }
  if len(inputs) == 1 && base.name(type) == name {
    let value = scoped_value(m, inputs[0], ir.blk(op), known)
    let target_limits = limits(type)
    if len(value) == 2 && len(target_limits) == 2 &&
       value[0] >= target_limits[0] && value[1] <= target_limits[1] {
      return value
    }
  }
  return []
}

// A yielded comparison operand is constrained by the selected branch arm.
// Keep this fact local to the join; the same SSA value outside that arm does
// not acquire the constraint.
local fn copied_source(m: Mod, value: Val) -> Val {
  let source = ir.def(value)
  if ir.live(source) && ir.kind(source) == "call" &&
     ir.target(m, source) == "base.copy" && len(ir.args(source)) == 1 {
    return copied_source(m, ir.args(source)[0])
  }
  return value
}

local fn same_scalar(m: Mod, a: Val, b: Val, known: dict) -> bool {
  let left = copied_source(m, a)
  let right = copied_source(m, b)
  if left == right { return true }
  let l = ir.def(left)
  let r = ir.def(right)
  if !ir.live(l) || !ir.live(r) || ir.kind(l) != "call" ||
     ir.kind(r) != "call" || ir.target(m, l) != "tensor.operator []" ||
     ir.target(m, r) != "tensor.operator []" { return false }
  let la = ir.args(l)
  let ra = ir.args(r)
  if len(la) != 2 || len(ra) != 2 || la[0] != ra[0] { return false }
  let li = get(known, la[1])
  let ri = get(known, ra[1])
  return len(li) == 2 && len(ri) == 2 && li[0] == li[1] &&
         ri[0] == ri[1] && li[0] == ri[0]
}

local fn selected_condition(m: Mod, value: Val, known: dict) -> Val {
  let source = ir.def(value)
  if !ir.live(source) || ir.kind(source) != "branch" { return value }
  let inputs = ir.args(source)
  let flag = get(known, inputs[0])
  if len(flag) != 2 || flag[0] != flag[1] { return value }
  var arm = 0
  if flag[0] == 0 { arm = 1 }
  let bodies = ir.blks(source)
  if arm >= len(bodies) { return value }
  let ops = ir.ops(bodies[arm])
  if len(ops) == 0 { return value }
  let outputs = ir.outs(source)
  let yielded = ir.args(ops[len(ops) - 1])
  for i in 0..len(outputs) {
    if outputs[i] == value && i < len(yielded) {
      var selected = yielded[i]
      let args = ir.args(bodies[arm])
      for j in 0..len(args) {
        if selected == args[j] { selected = inputs[j + 1] }
      }
      return selected_condition(m, selected, known)
    }
  }
  return value
}

local fn branch_value(
  m: Mod, value: Val, owner: Op, arm: int, known: dict
) -> list<int> {
  let original = get(known, value)
  if !integer(ir.type(value)) { return original }
  let inputs = ir.args(owner)
  if len(inputs) == 0 { return original }
  let condition = ir.def(selected_condition(m, inputs[0], known))
  if !ir.live(condition) || ir.kind(condition) != "call" { return original }
  var name = base_call(m, condition)
  let operands = ir.args(condition)
  if len(operands) != 2 { return original }
  var source = copied_source(m, value)
  let arguments = ir.args(ir.blks(owner)[arm])
  for i in 0..len(arguments) {
    if source == arguments[i] && i + 1 < len(inputs) { source = inputs[i + 1] }
  }
  var other = operands[1]
  if same_scalar(m, source, operands[1], known) {
    other = operands[0]
    if name == "operator <" { name = "operator >" } else {
      if name == "operator <=" { name = "operator >=" } else {
        if name == "operator >" { name = "operator <" } else {
          if name == "operator >=" { name = "operator <=" }
        }
      }
    }
  } else { if !same_scalar(m, source, operands[0], known) { return original } }
  if arm == 1 {
    if name == "operator <" { name = "operator >=" } else {
      if name == "operator <=" { name = "operator >" } else {
        if name == "operator >" { name = "operator <=" } else {
          if name == "operator >=" { name = "operator <" } else {
            if name == "operator ==" { name = "operator !=" } else {
              if name == "operator !=" { name = "operator ==" }
            }
          }
        }
      }
    }
  }
  let bound = get(known, other)
  if len(bound) != 2 { return original }
  var out = original
  if len(out) != 2 { out = limits(ir.type(value)) }
  if len(out) != 2 { return original }
  if name == "operator <" || name == "operator <=" {
    var upper = [bound[1]]
    if name == "operator <" { upper = sub_value(bound[1], 1) }
    if len(upper) == 0 { return original }
    if upper[0] < out[1] { out[1] = upper[0] }
  } else {
    if name == "operator >" || name == "operator >=" {
      var lower = [bound[0]]
      if name == "operator >" { lower = add_value(bound[0], 1) }
      if len(lower) == 0 { return original }
      if lower[0] > out[0] { out[0] = lower[0] }
    } else {
      if name != "operator ==" { return original }
      if bound[0] > out[0] { out[0] = bound[0] }
      if bound[1] < out[1] { out[1] = bound[1] }
    }
  }
  if out[0] > out[1] { return original }
  return out
}

local fn scoped_value(m: Mod, value: Val, block: Blk, known: dict) -> list<int> {
  let owner = ir.op(block)
  if !ir.live(owner) { return get(known, value) }
  var out = scoped_value(m, value, ir.blk(owner), known)
  if ir.kind(owner) != "branch" { return out }
  let bodies = ir.blks(owner)
  for arm in 0..len(bodies) {
    if bodies[arm] == block {
      let local = branch_value(m, value, owner, arm, known)
      if len(local) != 2 { return out }
      if len(out) != 2 { return local }
      if local[0] > out[0] { out[0] = local[0] }
      if local[1] < out[1] { out[1] = local[1] }
    }
  }
  if len(out) == 2 && out[0] > out[1] { return get(known, value) }
  return out
}

local fn constants(values: list<Val>) -> dict {
  var known: dict = {}
  for value in values {
    if ir.is_const(value) && base.kind(ir.constant(value)) == "int" &&
       integer(ir.type(value)) {
      let exact = base.int(ir.constant(value))
      let allowed = limits(ir.type(value))
      if len(allowed) == 0 ||
         (exact >= allowed[0] && exact <= allowed[1]) {
        let value_id = id(value)
        known[value_id + ".lo"] = exact
        known[value_id + ".hi"] = exact
      }
    }
  }
  return known
}

local fn infer_operations(m: Mod, ops: list<Op>, seed: dict) -> dict {
  var known = seed
  for op in ops {
    let kind = ir.kind(op)
    if kind == "call" {
      let outputs = ir.outs(op)
      let value = result(m, op, known)
      if len(outputs) == 1 && len(value) == 2 {
        let value_id = id(outputs[0])
        known[value_id + ".lo"] = value[0]
        known[value_id + ".hi"] = value[1]
      }
    } else {
      if kind == "loop" {
        let bodies = ir.blks(op)
        if len(bodies) == 1 {
          let body_args = ir.args(bodies[0])
          let outputs = ir.outs(op)
          let carried = len(outputs)
          let iterators = len(body_args) - carried
          let sources = ir.args(op)
          for i in 0..iterators {
            let source = ir.def(sources[i])
            if ir.live(source) && ir.callee(source) == "operator .." {
              let range_args = ir.args(source)
              if len(range_args) == 2 {
                let first = get(known, range_args[0])
                let last = get(known, range_args[1])
                if len(first) == 2 && len(last) == 2 &&
                   first[0] < last[1] &&
                   last[1] != -9223372036854775807 - 1 {
                  let value_id = id(body_args[i])
                  known[value_id + ".lo"] = first[0]
                  known[value_id + ".hi"] = last[1] - 1
                }
              }
            }
          }
          let body_ops = ir.ops(bodies[0])
          if len(body_ops) != 0 {
            let yielded = ir.args(body_ops[len(body_ops) - 1])
            for i in 0..carried {
              let seed = iterators + i
              if seed < len(sources) && i < len(yielded) &&
                 yielded[i] == body_args[iterators + i] {
                let value = get(known, sources[seed])
                if len(value) == 2 {
                  let value_id = id(body_args[iterators + i])
                  known[value_id + ".lo"] = value[0]
                  known[value_id + ".hi"] = value[1]
                }
              }
            }
          }
        }
      } else {
        if kind == "branch" {
          let inputs = ir.args(op)
          for body in ir.blks(op) {
            let body_args = ir.args(body)
            for i in 0..len(body_args) {
              if i + 1 < len(inputs) {
                let value = get(known, inputs[i + 1])
                if len(value) == 2 {
                  let value_id = id(body_args[i])
                  known[value_id + ".lo"] = value[0]
                  known[value_id + ".hi"] = value[1]
                }
              }
            }
          }
        } else {
          if kind == "yield" {
            let owner = ir.op(ir.blk(op))
            if ir.live(owner) && ir.kind(owner) == "branch" {
              let yielded = ir.args(op)
              let bodies = ir.blks(owner)
              let owner_args = ir.args(owner)
              var condition: list<int> = []
              if len(owner_args) != 0 {
                condition = get(known, owner_args[0])
              }
              var selected = -1
              if len(condition) == 2 && condition[0] == condition[1] {
                if condition[0] == 0 {
                  selected = 1
                } else {
                  selected = 0
                }
              }
              for i in 0..len(yielded) {
                var complete = true
                var lo = 0
                var hi = 0
                var first = true
                for arm_index in 0..len(bodies) {
                  if selected < 0 || arm_index == selected {
                    let body_ops = ir.ops(bodies[arm_index])
                    if len(body_ops) == 0 {
                      complete = false
                    } else {
                      let arm = ir.args(body_ops[len(body_ops) - 1])
                      if i >= len(arm) {
                        complete = false
                      } else {
                        let value = branch_value(m, arm[i], owner, arm_index, known)
                        if len(value) != 2 {
                          complete = false
                        } else {
                          if first || value[0] < lo {
                            lo = value[0]
                          }
                          if first || value[1] > hi {
                            hi = value[1]
                          }
                          first = false
                        }
                      }
                    }
                  }
                }
                if complete && !first && i < len(ir.outs(owner)) {
                  let value_id = id(ir.outs(owner)[i])
                  known[value_id + ".lo"] = lo
                  known[value_id + ".hi"] = hi
                }
              }
            } else {
              if ir.live(owner) && ir.kind(owner) == "loop" {
                let bodies = ir.blks(owner)
                let outputs = ir.outs(owner)
                if len(bodies) == 1 {
                  let body_args = ir.args(bodies[0])
                  let iterators = len(body_args) - len(outputs)
                  let sources = ir.args(owner)
                  let yielded = ir.args(op)
                  for i in 0..len(outputs) {
                    if i < len(yielded) &&
                       yielded[i] == body_args[iterators + i] &&
                       iterators + i < len(sources) {
                      let value = get(known, sources[iterators + i])
                      if len(value) == 2 {
                        let value_id = id(outputs[i])
                        known[value_id + ".lo"] = value[0]
                        known[value_id + ".hi"] = value[1]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return known
}

[memo]
fn infer(m: Mod) -> dict {
  return infer_operations(m, ir.ops(m), constants(ir.vals(m)))
}

local fn predicate(m: Mod, op: Op) -> bool {
  if ir.kind(op) != "call" || len(ir.outs(op)) != 1 ||
     ir.type(ir.outs(op)[0]) != ty("bool") {
    return false
  }
  let name = base_call(m, op)
  return name == "operator ==" || name == "operator !=" ||
         name == "operator <" || name == "operator <=" ||
         name == "operator >" || name == "operator >=" ||
         name == "operator &&" || name == "operator ||" ||
         name == "operator !"
}

local fn dimension(m: Mod, op: Op) -> bool {
  return ir.kind(op) == "call" && len(ir.outs(op)) == 1 &&
         ir.target(m, op) == "tensor.dim"
}

fn fold(m: Mod) -> bool {
  let known = infer(m)
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) && (predicate(m, op) || dimension(m, op)) {
      let bound = get(known, ir.outs(op)[0])
      if len(bound) == 2 && bound[0] == bound[1] {
        if predicate(m, op) {
          assert(ir.replace(m, op, bound[0] != 0),
                 "bounds.fold could not replace an exact predicate")
        } else {
          assert(ir.replace(m, op, bound[0]),
                 "bounds.fold could not replace an exact dimension")
        }
        changed = true
      }
    }
  }
  return changed
}

fn fits(known: dict, value: Val, type: Ty) -> bool {
  let bound = get(known, value)
  let allowed = limits(type)
  return len(bound) == 2 && len(allowed) == 2 &&
         bound[0] >= allowed[0] && bound[1] <= allowed[1]
}

fn report(m: Mod) -> dict {
  let known = infer(m)
  var rows: dict = {}
  var integers = 0
  var count = 0
  for fn in ir.fns(m) {
    for value in ir.vals(fn) {
      if integer(ir.type(value)) {
        integers += 1
      }
      let bound = get(known, value)
      if len(bound) == 2 {
        var row: dict = {}
        row["fn"] = ir.name(fn)
        row["name"] = ir.name(value)
        row["type"] = text(ir.type(value))
        row["lo"] = bound[0]
        row["hi"] = bound[1]
        rows[id(value)] = row
        count += 1
      }
    }
  }
  var out: dict = {}
  out["revision"] = ir.revision(m)
  out["integers"] = integers
  out["known"] = count
  out["values"] = rows
  return out
}
