module ir
use base

fn fns(m: Mod) -> list<Fn>;
fn params(f: Fn) -> list<Val>;
fn blks(f: Fn) -> list<Blk>;
fn blks(op: Op) -> list<Blk>;
fn block(op: Op) -> Blk;
fn ops(m: Mod) -> list<Op>;
fn ops(f: Fn) -> list<Op>;
fn ops(b: Blk) -> list<Op>;
fn args(b: Blk) -> list<Val>;
fn args(op: Op) -> list<Val>;
fn outs(op: Op) -> list<Val>;
fn users(v: Val) -> list<Op>;
fn live(f: Fn) -> bool;
fn live(b: Blk) -> bool;
fn live(op: Op) -> bool;
fn live(v: Val) -> bool;
fn kind(op: Op) -> str;
fn callee(op: Op) -> str;
fn type(v: Val) -> str;
fn has(f: Fn, key: str) -> bool;
fn has(op: Op, key: str) -> bool;
fn meta(f: Fn) -> Attr;
fn meta(op: Op) -> Attr;
fn meta(f: Fn, key: str) -> Attr;
fn meta(op: Op, key: str) -> Attr;
fn is_const(v: Val) -> bool;
fn constant(v: Val) -> Attr;
fn call(m: Mod, before: Op, callee: str, args: list<Val>, type: str) -> Val;
fn call(m: Mod, before: Op, callee: str, args: list<Val>, types: list<str>) -> Op;
fn constant(m: Mod, before: Op, value: Attr, type: str) -> Val;
fn loop(
  m: Mod, before: Op, names: list<str>, sources: list<Val>, carried: list<Val>
) -> Op;
fn branch(
  m: Mod, before: Op, condition: Val, carried: list<Val>
) -> Op;
fn clone(m: Mod, op: Op, before: Op) -> Op;
fn move(m: Mod, op: Op, before: Op) -> bool;
fn args(m: Mod, op: Op, values: list<Val>) -> bool;
fn fuse(m: Mod, ops: list<Op>, callee: str) -> bool;
fn replace(m: Mod, old: Val, next: Val) -> bool;
fn replace(m: Mod, old: Val, next: Val, user: Op) -> bool;
fn erase(m: Mod, op: Op) -> bool;
fn rename(m: Mod, value: Val, name: str) -> bool;
fn rename(m: Mod, op: Op, callee: str) -> bool;
fn set(m: Mod, f: Fn, key: str, value: Attr) -> bool;
fn set(m: Mod, op: Op, key: str, value: Attr) -> bool;
fn unset(m: Mod, f: Fn, key: str) -> bool;
fn unset(m: Mod, op: Op, key: str) -> bool;
