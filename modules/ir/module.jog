module ir
use base

fn fns(m: Mod) -> list<Fn>;
fn fns(module: str) -> list<Fn>;
fn find(m: Mod, name: str) -> Fn;
fn uses(m: Mod) -> list<str>;
fn revision(m: Mod) -> int;
fn params(f: Fn) -> list<Val>;
fn returns(f: Fn) -> list<Ty>;
fn blks(f: Fn) -> list<Blk>;
fn blks(op: Op) -> list<Blk>;
fn blk(op: Op) -> Blk;
fn ops(m: Mod) -> list<Op>;
fn ops(f: Fn) -> list<Op>;
fn ops(b: Blk) -> list<Op>;
fn args(b: Blk) -> list<Val>;
fn args(op: Op) -> list<Val>;
fn outs(op: Op) -> list<Val>;
fn def(v: Val) -> Op;
fn users(v: Val) -> list<Op>;
fn live(f: Fn) -> bool;
fn live(b: Blk) -> bool;
fn live(op: Op) -> bool;
fn live(v: Val) -> bool;
fn kind(op: Op) -> str;
fn callee(op: Op) -> str;
fn name(f: Fn) -> str;
fn name(v: Val) -> str;
fn type(v: Val) -> Ty;
fn type(m: Mod, v: Val, type: Ty) -> bool;
fn returns(m: Mod, f: Fn, types: list<Ty>) -> bool;
fn resolve(m: Mod, op: Op) -> Fn;
fn accepts(op: Op, f: Fn) -> bool;
fn match(op: Op, fns: list<Fn>) -> Fn;
fn match(op: Op, fn: Fn) -> list<Ty>;
fn where(fns: list<Fn>, key: str, value: Attr) -> list<Fn>;
fn invoke(m: Mod, op: Op, fn: Fn) -> bool;
fn symbol(f: Fn) -> str;
fn has(f: Fn, key: str) -> bool;
fn has(v: Val, key: str) -> bool;
fn has(op: Op, key: str) -> bool;
fn meta(f: Fn) -> Attr;
fn meta(v: Val) -> Attr;
fn meta(op: Op) -> Attr;
fn meta(f: Fn, key: str) -> Attr;
fn meta(v: Val, key: str) -> Attr;
fn meta(op: Op, key: str) -> Attr;
fn is_const(v: Val) -> bool;
fn constant(v: Val) -> Attr;
fn call(m: Mod, before: Op, callee: str, args: list<Val>, type: Ty) -> Val;
fn call(m: Mod, before: Op, callee: str, args: list<Val>, types: list<Ty>) -> Op;
fn constant(m: Mod, before: Op, value: Attr, type: Ty) -> Val;
fn loop(
  m: Mod, before: Op, names: list<str>, sources: list<Val>, carried: list<Val>
) -> Op;
fn branch(
  m: Mod, before: Op, condition: Val, carried: list<Val>
) -> Op;
fn clone(m: Mod, op: Op, before: Op) -> Op;
fn clone(m: Mod, fn: Fn, name: str) -> Fn;
fn clone(m: Mod, fn: Fn, name: str, generics: list<Ty>) -> Fn;
fn expand(m: Mod, call: Op, callee: Fn) -> bool;
fn move(m: Mod, op: Op, before: Op) -> bool;
fn args(m: Mod, op: Op, values: list<Val>) -> bool;
fn fuse(m: Mod, ops: list<Op>, callee: str) -> bool;
fn replace(m: Mod, old: Val, next: Val) -> bool;
fn replace(m: Mod, old: Val, next: Val, user: Op) -> bool;
fn erase(m: Mod, op: Op) -> bool;
fn erase(m: Mod, fn: Fn) -> bool;
fn rename(m: Mod, fn: Fn, name: str) -> bool;
fn rename(m: Mod, value: Val, name: str) -> bool;
fn rename(m: Mod, op: Op, callee: str) -> bool;
fn retarget(m: Mod, op: Op, callee: str, args: list<Val>) -> bool;
fn set(m: Mod, f: Fn, key: str, value: Attr) -> bool;
fn set(m: Mod, v: Val, key: str, value: Attr) -> bool;
fn set(m: Mod, op: Op, key: str, value: Attr) -> bool;
fn unset(m: Mod, f: Fn, key: str) -> bool;
fn unset(m: Mod, v: Val, key: str) -> bool;
fn unset(m: Mod, op: Op, key: str) -> bool;
fn use(m: Mod, module: str) -> bool;
