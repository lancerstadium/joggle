mod opt
use ir
use tensor

fn fold(m: Mod, fns: list<Fn>) -> bool {
  var changed = fold_len(m)
  changed = ir.fold(m, fns) || changed
  changed = project(m) || changed
  changed = select(m) || changed
  let controls = ir.ops(m, ["loop", "branch"])
  if len(controls) != 0 {
    changed = ir.fold(m, controls, fns) || changed
  }
  return changed
}

fn fold(m: Mod) -> bool {
  return opt.fold(m, ir.fns("base"))
}

fn specialize(m: Mod, key: str, value: Attr) -> bool {
  var changed = false
  let candidates = ir.ops(m, ["loop"])
  for reverse in 0..len(candidates) {
    let op = candidates[len(candidates) - reverse - 1]
    if ir.live(op) && ir.has(op, key) &&
       ir.meta(op, key) == value {
      // Specialization is an optimization, not a legality condition.  A tagged
      // loop whose bounds are known is expanded here; a loop with runtime
      // bounds stays structured for a backend that can lower control flow.
      if specialize_loop(m, op) {
        changed = true
      }
    }
  }
  if changed {
    // Projection can make a condition static; the second fold selects it.
    fold(m)
    fold(m)
    dce(m, ["base.list"])
  }
  return changed
}

local fn untag(m: Mod, value: Val) -> bool {
  // The conversion erases the model op only once no op carries the frontend tag,
  // so every op built here has to lose it.
  let op = ir.def(value)
  if !ir.live(op) || !ir.has(op, "onnx") {
    return false
  }
  return ir.unset(m, op, "onnx")
}

local fn scalar_attr(elem: Ty, value: int) -> Attr {
  if elem == ty("f32") || elem == ty("f64") {
    return real(base.int(value))
  }
  return base.int(value)
}

fn bind(m: Mod, name: str, index: int, values: list<int>) -> bool {
  // Some graphs read their own extent from a second input tensor rather than from
  // their declared shape, so no amount of type information makes the shape
  // arithmetic fold. This replaces a parameter's uses with a constant, the
  // value-level counterpart of opt.signature; the parameter stays in the
  // signature, so a caller still feeds it.
  let fn = ir.find(m, name)
  if !ir.live(fn) {
    return false
  }
  let blocks = ir.blks(fn)
  if len(blocks) == 0 {
    return false
  }
  let head_ops = ir.ops(blocks[0])
  if len(head_ops) == 0 {
    return false
  }
  // An anchor that is not tagged for the frontend: the conversion erases the model
  // op only once no tagged op is left, so anything built here must be untagged.
  let head = head_ops[0]
  let params = ir.params(fn)
  if index < 0 || index >= len(params) || len(values) == 0 {
    return false
  }
  let parameter = params[index]
  let type = ir.type(parameter)
  if !tensor.valid(type) {
    return false
  }
  let elem = tensor.elem(type)
  var count = 1
  for dim in tensor.dims(type) {
    if base.kind(dim) != "int" {
      return false
    }
    count *= base.int(dim)
  }
  if count <= 0 {
    return false
  }
  var constant = ir.call(
    m, head, "tensor.tensor",
    [ir.constant(m, head, scalar_attr(elem, values[0]), elem)], type
  )
  if !ir.live(constant) {
    return false
  }
  // tensor.tensor is generic in its shape, so the call does not adopt the result
  // type it was given and the value arrives unranked. State it.
  if !ir.type(m, constant, type) {
    return false
  }
  ir.unset(m, ir.def(constant), "onnx")
  untag(m, ir.constant(m, head, scalar_attr(elem, values[0]), elem))
  for i in 0..count {
    let at = ir.constant(m, head, base.int(i), ty("index"))
    let scalar = ir.constant(
      m, head, scalar_attr(elem, values[i % len(values)]), elem
    )
    untag(m, at)
    untag(m, scalar)
    constant = ir.call(
      m, head, "tensor.operator []=", [constant, at, scalar], type
    )
    if !ir.live(constant) {
      return false
    }
    if !ir.type(m, constant, type) {
      return false
    }
    ir.unset(m, ir.def(constant), "onnx")
  }
  return ir.replace(m, parameter, constant)
}

fn signature(m: Mod, name: str, types: list<Ty>) -> bool {
  // Some graphs declare an input whose extents have no name at all, so there is
  // no dimension parameter for opt.instantiate to bind. A caller that knows the
  // shape it will feed can state it here before conversion, which is the same
  // obligation TVM and ONNX-MLIR place on their users.
  let fn = ir.find(m, name)
  if !ir.live(fn) || len(ir.blks(fn)) == 0 {
    return false
  }
  let args = ir.params(fn)
  if len(args) != len(types) {
    return false
  }
  var changed = false
  for i in 0..len(args) {
    if ir.type(args[i]) != types[i] {
      changed = ir.type(m, args[i], types[i]) || changed
    }
  }
  return changed
}

fn signature(m: Mod, name: str, types: list<str>) -> bool {
  var parsed: list<Ty> = []
  for type in types {
    parsed += [ty(type)]
  }
  return signature(m, name, parsed)
}

fn instantiate(m: Mod, name: str, args: list<Ty>) -> bool {
  let source = ir.find(m, name)
  if !ir.live(source) || len(ir.generics(source)) == 0 ||
     len(ir.generics(source)) != len(args) {
    return false
  }
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) && ir.resolve(m, op) == source {
      return false
    }
  }
  let hidden = template_name(m, name)
  if !ir.rename(m, source, hidden) {
    return false
  }
  let instance = ir.clone(m, source, name, args)
  if !ir.live(instance) {
    assert(ir.rename(m, source, name),
           "opt.instantiate could not restore the source name")
    return false
  }
  assert(ir.erase(m, source),
         "opt.instantiate could not remove the generic source")
  return true
}

fn instantiate(m: Mod, name: str, args: list<str>) -> bool {
  var types: list<Ty> = []
  for arg in args {
    types += [ty(arg)]
  }
  return instantiate(m, name, types)
}

fn copy(m: Mod) -> bool {
  var calls: list<Op> = []
  var old: list<Val> = []
  var next: list<Val> = []
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) &&
       ir.callee(op) == "base.copy" && len(ir.meta(op)) == 0 {
      let args = ir.args(op)
      let outs = ir.outs(op)
      var root = false
      for fn in ir.fns(m) {
        let blocks = ir.blks(fn)
        if len(blocks) != 0 && ir.blk(op) == blocks[0] {
          root = true
        }
      }
      var carried = false
      if len(outs) == 1 {
        for user in ir.users(outs[0]) {
          let kind = ir.kind(user)
          if kind == "loop" || kind == "branch" || kind == "yield" {
            carried = true
          }
        }
      }
      if len(args) == 1 && len(outs) == 1 &&
         ir.type(args[0]) == ir.type(outs[0]) && root && !carried {
        calls += [op]
        old += [outs[0]]
        next += [args[0]]
      }
    }
  }
  if len(calls) == 0 {
    return false
  }
  base.assert(ir.replace(m, old, next), "opt.copy could not replace values")
  return ir.erase(m, calls)
}

fn fold_identity(m: Mod, callee: str, identity: Attr, side: int) -> bool {
  var changed = false
  for op in ir.ops(m, ["call"]) {
    let form = ir.form(op)
    if matches(m, op, callee) &&
       (form == "expr" || form == "let") &&
       (side == 0 || side == 1) {
      let args = ir.args(op)
      let outs = ir.outs(op)
      if len(args) == 2 && len(outs) == 1 {
        if ir.is_const(args[side]) {
          if ir.constant(args[side]) == identity {
            let keep = args[1 - side]
            if ir.type(outs[0]) == ir.type(keep) {
              let source = ir.def(keep)
              var mutable = ir.name(keep) != "" && ir.is_const(keep)
              if ir.live(source) {
                let source_form = ir.form(source)
                mutable = source_form == "var" || source_form == "assign" ||
                          source_form == "compound" ||
                          source_form == "index_assign"
              }
              if !mutable {
                changed = ir.replace(m, outs[0], keep)
                changed = ir.erase(m, op)
              }
            }
          }
        }
      }
    }
  }
  return changed
}

fn fold_add_zero(m: Mod) -> bool {
  var changed = fold_identity(m, "base.operator +", 0, 1)
  changed = fold_identity(m, "base.operator +", 0, 0) || changed
  return changed
}

fn dce(m: Mod, pure: list<str>) -> bool {
  var unused: list<Op> = []
  for fn in ir.fns(m) {
    for block in ir.blks(fn) {
      unused += dead(m, block, pure)
    }
  }
  return len(unused) != 0 && ir.erase(m, unused)
}

fn cse(m: Mod, pure: list<str>) -> bool {
  var changed = false
  for fn in ir.fns(m) {
    for block in ir.blks(fn) {
      changed = cse_block(m, block, pure) || changed
    }
  }
  return changed
}

fn hoist(m: Mod, safe: list<str>) -> bool {
  return hoist_all(m, safe)
}

fn hoist(m: Mod, policy: Fn) -> bool {
  return hoist_all(m, policy)
}

fn fix(m: Mod, pure: list<str>, limit: int) -> bool {
  base.assert(limit > 0, "opt.fix requires a positive limit")
  let safe = pure + ["base.operator +", "base.operator -",
                     "base.operator *"]
  var changed = false
  var again = true
  var exhausted = false
  for i in 0..limit {
    if again {
      let before = ir.revision(m)
      fold_identity(m, "base.operator +", 0, 0)
      fold_identity(m, "base.operator +", 0, 1)
      fold_identity(m, "base.operator *", 1, 0)
      fold_identity(m, "base.operator *", 1, 1)
      cse(m, safe)
      dce(m, safe)
      again = ir.revision(m) != before
      changed = again || changed
      if i == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "opt.fix did not converge")
  return changed
}

fn basic(m: Mod) -> bool {
  return fix(m, [], len(ir.ops(m)) + 1)
}

fn update(m: Mod, roots: list<Val>, rule: Fn) -> bool {
  var changed = false
  let work = ir.affected(roots)
  for op in work {
    if ir.live(op) {
      changed = ir.invoke<bool>(m, op, rule) || changed
    }
  }
  return changed
}

fn count(m: Mod, callee: str) -> int {
  var total = 0
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) {
      if ir.callee(op) == callee {
        total += 1
      }
    }
  }
  return total
}

fn unresolved(m: Mod) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) &&
       ir.callee(op) != "base.list" {
      if !ir.live(ir.resolve(m, op)) {
        let callee = ir.callee(op)
        var seen = false
        for item in out {
          if item == callee {
            seen = true
          }
        }
        if !seen {
          out += [callee]
        }
      }
    }
  }
  return out
}

fn untyped(m: Mod) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) {
      var open = false
      for value in ir.outs(op) {
        if ir.type(value) == ty("_") {
          open = true
        }
      }
      if open {
        let callee = ir.callee(op)
        var seen = false
        for item in out {
          if item == callee {
            seen = true
          }
        }
        if !seen {
          out += [callee]
        }
      }
    }
  }
  return out
}

fn supports(m: Mod, op: Op, caps: list<Fn>) -> bool {
  if ir.callee(op) == "base.list" {
    return true
  }
  let symbol = ir.target(m, op)
  for cap in caps {
    if ir.name(cap) == symbol && ir.accepts(op, cap) {
      return true
    }
  }
  return false
}

fn supports(m: Mod, op: Op, accept: Fn) -> bool {
  return supports_with(m, op, accept, nil, false)
}

fn supports(m: Mod, op: Op, accept: Fn, arg: Attr) -> bool {
  return supports_with(m, op, accept, arg, true)
}

fn frontier(m: Mod, caps: list<Fn>) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) &&
       !supports(m, op, caps) {
      let symbol = ir.target(m, op)
      var seen = false
      for item in out {
        if item == symbol {
          seen = true
        }
      }
      if !seen {
        out += [symbol]
      }
    }
  }
  return out
}

fn frontier(m: Mod, accept: Fn) -> list<str> {
  return frontier_with(m, accept, nil, false)
}

fn frontier(m: Mod, accept: Fn, arg: Attr) -> list<str> {
  return frontier_with(m, accept, arg, true)
}

fn legalize(m: Mod, caps: list<Fn>, limit: int) -> bool {
  var changed = false
  var again = true
  for round in 0..limit {
    if again {
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      for op in ir.ops(m, ["call"]) {
        if ir.live(op) &&
           !supports(m, op, caps) && len(ir.meta(op)) == 0 {
          let target = ir.resolve(m, op)
          if ir.live(target) && len(ir.blks(target)) != 0 {
            calls += [op]
            bodies += [target]
          }
        }
      }
      again = false
      if len(calls) != 0 {
        again = ir.expand(m, calls, bodies)
        if !again {
          for i in 0..len(calls) {
            if ir.live(calls[i]) {
              again = ir.expand(m, [calls[i]], [bodies[i]]) || again
            }
          }
        }
      }
      changed = again || changed
    }
  }
  return changed
}

fn expand(m: Mod, accept: Fn) -> bool {
  return expand_with(m, accept, nil, false)
}

fn expand(m: Mod, accept: Fn, arg: Attr) -> bool {
  return expand_with(m, accept, arg, true)
}

fn legalize(m: Mod, accept: Fn, limit: int) -> bool {
  return legalize_with(m, accept, nil, false, limit)
}

fn legalize(m: Mod, accept: Fn, arg: Attr, limit: int) -> bool {
  return legalize_with(m, accept, arg, true, limit)
}

fn expose(m: Mod, accept: Fn, limit: int) -> bool {
  return expose_with(m, accept, nil, false, limit)
}

fn expose(m: Mod, accept: Fn, arg: Attr, limit: int) -> bool {
  return expose_with(m, accept, arg, true, limit)
}

fn candidates(m: Mod, op: Op, impls: list<Fn>) -> list<Fn> {
  let symbol = ir.target(m, op)
  var out: list<Fn> = []
  for impl in impls {
    if (ir.name(impl) == symbol || ir.symbol(impl) == symbol) &&
       ir.accepts(op, impl) {
      var seen = false
      for prior in out {
        seen = prior == impl || seen
      }
      if !seen {
        out += [impl]
      }
    }
  }
  return out
}

fn apply(m: Mod, impls: list<Fn>, limit: int) -> bool {
  let policies: list<Fn> = []
  return apply_with(m, impls, policies, {}, false, limit)
}

fn apply(m: Mod, impls: list<Fn>) -> bool {
  return apply(m, impls, len(impls) + 1)
}

fn apply(m: Mod, impls: list<Fn>, policy: Fn, limit: int) -> bool {
  return apply_with(m, impls, [policy], {}, false, limit)
}

fn apply(m: Mod, impls: list<Fn>, policy: Fn) -> bool {
  return apply(m, impls, policy, len(impls) + 1)
}

fn apply(
  m: Mod, impls: list<Fn>, policy: Fn, config: dict, limit: int
) -> bool {
  return apply_with(m, impls, [policy], config, true, limit)
}

fn apply(
  m: Mod, impls: list<Fn>, policy: Fn, config: dict
) -> bool {
  return apply(m, impls, policy, config, len(impls) + 1)
}

fn instantiate(m: Mod, impls: list<Fn>, limit: int) -> bool {
  let policies: list<Fn> = []
  return instantiate_with(m, impls, policies, {}, false, limit)
}

fn instantiate(m: Mod, impls: list<Fn>) -> bool {
  return instantiate(m, impls, len(ir.ops(m)) + len(impls) + 1)
}

fn instantiate(m: Mod, module: str, limit: int) -> bool {
  return instantiate(m, ir.fns(module), limit)
}

fn instantiate(m: Mod, module: str) -> bool {
  return instantiate(m, ir.fns(module))
}

fn instantiate(
  m: Mod, impls: list<Fn>, policy: Fn, limit: int
) -> bool {
  return instantiate_with(m, impls, [policy], {}, false, limit)
}

fn instantiate(m: Mod, impls: list<Fn>, policy: Fn) -> bool {
  return instantiate(
    m, impls, policy, len(ir.ops(m)) + len(impls) + 1
  )
}

fn instantiate(
  m: Mod, impls: list<Fn>, policy: Fn, config: dict, limit: int
) -> bool {
  return instantiate_with(m, impls, [policy], config, true, limit)
}

fn instantiate(
  m: Mod, impls: list<Fn>, policy: Fn, config: dict
) -> bool {
  return instantiate(
    m, impls, policy, config, len(ir.ops(m)) + len(impls) + 1
  )
}

fn rename(m: Mod, rules: list<list<str>>) -> bool {
  var changed = false
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) {
      var selected = false
      for rule in rules {
        if !selected && len(rule) == 2 {
          if ir.callee(op) == rule[0] {
            selected = true
            changed = ir.rename(m, op, rule[1]) || changed
          }
        }
      }
    }
  }
  return changed
}

fn expand(m: Mod, callees: list<str>) -> bool {
  var calls: list<Op> = []
  var bodies: list<Fn> = []
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) {
      let target = ir.resolve(m, op)
      let symbol = ir.target(m, op)
      var selected = false
      for callee in callees {
        if !selected {
          if (ir.callee(op) == callee || symbol == callee) &&
             ir.live(target) && len(ir.blks(target)) != 0 {
            selected = true
            calls += [op]
            bodies += [target]
          }
        }
      }
    }
  }
  return len(calls) != 0 && ir.expand(m, calls, bodies)
}

fn fuse(m: Mod, pattern: list<str>, replacement: str) -> bool {
  var changed = false
  if len(pattern) > 1 {
    for first in ir.ops(m) {
      if ir.callee(first) == pattern[0] {
        var matched = true
        var current = first
        var group = [first]
        for i in 1..len(pattern) {
          if matched {
            let outs = ir.outs(current)
            if len(outs) == 1 {
              let users = ir.users(outs[0])
              if len(users) == 1 {
                let next = users[0]
                if ir.callee(next) == pattern[i] {
                  current = next
                  group += [next]
                } else {
                  matched = false
                }
              } else {
                matched = false
              }
            } else {
              matched = false
            }
          }
        }
        if matched {
          changed = ir.fuse(m, group, replacement)
        }
      }
    }
  }
  return changed
}
