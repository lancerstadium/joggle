module opt
use ir

fn fold(m: Mod, fns: list<Fn>) -> bool {
  var calls: list<Op> = []
  var bodies: list<Fn> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      let target = ir.resolve(m, op)
      if ir.live(target) {
        var selected = false
        for fn in fns {
          if !selected && fn == target {
            selected = true
            calls += [op]
            bodies += [fn]
          }
        }
      }
    }
  }
  return len(calls) != 0 && ir.fold(m, calls, bodies)
}

fn fold(m: Mod) -> bool {
  return fold(m, ir.fns("base"))
}

fn copy(m: Mod) -> bool {
  var calls: list<Op> = []
  var old: list<Val> = []
  var next: list<Val> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       ir.callee(op) == "base.copy" && len(ir.meta(op)) == 0 {
      let args = ir.args(op)
      let outs = ir.outs(op)
      var root = false
      for fn in ir.fns(m) {
        let blocks = ir.blks(fn)
        if len(blocks) != 0 && ir.blk(op) == blocks[0] {
          root = true
        }
      }
      var carried = false
      if len(outs) == 1 {
        for user in ir.users(outs[0]) {
          let kind = ir.kind(user)
          if kind == "loop" || kind == "branch" || kind == "yield" {
            carried = true
          }
        }
      }
      if len(args) == 1 && len(outs) == 1 &&
         ir.type(args[0]) == ir.type(outs[0]) && root && !carried {
        calls += [op]
        old += [outs[0]]
        next += [args[0]]
      }
    }
  }
  if len(calls) == 0 {
    return false
  }
  base.assert(ir.replace(m, old, next), "opt.copy could not replace values")
  return ir.erase(m, calls)
}

fn fold_identity(m: Mod, callee: str, identity: Attr, side: int) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.callee(op) == callee && (side == 0 || side == 1) {
      let args = ir.args(op)
      let outs = ir.outs(op)
      if len(args) == 2 && len(outs) == 1 {
        if ir.is_const(args[side]) {
          if ir.constant(args[side]) == identity {
            let keep = args[1 - side]
            if ir.type(outs[0]) == ir.type(keep) {
              changed = ir.replace(m, outs[0], keep)
              changed = ir.erase(m, op)
            }
          }
        }
      }
    }
  }
  return changed
}

fn fold_add_zero(m: Mod) -> bool {
  var changed = fold_identity(m, "operator +", 0, 1)
  changed = fold_identity(m, "operator +", 0, 0) || changed
  return changed
}

fn dce(m: Mod, pure: list<str>) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) {
      var allowed = ir.kind(op) == "constant"
      for callee in pure {
        if ir.kind(op) == "call" && callee == ir.callee(op) {
          allowed = true
        }
      }
      if allowed {
        var unused = true
        for value in ir.outs(op) {
          if len(ir.users(value)) != 0 {
            unused = false
          }
        }
        if unused {
          changed = ir.erase(m, op) || changed
        }
      }
    }
  }
  return changed
}

fn cse(m: Mod, pure: list<str>) -> bool {
  var changed = false
  let ops = ir.ops(m)
  for i in 0..len(ops) {
    let op = ops[i]
    if ir.live(op) {
      var allowed = false
      for callee in pure {
        if callee == ir.callee(op) {
          allowed = true
        }
      }
      if ir.kind(op) == "call" && allowed {
        var merged = false
        for j in 0..i {
          if !merged {
            let prior = ops[j]
            if ir.live(prior) {
              if ir.kind(prior) == "call" && ir.blk(prior) == ir.blk(op) {
                let left = ir.outs(prior)
                let right = ir.outs(op)
                var same = len(left) == len(right)
                if same {
                  for k in 0..len(left) {
                    if ir.type(left[k]) != ir.type(right[k]) {
                      same = false
                    }
                  }
                }
                if same && ir.callee(prior) == ir.callee(op) &&
                   ir.args(prior) == ir.args(op) &&
                   ir.meta(prior) == ir.meta(op) {
                  var replaced = true
                  for k in 0..len(ir.outs(op)) {
                    replaced = ir.replace(
                      m, ir.outs(op)[k], ir.outs(prior)[k]
                    ) && replaced
                  }
                  if replaced {
                    merged = ir.erase(m, op)
                    changed = merged || changed
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return changed
}

fn fix(m: Mod, pure: list<str>, limit: int) -> bool {
  base.assert(limit > 0, "opt.fix requires a positive limit")
  let safe = pure + ["operator +", "operator *"]
  var changed = false
  var again = true
  var exhausted = false
  for i in 0..limit {
    if again {
      let before = ir.revision(m)
      fold_identity(m, "operator +", 0, 0)
      fold_identity(m, "operator +", 0, 1)
      fold_identity(m, "operator *", 1, 0)
      fold_identity(m, "operator *", 1, 1)
      cse(m, safe)
      dce(m, safe)
      again = ir.revision(m) != before
      changed = again || changed
      if i == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "opt.fix did not converge")
  return changed
}

fn basic(m: Mod) -> bool {
  return fix(m, [], len(ir.ops(m)) + 1)
}

fn count(m: Mod, callee: str) -> int {
  var total = 0
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      if ir.callee(op) == callee {
        total += 1
      }
    }
  }
  return total
}

fn unresolved(m: Mod) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       ir.callee(op) != "base.list" {
      if !ir.live(ir.resolve(m, op)) {
        let callee = ir.callee(op)
        var seen = false
        for item in out {
          if item == callee {
            seen = true
          }
        }
        if !seen {
          out += [callee]
        }
      }
    }
  }
  return out
}

fn untyped(m: Mod) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      var open = false
      for value in ir.outs(op) {
        if ir.type(value) == ty("_") {
          open = true
        }
      }
      if open {
        let callee = ir.callee(op)
        var seen = false
        for item in out {
          if item == callee {
            seen = true
          }
        }
        if !seen {
          out += [callee]
        }
      }
    }
  }
  return out
}

fn supports(m: Mod, op: Op, caps: list<Fn>) -> bool {
  if ir.callee(op) == "base.list" {
    return true
  }
  var symbol = ir.callee(op)
  let target = ir.resolve(m, op)
  if ir.live(target) {
    symbol = ir.symbol(target)
  }
  for cap in caps {
    if ir.name(cap) == symbol && ir.accepts(op, cap) {
      return true
    }
  }
  return false
}

fn frontier(m: Mod, caps: list<Fn>) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       !supports(m, op, caps) {
      var symbol = ir.callee(op)
      let target = ir.resolve(m, op)
      if ir.live(target) {
        symbol = ir.symbol(target)
      }
      var seen = false
      for item in out {
        if item == symbol {
          seen = true
        }
      }
      if !seen {
        out += [symbol]
      }
    }
  }
  return out
}

fn legalize(m: Mod, caps: list<Fn>, limit: int) -> bool {
  var changed = false
  var again = true
  for round in 0..limit {
    if again {
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      for op in ir.ops(m) {
        if ir.live(op) && ir.kind(op) == "call" &&
           !supports(m, op, caps) && len(ir.meta(op)) == 0 {
          let target = ir.resolve(m, op)
          if ir.live(target) && len(ir.blks(target)) != 0 {
            calls += [op]
            bodies += [target]
          }
        }
      }
      again = len(calls) != 0 && ir.expand(m, calls, bodies)
      changed = again || changed
    }
  }
  return changed
}

fn apply(m: Mod, impls: list<Fn>, limit: int) -> bool {
  assert(limit >= 0, "opt.apply limit must not be negative")
  var changed = false
  var again = true
  var exceeded = false
  for round in 0..(limit + 1) {
    if again {
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      for op in ir.ops(m) {
        if ir.live(op) && ir.kind(op) == "call" && len(ir.meta(op)) == 0 {
          var symbol = ir.callee(op)
          let source = ir.resolve(m, op)
          if ir.live(source) {
            symbol = ir.symbol(source)
          }
          var candidates: list<Fn> = []
          for impl in impls {
            if ir.name(impl) == symbol && len(ir.blks(impl)) != 0 {
              candidates += [impl]
            }
          }
          let selected = ir.match(op, candidates)
          if ir.live(selected) {
            calls += [op]
            bodies += [selected]
          }
        }
      }
      again = len(calls) != 0 && ir.expand(m, calls, bodies)
      changed = again || changed
      if round == limit && again {
        exceeded = true
      }
    }
  }
  assert(!exceeded, "opt.apply did not converge within its limit")
  return changed
}

fn apply(m: Mod, impls: list<Fn>) -> bool {
  return apply(m, impls, len(impls) + 1)
}

fn rename(m: Mod, rules: list<list<str>>) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      var selected = false
      for rule in rules {
        if !selected && len(rule) == 2 {
          if ir.callee(op) == rule[0] {
            selected = true
            changed = ir.rename(m, op, rule[1]) || changed
          }
        }
      }
    }
  }
  return changed
}

fn expand(m: Mod, callees: list<str>) -> bool {
  var calls: list<Op> = []
  var bodies: list<Fn> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      let target = ir.resolve(m, op)
      var symbol = ir.callee(op)
      if ir.live(target) {
        symbol = ir.symbol(target)
      }
      var selected = false
      for callee in callees {
        if !selected {
          if ir.callee(op) == callee || symbol == callee {
            selected = true
            calls += [op]
            bodies += [target]
          }
        }
      }
    }
  }
  return len(calls) != 0 && ir.expand(m, calls, bodies)
}

fn fuse(m: Mod, pattern: list<str>, replacement: str) -> bool {
  var changed = false
  if len(pattern) > 1 {
    for first in ir.ops(m) {
      if ir.callee(first) == pattern[0] {
        var matched = true
        var current = first
        var group = [first]
        for i in 1..len(pattern) {
          if matched {
            let outs = ir.outs(current)
            if len(outs) == 1 {
              let users = ir.users(outs[0])
              if len(users) == 1 {
                let next = users[0]
                if ir.callee(next) == pattern[i] {
                  current = next
                  group += [next]
                } else {
                  matched = false
                }
              } else {
                matched = false
              }
            } else {
              matched = false
            }
          }
        }
        if matched {
          changed = ir.fuse(m, group, replacement)
        }
      }
    }
  }
  return changed
}
