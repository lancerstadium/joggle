module opt
use ir

local fn mapped(value: Val, old: list<Val>, next: list<Val>) -> Val {
  for i in 0..len(old) {
    if value == old[i] {
      return next[i]
    }
  }
  return value
}

local fn project(m: Mod) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       ir.callee(op) == "operator []" {
      let args = ir.args(op)
      let outs = ir.outs(op)
      if len(args) == 2 && len(outs) == 1 && ir.is_const(args[1]) &&
         base.kind(ir.constant(args[1])) == "int" {
        let list = ir.def(args[0])
        if ir.live(list) && ir.kind(list) == "call" &&
           ir.callee(list) == "base.list" {
          let items = ir.args(list)
          let index = base.int(ir.constant(args[1]))
          if index >= 0 && index < len(items) &&
             ir.type(outs[0]) == ir.type(items[index]) {
            changed = ir.replace(m, outs[0], items[index]) || changed
            changed = ir.erase(m, op) || changed
          }
        }
      }
    }
  }
  return changed
}

local fn select(m: Mod) -> bool {
  var changed = false
  let candidates = ir.ops(m)
  for branch in candidates {
    if ir.live(branch) && ir.kind(branch) == "branch" &&
       len(ir.meta(branch)) == 0 {
      let inputs = ir.args(branch)
      let outputs = ir.outs(branch)
      let bodies = ir.blks(branch)
      if len(inputs) > 0 && len(bodies) == 2 &&
         ir.is_const(inputs[0]) &&
         base.kind(ir.constant(inputs[0])) == "bool" {
        var chosen = bodies[1]
        if ir.constant(inputs[0]) == true {
          chosen = bodies[0]
        }
        let args = ir.args(chosen)
        let ops = ir.ops(chosen)
        if len(args) == len(outputs) && len(inputs) == len(outputs) + 1 &&
           len(ops) > 0 && ir.kind(ops[len(ops) - 1]) == "yield" {
          var old = args
          var next: list<Val> = []
          for i in 1..len(inputs) {
            next += [inputs[i]]
          }
          for i in 0..len(ops) - 1 {
            let copy = ir.clone(m, ops[i], branch, old, next)
            assert(ir.live(copy), "opt.fold could not select a branch")
            old += ir.outs(ops[i])
            next += ir.outs(copy)
          }
          var values: list<Val> = []
          for value in ir.args(ops[len(ops) - 1]) {
            values += [mapped(value, old, next)]
          }
          if len(outputs) != 0 {
            for i in 0..len(outputs) {
              let output_type = ir.type(outputs[i])
              let value_type = ir.type(values[i])
              if output_type == ty("_") && value_type != ty("_") {
                assert(ir.type(m, outputs[i], value_type),
                       "opt.fold could not refine a branch result")
              } else {
                if value_type == ty("_") && output_type != ty("_") {
                  assert(ir.type(m, values[i], output_type),
                         "opt.fold could not refine a selected value")
                }
              }
              let selected_type = ir.type(values[i])
              let result_type = ir.type(outputs[i])
              if selected_type != result_type &&
                 ((selected_type == ty("index") && result_type == ty("int")) ||
                  (selected_type == ty("int") && result_type == ty("index"))) {
                values[i] = ir.call(
                  m, branch, text(result_type), [values[i]], result_type
                )
              }
              assert(ir.type(outputs[i]) == ir.type(values[i]),
                     "opt.fold branch type mismatch: " +
                     text(ir.type(outputs[i])) + " and " +
                     text(ir.type(values[i])))
            }
            assert(ir.replace(m, outputs, values),
                   "opt.fold could not replace branch results")
          }
          assert(ir.erase(m, branch), "opt.fold could not erase a branch")
          changed = true
        }
      }
    }
  }
  return changed
}

fn fold(m: Mod, fns: list<Fn>) -> bool {
  var calls: list<Op> = []
  var bodies: list<Fn> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      let target = ir.resolve(m, op)
      if ir.live(target) {
        var selected = false
        for fn in fns {
          if !selected && fn == target {
            selected = true
            calls += [op]
            bodies += [fn]
          }
        }
      }
    }
  }
  var changed = len(calls) != 0 && ir.fold(m, calls, bodies)
  changed = project(m) || changed
  changed = select(m) || changed
  for op in ir.ops(m) {
    if ir.live(op) &&
       (ir.kind(op) == "loop" || ir.kind(op) == "branch") {
      changed = ir.fold(m, op, fns) || changed
    }
  }
  return changed
}

fn fold(m: Mod) -> bool {
  return fold(m, ir.fns("base"))
}

local fn specialize_loop(m: Mod, loop: Op) -> bool {
  let inputs = ir.args(loop)
  let outputs = ir.outs(loop)
  let bodies = ir.blks(loop)
  let axes = len(inputs) - len(outputs)
  if ir.kind(loop) != "loop" || len(bodies) != 1 || axes <= 0 {
    return false
  }
  let body = bodies[0]
  let body_args = ir.args(body)
  let body_ops = ir.ops(body)
  if len(body_args) != axes + len(outputs) || len(body_ops) == 0 ||
     ir.kind(body_ops[len(body_ops) - 1]) != "yield" {
    return false
  }

  var lower: list<int> = []
  var sizes: list<int> = []
  var count = 1
  for axis in 0..axes {
    let range = ir.def(inputs[axis])
    if !ir.live(range) || ir.kind(range) != "call" ||
       ir.callee(range) != "operator .." {
      return false
    }
    let bounds = ir.args(range)
    if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
       !ir.is_const(bounds[1]) ||
       base.kind(ir.constant(bounds[0])) != "int" ||
       base.kind(ir.constant(bounds[1])) != "int" {
      return false
    }
    let begin = base.int(ir.constant(bounds[0]))
    let end = base.int(ir.constant(bounds[1]))
    var size = 0
    if end > begin {
      size = end - begin
    }
    lower += [begin]
    sizes += [size]
    count *= size
  }

  var current: list<Val> = []
  for i in axes..len(inputs) {
    current += [inputs[i]]
  }
  let yield = body_ops[len(body_ops) - 1]
  for point in 0..count {
    var remainder = point
    var coords: list<int> = []
    for axis in 0..axes {
      coords += [0]
    }
    for reverse in 0..axes {
      let axis = axes - reverse - 1
      coords[axis] = lower[axis] + remainder % sizes[axis]
      remainder /= sizes[axis]
    }

    var old: list<Val> = []
    var next: list<Val> = []
    for axis in 0..axes {
      old += [body_args[axis]]
      next += [ir.constant(m, loop, coords[axis], ty("index"))]
    }
    for i in 0..len(outputs) {
      old += [body_args[axes + i]]
      next += [current[i]]
    }
    for i in 0..len(body_ops) - 1 {
      let copy = ir.clone(m, body_ops[i], loop, old, next)
      assert(ir.live(copy), "opt.specialize could not clone a loop body")
      old += ir.outs(body_ops[i])
      next += ir.outs(copy)
    }
    current = []
    for value in ir.args(yield) {
      current += [mapped(value, old, next)]
    }
  }

  if len(outputs) != 0 {
    assert(ir.replace(m, outputs, current),
           "opt.specialize could not replace loop results")
  }
  assert(ir.erase(m, loop), "opt.specialize could not erase a loop")
  return true
}

fn specialize(m: Mod, key: str, value: Attr) -> bool {
  var changed = false
  let candidates = ir.ops(m)
  for reverse in 0..len(candidates) {
    let op = candidates[len(candidates) - reverse - 1]
    if ir.live(op) && ir.kind(op) == "loop" && ir.has(op, key) &&
       ir.meta(op, key) == value {
      assert(specialize_loop(m, op),
             "opt.specialize requires finite static ranges")
      changed = true
    }
  }
  if changed {
    // Projection can make a condition static; the second fold selects it.
    fold(m)
    fold(m)
    dce(m, ["base.list"])
  }
  return changed
}

local fn template_name(m: Mod, name: str) -> str {
  var out = ""
  for attempt in 0..len(ir.fns(m)) + 2 {
    var candidate = name + "_template"
    if attempt != 0 {
      candidate += "_" + text(attempt)
    }
    if out == "" && !ir.live(ir.find(m, candidate)) {
      out = candidate
    }
  }
  assert(out != "", "opt.instantiate could not reserve a temporary name")
  return out
}

fn instantiate(m: Mod, name: str, args: list<Ty>) -> bool {
  let source = ir.find(m, name)
  if !ir.live(source) || len(ir.generics(source)) == 0 ||
     len(ir.generics(source)) != len(args) {
    return false
  }
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" && ir.resolve(m, op) == source {
      return false
    }
  }
  let hidden = template_name(m, name)
  if !ir.rename(m, source, hidden) {
    return false
  }
  let instance = ir.clone(m, source, name, args)
  if !ir.live(instance) {
    assert(ir.rename(m, source, name),
           "opt.instantiate could not restore the source name")
    return false
  }
  assert(ir.erase(m, source),
         "opt.instantiate could not remove the generic source")
  return true
}

fn instantiate(m: Mod, name: str, args: list<str>) -> bool {
  var types: list<Ty> = []
  for arg in args {
    types += [ty(arg)]
  }
  return instantiate(m, name, types)
}

fn copy(m: Mod) -> bool {
  var calls: list<Op> = []
  var old: list<Val> = []
  var next: list<Val> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       ir.callee(op) == "base.copy" && len(ir.meta(op)) == 0 {
      let args = ir.args(op)
      let outs = ir.outs(op)
      var root = false
      for fn in ir.fns(m) {
        let blocks = ir.blks(fn)
        if len(blocks) != 0 && ir.blk(op) == blocks[0] {
          root = true
        }
      }
      var carried = false
      if len(outs) == 1 {
        for user in ir.users(outs[0]) {
          let kind = ir.kind(user)
          if kind == "loop" || kind == "branch" || kind == "yield" {
            carried = true
          }
        }
      }
      if len(args) == 1 && len(outs) == 1 &&
         ir.type(args[0]) == ir.type(outs[0]) && root && !carried {
        calls += [op]
        old += [outs[0]]
        next += [args[0]]
      }
    }
  }
  if len(calls) == 0 {
    return false
  }
  base.assert(ir.replace(m, old, next), "opt.copy could not replace values")
  return ir.erase(m, calls)
}

fn fold_identity(m: Mod, callee: str, identity: Attr, side: int) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.callee(op) == callee && (side == 0 || side == 1) {
      let args = ir.args(op)
      let outs = ir.outs(op)
      if len(args) == 2 && len(outs) == 1 {
        if ir.is_const(args[side]) {
          if ir.constant(args[side]) == identity {
            let keep = args[1 - side]
            if ir.type(outs[0]) == ir.type(keep) {
              changed = ir.replace(m, outs[0], keep)
              changed = ir.erase(m, op)
            }
          }
        }
      }
    }
  }
  return changed
}

fn fold_add_zero(m: Mod) -> bool {
  var changed = fold_identity(m, "operator +", 0, 1)
  changed = fold_identity(m, "operator +", 0, 0) || changed
  return changed
}

local fn needs_declaration(op: Op) -> bool {
  if ir.form(op) != "var" || len(ir.outs(op)) != 1 {
    return false
  }
  let name = ir.name(ir.outs(op)[0])
  for peer in ir.ops(ir.blk(op)) {
    let form = ir.form(peer)
    if ir.live(peer) && len(ir.outs(peer)) == 1 &&
       (form == "assign" || form == "compound" ||
        form == "index_assign") && ir.name(ir.outs(peer)[0]) == name {
      return true
    }
  }
  return false
}

fn dce(m: Mod, pure: list<str>) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) {
      var allowed = ir.kind(op) == "constant"
      for callee in pure {
        if ir.kind(op) == "call" && callee == ir.callee(op) {
          allowed = true
        }
      }
      allowed = allowed && !needs_declaration(op)
      if allowed {
        var unused = true
        for value in ir.outs(op) {
          if len(ir.users(value)) != 0 {
            unused = false
          }
        }
        if unused {
          changed = ir.erase(m, op) || changed
        }
      }
    }
  }
  return changed
}

fn cse(m: Mod, pure: list<str>) -> bool {
  var changed = false
  let ops = ir.ops(m)
  for i in 0..len(ops) {
    let op = ops[i]
    if ir.live(op) {
      var allowed = false
      for callee in pure {
        if callee == ir.callee(op) {
          allowed = true
        }
      }
      if ir.kind(op) == "call" && allowed {
        var merged = false
        for j in 0..i {
          if !merged {
            let prior = ops[j]
            if ir.live(prior) {
              if ir.kind(prior) == "call" && ir.blk(prior) == ir.blk(op) {
                let left = ir.outs(prior)
                let right = ir.outs(op)
                var same = len(left) == len(right)
                if same {
                  for k in 0..len(left) {
                    if ir.type(left[k]) != ir.type(right[k]) {
                      same = false
                    }
                  }
                }
                if same && ir.callee(prior) == ir.callee(op) &&
                   ir.args(prior) == ir.args(op) &&
                   ir.meta(prior) == ir.meta(op) {
                  var replaced = true
                  for k in 0..len(ir.outs(op)) {
                    replaced = ir.replace(
                      m, ir.outs(op)[k], ir.outs(prior)[k]
                    ) && replaced
                  }
                  if replaced {
                    merged = ir.erase(m, op)
                    changed = merged || changed
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return changed
}

fn fix(m: Mod, pure: list<str>, limit: int) -> bool {
  base.assert(limit > 0, "opt.fix requires a positive limit")
  let safe = pure + ["operator +", "operator *"]
  var changed = false
  var again = true
  var exhausted = false
  for i in 0..limit {
    if again {
      let before = ir.revision(m)
      fold_identity(m, "operator +", 0, 0)
      fold_identity(m, "operator +", 0, 1)
      fold_identity(m, "operator *", 1, 0)
      fold_identity(m, "operator *", 1, 1)
      cse(m, safe)
      dce(m, safe)
      again = ir.revision(m) != before
      changed = again || changed
      if i == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "opt.fix did not converge")
  return changed
}

fn basic(m: Mod) -> bool {
  return fix(m, [], len(ir.ops(m)) + 1)
}

fn count(m: Mod, callee: str) -> int {
  var total = 0
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      if ir.callee(op) == callee {
        total += 1
      }
    }
  }
  return total
}

fn unresolved(m: Mod) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       ir.callee(op) != "base.list" {
      if !ir.live(ir.resolve(m, op)) {
        let callee = ir.callee(op)
        var seen = false
        for item in out {
          if item == callee {
            seen = true
          }
        }
        if !seen {
          out += [callee]
        }
      }
    }
  }
  return out
}

fn untyped(m: Mod) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      var open = false
      for value in ir.outs(op) {
        if ir.type(value) == ty("_") {
          open = true
        }
      }
      if open {
        let callee = ir.callee(op)
        var seen = false
        for item in out {
          if item == callee {
            seen = true
          }
        }
        if !seen {
          out += [callee]
        }
      }
    }
  }
  return out
}

fn supports(m: Mod, op: Op, caps: list<Fn>) -> bool {
  if ir.callee(op) == "base.list" {
    return true
  }
  var symbol = ir.callee(op)
  let target = ir.resolve(m, op)
  if ir.live(target) {
    symbol = ir.symbol(target)
  }
  for cap in caps {
    if ir.name(cap) == symbol && ir.accepts(op, cap) {
      return true
    }
  }
  return false
}

local fn supports_with(
  m: Mod, op: Op, accept: Fn, arg: Attr, configured: bool
) -> bool {
  let before = ir.revision(m)
  var result = false
  if configured {
    result = ir.invoke<bool>(m, op, accept, arg)
  } else {
    result = ir.invoke<bool>(m, op, accept)
  }
  assert(ir.revision(m) == before,
         "opt: capability function must not mutate the module")
  return result
}

fn supports(m: Mod, op: Op, accept: Fn) -> bool {
  return supports_with(m, op, accept, nil, false)
}

fn supports(m: Mod, op: Op, accept: Fn, arg: Attr) -> bool {
  return supports_with(m, op, accept, arg, true)
}

fn frontier(m: Mod, caps: list<Fn>) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       !supports(m, op, caps) {
      var symbol = ir.callee(op)
      let target = ir.resolve(m, op)
      if ir.live(target) {
        symbol = ir.symbol(target)
      }
      var seen = false
      for item in out {
        if item == symbol {
          seen = true
        }
      }
      if !seen {
        out += [symbol]
      }
    }
  }
  return out
}

local fn frontier_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool
) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       !supports_with(m, op, accept, arg, configured) {
      var symbol = ir.callee(op)
      let target = ir.resolve(m, op)
      if ir.live(target) {
        symbol = ir.symbol(target)
      }
      var seen = false
      for item in out {
        if item == symbol {
          seen = true
        }
      }
      if !seen {
        out += [symbol]
      }
    }
  }
  return out
}

fn frontier(m: Mod, accept: Fn) -> list<str> {
  return frontier_with(m, accept, nil, false)
}

fn frontier(m: Mod, accept: Fn, arg: Attr) -> list<str> {
  return frontier_with(m, accept, arg, true)
}

fn legalize(m: Mod, caps: list<Fn>, limit: int) -> bool {
  var changed = false
  var again = true
  for round in 0..limit {
    if again {
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      for op in ir.ops(m) {
        if ir.live(op) && ir.kind(op) == "call" &&
           !supports(m, op, caps) && len(ir.meta(op)) == 0 {
          let target = ir.resolve(m, op)
          if ir.live(target) && len(ir.blks(target)) != 0 {
            calls += [op]
            bodies += [target]
          }
        }
      }
      again = len(calls) != 0 && ir.expand(m, calls, bodies)
      changed = again || changed
    }
  }
  return changed
}

local fn expand_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool
) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" &&
       !supports_with(m, op, accept, arg, configured) &&
       len(ir.meta(op)) == 0 {
      let target = ir.resolve(m, op)
      if ir.live(target) && len(ir.blks(target)) != 0 {
        changed = ir.expand(m, op, target) || changed
      }
    }
  }
  return changed
}

fn expand(m: Mod, accept: Fn) -> bool {
  return expand_with(m, accept, nil, false)
}

fn expand(m: Mod, accept: Fn, arg: Attr) -> bool {
  return expand_with(m, accept, arg, true)
}

local fn legalize_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool, limit: int
) -> bool {
  assert(limit >= 0, "opt.legalize limit must not be negative")
  var changed = false
  var again = true
  var exceeded = false
  for round in 0..(limit + 1) {
    if again {
      again = expand_with(m, accept, arg, configured)
      changed = again || changed
      if round == limit && again {
        exceeded = true
      }
    }
  }
  assert(!exceeded, "opt.legalize did not converge within its limit")
  return changed
}

fn legalize(m: Mod, accept: Fn, limit: int) -> bool {
  return legalize_with(m, accept, nil, false, limit)
}

fn legalize(m: Mod, accept: Fn, arg: Attr, limit: int) -> bool {
  return legalize_with(m, accept, arg, true, limit)
}

local fn expose_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool, limit: int
) -> bool {
  assert(limit >= 0, "opt.expose limit must not be negative")
  var changed = false
  var again = true
  var exceeded = false
  for round in 0..(limit + 1) {
    if again {
      let before = ir.revision(m)
      fold(m)
      copy(m)
      dce(m, [])
      expand_with(m, accept, arg, configured)
      again = ir.revision(m) != before
      changed = again || changed
      if round == limit && again {
        exceeded = true
      }
    }
  }
  assert(!exceeded, "opt.expose did not converge within its limit")
  return changed
}

fn expose(m: Mod, accept: Fn, limit: int) -> bool {
  return expose_with(m, accept, nil, false, limit)
}

fn expose(m: Mod, accept: Fn, arg: Attr, limit: int) -> bool {
  return expose_with(m, accept, arg, true, limit)
}

fn apply(m: Mod, impls: list<Fn>, limit: int) -> bool {
  assert(limit >= 0, "opt.apply limit must not be negative")
  var changed = false
  var again = true
  var exceeded = false
  for round in 0..(limit + 1) {
    if again {
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      for op in ir.ops(m) {
        if ir.live(op) && ir.kind(op) == "call" && len(ir.meta(op)) == 0 {
          var symbol = ir.callee(op)
          let source = ir.resolve(m, op)
          if ir.live(source) {
            symbol = ir.symbol(source)
          }
          var candidates: list<Fn> = []
          for impl in impls {
            if ir.name(impl) == symbol && len(ir.blks(impl)) != 0 {
              candidates += [impl]
            }
          }
          let selected = ir.match(op, candidates)
          if ir.live(selected) {
            calls += [op]
            bodies += [selected]
          }
        }
      }
      again = len(calls) != 0 && ir.expand(m, calls, bodies)
      changed = again || changed
      if round == limit && again {
        exceeded = true
      }
    }
  }
  assert(!exceeded, "opt.apply did not converge within its limit")
  return changed
}

fn apply(m: Mod, impls: list<Fn>) -> bool {
  return apply(m, impls, len(impls) + 1)
}

fn rename(m: Mod, rules: list<list<str>>) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      var selected = false
      for rule in rules {
        if !selected && len(rule) == 2 {
          if ir.callee(op) == rule[0] {
            selected = true
            changed = ir.rename(m, op, rule[1]) || changed
          }
        }
      }
    }
  }
  return changed
}

fn expand(m: Mod, callees: list<str>) -> bool {
  var calls: list<Op> = []
  var bodies: list<Fn> = []
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      let target = ir.resolve(m, op)
      var symbol = ir.callee(op)
      if ir.live(target) {
        symbol = ir.symbol(target)
      }
      var selected = false
      for callee in callees {
        if !selected {
          if (ir.callee(op) == callee || symbol == callee) &&
             ir.live(target) && len(ir.blks(target)) != 0 {
            selected = true
            calls += [op]
            bodies += [target]
          }
        }
      }
    }
  }
  return len(calls) != 0 && ir.expand(m, calls, bodies)
}

fn fuse(m: Mod, pattern: list<str>, replacement: str) -> bool {
  var changed = false
  if len(pattern) > 1 {
    for first in ir.ops(m) {
      if ir.callee(first) == pattern[0] {
        var matched = true
        var current = first
        var group = [first]
        for i in 1..len(pattern) {
          if matched {
            let outs = ir.outs(current)
            if len(outs) == 1 {
              let users = ir.users(outs[0])
              if len(users) == 1 {
                let next = users[0]
                if ir.callee(next) == pattern[i] {
                  current = next
                  group += [next]
                } else {
                  matched = false
                }
              } else {
                matched = false
              }
            } else {
              matched = false
            }
          }
        }
        if matched {
          changed = ir.fuse(m, group, replacement)
        }
      }
    }
  }
  return changed
}
