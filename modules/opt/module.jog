module opt
use ir

fn fold_add_zero(m: Mod) -> bool {
  var changed = false
  for f in ir.fns(m) {
    for b in ir.blocks(f) {
      for op in ir.ops(b) {
        if ir.callee(op) == "operator +" {
          let args = ir.args(op)
          let outs = ir.outs(op)
          if ir.len(args) == 2 && ir.len(outs) == 1 {
            if ir.is_const(args[1]) {
              if ir.constant(args[1]) == 0 {
                changed = ir.replace(m, outs[0], args[0])
                changed = ir.erase(m, op)
              }
            }
          }
        }
      }
    }
  }
  return changed
}

fn fuse(m: Mod, pattern: list<str>, replacement: str) -> bool {
  var changed = false
  if ir.len(pattern) > 1 {
    for f in ir.fns(m) {
      for b in ir.blocks(f) {
        for first in ir.ops(b) {
          if ir.callee(first) == pattern[0] {
            var matched = true
            var current = first
            var group = [first]
            for i in 1..ir.len(pattern) {
              if matched {
                let outs = ir.outs(current)
                if ir.len(outs) == 1 {
                  let users = ir.users(outs[0])
                  if ir.len(users) == 1 {
                    let next = users[0]
                    if ir.callee(next) == pattern[i] {
                      current = next
                      group += [next]
                    } else {
                      matched = false
                    }
                  } else {
                    matched = false
                  }
                } else {
                  matched = false
                }
              }
            }
            if matched {
              changed = ir.fuse(m, group, replacement)
            }
          }
        }
      }
    }
  }
  return changed
}
