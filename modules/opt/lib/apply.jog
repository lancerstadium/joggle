local fn choose(
  m: Mod, op: Op, impls: list<Fn>, policies: list<Fn>,
  config: dict, configured: bool
) -> list<Fn> {
  assert(len(policies) <= 1, "opt accepts at most one policy")
  let available = candidates(m, op, impls)
  if len(policies) == 0 || len(available) == 0 {
    return available
  }

  let policy = policies[0]
  let returns = ir.returns(policy)
  assert(len(returns) == 1 &&
         (returns[0] == ty("bool") ||
          returns[0] == ty("list<Fn>")),
         "opt policy must return bool or list<Fn>")
  if returns[0] == ty("bool") {
    var out: list<Fn> = []
    for impl in available {
      let before = ir.revision(m)
      var accepted = false
      if configured {
        accepted = ir.invoke<bool>(m, op, policy, impl, config)
      } else {
        accepted = ir.invoke<bool>(m, op, policy, impl)
      }
      assert(ir.revision(m) == before,
             "opt policy must not mutate the module")
      if accepted {
        out += [impl]
      }
    }
    return out
  }

  let before = ir.revision(m)
  var selected: list<Fn> = []
  if configured {
    selected = ir.invoke<list<Fn>>(m, op, policy, available, config)
  } else {
    selected = ir.invoke<list<Fn>>(m, op, policy, available)
  }
  assert(ir.revision(m) == before,
         "opt policy must not mutate the module")
  assert(len(selected) <= 1,
         "opt policy must select at most one implementation")
  if len(selected) == 1 {
    var member = false
    for impl in available {
      member = selected[0] == impl || member
    }
    assert(member,
           "opt policy selected a function outside its candidates")
  }
  return selected
}

local fn apply_with(
  m: Mod, impls: list<Fn>, policies: list<Fn>,
  config: dict, configured: bool, limit: int
) -> bool {
  assert(limit >= 0, "opt.apply limit must not be negative")
  var changed = false
  var again = true
  var exceeded = false
  for round in 0..(limit + 1) {
    if again {
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      var redirects: list<Op> = []
      var targets: list<Fn> = []
      for op in ir.ops(m, ["call"]) {
        if ir.live(op) && len(ir.meta(op)) == 0 {
          let selected = ir.match(
            op, choose(m, op, impls, policies, config, configured)
          )
          if ir.live(selected) && selected != ir.resolve(m, op) {
            if len(ir.blks(selected)) == 0 {
              redirects += [op]
              targets += [selected]
            } else {
              calls += [op]
              bodies += [selected]
            }
          }
        }
      }
      again = false
      for i in 0..len(redirects) {
        assert(ir.retarget(m, redirects[i], targets[i]),
               "opt.apply could not select an external implementation")
        again = true
      }
      if len(calls) != 0 {
        assert(ir.expand(m, calls, bodies),
               "opt.apply could not expand a selected implementation")
        again = true
      }
      changed = again || changed
      if round == limit && again {
        exceeded = true
      }
    }
  }
  assert(!exceeded, "opt.apply did not converge within its limit")
  changed = ir.trim(m) || changed
  return changed
}
