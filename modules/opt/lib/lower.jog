local fn expand_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool
) -> bool {
  var calls: list<Op> = []
  var bodies: list<Fn> = []
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) &&
       !supports_with(m, op, accept, arg, configured) &&
       len(ir.meta(op)) == 0 {
      let target = ir.resolve(m, op)
      if ir.live(target) && len(ir.blks(target)) != 0 {
        calls += [op]
        bodies += [target]
      }
    }
  }
  if len(calls) == 0 {
    return false
  }
  // Expand atomically when possible; isolate refusals without blocking later
  // calls or retaining an incomplete body from a failed expansion.
  return ir.expand_partial(m, calls, bodies, true)
}

local fn legalize_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool, limit: int
) -> bool {
  assert(limit >= 0, "opt.legalize limit must not be negative")
  var changed = false
  for round in 0..(limit + 1) {
    let again = expand_with(m, accept, arg, configured)
    changed = again || changed
    if !again {
      return changed
    }
    assert(round < limit, "opt.legalize did not converge within its limit")
  }
  return changed
}

local fn expose_with(
  m: Mod, accept: Fn, arg: Attr, configured: bool, limit: int
) -> bool {
  assert(limit >= 0, "opt.expose limit must not be negative")
  var changed = false
  for round in 0..(limit + 1) {
    let before = ir.revision(m)
    fold(m)
    copy(m)
    dce(m, [])
    // Only successful inlining can expose another call layer. Canonicalization
    // alone does not require an additional exposure round.
    let again = expand_with(m, accept, arg, configured)
    changed = ir.revision(m) != before || changed
    if !again {
      return changed
    }
    assert(round < limit, "opt.expose did not converge within its limit")
  }
  return changed
}
