module math

fn abs(x: f32) -> f32;
fn abs(x: f64) -> f64;
fn ceil(x: f32) -> f32;
fn ceil(x: f64) -> f64;
fn erf(x: f32) -> f32;
fn erf(x: f64) -> f64;
fn exp(x: f32) -> f32;
fn exp(x: f64) -> f64;
fn floor(x: f32) -> f32;
fn floor(x: f64) -> f64;
fn log(x: f32) -> f32;
fn log(x: f64) -> f64;
fn pow(x: f32, y: f32) -> f32;
fn pow(x: f64, y: f64) -> f64;
fn round_even(x: f32) -> f32;
fn round_even(x: f64) -> f64;
fn sqrt(x: f32) -> f32;
fn sqrt(x: f64) -> f64;
fn tanh(x: f32) -> f32;
fn tanh(x: f64) -> f64;
