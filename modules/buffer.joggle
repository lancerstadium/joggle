joggle 1;

module buffer@1.0.0 {
  interface storage: type {
    element_type: type;
    shape: list<int>;
    address_space: string;
  }
  interface reads: fn;
  interface writes: fn;
  interface allocates: fn;

  type token();
  type buffer(element: type, shape: list<int>, space: string = "") : storage {
    element_type = element;
    address_space = space;
  }

  fn start() -> token;
  fn alloc<E: prelude.scalar, S: list<int>, Space: string>(
    chain: token,
    shape: S,
    space: Space = ""
  ) -> (buffer<E, S, Space>, token) : allocates;
  fn read<E: prelude.scalar, S: list<int>, Space: string>(
    chain: token,
    source: buffer<E, S, Space>,
    indices: list<int>
  ) -> (E, token) : reads;
  fn write<E: prelude.scalar, S: list<int>, Space: string>(
    chain: token,
    value: E,
    destination: buffer<E, S, Space>,
    indices: list<int>
  ) -> token : writes;
  fn copy<E: prelude.scalar, S: list<int>, From: string, To: string>(
    chain: token,
    source: buffer<E, S, From>,
    destination: buffer<E, S, To>
  ) -> token : reads, writes;
}
