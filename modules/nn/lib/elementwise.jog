fn add<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return left + right
}

fn add<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return a + b
}

fn add<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>, activation: str
) -> tensor<E, S> {
  return activate(left + right, activation)
}

fn add<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>, activation: str
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return activate(a + b, activation)
}

fn sub<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return left - right
}

fn sub<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return a - b
}

fn sub<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>, activation: str
) -> tensor<E, S> {
  return activate(left - right, activation)
}

fn sub<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>, activation: str
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return activate(a - b, activation)
}

fn mul<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return left * right
}

fn mul<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return a * b
}

fn mul<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>, activation: str
) -> tensor<E, S> {
  return activate(left * right, activation)
}

fn mul<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>, activation: str
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return activate(a * b, activation)
}

fn div<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return left / right
}

fn div<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return a / b
}

fn maximum<E: Ty>(left: E, right: E) -> E {
  var out = right
  if left != left || (right == right && left > right) {
    out = left
  }
  return out
}

fn maximum<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = maximum(left[i], right[i])
  }
  return out
}

fn maximum<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return maximum(a, b)
}

fn minimum<E: Ty>(left: E, right: E) -> E {
  var out = right
  if left != left || (right == right && left < right) {
    out = left
  }
  return out
}

fn minimum<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = minimum(left[i], right[i])
  }
  return out
}

fn minimum<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return minimum(a, b)
}

fn pow<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = pow(left[i], right[i])
  }
  return out
}

fn pow<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return pow(a, b)
}

fn sqrt<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = sqrt(x[i])
  }
  return out
}

fn reduce_l2<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  let reduced: tensor<E, Y> = tensor.sum(x * x, axes)
  return sqrt(reduced)
}

fn cos<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = cos(x[i])
  }
  return out
}

fn sin<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = sin(x[i])
