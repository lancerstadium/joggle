// Specialize rank and scalar operation; keep logical extents as runtime values.
// Zero strides reuse broadcast input elements without allocating expanded copies.
local fn arithmetic_runtime<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>,
  P: int, Q: int, D: int, Mode: int
>(a: tensor<E, L>, b: tensor<E, R>) -> tensor<E, Y> {
  let shape, left_strides, right_strides, count =
    tensor.broadcast_layout<E, E, L, R, P, Q, D>(a, b)
  var out: tensor<E, Y> = tensor.make(E(0), shape)
  for linear in index(0)..count {
    var remaining = linear
    var left = index(0)
    var right = index(0)
    [stage: "shape"]
    for reverse in 0..D {
      let axis = D - reverse - 1
      let coordinate = remaining % shape[axis]
      remaining /= shape[axis]
      left += coordinate * left_strides[axis]
      right += coordinate * right_strides[axis]
    }
    var value = E(0)
    if Mode == 0 { value = a[left] + b[right] }
    if Mode == 1 { value = a[left] - b[right] }
    if Mode == 2 { value = a[left] * b[right] }
    if Mode == 3 { value = a[left] / b[right] }
    out[linear] = value
  }
  return tensor.view<E, index, Y, Y, D>(out, shape)
}

fn add<E: Ty>(left: tensor<E, []>, right: tensor<E, []>) -> tensor<E, []> {
  return tensor<E, []>(left[0] + right[0])
}

fn sub<E: Ty>(left: tensor<E, []>, right: tensor<E, []>) -> tensor<E, []> {
  return tensor<E, []>(left[0] - right[0])
}

fn mul<E: Ty>(left: tensor<E, []>, right: tensor<E, []>) -> tensor<E, []> {
  return tensor<E, []>(left[0] * right[0])
}

fn div<E: Ty>(left: tensor<E, []>, right: tensor<E, []>) -> tensor<E, []> {
  return tensor<E, []>(left[0] / right[0])
}

fn add<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return arithmetic_runtime<E, S, S, S, len<S>, len<S>, len<S>, 0>(left, right)
}

fn add<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  return arithmetic_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 0>(left, right)
}

fn add<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>, activation: str
) -> tensor<E, S> {
  return activate(add(left, right), activation)
}

fn add<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>, activation: str
) -> tensor<E, Y> {
  let out: tensor<E, Y> = add(left, right)
  return activate(out, activation)
}

fn sub<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return arithmetic_runtime<E, S, S, S, len<S>, len<S>, len<S>, 1>(left, right)
}

fn sub<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  return arithmetic_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 1>(left, right)
}

fn sub<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>, activation: str
) -> tensor<E, S> {
  return activate(sub(left, right), activation)
}

fn sub<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>, activation: str
) -> tensor<E, Y> {
  let out: tensor<E, Y> = sub(left, right)
  return activate(out, activation)
}

fn mul<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return arithmetic_runtime<E, S, S, S, len<S>, len<S>, len<S>, 2>(left, right)
}

fn mul<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  return arithmetic_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 2>(left, right)
}

fn mul<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>, activation: str
) -> tensor<E, S> {
  return activate(mul(left, right), activation)
}

fn mul<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>, activation: str
) -> tensor<E, Y> {
  let out: tensor<E, Y> = mul(left, right)
  return activate(out, activation)
}

fn div<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return arithmetic_runtime<E, S, S, S, len<S>, len<S>, len<S>, 3>(left, right)
}

fn div<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  return arithmetic_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 3>(left, right)
}

local fn unordered<E: Ty>(value: E) -> bool { return false }
local fn unordered(value: f32) -> bool { return value != value }
local fn unordered(value: f64) -> bool { return value != value }

fn maximum<E: Ty>(left: E, right: E) -> E {
  var out = right
  if unordered(left) || (!unordered(right) && left > right) { out = left }
  return out
}

fn maximum<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return extrema_runtime<E, S, S, S, len<S>, 0>(left, right)
}

fn maximum<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  return extrema_runtime<E, L, R, Y, len<Y>, 0>(left, right)
}

fn minimum<E: Ty>(left: E, right: E) -> E {
  var out = right
  if unordered(left) || (!unordered(right) && left < right) { out = left }
  return out
}

fn minimum<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  return extrema_runtime<E, S, S, S, len<S>, 1>(left, right)
}

fn minimum<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  return extrema_runtime<E, L, R, Y, len<Y>, 1>(left, right)
}

local fn extrema_runtime<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>, D: int, Mode: int
>(a: tensor<E, L>, b: tensor<E, R>) -> tensor<E, Y> {
  let shape, left_strides, right_strides, count =
    tensor.broadcast_layout<E, E, L, R, len<L>, len<R>, D>(a, b)
  var out: tensor<E, Y> = tensor.make(E(0), shape)
  for linear in index(0)..count {
    var remaining = linear
    var left = index(0)
    var right = index(0)
    [stage: "shape"]
    for reverse in 0..D {
      let axis = D - reverse - 1
      let coordinate = remaining % shape[axis]
      remaining /= shape[axis]
      left += coordinate * left_strides[axis]
      right += coordinate * right_strides[axis]
    }
    var value = maximum(a[left], b[right])
    if Mode == 1 { value = minimum(a[left], b[right]) }
    out[linear] = value
  }
  return tensor.view<E, index, Y, Y, D>(out, shape)
}

fn pow<E: Ty, S: list<int>>(
  left: tensor<E, S>, right: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = pow(left[i], right[i])
  }
  return out
}

fn pow<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  left: tensor<E, L>, right: tensor<E, R>
) -> tensor<E, Y> {
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  return pow(a, b)
}

fn sqrt<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = sqrt(x[i])
  }
  return out
}

fn reduce_l2<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  let reduced: tensor<E, Y> = tensor.sum(x * x, axes)
  return sqrt(reduced)
}

fn cos<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = cos(x[i])
  }
  return out
}

fn sin<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = sin(x[i])
  }
  return out
}

fn where<
  E: Ty,
  C: list<int>,
  L: list<int>,
  R: list<int>,
  Y: list<int>
>(
  condition: tensor<bool, C>,
  left: tensor<E, L>,
  right: tensor<E, R>
) -> tensor<E, Y> {
  let selected: tensor<bool, Y> = tensor.broadcast(condition)
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  var out = tensor<E, Y>(E(0))
  for i in 0..tensor.numel<Y>() {
    if selected[i] {
      out[i] = a[i]
    } else {
      out[i] = b[i]
    }
  }
  return out
}

fn neg<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = -x[i]
  }
  return out
}

