fn exp<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = exp(x[i])
  }
  return out
}

fn sigmoid<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = E(1) / (E(1) + exp(E(0) - x[i]))
  }
  return out
}

fn ceil<E: Ty, S: list<int>>(
