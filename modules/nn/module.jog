  return out
}

fn sin<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = sin(x[i])
  }
  return out
}

fn where<
  E: Ty,
  C: list<int>,
  L: list<int>,
  R: list<int>,
  Y: list<int>
>(
  condition: tensor<bool, C>,
  left: tensor<E, L>,
  right: tensor<E, R>
) -> tensor<E, Y> {
  let selected: tensor<bool, Y> = tensor.broadcast(condition)
  let a: tensor<E, Y> = tensor.broadcast(left)
  let b: tensor<E, Y> = tensor.broadcast(right)
  var out = tensor<E, Y>(E(0))
  for i in 0..tensor.numel<Y>() {
    if selected[i] {
      out[i] = a[i]
    } else {
      out[i] = b[i]
    }
  }
  return out
}

fn abs<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = abs(x[i])
  }
  return out
}

fn floor<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = floor(x[i])
  }
  return out
}

