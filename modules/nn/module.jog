fn recip<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = E(1) / x[i]
  }
  return out
}

fn tanh<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    out[i] = tanh(x[i])
