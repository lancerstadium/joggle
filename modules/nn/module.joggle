joggle 1;

module nn@2.0.0 {
  import arith@2.0.0;
  import tensor@2.0.0;

  interface activation: fn;
  interface normalization: fn;
  interface pooling: fn;

  fn conv_extent(
    input: int,
    kernel: int,
    stride: int,
    dilation: int,
    pad_before: int,
    pad_after: int
  ) -> int {
    return (input + pad_before + pad_after - dilation * (kernel - 1) - 1) / stride + 1;
  }
  fn relu<E: prelude.numeric, S: list<int>>(
    input: tensor.ranked<E, S>
  ) -> tensor.ranked<E, S> : arith.elementwise, activation;
  fn add<E: prelude.numeric, S: list<int>>(
    lhs: tensor.ranked<E, S>,
    rhs: tensor.ranked<E, S>
  ) -> tensor.ranked<E, S> as + : arith.elementwise;
  fn conv2d_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    O: int,
    KH: int,
    KW: int,
    SH: int,
    SW: int,
    DH: int,
    DW: int,
    PT: int,
    PL: int,
    PB: int,
    PR: int
  >(
    input: tensor.ranked<E, [N, C, H, W]>,
    weight: tensor.ranked<E, [O, C, KH, KW]>,
    stride_h: SH = 1,
    stride_w: SW = 1,
    dilation_h: DH = 1,
    dilation_w: DW = 1,
    pad_top: PT = 0,
    pad_left: PL = 0,
    pad_bottom: PB = 0,
    pad_right: PR = 0
  ) ->
    tensor.ranked<
      E,
      [N, O, @conv_extent(H, KH, SH, DH, PT, PB), @conv_extent(W, KW, SW, DW, PL, PR)]
    >;
  fn conv2d_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    O: int,
    KH: int,
    KW: int,
    SH: int,
    SW: int,
    DH: int,
    DW: int,
    PT: int,
    PL: int,
    PB: int,
    PR: int
  >(
    input: tensor.ranked<E, [N, C, H, W]>,
    weight: tensor.ranked<E, [O, C, KH, KW]>,
    bias: tensor.ranked<E, [O]>,
    stride_h: SH = 1,
    stride_w: SW = 1,
    dilation_h: DH = 1,
    dilation_w: DW = 1,
    pad_top: PT = 0,
    pad_left: PL = 0,
    pad_bottom: PB = 0,
    pad_right: PR = 0
  ) ->
    tensor.ranked<
      E,
      [N, O, @conv_extent(H, KH, SH, DH, PT, PB), @conv_extent(W, KW, SW, DW, PL, PR)]
    >;
  fn batch_norm_nchw<E: prelude.floating_point, N: int, C: int, H: int, W: int>(
    input: tensor.ranked<E, [N, C, H, W]>,
    scale: tensor.ranked<E, [C]>,
    bias: tensor.ranked<E, [C]>,
    mean: tensor.ranked<E, [C]>,
    variance: tensor.ranked<E, [C]>,
    epsilon: real = 1e-05
  ) -> tensor.ranked<E, [N, C, H, W]> : normalization;
  fn max_pool2d_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    KH: int,
    KW: int,
    SH: int,
    SW: int,
    DH: int,
    DW: int,
    PT: int,
    PL: int,
    PB: int,
    PR: int
  >(
    input: tensor.ranked<E, [N, C, H, W]>,
    kernel_h: KH,
    kernel_w: KW,
    stride_h: SH = 1,
    stride_w: SW = 1,
    dilation_h: DH = 1,
    dilation_w: DW = 1,
    pad_top: PT = 0,
    pad_left: PL = 0,
    pad_bottom: PB = 0,
    pad_right: PR = 0
  ) ->
    tensor.ranked<
      E,
      [N, C, @conv_extent(H, KH, SH, DH, PT, PB), @conv_extent(W, KW, SW, DW, PL, PR)]
    > : pooling;
  fn global_average_pool_nchw<E: prelude.numeric, N: int, C: int, H: int, W: int>(
    input: tensor.ranked<E, [N, C, H, W]>
  ) -> tensor.ranked<E, [N, C, 1, 1]> : pooling;
  fn flatten_nchw<E: prelude.numeric, N: int, C: int, H: int, W: int>(
    input: tensor.ranked<E, [N, C, H, W]>
  ) -> tensor.ranked<E, [N, C * H * W]>;
  fn linear<E: prelude.numeric, N: int, K: int, M: int>(
    input: tensor.ranked<E, [N, K]>,
    weight: tensor.ranked<E, [M, K]>,
    bias: tensor.ranked<E, [M]>
  ) -> tensor.ranked<E, [N, M]>;
  fn softmax<E: prelude.numeric, S: list<int>>(
    input: tensor.ranked<E, S>,
    axis: int
  ) -> tensor.ranked<E, S> : activation;
}
