joggle 1;

module qdq@1.0.0 {
  import quant@1 as q;
  import tensor@1 as t;

  fn nchw_conv<
    X: list<int>, XQ: list<int>,
    W: list<int>, WQ: list<int>,
    B: list<int>, BQ: list<int>,
    OQ: list<int>, Y: list<int>
  >(
    input: t.tensor<u8, X>,
    input_scale: t.tensor<f32, XQ>,
    input_zero: t.tensor<u8, XQ>,
    weight: t.tensor<i8, W>,
    weight_scale: t.tensor<f32, WQ>,
    weight_zero: t.tensor<i8, WQ>,
    bias: t.tensor<i32, B>,
    bias_scale: t.tensor<f32, BQ>,
    bias_zero: t.tensor<i32, BQ>,
    output_scale: t.tensor<f32, OQ>,
    output_zero: t.tensor<u8, OQ>,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> t.tensor<u8, Y> {
    expressed_input: t.tensor<f32, X> = q.dequantize(
      input, input_scale, input_zero, axis: 1
    );
    expressed_weight: t.tensor<f32, W> = q.dequantize(
      weight, weight_scale, weight_zero, axis: 0
    );
    expressed_bias: t.tensor<f32, B> = q.dequantize(
      bias, bias_scale, bias_zero, axis: 0
    );
    convolved: t.tensor<f32, Y> = t.conv(
      expressed_input,
      expressed_weight,
      expressed_bias,
      strides,
      pads,
      dilations,
      group
    );
    return q.quantize(
      convolved, output_scale, output_zero, axis: 1
    );
  }

  fn run(input: function) -> function;
  fn run(input: module) -> module;
}
