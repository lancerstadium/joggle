joggle 1;

module prelude@1.0.0 {
  type type();
  type int();
  type real();
  type bool();
  type string();
  type attr();
  type bytes();
  type function();
  type list(element: type);

  interface scalar: type {
    storage_bits: int;
  }
  interface integer: type;
  interface signed_integer: type;
  interface unsigned_integer: type;
  interface floating_point: type;
  interface logical: type;
  interface index_type: type;

  type i1() : scalar, logical {
    storage_bits = 1;
  }
  type i8() : scalar, integer, signed_integer {
    storage_bits = 8;
  }
  type i16() : scalar, integer, signed_integer {
    storage_bits = 16;
  }
  type i32() : scalar, integer, signed_integer {
    storage_bits = 32;
  }
  type i64() : scalar, integer, signed_integer {
    storage_bits = 64;
  }
  type u8() : scalar, integer, unsigned_integer {
    storage_bits = 8;
  }
  type u16() : scalar, integer, unsigned_integer {
    storage_bits = 16;
  }
  type u32() : scalar, integer, unsigned_integer {
    storage_bits = 32;
  }
  type u64() : scalar, integer, unsigned_integer {
    storage_bits = 64;
  }
  type f16() : scalar, floating_point {
    storage_bits = 16;
  }
  type bf16() : scalar, floating_point {
    storage_bits = 16;
  }
  type f32() : scalar, floating_point {
    storage_bits = 32;
  }
  type f64() : scalar, floating_point {
    storage_bits = 64;
  }
  type index() : integer, unsigned_integer, index_type;
}
