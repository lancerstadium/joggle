local fn same_order(left: list<int>, right: list<int>) -> bool {
  if len(left) != len(right) {
    return false
  }
  for i in 0..len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}

local fn permutation_issue(order: list<int>, axes: int) -> str {
  if len(order) != axes {
    return "requires one position for every loop axis"
  }
  var seen: list<bool> = []
  for i in 0..axes {
    seen += [false]
  }
  for axis in order {
    if axis < 0 || axis >= axes {
      return "contains an out-of-range axis"
    }
    if seen[axis] {
      return "contains a duplicate axis"
    }
    seen[axis] = true
  }
  return ""
}

local fn trip(m: Mod, range: Val) -> int {
  let op = ir.def(range)
  if !ir.live(op) || ir.kind(op) != "call" ||
     (ir.target(m, op) != "base.operator .." &&
      ir.target(m, op) != "operator ..") {
    return -1
  }
  let bounds = ir.args(op)
  if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
     !ir.is_const(bounds[1]) ||
     base.kind(ir.constant(bounds[0])) != "int" ||
     base.kind(ir.constant(bounds[1])) != "int" {
    return -1
  }
  let lower = base.int(ir.constant(bounds[0]))
  let upper = base.int(ir.constant(bounds[1]))
  if lower < 0 || upper < 0 {
    return -1
  }
  if upper <= lower {
    return 0
  }
  return upper - lower
}

local fn subsequence(order: list<int>, selected: list<bool>) -> list<int> {
  var out: list<int> = []
  for axis in order {
    if selected[axis] {
      out += [axis]
    }
  }
  return out
}

local fn axis_sequence(selected: list<bool>, value: bool) -> list<int> {
  var out: list<int> = []
  for axis in 0..len(selected) {
    if selected[axis] == value {
      out += [axis]
    }
  }
  return out
}

local fn magnitude(value: int) -> list<int> {
  let low = -9223372036854775807 - 1
  if value == low {
    return []
  }
  if value < 0 {
    return [-value]
  }
  return [value]
}

// Prove that the affine address distinguishes every non-singleton state
// coordinate. This accepts dense and padded strided layouts without assuming
// a particular tensor axis order.
local fn injective(
  m: Mod, sources: list<Val>, axes: int,
  form: list<int>, state: list<bool>
) -> bool {
  if len(form) != axes + 1 {
    return false
  }
  var remaining = 0
  for axis in 0..axes {
    if state[axis] && trip(m, sources[axis]) > 1 {
      remaining += 1
    }
  }
  var reach = 0
  var previous = 0
  for step in 0..remaining {
    var found = false
    var chosen = -1
    var coefficient = 0
    for axis in 0..axes {
      let extent = trip(m, sources[axis])
      let absolute = magnitude(form[axis + 1])
      if len(absolute) == 0 {
        return false
      }
      let stride = absolute[0]
      if state[axis] && extent > 1 && stride > previous &&
         (!found || stride < coefficient) {
        found = true
        chosen = axis
        coefficient = stride
      }
    }
    if !found || coefficient <= reach {
      return false
    }
    let width = trip(m, sources[chosen]) - 1
    let product = affine_mul_int(coefficient, width)
    if len(product) == 0 {
      return false
    }
    let extended = affine_add_int(reach, product[0])
    if len(extended) == 0 {
      return false
    }
    reach = extended[0]
    previous = coefficient
  }
  return true
}

local fn reorder_access_issue(
  m: Mod, source: Op, order: list<int>
) -> str {
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let axes = len(inputs) - len(outputs)
  let body_args = ir.args(ir.blks(source)[0])
  if len(outputs) != 1 {
    return "currently requires one carried value"
  }
  let state_value = body_args[axes]
  let read_accesses = reads(source, state_value)
  let write_accesses = writes(source, state_value)
  if len(read_accesses) != 1 || len(write_accesses) != 1 ||
     len(read_accesses[0]) != 1 || len(write_accesses[0]) != 1 {
    return "requires one indexed read and write of the carried value"
  }
  let read_form = affine(m, source, read_accesses[0][0])
  let write_form = affine(m, source, write_accesses[0][0])
  if len(read_form) != axes + 1 || read_form != write_form {
    return "requires equal affine read and write addresses"
  }

  var state: list<bool> = []
  for axis in 0..axes {
    state += [write_form[axis + 1] != 0]
  }
  if !injective(m, inputs, axes, write_form, state) {
    return "cannot prove that state coordinates have distinct addresses"
  }

  if subsequence(order, state) != axis_sequence(state, true) {
    return "must preserve the relative order of state axes"
  }
  var reduction: list<bool> = []
  for item in state {
    reduction += [!item]
  }
  if subsequence(order, reduction) != axis_sequence(state, false) {
    return "must preserve the relative order of reduction axes"
  }
  return ""
}

fn reorder_issue(m: Mod, source: Op, order: list<int>) -> str {
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(inputs) <= len(outputs) {
    return "requires a structured range loop"
  }
  let axes = len(inputs) - len(outputs)
  let issue = permutation_issue(order, axes)
  if issue != "" {
    return issue
  }
  let body_args = ir.args(bodies[0])
  if len(body_args) != len(inputs) {
    return "found an invalid loop signature"
  }
  let ops = ir.ops(bodies[0])
  if len(ops) == 0 || ir.kind(ops[len(ops) - 1]) != "yield" {
    return "requires a terminated loop body"
  }
  for axis in 0..axes {
    if trip(m, inputs[axis]) < 0 {
      return "requires static integer ranges"
    }
  }
  return reorder_access_issue(m, source, order)
}

fn can_reorder(m: Mod, source: Op, order: list<int>) -> bool {
  let before = ir.revision(m)
  let legal = reorder_issue(m, source, order) == ""
  assert(ir.revision(m) == before,
         "tile.can_reorder changed the module")
  return legal
}

local fn role_axes(m: Mod, source: Op, state: bool) -> list<int> {
  if !ir.live(source) || ir.kind(source) != "loop" {
    return []
  }
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let axes = len(inputs) - len(outputs)
  if axes <= 0 {
    return []
  }
  var identity: list<int> = []
  for axis in 0..axes {
    identity += [axis]
  }
  if reorder_issue(m, source, identity) != "" {
    return []
  }
  let body_args = ir.args(ir.blks(source)[0])
  let accesses = writes(source, body_args[axes])
  let form = affine(m, source, accesses[0][0])
  var out: list<int> = []
  for axis in 0..axes {
    if (form[axis + 1] != 0) == state {
      out += [axis]
    }
  }
  return out
}

// Classify a reorderable loop by the affine address of its carried state.
// State axes select distinct carried elements; reduction axes update an
// already-selected element. Unsupported loops return no roles.
fn state_axes(m: Mod, source: Op) -> list<int> {
  return role_axes(m, source, true)
}

fn reduction_axes(m: Mod, source: Op) -> list<int> {
  return role_axes(m, source, false)
}

fn reorderable(m: Mod, order: list<int>) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_reorder(m, op, order) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.reorderable changed the module")
  return out
}

fn reorder(m: Mod, source: Op, order: list<int>) -> bool {
  let issue = reorder_issue(m, source, order)
  assert(issue == "", "tile.reorder " + issue)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let axes = len(inputs) - len(outputs)
  let body = ir.blks(source)[0]
  let body_args = ir.args(body)

  var identity: list<int> = []
  for axis in 0..axes {
    identity += [axis]
  }
  if same_order(order, identity) {
    return false
  }

  var names: list<str> = []
  var sources: list<Val> = []
  for axis in order {
    names += [ir.name(body_args[axis])]
    sources += [inputs[axis]]
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }

  let next_loop = ir.loop(m, source, names, sources, carried)
  assert(ir.live(next_loop), "tile.reorder could not build the loop")
  let next_body = ir.blks(next_loop)[0]
  let next_args = ir.args(next_body)
  let next_ops = ir.ops(next_body)
  let next_yield = next_ops[len(next_ops) - 1]

  var old: list<Val> = []
  var next: list<Val> = []
  for axis in 0..axes {
    old += [body_args[axis]]
    var position = -1
    for i in 0..axes {
      if order[i] == axis {
        position = i
      }
    }
    assert(position >= 0, "tile.reorder lost an axis")
    next += [next_args[position]]
  }
  for i in 0..len(outputs) {
    old += [body_args[axes + i]]
    next += [next_args[axes + i]]
  }

  let original = ir.ops(body)
  for i in 0..len(original) - 1 {
    let copy = ir.clone(m, original[i], next_yield, old, next)
    assert(ir.live(copy), "tile.reorder could not clone the loop body")
    old += ir.outs(original[i])
    next += ir.outs(copy)
  }
  let original_yield = original[len(original) - 1]
  assert(ir.args(m, next_yield, mapped(ir.args(original_yield), old, next)),
         "tile.reorder could not connect the loop")
  assert(ir.replace(m, outputs, ir.outs(next_loop)),
         "tile.reorder could not replace the loop results")
  assert(ir.erase(m, source),
         "tile.reorder could not erase the original loop")
  return true
}

local fn reorder_all(
  m: Mod, policy: Fn, arg: Attr, configured: bool
) -> bool {
  assert(ir.live(policy), "tile.reorder requires a valid policy")
  let candidates = ir.ops(m)
  var changed = false
  for op in candidates {
    if ir.live(op) && ir.kind(op) == "loop" {
      let before = ir.revision(m)
      var order: list<int> = []
      if configured {
        order = ir.invoke<list<int>>(m, op, policy, arg)
      } else {
        order = ir.invoke<list<int>>(m, op, policy)
      }
      assert(ir.revision(m) == before,
             "tile.reorder policy changed the module")
      if len(order) != 0 {
        let issue = reorder_issue(m, op, order)
        assert(issue == "",
               "tile.reorder policy selected an illegal order: " + issue)
        changed = reorder(m, op, order) || changed
      }
    }
  }
  return changed
}

fn reorder(m: Mod, policy: Fn) -> bool {
  return reorder_all(m, policy, nil, false)
}

fn reorder(m: Mod, policy: Fn, arg: Attr) -> bool {
  return reorder_all(m, policy, arg, true)
}
