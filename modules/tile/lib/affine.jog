[memo]
local fn affine_integer(type: Ty) -> bool {
  let name = base.name(type)
  return name == "int" || name == "index" ||
         name == "i8" || name == "i16" || name == "i32" ||
         name == "i64" || name == "u8" || name == "u16" ||
         name == "u32" || name == "u64"
}

// `int` and `index` are the core's two unbounded coordinate spellings. Their
// conversion cannot discard coordinate information. Fixed-width and custom
// integer conversions remain unsupported because proving them lossless needs
// an explicit representation or range contract.
[memo]
local fn affine_coordinate_cast(source: Ty, result: Ty) -> bool {
  let left = base.name(source)
  let right = base.name(result)
  return (left == "int" || left == "index") &&
         (right == "int" || right == "index")
}

[memo]
local fn affine_zero(axes: int) -> list<int> {
  var out: list<int> = [0]
  for axis in 0..axes {
    out += [0]
  }
  return out
}

[memo]
local fn affine_add_int(left: int, right: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if (right > 0 && left > high - right) ||
     (right < 0 && left < low - right) {
    return []
  }
  return [left + right]
}

[memo]
local fn affine_sub_int(left: int, right: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if (right < 0 && left > high + right) ||
     (right > 0 && left < low + right) {
    return []
  }
  return [left - right]
}

[memo]
local fn affine_mul_int(left: int, right: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if left > 0 {
    if (right > 0 && left > high / right) ||
       (right < 0 && right < low / left) {
      return []
    }
  } else {
    if left < 0 {
      if (right > 0 && left < low / right) ||
         (right < 0 && right < high / left) {
        return []
      }
    }
  }
  return [left * right]
}

[memo]
local fn affine_add(
  left: list<int>, right: list<int>, subtract: bool
) -> list<int> {
  if len(left) == 0 || len(left) != len(right) {
    return []
  }
  var out: list<int> = []
  for i in 0..len(left) {
    var item = affine_add_int(left[i], right[i])
    if subtract {
      item = affine_sub_int(left[i], right[i])
    }
    if len(item) == 0 {
      return []
    }
    out += item
  }
  return out
}

[memo]
local fn affine_scale(value: list<int>, factor: int) -> list<int> {
  if len(value) == 0 {
    return []
  }
  var out: list<int> = []
  for item in value {
    let product = affine_mul_int(item, factor)
    if len(product) == 0 {
      return []
    }
    out += product
  }
  return out
}

[memo]
local fn affine_exact(value: list<int>) -> list<int> {
  if len(value) == 0 {
    return []
  }
  for i in 1..len(value) {
    if value[i] != 0 {
      return []
    }
  }
  return [value[0]]
}

[memo]
local fn affine_divide(value: list<int>, divisor: int) -> list<int> {
  if len(value) == 0 || divisor == 0 {
    return []
  }
  let low = -9223372036854775807 - 1
  var out: list<int> = []
  for item in value {
    if (item == low && divisor == -1) || item % divisor != 0 {
      return []
    }
    out += [item / divisor]
  }
  return out
}

// Bound an affine form over the half-open ranges of a structured loop. The
// empty result means that a range is dynamic, empty, or would overflow.
[memo]
local fn affine_bounds(
  m: Mod, loop: Op, value: list<int>
) -> list<int> {
  let inputs = ir.args(loop)
  let axes = len(inputs) - len(ir.outs(loop))
  if len(value) != axes + 1 {
    return []
  }
  var minimum = value[0]
  var maximum = value[0]
  for axis in 0..axes {
    let range = ir.def(inputs[axis])
    let bounds = ir.args(range)
    if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
       !ir.is_const(bounds[1]) ||
       base.kind(ir.constant(bounds[0])) != "int" ||
       base.kind(ir.constant(bounds[1])) != "int" {
      return []
    }
    let lower = base.int(ir.constant(bounds[0]))
    let upper = base.int(ir.constant(bounds[1]))
    if upper <= lower {
      return []
    }
    var first = lower
    var final = upper - 1
    if value[axis + 1] < 0 {
      first = upper - 1
      final = lower
    }
    let low = affine_mul_int(value[axis + 1], first)
    let high = affine_mul_int(value[axis + 1], final)
    if len(low) == 0 || len(high) == 0 {
      return []
    }
    let next_minimum = affine_add_int(minimum, low[0])
    let next_maximum = affine_add_int(maximum, high[0])
    if len(next_minimum) == 0 || len(next_maximum) == 0 {
      return []
    }
    minimum = next_minimum[0]
    maximum = next_maximum[0]
  }
  return [minimum, maximum]
}

// Integer division is not generally affine. It is affine when every
// coefficient divides exactly, or constant when the loop ranges prove that
// the quotient cannot change. The latter recognizes grouped/layout indices
// such as m / 160 for m in 0..160 without naming an operator or a layout.
[memo]
local fn affine_quotient(
  m: Mod, loop: Op, value: list<int>, divisor: int
) -> list<int> {
  let exact = affine_divide(value, divisor)
  if len(exact) != 0 {
    return exact
  }
  if divisor <= 0 {
    return []
  }
  let bounds = affine_bounds(m, loop, value)
  if len(bounds) != 2 || bounds[0] < 0 ||
     bounds[0] / divisor != bounds[1] / divisor {
    return []
  }
  var out = affine_zero(len(value) - 1)
  out[0] = bounds[0] / divisor
  return out
}

// Verified SSA definitions are acyclic, so the value is a complete recursion
// key and shared address expressions can reuse one analysis result.
[memo]
local fn affine_in(
  m: Mod, loop: Op, value: Val
) -> list<int> {
  if !affine_integer(ir.type(value)) {
    return []
  }
  let inputs = ir.args(loop)
  let outputs = ir.outs(loop)
  let axes = len(inputs) - len(outputs)
  let body_args = ir.args(ir.blks(loop)[0])

  for axis in 0..axes {
    if value == body_args[axis] {
      var out = affine_zero(axes)
      out[axis + 1] = 1
      return out
    }
  }
  if ir.is_const(value) && base.kind(ir.constant(value)) == "int" {
    var out = affine_zero(axes)
    out[0] = base.int(ir.constant(value))
    return out
  }
  let op = ir.def(value)
  if !ir.live(op) || ir.kind(op) != "call" {
    return []
  }
  let args = ir.args(op)
  let name = ir.target(m, op)
  if len(args) == 1 {
    let input = affine_in(m, loop, args[0])
    if base_op(m, op, "copy") ||
       base_op(m, op, "operator +") ||
       affine_coordinate_cast(ir.type(args[0]), ir.type(value)) ||
       ((name == "base." + text(ir.type(value)) ||
         name == text(ir.type(value))) &&
        ir.type(args[0]) == ir.type(value)) {
      return input
    }
    if base_op(m, op, "operator -") {
      return affine_scale(input, -1)
    }
    return []
  }
  if len(args) != 2 {
    return []
  }
  let left = affine_in(m, loop, args[0])
  let right = affine_in(m, loop, args[1])
  if base_op(m, op, "operator +") {
    return affine_add(left, right, false)
  }
  if base_op(m, op, "operator -") {
    return affine_add(left, right, true)
  }
  if base_op(m, op, "operator *") {
    let left_value = affine_exact(left)
    if len(left_value) == 1 {
      if left_value[0] == 0 {
        return affine_zero(axes)
      }
      return affine_scale(right, left_value[0])
    }
    let right_value = affine_exact(right)
    if len(right_value) == 1 {
      if right_value[0] == 0 {
        return affine_zero(axes)
      }
      return affine_scale(left, right_value[0])
    }
    return []
  }
  if base_op(m, op, "operator /") {
    let divisor = affine_exact(right)
    if len(divisor) == 1 {
      return affine_quotient(m, loop, left, divisor[0])
    }
  }
  return []
}

[memo]
fn affine(m: Mod, loop: Op, value: Val) -> list<int> {
  assert(ir.live(loop) && ir.kind(loop) == "loop" && ir.live(value),
         "tile.affine requires a live loop and value")
  let bodies = ir.blks(loop)
  let inputs = ir.args(loop)
  let outputs = ir.outs(loop)
  assert(len(bodies) == 1 && len(inputs) > len(outputs) &&
         len(ir.args(bodies[0])) == len(inputs),
         "tile.affine requires a structured loop")
  return affine_in(m, loop, value)
}

// Rebuild a proved affine form from loop coordinates. Keeping construction
// next to the analysis gives every transform one normal form.
local fn affine_value(
  m: Mod,
  before: Op,
  type: Ty,
  form: list<int>,
  axes: list<Val>
) -> Val {
  var out = axes[0]
  var started = false
  if form[0] != 0 {
    out = ir.constant(m, before, form[0], type)
    assert(ir.live(out), "tile could not build an affine offset")
    started = true
  }
  for axis in 0..len(axes) {
    let coefficient = form[axis + 1]
    if coefficient != 0 {
      var coordinate = axes[axis]
      if ir.type(coordinate) != type {
        coordinate = ir.call(m, before, text(type), [coordinate], type)
        assert(ir.live(coordinate),
               "tile could not cast an affine coordinate")
      }
      var term = coordinate
      if coefficient != 1 {
        let scale = ir.constant(m, before, coefficient, type)
        assert(ir.live(scale), "tile could not build an affine scale")
        term = ir.call(
          m, before, base_fn("operator *", 2), [coordinate, scale], type
        )
        assert(ir.live(term), "tile could not scale an affine coordinate")
      }
      if !started {
        out = term
        started = true
      } else {
        out = ir.call(
          m, before, base_fn("operator +", 2), [out, term], type
        )
        assert(ir.live(out), "tile could not extend an affine value")
      }
    }
  }
  if !started {
    out = ir.constant(m, before, 0, type)
    assert(ir.live(out), "tile could not build a zero affine value")
  }
  return out
}
