fn fuse_issue(m: Mod, producer: Op, consumer: Op) -> str {
  if !ir.live(producer) || !ir.live(consumer) ||
     ir.kind(producer) != "loop" || ir.kind(consumer) != "loop" ||
     producer == consumer || ir.blk(producer) != ir.blk(consumer) {
    return "requires two distinct loops in one block"
  }
  var ordered = false
  var found = false
  for op in ir.ops(ir.blk(producer)) {
    if op == producer {
      ordered = true
    }
    if op == consumer {
      found = true
      if !ordered {
        return "requires producer before consumer"
      }
    }
  }
  if !found {
    return "requires producer before consumer"
  }

  let producer_inputs = ir.args(producer)
  let consumer_inputs = ir.args(consumer)
  let producer_outputs = ir.outs(producer)
  let consumer_outputs = ir.outs(consumer)
  let producer_bodies = ir.blks(producer)
  let consumer_bodies = ir.blks(consumer)
  if len(producer_outputs) != 1 || len(consumer_outputs) != 1 ||
     len(producer_bodies) != 1 || len(consumer_bodies) != 1 {
    return "currently requires one carried tensor per loop"
  }
  let producer_axes = len(producer_inputs) - len(producer_outputs)
  let consumer_axes = len(consumer_inputs) - len(consumer_outputs)
  if producer_axes <= 0 || consumer_axes <= 0 {
    return "requires nonempty iteration spaces"
  }
  if ir.type(producer_outputs[0]) !=
       ir.type(producer_inputs[producer_axes]) ||
     ir.type(consumer_outputs[0]) !=
       ir.type(consumer_inputs[consumer_axes]) ||
     producer_outputs[0] == consumer_inputs[consumer_axes] {
    return "requires distinct, type-stable carried tensors"
  }

  let producer_body = producer_bodies[0]
  let consumer_body = consumer_bodies[0]
  let producer_args = ir.args(producer_body)
  let consumer_args = ir.args(consumer_body)
  if len(producer_args) != producer_axes + 1 ||
     len(consumer_args) != consumer_axes + 1 {
    return "found incompatible loop bodies"
  }
  if producer_axes == consumer_axes {
    for axis in 0..producer_axes {
      if ir.type(producer_args[axis]) != ir.type(consumer_args[axis]) {
        return "found incompatible loop bodies"
      }
    }
  }

  var stores: list<Op> = []
  for op in ir.ops(producer_body) {
    let inputs = ir.args(op)
    if syntax_op(m, op, "operator []=") && len(inputs) >= 3 &&
       inputs[0] == producer_args[producer_axes] {
      stores += [op]
    }
  }
  if len(stores) != 1 {
    return "requires one pointwise producer store"
  }
  if !same_iteration(
       m, producer, producer_args[producer_axes],
       subscripts(stores[0], true), consumer
     ) {
    return "requires equal or densely flattened iteration spaces"
  }
  let producer_ops = ir.ops(producer_body)
  let consumer_ops = ir.ops(consumer_body)
  if len(producer_ops) < 2 || len(consumer_ops) < 1 ||
     producer_ops[len(producer_ops) - 2] != stores[0] {
    return "requires a final producer store"
  }
  let producer_yield = producer_ops[len(producer_ops) - 1]
  let consumer_yield = consumer_ops[len(consumer_ops) - 1]
  if ir.kind(producer_yield) != "yield" ||
     ir.kind(consumer_yield) != "yield" ||
     ir.args(producer_yield) != ir.outs(stores[0]) {
    return "requires the producer store to reach its yield"
  }
  if !captured(consumer, producer_outputs[0]) ||
     !pointwise_at(
       m, consumer, consumer, producer_outputs[0], producer,
       producer_args[producer_axes], subscripts(stores[0], true)
     ) {
    return "requires pointwise consumer reads"
  }

  for user in ir.users(producer_outputs[0]) {
    if contains(consumer, user) {
      if ir.blk(user) != consumer_body ||
         !load_at(
           m, consumer, user, producer_outputs[0], producer,
           producer_args[producer_axes], subscripts(stores[0], true)
         ) {
        return "requires direct pointwise consumer reads"
      }
    }
  }
  let consumer_init = ir.def(consumer_inputs[consumer_axes])
  var consumer_ranges: list<Op> = []
  for axis in 0..consumer_axes {
    consumer_ranges += [ir.def(consumer_inputs[axis])]
  }
  var between = false
  for op in ir.ops(ir.blk(producer)) {
    if op == producer {
      between = true
    } else {
      if op == consumer {
        between = false
      } else {
        if between {
          var range = false
          for candidate in consumer_ranges {
            if op == candidate {
              range = true
            }
          }
          if !range && ir.kind(op) != "constant" && !constructor(op) &&
             !base_op(m, op, "list") && op != consumer_init {
              return "cannot cross non-setup operation: " + ir.kind(op) +
                     " " + ir.callee(op)
          }
        }
      }
    }
  }
  return ""
}

fn can_fuse(m: Mod, producer: Op, consumer: Op) -> bool {
  let before = ir.revision(m)
  let legal = fuse_issue(m, producer, consumer) == ""
  assert(ir.revision(m) == before,
         "tile.can_fuse changed the module")
  return legal
}

fn fusible(m: Mod) -> list<list<Op>> {
  let before = ir.revision(m)
  let ops = ir.ops(m)
  var out: list<list<Op>> = []
  for i in 0..len(ops) {
    if ir.live(ops[i]) && ir.kind(ops[i]) == "loop" {
      var next_loop = false
      for j in i + 1..len(ops) {
        if !next_loop && ir.live(ops[j]) &&
           ir.kind(ops[j]) == "loop" &&
           ir.blk(ops[i]) == ir.blk(ops[j]) {
          next_loop = true
          if can_fuse(m, ops[i], ops[j]) {
            out += [[ops[i], ops[j]]]
          }
        }
      }
    }
  }
  assert(ir.revision(m) == before,
         "tile.fusible changed the module")
  return out
}

fn fuse(m: Mod, producer: Op, consumer: Op) -> Op {
  let issue = fuse_issue(m, producer, consumer)
  assert(issue == "", "tile.fuse " + issue)

  let producer_inputs = ir.args(producer)
  let consumer_inputs = ir.args(consumer)
  let producer_outputs = ir.outs(producer)
  let consumer_outputs = ir.outs(consumer)
  let producer_body = ir.blks(producer)[0]
  let consumer_body = ir.blks(consumer)[0]
  let producer_args = ir.args(producer_body)
  let consumer_args = ir.args(consumer_body)
  let producer_axes = len(producer_inputs) - len(producer_outputs)
  let consumer_axes = len(consumer_inputs) - len(consumer_outputs)
  let producer_ops = ir.ops(producer_body)
  let consumer_ops = ir.ops(consumer_body)
  let consumer_yield = consumer_ops[len(consumer_ops) - 1]
  var stores: list<Op> = []
  for op in producer_ops {
    let inputs = ir.args(op)
    if syntax_op(m, op, "operator []=") && len(inputs) >= 3 &&
       inputs[0] == producer_args[producer_axes] {
      stores += [op]
    }
  }
  var private = true
  for user in ir.users(producer_outputs[0]) {
    if !contains(consumer, user) {
      private = false
    }
  }
  var store_only = true
  var initial_loads: list<Op> = []
  let store_indices = subscripts(stores[0], true)
  let producer_form = address_form(
    m, producer, producer_args[producer_axes], store_indices
  )
  for op in producer_ops {
    if load_at(
         m, producer, op, producer_args[producer_axes], producer,
         producer_args[producer_axes], store_indices
       ) {
      initial_loads += [op]
    }
  }
  for user in ir.users(producer_args[producer_axes]) {
    var initial_load = false
    for load in initial_loads {
      if user == load {
        initial_load = true
      }
    }
    if user != stores[0] && !initial_load {
      store_only = false
    }
  }
  let producer_init = ir.def(producer_inputs[producer_axes])
  var private_init = ir.live(producer_init)
  if private_init {
    for user in ir.users(producer_inputs[producer_axes]) {
      if user != producer {
        private_init = false
      }
    }
  }
  var direct_init = len(initial_loads) == 0
  if len(initial_loads) == 1 && constructor(producer_init) &&
     len(ir.args(producer_init)) == 1 &&
     len(ir.outs(initial_loads[0])) == 1 &&
     ir.type(ir.args(producer_init)[0]) == ir.type(ir.outs(initial_loads[0])[0]) {
    direct_init = true
  }
  let forward = private && store_only && private_init && direct_init
  var private_ranges: list<Op> = []
  for axis in 0..consumer_axes {
    let consumer_range = ir.def(consumer_inputs[axis])
    var private_range = ir.live(consumer_range) &&
                        consumer_range != ir.def(producer_inputs[axis])
    if private_range {
      for user in ir.users(consumer_inputs[axis]) {
        if user != consumer {
          private_range = false
        }
      }
    }
    if private_range {
      private_ranges += [consumer_range]
    }
  }

  var carried: list<Val> = [consumer_inputs[consumer_axes]]
  if !forward {
    carried = [producer_inputs[producer_axes],
               consumer_inputs[consumer_axes]]
  }
  var names: list<str> = []
  var ranges: list<Val> = []
  for axis in 0..producer_axes {
    names += [ir.name(producer_args[axis])]
    ranges += [producer_inputs[axis]]
  }
  let merged = ir.loop(m, consumer, names, ranges, carried)
  assert(ir.live(merged), "tile.fuse could not build the merged loop")
  let merged_body = ir.blks(merged)[0]
  let merged_args = ir.args(merged_body)
  let merged_ops = ir.ops(merged_body)
  let merged_yield = merged_ops[len(merged_ops) - 1]

  var old: list<Val> = []
  var next: list<Val> = []
  for axis in 0..producer_axes {
    old += [producer_args[axis]]
    next += [merged_args[axis]]
  }
  var consumer_carried = merged_args[producer_axes]
  if !forward {
    old += [producer_args[producer_axes]]
    next += [merged_args[producer_axes]]
    consumer_carried = merged_args[producer_axes + 1]
  }
  for i in 0..len(producer_ops) - 2 {
    if forward && len(initial_loads) == 1 &&
       producer_ops[i] == initial_loads[0] {
      let seed_op = ir.clone(
        m, producer_ops[i], merged_yield,
        old + [producer_args[producer_axes]],
        next + [producer_inputs[producer_axes]]
      )
      assert(ir.live(seed_op) && len(ir.outs(seed_op)) == 1,
             "tile.fuse could not clone a scalar initializer")
      assert(ir.retarget(
               m, seed_op, base_fn("copy", 1),
               [ir.args(producer_init)[0]]
             ),
             "tile.fuse could not materialize a scalar initializer")
      old += ir.outs(producer_ops[i])
      next += ir.outs(seed_op)
    } else {
      let copy = ir.clone(m, producer_ops[i], merged_yield, old, next)
      assert(ir.live(copy), "tile.fuse could not clone producer operation " +
             text(i) + " " + ir.kind(producer_ops[i]) + " " +
             ir.callee(producer_ops[i]))
      old += ir.outs(producer_ops[i])
      next += ir.outs(copy)
    }
  }
  let store_inputs = ir.args(stores[0])
  let scalar = mapped(store_inputs[len(store_inputs) - 1], old, next)
  let scalar_op = ir.def(scalar)
  if ir.name(scalar) == "" && ir.live(scalar_op) &&
     ir.blk(scalar_op) == merged_body {
    assert(ir.rename(m, scalar, "fuse_value_" + text(ir.key(scalar))),
           "tile.fuse could not retain the forwarded scalar")
  }
  var produced: list<Val> = []
  if !forward {
    let store = ir.clone(m, stores[0], merged_yield, old, next)
    assert(ir.live(store), "tile.fuse could not clone the producer store")
    produced = ir.outs(store)
    assert(len(produced) == 1,
           "tile.fuse found an invalid producer store")
    old += ir.outs(stores[0])
    next += produced
  }
  if producer_axes == consumer_axes {
    for axis in 0..consumer_axes {
      old += [consumer_args[axis]]
      next += [merged_args[axis]]
    }
  } else {
    var axes: list<Val> = []
    for axis in 0..producer_axes {
      axes += [merged_args[axis]]
    }
    let coordinate = affine_value(
      m, merged_yield, ir.type(consumer_args[0]),
      producer_form, axes
    )
    old += [consumer_args[0]]
    next += [coordinate]
  }
  old += [consumer_args[consumer_axes]]
  next += [consumer_carried]

  for i in 0..len(consumer_ops) - 1 {
    if load_at(
         m, consumer, consumer_ops[i], producer_outputs[0], producer,
         producer_args[producer_axes], subscripts(stores[0], true)
       ) {
      let outputs = ir.outs(consumer_ops[i])
      assert(len(outputs) == 1,
             "tile.fuse found an invalid pointwise load")
      old += outputs
      next += [scalar]
    } else {
      let copy = ir.clone(m, consumer_ops[i], merged_yield, old, next)
      assert(ir.live(copy), "tile.fuse could not clone consumer operation " +
             text(i) + " " + ir.kind(consumer_ops[i]) + " " +
             ir.callee(consumer_ops[i]))
      old += ir.outs(consumer_ops[i])
      next += ir.outs(copy)
    }
  }
  let consumed = mapped(ir.args(consumer_yield), old, next)
  assert(len(consumed) == 1,
         "tile.fuse found an invalid consumer yield")
  if forward {
    assert(ir.args(m, merged_yield, consumed),
           "tile.fuse could not connect the forwarded loop")
    assert(ir.replace(m, consumer_outputs[0], ir.outs(merged)[0]),
           "tile.fuse could not replace the consumer result")
  } else {
    assert(ir.args(m, merged_yield, [produced[0], consumed[0]]),
           "tile.fuse could not connect the merged loop")
    assert(ir.replace(
             m, [producer_outputs[0], consumer_outputs[0]], ir.outs(merged)
           ),
           "tile.fuse could not replace the original loop results")
  }
  var erased: list<Op> = [consumer, producer]
  if forward {
    erased += [producer_init]
  }
  for range in private_ranges {
    erased += [range]
  }
  assert(ir.erase(m, erased),
         "tile.fuse could not erase the original structure")
  return merged
}

local fn fuse_all(
  m: Mod, policies: list<Fn>, arg: Attr, configured: bool
) -> bool {
  assert(len(policies) <= 1,
         "tile.fuse accepts at most one profitability policy")
  var limit = 0
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      limit += 1
    }
  }
  var changed = false
  var again = true
  for round in 0..limit {
    if again {
      again = false
      for pair in fusible(m) {
        if len(pair) == 2 && ir.live(pair[0]) && ir.live(pair[1]) {
          var profitable = true
          if len(policies) == 1 {
            let before = ir.revision(m)
            if configured {
              profitable = ir.invoke<bool>(m, pair, policies[0], arg)
            } else {
              profitable = ir.invoke<bool>(m, pair, policies[0])
            }
            assert(ir.revision(m) == before,
                   "tile.fuse policy must not mutate the module")
          }
          if profitable {
            assert(ir.live(fuse(m, pair[0], pair[1])),
                   "tile.fuse could not apply a valid candidate")
            changed = true
            again = true
          }
        }
      }
    }
  }
  if changed {
    opt.dce(m, [])
  }
  return changed
}

fn fuse(m: Mod) -> bool {
  return fuse_all(m, [], nil, false)
}

fn fuse(m: Mod, policy: Fn) -> bool {
  assert(ir.live(policy), "tile.fuse requires a valid policy")
  return fuse_all(m, [policy], nil, false)
}

fn fuse(m: Mod, policy: Fn, arg: Attr) -> bool {
  assert(ir.live(policy), "tile.fuse requires a valid policy")
  return fuse_all(m, [policy], arg, true)
}
