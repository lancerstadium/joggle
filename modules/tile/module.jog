module tile
use base
use ir
use opt
use tensor

[memo]
local fn base_op(m: Mod, op: Op, name: str) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  let target = ir.target(m, op)
  return target == "base." + name ||
         (target == ir.callee(op) && target == name)
}

[memo]
local fn base_fn(name: str, arity: int) -> Fn {
  for fn in ir.fns("base") {
    if ir.name(fn) == name && len(ir.params(fn)) == arity {
      return fn
    }
  }
  assert(false, "tile requires base." + name)
  return ir.find("")
}

local fn call_like(
  m: Mod, before: Op, source: Op, args: list<Val>, type: Ty
) -> Val {
  let target = ir.resolve(m, source)
  if ir.live(target) {
    return ir.call(m, before, target, args, type)
  }
  return ir.call(m, before, ir.callee(source), args, type)
}

[memo]
local fn syntax_op(m: Mod, op: Op, name: str) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  let target = ir.resolve(m, op)
  if ir.live(target) {
    return ir.name(target) == name
  }
  return ir.callee(op) == name
}
local fn mapped(value: Val, old: list<Val>, next: list<Val>) -> Val {
  for i in 0..len(old) {
    if value == old[i] {
      return next[i]
    }
  }
  return value
}

local fn mapped(values: list<Val>, old: list<Val>, next: list<Val>)
    -> list<Val> {
  var out: list<Val> = []
  for value in values {
    out += [mapped(value, old, next)]
  }
  return out
}

local fn same_value(left: Val, right: Val) -> bool {
  if left == right {
    return true
  }
  return ir.type(left) == ir.type(right) &&
         ir.is_const(left) && ir.is_const(right) &&
         ir.constant(left) == ir.constant(right)
}

local fn same_range(m: Mod, left: Val, right: Val) -> bool {
  if left == right {
    return true
  }
  let left_op = ir.def(left)
  let right_op = ir.def(right)
  if !syntax_op(m, left_op, "operator ..") ||
     !syntax_op(m, right_op, "operator ..") {
    return false
  }
  let a = ir.args(left_op)
  let b = ir.args(right_op)
  return len(a) == 2 && len(b) == 2 &&
         same_value(a[0], b[0]) && same_value(a[1], b[1])
}

[memo]
local fn captured(op: Op, value: Val) -> bool {
  for input in ir.args(op) {
    if input == value {
      return true
    }
  }
  for body in ir.blks(op) {
    for child in ir.ops(body) {
      if captured(child, value) {
        return true
      }
    }
  }
  return false
}

[memo]
local fn contains(root: Op, selected: Op) -> bool {
  if root == selected {
    return true
  }
  for body in ir.blks(root) {
    for child in ir.ops(body) {
      if contains(child, selected) {
        return true
      }
    }
  }
  return false
}

local fn load(m: Mod, op: Op, tensor: Val, index: Val) -> bool {
  let inputs = ir.args(op)
  return syntax_op(m, op, "operator []") &&
         len(inputs) == 2 && inputs[0] == tensor && inputs[1] == index
}

local fn same_form(left: list<int>, right: list<int>) -> bool {
  if len(left) == 0 || len(left) != len(right) {
    return false
  }
  for i in 0..len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}

local fn dense_form(shape: list<int>, form: list<int>) -> bool {
  if len(shape) == 0 || len(form) != len(shape) + 1 || form[0] != 0 {
    return false
  }
  var stride = 1
  for reverse in 0..len(shape) {
    let axis = len(shape) - reverse - 1
    if shape[axis] <= 0 || form[axis + 1] != stride {
      return false
    }
    let next = affine_mul_int(stride, shape[axis])
    if len(next) == 0 {
      return false
    }
    stride = next[0]
  }
  return true
}

local fn zero_range(m: Mod, value: Val, extent: int) -> bool {
  let op = ir.def(value)
  if !syntax_op(m, op, "operator ..") {
    return false
  }
  let bounds = ir.args(op)
  return len(bounds) == 2 && ir.is_const(bounds[0]) &&
         ir.is_const(bounds[1]) &&
         base.kind(ir.constant(bounds[0])) == "int" &&
         base.kind(ir.constant(bounds[1])) == "int" &&
         base.int(ir.constant(bounds[0])) == 0 &&
         base.int(ir.constant(bounds[1])) == extent
}

local fn collapsed_iteration(
  m: Mod,
  producer: Op,
  producer_tensor: Val,
  producer_indices: list<Val>,
  consumer: Op
) -> bool {
  let producer_inputs = ir.args(producer)
  let producer_axes = len(producer_inputs) - len(ir.outs(producer))
  let consumer_inputs = ir.args(consumer)
  let consumer_axes = len(consumer_inputs) - len(ir.outs(consumer))
  if producer_axes <= 1 || consumer_axes != 1 {
    return false
  }
  let shape = extents(m, producer)
  if len(shape) != producer_axes ||
     !dense_form(
       shape,
       address_form(m, producer, producer_tensor, producer_indices)
     ) {
    return false
  }
  var total = 1
  for axis in 0..producer_axes {
    if !zero_range(m, producer_inputs[axis], shape[axis]) {
      return false
    }
    let next = affine_mul_int(total, shape[axis])
    if len(next) == 0 {
      return false
    }
    total = next[0]
  }
  return zero_range(m, consumer_inputs[0], total)
}

// Compare two addresses in their respective iteration spaces. The loop axes
// need not share SSA values or source names; equal affine forms establish the
// coordinate-wise mapping used by fusion.
local fn same_point(
  m: Mod,
  left_loop: Op,
  left_tensor: Val,
  left: list<Val>,
  right_loop: Op,
  right_tensor: Val,
  right: list<Val>
) -> bool {
  let left_form = address_form(m, left_loop, left_tensor, left)
  let right_form = address_form(m, right_loop, right_tensor, right)
  return same_form(left_form, right_form) ||
         (right_form == [0, 1] &&
          dense_form(extents(m, left_loop), left_form))
}

local fn same_iteration(
  m: Mod,
  producer: Op,
  producer_tensor: Val,
  producer_indices: list<Val>,
  consumer: Op
) -> bool {
  let producer_inputs = ir.args(producer)
  let producer_axes = len(producer_inputs) - len(ir.outs(producer))
  let consumer_inputs = ir.args(consumer)
  let consumer_axes = len(consumer_inputs) - len(ir.outs(consumer))
  if producer_axes == consumer_axes {
    for axis in 0..producer_axes {
      if !same_range(m, producer_inputs[axis], consumer_inputs[axis]) {
        return false
      }
    }
    return true
  }
  return collapsed_iteration(
    m, producer, producer_tensor, producer_indices, consumer
  )
}

local fn subscripts(op: Op, write: bool) -> list<Val> {
  let inputs = ir.args(op)
  var end = len(inputs)
  if write {
    end -= 1
  }
  var out: list<Val> = []
  for i in 1..end {
    out += [inputs[i]]
  }
  return out
}

local fn load_at(
  m: Mod,
  loop: Op,
  op: Op,
  tensor: Val,
  source_loop: Op,
  source_tensor: Val,
  source_indices: list<Val>
) -> bool {
  let inputs = ir.args(op)
  return syntax_op(m, op, "operator []") && len(inputs) >= 2 &&
         inputs[0] == tensor &&
         same_point(
           m, source_loop, source_tensor, source_indices,
           loop, tensor, subscripts(op, false)
         )
}

local fn constructor(op: Op) -> bool {
  let outputs = ir.outs(op)
  return ir.kind(op) == "call" && len(outputs) == 1 &&
         ir.callee(op) == text(ir.type(outputs[0]))
}

local fn pointwise_at(
  m: Mod,
  loop: Op,
  op: Op,
  tensor: Val,
  source_loop: Op,
  source_tensor: Val,
  source_indices: list<Val>
) -> bool {
  var touches = false
  for input in ir.args(op) {
    if input == tensor {
      touches = true
    }
  }
  if touches {
    return load_at(
      m, loop, op, tensor, source_loop, source_tensor, source_indices
    )
  }
  for body in ir.blks(op) {
    for child in ir.ops(body) {
      if !pointwise_at(
           m, loop, child, tensor, source_loop, source_tensor,
           source_indices
         ) {
        return false
      }
    }
  }
  return true
}

local fn keep(m: Mod, value: Val, stem: str) -> Val {
  assert(ir.live(value), "tile: cannot retain an invalid value")
  assert(ir.rename(m, value, stem + "_" + text(ir.key(value))),
         "tile: cannot name a generated value")
  return value
}

local fn last_axis(source: Op) -> int {
  if !ir.live(source) || ir.kind(source) != "loop" {
    return -1
  }
  return len(ir.args(source)) - len(ir.outs(source)) - 1
}

fn split_issue(m: Mod, source: Op, axis: int, factor: int) -> str {
  if factor <= 0 {
    return "requires a positive factor"
  }
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(inputs) <= len(outputs) {
    return "requires a structured range loop"
  }
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)
  if axes <= 0 || len(body_args) != axes + len(outputs) {
    return "found an invalid loop signature"
  }
  if axis < 0 || axis >= axes {
    return "requires an axis within the loop rank"
  }
  let range_op = ir.def(inputs[axis])
  if !syntax_op(m, range_op, "operator ..") {
    return "requires the selected iterator to use a range"
  }
  let bounds = ir.args(range_op)
  if len(bounds) != 2 || ir.type(bounds[0]) != ir.type(bounds[1]) {
    return "requires matching range bounds"
  }
  if ir.type(body_args[axis]) != ty("index") {
    return "requires an index iterator"
  }
  let ops = ir.ops(body)
  if len(ops) == 0 || ir.kind(ops[len(ops) - 1]) != "yield" {
    return "requires a terminated loop body"
  }
  return ""
}

fn split_issue(m: Mod, source: Op, factor: int) -> str {
  return split_issue(m, source, last_axis(source), factor)
}

fn can_split(m: Mod, source: Op, axis: int, factor: int) -> bool {
  let before = ir.revision(m)
  let legal = factor > 1 && split_issue(m, source, axis, factor) == ""
  assert(ir.revision(m) == before,
         "tile.can_split changed the module")
  return legal
}

fn can_split(m: Mod, source: Op, factor: int) -> bool {
  return can_split(m, source, last_axis(source), factor)
}

fn splittable(m: Mod, axis: int, factor: int) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_split(m, op, axis, factor) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.splittable changed the module")
  return out
}

fn splittable(m: Mod, factor: int) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_split(m, op, last_axis(op), factor) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.splittable changed the module")
  return out
}

local fn clone_body(
  m: Mod, source: Blk, target: Blk,
  old: list<Val>, next: list<Val>
) -> list<Val> {
  let source_ops = ir.ops(source)
  let target_ops = ir.ops(target)
  assert(len(source_ops) > 0 && len(target_ops) > 0 &&
         ir.kind(source_ops[len(source_ops) - 1]) == "yield" &&
         ir.kind(target_ops[len(target_ops) - 1]) == "yield",
         "tile requires terminated source and target blocks")
  let before = target_ops[len(target_ops) - 1]
  var old_values = old
  var next_values = next
  for i in 0..len(source_ops) - 1 {
    let copy = ir.clone(
      m, source_ops[i], before, old_values, next_values
    )
    assert(ir.live(copy), "tile could not clone a loop body")
    let source_outputs = ir.outs(source_ops[i])
    let target_outputs = ir.outs(copy)
    assert(len(source_outputs) == len(target_outputs),
           "tile cloned an inconsistent operation")
    old_values += source_outputs
    next_values += target_outputs
  }
  return mapped(
    ir.args(source_ops[len(source_ops) - 1]), old_values, next_values
  )
}

local fn adjacent_axis(source: Op) -> int {
  return last_axis(source) - 1
}

fn merge_issue(m: Mod, source: Op, axis: int) -> str {
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(inputs) <= len(outputs) {
    return "requires a structured range loop"
  }
  let axes = len(inputs) - len(outputs)
  let body_args = ir.args(bodies[0])
  if axes < 2 || len(body_args) != len(inputs) {
    return "requires at least two loop axes"
  }
  if axis < 0 || axis + 1 >= axes {
    return "requires an adjacent axis pair within the loop rank"
  }
  if ir.type(body_args[axis]) != ty("index") ||
     ir.type(body_args[axis + 1]) != ty("index") {
    return "requires index iterators"
  }
  let left = ir.def(inputs[axis])
  let right = ir.def(inputs[axis + 1])
  if !syntax_op(m, left, "operator ..") ||
     !syntax_op(m, right, "operator ..") {
    return "requires adjacent range iterators"
  }
  let left_bounds = ir.args(left)
  let right_bounds = ir.args(right)
  if len(left_bounds) != 2 || len(right_bounds) != 2 {
    return "requires two-bound ranges"
  }
  for bound in left_bounds + right_bounds {
    if !ir.is_const(bound) || base.kind(ir.constant(bound)) != "int" {
      return "requires static integer bounds"
    }
  }
  let left_width = base.int(ir.constant(left_bounds[1])) -
                   base.int(ir.constant(left_bounds[0]))
  let right_width = base.int(ir.constant(right_bounds[1])) -
                    base.int(ir.constant(right_bounds[0]))
  if left_width <= 0 || right_width <= 0 {
    return "requires non-empty increasing ranges"
  }
  if len(affine_mul_int(left_width, right_width)) == 0 {
    return "range product overflows"
  }
  let ops = ir.ops(bodies[0])
  if len(ops) == 0 || ir.kind(ops[len(ops) - 1]) != "yield" {
    return "requires a terminated loop body"
  }
  return ""
}

fn merge_issue(m: Mod, source: Op) -> str {
  return merge_issue(m, source, adjacent_axis(source))
}

fn can_merge(m: Mod, source: Op, axis: int) -> bool {
  let before = ir.revision(m)
  let legal = merge_issue(m, source, axis) == ""
  assert(ir.revision(m) == before,
         "tile.can_merge changed the module")
  return legal
}

fn can_merge(m: Mod, source: Op) -> bool {
  return can_merge(m, source, adjacent_axis(source))
}

fn mergeable(m: Mod, axis: int) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_merge(m, op, axis) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.mergeable changed the module")
  return out
}

fn mergeable(m: Mod) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_merge(m, op) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.mergeable changed the module")
  return out
}

fn merge(m: Mod, source: Op, axis: int) -> Op {
  let issue = merge_issue(m, source, axis)
  assert(issue == "", "tile.merge " + issue)

  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let axes = len(inputs) - len(outputs)
  let body = ir.blks(source)[0]
  let body_args = ir.args(body)
  let left_range = ir.def(inputs[axis])
  let right_range = ir.def(inputs[axis + 1])
  let left_bounds = ir.args(left_range)
  let right_bounds = ir.args(right_range)
  let left_begin = base.int(ir.constant(left_bounds[0]))
  let left_end = base.int(ir.constant(left_bounds[1]))
  let right_begin = base.int(ir.constant(right_bounds[0]))
  let right_end = base.int(ir.constant(right_bounds[1]))
  let right_width = right_end - right_begin
  let product = affine_mul_int(left_end - left_begin, right_width)
  assert(len(product) == 1, "tile.merge range product overflows")

  let type = ty("index")
  let zero = keep(m, ir.constant(m, source, 0, type), "merge_zero")
  let total = keep(
    m, ir.constant(m, source, product[0], type), "merge_extent"
  )
  let inner_extent = keep(
    m, ir.constant(m, source, right_width, type), "merge_inner_extent"
  )
  let outer_begin = keep(
    m, ir.constant(m, source, left_begin, type), "merge_outer_begin"
  )
  let inner_begin = keep(
    m, ir.constant(m, source, right_begin, type), "merge_inner_begin"
  )
  let range = call_like(
    m, source, left_range, [zero, total], ir.type(inputs[axis])
  )

  var sources: list<Val> = []
  var names: list<str> = []
  for i in 0..axes {
    if i == axis {
      sources += [range]
      names += ["merge_" + text(ir.key(body_args[axis]))]
    } else {
      if i != axis + 1 {
        sources += [inputs[i]]
        names += [ir.name(body_args[i])]
      }
    }
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }

  let merged = ir.loop(m, source, names, sources, carried)
  assert(ir.live(merged), "tile.merge could not build the merged loop")
  let merged_body = ir.blks(merged)[0]
  let merged_args = ir.args(merged_body)
  let merged_ops = ir.ops(merged_body)
  let merged_yield = merged_ops[len(merged_ops) - 1]
  let linear = merged_args[axis]
  let outer_offset = keep(
    m, ir.call(
      m, merged_yield, base_fn("operator /", 2),
      [linear, inner_extent], type
    ),
    "merge_outer_offset"
  )
  let inner_offset = keep(
    m, ir.call(
      m, merged_yield, base_fn("operator %", 2),
      [linear, inner_extent], type
    ),
    "merge_inner_offset"
  )
  let outer = keep(
    m, ir.call(
      m, merged_yield, base_fn("operator +", 2),
      [outer_begin, outer_offset], type
    ),
    "merge_outer"
  )
  let inner = keep(
    m, ir.call(
      m, merged_yield, base_fn("operator +", 2),
      [inner_begin, inner_offset], type
    ),
    "merge_inner"
  )

  var old: list<Val> = []
  var next: list<Val> = []
  for i in 0..axes {
    old += [body_args[i]]
    if i == axis {
      next += [outer]
    } else {
      if i == axis + 1 {
        next += [inner]
      } else {
        var merged_axis = i
        if i > axis + 1 {
          merged_axis -= 1
        }
        next += [merged_args[merged_axis]]
      }
    }
  }
  for i in 0..len(outputs) {
    old += [body_args[axes + i]]
    next += [merged_args[axes - 1 + i]]
  }
  assert(ir.args(m, merged_yield,
                 clone_body(m, body, merged_body, old, next)),
         "tile.merge could not connect the merged loop")
  if len(outputs) != 0 {
    assert(ir.replace(m, outputs, ir.outs(merged)),
           "tile.merge could not replace the original loop results")
  }
  assert(ir.erase(m, source),
         "tile.merge could not erase the original loop")
  return merged
}

fn merge(m: Mod, source: Op) -> Op {
  return merge(m, source, adjacent_axis(source))
}

fn peel_issue(m: Mod, source: Op, axis: int, factor: int) -> str {
  if factor <= 0 {
    return "requires a positive factor"
  }
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(outputs) != 1 || len(inputs) <= len(outputs) {
    return "requires one carried value in a structured range loop"
  }
  let axes = len(inputs) - len(outputs)
  let body_args = ir.args(bodies[0])
  if len(body_args) != len(inputs) {
    return "found an invalid loop signature"
  }
  if axis < 0 || axis >= axes {
    return "requires an axis within the loop rank"
  }
  let range = ir.def(inputs[axis])
  if !syntax_op(m, range, "operator ..") {
    return "requires the selected iterator to use a range"
  }
  let bounds = ir.args(range)
  if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
     !ir.is_const(bounds[1]) ||
     base.kind(ir.constant(bounds[0])) != "int" ||
     base.kind(ir.constant(bounds[1])) != "int" {
    return "requires static integer bounds"
  }
  var identity: list<int> = []
  for i in 0..axes {
    identity += [i]
  }
  let issue = reorder_issue(m, source, identity)
  if issue != "" {
    return issue
  }
  let state = state_axes(m, source)
  for i in 0..axis + 1 {
    if i >= len(state) || state[i] != i {
      return "requires the selected axis and its outer axes to be state axes"
    }
  }
  let ops = ir.ops(bodies[0])
  if len(ops) == 0 || ir.kind(ops[len(ops) - 1]) != "yield" {
    return "requires a terminated loop body"
  }
  return ""
}

fn can_peel(m: Mod, source: Op, axis: int, factor: int) -> bool {
  let before = ir.revision(m)
  var legal = factor > 1 && peel_issue(m, source, axis, factor) == ""
  if legal {
    let range = ir.def(ir.args(source)[axis])
    let bounds = ir.args(range)
    let lower = base.int(ir.constant(bounds[0]))
    let upper = base.int(ir.constant(bounds[1]))
    var width = 0
    if upper > lower {
      width = upper - lower
    }
    legal = width > factor && width % factor != 0
  }
  assert(ir.revision(m) == before,
         "tile.can_peel changed the module")
  return legal
}

fn peel(m: Mod, source: Op, axis: int, factor: int) -> list<Op> {
  let issue = peel_issue(m, source, axis, factor)
  assert(issue == "", "tile.peel " + issue)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let axes = len(inputs) - len(outputs)
  let body = ir.blks(source)[0]
  let body_args = ir.args(body)
  let range = ir.def(inputs[axis])
  let bounds = ir.args(range)
  let lower = base.int(ir.constant(bounds[0]))
  let upper = base.int(ir.constant(bounds[1]))
  var width = 0
  if upper > lower {
    width = upper - lower
  }
  if factor == 1 || width <= factor || width % factor == 0 {
    return [source]
  }

  let middle = lower + width / factor * factor
  let middle_value = keep(
    m, ir.constant(m, source, middle, ir.type(bounds[0])), "peel_middle"
  )
  let prefix_range = call_like(
    m, source, range, [bounds[0], middle_value], ir.type(inputs[axis])
  )
  let tail_range = call_like(
    m, source, range, [middle_value, bounds[1]], ir.type(inputs[axis])
  )

  var names: list<str> = []
  var prefix_sources: list<Val> = []
  var tail_sources: list<Val> = []
  for i in 0..axes {
    names += [ir.name(body_args[i])]
    if i == axis {
      prefix_sources += [prefix_range]
      tail_sources += [tail_range]
    } else {
      prefix_sources += [inputs[i]]
      tail_sources += [inputs[i]]
    }
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }

  let prefix = ir.loop(m, source, names, prefix_sources, carried)
  assert(ir.live(prefix), "tile.peel could not build the aligned prefix")
  let prefix_body = ir.blks(prefix)[0]
  let prefix_ops = ir.ops(prefix_body)
  let prefix_yield = prefix_ops[len(prefix_ops) - 1]
  assert(ir.args(
           m, prefix_yield,
           clone_body(m, body, prefix_body, body_args, ir.args(prefix_body))
         ),
         "tile.peel could not connect the aligned prefix")

  let tail = ir.loop(m, source, names, tail_sources, ir.outs(prefix))
  assert(ir.live(tail), "tile.peel could not build the scalar tail")
  let tail_body = ir.blks(tail)[0]
  let tail_ops = ir.ops(tail_body)
  let tail_yield = tail_ops[len(tail_ops) - 1]
  assert(ir.args(
           m, tail_yield,
           clone_body(m, body, tail_body, body_args, ir.args(tail_body))
         ),
         "tile.peel could not connect the scalar tail")

  assert(ir.replace(m, outputs, ir.outs(tail)),
         "tile.peel could not replace the original loop results")
  assert(ir.erase(m, source),
         "tile.peel could not erase the original loop")
  return [prefix, tail]
}

fn split(m: Mod, source: Op, axis: int, factor: int) -> Op {
  let issue = split_issue(m, source, axis, factor)
  assert(issue == "", "tile.split " + issue)
  if factor == 1 {
    return source
  }

  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)

  let range = inputs[axis]
  let range_op = ir.def(range)
  let bounds = ir.args(range_op)

  let type = ty("index")
  var lower = bounds[0]
  var upper = bounds[1]
  var exact = false
  let fixed = ir.is_const(bounds[0]) && ir.is_const(bounds[1]) &&
              base.kind(ir.constant(bounds[0])) == "int" &&
              base.kind(ir.constant(bounds[1])) == "int"
  if fixed {
    lower = keep(
      m, ir.constant(
        m, source, base.int(ir.constant(bounds[0])), type
      ),
      "tile_begin"
    )
    upper = keep(
      m, ir.constant(
        m, source, base.int(ir.constant(bounds[1])), type
      ),
      "tile_end"
    )
  } else {
    if ir.type(lower) != type {
      lower = keep(
        m, ir.call(m, source, text(type), [lower], type), "tile_begin"
      )
      upper = keep(
        m, ir.call(m, source, text(type), [upper], type), "tile_end"
      )
    }
  }
  let zero = keep(m, ir.constant(m, source, 0, type), "tile_zero")
  let factor_value = keep(
    m, ir.constant(m, source, factor, type), "tile_factor"
  )
  var blocks = zero
  if fixed {
    let begin = base.int(ir.constant(bounds[0]))
    let end = base.int(ir.constant(bounds[1]))
    var width = 0
    if end > begin {
      width = end - begin
    }
    exact = width % factor == 0
    var block_count = width / factor
    if width % factor != 0 {
      block_count += 1
    }
    blocks = keep(
      m, ir.constant(
        m, source, block_count, type
      ),
      "tile_blocks"
    )
  } else {
    let one = keep(m, ir.constant(m, source, 1, type), "tile_one")
    let width = keep(
      m, ir.call(
        m, source, base_fn("operator -", 2), [upper, lower], type
      ),
      "tile_width"
    )
    let factor_less_one = keep(
      m, ir.call(
        m, source, base_fn("operator -", 2), [factor_value, one], type
      ),
      "tile_tail"
    )
    let padded = keep(
      m, ir.call(
        m, source, base_fn("operator +", 2), [width, factor_less_one], type
      ),
      "tile_padded"
    )
    blocks = keep(
      m, ir.call(
        m, source, base_fn("operator /", 2), [padded, factor_value], type
      ),
      "tile_blocks"
    )
  }
  let outer_range = call_like(
    m, source, range_op, [zero, blocks], ir.type(range)
  )
  let inner_range = call_like(
    m, source, range_op, [zero, factor_value], ir.type(range)
  )

  var sources: list<Val> = []
  var names: list<str> = []
  for i in 0..axes {
    if i == axis {
      sources += [outer_range, inner_range]
      names += [ir.name(body_args[i]) + "_tile", ir.name(body_args[i])]
    } else {
      sources += [inputs[i]]
      names += [ir.name(body_args[i])]
    }
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }

  let split = ir.loop(m, source, names, sources, carried)
  assert(ir.live(split), "tile.split could not build the split loop")
  let split_body = ir.blks(split)[0]
  let split_args = ir.args(split_body)
  let split_ops = ir.ops(split_body)
  let split_yield = split_ops[len(split_ops) - 1]

  let scaled = keep(
    m,
    ir.call(
      m, split_yield, base_fn("operator *", 2),
      [split_args[axis], factor_value], type
    ),
    "tile_scaled"
  )
  let base = keep(
    m, ir.call(
      m, split_yield, base_fn("operator +", 2), [lower, scaled], type
    ),
    "tile_base"
  )
  let index = keep(
    m, ir.call(
      m, split_yield, base_fn("operator +", 2),
      [base, split_args[axis + 1]], type
    ),
    "tile_index"
  )

  var old: list<Val> = []
  var next: list<Val> = []
  for i in 0..axes {
    old += [body_args[i]]
    if i == axis {
      next += [index]
    } else {
      var split_axis = i
      if i > axis {
        split_axis += 1
      }
      next += [split_args[split_axis]]
    }
  }
  if exact {
    for i in 0..len(outputs) {
      old += [body_args[axes + i]]
      next += [split_args[axes + 1 + i]]
    }
    assert(ir.args(m, split_yield,
                   clone_body(m, body, split_body, old, next)),
           "tile.split could not connect an exact split loop")
  } else {
    let inside = keep(
      m, ir.call(
        m, split_yield, base_fn("operator <", 2),
        [index, upper], ty("bool")
      ),
      "tile_inside"
    )
    var guarded_carried: list<Val> = []
    for i in axes + 1..len(split_args) {
      guarded_carried += [split_args[i]]
    }
    let guard = ir.branch(m, split_yield, inside, guarded_carried)
    assert(ir.live(guard), "tile.split could not build the tail guard")
    let then_body = ir.blks(guard)[0]
    let then_args = ir.args(then_body)
    let then_ops = ir.ops(then_body)
    let then_yield = then_ops[len(then_ops) - 1]
    for i in 0..len(outputs) {
      old += [body_args[axes + i]]
      next += [then_args[i]]
    }
    assert(ir.args(m, then_yield,
                   clone_body(m, body, then_body, old, next)),
           "tile.split could not connect the guarded body")
    assert(ir.args(m, split_yield, ir.outs(guard)),
           "tile.split could not connect the split loop")
  }
  if len(outputs) != 0 {
    assert(ir.replace(m, outputs, ir.outs(split)),
           "tile.split could not replace the original loop results")
  }
  assert(ir.erase(m, source),
         "tile.split could not erase the original loop")
  return split
}

fn split(m: Mod, source: Op, factor: int) -> Op {
  return split(m, source, last_axis(source), factor)
}

fn unroll_issue(m: Mod, source: Op, factor: int) -> str {
  if factor <= 0 {
    return "requires a positive factor"
  }
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  if factor == 1 {
    return ""
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(inputs) <= len(outputs) {
    return "requires a structured range loop"
  }
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)
  if axes <= 0 || len(body_args) != axes + len(outputs) {
    return "found an invalid loop signature"
  }
  let axis = axes - 1
  if ir.type(body_args[axis]) != ty("index") {
    return "requires an index iterator"
  }

  let range = inputs[axis]
  let range_op = ir.def(range)
  if !syntax_op(m, range_op, "operator ..") {
    return "requires the last iterator to use a range"
  }
  let bounds = ir.args(range_op)
  if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
     !ir.is_const(bounds[1]) ||
     base.kind(ir.constant(bounds[0])) != "int" ||
     base.kind(ir.constant(bounds[1])) != "int" {
    return "requires static integer bounds"
  }
  let lower = base.int(ir.constant(bounds[0]))
  let upper = base.int(ir.constant(bounds[1]))
  var trip = 0
  if upper > lower {
    trip = upper - lower
  }
  if trip % factor != 0 {
    return "requires the trip count to be divisible by the factor"
  }
  return ""
}

fn can_unroll(m: Mod, source: Op, factor: int) -> bool {
  let before = ir.revision(m)
  let legal = factor > 1 && unroll_issue(m, source, factor) == ""
  assert(ir.revision(m) == before,
         "tile.can_unroll changed the module")
  return legal
}

fn unrollable(m: Mod, factor: int) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_unroll(m, op, factor) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.unrollable changed the module")
  return out
}

fn unroll(m: Mod, source: Op, factor: int) -> Op {
  let issue = unroll_issue(m, source, factor)
  assert(issue == "", "tile.unroll " + issue)
  if factor == 1 {
    return source
  }

  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)
  let axis = axes - 1
  let range = inputs[axis]
  let range_op = ir.def(range)
  let bounds = ir.args(range_op)
  let lower = base.int(ir.constant(bounds[0]))
  let upper = base.int(ir.constant(bounds[1]))
  var trip = 0
  if upper > lower {
    trip = upper - lower
  }
  var private_range = true
  for user in ir.users(range) {
    if user != source {
      private_range = false
    }
  }

  let type = ty("index")
  let zero = keep(m, ir.constant(m, source, 0, type), "unroll_zero")
  let blocks = keep(
    m, ir.constant(m, source, trip / factor, type), "unroll_blocks"
  )
  let outer_range = call_like(
    m, source, range_op, [zero, blocks], ir.type(range)
  )
  var names: list<str> = []
  var sources: list<Val> = []
  for i in 0..axes {
    names += [ir.name(body_args[i])]
    if i == axis {
      sources += [outer_range]
    } else {
      sources += [inputs[i]]
    }
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }
  let outer = ir.loop(m, source, names, sources, carried)
  assert(ir.live(outer), "tile.unroll could not build the outer loop")
  let outer_body = ir.blks(outer)[0]
  let outer_args = ir.args(outer_body)
  let outer_ops = ir.ops(outer_body)
  let outer_yield = outer_ops[len(outer_ops) - 1]

  let width = keep(
    m, ir.constant(m, outer_yield, factor, type), "unroll_factor"
  )
  let begin = keep(
    m, ir.constant(m, outer_yield, lower, type), "unroll_begin"
  )
  let scaled = keep(
    m,
    ir.call(
      m, outer_yield, base_fn("operator *", 2),
      [outer_args[axis], width], type
    ),
    "unroll_scaled"
  )
  let base_index = keep(
    m, ir.call(
      m, outer_yield, base_fn("operator +", 2), [begin, scaled], type
    ),
    "unroll_base"
  )

  let original_ops = ir.ops(body)
  assert(len(original_ops) > 0 &&
         ir.kind(original_ops[len(original_ops) - 1]) == "yield",
         "tile.unroll requires a terminated loop body")
  let original_yield = original_ops[len(original_ops) - 1]
  var current: list<Val> = []
  for i in axes..len(outer_args) {
    current += [outer_args[i]]
  }
  for point in 0..factor {
    var index = base_index
    if point != 0 {
      let offset = keep(
        m, ir.constant(m, outer_yield, point, type), "unroll_offset"
      )
      index = keep(
        m, ir.call(
          m, outer_yield, base_fn("operator +", 2),
          [base_index, offset], type
        ),
        "unroll_index"
      )
    }
    var old: list<Val> = []
    var next: list<Val> = []
    for i in 0..axes {
      old += [body_args[i]]
      if i == axis {
        next += [index]
      } else {
        next += [outer_args[i]]
      }
    }
    for i in 0..len(outputs) {
      old += [body_args[axes + i]]
      next += [current[i]]
    }
    for i in 0..len(original_ops) - 1 {
      let copy = ir.clone(m, original_ops[i], outer_yield, old, next)
      assert(ir.live(copy), "tile.unroll could not clone the loop body")
      old += ir.outs(original_ops[i])
      next += ir.outs(copy)
    }
    current = mapped(ir.args(original_yield), old, next)
    assert(len(current) == len(outputs),
           "tile.unroll found an invalid loop yield")
  }

  assert(ir.args(m, outer_yield, current),
         "tile.unroll could not connect the outer loop")
  if len(outputs) != 0 {
    assert(ir.replace(m, outputs, ir.outs(outer)),
           "tile.unroll could not replace the original loop results")
  }
  var erased: list<Op> = [source]
  if private_range {
    erased += [range_op]
  }
  assert(ir.erase(m, erased),
         "tile.unroll could not erase the original loop")
  opt.dce(m, [])
  return outer
}

local fn unroll_all(
  m: Mod, policy: Fn, arg: Attr, configured: bool
) -> bool {
  assert(ir.live(policy), "tile.unroll requires a valid policy")
  let candidates = ir.ops(m)
  var changed = false
  for reverse in 0..len(candidates) {
    let op = candidates[len(candidates) - reverse - 1]
    if ir.live(op) && ir.kind(op) == "loop" {
      let before = ir.revision(m)
      var factor = 1
      if configured {
        factor = ir.invoke<int>(m, op, policy, arg)
      } else {
        factor = ir.invoke<int>(m, op, policy)
      }
      assert(ir.revision(m) == before,
             "tile.unroll policy changed the module")
      if factor > 1 {
        let issue = unroll_issue(m, op, factor)
        assert(issue == "",
               "tile.unroll policy selected an illegal factor: " + issue)
        assert(ir.live(unroll(m, op, factor)),
               "tile.unroll could not apply a valid candidate")
        changed = true
      }
    }
  }
  return changed
}

fn unroll(m: Mod, policy: Fn) -> bool {
  return unroll_all(m, policy, nil, false)
}

fn unroll(m: Mod, policy: Fn, arg: Attr) -> bool {
  return unroll_all(m, policy, arg, true)
}

fn fuse_issue(m: Mod, producer: Op, consumer: Op) -> str {
  if !ir.live(producer) || !ir.live(consumer) ||
     ir.kind(producer) != "loop" || ir.kind(consumer) != "loop" ||
     producer == consumer || ir.blk(producer) != ir.blk(consumer) {
    return "requires two distinct loops in one block"
  }
  var ordered = false
  var found = false
  for op in ir.ops(ir.blk(producer)) {
    if op == producer {
      ordered = true
    }
    if op == consumer {
      found = true
      if !ordered {
        return "requires producer before consumer"
      }
    }
  }
  if !found {
    return "requires producer before consumer"
  }

  let producer_inputs = ir.args(producer)
  let consumer_inputs = ir.args(consumer)
  let producer_outputs = ir.outs(producer)
  let consumer_outputs = ir.outs(consumer)
  let producer_bodies = ir.blks(producer)
  let consumer_bodies = ir.blks(consumer)
  if len(producer_outputs) != 1 || len(consumer_outputs) != 1 ||
     len(producer_bodies) != 1 || len(consumer_bodies) != 1 {
    return "currently requires one carried tensor per loop"
  }
  let producer_axes = len(producer_inputs) - len(producer_outputs)
  let consumer_axes = len(consumer_inputs) - len(consumer_outputs)
  if producer_axes <= 0 || consumer_axes <= 0 {
    return "requires nonempty iteration spaces"
  }
  if ir.type(producer_outputs[0]) !=
       ir.type(producer_inputs[producer_axes]) ||
     ir.type(consumer_outputs[0]) !=
       ir.type(consumer_inputs[consumer_axes]) ||
     producer_outputs[0] == consumer_inputs[consumer_axes] {
    return "requires distinct, type-stable carried tensors"
  }

  let producer_body = producer_bodies[0]
  let consumer_body = consumer_bodies[0]
  let producer_args = ir.args(producer_body)
  let consumer_args = ir.args(consumer_body)
  if len(producer_args) != producer_axes + 1 ||
     len(consumer_args) != consumer_axes + 1 {
    return "found incompatible loop bodies"
  }
  if producer_axes == consumer_axes {
    for axis in 0..producer_axes {
      if ir.type(producer_args[axis]) != ir.type(consumer_args[axis]) {
        return "found incompatible loop bodies"
      }
    }
  }

  var stores: list<Op> = []
  for op in ir.ops(producer_body) {
    let inputs = ir.args(op)
    if syntax_op(m, op, "operator []=") && len(inputs) >= 3 &&
       inputs[0] == producer_args[producer_axes] {
      stores += [op]
    }
  }
  if len(stores) != 1 {
    return "requires one pointwise producer store"
  }
  if !same_iteration(
       m, producer, producer_args[producer_axes],
       subscripts(stores[0], true), consumer
     ) {
    return "requires equal or densely flattened iteration spaces"
  }
  let producer_ops = ir.ops(producer_body)
  let consumer_ops = ir.ops(consumer_body)
  if len(producer_ops) < 2 || len(consumer_ops) < 1 ||
     producer_ops[len(producer_ops) - 2] != stores[0] {
    return "requires a final producer store"
  }
  let producer_yield = producer_ops[len(producer_ops) - 1]
  let consumer_yield = consumer_ops[len(consumer_ops) - 1]
  if ir.kind(producer_yield) != "yield" ||
     ir.kind(consumer_yield) != "yield" ||
     ir.args(producer_yield) != ir.outs(stores[0]) {
    return "requires the producer store to reach its yield"
  }
  if !captured(consumer, producer_outputs[0]) ||
     !pointwise_at(
       m, consumer, consumer, producer_outputs[0], producer,
       producer_args[producer_axes], subscripts(stores[0], true)
     ) {
    return "requires pointwise consumer reads"
  }

  for user in ir.users(producer_outputs[0]) {
    if contains(consumer, user) {
      if ir.blk(user) != consumer_body ||
         !load_at(
           m, consumer, user, producer_outputs[0], producer,
           producer_args[producer_axes], subscripts(stores[0], true)
         ) {
        return "requires direct pointwise consumer reads"
      }
    }
  }
  let consumer_init = ir.def(consumer_inputs[consumer_axes])
  var consumer_ranges: list<Op> = []
  for axis in 0..consumer_axes {
    consumer_ranges += [ir.def(consumer_inputs[axis])]
  }
  var between = false
  for op in ir.ops(ir.blk(producer)) {
    if op == producer {
      between = true
    } else {
      if op == consumer {
        between = false
      } else {
        if between {
          var range = false
          for candidate in consumer_ranges {
            if op == candidate {
              range = true
            }
          }
          if !range && ir.kind(op) != "constant" && !constructor(op) &&
             !base_op(m, op, "list") && op != consumer_init {
              return "cannot cross non-setup operation: " + ir.kind(op) +
                     " " + ir.callee(op)
          }
        }
      }
    }
  }
  return ""
}

fn can_fuse(m: Mod, producer: Op, consumer: Op) -> bool {
  let before = ir.revision(m)
  let legal = fuse_issue(m, producer, consumer) == ""
  assert(ir.revision(m) == before,
         "tile.can_fuse changed the module")
  return legal
}

fn fusible(m: Mod) -> list<list<Op>> {
  let before = ir.revision(m)
  let ops = ir.ops(m)
  var out: list<list<Op>> = []
  for i in 0..len(ops) {
    if ir.live(ops[i]) && ir.kind(ops[i]) == "loop" {
      var next_loop = false
      for j in i + 1..len(ops) {
        if !next_loop && ir.live(ops[j]) &&
           ir.kind(ops[j]) == "loop" &&
           ir.blk(ops[i]) == ir.blk(ops[j]) {
          next_loop = true
          if can_fuse(m, ops[i], ops[j]) {
            out += [[ops[i], ops[j]]]
          }
        }
      }
    }
  }
  assert(ir.revision(m) == before,
         "tile.fusible changed the module")
  return out
}

fn fuse(m: Mod, producer: Op, consumer: Op) -> Op {
  let issue = fuse_issue(m, producer, consumer)
  assert(issue == "", "tile.fuse " + issue)

  let producer_inputs = ir.args(producer)
  let consumer_inputs = ir.args(consumer)
  let producer_outputs = ir.outs(producer)
  let consumer_outputs = ir.outs(consumer)
  let producer_body = ir.blks(producer)[0]
  let consumer_body = ir.blks(consumer)[0]
  let producer_args = ir.args(producer_body)
  let consumer_args = ir.args(consumer_body)
  let producer_axes = len(producer_inputs) - len(producer_outputs)
  let consumer_axes = len(consumer_inputs) - len(consumer_outputs)
  let producer_ops = ir.ops(producer_body)
  let consumer_ops = ir.ops(consumer_body)
  let consumer_yield = consumer_ops[len(consumer_ops) - 1]
  var stores: list<Op> = []
  for op in producer_ops {
    let inputs = ir.args(op)
    if syntax_op(m, op, "operator []=") && len(inputs) >= 3 &&
       inputs[0] == producer_args[producer_axes] {
      stores += [op]
    }
  }
  var private = true
  for user in ir.users(producer_outputs[0]) {
    if !contains(consumer, user) {
      private = false
    }
  }
  var store_only = true
  var initial_loads: list<Op> = []
  let store_indices = subscripts(stores[0], true)
  let producer_form = address_form(
    m, producer, producer_args[producer_axes], store_indices
  )
  for op in producer_ops {
    if load_at(
         m, producer, op, producer_args[producer_axes], producer,
         producer_args[producer_axes], store_indices
       ) {
      initial_loads += [op]
    }
  }
  for user in ir.users(producer_args[producer_axes]) {
    var initial_load = false
    for load in initial_loads {
      if user == load {
        initial_load = true
      }
    }
    if user != stores[0] && !initial_load {
      store_only = false
    }
  }
  let producer_init = ir.def(producer_inputs[producer_axes])
  var private_init = ir.live(producer_init)
  if private_init {
    for user in ir.users(producer_inputs[producer_axes]) {
      if user != producer {
        private_init = false
      }
    }
  }
  var direct_init = len(initial_loads) == 0
  if len(initial_loads) == 1 && constructor(producer_init) &&
     len(ir.args(producer_init)) == 1 &&
     len(ir.outs(initial_loads[0])) == 1 &&
     ir.type(ir.args(producer_init)[0]) == ir.type(ir.outs(initial_loads[0])[0]) {
    direct_init = true
  }
  let forward = private && store_only && private_init && direct_init
  var private_ranges: list<Op> = []
  for axis in 0..consumer_axes {
    let consumer_range = ir.def(consumer_inputs[axis])
    var private_range = ir.live(consumer_range) &&
                        consumer_range != ir.def(producer_inputs[axis])
    if private_range {
      for user in ir.users(consumer_inputs[axis]) {
        if user != consumer {
          private_range = false
        }
      }
    }
    if private_range {
      private_ranges += [consumer_range]
    }
  }

  var carried: list<Val> = [consumer_inputs[consumer_axes]]
  if !forward {
    carried = [producer_inputs[producer_axes],
               consumer_inputs[consumer_axes]]
  }
  var names: list<str> = []
  var ranges: list<Val> = []
  for axis in 0..producer_axes {
    names += [ir.name(producer_args[axis])]
    ranges += [producer_inputs[axis]]
  }
  let merged = ir.loop(m, consumer, names, ranges, carried)
  assert(ir.live(merged), "tile.fuse could not build the merged loop")
  let merged_body = ir.blks(merged)[0]
  let merged_args = ir.args(merged_body)
  let merged_ops = ir.ops(merged_body)
  let merged_yield = merged_ops[len(merged_ops) - 1]

  var old: list<Val> = []
  var next: list<Val> = []
  for axis in 0..producer_axes {
    old += [producer_args[axis]]
    next += [merged_args[axis]]
  }
  var consumer_carried = merged_args[producer_axes]
  if !forward {
    old += [producer_args[producer_axes]]
    next += [merged_args[producer_axes]]
    consumer_carried = merged_args[producer_axes + 1]
  }
  for i in 0..len(producer_ops) - 2 {
    if forward && len(initial_loads) == 1 &&
       producer_ops[i] == initial_loads[0] {
      let seed_op = ir.clone(
        m, producer_ops[i], merged_yield,
        old + [producer_args[producer_axes]],
        next + [producer_inputs[producer_axes]]
      )
      assert(ir.live(seed_op) && len(ir.outs(seed_op)) == 1,
             "tile.fuse could not clone a scalar initializer")
      assert(ir.retarget(
               m, seed_op, base_fn("copy", 1),
               [ir.args(producer_init)[0]]
             ),
             "tile.fuse could not materialize a scalar initializer")
      old += ir.outs(producer_ops[i])
      next += ir.outs(seed_op)
    } else {
      let copy = ir.clone(m, producer_ops[i], merged_yield, old, next)
      assert(ir.live(copy), "tile.fuse could not clone producer operation " +
             text(i) + " " + ir.kind(producer_ops[i]) + " " +
             ir.callee(producer_ops[i]))
      old += ir.outs(producer_ops[i])
      next += ir.outs(copy)
    }
  }
  let store_inputs = ir.args(stores[0])
  let scalar = mapped(store_inputs[len(store_inputs) - 1], old, next)
  let scalar_op = ir.def(scalar)
  if ir.name(scalar) == "" && ir.live(scalar_op) &&
     ir.blk(scalar_op) == merged_body {
    assert(ir.rename(m, scalar, "fuse_value_" + text(ir.key(scalar))),
           "tile.fuse could not retain the forwarded scalar")
  }
  var produced: list<Val> = []
  if !forward {
    let store = ir.clone(m, stores[0], merged_yield, old, next)
    assert(ir.live(store), "tile.fuse could not clone the producer store")
    produced = ir.outs(store)
    assert(len(produced) == 1,
           "tile.fuse found an invalid producer store")
    old += ir.outs(stores[0])
    next += produced
  }
  if producer_axes == consumer_axes {
    for axis in 0..consumer_axes {
      old += [consumer_args[axis]]
      next += [merged_args[axis]]
    }
  } else {
    var axes: list<Val> = []
    for axis in 0..producer_axes {
      axes += [merged_args[axis]]
    }
    let coordinate = affine_value(
      m, merged_yield, ir.type(consumer_args[0]),
      producer_form, axes
    )
    old += [consumer_args[0]]
    next += [coordinate]
  }
  old += [consumer_args[consumer_axes]]
  next += [consumer_carried]

  for i in 0..len(consumer_ops) - 1 {
    if load_at(
         m, consumer, consumer_ops[i], producer_outputs[0], producer,
         producer_args[producer_axes], subscripts(stores[0], true)
       ) {
      let outputs = ir.outs(consumer_ops[i])
      assert(len(outputs) == 1,
             "tile.fuse found an invalid pointwise load")
      old += outputs
      next += [scalar]
    } else {
      let copy = ir.clone(m, consumer_ops[i], merged_yield, old, next)
      assert(ir.live(copy), "tile.fuse could not clone consumer operation " +
             text(i) + " " + ir.kind(consumer_ops[i]) + " " +
             ir.callee(consumer_ops[i]))
      old += ir.outs(consumer_ops[i])
      next += ir.outs(copy)
    }
  }
  let consumed = mapped(ir.args(consumer_yield), old, next)
  assert(len(consumed) == 1,
         "tile.fuse found an invalid consumer yield")
  if forward {
    assert(ir.args(m, merged_yield, consumed),
           "tile.fuse could not connect the forwarded loop")
    assert(ir.replace(m, consumer_outputs[0], ir.outs(merged)[0]),
           "tile.fuse could not replace the consumer result")
  } else {
    assert(ir.args(m, merged_yield, [produced[0], consumed[0]]),
           "tile.fuse could not connect the merged loop")
    assert(ir.replace(
             m, [producer_outputs[0], consumer_outputs[0]], ir.outs(merged)
           ),
           "tile.fuse could not replace the original loop results")
  }
  var erased: list<Op> = [consumer, producer]
  if forward {
    erased += [producer_init]
  }
  for range in private_ranges {
    erased += [range]
  }
  assert(ir.erase(m, erased),
         "tile.fuse could not erase the original structure")
  return merged
}

local fn fuse_all(
  m: Mod, policies: list<Fn>, arg: Attr, configured: bool
) -> bool {
  assert(len(policies) <= 1,
         "tile.fuse accepts at most one profitability policy")
  var limit = 0
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      limit += 1
    }
  }
  var changed = false
  var again = true
  for round in 0..limit {
    if again {
      again = false
      for pair in fusible(m) {
        if len(pair) == 2 && ir.live(pair[0]) && ir.live(pair[1]) {
          var profitable = true
          if len(policies) == 1 {
            let before = ir.revision(m)
            if configured {
              profitable = ir.invoke<bool>(m, pair, policies[0], arg)
            } else {
              profitable = ir.invoke<bool>(m, pair, policies[0])
            }
            assert(ir.revision(m) == before,
                   "tile.fuse policy must not mutate the module")
          }
          if profitable {
            assert(ir.live(fuse(m, pair[0], pair[1])),
                   "tile.fuse could not apply a valid candidate")
            changed = true
            again = true
          }
        }
      }
    }
  }
  if changed {
    opt.dce(m, [])
  }
  return changed
}

fn fuse(m: Mod) -> bool {
  return fuse_all(m, [], nil, false)
}

fn fuse(m: Mod, policy: Fn) -> bool {
  assert(ir.live(policy), "tile.fuse requires a valid policy")
  return fuse_all(m, [policy], nil, false)
}

fn fuse(m: Mod, policy: Fn, arg: Attr) -> bool {
  assert(ir.live(policy), "tile.fuse requires a valid policy")
  return fuse_all(m, [policy], arg, true)
}
