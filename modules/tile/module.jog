module tile
use base
use ir
use opt

local fn mapped(value: Val, old: list<Val>, next: list<Val>) -> Val {
  for i in 0..len(old) {
    if value == old[i] {
      return next[i]
    }
  }
  return value
}

local fn mapped(values: list<Val>, old: list<Val>, next: list<Val>)
    -> list<Val> {
  var out: list<Val> = []
  for value in values {
    out += [mapped(value, old, next)]
  }
  return out
}

local fn same_value(left: Val, right: Val) -> bool {
  if left == right {
    return true
  }
  return ir.type(left) == ir.type(right) &&
         ir.is_const(left) && ir.is_const(right) &&
         ir.constant(left) == ir.constant(right)
}

local fn same_range(left: Val, right: Val) -> bool {
  if left == right {
    return true
  }
  let left_op = ir.def(left)
  let right_op = ir.def(right)
  if !ir.live(left_op) || !ir.live(right_op) ||
     ir.callee(left_op) != "operator .." ||
     ir.callee(right_op) != "operator .." {
    return false
  }
  let a = ir.args(left_op)
  let b = ir.args(right_op)
  return len(a) == 2 && len(b) == 2 &&
         same_value(a[0], b[0]) && same_value(a[1], b[1])
}

local fn captured(op: Op, value: Val) -> bool {
  for input in ir.args(op) {
    if input == value {
      return true
    }
  }
  for body in ir.blks(op) {
    for child in ir.ops(body) {
      if captured(child, value) {
        return true
      }
    }
  }
  return false
}

local fn contains(root: Op, selected: Op) -> bool {
  if root == selected {
    return true
  }
  for body in ir.blks(root) {
    for child in ir.ops(body) {
      if contains(child, selected) {
        return true
      }
    }
  }
  return false
}

local fn load(op: Op, tensor: Val, index: Val) -> bool {
  let inputs = ir.args(op)
  return ir.kind(op) == "call" && ir.callee(op) == "operator []" &&
         len(inputs) == 2 && inputs[0] == tensor && inputs[1] == index
}

local fn constructor(op: Op) -> bool {
  let outputs = ir.outs(op)
  return ir.kind(op) == "call" && len(outputs) == 1 &&
         ir.callee(op) == text(ir.type(outputs[0]))
}

local fn pointwise(op: Op, tensor: Val, index: Val) -> bool {
  var touches = false
  for input in ir.args(op) {
    if input == tensor {
      touches = true
    }
  }
  if touches {
    return load(op, tensor, index)
  }
  for body in ir.blks(op) {
    for child in ir.ops(body) {
      if !pointwise(child, tensor, index) {
        return false
      }
    }
  }
  return true
}

local fn keep(m: Mod, value: Val, stem: str) -> Val {
  assert(ir.live(value), "tile: cannot retain an invalid value")
  assert(ir.rename(m, value, stem + "_" + text(ir.key(value))),
         "tile: cannot name a generated value")
  return value
}

local fn known(value: Val, values: list<Val>) -> bool {
  for candidate in values {
    if candidate == value {
      return true
    }
  }
  return false
}

local fn depends_in(value: Val, source: Val, seen: list<Val>) -> bool {
  if value == source {
    return true
  }
  if known(value, seen) {
    return false
  }
  let next = seen + [value]
  let op = ir.def(value)
  if !ir.live(op) {
    return false
  }
  for input in ir.args(op) {
    if depends_in(input, source, next) {
      return true
    }
  }
  for body in ir.blks(op) {
    for child in ir.ops(body) {
      for input in ir.args(child) {
        if depends_in(input, source, next) {
          return true
        }
      }
      for output in ir.outs(child) {
        if depends_in(output, source, next) {
          return true
        }
      }
    }
  }
  return false
}

fn depends(value: Val, source: Val) -> bool {
  assert(ir.live(value) && ir.live(source),
         "tile.depends requires live values")
  return depends_in(value, source, [])
}

fn axes(loop: Op, value: Val) -> list<int> {
  assert(ir.live(loop) && ir.kind(loop) == "loop" && ir.live(value),
         "tile.axes requires a live loop and value")
  let bodies = ir.blks(loop)
  let inputs = ir.args(loop)
  let outputs = ir.outs(loop)
  assert(len(bodies) == 1 && len(inputs) > len(outputs),
         "tile.axes requires a structured loop")
  let body_args = ir.args(bodies[0])
  let count = len(inputs) - len(outputs)
  assert(len(body_args) == len(inputs),
         "tile.axes found an invalid loop signature")
  var out: list<int> = []
  for i in 0..count {
    if depends(value, body_args[i]) {
      out += [i]
    }
  }
  return out
}

fn split_issue(source: Op, factor: int) -> str {
  if factor <= 0 {
    return "requires a positive factor"
  }
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(inputs) <= len(outputs) {
    return "requires a structured range loop"
  }
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)
  if axes <= 0 || len(body_args) != axes + len(outputs) {
    return "found an invalid loop signature"
  }
  let axis = axes - 1
  let range_op = ir.def(inputs[axis])
  if !ir.live(range_op) || ir.callee(range_op) != "operator .." {
    return "requires the last iterator to use a range"
  }
  let bounds = ir.args(range_op)
  if len(bounds) != 2 || ir.type(bounds[0]) != ir.type(bounds[1]) {
    return "requires matching range bounds"
  }
  if ir.type(body_args[axis]) != ty("index") {
    return "requires an index iterator"
  }
  let ops = ir.ops(body)
  if len(ops) == 0 || ir.kind(ops[len(ops) - 1]) != "yield" {
    return "requires a terminated loop body"
  }
  return ""
}

fn can_split(m: Mod, source: Op, factor: int) -> bool {
  let before = ir.revision(m)
  let legal = factor > 1 && split_issue(source, factor) == ""
  assert(ir.revision(m) == before,
         "tile.can_split changed the module")
  return legal
}

fn splittable(m: Mod, factor: int) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_split(m, op, factor) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.splittable changed the module")
  return out
}

fn split(m: Mod, source: Op, factor: int) -> bool {
  let issue = split_issue(source, factor)
  assert(issue == "", "tile.split " + issue)
  if factor == 1 {
    return false
  }

  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)

  let axis = axes - 1
  let range = inputs[axis]
  let range_op = ir.def(range)
  let bounds = ir.args(range_op)

  let type = ty("index")
  var lower = bounds[0]
  var upper = bounds[1]
  if ir.type(lower) != type {
    lower = keep(
      m, ir.call(m, source, text(type), [lower], type), "tile_begin"
    )
    upper = keep(
      m, ir.call(m, source, text(type), [upper], type), "tile_end"
    )
  }
  let zero = keep(m, ir.constant(m, source, 0, type), "tile_zero")
  let one = keep(m, ir.constant(m, source, 1, type), "tile_one")
  let width = keep(
    m, ir.call(m, source, "operator -", [upper, lower], type),
    "tile_width"
  )
  let factor_value = keep(
    m, ir.constant(m, source, factor, type), "tile_factor"
  )
  let factor_less_one = keep(
    m, ir.call(m, source, "operator -", [factor_value, one], type),
    "tile_tail"
  )
  let padded = keep(
    m, ir.call(m, source, "operator +", [width, factor_less_one], type),
    "tile_padded"
  )
  let blocks = keep(
    m, ir.call(m, source, "operator /", [padded, factor_value], type),
    "tile_blocks"
  )
  let outer_range = ir.call(
    m, source, "operator ..", [zero, blocks], ir.type(range)
  )

  var outer_sources: list<Val> = []
  var outer_names: list<str> = []
  for i in 0..axes {
    if i == axis {
      outer_sources += [outer_range]
      outer_names += [ir.name(body_args[i]) + "_tile"]
    } else {
      outer_sources += [inputs[i]]
      outer_names += [ir.name(body_args[i])]
    }
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }

  let outer = ir.loop(m, source, outer_names, outer_sources, carried)
  assert(ir.live(outer), "tile.split could not build the outer loop")
  let outer_body = ir.blks(outer)[0]
  let outer_args = ir.args(outer_body)
  let outer_ops = ir.ops(outer_body)
  let outer_yield = outer_ops[len(outer_ops) - 1]

  let scaled = keep(
    m,
    ir.call(
      m, outer_yield, "operator *", [outer_args[axis], factor_value], type
    ),
    "tile_scaled"
  )
  let base = keep(
    m, ir.call(m, outer_yield, "operator +", [lower, scaled], type),
    "tile_base"
  )
  let inner_range = ir.call(
    m, outer_yield, "operator ..", [zero, factor_value], ir.type(range)
  )
  var inner_carried: list<Val> = []
  for i in axes..len(outer_args) {
    inner_carried += [outer_args[i]]
  }
  let inner = ir.loop(
    m, outer_yield, [ir.name(body_args[axis])],
    [inner_range], inner_carried
  )
  assert(ir.live(inner), "tile.split could not build the inner loop")
  let inner_body = ir.blks(inner)[0]
  let inner_args = ir.args(inner_body)
  let inner_ops = ir.ops(inner_body)
  let inner_yield = inner_ops[len(inner_ops) - 1]
  let index = keep(
    m, ir.call(m, inner_yield, "operator +", [base, inner_args[0]], type),
    "tile_index"
  )
  let inside = keep(
    m, ir.call(
      m, inner_yield, "operator <", [index, upper], ty("bool")
    ),
    "tile_inside"
  )
  var guarded_carried: list<Val> = []
  for i in 1..len(inner_args) {
    guarded_carried += [inner_args[i]]
  }
  let guard = ir.branch(m, inner_yield, inside, guarded_carried)
  assert(ir.live(guard), "tile.split could not build the tail guard")
  let then_body = ir.blks(guard)[0]
  let then_args = ir.args(then_body)
  let then_ops = ir.ops(then_body)
  let then_yield = then_ops[len(then_ops) - 1]

  var old: list<Val> = []
  var next: list<Val> = []
  for i in 0..axes {
    old += [body_args[i]]
    if i == axis {
      next += [index]
    } else {
      next += [outer_args[i]]
    }
  }
  for i in 0..len(outputs) {
    old += [body_args[axes + i]]
    next += [then_args[i]]
  }

  let original_ops = ir.ops(body)
  for i in 0..len(original_ops) - 1 {
    let copy = ir.clone(m, original_ops[i], then_yield, old, next)
    assert(ir.live(copy), "tile.split could not clone the loop body")
    let old_outputs = ir.outs(original_ops[i])
    let new_outputs = ir.outs(copy)
    assert(len(old_outputs) == len(new_outputs),
           "tile.split cloned an inconsistent operation")
    old += old_outputs
    next += new_outputs
  }

  let original_yield = original_ops[len(original_ops) - 1]
  assert(ir.args(m, then_yield, mapped(ir.args(original_yield), old, next)),
         "tile.split could not connect the guarded body")
  assert(ir.args(m, inner_yield, ir.outs(guard)),
         "tile.split could not connect the inner loop")
  assert(ir.args(m, outer_yield, ir.outs(inner)),
         "tile.split could not connect the outer loop")
  if len(outputs) != 0 {
    assert(ir.replace(m, outputs, ir.outs(outer)),
           "tile.split could not replace the original loop results")
  }
  assert(ir.erase(m, source),
         "tile.split could not erase the original loop")
  return true
}

fn unroll_issue(source: Op, factor: int) -> str {
  if factor <= 0 {
    return "requires a positive factor"
  }
  if !ir.live(source) || ir.kind(source) != "loop" {
    return "requires a live loop"
  }
  if factor == 1 {
    return ""
  }
  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  if len(bodies) != 1 || len(inputs) <= len(outputs) {
    return "requires a structured range loop"
  }
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)
  if axes <= 0 || len(body_args) != axes + len(outputs) {
    return "found an invalid loop signature"
  }
  let axis = axes - 1
  if ir.type(body_args[axis]) != ty("index") {
    return "requires an index iterator"
  }

  let range = inputs[axis]
  let range_op = ir.def(range)
  if !ir.live(range_op) || ir.callee(range_op) != "operator .." {
    return "requires the last iterator to use a range"
  }
  let bounds = ir.args(range_op)
  if len(bounds) != 2 || !ir.is_const(bounds[0]) ||
     !ir.is_const(bounds[1]) ||
     base.kind(ir.constant(bounds[0])) != "int" ||
     base.kind(ir.constant(bounds[1])) != "int" {
    return "requires static integer bounds"
  }
  let lower = base.int(ir.constant(bounds[0]))
  let upper = base.int(ir.constant(bounds[1]))
  var trip = 0
  if upper > lower {
    trip = upper - lower
  }
  if trip % factor != 0 {
    return "requires the trip count to be divisible by the factor"
  }
  return ""
}

fn can_unroll(m: Mod, source: Op, factor: int) -> bool {
  let before = ir.revision(m)
  let legal = factor > 1 && unroll_issue(source, factor) == ""
  assert(ir.revision(m) == before,
         "tile.can_unroll changed the module")
  return legal
}

fn unrollable(m: Mod, factor: int) -> list<Op> {
  let before = ir.revision(m)
  var out: list<Op> = []
  for op in ir.ops(m) {
    if can_unroll(m, op, factor) {
      out += [op]
    }
  }
  assert(ir.revision(m) == before,
         "tile.unrollable changed the module")
  return out
}

fn unroll(m: Mod, source: Op, factor: int) -> bool {
  let issue = unroll_issue(source, factor)
  assert(issue == "", "tile.unroll " + issue)
  if factor == 1 {
    return false
  }

  let bodies = ir.blks(source)
  let inputs = ir.args(source)
  let outputs = ir.outs(source)
  let body = bodies[0]
  let body_args = ir.args(body)
  let axes = len(inputs) - len(outputs)
  let axis = axes - 1
  let range = inputs[axis]
  let range_op = ir.def(range)
  let bounds = ir.args(range_op)
  let lower = base.int(ir.constant(bounds[0]))
  let upper = base.int(ir.constant(bounds[1]))
  var trip = 0
  if upper > lower {
    trip = upper - lower
  }
  var private_range = true
  for user in ir.users(range) {
    if user != source {
      private_range = false
    }
  }

  let type = ty("index")
  let zero = keep(m, ir.constant(m, source, 0, type), "unroll_zero")
  let blocks = keep(
    m, ir.constant(m, source, trip / factor, type), "unroll_blocks"
  )
  let outer_range = ir.call(
    m, source, "operator ..", [zero, blocks], ir.type(range)
  )
  var names: list<str> = []
  var sources: list<Val> = []
  for i in 0..axes {
    names += [ir.name(body_args[i])]
    if i == axis {
      sources += [outer_range]
    } else {
      sources += [inputs[i]]
    }
  }
  var carried: list<Val> = []
  for i in axes..len(inputs) {
    carried += [inputs[i]]
  }
  let outer = ir.loop(m, source, names, sources, carried)
  assert(ir.live(outer), "tile.unroll could not build the outer loop")
  let outer_body = ir.blks(outer)[0]
  let outer_args = ir.args(outer_body)
  let outer_ops = ir.ops(outer_body)
  let outer_yield = outer_ops[len(outer_ops) - 1]

  let width = keep(
    m, ir.constant(m, outer_yield, factor, type), "unroll_factor"
  )
  let begin = keep(
    m, ir.constant(m, outer_yield, lower, type), "unroll_begin"
  )
  let scaled = keep(
    m,
    ir.call(m, outer_yield, "operator *", [outer_args[axis], width], type),
    "unroll_scaled"
  )
  let base_index = keep(
    m, ir.call(m, outer_yield, "operator +", [begin, scaled], type),
    "unroll_base"
  )

  let original_ops = ir.ops(body)
  assert(len(original_ops) > 0 &&
         ir.kind(original_ops[len(original_ops) - 1]) == "yield",
         "tile.unroll requires a terminated loop body")
  let original_yield = original_ops[len(original_ops) - 1]
  var current: list<Val> = []
  for i in axes..len(outer_args) {
    current += [outer_args[i]]
  }
  for point in 0..factor {
    var index = base_index
    if point != 0 {
      let offset = keep(
        m, ir.constant(m, outer_yield, point, type), "unroll_offset"
      )
      index = keep(
        m, ir.call(m, outer_yield, "operator +", [base_index, offset], type),
        "unroll_index"
      )
    }
    var old: list<Val> = []
    var next: list<Val> = []
    for i in 0..axes {
      old += [body_args[i]]
      if i == axis {
        next += [index]
      } else {
        next += [outer_args[i]]
      }
    }
    for i in 0..len(outputs) {
      old += [body_args[axes + i]]
      next += [current[i]]
    }
    for i in 0..len(original_ops) - 1 {
      let copy = ir.clone(m, original_ops[i], outer_yield, old, next)
      assert(ir.live(copy), "tile.unroll could not clone the loop body")
      old += ir.outs(original_ops[i])
      next += ir.outs(copy)
    }
    current = mapped(ir.args(original_yield), old, next)
    assert(len(current) == len(outputs),
           "tile.unroll found an invalid loop yield")
  }

  assert(ir.args(m, outer_yield, current),
         "tile.unroll could not connect the outer loop")
  if len(outputs) != 0 {
    assert(ir.replace(m, outputs, ir.outs(outer)),
           "tile.unroll could not replace the original loop results")
  }
  var erased: list<Op> = [source]
  if private_range {
    erased += [range_op]
  }
  assert(ir.erase(m, erased),
         "tile.unroll could not erase the original loop")
  opt.dce(m, [])
  return true
}

local fn unroll_all(
  m: Mod, policy: Fn, arg: Attr, configured: bool
) -> bool {
  assert(ir.live(policy), "tile.unroll requires a valid policy")
  let candidates = ir.ops(m)
  var changed = false
  for reverse in 0..len(candidates) {
    let op = candidates[len(candidates) - reverse - 1]
    if ir.live(op) && ir.kind(op) == "loop" {
      let before = ir.revision(m)
      var factor = 1
      if configured {
        factor = ir.invoke<int>(m, op, policy, arg)
      } else {
        factor = ir.invoke<int>(m, op, policy)
      }
      assert(ir.revision(m) == before,
             "tile.unroll policy changed the module")
      if factor > 1 {
        let issue = unroll_issue(op, factor)
        assert(issue == "",
               "tile.unroll policy selected an illegal factor: " + issue)
        changed = unroll(m, op, factor) || changed
      }
    }
  }
  return changed
}

fn unroll(m: Mod, policy: Fn) -> bool {
  return unroll_all(m, policy, nil, false)
}

fn unroll(m: Mod, policy: Fn, arg: Attr) -> bool {
  return unroll_all(m, policy, arg, true)
}

fn fuse_issue(producer: Op, consumer: Op) -> str {
  if !ir.live(producer) || !ir.live(consumer) ||
     ir.kind(producer) != "loop" || ir.kind(consumer) != "loop" ||
     producer == consumer || ir.blk(producer) != ir.blk(consumer) {
    return "requires two distinct loops in one block"
  }
  var ordered = false
  var found = false
  for op in ir.ops(ir.blk(producer)) {
    if op == producer {
      ordered = true
    }
    if op == consumer {
      found = true
      if !ordered {
        return "requires producer before consumer"
      }
    }
  }
  if !found {
    return "requires producer before consumer"
  }

  let producer_inputs = ir.args(producer)
  let consumer_inputs = ir.args(consumer)
  let producer_outputs = ir.outs(producer)
  let consumer_outputs = ir.outs(consumer)
  let producer_bodies = ir.blks(producer)
  let consumer_bodies = ir.blks(consumer)
  if len(producer_outputs) != 1 || len(consumer_outputs) != 1 ||
     len(producer_bodies) != 1 || len(consumer_bodies) != 1 {
    return "currently requires one carried tensor per loop"
  }
  if len(producer_inputs) != 2 || len(consumer_inputs) != 2 {
    return "currently requires one iterator per loop"
  }
  if !same_range(producer_inputs[0], consumer_inputs[0]) {
    return "requires equal iteration ranges"
  }
  if ir.type(producer_outputs[0]) != ir.type(producer_inputs[1]) ||
     ir.type(consumer_outputs[0]) != ir.type(consumer_inputs[1]) ||
     producer_outputs[0] == consumer_inputs[1] {
    return "requires distinct, type-stable carried tensors"
  }

  let producer_body = producer_bodies[0]
  let consumer_body = consumer_bodies[0]
  let producer_args = ir.args(producer_body)
  let consumer_args = ir.args(consumer_body)
  if len(producer_args) != 2 || len(consumer_args) != 2 ||
     ir.type(producer_args[0]) != ir.type(consumer_args[0]) {
    return "found incompatible loop bodies"
  }

  var stores: list<Op> = []
  for op in ir.ops(producer_body) {
    let inputs = ir.args(op)
    if ir.callee(op) == "operator []=" && len(inputs) == 3 &&
       inputs[0] == producer_args[1] && inputs[1] == producer_args[0] {
      stores += [op]
    }
  }
  if len(stores) != 1 {
    return "requires one pointwise producer store"
  }
  let producer_ops = ir.ops(producer_body)
  let consumer_ops = ir.ops(consumer_body)
  if len(producer_ops) < 2 || len(consumer_ops) < 1 ||
     producer_ops[len(producer_ops) - 2] != stores[0] {
    return "requires a final producer store"
  }
  let producer_yield = producer_ops[len(producer_ops) - 1]
  let consumer_yield = consumer_ops[len(consumer_ops) - 1]
  if ir.kind(producer_yield) != "yield" ||
     ir.kind(consumer_yield) != "yield" ||
     ir.args(producer_yield) != ir.outs(stores[0]) {
    return "requires the producer store to reach its yield"
  }
  if !captured(consumer, producer_outputs[0]) ||
     !pointwise(consumer, producer_outputs[0], consumer_args[0]) {
    return "requires pointwise consumer reads"
  }

  for user in ir.users(producer_outputs[0]) {
    if contains(consumer, user) {
      if ir.blk(user) != consumer_body ||
         !load(user, producer_outputs[0], consumer_args[0]) {
        return "requires direct pointwise consumer reads"
      }
    }
  }
  let consumer_init = ir.def(consumer_inputs[1])
  let consumer_range = ir.def(consumer_inputs[0])
  var between = false
  for op in ir.ops(ir.blk(producer)) {
    if op == producer {
      between = true
    } else {
      if op == consumer {
        between = false
      } else {
        if between {
          if ir.kind(op) != "constant" && !constructor(op) &&
             ir.callee(op) != "base.list" && op != consumer_init &&
             op != consumer_range {
            return "cannot cross non-setup operation: " + ir.kind(op) +
                   " " + ir.callee(op)
          }
        }
      }
    }
  }
  return ""
}

fn can_fuse(m: Mod, producer: Op, consumer: Op) -> bool {
  let before = ir.revision(m)
  let legal = fuse_issue(producer, consumer) == ""
  assert(ir.revision(m) == before,
         "tile.can_fuse changed the module")
  return legal
}

fn fusible(m: Mod) -> list<list<Op>> {
  let before = ir.revision(m)
  let ops = ir.ops(m)
  var out: list<list<Op>> = []
  for i in 0..len(ops) {
    if ir.live(ops[i]) && ir.kind(ops[i]) == "loop" {
      var next_loop = false
      for j in i + 1..len(ops) {
        if !next_loop && ir.live(ops[j]) &&
           ir.kind(ops[j]) == "loop" &&
           ir.blk(ops[i]) == ir.blk(ops[j]) {
          next_loop = true
          if can_fuse(m, ops[i], ops[j]) {
            out += [[ops[i], ops[j]]]
          }
        }
      }
    }
  }
  assert(ir.revision(m) == before,
         "tile.fusible changed the module")
  return out
}

fn fuse(m: Mod, producer: Op, consumer: Op) -> bool {
  let issue = fuse_issue(producer, consumer)
  assert(issue == "", "tile.fuse " + issue)

  let producer_inputs = ir.args(producer)
  let consumer_inputs = ir.args(consumer)
  let producer_outputs = ir.outs(producer)
  let consumer_outputs = ir.outs(consumer)
  let producer_body = ir.blks(producer)[0]
  let consumer_body = ir.blks(consumer)[0]
  let producer_args = ir.args(producer_body)
  let consumer_args = ir.args(consumer_body)
  let producer_ops = ir.ops(producer_body)
  let consumer_ops = ir.ops(consumer_body)
  let consumer_yield = consumer_ops[len(consumer_ops) - 1]
  var stores: list<Op> = []
  for op in producer_ops {
    let inputs = ir.args(op)
    if ir.callee(op) == "operator []=" && len(inputs) == 3 &&
       inputs[0] == producer_args[1] && inputs[1] == producer_args[0] {
      stores += [op]
    }
  }
  var private = true
  for user in ir.users(producer_outputs[0]) {
    if !contains(consumer, user) {
      private = false
    }
  }
  var store_only = true
  for user in ir.users(producer_args[1]) {
    if user != stores[0] {
      store_only = false
    }
  }
  let producer_init = ir.def(producer_inputs[1])
  let consumer_range = ir.def(consumer_inputs[0])
  var private_init = ir.live(producer_init)
  if private_init {
    for user in ir.users(producer_inputs[1]) {
      if user != producer {
        private_init = false
      }
    }
  }
  let forward = private && store_only && private_init
  var private_range = ir.live(consumer_range) &&
                      consumer_range != ir.def(producer_inputs[0])
  if private_range {
    for user in ir.users(consumer_inputs[0]) {
      if user != consumer {
        private_range = false
      }
    }
  }

  var carried: list<Val> = [consumer_inputs[1]]
  if !forward {
    carried = [producer_inputs[1], consumer_inputs[1]]
  }
  let merged = ir.loop(m, consumer, [ir.name(producer_args[0])],
                       [producer_inputs[0]], carried)
  assert(ir.live(merged), "tile.fuse could not build the merged loop")
  let merged_body = ir.blks(merged)[0]
  let merged_args = ir.args(merged_body)
  let merged_ops = ir.ops(merged_body)
  let merged_yield = merged_ops[len(merged_ops) - 1]

  var old: list<Val> = [producer_args[0]]
  var next: list<Val> = [merged_args[0]]
  var consumer_carried = merged_args[1]
  if !forward {
    old += [producer_args[1]]
    next += [merged_args[1]]
    consumer_carried = merged_args[2]
  }
  for i in 0..len(producer_ops) - 2 {
    let copy = ir.clone(m, producer_ops[i], merged_yield, old, next)
    assert(ir.live(copy), "tile.fuse could not clone producer operation " +
           text(i) + " " + ir.kind(producer_ops[i]) + " " +
           ir.callee(producer_ops[i]))
    old += ir.outs(producer_ops[i])
    next += ir.outs(copy)
  }
  let store_inputs = ir.args(stores[0])
  let scalar = mapped(store_inputs[2], old, next)
  let scalar_op = ir.def(scalar)
  if ir.name(scalar) == "" && ir.live(scalar_op) &&
     ir.blk(scalar_op) == merged_body {
    assert(ir.rename(m, scalar, "fuse_value_" + text(ir.key(scalar))),
           "tile.fuse could not retain the forwarded scalar")
  }
  var produced: list<Val> = []
  if !forward {
    let store = ir.clone(m, stores[0], merged_yield, old, next)
    assert(ir.live(store), "tile.fuse could not clone the producer store")
    produced = ir.outs(store)
    assert(len(produced) == 1,
           "tile.fuse found an invalid producer store")
    old += ir.outs(stores[0])
    next += produced
  }
  old += [consumer_args[0], consumer_args[1]]
  next += [merged_args[0], consumer_carried]

  for i in 0..len(consumer_ops) - 1 {
    if load(consumer_ops[i], producer_outputs[0], consumer_args[0]) {
      let outputs = ir.outs(consumer_ops[i])
      assert(len(outputs) == 1,
             "tile.fuse found an invalid pointwise load")
      old += outputs
      next += [scalar]
    } else {
      let copy = ir.clone(m, consumer_ops[i], merged_yield, old, next)
      assert(ir.live(copy), "tile.fuse could not clone consumer operation " +
             text(i) + " " + ir.kind(consumer_ops[i]) + " " +
             ir.callee(consumer_ops[i]))
      old += ir.outs(consumer_ops[i])
      next += ir.outs(copy)
    }
  }
  let consumed = mapped(ir.args(consumer_yield), old, next)
  assert(len(consumed) == 1,
         "tile.fuse found an invalid consumer yield")
  if forward {
    assert(ir.args(m, merged_yield, consumed),
           "tile.fuse could not connect the forwarded loop")
    assert(ir.replace(m, consumer_outputs[0], ir.outs(merged)[0]),
           "tile.fuse could not replace the consumer result")
  } else {
    assert(ir.args(m, merged_yield, [produced[0], consumed[0]]),
           "tile.fuse could not connect the merged loop")
    assert(ir.replace(
             m, [producer_outputs[0], consumer_outputs[0]], ir.outs(merged)
           ),
           "tile.fuse could not replace the original loop results")
  }
  var erased: list<Op> = [consumer, producer]
  if forward {
    erased += [producer_init]
  }
  if private_range {
    erased += [consumer_range]
  }
  assert(ir.erase(m, erased),
         "tile.fuse could not erase the original structure")
  return true
}

local fn fuse_all(
  m: Mod, policies: list<Fn>, arg: Attr, configured: bool
) -> bool {
  assert(len(policies) <= 1,
         "tile.fuse accepts at most one profitability policy")
  var limit = 0
  for op in ir.ops(m) {
    if ir.kind(op) == "loop" {
      limit += 1
    }
  }
  var changed = false
  var again = true
  for round in 0..limit {
    if again {
      again = false
      for pair in fusible(m) {
        if len(pair) == 2 && ir.live(pair[0]) && ir.live(pair[1]) {
          var profitable = true
          if len(policies) == 1 {
            let before = ir.revision(m)
            if configured {
              profitable = ir.invoke<bool>(m, pair, policies[0], arg)
            } else {
              profitable = ir.invoke<bool>(m, pair, policies[0])
            }
            assert(ir.revision(m) == before,
                   "tile.fuse policy must not mutate the module")
          }
          if profitable {
            assert(fuse(m, pair[0], pair[1]),
                   "tile.fuse could not apply a valid candidate")
            changed = true
            again = true
          }
        }
      }
    }
  }
  if changed {
    opt.dce(m, [])
  }
  return changed
}

fn fuse(m: Mod) -> bool {
  return fuse_all(m, [], nil, false)
}

fn fuse(m: Mod, policy: Fn) -> bool {
  assert(ir.live(policy), "tile.fuse requires a valid policy")
  return fuse_all(m, [policy], nil, false)
}

fn fuse(m: Mod, policy: Fn, arg: Attr) -> bool {
  assert(ir.live(policy), "tile.fuse requires a valid policy")
  return fuse_all(m, [policy], arg, true)
}
