local fn noalias_spec(fn: Fn, enabled: bool) -> dict {
  var out: dict = {}
  if ir.has(fn, "c") {
    let current = ir.meta(fn, "c")
    assert(base.kind(current) == "dict",
           "c: binding must be a dictionary")
    for key in base.keys(current) {
      if key != "noalias" {
        out[key] = base.get(current, key)
      }
    }
  }
  if enabled {
    out["noalias"] = true
  }
  return out
}

local fn restrict_spec(fn: Fn, enabled: bool) -> dict {
  var out: dict = {}
  if ir.has(fn, "c") {
    let current = ir.meta(fn, "c")
    assert(base.kind(current) == "dict",
           "c: binding must be a dictionary")
    for key in base.keys(current) {
      if key != "restrict" {
        out[key] = base.get(current, key)
      }
    }
  }
  if enabled {
    out["restrict"] = true
  }
  return out
}

local fn binding_spec(fn: Fn, name: str) -> dict {
  var out: dict = {}
  if ir.has(fn, "c") {
    let current = ir.meta(fn, "c")
    assert(base.kind(current) == "dict",
           "c: binding must be a dictionary")
    for key in base.keys(current) {
      if key != "name" {
        out[key] = base.get(current, key)
      }
    }
  }
  if name != "" {
    out["name"] = name
  }
  return out
}

local fn pointer_count(op: Op) -> int {
  var out = 0
  for value in ir.args(op) {
    if tensor.valid(ir.type(value)) {
      out += 1
    }
  }
  for value in ir.outs(op) {
    if tensor.valid(ir.type(value)) {
      out += 1
    }
  }
  return out
}

local fn fn_index(fns: list<Fn>, target: Fn) -> int {
  for i in 0..len(fns) {
    if fns[i] == target {
      return i
    }
  }
  return -1
}
