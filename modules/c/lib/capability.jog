local fn has_fn(values: list<Fn>, value: Fn) -> bool {
  for candidate in values {
    if candidate == value {
      return true
    }
  }
  return false
}

local fn has_name(values: list<str>, name: str) -> bool {
  for value in values {
    if value == name {
      return true
    }
  }
  return false
}

local fn data_functions(m: Mod) -> list<Fn> {
  let fns = ir.fns(m)
  var out: list<Fn> = []
  for fn in fns {
    for op in ir.ops(fn) {
      let outputs = ir.outs(op)
      if ir.kind(op) == "constant" && len(outputs) == 1 &&
         tensor.valid(ir.type(outputs[0])) && !has_fn(out, fn) {
        out += [fn]
      }
    }
  }
  var again = true
  for round in 0..len(fns) {
    if again {
      let before = len(out)
      var names: list<str> = []
      for target in out {
        names += [ir.name(target), ir.symbol(target)]
      }
      for fn in fns {
        if !has_fn(out, fn) {
          for op in ir.ops(fn) {
            if ir.kind(op) == "call" && has_name(names, ir.callee(op)) {
              let target = ir.resolve(m, op)
              if ir.owned(m, target) && has_fn(out, target) {
                out += [fn]
              }
            }
          }
        }
      }
      again = len(out) != before
    }
  }
  return out
}

local fn data_name(m: Mod, requested: str) -> str {
  let name = c_name(requested)
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      for param in ir.params(fn) {
        assert(val(param) != name,
               "c: external data name collides with parameter " + name)
      }
    }
  }
  return name
}

[memo]
local fn callable(m: Mod, fn: Fn, config: dict) -> bool {
  if !ir.live(fn) || len(ir.generics(fn)) != 0 {
    return false
  }
  for type in ir.returns(fn) {
    if !supported(type, config) {
      return false
    }
  }
  for param in ir.params(fn) {
    if !supported(ir.type(param), config) {
      return false
    }
  }
  return ir.owned(m, fn) || len(ir.blks(fn)) == 0
}

[memo]
local fn external_call(m: Mod, op: Op, config: dict) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  let name = call_name(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let fn = ir.resolve(m, op)
  if !ir.live(fn) || ir.owned(m, fn) || len(ir.blks(fn)) != 0 ||
     !ir.accepts(op, fn) {
    return false
  }
  if name == "base.list" || name == "operator .." ||
     name == "base.copy" || name == "base.assert" ||
     name == "operator []" ||
     name == "operator []=" ||
     ir.symbol(fn) == "tensor.make" ||
     ir.symbol(fn) == "tensor.view" ||
     ir.symbol(fn) == "tensor.dim" ||
     (len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
      ir.symbol(fn) == "tensor.tensor") ||
     (binary(name) != "" && len(inputs) == 2 && len(outputs) == 1) ||
     (unary(name) != "" && len(inputs) == 1 && len(outputs) == 1) ||
     (scalar_name(name, config) && len(inputs) == 1 && len(outputs) == 1) {
    return false
  }
  for value in inputs {
    if !supported(ir.type(value), config) {
      return false
    }
  }
  for value in outputs {
    if !supported(ir.type(value), config) {
      return false
    }
  }
  return true
}

[memo]
local fn noalias_enabled(fn: Fn) -> bool {
  if !ir.live(fn) || !ir.has(fn, "c") {
    return false
  }
  let spec = ir.meta(fn, "c")
  assert(base.kind(spec) == "dict", "c: binding must be a dictionary")
  let enabled = base.get(spec, "noalias", false)
  assert(base.kind(enabled) == "bool",
         "c: noalias must be a Boolean")
  let proven = base.get(spec, "restrict", false)
  assert(base.kind(proven) == "bool",
         "c: restrict proof must be a Boolean")
  return enabled == true || proven == true
}

[memo]
local fn accepts_with(m: Mod, op: Op, config: dict) -> bool {
  let name = call_name(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if name == "base.list" || name == "operator .." {
    return true
  }
  if name == "base.assert" || ir.target(m, op) == "base.assert" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           ir.type(inputs[0]) == ty("bool") &&
           ir.type(inputs[1]) == ty("str") &&
           ir.type(outputs[0]) == ty("bool")
  }
  if name == "base.copy" {
    return len(inputs) == 1 && len(outputs) == 1 &&
           ir.type(inputs[0]) == ir.type(outputs[0]) &&
           supported(ir.type(outputs[0]), config)
  }
  let resolved = ir.target(m, op)
  if resolved == "tensor.make" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(outputs[0]), config) &&
           supported(ir.type(inputs[1]), config) &&
           len(mem.capacity(m, outputs[0])) ==
             len(tensor.dims(ir.type(outputs[0])))
  }
  if resolved == "tensor.view" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           tensor.valid(ir.type(inputs[0])) &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(inputs[0]), config) &&
           supported(ir.type(outputs[0]), config) &&
           supported(ir.type(inputs[1]), config) &&
           len(mem.capacity(m, outputs[0])) ==
             len(tensor.dims(ir.type(outputs[0])))
  }
  if resolved == "tensor.dim" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           tensor.valid(ir.type(inputs[0])) &&
           supported(ir.type(inputs[0]), config) &&
           integer(ir.type(outputs[0]), config)
  }
  if name == "operator []" {
    if len(outputs) != 1 || len(inputs) < 2 ||
       tensor.valid(ir.type(outputs[0])) {
      return false
    }
    if tensor.valid(ir.type(inputs[0])) {
      return supported(ir.type(inputs[0]), config)
    }
    let source = ir.def(inputs[0])
    return len(inputs) == 2 && ir.live(source) &&
           ir.callee(source) == "base.list"
  }
  if name == "operator []=" {
    return len(outputs) == 1 && len(inputs) >= 3 &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(outputs[0]), config)
  }
  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return supported(ir.type(outputs[0]), config)
  }
  if binary(name) != "" && len(inputs) == 2 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0])) &&
           binary_types(name, inputs, outputs[0], config)
  }
  if unary(name) != "" && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0])) &&
           unary_types(name, inputs[0], outputs[0], config)
  }
  if scalar_name(name, config) && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  return callable(m, target, config) || external_call(m, op, config)
}

local fn outline_constant(value: Val) -> bool {
  if ir.is_const(value) {
    let kind = base.kind(ir.constant(value))
    return kind == "bool" || kind == "int" || kind == "f64" ||
           kind == "str"
  }
  let source = ir.def(value)
  if !ir.live(source) || ir.kind(source) != "call" ||
     ir.callee(source) != "base.list" {
    return false
  }
  for item in ir.args(source) {
    if !outline_constant(item) {
      return false
    }
  }
  return true
}

// opt.instantiate removes structural constants from the instance signature.
// Everything that remains must cross an ordinary C call boundary.
fn outlineable(
  m: Mod, op: Op, impl: Fn, config: dict
) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  for value in ir.args(op) {
    if !outline_constant(value) && !supported(ir.type(value), config) {
      return false
    }
    if tensor.valid(ir.type(value)) && !tensor.static(ir.type(value)) {
      return false
    }
  }
  for value in outputs {
    if !supported(ir.type(value), config) {
      return false
    }
    if tensor.valid(ir.type(value)) && !tensor.static(ir.type(value)) {
      return false
    }
  }
  return ir.live(impl) && len(ir.blks(impl)) != 0
}

local fn frequent_impls(
  m: Mod, impls: list<Fn>, min_uses: int
) -> list<Fn> {
  var out: list<Fn> = []
  let calls = ir.ops(m, ["call"])
  for impl in impls {
    var uses = 0
    for op in calls {
      if ir.live(op) && ir.resolve(m, op) == impl {
        uses += 1
      }
    }
    if uses >= min_uses {
      out += [impl]
    }
  }
  return out
}

local fn prune_templates(m: Mod) -> bool {
  var changed = false
  let functions = ir.fns(m)
  for fn in functions {
    if ir.live(fn) && ir.local(fn) && len(ir.generics(fn)) != 0 {
      var used = false
      for op in ir.ops(m, ["call"]) {
        if ir.live(op) && ir.resolve(m, op) == fn {
          used = true
        }
      }
      if !used {
        changed = ir.erase(m, fn) || changed
      }
    }
  }
  return changed
}

local fn prepare_with(m: Mod, config: dict) -> bool {
  let accept = ir.find(
    "c.accepts", [ty("Mod"), ty("Op"), ty("dict")]
  )
  // Materialize each concrete tensor/NN implementation once inside the
  // program.  Calls with the same signature then share a callable body instead
  // of cloning that body at every call site during exposure.  The bodies are
  // still checked below, so this changes representation rather than legality.
  let outline = ir.find(
    "c.outlineable", [ty("Mod"), ty("Op"), ty("Fn"), ty("dict")]
  )
  let outline_uses = base.get(config, "outline_uses", 4)
  assert(base.kind(outline_uses) == "int" && outline_uses >= 1,
         "c: outline_uses must be a positive integer")
  let tensor_impls = frequent_impls(m, ir.fns("tensor"), outline_uses)
  let nn_impls = frequent_impls(m, ir.fns("nn"), outline_uses)
  var changed = opt.instantiate(m, tensor_impls, outline, config)
  changed = opt.instantiate(m, nn_impls, outline, config) || changed
  // A public implementation may call generic private helpers captured with its
  // lexical closure.  Specialize those owned helpers after their callers have
  // been materialized so no symbolic tensor type crosses into C lowering.
  changed = opt.instantiate(m, ir.fns(m), outline, config) || changed
  // Exposure can inline a body into many call sites, so the operation count
  // after the first fixed point can be much larger than the input count. Size
  // each convergence budget from the graph consumed by that invocation.
  changed = opt.expose(m, accept, config, len(ir.ops(m)) + 1) || changed
  if ir.type(m) {
    changed = true
  }
  if opt.expose(m, accept, config, len(ir.ops(m)) + 1) {
    changed = true
  }
  // The last expansion round can expose structural constants such as
  // len(list) inside a shape loop. Fold them before deciding whether the loop
  // is statically specializable.
  if opt.fold(m) {
    changed = true
  }
  if opt.specialize(m, "stage", "shape") {
    changed = true
  }
  if opt.basic(m) {
    changed = true
  }
  // Outlined bodies expose assignment chains that become constant only after
  // canonicalization (for example, shape strides).  Fold that final form now
  // so a repeated prepare is byte-for-byte stable.
  if opt.fold(m) {
    changed = true
  }
  if prune_templates(m) {
    changed = true
  }
  if ir.trim(m) {
    changed = true
  }
  for op in ir.ops(m, ["call"]) {
    if ir.live(op) {
      if !accepts_with(m, op, config) {
        var detail = "c: unsupported call remains: " + ir.callee(op) +
                     " (target " + ir.target(m, op) + ")"
        let owner: Fn = ir.owner(ir.blk(op))
        if ir.live(owner) {
          detail += ", owner " + ir.name(owner)
        }
        let inputs = ir.args(op)
        let outputs = ir.outs(op)
        if len(outputs) > 0 {
          detail += ", output " + text(ir.type(outputs[0]))
        }
        if len(inputs) > 0 {
          let source = ir.def(inputs[0])
          detail += ", input " + text(ir.type(inputs[0]))
          if ir.live(source) && ir.kind(source) == "call" {
            detail += " from " + ir.callee(source) +
                      " (target " + ir.target(m, source) + ")"
          }
        }
        assert(false, detail)
      }
    }
  }
  return changed
}
