local fn result_values(fn: Fn) -> list<Val> {
  let bodies = ir.blks(fn)
  if len(bodies) == 1 {
    let operations = ir.ops(bodies[0])
    if len(operations) != 0 {
      let last = operations[len(operations) - 1]
      if ir.kind(last) == "return" {
        return ir.args(last)
      }
    }
  }
  var out: list<Val> = []
  var count = 0
  for op in ir.ops(fn) {
    if ir.kind(op) == "return" {
      out = ir.args(op)
      count += 1
    }
  }
  if count != 1 {
    return []
  }
  return out
}

local fn direct_labels(m: Mod, fn: Fn) -> list<str> {
  let types = ir.returns(fn)
  let returned = result_values(fn)
  var out: list<str> = []
  for i in 0..len(types) {
    var name = ""
    if len(returned) == len(types) && tensor.valid(types[i]) {
      for op in ir.ops(fn) {
        if ir.kind(op) == "call" && !reuses(op) &&
           ir.target(m, op) != "tensor.view" {
          for value in ir.outs(op) {
            if tensor.valid(ir.type(value)) && !mem.planned(value) &&
               label(value) == label(returned[i]) {
              name = label(returned[i])
            }
          }
        }
      }
    }
    out += [name]
  }
  return out
}

local fn result_taken(
  fn: Fn, blob: str, prior: list<str>, name: str
) -> bool {
  if name == blob && blob != "" {
    return true
  }
  if ir.bound(fn, name) {
    return true
  }
  for existing in prior {
    if existing == name {
      return true
    }
  }
  return false
}

local fn result_names(fn: Fn, blob: str) -> list<str> {
  let types = ir.returns(fn)
  let single = result_values(fn)
  var out: list<str> = []
  for i in 0..len(types) {
    var name = ""
    var consistent = true
    var found = false
    if len(single) == len(types) {
      let source = ir.name(single[i])
      found = true
      consistent = source != ""
      if consistent {
        name = c_name(source)
      }
    } else {
      for op in ir.ops(fn) {
        if ir.kind(op) == "return" {
          let values = ir.args(op)
          assert(len(values) == len(types), "c: return arity is inconsistent")
          let source = ir.name(values[i])
          if source == "" {
            consistent = false
          } else {
            let candidate = c_name(source)
            if found && candidate != name {
              consistent = false
            } else {
              name = candidate
            }
          }
          found = true
        }
      }
    }
    if found && consistent {
      name += "_out"
    }
    if !found || !consistent || result_taken(fn, blob, out, name) {
      name = ""
      var base = "out"
      if len(types) != 1 {
        base += "_" + text(i)
      }
      for attempt in 0..len(ir.vals(fn)) + len(types) + 2 {
        var candidate = base
        if attempt != 0 {
          candidate += "_" + text(attempt)
        }
        if name == "" && !result_taken(fn, blob, out, candidate) {
          name = candidate
        }
      }
      assert(name != "", "c: could not name a result parameter")
    }
    out += [name]
  }
  return out
}

local fn signature_text(
  name: str,
  params: list<Ty>,
  names: list<str>,
  returns: list<Ty>,
  results: list<str>,
  blob: str,
  config: dict,
  definition: bool,
  bounded: bool,
  noalias: bool
) -> str {
  assert(len(params) == len(names) && len(returns) == len(results),
         "c: signature names do not match its types")
  assert(definition || !noalias,
         "c: noalias qualifiers belong only to definitions")
  assert(definition || !bounded,
         "c: bounded parameters belong only to definitions")
  var out = "void"
  if len(returns) == 1 && !tensor.valid(returns[0]) {
    out = scalar(returns[0], config)
  }
  out += " " + name + "("
  var arguments = 0
  for i in 0..len(params) {
    if arguments != 0 {
      out += ", "
    }
    let type = params[i]
    if tensor.valid(type) {
      var elements = 0
      if tensor.static(type) {
        elements = count(type)
      }
      out += "const " + scalar(tensor.elem(type), config)
      if bounded && elements > 0 {
        out += " " + names[i] + "["
        if noalias {
          out += "restrict "
        }
        out += "static " + text(elements) + "]"
      } else {
        out += "*"
        if noalias {
          out += " restrict"
        }
        out += " " + names[i]
      }
      let dims = tensor.dims(type)
      for axis in 0..len(dims) {
        if base.kind(dims[axis]) != "int" {
          out += ", " + index_type(config) + " " + names[i] +
                 "_dim_" + text(axis)
          arguments += 1
        }
      }
    } else {
      out += scalar(type, config) + " " + names[i]
    }
    arguments += 1
  }
  if blob != "" {
    if arguments != 0 {
      out += ", "
    }
    out += "const unsigned char*"
    if noalias {
      out += " restrict"
    }
    out += " " + blob
    arguments += 1
  }
  if len(returns) != 1 || tensor.valid(returns[0]) {
    for i in 0..len(returns) {
      if arguments != 0 {
        out += ", "
      }
      let type = returns[i]
      if tensor.valid(type) {
        var elements = 0
        if tensor.static(type) {
          elements = count(type)
        }
        out += scalar(tensor.elem(type), config)
        if bounded && elements > 0 {
          out += " " + results[i] + "["
          if noalias {
            out += "restrict "
          }
          out += "static " + text(elements) + "]"
        } else {
          out += "*"
          if noalias {
            out += " restrict"
          }
          out += " " + results[i]
        }
        let dims = tensor.dims(type)
        for axis in 0..len(dims) {
          if base.kind(dims[axis]) != "int" {
            out += ", " + index_type(config) + "* " + results[i] +
                   "_dim_" + text(axis)
            arguments += 1
          }
        }
      } else {
        out += scalar(type, config) + "* " + results[i]
      }
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn signature(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict,
  definition: bool
) -> str {
  assert(callable(m, fn, config), "c: function has no representable ABI")
  var types: list<Ty> = []
  var names: list<str> = []
  for param in ir.params(fn) {
    types += [ir.type(param)]
    names += [val(param)]
  }
  var data = ""
  if ir.owned(m, fn) && has_fn(data_fns, fn) {
    data = blob
  }
  return signature_text(
    symbol(m, fn, config), types, names, ir.returns(fn),
    result_names(fn, data), data, config,
    definition, definition && ir.local(fn),
    definition && noalias_enabled(fn)
  )
}

local fn external_signature(m: Mod, op: Op, config: dict) -> str {
  assert(external_call(m, op, config),
         "c: external call has no representable ABI")
  let fn = ir.resolve(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let params = ir.params(fn)
  assert(len(params) == len(inputs),
         "c: external call parameter count mismatch")
  var types: list<Ty> = []
  var names: list<str> = []
  var used: list<str> = []
  for i in 0..len(inputs) {
    let name = c_name(ir.name(params[i]))
    for existing in used {
      assert(existing != name,
             "c: external parameters collide after normalization")
    }
    names += [name]
    used += [name]
    types += [ir.type(inputs[i])]
  }
  var returns: list<Ty> = []
  var results: list<str> = []
  for i in 0..len(outputs) {
    returns += [ir.type(outputs[i])]
    var name = ""
    for attempt in 0..len(used) + 2 {
      var candidate = "out"
      if len(outputs) != 1 {
        candidate += "_" + text(i)
      }
      for suffix in 0..attempt {
        candidate += "_"
      }
      var taken = false
      for existing in used {
        taken = existing == candidate || taken
      }
      if name == "" && !taken {
        name = candidate
      }
    }
    assert(name != "", "c: could not name an external result")
    used += [name]
    results += [name]
  }
  return signature_text(
    symbol(m, fn, config), types, names, returns, results, "", config,
    false, false, false
  )
}

local fn external_abi(m: Mod, op: Op, config: dict) -> str {
  assert(external_call(m, op, config),
         "c: external call has no representable ABI")
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  var out = "void("
  if len(outputs) == 1 && !tensor.valid(ir.type(outputs[0])) {
    out = scalar(ir.type(outputs[0]), config) + "("
  }
  var arguments = 0
  for value in inputs {
    if arguments != 0 {
      out += ","
    }
    let type = ir.type(value)
    if tensor.valid(type) {
      out += "const " + scalar(tensor.elem(type), config) + "*"
    } else {
      out += scalar(type, config)
    }
    arguments += 1
  }
  if len(outputs) != 1 || tensor.valid(ir.type(outputs[0])) {
    for value in outputs {
      if arguments != 0 {
        out += ","
      }
      let type = ir.type(value)
      if tensor.valid(type) {
        out += scalar(tensor.elem(type), config) + "*"
      } else {
        out += scalar(type, config) + "*"
      }
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn linkage(m: Mod, fn: Fn) -> str {
  if ir.owned(m, fn) && ir.local(fn) {
    return "static "
  }
  return ""
}

local fn runtime_arg(m: Mod, op: Op, at: int) -> bool {
  let inputs = ir.args(op)
  assert(at >= 0 && at < len(inputs), "c: argument index is out of range")
  // Region operands only carry a storage identity into nested blocks. The
  // nested operations, not the loop/branch/yield edge, determine whether the
  // emitted program reads that storage.
  if ir.kind(op) == "yield" {
    return false
  }
  if (ir.kind(op) == "loop" || ir.kind(op) == "branch") &&
     mem.planned(inputs[at]) {
    return false
  }
  if ir.kind(op) != "call" {
    return true
  }
  let target = ir.target(m, op)
  let name = call_name(m, op)
  // A store defines the next version of its destination; it does not read the
  // previous contents. Indices and the stored value remain ordinary reads.
  if name == "operator []=" && at == 0 {
    return false
  }
  // Static capacities and extents are already present in the prepared IR.
  // Their shape operands have no representation in emitted C.
  if target == "tensor.make" && at == 1 {
    let outputs = ir.outs(op)
    return len(outputs) != 1 ||
           (!tensor.static(ir.type(outputs[0])) &&
            len(ir.users(outputs[0])) != 0)
  }
  if target == "tensor.view" {
    if at == 1 {
      let outputs = ir.outs(op)
      return len(outputs) != 1 ||
             (!tensor.static(ir.type(outputs[0])) &&
              len(ir.users(outputs[0])) != 0)
    }
    if at == 0 {
      let outputs = ir.outs(op)
      return len(outputs) != 1 || len(ir.users(outputs[0])) != 0
    }
  }
  if target == "tensor.dim" && at == 0 && tensor.static(ir.type(inputs[0])) {
    return false
  }
  return true
}

local fn contains(fn: Fn, value: Val) -> bool {
  for candidate in ir.vals(fn) {
    if candidate == value {
      return true
    }
  }
  return false
}

local fn uses_slot(m: Mod, fn: Fn, slot: int) -> bool {
  for op in ir.ops(fn) {
    let inputs = ir.args(op)
    for at in 0..len(inputs) {
      let value = inputs[at]
      if mem.planned(value) && mem.slot(value) == slot &&
         runtime_arg(m, op, at) {
        return true
      }
    }
  }
  return false
}

local fn runtime_storage(m: Mod, value: Val) -> bool {
  if !mem.planned(value) {
    return true
  }
  for fn in ir.fns(m) {
    if contains(fn, value) {
      return uses_slot(m, fn, mem.slot(value))
    }
  }
  assert(false, "c: planned value has no owning function")
  return false
}

local fn definition_prefix(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict, offsets: dict
) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  return linkage(m, fn) +
         signature(m, fn, blob, data_fns, config, true) + " {\n"
}

local fn definition_storage(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict, offsets: dict
) -> str {
  var memory = ""
  var storage = ""
  if ir.has(fn, "c.place") {
    let place = str(ir.meta(fn, "c.place"))
    assert(place == "static", "c: unsupported storage placement " + place)
    storage = "static "
  }
  for slot in 0..mem.slots(fn) {
    if uses_slot(m, fn, slot) {
      let type = mem.type(fn, slot)
      memory += pad(1) + storage + scalar(type, config) + " slot_" +
                c_name(base.name(type)) + "_" + text(slot) + "[" +
                text(mem.count(fn, slot)) + "];\n"
    }
  }
  return memory
}

local fn definition_contents(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict, offsets: dict
) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  var data_name = ""
  if blob != "" && has_fn(data_fns, fn) {
    data_name = blob
  }
  let direct = direct_labels(m, fn)
  let results = result_names(fn, data_name)
  return block(
    m, bodies[0], 1, data_name, data_fns, config, offsets, direct, results
  )
}

local fn definition_chunk(
  m: Mod, fn: Fn, start: int, count: int, direct: list<str>,
  results: list<str>, blob: str, data_fns: list<Fn>, config: dict,
  offsets: dict
) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  var data_name = ""
  if blob != "" && has_fn(data_fns, fn) {
    data_name = blob
  }
  return block_chunk(
    m, bodies[0], start, count, 1, data_name, data_fns, config, offsets,
    direct, results
  )
}

local fn nested_depth(
  m: Mod, fn: Fn, owner_path: list<int>, child: int
) -> int {
  assert(len(owner_path) != 0 && len(owner_path) % 2 == 1,
         "c: nested owner path must identify an operation")
  var depth = 1
  var prefix: list<int> = []
  for i in 0..len(owner_path) {
    prefix += [owner_path[i]]
    if i % 2 == 0 && i + 1 < len(owner_path) {
      let owner = ir.at(m, fn, prefix)
      let blocks = ir.blks(owner)
      let selected = owner_path[i + 1]
      assert(selected >= 0 && selected < len(blocks),
             "c: nested block path is out of range")
      if ir.kind(owner) == "loop" {
        depth += len(ir.args(blocks[selected])) - len(ir.outs(owner))
      } else {
        assert(ir.kind(owner) == "branch",
               "c: nested path crosses a non-control operation")
        depth += 1
      }
    }
  }
  let owner = ir.at(m, fn, owner_path)
  let blocks = ir.blks(owner)
  assert(child >= 0 && child < len(blocks),
         "c: nested child block is out of range")
  if ir.kind(owner) == "loop" {
    return depth + len(ir.args(blocks[child])) - len(ir.outs(owner))
  }
  assert(ir.kind(owner) == "branch",
         "c: nested owner must be a loop or branch")
  return depth + 1
}

local fn definition_nested_chunk(
  m: Mod, fn: Fn, owner_path: list<int>, child: int,
  start: int, count: int, direct: list<str>, results: list<str>,
  blob: str, data_fns: list<Fn>, config: dict, offsets: dict
) -> str {
  let owner = ir.at(m, fn, owner_path)
  assert(ir.live(owner), "c: nested owner operation not found")
  let blocks = ir.blks(owner)
  assert(child >= 0 && child < len(blocks),
         "c: nested child block is out of range")
  var data_name = ""
  if blob != "" && has_fn(data_fns, fn) {
    data_name = blob
  }
  return block_chunk(
    m, blocks[child], start, count,
    nested_depth(m, fn, owner_path, child), data_name, data_fns, config,
    offsets, direct, results
  )
}

local fn definition_nested_partition(
  m: Mod, fn: Fn, root_start: int, root_count: int,
  owner_path: list<int>, child: int, start: int, count: int,
  direct: list<str>, results: list<str>, blob: str,
  data_fns: list<Fn>, config: dict, offsets: dict
) -> list<str> {
  assert(len(owner_path) != 0 && len(owner_path) % 2 == 1,
         "c: nested owner path must identify an operation")
  let body = ir.blks(fn)[0]
  let operations = ir.ops(body)
  let root = owner_path[0]
  assert(root_start >= 0 && root_count > 0 &&
         root >= root_start && root < root_start + root_count &&
         root_start + root_count <= len(operations),
         "c: nested root partition is out of range")
  var data_name = ""
  if blob != "" && has_fn(data_fns, fn) {
    data_name = blob
  }
  let nested = statement_partition(
    m, operations[root], owner_path, 1, child, start, count, 1,
    data_name, data_fns, config, offsets, direct, results
  )
  return [
    block_chunk(
      m, body, root_start, root - root_start, 1, data_name, data_fns,
      config, offsets, direct, results
    ) + str(nested[0]),
    str(nested[1]),
    str(nested[2]) + block_chunk(
      m, body, root + 1, root_start + root_count - root - 1, 1,
      data_name, data_fns, config, offsets, direct, results
    )
  ]
}

local fn definition_suffix() -> str {
  return "}\n"
}

local fn definition(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict, offsets: dict
) -> str {
  return definition_prefix(m, fn, blob, data_fns, config, offsets) +
         definition_storage(m, fn, blob, data_fns, config, offsets) +
         definition_contents(m, fn, blob, data_fns, config, offsets) +
         definition_suffix()
}

local fn functions(m: Mod) -> list<Fn> {
  var out: list<Fn> = []
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      out += [fn]
    }
  }
  return out
}

local fn exports(m: Mod) -> list<Fn> {
  var visible: list<Fn> = []
  for fn in functions(m) {
    if !ir.local(fn) {
      visible += [fn]
    }
  }
  let entries = ir.where(visible, "entry", true)
  if len(entries) != 0 {
    return entries
  }
  return visible
}
