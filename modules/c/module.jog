module c
use base
use ir
use mem
use opt
use tensor

[memo]
local fn c_name(text: str) -> str {
  let name = base.ident(text)
  let reserved = [
    "alignas", "alignof", "auto", "bool", "break", "case", "char",
    "const", "constexpr", "continue", "default", "do", "double", "else",
    "enum", "extern", "false", "float", "for", "goto", "if", "inline",
    "int", "long", "nullptr", "register", "restrict", "return", "short",
    "signed", "sizeof", "static", "static_assert", "struct", "switch",
    "thread_local", "true", "typedef", "typeof", "typeof_unqual", "union",
    "unsigned", "void", "volatile", "while", "_Alignas", "_Alignof",
    "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary", "_Noreturn",
    "_Static_assert", "_Thread_local"
  ]
  for keyword in reserved {
    if name == keyword {
      return name + "_"
    }
  }
  return name
}

[memo]
local fn label(value: Val) -> str {
  let name = ir.name(value)
  if name == "" {
    return "tmp_" + text(ir.key(value))
  }
  return c_name(name)
}

[memo]
local fn val(value: Val) -> str {
  if mem.planned(value) {
    let type = ir.type(value)
    assert(tensor.valid(type), "c: planned value must be a tensor")
    return "slot_" + c_name(base.name(tensor.elem(type))) + "_" +
           text(mem.slot(value))
  }
  return label(value)
}

[memo]
local fn call_name(m: Mod, op: Op) -> str {
  let target = ir.resolve(m, op)
  if ir.live(target) {
    let name = ir.name(target)
    let symbol = ir.symbol(target)
    if base.replace(name, "operator ", "") != name {
      if symbol == "base." + name || symbol == "tensor." + name {
        return name
      }
      return symbol
    }
  }
  return ir.callee(op)
}

[memo]
fn abi() -> dict {
  return {
    bool: {name: "bool",     bytes: 1, kind: "bool",     include: "stdbool.h"},
    f32: {name: "float",     bytes: 4, kind: "float",    include: ""},
    f64: {name: "double",    bytes: 8, kind: "float",    include: ""},
    i8: {name: "int8_t",     bytes: 1, kind: "signed",   include: "stdint.h"},
    i16: {name: "int16_t",   bytes: 2, kind: "signed",   include: "stdint.h"},
    i32: {name: "int32_t",   bytes: 4, kind: "signed",   include: "stdint.h"},
    i64: {name: "int64_t",   bytes: 8, kind: "signed",   include: "stdint.h"},
    index: {name: "int64_t", bytes: 8, kind: "signed",   include: "stdint.h"},
    int: {name: "int64_t",   bytes: 8, kind: "signed",   include: "stdint.h"},
    u8: {name: "uint8_t",    bytes: 1, kind: "unsigned", include: "stdint.h"},
    u16: {name: "uint16_t",  bytes: 2, kind: "unsigned", include: "stdint.h"},
    u32: {name: "uint32_t",  bytes: 4, kind: "unsigned", include: "stdint.h"},
    u64: {name: "uint64_t",  bytes: 8, kind: "unsigned", include: "stdint.h"}
  }
}

[memo]
local fn spec(config: dict, name: str) -> Attr {
  if base.has(config, name) {
    return config[name]
  }
  let defaults = abi()
  assert(base.has(defaults, name), "c: ABI has no type " + name)
  return defaults[name]
}

[memo]
local fn field(config: dict, name: str, key: str) -> Attr {
  let type = spec(config, name)
  assert(base.kind(type) == "dict",
         "c: ABI type " + name + " must be a dictionary")
  assert(base.has(type, key), "c: ABI type " + name + " has no " + key)
  return base.get(type, key)
}

[memo]
local fn scalar(type: Ty, config: dict) -> str {
  return str(field(config, base.name(type), "name"))
}

[memo]
local fn scalar_name(name: str, config: dict) -> bool {
  return base.has(config, name) || base.has(abi(), name)
}

[memo]
local fn class(type: Ty, config: dict) -> str {
  let name = base.name(type)
  if !scalar_name(name, config) {
    return ""
  }
  return str(field(config, name, "kind"))
}

[memo]
local fn number(type: Ty, config: dict) -> bool {
  let kind = class(type, config)
  return kind == "signed" || kind == "unsigned" || kind == "float"
}

[memo]
local fn integer(type: Ty, config: dict) -> bool {
  let kind = class(type, config)
  return kind == "signed" || kind == "unsigned"
}

[memo]
local fn same_repr(left: Ty, right: Ty, config: dict) -> bool {
  return class(left, config) != "" && class(right, config) != "" &&
         scalar(left, config) == scalar(right, config)
}

[memo]
local fn width(type: Ty, config: dict) -> int {
  let bytes = base.int(field(config, base.name(type), "bytes"))
  assert(bytes > 0, "c: ABI byte width must be positive")
  return bytes
}

[memo]
local fn alignment(type: Ty, config: dict) -> int {
  let desc = spec(config, base.name(type))
  var bytes = width(type, config)
  if base.has(desc, "align") {
    bytes = base.int(desc["align"])
  }
  assert(bytes > 0, "c: ABI alignment must be positive")
  return bytes
}

[memo]
local fn index_type(config: dict) -> str {
  return scalar(ty("index"), config)
}

local fn count(type: Ty) -> int {
  assert(tensor.static(type), "c: tensor shape must be static: " + text(type))
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

local fn storage_count(m: Mod, value: Val) -> int {
  let shape = mem.capacity(m, value)
  assert(len(shape) == len(tensor.dims(ir.type(value))),
         "c: dynamic tensor has no finite capacity: " + ir.name(value))
  var out = 1
  for extent in shape {
    assert(extent >= 0 && (extent == 0 ||
           out <= 9223372036854775807 / extent),
           "c: dynamic tensor capacity overflows")
    out *= extent
  }
  return out
}

local fn allocation_count(m: Mod, value: Val) -> int {
  if tensor.static(ir.type(value)) {
    return count(ir.type(value))
  }
  return storage_count(m, value)
}

local fn extent(m: Mod, value: Val, axis: int) -> str {
  let dims = tensor.dims(ir.type(value))
  assert(axis >= 0 && axis < len(dims), "c: tensor axis is out of range")
  if base.kind(dims[axis]) == "int" {
    return text(base.int(dims[axis]))
  }
  let source = ir.def(value)
  if ir.live(source) && ir.kind(source) == "call" &&
     (ir.target(m, source) == "tensor.make" ||
      ir.target(m, source) == "tensor.view" ||
      ir.callee(source) == "tensor.make" ||
      ir.callee(source) == "tensor.view") && len(ir.args(source)) == 2 {
    return val(ir.args(source)[1]) + "[" + text(axis) + "]"
  }
  return val(value) + "_dim_" + text(axis)
}

local fn logical_count(m: Mod, value: Val) -> str {
  let dims = tensor.dims(ir.type(value))
  var out = "1"
  for axis in 0..len(dims) {
    out = "(" + out + " * " + extent(m, value, axis) + ")"
  }
  return out
}

local fn dimension(
  m: Mod, value: Val, axis: Val, blob: str,
  data_fns: list<Fn>, config: dict
) -> str {
  let dims = tensor.dims(ir.type(value))
  assert(len(dims) != 0, "c: tensor.dim requires a non-scalar tensor")
  let selected = expr(m, axis, blob, data_fns, config)
  var out = extent(m, value, 0)
  for i in 1..len(dims) {
    out = "(" + selected + " == " + text(i) + " ? " +
          extent(m, value, i) + " : " + out + ")"
  }
  return out
}

[memo]
local fn pad(depth: int) -> str {
  var out = ""
  for i in 0..depth {
    out += "  "
  }
  return out
}

local fn logical(
  m: Mod, op: Op, blob: str, data_fns: list<Fn>, config: dict
) -> str {
  if ir.kind(op) != "branch" {
    return ""
  }
  let inputs = ir.args(op)
  let bodies = ir.blks(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(bodies) != 2 || len(outputs) != 1 ||
     ir.type(outputs[0]) != ty("bool") {
    return ""
  }
  let first_args = ir.args(bodies[0])
  let second_args = ir.args(bodies[1])
  let first_ops = ir.ops(bodies[0])
  let second_ops = ir.ops(bodies[1])
  if len(first_args) != 1 || len(second_args) != 1 ||
     len(first_ops) == 0 || len(second_ops) == 0 {
    return ""
  }
  let first_yield = first_ops[len(first_ops) - 1]
  let second_yield = second_ops[len(second_ops) - 1]
  if ir.kind(first_yield) != "yield" ||
     ir.kind(second_yield) != "yield" ||
     len(ir.args(first_yield)) != 1 || len(ir.args(second_yield)) != 1 {
    return ""
  }
  let first = ir.args(first_yield)[0]
  let second = ir.args(second_yield)[0]
  if second == second_args[0] && first != first_args[0] {
    return "(" + expr(m, inputs[0], blob, data_fns, config) + " && " +
           expr(m, first, blob, data_fns, config) + ")"
  }
  if first == first_args[0] && second != second_args[0] {
    return "(" + expr(m, inputs[0], blob, data_fns, config) + " || " +
           expr(m, second, blob, data_fns, config) + ")"
  }
  return ""
}

local fn expr(
  m: Mod, value: Val, blob: str, data_fns: list<Fn>, config: dict
) -> str {
  if ir.is_const(value) {
    let source = ir.def(value)
    if !tensor.valid(ir.type(value)) &&
       ir.form(source) != "var" && !reuses(source) {
      return text(ir.constant(value))
    }
  }
  if ir.name(value) != "" {
    return val(value)
  }
  if tensor.valid(ir.type(value)) {
    return val(value)
  }
  let op = ir.def(value)
  assert(ir.live(op),
         "c: unnamed " + text(ir.type(value)) +
         " value has no definition")
  if ir.kind(op) == "branch" {
    let out = logical(m, op, blob, data_fns, config)
    assert(out != "", "c: unnamed branch value is not a logical expression")
    return out
  }
  assert(ir.kind(op) == "call",
         "c: unnamed " + text(ir.type(value)) +
         " value is neither a constant nor a call result")
  let name = call_name(m, op)
  let inputs = ir.args(op)
  if name == "operator []" {
    return index(m, inputs[0], inputs, blob, data_fns, config)
  }
  if ir.target(m, op) == "tensor.dim" && len(inputs) == 2 {
    return dimension(m, inputs[0], inputs[1], blob, data_fns, config)
  }
  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 {
    return "(" + expr(m, inputs[0], blob, data_fns, config) + " " +
           binary_op + " " +
           expr(m, inputs[1], blob, data_fns, config) + ")"
  }
  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 {
    return "(" + unary_op +
           expr(m, inputs[0], blob, data_fns, config) + ")"
  }
  if len(inputs) == 1 && scalar_name(name, config) {
    return "((" + scalar(ty(name), config) + ")(" +
           expr(m, inputs[0], blob, data_fns, config) + "))"
  }
  let bound = binding(m, op)
  if bound != "" && len(ir.outs(op)) == 1 &&
     !tensor.valid(ir.type(ir.outs(op)[0])) {
    return bound + "(" + args(m, inputs, blob, data_fns, config) + ")"
  }
  let target = ir.resolve(m, op)
  if callable(m, target, config) && len(ir.outs(op)) == 1 &&
     !tensor.valid(ir.type(value)) &&
     len(ir.users(value)) == 1 {
    var actuals = args(m, inputs, blob, data_fns, config)
    if blob != "" && owned(m, target) && has_fn(data_fns, target) {
      if actuals != "" {
        actuals += ", "
      }
      actuals += blob
    }
    return symbol(m, target, config) + "(" + actuals + ")"
  }
  assert(false, "c: unnamed call must be assigned or exposed: " + name)
  return ""
}

local fn reuses(op: Op) -> bool {
  let form = ir.form(op)
  return form == "assign" || form == "compound" || form == "index_assign"
}

local fn lhs(op: Op, output: Val, config: dict) -> str {
  if reuses(op) {
    return val(output)
  }
  var type = scalar(ir.type(output), config)
  if ir.form(op) == "let" {
    type = "const " + type
  }
  return type + " " + val(output)
}

local fn index(
  m: Mod, value: Val, indices: list<Val>, blob: str,
  data_fns: list<Fn>, config: dict
) -> str {
  let type = ir.type(value)
  if tensor.valid(type) {
    let dims = tensor.dims(type)
    assert(len(indices) == 2 || len(indices) == len(dims) + 1,
           "c: tensor index must be linear or match its rank")
    var out = expr(m, indices[1], blob, data_fns, config)
    if len(indices) != 2 {
      for i in 2..len(indices) {
        out = "(" + out + " * " + extent(m, value, i - 1) + " + " +
              expr(m, indices[i], blob, data_fns, config) + ")"
      }
    }
    return val(value) + "[" + out + "]"
  }
  let source = ir.def(value)
  let types = base.args(type)
  assert(base.name(type) == "list" && len(types) == 1 &&
         len(indices) == 2 &&
         ir.live(source) && ir.callee(source) == "base.list",
         "c: scalar index requires a literal list")
  return "((const " + scalar(types[0], config) + "[]){" +
         args(m, ir.args(source), blob, data_fns, config) + "})[" +
         expr(m, indices[1], blob, data_fns, config) + "]"
}

[memo]
local fn owned(m: Mod, fn: Fn) -> bool {
  for candidate in ir.fns(m) {
    if candidate == fn {
      return true
    }
  }
  return false
}

local fn has_fn(values: list<Fn>, value: Fn) -> bool {
  for candidate in values {
    if candidate == value {
      return true
    }
  }
  return false
}

local fn has_name(values: list<str>, name: str) -> bool {
  for value in values {
    if value == name {
      return true
    }
  }
  return false
}

local fn data_functions(m: Mod) -> list<Fn> {
  let fns = ir.fns(m)
  var out: list<Fn> = []
  for fn in fns {
    for op in ir.ops(fn) {
      let outputs = ir.outs(op)
      if ir.kind(op) == "constant" && len(outputs) == 1 &&
         tensor.valid(ir.type(outputs[0])) && !has_fn(out, fn) {
        out += [fn]
      }
    }
  }
  var again = true
  for round in 0..len(fns) {
    if again {
      let before = len(out)
      var names: list<str> = []
      for target in out {
        names += [ir.name(target), ir.symbol(target)]
      }
      for fn in fns {
        if !has_fn(out, fn) {
          for op in ir.ops(fn) {
            if ir.kind(op) == "call" && has_name(names, ir.callee(op)) {
              let target = ir.resolve(m, op)
              if owned(m, target) && has_fn(out, target) {
                out += [fn]
              }
            }
          }
        }
      }
      again = len(out) != before
    }
  }
  return out
}

local fn data_name(m: Mod, requested: str) -> str {
  let name = c_name(requested)
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      for param in ir.params(fn) {
        assert(val(param) != name,
               "c: external data name collides with parameter " + name)
      }
    }
  }
  return name
}

[memo]
local fn supported(type: Ty, config: dict) -> bool {
  if tensor.valid(type) {
    return scalar_name(base.name(tensor.elem(type)), config)
  }
  return scalar_name(base.name(type), config)
}

[memo]
local fn callable(m: Mod, fn: Fn, config: dict) -> bool {
  if !ir.live(fn) || len(ir.generics(fn)) != 0 {
    return false
  }
  for type in ir.returns(fn) {
    if !supported(type, config) {
      return false
    }
  }
  for param in ir.params(fn) {
    if !supported(ir.type(param), config) {
      return false
    }
  }
  return owned(m, fn) || len(ir.blks(fn)) == 0
}

[memo]
local fn external_call(m: Mod, op: Op, config: dict) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  let name = call_name(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let fn = ir.resolve(m, op)
  if !ir.live(fn) || owned(m, fn) || len(ir.blks(fn)) != 0 ||
     !ir.accepts(op, fn) {
    return false
  }
  if name == "base.list" || name == "operator .." ||
     name == "base.copy" || name == "base.assert" ||
     name == "operator []" ||
     name == "operator []=" ||
     ir.symbol(fn) == "tensor.make" ||
     ir.symbol(fn) == "tensor.view" ||
     ir.symbol(fn) == "tensor.dim" ||
     (len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
      ir.symbol(fn) == "tensor.tensor") ||
     (binary(name) != "" && len(inputs) == 2 && len(outputs) == 1) ||
     (unary(name) != "" && len(inputs) == 1 && len(outputs) == 1) ||
     (scalar_name(name, config) && len(inputs) == 1 && len(outputs) == 1) {
    return false
  }
  for value in inputs {
    if !supported(ir.type(value), config) {
      return false
    }
  }
  for value in outputs {
    if !supported(ir.type(value), config) {
      return false
    }
  }
  return true
}

local fn symbol(m: Mod, fn: Fn, config: dict) -> str {
  assert(ir.live(fn), "c: function has no symbol")
  let bound = binding(fn)
  if bound != "" {
    return bound
  }
  return c_name(base.replace(ir.symbol(fn), ".", "_"))
}

local fn args(
  m: Mod, values: list<Val>, blob: str, data_fns: list<Fn>, config: dict
) -> str {
  var out = ""
  for i in 0..len(values) {
    if i != 0 {
      out += ", "
    }
    out += expr(m, values[i], blob, data_fns, config)
    if tensor.valid(ir.type(values[i])) {
      let dims = tensor.dims(ir.type(values[i]))
      for axis in 0..len(dims) {
        if base.kind(dims[axis]) != "int" {
          out += ", " + extent(m, values[i], axis)
        }
      }
    }
  }
  return out
}

[memo]
local fn binary(op: str) -> str {
  let operators = {
    "operator %": "%", "operator &": "&", "operator &&": "&&",
    "operator *": "*", "operator +": "+", "operator -": "-",
    "operator /": "/", "operator <": "<", "operator <<": "<<",
    "operator <=": "<=", "operator ==": "==", "operator >": ">",
    "operator >=": ">=", "operator >>": ">>", "operator ^": "^",
    "operator |": "|", "operator ||": "||", "operator !=": "!="
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

[memo]
local fn unary(op: str) -> str {
  let operators = {
    "operator !": "!", "operator +": "+", "operator -": "-",
    "operator ~": "~"
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

local fn binary_types(
  op: str, inputs: list<Val>, output: Val, config: dict
) -> bool {
  if len(inputs) != 2 || binary(op) == "" {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  let result = ir.type(output)
  let compatible = same_repr(left, right, config) ||
                   (number(left, config) && number(right, config) &&
                    (ir.is_const(inputs[0]) || ir.is_const(inputs[1])))
  if op == "operator &&" || op == "operator ||" {
    return class(left, config) != "" && class(right, config) != "" &&
           result == ty("bool")
  }
  if op == "operator ==" || op == "operator !=" ||
     op == "operator <" || op == "operator <=" ||
     op == "operator >" || op == "operator >=" {
    return compatible && result == ty("bool")
  }
  if op == "operator <<" || op == "operator >>" {
    return integer(left, config) && integer(right, config) &&
           same_repr(result, left, config)
  }
  if op == "operator %" || op == "operator &" ||
     op == "operator ^" || op == "operator |" {
    return integer(left, config) && integer(right, config) &&
           same_repr(left, right, config) && same_repr(result, left, config)
  }
  return number(left, config) && number(right, config) && compatible &&
         same_repr(result, left, config)
}

local fn unary_types(
  op: str, input: Val, output: Val, config: dict
) -> bool {
  let source = ir.type(input)
  let result = ir.type(output)
  if op == "operator !" {
    return class(source, config) != "" && result == ty("bool")
  }
  if op == "operator ~" {
    return integer(source, config) && same_repr(result, source, config)
  }
  return number(source, config) && same_repr(result, source, config)
}

[memo]
local fn binding(fn: Fn) -> str {
  if !ir.live(fn) || !ir.has(fn, "c") {
    return ""
  }
  let spec = ir.meta(fn, "c")
  assert(base.kind(spec) == "dict", "c: binding must be a dictionary")
  let name = base.get(spec, "name", "")
  assert(base.kind(name) == "str", "c: binding name must be a string")
  return base.str(name)
}

[memo]
local fn binding(m: Mod, op: Op) -> str {
  return binding(ir.resolve(m, op))
}

local fn binding_header(fn: Fn) -> str {
  if !ir.live(fn) || !ir.has(fn, "c") {
    return ""
  }
  let spec = ir.meta(fn, "c")
  assert(base.kind(spec) == "dict", "c: binding must be a dictionary")
  let name = base.get(spec, "include", "")
  assert(base.kind(name) == "str", "c: binding header must be a string")
  return base.str(name)
}

[memo]
local fn noalias_enabled(fn: Fn) -> bool {
  if !ir.live(fn) || !ir.has(fn, "c") {
    return false
  }
  let spec = ir.meta(fn, "c")
  assert(base.kind(spec) == "dict", "c: binding must be a dictionary")
  let enabled = base.get(spec, "noalias", false)
  assert(base.kind(enabled) == "bool",
         "c: noalias must be a Boolean")
  let proven = base.get(spec, "restrict", false)
  assert(base.kind(proven) == "bool",
         "c: restrict proof must be a Boolean")
  return enabled == true || proven == true
}

local fn accepts_with(m: Mod, op: Op, config: dict) -> bool {
  let name = call_name(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if name == "base.list" || name == "operator .." {
    return true
  }
  if name == "base.assert" || ir.target(m, op) == "base.assert" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           ir.type(inputs[0]) == ty("bool") &&
           ir.type(inputs[1]) == ty("str") &&
           ir.type(outputs[0]) == ty("bool")
  }
  if name == "base.copy" {
    return len(inputs) == 1 && len(outputs) == 1 &&
           ir.type(inputs[0]) == ir.type(outputs[0]) &&
           supported(ir.type(outputs[0]), config)
  }
  let resolved = ir.target(m, op)
  if resolved == "tensor.make" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(outputs[0]), config) &&
           supported(ir.type(inputs[1]), config) &&
           len(mem.capacity(m, outputs[0])) ==
             len(tensor.dims(ir.type(outputs[0])))
  }
  if resolved == "tensor.view" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           tensor.valid(ir.type(inputs[0])) &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(inputs[0]), config) &&
           supported(ir.type(outputs[0]), config) &&
           supported(ir.type(inputs[1]), config) &&
           len(mem.capacity(m, outputs[0])) ==
             len(tensor.dims(ir.type(outputs[0])))
  }
  if resolved == "tensor.dim" {
    return len(inputs) == 2 && len(outputs) == 1 &&
           tensor.valid(ir.type(inputs[0])) &&
           supported(ir.type(inputs[0]), config) &&
           integer(ir.type(outputs[0]), config)
  }
  if name == "operator []" {
    if len(outputs) != 1 || len(inputs) < 2 ||
       tensor.valid(ir.type(outputs[0])) {
      return false
    }
    if tensor.valid(ir.type(inputs[0])) {
      return supported(ir.type(inputs[0]), config)
    }
    let source = ir.def(inputs[0])
    return len(inputs) == 2 && ir.live(source) &&
           ir.callee(source) == "base.list"
  }
  if name == "operator []=" {
    return len(outputs) == 1 && len(inputs) >= 3 &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(outputs[0]), config)
  }
  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return supported(ir.type(outputs[0]), config)
  }
  if binary(name) != "" && len(inputs) == 2 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0])) &&
           binary_types(name, inputs, outputs[0], config)
  }
  if unary(name) != "" && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0])) &&
           unary_types(name, inputs[0], outputs[0], config)
  }
  if scalar_name(name, config) && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  return callable(m, target, config) || external_call(m, op, config)
}

fn accepts(m: Mod, op: Op) -> bool {
  return accepts_with(m, op, {})
}

fn accepts(m: Mod, op: Op, config: dict) -> bool {
  return accepts_with(m, op, config)
}

fn frontier(m: Mod) -> list<str> {
  return opt.frontier(m, ir.find("c.accepts", [ty("Mod"), ty("Op")]))
}

fn frontier(m: Mod, config: dict) -> list<str> {
  return opt.frontier(
    m, ir.find("c.accepts", [ty("Mod"), ty("Op"), ty("dict")]), config
  )
}

local fn prepare_with(m: Mod, config: dict) -> bool {
  let limit = len(ir.ops(m)) + 1
  let accept = ir.find(
    "c.accepts", [ty("Mod"), ty("Op"), ty("dict")]
  )
  var changed = opt.expose(m, accept, config, limit)
  if ir.type(m) {
    changed = true
  }
  if opt.expose(m, accept, config, limit) {
    changed = true
  }
  if opt.specialize(m, "stage", "shape") {
    changed = true
  }
  if opt.basic(m) {
    changed = true
  }
  if ir.trim(m) {
    changed = true
  }
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      assert(accepts_with(m, op, config),
             "c: unsupported call remains: " + ir.callee(op))
    }
  }
  return changed
}

fn prepare(m: Mod) -> bool {
  return prepare_with(m, {})
}

fn prepare(m: Mod, config: dict) -> bool {
  return prepare_with(m, config)
}

fn place(m: Mod, scope: str) -> bool {
  assert(scope == "local" || scope == "static",
         "c.place expects local or static storage")
  var changed = false
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      if scope == "static" {
        changed = ir.set(m, fn, "c.place", scope) || changed
      } else {
        if ir.has(fn, "c.place") {
          changed = ir.unset(m, fn, "c.place") || changed
        }
      }
    }
  }
  return changed
}

local fn direct_result(
  value: Val, direct: list<str>, results: list<str>
) -> str {
  assert(len(direct) == len(results),
         "c: direct result map is inconsistent")
  if !tensor.valid(ir.type(value)) {
    return ""
  }
  for i in 0..len(direct) {
    if direct[i] != "" && label(value) == direct[i] {
      return results[i]
    }
  }
  return ""
}

local fn returned_only(value: Val) -> bool {
  let users = ir.users(value)
  return len(users) == 1 && ir.kind(users[0]) == "return"
}

local fn tensor_new(
  m: Mod, op: Op, depth: int, blob: str, data_fns: list<Fn>, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 1,
         "c: tensor construction requires one fill value")
  let output = outputs[0]
  let type = ir.type(output)
  let n = count(type)
  let indent = pad(depth)
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    let target = direct_result(output, direct, results)
    if target == "" {
      out = indent + scalar(tensor.elem(type), config) + " " + val(output) +
            "[" + text(n) + "];\n"
    } else {
      out = indent + scalar(tensor.elem(type), config) + "* " + val(output) +
            " = " + target + ";\n"
    }
  }
  if !ir.has(op, "mem.fill") || ir.meta(op, "mem.fill") != false {
    out += indent + "for (" + index_type(config) +
           " i = 0; i < " + text(n) +
           "; ++i) " + val(output) + "[i] = " +
           expr(m, inputs[0], blob, data_fns, config) + ";\n"
  }
  return out
}

local fn tensor_make(
  m: Mod, op: Op, depth: int, blob: str,
  data_fns: list<Fn>, config: dict
) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 2,
         "c: tensor.make requires a fill and shape")
  let output = outputs[0]
  let n = storage_count(m, output)
  let indent = pad(depth)
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    var storage = n
    if storage == 0 {
      storage = 1
    }
    out = indent + scalar(tensor.elem(ir.type(output)), config) + " " +
          val(output) + "[" + text(storage) + "];\n"
  }
  if !ir.has(op, "mem.fill") || ir.meta(op, "mem.fill") != false {
    out += indent + "for (" + index_type(config) +
           " i = 0; i < " + text(n) + "; ++i) " + val(output) +
           "[i] = " + expr(m, inputs[0], blob, data_fns, config) + ";\n"
  }
  return out
}

local fn tensor_view(
  op: Op, depth: int, config: dict
) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 2,
         "c: tensor.view requires data and shape")
  let output = outputs[0]
  if len(ir.users(output)) == 0 || reuses(op) ||
     val(output) == val(inputs[0]) {
    return ""
  }
  return pad(depth) + scalar(tensor.elem(ir.type(output)), config) + "* " +
         val(output) + " = " + val(inputs[0]) + ";\n"
}

local fn payload_data(op: Op) -> Attr {
  let outputs = ir.outs(op)
  if ir.kind(op) == "constant" && len(outputs) == 1 &&
     tensor.valid(ir.type(outputs[0])) &&
     base.kind(ir.constant(outputs[0])) == "bytes" {
    return ir.constant(outputs[0])
  }
  return {}
}

local fn payload(op: Op) -> bool {
  return base.kind(payload_data(op)) == "bytes"
}

local fn aligned(offset: int, alignment: int) -> int {
  return ((offset + alignment - 1) / alignment) * alignment
}

local fn payload_offsets(m: Mod, config: dict) -> dict {
  var offsets: dict = {}
  var out = 0
  for op in ir.ops(m) {
    if payload(op) {
      let outputs = ir.outs(op)
      assert(len(outputs) == 1,
             "c: tensor payload must have one result")
      out = aligned(
        out, alignment(tensor.elem(ir.type(outputs[0])), config)
      )
      offsets[text(ir.key(outputs[0]))] = out
      out += base.size(payload_data(op))
    }
  }
  return offsets
}

local fn payload_offset(offsets: dict, output: Val) -> int {
  let key = text(ir.key(output))
  assert(base.has(offsets, key),
         "c: tensor constant is outside the payload layout")
  return int(offsets[key])
}

local fn tensor_constant(
  op: Op, depth: int, blob: str, offsets: dict, config: dict
) -> str {
  let outputs = ir.outs(op)
  let data = payload_data(op)
  assert(len(outputs) == 1 && base.kind(data) == "bytes",
         "c: tensor constant requires bytes")
  let output = outputs[0]
  let type = ir.type(output)
  let indent = pad(depth)
  let bytes = base.size(data)
  let elements = count(type)
  assert(bytes == elements * width(tensor.elem(type), config),
         "c: tensor constant byte size does not match its type")
  if blob != "" {
    return indent + "const " + scalar(tensor.elem(type), config) + "* " +
           val(output) + " = (const " + scalar(tensor.elem(type), config) +
           "*)(const void*)(" + blob + " + " +
           text(payload_offset(offsets, output)) + ");\n"
  }
  var storage = elements
  if storage == 0 {
    storage = 1
  }
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    out = indent + scalar(tensor.elem(type), config) + " " + val(output) + "[" +
          text(storage) + "];\n"
  }
  if bytes == 0 {
    return out
  }
  out += indent + "static const unsigned char data_" +
         label(output) +
         "[" + text(bytes) + "] = {0x" + base.hex(data, ", 0x") +
         "};\n" + indent + "memcpy(" + val(output) + ", data_" +
         label(output) + ", " + text(bytes) + ");\n"
  return out
}

local fn copy(
  m: Mod, op: Op, depth: int, blob: str, data_fns: list<Fn>, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  assert(len(inputs) == 1 && len(outputs) == 1,
         "c: copy requires one input and one output")
  let input = inputs[0]
  let output = outputs[0]
  let type = ir.type(output)
  let indent = pad(depth)
  if tensor.valid(type) {
    var out = ""
    if !reuses(op) && !mem.planned(output) {
      let target = direct_result(output, direct, results)
      if target == "" {
        out = indent + scalar(tensor.elem(type), config) + " " + val(output) +
              "[" + text(allocation_count(m, output)) + "];\n"
      } else {
        out = indent + scalar(tensor.elem(type), config) + "* " + val(output) +
              " = " + target + ";\n"
      }
    }
    if val(output) != val(input) {
      var copied = ""
      if tensor.static(type) {
        copied = text(count(type))
      } else {
        var capacity = mem.capacity(m, input)
        var bounded = input
        if len(capacity) != len(tensor.dims(type)) {
          capacity = mem.capacity(m, output)
          bounded = output
        }
        if len(capacity) == len(tensor.dims(type)) {
          copied = text(storage_count(m, bounded))
        } else {
          copied = logical_count(m, input)
        }
      }
      out += indent + "memcpy(" + val(output) + ", " + val(input) + ", " +
             "(" + copied + ") * " +
             text(width(tensor.elem(type), config)) + ");\n"
    }
    return out
  }
  return indent + lhs(op, output, config) + " = " +
         expr(m, input, blob, data_fns, config) + ";\n"
}

local fn compound_identity(
  op: str, value: Val, type: Ty, config: dict
) -> bool {
  if !integer(type, config) || !ir.is_const(value) ||
     base.kind(ir.constant(value)) != "int" {
    return false
  }
  let literal = base.int(ir.constant(value))
  if op == "+" || op == "-" || op == "|" || op == "^" ||
     op == "<<" || op == ">>" {
    return literal == 0
  }
  if op == "*" || op == "/" {
    return literal == 1
  }
  return false
}

local fn call(
  m: Mod, op: Op, depth: int, blob: str, data_fns: list<Fn>, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let name = call_name(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let indent = pad(depth)
  assert(accepts_with(m, op, config), "c: call must be prepared: " + name)
  let resolved = ir.target(m, op)
  if resolved == "tensor.make" {
    return tensor_make(m, op, depth, blob, data_fns, config)
  }
  if resolved == "tensor.view" {
    return tensor_view(op, depth, config)
  }
  if resolved == "tensor.dim" {
    assert(len(inputs) == 2 && len(outputs) == 1,
           "c: tensor.dim requires data and axis")
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) + " = " +
           dimension(m, inputs[0], inputs[1], blob, data_fns, config) + ";\n"
  }
  if name == "base.list" || name == "operator .." {
    return ""
  }
  if name == "base.assert" || resolved == "base.assert" {
    assert(len(inputs) == 2 && len(outputs) == 1,
           "c: assert requires condition and message")
    var out = indent + "assert(" +
              expr(m, inputs[0], blob, data_fns, config) + ");\n"
    if ir.name(outputs[0]) != "" {
      out += indent + lhs(op, outputs[0], config) + " = true;\n"
    }
    return out
  }
  if name == "base.copy" {
    return copy(m, op, depth, blob, data_fns, config, direct, results)
  }
  if name == "operator []" {
    assert(len(outputs) == 1 && len(inputs) >= 2,
           "c: invalid tensor load")
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) +
           " = " +
           index(m, inputs[0], inputs, blob, data_fns, config) + ";\n"
  }
  if name == "operator []=" {
    assert(len(outputs) == 1 && len(inputs) >= 3,
           "c: invalid tensor store")
    var access: list<Val> = [inputs[0]]
    for i in 1..len(inputs) - 1 {
      access += [inputs[i]]
    }
    return indent +
           index(m, inputs[0], access, blob, data_fns, config) + " = " +
           expr(m, inputs[len(inputs) - 1], blob, data_fns, config) + ";\n"
  }

  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return tensor_new(
      m, op, depth, blob, data_fns, config, direct, results
    )
  }
  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    if ir.form(op) == "compound" {
      if compound_identity(
           binary_op, inputs[1], ir.type(outputs[0]), config
         ) {
        return ""
      }
      return indent + val(outputs[0]) + " " + binary_op + "= " +
             expr(m, inputs[1], blob, data_fns, config) + ";\n"
    }
    return indent + lhs(op, outputs[0], config) + " = " +
           expr(m, inputs[0], blob, data_fns, config) + " " + binary_op +
           " " + expr(m, inputs[1], blob, data_fns, config) + ";\n"
  }

  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) + " = " + unary_op +
           expr(m, inputs[0], blob, data_fns, config) + ";\n"
  }

  if len(inputs) == 1 && len(outputs) == 1 && scalar_name(name, config) &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) + " = (" +
           scalar(ty(name), config) + ")(" +
           expr(m, inputs[0], blob, data_fns, config) + ");\n"
  }

  if len(outputs) == 1 {
    let bound = binding(m, op)
    if bound != "" && !tensor.valid(ir.type(outputs[0])) {
      if ir.name(outputs[0]) == "" {
        return ""
      }
      return indent + lhs(op, outputs[0], config) + " = " + bound + "(" +
             args(m, inputs, blob, data_fns, config) + ");\n"
    }
  }

  let callee = symbol(m, target, config)
  var actuals = args(m, inputs, blob, data_fns, config)
  if blob != "" && owned(m, target) && has_fn(data_fns, target) {
    if actuals != "" {
      actuals += ", "
    }
    actuals += blob
  }
  if len(outputs) == 0 {
    return indent + callee + "(" + actuals + ");\n"
  }
  if len(outputs) > 1 {
    assert(!reuses(op), "c: multi-result call cannot update one binding")
    var out = ""
    for i in 0..len(outputs) {
      let output = outputs[i]
      let type = ir.type(output)
      if tensor.valid(type) {
        if !mem.planned(output) {
          let target = direct_result(output, direct, results)
          if target == "" {
            out += indent + scalar(tensor.elem(type), config) + " " +
                   val(output) + "[" +
                   text(allocation_count(m, output)) + "];\n"
          } else {
            out += indent + scalar(tensor.elem(type), config) + "* " +
                   val(output) + " = " + target + ";\n"
          }
        }
      } else {
        out += indent + scalar(type, config) + " " + val(output) + ";\n"
      }
      if actuals != "" {
        actuals += ", "
      }
      if tensor.valid(type) {
        actuals += val(output)
        let dims = tensor.dims(type)
        for axis in 0..len(dims) {
          if base.kind(dims[axis]) != "int" {
            out += indent + index_type(config) + " " + val(output) +
                   "_dim_" + text(axis) + ";\n"
            actuals += ", &" + val(output) + "_dim_" + text(axis)
          }
        }
      } else {
        actuals += "&" + val(output)
      }
    }
    return out + indent + callee + "(" + actuals + ");\n"
  }
  let output = outputs[0]
  if tensor.valid(ir.type(output)) {
    let type = ir.type(output)
    var out = ""
    var destination = val(output)
    if !reuses(op) && !mem.planned(output) {
      let target = direct_result(output, direct, results)
      if target == "" {
        out = indent + scalar(tensor.elem(type), config) + " " + val(output) +
              "[" + text(allocation_count(m, output)) + "];\n"
      } else {
        if returned_only(output) {
          destination = target
        } else {
          out = indent + scalar(tensor.elem(type), config) + "* " +
                val(output) + " = " + target + ";\n"
        }
      }
    }
    if actuals != "" {
      actuals += ", "
    }
    actuals += destination
    let dims = tensor.dims(type)
    for axis in 0..len(dims) {
      if base.kind(dims[axis]) != "int" {
        out += indent + index_type(config) + " " + val(output) +
               "_dim_" + text(axis) + ";\n"
        actuals += ", &" + val(output) + "_dim_" + text(axis)
      }
    }
    out += indent + callee + "(" + actuals + ");\n"
    return out
  }
  if ir.name(output) == "" {
    return ""
  }
  return indent + lhs(op, output, config) + " = " + callee + "(" +
         actuals + ");\n"
}

local fn ret(
  m: Mod, op: Op, depth: int, blob: str, data_fns: list<Fn>, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let values = ir.args(op)
  let indent = pad(depth)
  assert(len(values) == len(results), "c: return arity is inconsistent")
  if len(values) == 0 {
    return indent + "return;\n"
  }
  if len(values) == 1 && !tensor.valid(ir.type(values[0])) {
    return indent + "return " +
           expr(m, values[0], blob, data_fns, config) + ";\n"
  }
  var out = ""
  for i in 0..len(values) {
    let value = values[i]
    let output = results[i]
    var iterator = "i"
    if len(values) != 1 {
      iterator += "_" + text(i)
    }
    if tensor.valid(ir.type(value)) {
      if direct_result(value, direct, results) != output {
        var n = ""
        if tensor.static(ir.type(value)) {
          n = text(count(ir.type(value)))
        } else {
          n = logical_count(m, value)
        }
        out += indent + "for (" + index_type(config) + " " + iterator +
               " = 0; " + iterator + " < " + n + "; ++" + iterator +
               ") " + output + "[" + iterator + "] = " + val(value) + "[" +
               iterator + "];\n"
      }
      let dims = tensor.dims(ir.type(value))
      for axis in 0..len(dims) {
        if base.kind(dims[axis]) != "int" {
          out += indent + "*" + output + "_dim_" + text(axis) + " = " +
                 extent(m, value, axis) + ";\n"
        }
      }
    } else {
      out += indent + "*" + output + " = " +
             expr(m, value, blob, data_fns, config) + ";\n"
    }
  }
  return out + indent + "return;\n"
}

local fn constant(op: Op, depth: int, config: dict) -> str {
  let outputs = ir.outs(op)
  assert(len(outputs) == 1, "c: constant must have one result")
  let output = outputs[0]
  if ir.name(output) == "" {
    return ""
  }
  let form = ir.form(op)
  if form == "var" {
    return pad(depth) + scalar(ir.type(output), config) + " " + val(output) +
           " = " + text(ir.constant(output)) + ";\n"
  }
  if reuses(op) {
    return pad(depth) + val(output) + " = " + text(ir.constant(output)) +
           ";\n"
  }
  assert(form == "hidden" || form == "expr" || form == "let",
         "c: unsupported constant form " + form)
  return ""
}

local fn loop(
  m: Mod, op: Op, depth: int, blob: str, data_fns: list<Fn>, config: dict,
  offsets: dict, direct: list<str>, results: list<str>
) -> str {
  let bodies = ir.blks(op)
  assert(len(bodies) == 1, "c: loop must have one body")
  let body = bodies[0]
  let body_args = ir.args(body)
  let sources = ir.args(op)
  let carried = len(ir.outs(op))
  let iterators = len(body_args) - carried
  assert(iterators > 0 && len(sources) >= iterators,
         "c: loop source structure is invalid")
  var out = ""
  for i in 0..iterators {
    let source = ir.def(sources[i])
    assert(ir.live(source), "c: loop source has no definition")
    let iterator = val(body_args[i])
    if ir.callee(source) == "operator .." {
      let bounds = ir.args(source)
      assert(len(bounds) == 2, "c: range must have two bounds")
      out += pad(depth + i) + "for (" + index_type(config) + " " + iterator +
             " = " +
             expr(m, bounds[0], blob, data_fns, config) + "; " +
             iterator + " < " +
             expr(m, bounds[1], blob, data_fns, config) +
             "; ++" + iterator + ") {\n"
    } else {
      assert(ir.callee(source) == "base.list",
             "c: loop source must be a range or scalar list")
      let items = ir.args(source)
      if len(items) == 0 {
        out += pad(depth + i) + "for (" + index_type(config) + " " + iterator +
               " = 0; " + iterator + " < 0; ++" + iterator + ") {\n"
      } else {
        let index = "index_" + c_name(ir.name(body_args[i]))
        let type = scalar(ir.type(body_args[i]), config)
        out += pad(depth + i) + "for (" + index_type(config) + " " + index +
               " = 0; " + index +
               " < " + text(len(items)) + "; ++" + index + ") {\n"
        out += pad(depth + i + 1) + "const " + type + " " + iterator +
               " = (const " + type + "[]){" +
               args(m, items, blob, data_fns, config) + "}[" + index +
               "];\n"
      }
    }
  }
  out += block(
    m, body, depth + iterators, blob, data_fns, config, offsets, direct,
    results
  )
  for reverse in 0..iterators {
    out += pad(depth + iterators - reverse - 1) + "}\n"
  }
  return out
}

local fn branch(
  m: Mod, op: Op, depth: int, blob: str, data_fns: list<Fn>, config: dict,
  offsets: dict, direct: list<str>, results: list<str>
) -> str {
  let bodies = ir.blks(op)
  let inputs = ir.args(op)
  assert(len(bodies) == 2 && len(inputs) >= 1,
         "c: branch structure is invalid")
  let first = block(
    m, bodies[0], depth + 1, blob, data_fns, config, offsets, direct, results
  )
  let second = block(
    m, bodies[1], depth + 1, blob, data_fns, config, offsets, direct, results
  )
  var condition = expr(m, inputs[0], blob, data_fns, config)
  let source = ir.def(inputs[0])
  if ir.name(inputs[0]) == "" && ir.live(source) &&
     ir.kind(source) == "call" && len(ir.args(source)) == 2 &&
     binary(call_name(m, source)) != "" {
    let values = ir.args(source)
    condition = expr(m, values[0], blob, data_fns, config) + " " +
                binary(call_name(m, source)) + " " +
                expr(m, values[1], blob, data_fns, config)
  }
  var out = pad(depth) + "if (" + condition +
            ") {\n" + first
  if second == "" {
    out += pad(depth) + "}\n"
  } else {
    out += pad(depth) + "} else {\n" + second + pad(depth) + "}\n"
  }
  return out
}

local fn block(
  m: Mod, body: Blk, depth: int, blob: str,
  data_fns: list<Fn>, config: dict,
  offsets: dict, direct: list<str>, results: list<str>
) -> str {
  var out = ""
  for op in ir.ops(body) {
    let kind = ir.kind(op)
    if kind == "call" {
      out += call(m, op, depth, blob, data_fns, config, direct, results)
    } else {
      if kind == "loop" {
        out += loop(
          m, op, depth, blob, data_fns, config, offsets, direct, results
        )
      } else {
        if kind == "branch" {
          let logic = logical(m, op, blob, data_fns, config)
          let outputs = ir.outs(op)
          if logic == "" ||
             (len(outputs) == 1 && ir.name(outputs[0]) != "") {
            out += branch(
              m, op, depth, blob, data_fns, config, offsets, direct, results
            )
          }
        } else {
          if kind == "return" {
            out += ret(m, op, depth, blob, data_fns, config, direct, results)
          } else {
            if kind == "constant" {
              if payload(op) {
                out += tensor_constant(op, depth, blob, offsets, config)
              } else {
                out += constant(op, depth, config)
              }
            } else {
              assert(kind == "yield", "c: unsupported operation kind " + kind)
            }
          }
        }
      }
    }
  }
  return out
}

local fn result_values(fn: Fn) -> list<Val> {
  var out: list<Val> = []
  var count = 0
  for op in ir.ops(fn) {
    if ir.kind(op) == "return" {
      out = ir.args(op)
      count += 1
    }
  }
  if count != 1 {
    return []
  }
  return out
}

local fn direct_labels(m: Mod, fn: Fn) -> list<str> {
  let types = ir.returns(fn)
  let returned = result_values(fn)
  var out: list<str> = []
  for i in 0..len(types) {
    var name = ""
    if len(returned) == len(types) && tensor.valid(types[i]) {
      for op in ir.ops(fn) {
        if ir.kind(op) == "call" && !reuses(op) &&
           ir.target(m, op) != "tensor.view" {
          for value in ir.outs(op) {
            if tensor.valid(ir.type(value)) && !mem.planned(value) &&
               label(value) == label(returned[i]) {
              name = label(returned[i])
            }
          }
        }
      }
    }
    out += [name]
  }
  return out
}

local fn result_taken(
  fn: Fn, blob: str, prior: list<str>, name: str
) -> bool {
  if name == blob && blob != "" {
    return true
  }
  for value in ir.vals(fn) {
    if label(value) == name {
      return true
    }
  }
  for existing in prior {
    if existing == name {
      return true
    }
  }
  return false
}

local fn result_names(fn: Fn, blob: str) -> list<str> {
  let types = ir.returns(fn)
  var out: list<str> = []
  for i in 0..len(types) {
    var name = ""
    var consistent = true
    var found = false
    for op in ir.ops(fn) {
      if ir.kind(op) == "return" {
        let values = ir.args(op)
        assert(len(values) == len(types), "c: return arity is inconsistent")
        let source = ir.name(values[i])
        if source == "" {
          consistent = false
        } else {
          let candidate = c_name(source)
          if found && candidate != name {
            consistent = false
          } else {
            name = candidate
          }
        }
        found = true
      }
    }
    if found && consistent {
      name += "_out"
    }
    if !found || !consistent || result_taken(fn, blob, out, name) {
      name = ""
      var base = "out"
      if len(types) != 1 {
        base += "_" + text(i)
      }
      for attempt in 0..len(ir.vals(fn)) + len(types) + 2 {
        var candidate = base
        if attempt != 0 {
          candidate += "_" + text(attempt)
        }
        if name == "" && !result_taken(fn, blob, out, candidate) {
          name = candidate
        }
      }
      assert(name != "", "c: could not name a result parameter")
    }
    out += [name]
  }
  return out
}

local fn signature_text(
  name: str,
  params: list<Ty>,
  names: list<str>,
  returns: list<Ty>,
  results: list<str>,
  blob: str,
  config: dict,
  definition: bool,
  bounded: bool,
  noalias: bool
) -> str {
  assert(len(params) == len(names) && len(returns) == len(results),
         "c: signature names do not match its types")
  assert(definition || !noalias,
         "c: noalias qualifiers belong only to definitions")
  assert(definition || !bounded,
         "c: bounded parameters belong only to definitions")
  var out = "void"
  if len(returns) == 1 && !tensor.valid(returns[0]) {
    out = scalar(returns[0], config)
  }
  out += " " + name + "("
  var arguments = 0
  for i in 0..len(params) {
    if arguments != 0 {
      out += ", "
    }
    let type = params[i]
    if tensor.valid(type) {
      var elements = 0
      if tensor.static(type) {
        elements = count(type)
      }
      out += "const " + scalar(tensor.elem(type), config)
      if bounded && elements > 0 {
        out += " " + names[i] + "["
        if noalias {
          out += "restrict "
        }
        out += "static " + text(elements) + "]"
      } else {
        out += "*"
        if noalias {
          out += " restrict"
        }
        out += " " + names[i]
      }
      let dims = tensor.dims(type)
      for axis in 0..len(dims) {
        if base.kind(dims[axis]) != "int" {
          out += ", " + index_type(config) + " " + names[i] +
                 "_dim_" + text(axis)
          arguments += 1
        }
      }
    } else {
      out += scalar(type, config) + " " + names[i]
    }
    arguments += 1
  }
  if blob != "" {
    if arguments != 0 {
      out += ", "
    }
    out += "const unsigned char*"
    if noalias {
      out += " restrict"
    }
    out += " " + blob
    arguments += 1
  }
  if len(returns) != 1 || tensor.valid(returns[0]) {
    for i in 0..len(returns) {
      if arguments != 0 {
        out += ", "
      }
      let type = returns[i]
      if tensor.valid(type) {
        var elements = 0
        if tensor.static(type) {
          elements = count(type)
        }
        out += scalar(tensor.elem(type), config)
        if bounded && elements > 0 {
          out += " " + results[i] + "["
          if noalias {
            out += "restrict "
          }
          out += "static " + text(elements) + "]"
        } else {
          out += "*"
          if noalias {
            out += " restrict"
          }
          out += " " + results[i]
        }
        let dims = tensor.dims(type)
        for axis in 0..len(dims) {
          if base.kind(dims[axis]) != "int" {
            out += ", " + index_type(config) + "* " + results[i] +
                   "_dim_" + text(axis)
            arguments += 1
          }
        }
      } else {
        out += scalar(type, config) + "* " + results[i]
      }
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn signature(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict,
  definition: bool
) -> str {
  assert(callable(m, fn, config), "c: function has no representable ABI")
  var types: list<Ty> = []
  var names: list<str> = []
  for param in ir.params(fn) {
    types += [ir.type(param)]
    names += [val(param)]
  }
  var data = ""
  if owned(m, fn) && has_fn(data_fns, fn) {
    data = blob
  }
  return signature_text(
    symbol(m, fn, config), types, names, ir.returns(fn),
    result_names(fn, data), data, config,
    definition, definition && ir.local(fn),
    definition && noalias_enabled(fn)
  )
}

local fn external_signature(m: Mod, op: Op, config: dict) -> str {
  assert(external_call(m, op, config),
         "c: external call has no representable ABI")
  let fn = ir.resolve(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let params = ir.params(fn)
  assert(len(params) == len(inputs),
         "c: external call parameter count mismatch")
  var types: list<Ty> = []
  var names: list<str> = []
  var used: list<str> = []
  for i in 0..len(inputs) {
    let name = c_name(ir.name(params[i]))
    for existing in used {
      assert(existing != name,
             "c: external parameters collide after normalization")
    }
    names += [name]
    used += [name]
    types += [ir.type(inputs[i])]
  }
  var returns: list<Ty> = []
  var results: list<str> = []
  for i in 0..len(outputs) {
    returns += [ir.type(outputs[i])]
    var name = ""
    for attempt in 0..len(used) + 2 {
      var candidate = "out"
      if len(outputs) != 1 {
        candidate += "_" + text(i)
      }
      for suffix in 0..attempt {
        candidate += "_"
      }
      var taken = false
      for existing in used {
        taken = existing == candidate || taken
      }
      if name == "" && !taken {
        name = candidate
      }
    }
    assert(name != "", "c: could not name an external result")
    used += [name]
    results += [name]
  }
  return signature_text(
    symbol(m, fn, config), types, names, returns, results, "", config,
    false, false, false
  )
}

local fn external_abi(m: Mod, op: Op, config: dict) -> str {
  assert(external_call(m, op, config),
         "c: external call has no representable ABI")
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  var out = "void("
  if len(outputs) == 1 && !tensor.valid(ir.type(outputs[0])) {
    out = scalar(ir.type(outputs[0]), config) + "("
  }
  var arguments = 0
  for value in inputs {
    if arguments != 0 {
      out += ","
    }
    let type = ir.type(value)
    if tensor.valid(type) {
      out += "const " + scalar(tensor.elem(type), config) + "*"
    } else {
      out += scalar(type, config)
    }
    arguments += 1
  }
  if len(outputs) != 1 || tensor.valid(ir.type(outputs[0])) {
    for value in outputs {
      if arguments != 0 {
        out += ","
      }
      let type = ir.type(value)
      if tensor.valid(type) {
        out += scalar(tensor.elem(type), config) + "*"
      } else {
        out += scalar(type, config) + "*"
      }
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn linkage(m: Mod, fn: Fn) -> str {
  if owned(m, fn) && ir.local(fn) {
    return "static "
  }
  return ""
}

local fn uses_slot(fn: Fn, slot: int) -> bool {
  for value in ir.vals(fn) {
    if mem.planned(value) && mem.slot(value) == slot {
      return true
    }
  }
  return false
}

local fn definition(
  m: Mod, fn: Fn, blob: str, data_fns: list<Fn>, config: dict, offsets: dict
) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  var memory = ""
  var storage = ""
  if ir.has(fn, "c.place") {
    let place = str(ir.meta(fn, "c.place"))
    assert(place == "static", "c: unsupported storage placement " + place)
    storage = "static "
  }
  for slot in 0..mem.slots(fn) {
    if uses_slot(fn, slot) {
      let type = mem.type(fn, slot)
      memory += pad(1) + storage + scalar(type, config) + " slot_" +
                c_name(base.name(type)) + "_" + text(slot) + "[" +
                text(mem.count(fn, slot)) + "];\n"
    }
  }
  var data_name = ""
  if blob != "" && has_fn(data_fns, fn) {
    data_name = blob
  }
  let direct = direct_labels(m, fn)
  let results = result_names(fn, data_name)
  return linkage(m, fn) +
         signature(m, fn, blob, data_fns, config, true) + " {\n" +
         memory +
         block(
           m, bodies[0], 1, data_name, data_fns, config, offsets, direct,
           results
         ) + "}\n"
}

local fn functions(m: Mod) -> list<Fn> {
  var out: list<Fn> = []
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      out += [fn]
    }
  }
  return out
}

local fn exports(m: Mod) -> list<Fn> {
  var visible: list<Fn> = []
  for fn in functions(m) {
    if !ir.local(fn) {
      visible += [fn]
    }
  }
  let entries = ir.where(visible, "entry", true)
  if len(entries) != 0 {
    return entries
  }
  return visible
}

local fn noalias_spec(fn: Fn, enabled: bool) -> dict {
  var out: dict = {}
  if ir.has(fn, "c") {
    let current = ir.meta(fn, "c")
    assert(base.kind(current) == "dict",
           "c: binding must be a dictionary")
    for key in base.keys(current) {
      if key != "noalias" {
        out[key] = base.get(current, key)
      }
    }
  }
  if enabled {
    out["noalias"] = true
  }
  return out
}

fn noalias(m: Mod, enabled: bool) -> bool {
  var changed = false
  for fn in exports(m) {
    let spec = noalias_spec(fn, enabled)
    if len(spec) == 0 {
      changed = ir.unset(m, fn, "c") || changed
    } else {
      changed = ir.set(m, fn, "c", spec) || changed
    }
  }
  return changed
}

fn noalias(m: Mod) -> bool {
  return noalias(m, true)
}

local fn restrict_spec(fn: Fn, enabled: bool) -> dict {
  var out: dict = {}
  if ir.has(fn, "c") {
    let current = ir.meta(fn, "c")
    assert(base.kind(current) == "dict",
           "c: binding must be a dictionary")
    for key in base.keys(current) {
      if key != "restrict" {
        out[key] = base.get(current, key)
      }
    }
  }
  if enabled {
    out["restrict"] = true
  }
  return out
}

local fn pointer_count(op: Op) -> int {
  var out = 0
  for value in ir.args(op) {
    if tensor.valid(ir.type(value)) {
      out += 1
    }
  }
  for value in ir.outs(op) {
    if tensor.valid(ir.type(value)) {
      out += 1
    }
  }
  return out
}

local fn fn_index(fns: list<Fn>, target: Fn) -> int {
  for i in 0..len(fns) {
    if fns[i] == target {
      return i
    }
  }
  return -1
}

fn restrict(m: Mod) -> bool {
  let data_fns = data_functions(m)
  var called: list<Fn> = []
  var separate: list<bool> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "call" {
      let target = ir.resolve(m, op)
      if ir.live(target) && ir.local(target) && len(ir.blks(target)) != 0 {
        var at = fn_index(called, target)
        let safe = pointer_count(op) >= 2 && mem.separate(op)
        if at < 0 {
          called += [target]
          separate += [safe]
        } else {
          separate[at] = separate[at] && safe
        }
      }
    }
  }
  var changed = false
  for fn in ir.fns(m) {
    let at = fn_index(called, fn)
    var enabled = false
    if at >= 0 {
      enabled = separate[at] && !has_fn(data_fns, fn)
    }
    let spec = restrict_spec(fn, enabled)
    if len(spec) == 0 {
      changed = ir.unset(m, fn, "c") || changed
    } else {
      changed = ir.set(m, fn, "c", spec) || changed
    }
  }
  return changed
}

local fn dependencies(m: Mod, config: dict) -> list<Op> {
  var out: list<Op> = []
  var seen_calls: list<Op> = []
  for op in ir.ops(m) {
    if external_call(m, op, config) {
      let fn = ir.resolve(m, op)
      var seen = false
      for existing in seen_calls {
        let prior_fn = ir.resolve(m, existing)
        if symbol(m, prior_fn, config) == symbol(m, fn, config) {
          let prior_abi = external_abi(m, existing, config)
          let current_abi = external_abi(m, op, config)
          assert(prior_abi == current_abi,
                 "c: external symbol " + symbol(m, fn, config) +
                 " has incompatible call ABIs: " + prior_abi + " and " +
                 current_abi)
          assert(binding_header(prior_fn) == binding_header(fn),
                 "c: one external symbol has conflicting headers")
          seen = true
        }
      }
      if !seen {
        seen_calls += [op]
        if binding_header(fn) == "" {
          out += [op]
        }
      }
    }
  }
  return out
}

local fn binding_headers(m: Mod, config: dict) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if external_call(m, op, config) {
      let fn = ir.resolve(m, op)
      let name = binding_header(fn)
      if name != "" {
        var seen = false
        for existing in out {
          seen = seen || existing == name
        }
        if !seen {
          out += [name]
        }
      }
    }
  }
  return out
}

local fn includes(names: list<str>) -> str {
  var out = ""
  var emitted: list<str> = []
  for name in names {
    if name != "" {
      var seen = false
      for existing in emitted {
        seen = seen || existing == name
      }
      if !seen {
        out += "#include <" + name + ">\n"
        emitted += [name]
      }
    }
  }
  return out
}

[memo]
local fn type_header(type: Ty, config: dict) -> str {
  var scalar_type = type
  if tensor.valid(type) {
    scalar_type = tensor.elem(type)
  }
  return str(field(config, base.name(scalar_type), "include"))
}

local fn type_headers(fns: list<Fn>, config: dict) -> list<str> {
  var out: list<str> = []
  for fn in fns {
    for param in ir.params(fn) {
      out += [type_header(ir.type(param), config)]
    }
    for type in ir.returns(fn) {
      out += [type_header(type, config)]
    }
  }
  return out
}

local fn value_headers(fns: list<Fn>, config: dict) -> list<str> {
  var out: list<str> = []
  for fn in fns {
    for value in ir.vals(fn) {
      let type = ir.type(value)
      if supported(type, config) {
        out += [type_header(type, config)]
      }
    }
  }
  return out
}

local fn source_headers(
  m: Mod, fns: list<Fn>, blob: str, config: dict
) -> list<str> {
  var out = binding_headers(m, config) + type_headers(fns, config) +
            value_headers(fns, config)
  out += [type_header(ty("index"), config)]
  var needs_string = false
  var needs_assert = false
  for op in ir.ops(m) {
    if external_call(m, op, config) {
      for value in ir.args(op) {
        out += [type_header(ir.type(value), config)]
      }
      for value in ir.outs(op) {
        out += [type_header(ir.type(value), config)]
      }
    }
    if (blob == "" && payload(op)) ||
       (ir.kind(op) == "call" && ir.callee(op) == "base.copy" &&
        len(ir.outs(op)) == 1 && tensor.valid(ir.type(ir.outs(op)[0]))) {
      needs_string = true
    }
    if ir.kind(op) == "call" &&
       (ir.callee(op) == "base.assert" ||
        ir.target(m, op) == "base.assert") {
      needs_assert = true
    }
  }
  if needs_string {
    out += ["string.h"]
  }
  if needs_assert {
    out += ["assert.h"]
  }
  return out
}

local fn prototypes(
  m: Mod, fns: list<Fn>, calls: list<Op>, blob: str,
  data_fns: list<Fn>, config: dict, definition_syntax: bool
) -> str {
  var declarations = ""
  var names: list<str> = []
  for op in calls {
    let fn = ir.resolve(m, op)
    let name = symbol(m, fn, config)
    for existing in names {
      assert(existing != name,
             "c: overloaded or colliding function name " + name)
    }
    names += [name]
    declarations += external_signature(m, op, config) + ";\n"
  }
  for fn in fns {
    let name = symbol(m, fn, config)
    for existing in names {
      assert(existing != name,
             "c: overloaded or colliding function name " + name)
    }
    names += [name]
    declarations += linkage(m, fn) +
                    signature(
                      m, fn, blob, data_fns, config,
                      definition_syntax && ir.local(fn)
                    ) + ";\n"
  }
  return declarations
}

local fn header_with(m: Mod, blob: str, config: dict) -> str {
  let fns = exports(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  let calls: list<Op> = []
  var data_fns: list<Fn> = []
  if blob != "" {
    data_fns = data_functions(m)
  }
  let declarations = prototypes(m, fns, calls, blob, data_fns, config, false)
  return "#pragma once\n\n" +
         includes(type_headers(fns, config)) + "\n" +
         "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n" +
         declarations +
         "\n#ifdef __cplusplus\n}\n#endif\n"
}

fn header(m: Mod) -> str {
  return header_with(m, "", {})
}

fn header(m: Mod, config: dict) -> str {
  return header_with(m, "", config)
}

fn header(m: Mod, blob: str) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return header_with(m, data_name(m, blob), {})
}

fn header(m: Mod, blob: str, config: dict) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return header_with(m, data_name(m, blob), config)
}

local fn api_value(
  type: Ty, name: str, pointer: bool, config: dict, capacity: list<int>
) -> dict {
  var out: dict = {}
  out["name"] = name
  out["type"] = text(type)
  out["pointer"] = pointer
  if tensor.valid(type) {
    let element = tensor.elem(type)
    var storage = capacity
    var shape: list<Attr> = []
    for dim in tensor.dims(type) {
      if base.kind(dim) == "int" {
        shape += [base.int(dim)]
      } else {
        shape += ["_"]
      }
    }
    var elements = -1
    if tensor.static(type) {
      elements = count(type)
      storage = tensor.shape(type)
    } else {
      if len(storage) == len(tensor.dims(type)) {
        elements = 1
        for extent in storage {
          elements *= extent
        }
      }
    }
    out["c"] = scalar(element, config)
    out["kind"] = class(element, config)
    out["shape"] = shape
    out["capacity"] = storage
    out["dynamic"] = !tensor.static(type)
    out["elements"] = elements
    if elements < 0 {
      out["bytes"] = -1
    } else {
      out["bytes"] = elements * width(element, config)
    }
    return out
  }
  out["c"] = scalar(type, config)
  out["kind"] = class(type, config)
  out["shape"] = []
  out["elements"] = 1
  out["bytes"] = width(type, config)
  return out
}

local fn api_with(m: Mod, blob: str, config: dict) -> list<dict> {
  let fns = exports(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  var data_fns: list<Fn> = []
  if blob != "" {
    data_fns = data_functions(m)
  }
  var out: list<dict> = []
  for fn in fns {
    assert(callable(m, fn, config), "c: function has no representable ABI")
    var params: list<dict> = []
    for param in ir.params(fn) {
      let type = ir.type(param)
      params += [api_value(
        type, val(param), tensor.valid(type), config, mem.capacity(m, param)
      )]
    }
    var data = ""
    if blob != "" && owned(m, fn) && has_fn(data_fns, fn) {
      data = blob
    }
    let types = ir.returns(fn)
    let names = result_names(fn, data)
    let returned = result_values(fn)
    var results: list<dict> = []
    for i in 0..len(types) {
      var name = names[i]
      let direct = len(types) == 1 && !tensor.valid(types[i])
      if direct {
        name = ""
      }
      var capacity: list<int> = []
      if len(returned) == len(types) {
        capacity = mem.capacity(m, returned[i])
      }
      results += [api_value(types[i], name, !direct, config, capacity)]
    }
    var entry: dict = {}
    entry["name"] = symbol(m, fn, config)
    entry["declaration"] =
      signature(m, fn, blob, data_fns, config, false) + ";"
    entry["noalias"] = noalias_enabled(fn)
    entry["params"] = params
    entry["results"] = results
    entry["data"] = data
    out += [entry]
  }
  return out
}

fn api(m: Mod) -> list<dict> {
  return api_with(m, "", {})
}

fn api(m: Mod, config: dict) -> list<dict> {
  return api_with(m, "", config)
}

fn api(m: Mod, blob: str) -> list<dict> {
  assert(blob != "", "c: external data name must not be empty")
  return api_with(m, data_name(m, blob), {})
}

fn api(m: Mod, blob: str, config: dict) -> list<dict> {
  assert(blob != "", "c: external data name must not be empty")
  return api_with(m, data_name(m, blob), config)
}

local fn data_with(m: Mod, config: dict) -> bytes {
  var out = hex""
  for op in ir.ops(m) {
    if payload(op) {
      let outputs = ir.outs(op)
      let offset = aligned(
        base.size(out), alignment(tensor.elem(ir.type(outputs[0])), config)
      )
      for i in base.size(out)..offset {
        out += hex"00"
      }
      out += payload_data(op)
    }
  }
  return out
}

fn data(m: Mod) -> bytes {
  return data_with(m, {})
}

fn data(m: Mod, config: dict) -> bytes {
  return data_with(m, config)
}

local fn emit(m: Mod, blob: str, config: dict) -> str {
  let fns = functions(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  let calls = dependencies(m, config)
  var data_fns: list<Fn> = []
  if blob != "" {
    data_fns = data_functions(m)
  }
  var offsets: dict = {}
  if blob != "" {
    offsets = payload_offsets(m, config)
  }
  let declarations = prototypes(m, fns, calls, blob, data_fns, config, true)
  var definitions = ""
  for fn in fns {
    definitions += definition(m, fn, blob, data_fns, config, offsets) + "\n"
  }
  return includes(source_headers(m, fns, blob, config)) + "\n" +
         declarations + "\n" + definitions
}

fn source(m: Mod) -> str {
  return emit(m, "", {})
}

fn source(m: Mod, blob: str) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return emit(m, data_name(m, blob), {})
}

fn source(m: Mod, config: dict) -> str {
  return emit(m, "", config)
}

fn source(m: Mod, blob: str, config: dict) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return emit(m, data_name(m, blob), config)
}
