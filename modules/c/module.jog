module c
use base
use ir
use mem
use opt
use tensor

fn id(text: str) -> str {
  var out = replace(text, ".", "_")
  out = replace(out, " ", "_")
  return out
}

fn val(value: Val) -> str {
  if mem.planned(value) {
    let type = ir.type(value)
    assert(tensor.valid(type), "c: planned value must be a tensor")
    return "jog_mem_" + id(base.name(tensor.elem(type))) + "_" +
           text(mem.slot(value))
  }
  return "v_" + id(ir.name(value))
}

fn scalars() -> dict {
  return {
    bool: "bool",
    f32: "float",
    f64: "double",
    i8: "int8_t",
    i16: "int16_t",
    i32: "int32_t",
    i64: "int64_t",
    index: "int64_t",
    int: "int64_t",
    u8: "uint8_t",
    u16: "uint16_t",
    u32: "uint32_t",
    u64: "uint64_t"
  }
}

fn scalar(type: Ty) -> str {
  let name = base.name(type)
  let types = scalars()
  assert(has(types, name), "c: unsupported scalar type " + text(type))
  return str(types[name])
}

fn scalar_name(name: str) -> bool {
  return has(scalars(), name)
}

fn width(type: Ty) -> int {
  let widths = {
    bool: 1,
    i8: 1, u8: 1,
    i16: 2, u16: 2,
    i32: 4, u32: 4, f32: 4,
    i64: 8, u64: 8, index: 8, int: 8, f64: 8
  }
  let name = base.name(type)
  assert(has(widths, name), "c: unsupported scalar width " + text(type))
  return base.int(widths[name])
}

fn count(type: Ty) -> int {
  assert(tensor.static(type), "c: tensor shape must be static: " + text(type))
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

fn pad(depth: int) -> str {
  var out = ""
  for i in 0..depth {
    out += "  "
  }
  return out
}

fn expr(m: Mod, value: Val) -> str {
  if ir.is_const(value) {
    return text(ir.constant(value))
  }
  if ir.name(value) != "" {
    return val(value)
  }
  let op = ir.def(value)
  assert(ir.live(op) && ir.kind(op) == "call",
         "c: unnamed " + text(ir.type(value)) +
         " value is neither a constant nor a call result")
  let name = ir.callee(op)
  let inputs = ir.args(op)
  if name == "operator []" {
    return index(m, inputs[0], inputs)
  }
  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 {
    return "(" + expr(m, inputs[0]) + " " + binary_op + " " +
           expr(m, inputs[1]) + ")"
  }
  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 {
    return "(" + unary_op + expr(m, inputs[0]) + ")"
  }
  if len(inputs) == 1 && scalar_name(name) {
    return "((" + scalar(ty(name)) + ")(" + expr(m, inputs[0]) + "))"
  }
  let target = ir.resolve(m, op)
  if ir.live(target) && local(m, target) && len(ir.outs(op)) == 1 &&
     len(ir.users(value)) == 1 {
    return "jog_" + id(ir.name(target)) + "(" + args(m, inputs) + ")"
  }
  assert(false, "c: unnamed call must be assigned or exposed: " + name)
  return ""
}

fn update(output: Val, inputs: list<Val>) -> bool {
  for input in inputs {
    if ir.name(output) == ir.name(input) && ir.name(output) != "" {
      return true
    }
  }
  return false
}

fn lhs(output: Val, inputs: list<Val>) -> str {
  if update(output, inputs) {
    return val(output)
  }
  return scalar(ir.type(output)) + " " + val(output)
}

fn index(m: Mod, value: Val, indices: list<Val>) -> str {
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.shape(type)
    assert(len(indices) == 2 || len(indices) == len(shape) + 1,
           "c: tensor index must be linear or match its rank")
    var out = expr(m, indices[1])
    if len(indices) != 2 {
      for i in 2..len(indices) {
        out = "(" + out + " * " + text(shape[i - 1]) + " + " +
              expr(m, indices[i]) + ")"
      }
    }
    return val(value) + "[" + out + "]"
  }
  let source = ir.def(value)
  let types = base.args(type)
  assert(base.name(type) == "list" && len(types) == 1 &&
         len(indices) == 2 &&
         ir.live(source) && ir.callee(source) == "base.list",
         "c: scalar index requires a literal list")
  return "((const " + scalar(types[0]) + "[]){" +
         args(m, ir.args(source)) + "})[" + expr(m, indices[1]) + "]"
}

fn local(m: Mod, fn: Fn) -> bool {
  for candidate in ir.fns(m) {
    if candidate == fn {
      return true
    }
  }
  return false
}

fn args(m: Mod, values: list<Val>) -> str {
  var out = ""
  for i in 0..len(values) {
    if i != 0 {
      out += ", "
    }
    out += expr(m, values[i])
  }
  return out
}

fn binary(op: str) -> str {
  let operators = {
    "operator %": "%", "operator &": "&", "operator &&": "&&",
    "operator *": "*", "operator +": "+", "operator -": "-",
    "operator /": "/", "operator <": "<", "operator <<": "<<",
    "operator <=": "<=", "operator ==": "==", "operator >": ">",
    "operator >=": ">=", "operator >>": ">>", "operator ^": "^",
    "operator |": "|", "operator ||": "||", "operator !=": "!="
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

fn unary(op: str) -> str {
  let operators = {
    "operator !": "!", "operator +": "+", "operator -": "-",
    "operator ~": "~"
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

fn math(op: str, type: Ty) -> str {
  let names = {
    "math.ceil": "ceil", "math.exp": "exp", "math.pow": "pow",
    "math.round_even": "nearbyint", "math.sqrt": "sqrt",
    "math.tanh": "tanh"
  }
  let name = base.name(type)
  if base.has(names, op) && (name == "f32" || name == "f64") {
    var suffix = ""
    if name == "f32" {
      suffix = "f"
    }
    return str(names[op]) + suffix
  }
  return ""
}

fn supported(m: Mod, op: Op) -> bool {
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if name == "base.list" || name == "operator .." {
    return true
  }
  if name == "operator []" {
    if len(outputs) != 1 || len(inputs) < 2 ||
       tensor.valid(ir.type(outputs[0])) {
      return false
    }
    if tensor.valid(ir.type(inputs[0])) {
      return true
    }
    let source = ir.def(inputs[0])
    return len(inputs) == 2 && ir.live(source) &&
           ir.callee(source) == "base.list"
  }
  if name == "operator []=" {
    return len(outputs) == 1 && len(inputs) >= 3 &&
           tensor.valid(ir.type(outputs[0]))
  }
  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return true
  }
  if len(inputs) == 1 && len(outputs) == 1 &&
     tensor.static(ir.type(outputs[0])) && ir.is_const(inputs[0]) &&
     base.kind(ir.constant(inputs[0])) == "bytes" &&
     ir.live(target) && ir.symbol(target) == "tensor.literal" {
    return base.size(ir.constant(inputs[0])) ==
           count(ir.type(outputs[0])) * width(tensor.elem(ir.type(outputs[0])))
  }
  if binary(name) != "" && len(inputs) == 2 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  if unary(name) != "" && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  if scalar_name(name) && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  if len(outputs) == 1 && math(name, ir.type(outputs[0])) != "" &&
     (len(inputs) == 1 || len(inputs) == 2) {
    return true
  }
  return ir.live(target) && local(m, target) && len(outputs) <= 1
}

fn prepare(m: Mod) -> bool {
  var changed = false
  var again = true
  var exhausted = false
  let limit = len(ir.ops(m)) + 1
  for round in 0..limit {
    if again {
      let before = ir.revision(m)
      opt.fold(m)
      opt.copy(m)
      var calls: list<Op> = []
      var bodies: list<Fn> = []
      for op in ir.ops(m) {
        if ir.live(op) && ir.kind(op) == "call" && !supported(m, op) {
          let target = ir.resolve(m, op)
          assert(ir.live(target) && len(ir.blks(target)) != 0,
                 "c: call has no exposable body: " + ir.callee(op))
          assert(len(ir.meta(op)) == 0,
                 "c: cannot expose a call carrying metadata: " +
                 ir.callee(op))
          calls += [op]
          bodies += [target]
        }
      }
      if len(calls) != 0 {
        ir.expand(m, calls, bodies)
      }
      again = ir.revision(m) != before
      changed = again || changed
      if round == limit - 1 && again {
        exhausted = true
      }
    }
  }
  assert(!exhausted, "c.prepare did not converge")
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      assert(supported(m, op),
             "c: unsupported call remains: " + ir.callee(op))
    }
  }
  return changed
}

fn tensor_new(m: Mod, op: Op, depth: int) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 1,
         "c: tensor construction requires one fill value")
  let output = outputs[0]
  let type = ir.type(output)
  let n = count(type)
  let indent = pad(depth)
  var out = ""
  if !mem.planned(output) {
    out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
          text(n) + "];\n"
  }
  out += indent + "for (size_t jog_i = 0; jog_i < " + text(n) +
         "; ++jog_i) " + val(output) + "[jog_i] = " +
         expr(m, inputs[0]) + ";\n"
  return out
}

fn tensor_literal(op: Op, depth: int) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 1 && ir.is_const(inputs[0]),
         "c: tensor literal requires constant bytes")
  let output = outputs[0]
  let type = ir.type(output)
  let data = ir.constant(inputs[0])
  let indent = pad(depth)
  let bytes = base.size(data)
  let elements = count(type)
  assert(bytes == elements * width(tensor.elem(type)),
         "c: tensor literal byte size does not match its type")
  var storage = elements
  if storage == 0 {
    storage = 1
  }
  var out = ""
  if !mem.planned(output) {
    out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
          text(storage) + "];\n"
  }
  if bytes == 0 {
    return out
  }
  out += indent + "static const unsigned char jog_data_" +
         id(ir.name(output)) +
         "[" + text(bytes) + "] = \"\\x" + base.hex(data, "\\x") +
         "\";\n" + indent + "memcpy(" + val(output) + ", jog_data_" +
         id(ir.name(output)) + ", " + text(bytes) + ");\n"
  return out
}

fn call(m: Mod, op: Op, depth: int) -> str {
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let indent = pad(depth)
  assert(supported(m, op), "c: call must be prepared: " + name)
  if name == "base.list" || name == "operator .." {
    return ""
  }
  if name == "operator []" {
    assert(len(outputs) == 1 && len(inputs) >= 2,
           "c: invalid tensor load")
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + scalar(ir.type(outputs[0])) + " " + val(outputs[0]) +
           " = " + index(m, inputs[0], inputs) + ";\n"
  }
  if name == "operator []=" {
    assert(len(outputs) == 1 && len(inputs) >= 3,
           "c: invalid tensor store")
    var access: list<Val> = [inputs[0]]
    for i in 1..len(inputs) - 1 {
      access += [inputs[i]]
    }
    return indent + index(m, inputs[0], access) + " = " +
           expr(m, inputs[len(inputs) - 1]) + ";\n"
  }

  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return tensor_new(m, op, depth)
  }
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.literal" {
    return tensor_literal(op, depth)
  }

  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(outputs[0], inputs) + " = " +
           expr(m, inputs[0]) + " " + binary_op + " " +
           expr(m, inputs[1]) + ";\n"
  }

  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(outputs[0], inputs) + " = " + unary_op +
           expr(m, inputs[0]) + ";\n"
  }

  if len(inputs) == 1 && len(outputs) == 1 && scalar_name(name) &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(outputs[0], inputs) + " = (" + scalar(ty(name)) + ")(" +
           expr(m, inputs[0]) + ");\n"
  }

  if len(outputs) == 1 {
    let math_name = math(name, ir.type(outputs[0]))
    if math_name != "" && (len(inputs) == 1 || len(inputs) == 2) {
      if ir.name(outputs[0]) == "" {
        return ""
      }
      return indent + lhs(outputs[0], inputs) + " = " + math_name + "(" +
             args(m, inputs) + ");\n"
    }
  }

  let callee = "jog_" + id(ir.name(target))
  var actuals = args(m, inputs)
  if len(outputs) == 0 {
    return indent + callee + "(" + actuals + ");\n"
  }
  let output = outputs[0]
  if tensor.valid(ir.type(output)) {
    let type = ir.type(output)
    var out = ""
    if !mem.planned(output) {
      out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
            text(count(type)) + "];\n"
    }
    if len(inputs) != 0 {
      actuals += ", "
    }
    out += indent + callee + "(" + actuals + val(output) + ");\n"
    return out
  }
  if ir.name(output) == "" {
    return ""
  }
  return indent + lhs(output, inputs) + " = " + callee + "(" +
         actuals + ");\n"
}

fn ret(m: Mod, op: Op, depth: int) -> str {
  let values = ir.args(op)
  assert(len(values) == 1, "c: functions must return exactly one value")
  let value = values[0]
  let indent = pad(depth)
  if !tensor.valid(ir.type(value)) {
    return indent + "return " + expr(m, value) + ";\n"
  }
  assert(ir.name(value) != "",
         "c: returned tensor computation must be assigned or exposed")
  let n = count(ir.type(value))
  return indent + "for (size_t jog_i = 0; jog_i < " + text(n) +
         "; ++jog_i) jog_out[jog_i] = " + val(value) + "[jog_i];\n"
}

fn constant(op: Op, depth: int) -> str {
  let outputs = ir.outs(op)
  assert(len(outputs) == 1, "c: constant must have one result")
  let output = outputs[0]
  for user in ir.users(output) {
    for next in ir.outs(user) {
      if update(next, ir.args(user)) {
        return pad(depth) + scalar(ir.type(output)) + " " + val(output) +
               " = " + text(ir.constant(output)) + ";\n"
      }
    }
  }
  return ""
}

fn loop(m: Mod, op: Op, depth: int) -> str {
  let bodies = ir.blks(op)
  assert(len(bodies) == 1, "c: loop must have one body")
  let body = bodies[0]
  let body_args = ir.args(body)
  let sources = ir.args(op)
  let carried = len(ir.outs(op))
  let iterators = len(body_args) - carried
  assert(iterators > 0 && len(sources) >= iterators,
         "c: loop source structure is invalid")
  var out = ""
  for i in 0..iterators {
    let source = ir.def(sources[i])
    assert(ir.live(source), "c: loop source has no definition")
    let iterator = val(body_args[i])
    if ir.callee(source) == "operator .." {
      let bounds = ir.args(source)
      assert(len(bounds) == 2, "c: range must have two bounds")
      out += pad(depth + i) + "for (int64_t " + iterator + " = " +
             expr(m, bounds[0]) + "; " + iterator + " < " +
             expr(m, bounds[1]) +
             "; ++" + iterator + ") {\n"
    } else {
      assert(ir.callee(source) == "base.list",
             "c: loop source must be a range or scalar list")
      let items = ir.args(source)
      if len(items) == 0 {
        out += pad(depth + i) + "for (int64_t " + iterator +
               " = 0; " + iterator + " < 0; ++" + iterator + ") {\n"
      } else {
        let index = "jog_i_" + id(ir.name(body_args[i]))
        let type = scalar(ir.type(body_args[i]))
        out += pad(depth + i) + "for (size_t " + index + " = 0; " + index +
               " < " + text(len(items)) + "; ++" + index + ") {\n"
        out += pad(depth + i + 1) + "const " + type + " " + iterator +
               " = (const " + type + "[]){" + args(m, items) + "}[" + index +
               "];\n"
      }
    }
  }
  out += block(m, body, depth + iterators)
  for reverse in 0..iterators {
    out += pad(depth + iterators - reverse - 1) + "}\n"
  }
  return out
}

fn branch(m: Mod, op: Op, depth: int) -> str {
  let bodies = ir.blks(op)
  let inputs = ir.args(op)
  assert(len(bodies) == 2 && len(inputs) >= 1,
         "c: branch structure is invalid")
  let first = block(m, bodies[0], depth + 1)
  let second = block(m, bodies[1], depth + 1)
  var out = pad(depth) + "if (" + expr(m, inputs[0]) + ") {\n" + first
  if second == "" {
    out += pad(depth) + "}\n"
  } else {
    out += pad(depth) + "} else {\n" + second + pad(depth) + "}\n"
  }
  return out
}

fn block(m: Mod, body: Blk, depth: int) -> str {
  var out = ""
  for op in ir.ops(body) {
    let kind = ir.kind(op)
    if kind == "call" {
      out += call(m, op, depth)
    } else {
      if kind == "loop" {
        out += loop(m, op, depth)
      } else {
        if kind == "branch" {
          out += branch(m, op, depth)
        } else {
          if kind == "return" {
            out += ret(m, op, depth)
          } else {
            if kind == "constant" {
              out += constant(op, depth)
            } else {
              assert(kind == "yield", "c: unsupported operation kind " + kind)
            }
          }
        }
      }
    }
  }
  return out
}

fn signature(fn: Fn) -> str {
  let returns = ir.returns(fn)
  assert(len(returns) == 1, "c: function must have exactly one result")
  let result = returns[0]
  var out = ""
  if tensor.valid(result) {
    count(result)
    out = "void"
  } else {
    out = scalar(result)
  }
  out += " jog_" + id(ir.name(fn)) + "("
  let params = ir.params(fn)
  for i in 0..len(params) {
    if i != 0 {
      out += ", "
    }
    let type = ir.type(params[i])
    if tensor.valid(type) {
      count(type)
      out += "const " + scalar(tensor.elem(type)) + "* " + val(params[i])
    } else {
      out += scalar(type) + " " + val(params[i])
    }
  }
  if tensor.valid(result) {
    if len(params) != 0 {
      out += ", "
    }
    out += scalar(tensor.elem(result)) + "* jog_out"
  }
  return out + ")"
}

fn definition(m: Mod, fn: Fn) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  var memory = ""
  for slot in 0..mem.slots(fn) {
    let type = mem.type(fn, slot)
    memory += pad(1) + scalar(type) + " jog_mem_" + id(base.name(type)) +
              "_" + text(slot) + "[" + text(mem.count(fn, slot)) + "];\n"
  }
  return signature(fn) + " {\n" + memory + block(m, bodies[0], 1) + "}\n"
}

fn source(m: Mod) -> str {
  var declarations = ""
  var definitions = ""
  var names: list<str> = []
  var count = 0
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      let name = id(ir.name(fn))
      for existing in names {
        assert(existing != name,
               "c: overloaded or colliding function name " + name)
      }
      names += [name]
      declarations += signature(fn) + ";\n"
      definitions += definition(m, fn) + "\n"
      count += 1
    }
  }
  assert(count != 0, "c: module has no function definitions")
  return "#include <math.h>\n#include <stdbool.h>\n#include <stddef.h>\n" +
         "#include <stdint.h>\n" +
         "#include <string.h>\n\n" +
         declarations + "\n" + definitions
}
