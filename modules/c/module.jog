module c
use base
use ir
use mem
use opt
use tensor

local fn label(value: Val) -> str {
  let name = ir.name(value)
  if name == "" {
    return "v" + text(ir.key(value))
  }
  return base.ident(name)
}

local fn val(value: Val) -> str {
  if mem.planned(value) {
    let type = ir.type(value)
    assert(tensor.valid(type), "c: planned value must be a tensor")
    return "jog_mem_" + base.ident(base.name(tensor.elem(type))) + "_" +
           text(mem.slot(value))
  }
  if ir.name(value) == "" {
    return label(value)
  }
  return "v_" + label(value)
}

fn abi() -> dict {
  return {
    "bool.c": "bool",       "bool.bytes": 1,
    "f32.c": "float",       "f32.bytes": 4,
    "f64.c": "double",      "f64.bytes": 8,
    "i8.c": "int8_t",       "i8.bytes": 1,
    "i16.c": "int16_t",     "i16.bytes": 2,
    "i32.c": "int32_t",     "i32.bytes": 4,
    "i64.c": "int64_t",     "i64.bytes": 8,
    "index.c": "int64_t",   "index.bytes": 8,
    "int.c": "int64_t",     "int.bytes": 8,
    "u8.c": "uint8_t",      "u8.bytes": 1,
    "u16.c": "uint16_t",    "u16.bytes": 2,
    "u32.c": "uint32_t",    "u32.bytes": 4,
    "u64.c": "uint64_t",    "u64.bytes": 8
  }
}

local fn abi(name: str, field: str) -> Attr {
  let layout = abi()
  let key = name + "." + field
  assert(has(layout, key), "c: ABI has no " + key)
  return layout[key]
}

local fn scalar(type: Ty) -> str {
  let name = base.name(type)
  return str(abi(name, "c"))
}

local fn scalar_name(name: str) -> bool {
  return has(abi(), name + ".c")
}

local fn width(type: Ty) -> int {
  return base.int(abi(base.name(type), "bytes"))
}

local fn count_type() -> str {
  return "size_t"
}

local fn index_type() -> str {
  return scalar(ty("index"))
}

local fn count(type: Ty) -> int {
  assert(tensor.static(type), "c: tensor shape must be static: " + text(type))
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

local fn pad(depth: int) -> str {
  var out = ""
  for i in 0..depth {
    out += "  "
  }
  return out
}

local fn logical(m: Mod, op: Op) -> str {
  if ir.kind(op) != "branch" {
    return ""
  }
  let inputs = ir.args(op)
  let bodies = ir.blks(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(bodies) != 2 || len(outputs) != 1 ||
     ir.type(outputs[0]) != ty("bool") {
    return ""
  }
  let first_args = ir.args(bodies[0])
  let second_args = ir.args(bodies[1])
  let first_ops = ir.ops(bodies[0])
  let second_ops = ir.ops(bodies[1])
  if len(first_args) != 1 || len(second_args) != 1 ||
     len(first_ops) == 0 || len(second_ops) == 0 {
    return ""
  }
  let first_yield = first_ops[len(first_ops) - 1]
  let second_yield = second_ops[len(second_ops) - 1]
  if ir.kind(first_yield) != "yield" ||
     ir.kind(second_yield) != "yield" ||
     len(ir.args(first_yield)) != 1 || len(ir.args(second_yield)) != 1 {
    return ""
  }
  let first = ir.args(first_yield)[0]
  let second = ir.args(second_yield)[0]
  if second == second_args[0] && first != first_args[0] {
    return "(" + expr(m, inputs[0]) + " && " + expr(m, first) + ")"
  }
  if first == first_args[0] && second != second_args[0] {
    return "(" + expr(m, inputs[0]) + " || " + expr(m, second) + ")"
  }
  return ""
}

local fn expr(m: Mod, value: Val) -> str {
  if ir.is_const(value) {
    let source = ir.def(value)
    if ir.form(source) != "var" && !reuses(source) {
      return text(ir.constant(value))
    }
  }
  if ir.name(value) != "" {
    return val(value)
  }
  let op = ir.def(value)
  assert(ir.live(op),
         "c: unnamed " + text(ir.type(value)) +
         " value has no definition")
  if ir.kind(op) == "branch" {
    let out = logical(m, op)
    assert(out != "", "c: unnamed branch value is not a logical expression")
    return out
  }
  assert(ir.kind(op) == "call",
         "c: unnamed " + text(ir.type(value)) +
         " value is neither a constant nor a call result")
  let name = ir.callee(op)
  let inputs = ir.args(op)
  if name == "operator []" {
    return index(m, inputs[0], inputs)
  }
  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 {
    return "(" + expr(m, inputs[0]) + " " + binary_op + " " +
           expr(m, inputs[1]) + ")"
  }
  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 {
    return "(" + unary_op + expr(m, inputs[0]) + ")"
  }
  if len(inputs) == 1 && scalar_name(name) {
    return "((" + scalar(ty(name)) + ")(" + expr(m, inputs[0]) + "))"
  }
  let math_name = math(m, op)
  if math_name != "" && (len(inputs) == 1 || len(inputs) == 2) {
    return math_name + "(" + args(m, inputs) + ")"
  }
  let target = ir.resolve(m, op)
  if callable(m, target) && len(ir.outs(op)) == 1 &&
     len(ir.users(value)) == 1 {
    return symbol(m, target) + "(" + args(m, inputs) + ")"
  }
  assert(false, "c: unnamed call must be assigned or exposed: " + name)
  return ""
}

local fn reuses(op: Op) -> bool {
  let form = ir.form(op)
  return form == "assign" || form == "compound" || form == "index_assign"
}

local fn lhs(op: Op, output: Val) -> str {
  if reuses(op) {
    return val(output)
  }
  return scalar(ir.type(output)) + " " + val(output)
}

local fn index(m: Mod, value: Val, indices: list<Val>) -> str {
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.shape(type)
    assert(len(indices) == 2 || len(indices) == len(shape) + 1,
           "c: tensor index must be linear or match its rank")
    var out = expr(m, indices[1])
    if len(indices) != 2 {
      for i in 2..len(indices) {
        out = "(" + out + " * " + text(shape[i - 1]) + " + " +
              expr(m, indices[i]) + ")"
      }
    }
    return val(value) + "[" + out + "]"
  }
  let source = ir.def(value)
  let types = base.args(type)
  assert(base.name(type) == "list" && len(types) == 1 &&
         len(indices) == 2 &&
         ir.live(source) && ir.callee(source) == "base.list",
         "c: scalar index requires a literal list")
  return "((const " + scalar(types[0]) + "[]){" +
         args(m, ir.args(source)) + "})[" + expr(m, indices[1]) + "]"
}

local fn owned(m: Mod, fn: Fn) -> bool {
  for candidate in ir.fns(m) {
    if candidate == fn {
      return true
    }
  }
  return false
}

local fn supported(type: Ty) -> bool {
  if tensor.valid(type) {
    return tensor.static(type) && scalar_name(base.name(tensor.elem(type)))
  }
  return scalar_name(base.name(type))
}

local fn callable(m: Mod, fn: Fn) -> bool {
  if !ir.live(fn) || len(ir.generics(fn)) != 0 {
    return false
  }
  for type in ir.returns(fn) {
    if !supported(type) {
      return false
    }
  }
  for param in ir.params(fn) {
    if !supported(ir.type(param)) {
      return false
    }
  }
  return owned(m, fn) || len(ir.blks(fn)) == 0
}

local fn external(m: Mod, fn: Fn) -> bool {
  return callable(m, fn) && !owned(m, fn) && len(ir.blks(fn)) == 0
}

local fn symbol(m: Mod, fn: Fn) -> str {
  assert(callable(m, fn), "c: function has no representable ABI")
  if owned(m, fn) {
    return "jog_" + base.ident(ir.name(fn))
  }
  return "jog_" + base.ident(base.replace(ir.symbol(fn), ".", "_"))
}

local fn args(m: Mod, values: list<Val>) -> str {
  var out = ""
  for i in 0..len(values) {
    if i != 0 {
      out += ", "
    }
    out += expr(m, values[i])
  }
  return out
}

local fn binary(op: str) -> str {
  let operators = {
    "operator %": "%", "operator &": "&", "operator &&": "&&",
    "operator *": "*", "operator +": "+", "operator -": "-",
    "operator /": "/", "operator <": "<", "operator <<": "<<",
    "operator <=": "<=", "operator ==": "==", "operator >": ">",
    "operator >=": ">=", "operator >>": ">>", "operator ^": "^",
    "operator |": "|", "operator ||": "||", "operator !=": "!="
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

local fn unary(op: str) -> str {
  let operators = {
    "operator !": "!", "operator +": "+", "operator -": "-",
    "operator ~": "~"
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

local fn math(op: str, type: Ty) -> str {
  let names = {
    "math.abs": "fabs", "math.ceil": "ceil", "math.erf": "erf",
    "math.exp": "exp", "math.floor": "floor", "math.log": "log",
    "math.pow": "pow", "math.sqrt": "sqrt", "math.tanh": "tanh"
  }
  let name = base.name(type)
  if op == "math.round_even" && (name == "f32" || name == "f64") {
    return "jog_round_even_" + name
  }
  if base.has(names, op) && (name == "f32" || name == "f64") {
    var suffix = ""
    if name == "f32" {
      suffix = "f"
    }
    return str(names[op]) + suffix
  }
  return ""
}

local fn math_support(m: Mod) -> str {
  var need_f32 = false
  var need_f64 = false
  for op in ir.ops(m) {
    if ir.kind(op) == "call" {
      let name = math(m, op)
      need_f32 = need_f32 || name == "jog_round_even_f32"
      need_f64 = need_f64 || name == "jog_round_even_f64"
    }
  }
  var out = ""
  if need_f32 {
    out += "static float jog_round_even_f32(float x) {\n" +
           "  if (!isfinite(x) || x == 0.0f) return x;\n" +
           "  const float lower = floorf(x);\n" +
           "  const float delta = x - lower;\n" +
           "  if (delta < 0.5f) return lower;\n" +
           "  if (delta > 0.5f) return lower + 1.0f;\n" +
           "  return fmodf(lower, 2.0f) == 0.0f ? lower : lower + 1.0f;\n" +
           "}\n\n"
  }
  if need_f64 {
    out += "static double jog_round_even_f64(double x) {\n" +
           "  if (!isfinite(x) || x == 0.0) return x;\n" +
           "  const double lower = floor(x);\n" +
           "  const double delta = x - lower;\n" +
           "  if (delta < 0.5) return lower;\n" +
           "  if (delta > 0.5) return lower + 1.0;\n" +
           "  return fmod(lower, 2.0) == 0.0 ? lower : lower + 1.0;\n" +
           "}\n\n"
  }
  return out
}

local fn math(m: Mod, op: Op) -> str {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return ""
  }
  let direct = math(ir.callee(op), ir.type(outputs[0]))
  if direct != "" {
    return direct
  }
  let target = ir.resolve(m, op)
  if ir.live(target) {
    return math(ir.symbol(target), ir.type(outputs[0]))
  }
  return ""
}

fn accepts(m: Mod, op: Op) -> bool {
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if name == "base.list" || name == "operator .." {
    return true
  }
  if name == "base.copy" {
    return len(inputs) == 1 && len(outputs) == 1 &&
           ir.type(inputs[0]) == ir.type(outputs[0])
  }
  if name == "operator []" {
    if len(outputs) != 1 || len(inputs) < 2 ||
       tensor.valid(ir.type(outputs[0])) {
      return false
    }
    if tensor.valid(ir.type(inputs[0])) {
      return true
    }
    let source = ir.def(inputs[0])
    return len(inputs) == 2 && ir.live(source) &&
           ir.callee(source) == "base.list"
  }
  if name == "operator []=" {
    return len(outputs) == 1 && len(inputs) >= 3 &&
           tensor.valid(ir.type(outputs[0]))
  }
  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return true
  }
  if len(inputs) == 1 && len(outputs) == 1 &&
     tensor.static(ir.type(outputs[0])) && ir.is_const(inputs[0]) &&
     base.kind(ir.constant(inputs[0])) == "bytes" &&
     ir.live(target) && ir.symbol(target) == "tensor.literal" {
    return base.size(ir.constant(inputs[0])) ==
           count(ir.type(outputs[0])) * width(tensor.elem(ir.type(outputs[0])))
  }
  if binary(name) != "" && len(inputs) == 2 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  if unary(name) != "" && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  if scalar_name(name) && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  if math(m, op) != "" && (len(inputs) == 1 || len(inputs) == 2) {
    return true
  }
  return callable(m, target)
}

fn prepare(m: Mod) -> bool {
  let limit = len(ir.ops(m)) + 1
  let changed = opt.expose(m, ir.find("c.accepts"), limit)
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      assert(accepts(m, op),
             "c: unsupported call remains: " + ir.callee(op))
    }
  }
  return changed
}

fn place(m: Mod, scope: str) -> bool {
  assert(scope == "local" || scope == "static",
         "c.place expects local or static storage")
  var changed = false
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      if scope == "static" {
        changed = ir.set(m, fn, "c.place", scope) || changed
      } else {
        if ir.has(fn, "c.place") {
          changed = ir.unset(m, fn, "c.place") || changed
        }
      }
    }
  }
  return changed
}

local fn tensor_new(m: Mod, op: Op, depth: int) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 1,
         "c: tensor construction requires one fill value")
  let output = outputs[0]
  let type = ir.type(output)
  let n = count(type)
  let indent = pad(depth)
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
          text(n) + "];\n"
  }
  out += indent + "for (" + count_type() +
         " jog_i = 0; jog_i < " + text(n) +
         "; ++jog_i) " + val(output) + "[jog_i] = " +
         expr(m, inputs[0]) + ";\n"
  return out
}

local fn tensor_literal(op: Op, depth: int) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 1 && ir.is_const(inputs[0]),
         "c: tensor literal requires constant bytes")
  let output = outputs[0]
  let type = ir.type(output)
  let data = ir.constant(inputs[0])
  let indent = pad(depth)
  let bytes = base.size(data)
  let elements = count(type)
  assert(bytes == elements * width(tensor.elem(type)),
         "c: tensor literal byte size does not match its type")
  var storage = elements
  if storage == 0 {
    storage = 1
  }
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
          text(storage) + "];\n"
  }
  if bytes == 0 {
    return out
  }
  out += indent + "static const unsigned char jog_data_" +
         label(output) +
         "[" + text(bytes) + "] = \"\\x" + base.hex(data, "\\x") +
         "\";\n" + indent + "memcpy(" + val(output) + ", jog_data_" +
         label(output) + ", " + text(bytes) + ");\n"
  return out
}

local fn copy(m: Mod, op: Op, depth: int) -> str {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  assert(len(inputs) == 1 && len(outputs) == 1,
         "c: copy requires one input and one output")
  let input = inputs[0]
  let output = outputs[0]
  let type = ir.type(output)
  let indent = pad(depth)
  if tensor.valid(type) {
    var out = ""
    if !reuses(op) && !mem.planned(output) {
      out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
            text(count(type)) + "];\n"
    }
    if val(output) != val(input) {
      out += indent + "memcpy(" + val(output) + ", " + val(input) + ", " +
             text(count(type) * width(tensor.elem(type))) + ");\n"
    }
    return out
  }
  return indent + lhs(op, output) + " = " +
         expr(m, input) + ";\n"
}

local fn call(m: Mod, op: Op, depth: int) -> str {
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let indent = pad(depth)
  assert(accepts(m, op), "c: call must be prepared: " + name)
  if name == "base.list" || name == "operator .." {
    return ""
  }
  if name == "base.copy" {
    return copy(m, op, depth)
  }
  if name == "operator []" {
    assert(len(outputs) == 1 && len(inputs) >= 2,
           "c: invalid tensor load")
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0]) +
           " = " + index(m, inputs[0], inputs) + ";\n"
  }
  if name == "operator []=" {
    assert(len(outputs) == 1 && len(inputs) >= 3,
           "c: invalid tensor store")
    var access: list<Val> = [inputs[0]]
    for i in 1..len(inputs) - 1 {
      access += [inputs[i]]
    }
    return indent + index(m, inputs[0], access) + " = " +
           expr(m, inputs[len(inputs) - 1]) + ";\n"
  }

  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return tensor_new(m, op, depth)
  }
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.literal" {
    return tensor_literal(op, depth)
  }

  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0]) + " = " +
           expr(m, inputs[0]) + " " + binary_op + " " +
           expr(m, inputs[1]) + ";\n"
  }

  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0]) + " = " + unary_op +
           expr(m, inputs[0]) + ";\n"
  }

  if len(inputs) == 1 && len(outputs) == 1 && scalar_name(name) &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0]) + " = (" + scalar(ty(name)) + ")(" +
           expr(m, inputs[0]) + ");\n"
  }

  if len(outputs) == 1 {
    let math_name = math(m, op)
    if math_name != "" && (len(inputs) == 1 || len(inputs) == 2) {
      if ir.name(outputs[0]) == "" {
        return ""
      }
      return indent + lhs(op, outputs[0]) + " = " + math_name + "(" +
             args(m, inputs) + ");\n"
    }
  }

  let callee = symbol(m, target)
  var actuals = args(m, inputs)
  if len(outputs) == 0 {
    return indent + callee + "(" + actuals + ");\n"
  }
  if len(outputs) > 1 {
    assert(!reuses(op), "c: multi-result call cannot update one binding")
    var out = ""
    for i in 0..len(outputs) {
      let output = outputs[i]
      let type = ir.type(output)
      if tensor.valid(type) {
        if !mem.planned(output) {
          out += indent + scalar(tensor.elem(type)) + " " + val(output) +
                 "[" + text(count(type)) + "];\n"
        }
      } else {
        out += indent + scalar(type) + " " + val(output) + ";\n"
      }
      if actuals != "" {
        actuals += ", "
      }
      if tensor.valid(type) {
        actuals += val(output)
      } else {
        actuals += "&" + val(output)
      }
    }
    return out + indent + callee + "(" + actuals + ");\n"
  }
  let output = outputs[0]
  if tensor.valid(ir.type(output)) {
    let type = ir.type(output)
    var out = ""
    if !reuses(op) && !mem.planned(output) {
      out = indent + scalar(tensor.elem(type)) + " " + val(output) + "[" +
            text(count(type)) + "];\n"
    }
    if len(inputs) != 0 {
      actuals += ", "
    }
    out += indent + callee + "(" + actuals + val(output) + ");\n"
    return out
  }
  if ir.name(output) == "" {
    return ""
  }
  return indent + lhs(op, output) + " = " + callee + "(" +
         actuals + ");\n"
}

local fn ret(m: Mod, op: Op, depth: int) -> str {
  let values = ir.args(op)
  let indent = pad(depth)
  if len(values) == 0 {
    return indent + "return;\n"
  }
  if len(values) == 1 && !tensor.valid(ir.type(values[0])) {
    return indent + "return " + expr(m, values[0]) + ";\n"
  }
  var out = ""
  for i in 0..len(values) {
    let value = values[i]
    var output = "jog_out"
    var iterator = "jog_i"
    if len(values) != 1 {
      output += "_" + text(i)
      iterator += "_" + text(i)
    }
    if tensor.valid(ir.type(value)) {
      let n = count(ir.type(value))
      out += indent + "for (" + count_type() + " " + iterator +
             " = 0; " + iterator + " < " + text(n) + "; ++" + iterator +
             ") " + output + "[" + iterator + "] = " + val(value) + "[" +
             iterator + "];\n"
    } else {
      out += indent + "*" + output + " = " + expr(m, value) + ";\n"
    }
  }
  return out + indent + "return;\n"
}

local fn constant(op: Op, depth: int) -> str {
  let outputs = ir.outs(op)
  assert(len(outputs) == 1, "c: constant must have one result")
  let output = outputs[0]
  if ir.name(output) == "" {
    return ""
  }
  let form = ir.form(op)
  if form == "var" {
    return pad(depth) + scalar(ir.type(output)) + " " + val(output) +
           " = " + text(ir.constant(output)) + ";\n"
  }
  if reuses(op) {
    return pad(depth) + val(output) + " = " + text(ir.constant(output)) +
           ";\n"
  }
  assert(form == "hidden" || form == "expr" || form == "let",
         "c: unsupported constant form " + form)
  return ""
}

local fn loop(m: Mod, op: Op, depth: int) -> str {
  let bodies = ir.blks(op)
  assert(len(bodies) == 1, "c: loop must have one body")
  let body = bodies[0]
  let body_args = ir.args(body)
  let sources = ir.args(op)
  let carried = len(ir.outs(op))
  let iterators = len(body_args) - carried
  assert(iterators > 0 && len(sources) >= iterators,
         "c: loop source structure is invalid")
  var out = ""
  for i in 0..iterators {
    let source = ir.def(sources[i])
    assert(ir.live(source), "c: loop source has no definition")
    let iterator = val(body_args[i])
    if ir.callee(source) == "operator .." {
      let bounds = ir.args(source)
      assert(len(bounds) == 2, "c: range must have two bounds")
      out += pad(depth + i) + "for (" + index_type() + " " + iterator +
             " = " +
             expr(m, bounds[0]) + "; " + iterator + " < " +
             expr(m, bounds[1]) +
             "; ++" + iterator + ") {\n"
    } else {
      assert(ir.callee(source) == "base.list",
             "c: loop source must be a range or scalar list")
      let items = ir.args(source)
      if len(items) == 0 {
        out += pad(depth + i) + "for (" + index_type() + " " + iterator +
               " = 0; " + iterator + " < 0; ++" + iterator + ") {\n"
      } else {
        let index = "jog_i_" + base.ident(ir.name(body_args[i]))
        let type = scalar(ir.type(body_args[i]))
        out += pad(depth + i) + "for (" + count_type() + " " + index +
               " = 0; " + index +
               " < " + text(len(items)) + "; ++" + index + ") {\n"
        out += pad(depth + i + 1) + "const " + type + " " + iterator +
               " = (const " + type + "[]){" + args(m, items) + "}[" + index +
               "];\n"
      }
    }
  }
  out += block(m, body, depth + iterators)
  for reverse in 0..iterators {
    out += pad(depth + iterators - reverse - 1) + "}\n"
  }
  return out
}

local fn branch(m: Mod, op: Op, depth: int) -> str {
  let bodies = ir.blks(op)
  let inputs = ir.args(op)
  assert(len(bodies) == 2 && len(inputs) >= 1,
         "c: branch structure is invalid")
  let first = block(m, bodies[0], depth + 1)
  let second = block(m, bodies[1], depth + 1)
  var out = pad(depth) + "if (" + expr(m, inputs[0]) + ") {\n" + first
  if second == "" {
    out += pad(depth) + "}\n"
  } else {
    out += pad(depth) + "} else {\n" + second + pad(depth) + "}\n"
  }
  return out
}

local fn block(m: Mod, body: Blk, depth: int) -> str {
  var out = ""
  for op in ir.ops(body) {
    let kind = ir.kind(op)
    if kind == "call" {
      out += call(m, op, depth)
    } else {
      if kind == "loop" {
        out += loop(m, op, depth)
      } else {
        if kind == "branch" {
          if logical(m, op) == "" {
            out += branch(m, op, depth)
          }
        } else {
          if kind == "return" {
            out += ret(m, op, depth)
          } else {
            if kind == "constant" {
              out += constant(op, depth)
            } else {
              assert(kind == "yield", "c: unsupported operation kind " + kind)
            }
          }
        }
      }
    }
  }
  return out
}

local fn signature(m: Mod, fn: Fn) -> str {
  assert(callable(m, fn), "c: function has no representable ABI")
  let returns = ir.returns(fn)
  var out = ""
  if len(returns) == 1 && !tensor.valid(returns[0]) {
    out = scalar(returns[0])
  } else {
    out = "void"
  }
  out += " " + symbol(m, fn) + "("
  let params = ir.params(fn)
  var arguments = 0
  for i in 0..len(params) {
    if arguments != 0 {
      out += ", "
    }
    let type = ir.type(params[i])
    if tensor.valid(type) {
      count(type)
      out += "const " + scalar(tensor.elem(type)) + "* " + val(params[i])
    } else {
      out += scalar(type) + " " + val(params[i])
    }
    arguments += 1
  }
  if len(returns) != 1 || tensor.valid(returns[0]) {
    for i in 0..len(returns) {
      if arguments != 0 {
        out += ", "
      }
      let type = returns[i]
      if tensor.valid(type) {
        count(type)
        out += scalar(tensor.elem(type)) + "*"
      } else {
        out += scalar(type) + "*"
      }
      out += " jog_out"
      if len(returns) != 1 {
        out += "_" + text(i)
      }
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn linkage(m: Mod, fn: Fn) -> str {
  if owned(m, fn) && ir.local(fn) {
    return "static "
  }
  return ""
}

local fn definition(m: Mod, fn: Fn) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  var memory = ""
  var storage = ""
  if ir.has(fn, "c.place") {
    let place = str(ir.meta(fn, "c.place"))
    assert(place == "static", "c: unsupported storage placement " + place)
    storage = "static "
  }
  for slot in 0..mem.slots(fn) {
    let type = mem.type(fn, slot)
    memory += pad(1) + storage + scalar(type) + " jog_mem_" +
              base.ident(base.name(type)) + "_" + text(slot) + "[" +
              text(mem.count(fn, slot)) + "];\n"
  }
  return linkage(m, fn) + signature(m, fn) + " {\n" +
         memory + block(m, bodies[0], 1) + "}\n"
}

local fn functions(m: Mod) -> list<Fn> {
  var out: list<Fn> = []
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      out += [fn]
    }
  }
  return out
}

local fn exports(m: Mod) -> list<Fn> {
  var visible: list<Fn> = []
  for fn in functions(m) {
    if !ir.local(fn) {
      visible += [fn]
    }
  }
  let entries = ir.where(visible, "entry", true)
  if len(entries) != 0 {
    return entries
  }
  return visible
}

local fn dependencies(m: Mod) -> list<Fn> {
  var out: list<Fn> = []
  for op in ir.ops(m) {
    if ir.kind(op) == "call" {
      let fn = ir.resolve(m, op)
      if external(m, fn) && math(m, op) == "" {
        var seen = false
        for existing in out {
          seen = existing == fn || seen
        }
        if !seen {
          out += [fn]
        }
      }
    }
  }
  return out
}

local fn prototypes(m: Mod, fns: list<Fn>) -> str {
  var declarations = ""
  var names: list<str> = []
  for fn in fns {
    let name = symbol(m, fn)
    for existing in names {
      assert(existing != name,
             "c: overloaded or colliding function name " + name)
    }
    names += [name]
    declarations += linkage(m, fn) + signature(m, fn) + ";\n"
  }
  return declarations
}

fn header(m: Mod) -> str {
  let fns = exports(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  let declarations = prototypes(m, fns)
  return "#pragma once\n\n" +
         "#include <stdbool.h>\n#include <stdint.h>\n\n" +
         "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n" +
         declarations +
         "\n#ifdef __cplusplus\n}\n#endif\n"
}

fn source(m: Mod) -> str {
  let fns = functions(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  let declarations = prototypes(m, dependencies(m) + fns)
  var definitions = ""
  for fn in fns {
    definitions += definition(m, fn) + "\n"
  }
  return "#include <math.h>\n#include <stdbool.h>\n#include <stddef.h>\n" +
         "#include <stdint.h>\n" +
         "#include <string.h>\n\n" +
         declarations + "\n" + math_support(m) + definitions
}
