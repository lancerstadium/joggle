module c
use base
use ir
use mem
use opt
use tensor

local fn c_name(text: str) -> str {
  let name = base.ident(text)
  let reserved = [
    "alignas", "alignof", "auto", "bool", "break", "case", "char",
    "const", "constexpr", "continue", "default", "do", "double", "else",
    "enum", "extern", "false", "float", "for", "goto", "if", "inline",
    "int", "long", "nullptr", "register", "restrict", "return", "short",
    "signed", "sizeof", "static", "static_assert", "struct", "switch",
    "thread_local", "true", "typedef", "typeof", "typeof_unqual", "union",
    "unsigned", "void", "volatile", "while", "_Alignas", "_Alignof",
    "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary", "_Noreturn",
    "_Static_assert", "_Thread_local"
  ]
  for keyword in reserved {
    if name == keyword {
      return "joggle_" + name
    }
  }
  return name
}

local fn label(value: Val) -> str {
  let name = ir.name(value)
  if name == "" {
    return "joggle_tmp_" + text(ir.key(value))
  }
  return c_name(name)
}

local fn val(value: Val) -> str {
  if mem.planned(value) {
    let type = ir.type(value)
    assert(tensor.valid(type), "c: planned value must be a tensor")
    return "joggle_slot_" + c_name(base.name(tensor.elem(type))) + "_" +
           text(mem.slot(value))
  }
  return label(value)
}

fn abi() -> dict {
  return {
    bool: {name: "bool",     bytes: 1, kind: "bool",     include: "stdbool.h"},
    f32: {name: "float",     bytes: 4, kind: "float",    include: ""},
    f64: {name: "double",    bytes: 8, kind: "float",    include: ""},
    i8: {name: "int8_t",     bytes: 1, kind: "signed",   include: "stdint.h"},
    i16: {name: "int16_t",   bytes: 2, kind: "signed",   include: "stdint.h"},
    i32: {name: "int32_t",   bytes: 4, kind: "signed",   include: "stdint.h"},
    i64: {name: "int64_t",   bytes: 8, kind: "signed",   include: "stdint.h"},
    index: {name: "int64_t", bytes: 8, kind: "signed",   include: "stdint.h"},
    int: {name: "int64_t",   bytes: 8, kind: "signed",   include: "stdint.h"},
    u8: {name: "uint8_t",    bytes: 1, kind: "unsigned", include: "stdint.h"},
    u16: {name: "uint16_t",  bytes: 2, kind: "unsigned", include: "stdint.h"},
    u32: {name: "uint32_t",  bytes: 4, kind: "unsigned", include: "stdint.h"},
    u64: {name: "uint64_t",  bytes: 8, kind: "unsigned", include: "stdint.h"}
  }
}

local fn spec(config: dict, name: str) -> Attr {
  if base.has(config, name) {
    return config[name]
  }
  let defaults = abi()
  assert(base.has(defaults, name), "c: ABI has no type " + name)
  return defaults[name]
}

local fn field(config: dict, name: str, key: str) -> Attr {
  let type = spec(config, name)
  assert(base.kind(type) == "dict",
         "c: ABI type " + name + " must be a dictionary")
  assert(base.has(type, key), "c: ABI type " + name + " has no " + key)
  return base.get(type, key)
}

local fn scalar(type: Ty, config: dict) -> str {
  return str(field(config, base.name(type), "name"))
}

local fn scalar_name(name: str, config: dict) -> bool {
  return base.has(config, name) || base.has(abi(), name)
}

local fn class(type: Ty, config: dict) -> str {
  let name = base.name(type)
  if !scalar_name(name, config) {
    return ""
  }
  return str(field(config, name, "kind"))
}

local fn number(type: Ty, config: dict) -> bool {
  let kind = class(type, config)
  return kind == "signed" || kind == "unsigned" || kind == "float"
}

local fn integer(type: Ty, config: dict) -> bool {
  let kind = class(type, config)
  return kind == "signed" || kind == "unsigned"
}

local fn same_repr(left: Ty, right: Ty, config: dict) -> bool {
  return class(left, config) != "" && class(right, config) != "" &&
         scalar(left, config) == scalar(right, config)
}

local fn width(type: Ty, config: dict) -> int {
  let bytes = base.int(field(config, base.name(type), "bytes"))
  assert(bytes > 0, "c: ABI byte width must be positive")
  return bytes
}

local fn alignment(type: Ty, config: dict) -> int {
  let desc = spec(config, base.name(type))
  var bytes = width(type, config)
  if base.has(desc, "align") {
    bytes = base.int(desc["align"])
  }
  assert(bytes > 0, "c: ABI alignment must be positive")
  return bytes
}

local fn index_type(config: dict) -> str {
  return scalar(ty("index"), config)
}

local fn count(type: Ty) -> int {
  assert(tensor.static(type), "c: tensor shape must be static: " + text(type))
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

local fn pad(depth: int) -> str {
  var out = ""
  for i in 0..depth {
    out += "  "
  }
  return out
}

local fn logical(m: Mod, op: Op, blob: str, config: dict) -> str {
  if ir.kind(op) != "branch" {
    return ""
  }
  let inputs = ir.args(op)
  let bodies = ir.blks(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(bodies) != 2 || len(outputs) != 1 ||
     ir.type(outputs[0]) != ty("bool") {
    return ""
  }
  let first_args = ir.args(bodies[0])
  let second_args = ir.args(bodies[1])
  let first_ops = ir.ops(bodies[0])
  let second_ops = ir.ops(bodies[1])
  if len(first_args) != 1 || len(second_args) != 1 ||
     len(first_ops) == 0 || len(second_ops) == 0 {
    return ""
  }
  let first_yield = first_ops[len(first_ops) - 1]
  let second_yield = second_ops[len(second_ops) - 1]
  if ir.kind(first_yield) != "yield" ||
     ir.kind(second_yield) != "yield" ||
     len(ir.args(first_yield)) != 1 || len(ir.args(second_yield)) != 1 {
    return ""
  }
  let first = ir.args(first_yield)[0]
  let second = ir.args(second_yield)[0]
  if second == second_args[0] && first != first_args[0] {
    return "(" + expr(m, inputs[0], blob, config) + " && " +
           expr(m, first, blob, config) + ")"
  }
  if first == first_args[0] && second != second_args[0] {
    return "(" + expr(m, inputs[0], blob, config) + " || " +
           expr(m, second, blob, config) + ")"
  }
  return ""
}

local fn expr(m: Mod, value: Val, blob: str, config: dict) -> str {
  if ir.is_const(value) {
    let source = ir.def(value)
    if ir.form(source) != "var" && !reuses(source) {
      return text(ir.constant(value))
    }
  }
  if ir.name(value) != "" {
    return val(value)
  }
  let op = ir.def(value)
  assert(ir.live(op),
         "c: unnamed " + text(ir.type(value)) +
         " value has no definition")
  if ir.kind(op) == "branch" {
    let out = logical(m, op, blob, config)
    assert(out != "", "c: unnamed branch value is not a logical expression")
    return out
  }
  assert(ir.kind(op) == "call",
         "c: unnamed " + text(ir.type(value)) +
         " value is neither a constant nor a call result")
  let name = ir.callee(op)
  let inputs = ir.args(op)
  if name == "operator []" {
    return index(m, inputs[0], inputs, blob, config)
  }
  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 {
    return "(" + expr(m, inputs[0], blob, config) + " " + binary_op + " " +
           expr(m, inputs[1], blob, config) + ")"
  }
  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 {
    return "(" + unary_op + expr(m, inputs[0], blob, config) + ")"
  }
  if len(inputs) == 1 && scalar_name(name, config) {
    return "((" + scalar(ty(name), config) + ")(" +
           expr(m, inputs[0], blob, config) + "))"
  }
  let bound = binding(m, op)
  if bound != "" && len(ir.outs(op)) == 1 &&
     !tensor.valid(ir.type(ir.outs(op)[0])) {
    return bound + "(" + args(m, inputs, blob, config) + ")"
  }
  let target = ir.resolve(m, op)
  if callable(m, target, config) && len(ir.outs(op)) == 1 &&
     len(ir.users(value)) == 1 {
    var actuals = args(m, inputs, blob, config)
    if blob != "" && owned(m, target) {
      if actuals != "" {
        actuals += ", "
      }
      actuals += blob
    }
    return symbol(m, target, config) + "(" + actuals + ")"
  }
  assert(false, "c: unnamed call must be assigned or exposed: " + name)
  return ""
}

local fn reuses(op: Op) -> bool {
  let form = ir.form(op)
  return form == "assign" || form == "compound" || form == "index_assign"
}

local fn lhs(op: Op, output: Val, config: dict) -> str {
  if reuses(op) {
    return val(output)
  }
  return scalar(ir.type(output), config) + " " + val(output)
}

local fn index(
  m: Mod, value: Val, indices: list<Val>, blob: str, config: dict
) -> str {
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.shape(type)
    assert(len(indices) == 2 || len(indices) == len(shape) + 1,
           "c: tensor index must be linear or match its rank")
    var out = expr(m, indices[1], blob, config)
    if len(indices) != 2 {
      for i in 2..len(indices) {
        out = "(" + out + " * " + text(shape[i - 1]) + " + " +
              expr(m, indices[i], blob, config) + ")"
      }
    }
    return val(value) + "[" + out + "]"
  }
  let source = ir.def(value)
  let types = base.args(type)
  assert(base.name(type) == "list" && len(types) == 1 &&
         len(indices) == 2 &&
         ir.live(source) && ir.callee(source) == "base.list",
         "c: scalar index requires a literal list")
  return "((const " + scalar(types[0], config) + "[]){" +
         args(m, ir.args(source), blob, config) + "})[" +
         expr(m, indices[1], blob, config) + "]"
}

local fn owned(m: Mod, fn: Fn) -> bool {
  for candidate in ir.fns(m) {
    if candidate == fn {
      return true
    }
  }
  return false
}

local fn data_name(m: Mod, requested: str) -> str {
  let name = c_name(requested)
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      for param in ir.params(fn) {
        assert(val(param) != name,
               "c: external data name collides with parameter " + name)
      }
    }
  }
  return name
}

local fn supported(type: Ty, config: dict) -> bool {
  if tensor.valid(type) {
    return tensor.static(type) &&
           scalar_name(base.name(tensor.elem(type)), config)
  }
  return scalar_name(base.name(type), config)
}

local fn callable(m: Mod, fn: Fn, config: dict) -> bool {
  if !ir.live(fn) || len(ir.generics(fn)) != 0 {
    return false
  }
  for type in ir.returns(fn) {
    if !supported(type, config) {
      return false
    }
  }
  for param in ir.params(fn) {
    if !supported(ir.type(param), config) {
      return false
    }
  }
  return owned(m, fn) || len(ir.blks(fn)) == 0
}

local fn external_call(m: Mod, op: Op, config: dict) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let fn = ir.resolve(m, op)
  if !ir.live(fn) || owned(m, fn) || len(ir.blks(fn)) != 0 ||
     !ir.accepts(op, fn) {
    return false
  }
  if name == "base.list" || name == "operator .." ||
     name == "base.copy" || name == "operator []" ||
     name == "operator []=" ||
     (len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
      ir.symbol(fn) == "tensor.tensor") ||
     (binary(name) != "" && len(inputs) == 2 && len(outputs) == 1) ||
     (unary(name) != "" && len(inputs) == 1 && len(outputs) == 1) ||
     (scalar_name(name, config) && len(inputs) == 1 && len(outputs) == 1) {
    return false
  }
  for value in inputs {
    if !supported(ir.type(value), config) {
      return false
    }
  }
  for value in outputs {
    if !supported(ir.type(value), config) {
      return false
    }
  }
  return true
}

local fn symbol(m: Mod, fn: Fn, config: dict) -> str {
  assert(ir.live(fn), "c: function has no symbol")
  let bound = binding(fn)
  if bound != "" {
    return bound
  }
  return c_name(base.replace(ir.symbol(fn), ".", "_"))
}

local fn args(m: Mod, values: list<Val>, blob: str, config: dict) -> str {
  var out = ""
  for i in 0..len(values) {
    if i != 0 {
      out += ", "
    }
    out += expr(m, values[i], blob, config)
  }
  return out
}

local fn binary(op: str) -> str {
  let operators = {
    "operator %": "%", "operator &": "&", "operator &&": "&&",
    "operator *": "*", "operator +": "+", "operator -": "-",
    "operator /": "/", "operator <": "<", "operator <<": "<<",
    "operator <=": "<=", "operator ==": "==", "operator >": ">",
    "operator >=": ">=", "operator >>": ">>", "operator ^": "^",
    "operator |": "|", "operator ||": "||", "operator !=": "!="
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

local fn unary(op: str) -> str {
  let operators = {
    "operator !": "!", "operator +": "+", "operator -": "-",
    "operator ~": "~"
  }
  if has(operators, op) {
    return str(operators[op])
  }
  return ""
}

local fn binary_types(
  op: str, inputs: list<Val>, output: Val, config: dict
) -> bool {
  if len(inputs) != 2 || binary(op) == "" {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  let result = ir.type(output)
  if op == "operator &&" || op == "operator ||" {
    return class(left, config) != "" && class(right, config) != "" &&
           result == ty("bool")
  }
  if op == "operator ==" || op == "operator !=" ||
     op == "operator <" || op == "operator <=" ||
     op == "operator >" || op == "operator >=" {
    return same_repr(left, right, config) && result == ty("bool")
  }
  if op == "operator <<" || op == "operator >>" {
    return integer(left, config) && integer(right, config) &&
           same_repr(result, left, config)
  }
  if op == "operator %" || op == "operator &" ||
     op == "operator ^" || op == "operator |" {
    return integer(left, config) && integer(right, config) &&
           same_repr(left, right, config) && same_repr(result, left, config)
  }
  return number(left, config) && number(right, config) &&
         same_repr(left, right, config) && same_repr(result, left, config)
}

local fn unary_types(
  op: str, input: Val, output: Val, config: dict
) -> bool {
  let source = ir.type(input)
  let result = ir.type(output)
  if op == "operator !" {
    return class(source, config) != "" && result == ty("bool")
  }
  if op == "operator ~" {
    return integer(source, config) && same_repr(result, source, config)
  }
  return number(source, config) && same_repr(result, source, config)
}

local fn binding(fn: Fn) -> str {
  if !ir.live(fn) || !ir.has(fn, "c") {
    return ""
  }
  let spec = ir.meta(fn, "c")
  assert(base.kind(spec) == "dict", "c: binding must be a dictionary")
  let name = base.get(spec, "name")
  assert(base.kind(name) == "str", "c: binding name must be a string")
  return base.str(name)
}

local fn binding(m: Mod, op: Op) -> str {
  return binding(ir.resolve(m, op))
}

local fn binding_header(fn: Fn) -> str {
  if !ir.live(fn) || !ir.has(fn, "c") {
    return ""
  }
  let spec = ir.meta(fn, "c")
  assert(base.kind(spec) == "dict", "c: binding must be a dictionary")
  let name = base.get(spec, "include", "")
  assert(base.kind(name) == "str", "c: binding header must be a string")
  return base.str(name)
}

local fn accepts_with(m: Mod, op: Op, config: dict) -> bool {
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if name == "base.list" || name == "operator .." {
    return true
  }
  if name == "base.copy" {
    return len(inputs) == 1 && len(outputs) == 1 &&
           ir.type(inputs[0]) == ir.type(outputs[0]) &&
           supported(ir.type(outputs[0]), config)
  }
  if name == "operator []" {
    if len(outputs) != 1 || len(inputs) < 2 ||
       tensor.valid(ir.type(outputs[0])) {
      return false
    }
    if tensor.valid(ir.type(inputs[0])) {
      return supported(ir.type(inputs[0]), config)
    }
    let source = ir.def(inputs[0])
    return len(inputs) == 2 && ir.live(source) &&
           ir.callee(source) == "base.list"
  }
  if name == "operator []=" {
    return len(outputs) == 1 && len(inputs) >= 3 &&
           tensor.valid(ir.type(outputs[0])) &&
           supported(ir.type(outputs[0]), config)
  }
  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return supported(ir.type(outputs[0]), config)
  }
  if binary(name) != "" && len(inputs) == 2 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0])) &&
           binary_types(name, inputs, outputs[0], config)
  }
  if unary(name) != "" && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0])) &&
           unary_types(name, inputs[0], outputs[0], config)
  }
  if scalar_name(name, config) && len(inputs) == 1 && len(outputs) == 1 {
    return !tensor.valid(ir.type(outputs[0]))
  }
  return callable(m, target, config) || external_call(m, op, config)
}

fn accepts(m: Mod, op: Op) -> bool {
  return accepts_with(m, op, {})
}

fn accepts(m: Mod, op: Op, config: dict) -> bool {
  return accepts_with(m, op, config)
}

local fn prepare_with(m: Mod, config: dict) -> bool {
  let limit = len(ir.ops(m)) + 1
  let accept = ir.find(
    "c.accepts", [ty("Mod"), ty("Op"), ty("dict")]
  )
  var changed = opt.expose(m, accept, config, limit)
  if opt.specialize(m, "stage", "shape") {
    changed = true
  }
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      assert(accepts_with(m, op, config),
             "c: unsupported call remains: " + ir.callee(op))
    }
  }
  return changed
}

fn prepare(m: Mod) -> bool {
  return prepare_with(m, {})
}

fn prepare(m: Mod, config: dict) -> bool {
  return prepare_with(m, config)
}

fn place(m: Mod, scope: str) -> bool {
  assert(scope == "local" || scope == "static",
         "c.place expects local or static storage")
  var changed = false
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      if scope == "static" {
        changed = ir.set(m, fn, "c.place", scope) || changed
      } else {
        if ir.has(fn, "c.place") {
          changed = ir.unset(m, fn, "c.place") || changed
        }
      }
    }
  }
  return changed
}

local fn direct_result(
  value: Val, direct: list<str>, results: list<str>
) -> str {
  assert(len(direct) == len(results),
         "c: direct result map is inconsistent")
  if !tensor.valid(ir.type(value)) {
    return ""
  }
  for i in 0..len(direct) {
    if direct[i] != "" && label(value) == direct[i] {
      return results[i]
    }
  }
  return ""
}

local fn tensor_new(
  m: Mod, op: Op, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let outputs = ir.outs(op)
  let inputs = ir.args(op)
  assert(len(outputs) == 1 && len(inputs) == 1,
         "c: tensor construction requires one fill value")
  let output = outputs[0]
  let type = ir.type(output)
  let n = count(type)
  let indent = pad(depth)
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    let target = direct_result(output, direct, results)
    if target == "" {
      out = indent + scalar(tensor.elem(type), config) + " " + val(output) +
            "[" + text(n) + "];\n"
    } else {
      out = indent + scalar(tensor.elem(type), config) + "* " + val(output) +
            " = " + target + ";\n"
    }
  }
  out += indent + "for (" + index_type(config) +
         " joggle_i = 0; joggle_i < " + text(n) +
         "; ++joggle_i) " + val(output) + "[joggle_i] = " +
         expr(m, inputs[0], blob, config) + ";\n"
  return out
}

local fn payload_data(op: Op) -> Attr {
  let outputs = ir.outs(op)
  if ir.kind(op) == "constant" && len(outputs) == 1 &&
     tensor.valid(ir.type(outputs[0])) &&
     base.kind(ir.constant(outputs[0])) == "bytes" {
    return ir.constant(outputs[0])
  }
  return {}
}

local fn payload(op: Op) -> bool {
  return base.kind(payload_data(op)) == "bytes"
}

local fn aligned(offset: int, alignment: int) -> int {
  return ((offset + alignment - 1) / alignment) * alignment
}

local fn payload_offset(m: Mod, target: Op, config: dict) -> int {
  var out = 0
  for op in ir.ops(m) {
    if payload(op) {
      let outputs = ir.outs(op)
      out = aligned(
        out, alignment(tensor.elem(ir.type(outputs[0])), config)
      )
    }
    if op == target {
      return out
    }
    if payload(op) {
      out += base.size(payload_data(op))
    }
  }
  assert(false, "c: tensor constant is outside the module")
  return 0
}

local fn tensor_constant(
  m: Mod, op: Op, depth: int, blob: str, config: dict
) -> str {
  let outputs = ir.outs(op)
  let data = payload_data(op)
  assert(len(outputs) == 1 && base.kind(data) == "bytes",
         "c: tensor constant requires bytes")
  let output = outputs[0]
  let type = ir.type(output)
  let indent = pad(depth)
  let bytes = base.size(data)
  let elements = count(type)
  assert(bytes == elements * width(tensor.elem(type), config),
         "c: tensor constant byte size does not match its type")
  if blob != "" {
    return indent + "const " + scalar(tensor.elem(type), config) + "* " +
           val(output) + " = (const " + scalar(tensor.elem(type), config) +
           "*)(const void*)(" + blob + " + " +
           text(payload_offset(m, op, config)) + ");\n"
  }
  var storage = elements
  if storage == 0 {
    storage = 1
  }
  var out = ""
  if !reuses(op) && !mem.planned(output) {
    out = indent + scalar(tensor.elem(type), config) + " " + val(output) + "[" +
          text(storage) + "];\n"
  }
  if bytes == 0 {
    return out
  }
  out += indent + "static const unsigned char joggle_data_" +
         label(output) +
         "[" + text(bytes) + "] = \"\\x" + base.hex(data, "\\x") +
         "\";\n" + indent + "memcpy(" + val(output) + ", joggle_data_" +
         label(output) + ", " + text(bytes) + ");\n"
  return out
}

local fn copy(
  m: Mod, op: Op, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  assert(len(inputs) == 1 && len(outputs) == 1,
         "c: copy requires one input and one output")
  let input = inputs[0]
  let output = outputs[0]
  let type = ir.type(output)
  let indent = pad(depth)
  if tensor.valid(type) {
    var out = ""
    if !reuses(op) && !mem.planned(output) {
      let target = direct_result(output, direct, results)
      if target == "" {
        out = indent + scalar(tensor.elem(type), config) + " " + val(output) +
              "[" + text(count(type)) + "];\n"
      } else {
        out = indent + scalar(tensor.elem(type), config) + "* " + val(output) +
              " = " + target + ";\n"
      }
    }
    if val(output) != val(input) {
      out += indent + "memcpy(" + val(output) + ", " + val(input) + ", " +
             text(count(type) * width(tensor.elem(type), config)) + ");\n"
    }
    return out
  }
  return indent + lhs(op, output, config) + " = " +
         expr(m, input, blob, config) + ";\n"
}

local fn call(
  m: Mod, op: Op, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let name = ir.callee(op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let indent = pad(depth)
  assert(accepts_with(m, op, config), "c: call must be prepared: " + name)
  if name == "base.list" || name == "operator .." {
    return ""
  }
  if name == "base.copy" {
    return copy(m, op, depth, blob, config, direct, results)
  }
  if name == "operator []" {
    assert(len(outputs) == 1 && len(inputs) >= 2,
           "c: invalid tensor load")
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) +
           " = " + index(m, inputs[0], inputs, blob, config) + ";\n"
  }
  if name == "operator []=" {
    assert(len(outputs) == 1 && len(inputs) >= 3,
           "c: invalid tensor store")
    var access: list<Val> = [inputs[0]]
    for i in 1..len(inputs) - 1 {
      access += [inputs[i]]
    }
    return indent + index(m, inputs[0], access, blob, config) + " = " +
           expr(m, inputs[len(inputs) - 1], blob, config) + ";\n"
  }

  let target = ir.resolve(m, op)
  if len(outputs) == 1 && tensor.valid(ir.type(outputs[0])) &&
     ir.live(target) && ir.symbol(target) == "tensor.tensor" {
    return tensor_new(m, op, depth, blob, config, direct, results)
  }
  let binary_op = binary(name)
  if binary_op != "" && len(inputs) == 2 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) + " = " +
           expr(m, inputs[0], blob, config) + " " + binary_op + " " +
           expr(m, inputs[1], blob, config) + ";\n"
  }

  let unary_op = unary(name)
  if unary_op != "" && len(inputs) == 1 && len(outputs) == 1 &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) + " = " + unary_op +
           expr(m, inputs[0], blob, config) + ";\n"
  }

  if len(inputs) == 1 && len(outputs) == 1 && scalar_name(name, config) &&
     !tensor.valid(ir.type(outputs[0])) {
    if ir.name(outputs[0]) == "" {
      return ""
    }
    return indent + lhs(op, outputs[0], config) + " = (" +
           scalar(ty(name), config) + ")(" +
           expr(m, inputs[0], blob, config) + ");\n"
  }

  if len(outputs) == 1 {
    let bound = binding(m, op)
    if bound != "" && !tensor.valid(ir.type(outputs[0])) {
      if ir.name(outputs[0]) == "" {
        return ""
      }
      return indent + lhs(op, outputs[0], config) + " = " + bound + "(" +
             args(m, inputs, blob, config) + ");\n"
    }
  }

  let callee = symbol(m, target, config)
  var actuals = args(m, inputs, blob, config)
  if blob != "" && owned(m, target) {
    if actuals != "" {
      actuals += ", "
    }
    actuals += blob
  }
  if len(outputs) == 0 {
    return indent + callee + "(" + actuals + ");\n"
  }
  if len(outputs) > 1 {
    assert(!reuses(op), "c: multi-result call cannot update one binding")
    var out = ""
    for i in 0..len(outputs) {
      let output = outputs[i]
      let type = ir.type(output)
      if tensor.valid(type) {
        if !mem.planned(output) {
          let target = direct_result(output, direct, results)
          if target == "" {
            out += indent + scalar(tensor.elem(type), config) + " " +
                   val(output) + "[" + text(count(type)) + "];\n"
          } else {
            out += indent + scalar(tensor.elem(type), config) + "* " +
                   val(output) + " = " + target + ";\n"
          }
        }
      } else {
        out += indent + scalar(type, config) + " " + val(output) + ";\n"
      }
      if actuals != "" {
        actuals += ", "
      }
      if tensor.valid(type) {
        actuals += val(output)
      } else {
        actuals += "&" + val(output)
      }
    }
    return out + indent + callee + "(" + actuals + ");\n"
  }
  let output = outputs[0]
  if tensor.valid(ir.type(output)) {
    let type = ir.type(output)
    var out = ""
    if !reuses(op) && !mem.planned(output) {
      let target = direct_result(output, direct, results)
      if target == "" {
        out = indent + scalar(tensor.elem(type), config) + " " + val(output) +
              "[" + text(count(type)) + "];\n"
      } else {
        out = indent + scalar(tensor.elem(type), config) + "* " + val(output) +
              " = " + target + ";\n"
      }
    }
    if len(inputs) != 0 {
      actuals += ", "
    }
    out += indent + callee + "(" + actuals + val(output) + ");\n"
    return out
  }
  if ir.name(output) == "" {
    return ""
  }
  return indent + lhs(op, output, config) + " = " + callee + "(" +
         actuals + ");\n"
}

local fn ret(
  m: Mod, op: Op, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let values = ir.args(op)
  let indent = pad(depth)
  assert(len(values) == len(results), "c: return arity is inconsistent")
  if len(values) == 0 {
    return indent + "return;\n"
  }
  if len(values) == 1 && !tensor.valid(ir.type(values[0])) {
    return indent + "return " + expr(m, values[0], blob, config) + ";\n"
  }
  var out = ""
  for i in 0..len(values) {
    let value = values[i]
    let output = results[i]
    var iterator = "joggle_i"
    if len(values) != 1 {
      iterator += "_" + text(i)
    }
    if tensor.valid(ir.type(value)) {
      if direct_result(value, direct, results) != output {
        let n = count(ir.type(value))
        out += indent + "for (" + index_type(config) + " " + iterator +
               " = 0; " + iterator + " < " + text(n) + "; ++" + iterator +
               ") " + output + "[" + iterator + "] = " + val(value) + "[" +
               iterator + "];\n"
      }
    } else {
      out += indent + "*" + output + " = " +
             expr(m, value, blob, config) + ";\n"
    }
  }
  return out + indent + "return;\n"
}

local fn constant(op: Op, depth: int, config: dict) -> str {
  let outputs = ir.outs(op)
  assert(len(outputs) == 1, "c: constant must have one result")
  let output = outputs[0]
  if ir.name(output) == "" {
    return ""
  }
  let form = ir.form(op)
  if form == "var" {
    return pad(depth) + scalar(ir.type(output), config) + " " + val(output) +
           " = " + text(ir.constant(output)) + ";\n"
  }
  if reuses(op) {
    return pad(depth) + val(output) + " = " + text(ir.constant(output)) +
           ";\n"
  }
  assert(form == "hidden" || form == "expr" || form == "let",
         "c: unsupported constant form " + form)
  return ""
}

local fn loop(
  m: Mod, op: Op, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let bodies = ir.blks(op)
  assert(len(bodies) == 1, "c: loop must have one body")
  let body = bodies[0]
  let body_args = ir.args(body)
  let sources = ir.args(op)
  let carried = len(ir.outs(op))
  let iterators = len(body_args) - carried
  assert(iterators > 0 && len(sources) >= iterators,
         "c: loop source structure is invalid")
  var out = ""
  for i in 0..iterators {
    let source = ir.def(sources[i])
    assert(ir.live(source), "c: loop source has no definition")
    let iterator = val(body_args[i])
    if ir.callee(source) == "operator .." {
      let bounds = ir.args(source)
      assert(len(bounds) == 2, "c: range must have two bounds")
      out += pad(depth + i) + "for (" + index_type(config) + " " + iterator +
             " = " +
             expr(m, bounds[0], blob, config) + "; " + iterator + " < " +
             expr(m, bounds[1], blob, config) +
             "; ++" + iterator + ") {\n"
    } else {
      assert(ir.callee(source) == "base.list",
             "c: loop source must be a range or scalar list")
      let items = ir.args(source)
      if len(items) == 0 {
        out += pad(depth + i) + "for (" + index_type(config) + " " + iterator +
               " = 0; " + iterator + " < 0; ++" + iterator + ") {\n"
      } else {
        let index = "joggle_i_" + c_name(ir.name(body_args[i]))
        let type = scalar(ir.type(body_args[i]), config)
        out += pad(depth + i) + "for (" + index_type(config) + " " + index +
               " = 0; " + index +
               " < " + text(len(items)) + "; ++" + index + ") {\n"
        out += pad(depth + i + 1) + "const " + type + " " + iterator +
               " = (const " + type + "[]){" +
               args(m, items, blob, config) + "}[" + index +
               "];\n"
      }
    }
  }
  out += block(m, body, depth + iterators, blob, config, direct, results)
  for reverse in 0..iterators {
    out += pad(depth + iterators - reverse - 1) + "}\n"
  }
  return out
}

local fn branch(
  m: Mod, op: Op, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  let bodies = ir.blks(op)
  let inputs = ir.args(op)
  assert(len(bodies) == 2 && len(inputs) >= 1,
         "c: branch structure is invalid")
  let first = block(m, bodies[0], depth + 1, blob, config, direct, results)
  let second = block(m, bodies[1], depth + 1, blob, config, direct, results)
  var out = pad(depth) + "if (" + expr(m, inputs[0], blob, config) +
            ") {\n" + first
  if second == "" {
    out += pad(depth) + "}\n"
  } else {
    out += pad(depth) + "} else {\n" + second + pad(depth) + "}\n"
  }
  return out
}

local fn block(
  m: Mod, body: Blk, depth: int, blob: str, config: dict,
  direct: list<str>, results: list<str>
) -> str {
  var out = ""
  for op in ir.ops(body) {
    let kind = ir.kind(op)
    if kind == "call" {
      out += call(m, op, depth, blob, config, direct, results)
    } else {
      if kind == "loop" {
        out += loop(m, op, depth, blob, config, direct, results)
      } else {
        if kind == "branch" {
          let logic = logical(m, op, blob, config)
          let outputs = ir.outs(op)
          if logic == "" ||
             (len(outputs) == 1 && ir.name(outputs[0]) != "") {
            out += branch(m, op, depth, blob, config, direct, results)
          }
        } else {
          if kind == "return" {
            out += ret(m, op, depth, blob, config, direct, results)
          } else {
            if kind == "constant" {
              if payload(op) {
                out += tensor_constant(m, op, depth, blob, config)
              } else {
                out += constant(op, depth, config)
              }
            } else {
              assert(kind == "yield", "c: unsupported operation kind " + kind)
            }
          }
        }
      }
    }
  }
  return out
}

local fn result_values(fn: Fn) -> list<Val> {
  var out: list<Val> = []
  var count = 0
  for op in ir.ops(fn) {
    if ir.kind(op) == "return" {
      out = ir.args(op)
      count += 1
    }
  }
  if count != 1 {
    return []
  }
  return out
}

local fn direct_labels(fn: Fn) -> list<str> {
  let types = ir.returns(fn)
  let returned = result_values(fn)
  var out: list<str> = []
  for i in 0..len(types) {
    var name = ""
    if len(returned) == len(types) && tensor.valid(types[i]) {
      for op in ir.ops(fn) {
        if ir.kind(op) == "call" && !reuses(op) {
          for value in ir.outs(op) {
            if tensor.valid(ir.type(value)) && !mem.planned(value) &&
               label(value) == label(returned[i]) {
              name = label(returned[i])
            }
          }
        }
      }
    }
    out += [name]
  }
  return out
}

local fn result_taken(
  fn: Fn, blob: str, prior: list<str>, name: str
) -> bool {
  if name == blob && blob != "" {
    return true
  }
  for value in ir.vals(fn) {
    if label(value) == name {
      return true
    }
  }
  for existing in prior {
    if existing == name {
      return true
    }
  }
  return false
}

local fn result_names(fn: Fn, blob: str) -> list<str> {
  let types = ir.returns(fn)
  var out: list<str> = []
  for i in 0..len(types) {
    var name = ""
    var consistent = true
    var found = false
    for op in ir.ops(fn) {
      if ir.kind(op) == "return" {
        let values = ir.args(op)
        assert(len(values) == len(types), "c: return arity is inconsistent")
        let source = ir.name(values[i])
        if source == "" {
          consistent = false
        } else {
          let candidate = c_name(source)
          if found && candidate != name {
            consistent = false
          } else {
            name = candidate
          }
        }
        found = true
      }
    }
    if found && consistent {
      name += "_out"
    }
    if !found || !consistent || result_taken(fn, blob, out, name) {
      name = ""
      var base = "joggle_result"
      if len(types) != 1 {
        base += "_" + text(i)
      }
      for attempt in 0..len(ir.vals(fn)) + len(types) + 2 {
        var candidate = base
        if attempt != 0 {
          candidate += "_" + text(attempt)
        }
        if name == "" && !result_taken(fn, blob, out, candidate) {
          name = candidate
        }
      }
      assert(name != "", "c: could not name a result parameter")
    }
    out += [name]
  }
  return out
}

local fn signature_text(
  name: str,
  params: list<Ty>,
  names: list<str>,
  returns: list<Ty>,
  results: list<str>,
  blob: str,
  config: dict
) -> str {
  assert(len(params) == len(names) && len(returns) == len(results),
         "c: signature names do not match its types")
  var out = "void"
  if len(returns) == 1 && !tensor.valid(returns[0]) {
    out = scalar(returns[0], config)
  }
  out += " " + name + "("
  var arguments = 0
  for i in 0..len(params) {
    if arguments != 0 {
      out += ", "
    }
    let type = params[i]
    if tensor.valid(type) {
      count(type)
      out += "const " + scalar(tensor.elem(type), config) + "* " + names[i]
    } else {
      out += scalar(type, config) + " " + names[i]
    }
    arguments += 1
  }
  if blob != "" {
    if arguments != 0 {
      out += ", "
    }
    out += "const unsigned char* " + blob
    arguments += 1
  }
  if len(returns) != 1 || tensor.valid(returns[0]) {
    for i in 0..len(returns) {
      if arguments != 0 {
        out += ", "
      }
      let type = returns[i]
      if tensor.valid(type) {
        count(type)
        out += scalar(tensor.elem(type), config) + "*"
      } else {
        out += scalar(type, config) + "*"
      }
      out += " " + results[i]
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn signature(m: Mod, fn: Fn, blob: str, config: dict) -> str {
  assert(callable(m, fn, config), "c: function has no representable ABI")
  var types: list<Ty> = []
  var names: list<str> = []
  for param in ir.params(fn) {
    types += [ir.type(param)]
    names += [val(param)]
  }
  var data = ""
  if owned(m, fn) {
    data = blob
  }
  return signature_text(
    symbol(m, fn, config), types, names, ir.returns(fn),
    result_names(fn, blob), data, config
  )
}

local fn external_signature(m: Mod, op: Op, config: dict) -> str {
  assert(external_call(m, op, config),
         "c: external call has no representable ABI")
  let fn = ir.resolve(m, op)
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let params = ir.params(fn)
  assert(len(params) == len(inputs),
         "c: external call parameter count mismatch")
  var types: list<Ty> = []
  var names: list<str> = []
  var used: list<str> = []
  for i in 0..len(inputs) {
    let name = c_name(ir.name(params[i]))
    for existing in used {
      assert(existing != name,
             "c: external parameters collide after normalization")
    }
    names += [name]
    used += [name]
    types += [ir.type(inputs[i])]
  }
  var returns: list<Ty> = []
  var results: list<str> = []
  for i in 0..len(outputs) {
    returns += [ir.type(outputs[i])]
    var name = ""
    for attempt in 0..len(used) + 2 {
      var candidate = "joggle_result"
      if len(outputs) != 1 {
        candidate += "_" + text(i)
      }
      for suffix in 0..attempt {
        candidate += "_"
      }
      var taken = false
      for existing in used {
        taken = existing == candidate || taken
      }
      if name == "" && !taken {
        name = candidate
      }
    }
    assert(name != "", "c: could not name an external result")
    used += [name]
    results += [name]
  }
  return signature_text(
    symbol(m, fn, config), types, names, returns, results, "", config
  )
}

local fn external_abi(m: Mod, op: Op, config: dict) -> str {
  assert(external_call(m, op, config),
         "c: external call has no representable ABI")
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  var out = "void("
  if len(outputs) == 1 && !tensor.valid(ir.type(outputs[0])) {
    out = scalar(ir.type(outputs[0]), config) + "("
  }
  var arguments = 0
  for value in inputs {
    if arguments != 0 {
      out += ","
    }
    let type = ir.type(value)
    if tensor.valid(type) {
      out += "const " + scalar(tensor.elem(type), config) + "*"
    } else {
      out += scalar(type, config)
    }
    arguments += 1
  }
  if len(outputs) != 1 || tensor.valid(ir.type(outputs[0])) {
    for value in outputs {
      if arguments != 0 {
        out += ","
      }
      let type = ir.type(value)
      if tensor.valid(type) {
        out += scalar(tensor.elem(type), config) + "*"
      } else {
        out += scalar(type, config) + "*"
      }
      arguments += 1
    }
  }
  if arguments == 0 {
    out += "void"
  }
  return out + ")"
}

local fn linkage(m: Mod, fn: Fn) -> str {
  if owned(m, fn) && ir.local(fn) {
    return "static "
  }
  return ""
}

local fn definition(m: Mod, fn: Fn, blob: str, config: dict) -> str {
  let bodies = ir.blks(fn)
  assert(len(bodies) >= 1, "c: function has no body")
  var memory = ""
  var storage = ""
  if ir.has(fn, "c.place") {
    let place = str(ir.meta(fn, "c.place"))
    assert(place == "static", "c: unsupported storage placement " + place)
    storage = "static "
  }
  for slot in 0..mem.slots(fn) {
    let type = mem.type(fn, slot)
    memory += pad(1) + storage + scalar(type, config) + " joggle_slot_" +
              c_name(base.name(type)) + "_" + text(slot) + "[" +
              text(mem.count(fn, slot)) + "];\n"
  }
  var data = ""
  if blob != "" {
    data = pad(1) + "(void)" + blob + ";\n"
  }
  let direct = direct_labels(fn)
  let results = result_names(fn, blob)
  return linkage(m, fn) + signature(m, fn, blob, config) + " {\n" +
         data + memory +
         block(m, bodies[0], 1, blob, config, direct, results) + "}\n"
}

local fn functions(m: Mod) -> list<Fn> {
  var out: list<Fn> = []
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      out += [fn]
    }
  }
  return out
}

local fn exports(m: Mod) -> list<Fn> {
  var visible: list<Fn> = []
  for fn in functions(m) {
    if !ir.local(fn) {
      visible += [fn]
    }
  }
  let entries = ir.where(visible, "entry", true)
  if len(entries) != 0 {
    return entries
  }
  return visible
}

local fn dependencies(m: Mod, config: dict) -> list<Op> {
  var out: list<Op> = []
  var seen_calls: list<Op> = []
  for op in ir.ops(m) {
    if external_call(m, op, config) {
      let fn = ir.resolve(m, op)
      var seen = false
      for existing in seen_calls {
        let prior_fn = ir.resolve(m, existing)
        if symbol(m, prior_fn, config) == symbol(m, fn, config) {
          let prior_abi = external_abi(m, existing, config)
          let current_abi = external_abi(m, op, config)
          assert(prior_abi == current_abi,
                 "c: external symbol " + symbol(m, fn, config) +
                 " has incompatible call ABIs: " + prior_abi + " and " +
                 current_abi)
          assert(binding_header(prior_fn) == binding_header(fn),
                 "c: one external symbol has conflicting headers")
          seen = true
        }
      }
      if !seen {
        seen_calls += [op]
        if binding_header(fn) == "" {
          out += [op]
        }
      }
    }
  }
  return out
}

local fn binding_headers(m: Mod, config: dict) -> list<str> {
  var out: list<str> = []
  for op in ir.ops(m) {
    if external_call(m, op, config) {
      let fn = ir.resolve(m, op)
      let name = binding_header(fn)
      if name != "" {
        var seen = false
        for existing in out {
          seen = seen || existing == name
        }
        if !seen {
          out += [name]
        }
      }
    }
  }
  return out
}

local fn includes(names: list<str>) -> str {
  var out = ""
  var emitted: list<str> = []
  for name in names {
    if name != "" {
      var seen = false
      for existing in emitted {
        seen = seen || existing == name
      }
      if !seen {
        out += "#include <" + name + ">\n"
        emitted += [name]
      }
    }
  }
  return out
}

local fn type_header(type: Ty, config: dict) -> str {
  var scalar_type = type
  if tensor.valid(type) {
    scalar_type = tensor.elem(type)
  }
  return str(field(config, base.name(scalar_type), "include"))
}

local fn type_headers(fns: list<Fn>, config: dict) -> list<str> {
  var out: list<str> = []
  for fn in fns {
    for param in ir.params(fn) {
      out += [type_header(ir.type(param), config)]
    }
    for type in ir.returns(fn) {
      out += [type_header(type, config)]
    }
  }
  return out
}

local fn value_headers(fns: list<Fn>, config: dict) -> list<str> {
  var out: list<str> = []
  for fn in fns {
    for value in ir.vals(fn) {
      let type = ir.type(value)
      if supported(type, config) {
        out += [type_header(type, config)]
      }
    }
  }
  return out
}

local fn source_headers(
  m: Mod, fns: list<Fn>, blob: str, config: dict
) -> list<str> {
  var out = binding_headers(m, config) + type_headers(fns, config) +
            value_headers(fns, config)
  out += [type_header(ty("index"), config)]
  var needs_string = false
  for op in ir.ops(m) {
    if external_call(m, op, config) {
      for value in ir.args(op) {
        out += [type_header(ir.type(value), config)]
      }
      for value in ir.outs(op) {
        out += [type_header(ir.type(value), config)]
      }
    }
    if (blob == "" && payload(op)) ||
       (ir.kind(op) == "call" && ir.callee(op) == "base.copy" &&
        len(ir.outs(op)) == 1 && tensor.valid(ir.type(ir.outs(op)[0]))) {
      needs_string = true
    }
  }
  if needs_string {
    out += ["string.h"]
  }
  return out
}

local fn prototypes(
  m: Mod, fns: list<Fn>, calls: list<Op>, blob: str, config: dict
) -> str {
  var declarations = ""
  var names: list<str> = []
  for op in calls {
    let fn = ir.resolve(m, op)
    let name = symbol(m, fn, config)
    for existing in names {
      assert(existing != name,
             "c: overloaded or colliding function name " + name)
    }
    names += [name]
    declarations += external_signature(m, op, config) + ";\n"
  }
  for fn in fns {
    let name = symbol(m, fn, config)
    for existing in names {
      assert(existing != name,
             "c: overloaded or colliding function name " + name)
    }
    names += [name]
    declarations += linkage(m, fn) + signature(m, fn, blob, config) + ";\n"
  }
  return declarations
}

local fn header_with(m: Mod, blob: str, config: dict) -> str {
  let fns = exports(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  let calls: list<Op> = []
  let declarations = prototypes(m, fns, calls, blob, config)
  return "#pragma once\n\n" +
         includes(type_headers(fns, config)) + "\n" +
         "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n" +
         declarations +
         "\n#ifdef __cplusplus\n}\n#endif\n"
}

fn header(m: Mod) -> str {
  return header_with(m, "", {})
}

fn header(m: Mod, config: dict) -> str {
  return header_with(m, "", config)
}

fn header(m: Mod, blob: str) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return header_with(m, data_name(m, blob), {})
}

fn header(m: Mod, blob: str, config: dict) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return header_with(m, data_name(m, blob), config)
}

local fn data_with(m: Mod, config: dict) -> bytes {
  var out = hex""
  for op in ir.ops(m) {
    if payload(op) {
      let outputs = ir.outs(op)
      let offset = aligned(
        base.size(out), alignment(tensor.elem(ir.type(outputs[0])), config)
      )
      for i in base.size(out)..offset {
        out += hex"00"
      }
      out += payload_data(op)
    }
  }
  return out
}

fn data(m: Mod) -> bytes {
  return data_with(m, {})
}

fn data(m: Mod, config: dict) -> bytes {
  return data_with(m, config)
}

local fn emit(m: Mod, blob: str, config: dict) -> str {
  let fns = functions(m)
  assert(len(fns) != 0, "c: module has no function definitions")
  let calls = dependencies(m, config)
  let declarations = prototypes(m, fns, calls, blob, config)
  var definitions = ""
  for fn in fns {
    definitions += definition(m, fn, blob, config) + "\n"
  }
  return includes(source_headers(m, fns, blob, config)) + "\n" +
         declarations + "\n" + definitions
}

fn source(m: Mod) -> str {
  return emit(m, "", {})
}

fn source(m: Mod, blob: str) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return emit(m, data_name(m, blob), {})
}

fn source(m: Mod, config: dict) -> str {
  return emit(m, "", config)
}

fn source(m: Mod, blob: str, config: dict) -> str {
  assert(blob != "", "c: external data name must not be empty")
  return emit(m, data_name(m, blob), config)
}
