joggle 1;

module tensor@1.0.0 {
  import arith@1.0.0;

  interface ranked_tensor: type {
    element_type: type;
    shape: list<int>;
  }

  type ranked(element: type, shape: list<int>) : ranked_tensor {
    element_type = element;
  }
  type unranked(element: type);

  fn cast<From: prelude.scalar, To: prelude.scalar, S: list<int>>(
    input: ranked<From, S>
  ) -> ranked<To, S> : arith.elementwise;
  fn reshape<E: type, From: list<int>, To: list<int>>(
    input: ranked<E, From>,
    shape: To
  ) -> ranked<E, To>;

  fn permute_shape(shape: list<int>, permutation: list<int>) -> list<int> {
    result: list<int> = [];
    for axis in permutation {
      result = append(result, at(shape, axis));
    }
    return result;
  }
  fn transpose<E: type, From: list<int>, P: list<int>>(
    input: ranked<E, From>,
    permutation: P
  ) -> ranked<E, @permute_shape(From, P)>;
  fn broadcast<E: type, From: list<int>, To: list<int>>(
    input: ranked<E, From>,
    shape: To
  ) -> ranked<E, To>;
}
