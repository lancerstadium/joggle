joggle 1;

module fusion@1.0.0 {
  import tensor@1 as t;

  fn conv_relu<X, W, Y>(
    input: X,
    weight: W,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y {
    convolved: Y = t.conv(input, weight, strides, pads, dilations, group);
    return t.relu(convolved);
  }
  fn conv_relu<X, W, B, Y>(
    input: X,
    weight: W,
    bias: B,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y {
    convolved: Y = t.conv(input, weight, bias, strides, pads, dilations, group);
    return t.relu(convolved);
  }
  fn run(input: function) -> function;
  fn run(input: module) -> module;
}
