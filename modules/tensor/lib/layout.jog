local fn concat_runtime<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>, N: int, P: int, Q: int
>(
  left: tensor<E, L>, right: tensor<E, R>, axis: int
) -> tensor<E, Y> {
  assert(N > 0 && P == N && Q == N, "tensor.concat ranks must match")
  var selected = axis
  if selected < 0 { selected += N }
  assert(selected >= 0 && selected < N, "tensor.concat axis is out of range")
  var shape = tensor<index, [N]>(index(0))
  var inner = index(1)
  var count = index(1)
  var left_width = index(0)
  var right_width = index(0)
  [stage: "shape"]
  for item in 0..N {
    let a = dim(left, index(item))
    let b = dim(right, index(item))
    assert(a >= index(0) && b >= index(0), "tensor.concat extent is negative")
    var extent = a
    if item == selected {
      assert(a <= index(9223372036854775807) - b, "tensor.concat extent overflows")
      extent = a + b
      left_width = a
      right_width = b
    } else {
      assert(a == b, "tensor.concat non-concatenated axes must match")
    }
    shape[item] = extent
    assert(extent == index(0) || count <= index(9223372036854775807) / extent,
           "tensor.concat size overflows")
    count *= extent
    if item > selected {
      assert(extent == index(0) || inner <= index(9223372036854775807) / extent,
             "tensor.concat stride overflows")
      inner *= extent
    }
  }
  var out: tensor<E, Y> = make(E(0), shape)
  [stage: "shape"]
  for item in 0..N {
    assert(dim(out, index(item)) == shape[item],
           "tensor.concat result disagrees with its declared shape")
  }
  let width = left_width + right_width
  for i in index(0)..count {
    let coordinate = (i / inner) % width
    let group = i / (width * inner)
    let offset = i % inner
    if coordinate < left_width {
      out[i] = left[(group * left_width + coordinate) * inner + offset]
    } else {
      out[i] = right[
        (group * right_width + coordinate - left_width) * inner + offset
      ]
    }
  }
  return view(out, shape)
}

fn concat<E: Ty, L: list<int>, R: list<int>, Y: list<int>>(
  left: tensor<E, L>, right: tensor<E, R>, axis: int
) -> tensor<E, Y> {
  return concat_runtime<E, L, R, Y, len<L>, len<R>, len<Y>>(left, right, axis)
}

fn one_hot<E: Ty, S: list<int>, Y: list<int>>(
  indices: tensor<index, S>, depth: int, values: tensor<E, [2]>, axis: int
) -> tensor<E, Y> {
  var inner = 1
  for dim in axis..len(S) {
    inner *= S[dim]
  }
  var out = tensor<E, Y>(E(0))
  for i in 0..numel<Y>() {
    let category = (i / inner) % depth
    let source = (i / (inner * depth)) * inner + i % inner
    if indices[source] == category {
      out[i] = values[1]
    } else {
      out[i] = values[0]
    }
  }
  return out
}

fn permutation(axes: list<int>, rank: int) -> bool {
  if len(axes) != rank {
    return false
  }
  for axis in 0..rank {
    var count = 0
    for item in axes {
      if item == axis {
        count += 1
      }
    }
    if count != 1 {
      return false
    }
  }
  return true
}

fn permuted(shape: list<int>, axes: list<int>) -> list<int> {
  var out: list<int> = []
  for axis in axes {
    out += [shape[axis]]
  }
  return out
}

fn permuted(shape: list<Ty>, axes: list<int>) -> list<Ty> {
  var out: list<Ty> = []
  for axis in axes {
    out += [shape[axis]]
  }
  return out
}

fn inserted(shape: list<Ty>, axis: int, dim: Ty) -> list<Ty> {
  var out: list<Ty> = []
  for i in 0..len(shape) + 1 {
    if i == axis {
      out += [dim]
    } else {
      var source = i
      if i > axis {
        source -= 1
      }
      out += [shape[source]]
    }
  }
  return out
}

fn replaced(shape: list<Ty>, axis: int, dim: Ty) -> list<Ty> {
  var out: list<Ty> = []
  for i in 0..len(shape) {
    if i == axis {
      out += [dim]
    } else {
      out += [shape[i]]
    }
  }
  return out
}

fn concatenated(
  left: list<Ty>, right: list<Ty>, axis: int
) -> list<Ty> {
  if len(left) == 0 || len(left) != len(right) {
    var invalid: list<Ty> = []
    return invalid
  }
  var dim = axis
  if dim < 0 {
    dim += len(left)
  }
  if dim < 0 || dim >= len(left) {
    return []
  }
  var out = left
  for item in 0..len(left) {
    if item != dim {
      if out[item] == ty("_") {
        out = replaced(out, item, right[item])
      } else {
        if right[item] != ty("_") && out[item] != right[item] {
          return []
        }
      }
    }
  }
  var extent = ty("_")
  if kind(left[dim]) == "int" && kind(right[dim]) == "int" {
    extent = ty(int(left[dim]) + int(right[dim]))
  } else {
    if left[dim] == ty(0) {
      extent = right[dim]
    }
    if right[dim] == ty(0) {
      extent = left[dim]
    }
  }
  return replaced(out, dim, extent)
}

local fn permute_runtime<E: Ty, S: list<int>, T: list<int>, R: int, Q: int>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, T> {
  assert(R == Q && len(axes) == R, "tensor.permute ranks must match")
  [stage: "shape"]
  for axis in 0..R {
    assert(axes[axis] >= 0 && axes[axis] < R,
           "tensor.permute axis is out of range")
    [stage: "shape"]
    for prior in 0..axis {
      assert(axes[prior] != axes[axis], "tensor.permute axes must be unique")
    }
  }
  var source_strides = tensor<index, [R]>(index(1))
  var shape = tensor<index, [R]>(index(0))
  var total = index(1)
  [stage: "shape"]
  for reverse in 0..R {
    let axis = R - reverse - 1
    let size = dim(x, index(axis))
    assert(size >= index(0), "tensor.permute extent is negative")
    source_strides[axis] = total
    assert(i64(total) <= i64(9223372036854775807) /
             (i64(size) + i64(size == index(0))),
           "tensor.permute size overflows")
    let next = i64(total) * i64(size)
    total = index(next)
    assert(i64(total) == next, "tensor.permute index range overflows")
  }
  [stage: "shape"]
  for axis in 0..R {
    shape[axis] = dim(x, index(axes[axis]))
  }
  var out: tensor<E, T> = make(E(0), shape)
  [stage: "shape"]
  for axis in 0..R {
    assert(dim(out, index(axis)) == shape[axis],
           "tensor.permute result disagrees with its declared shape")
  }
  for i in index(0)..total {
    var source = index(0)
    var remaining = i
    [stage: "shape"]
    for reverse in 0..R {
      let axis = R - reverse - 1
      let size = shape[axis] + index(shape[axis] == index(0))
      source += (remaining % size) * source_strides[axes[axis]]
      remaining /= size
    }
    out[i] = x[source]
  }
  return out
}

fn permute<E: Ty, S: list<int>, T: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, T> {
  return permute_runtime<E, S, T, len<S>, len<T>>(x, axes)
}
