local fn cast_runtime<A: Ty, B: Ty, S: list<int>, R: int>(
  x: tensor<A, S>
) -> tensor<B, S> {
  var shape = tensor<index, [R]>(index(0))
  var count = index(1)
  [stage: "shape"]
  for axis in 0..R {
    let extent = dim(x, index(axis))
    assert(extent >= index(0), "tensor.cast extent is negative")
    assert(count <= index(9223372036854775807) /
             (extent + index(extent == index(0))),
           "tensor.cast size overflows")
    shape[axis] = extent
    count *= extent
  }
  var out: tensor<B, S> = make(B(0), shape)
  for i in index(0)..count {
    out[i] = B(x[i])
  }
  return view(out, shape)
}

fn cast<A: Ty, B: Ty, S: list<int>>(
  x: tensor<A, S>
) -> tensor<B, S> {
  return cast_runtime<A, B, S, len<S>>(x)
}

fn fill<E: Ty, S: list<int>>(
  value: tensor<E, [1]>
) -> tensor<E, S> {
  return tensor<E, S>(value[0])
}

fn +<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] + b[i]
  }
  return out
}

fn -<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] - b[i]
  }
  return out
}

fn *<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] * b[i]
  }
  return out
}

fn /<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] / b[i]
  }
  return out
}

fn ==<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  var out = tensor<bool, S>(false)
  for i in 0..numel<S>() {
    out[i] = a[i] == b[i]
  }
  return out
}

fn ==<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  let left: tensor<E, Y> = broadcast(a)
  let right: tensor<E, Y> = broadcast(b)
  return left == right
}

fn < <E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  var out = tensor<bool, S>(false)
  for i in 0..numel<S>() {
    out[i] = a[i] < b[i]
  }
  return out
}

fn < <
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  let left: tensor<E, Y> = broadcast(a)
  let right: tensor<E, Y> = broadcast(b)
  return left < right
}

fn ><E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  var out = tensor<bool, S>(false)
  for i in 0..numel<S>() {
    out[i] = a[i] > b[i]
  }
  return out
}

fn ><
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  let left: tensor<E, Y> = broadcast(a)
  let right: tensor<E, Y> = broadcast(b)
  return left > right
}
