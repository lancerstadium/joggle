local fn cast_runtime<A: Ty, B: Ty, S: list<int>, R: int>(
  x: tensor<A, S>
) -> tensor<B, S> {
  var shape = tensor<index, [R]>(index(0))
  var count = index(1)
  [stage: "shape"]
  for axis in 0..R {
    let extent = dim(x, index(axis))
    assert(extent >= index(0), "tensor.cast extent is negative")
    assert(count <= index(9223372036854775807) /
             (extent + index(extent == index(0))),
           "tensor.cast size overflows")
    shape[axis] = extent
    count *= extent
  }
  var out: tensor<B, S> = make(B(0), shape)
  for i in index(0)..count {
    out[i] = B(x[i])
  }
  return view(out, shape)
}

fn cast<A: Ty, B: Ty, S: list<int>>(
  x: tensor<A, S>
) -> tensor<B, S> {
  return cast_runtime<A, B, S, len<S>>(x)
}

fn fill<E: Ty, S: list<int>>(
  value: tensor<E, [1]>
) -> tensor<E, S> {
  return tensor<E, S>(value[0])
}

fn +<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] + b[i]
  }
  return out
}

fn -<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] - b[i]
  }
  return out
}

fn *<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] * b[i]
  }
  return out
}

fn /<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] / b[i]
  }
  return out
}

local fn compare_runtime<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>,
  P: int, Q: int, D: int, Mode: int
>(a: tensor<E, L>, b: tensor<E, R>) -> tensor<bool, Y> {
  assert(D >= P && D >= Q, "tensor comparison result rank is too small")
  var shape = tensor<index, [D]>(index(1))
  var left_strides = tensor<index, [D]>(index(0))
  var right_strides = tensor<index, [D]>(index(0))
  var left_size = index(1)
  var right_size = index(1)
  var count = index(1)
  [stage: "shape"]
  for reverse in 0..D {
    let axis = D - reverse - 1
    var left = index(1)
    var right = index(1)
    if axis >= D - P { left = dim(a, index(axis - (D - P))) }
    if axis >= D - Q { right = dim(b, index(axis - (D - Q))) }
    assert(left >= index(0) && right >= index(0),
           "tensor comparison extent is negative")
    assert(left == right || left == index(1) || right == index(1),
           "tensor comparison shapes are incompatible")
    var extent = left
    if left == index(1) { extent = right }
    shape[axis] = extent
    if left != index(1) { left_strides[axis] = left_size }
    if right != index(1) { right_strides[axis] = right_size }
    assert(i64(left_size) <= i64(9223372036854775807) /
             (i64(left) + i64(left == index(0))) &&
           i64(right_size) <= i64(9223372036854775807) /
             (i64(right) + i64(right == index(0))) &&
           i64(count) <= i64(9223372036854775807) /
             (i64(extent) + i64(extent == index(0))),
           "tensor comparison size overflows")
    let next_left = i64(left_size) * i64(left)
    let next_right = i64(right_size) * i64(right)
    let next_count = i64(count) * i64(extent)
    left_size = index(next_left)
    right_size = index(next_right)
    count = index(next_count)
    assert(i64(left_size) == next_left && i64(right_size) == next_right &&
           i64(count) == next_count, "tensor comparison index range overflows")
  }
  var out: tensor<bool, Y> = make(false, shape)
  for linear in index(0)..count {
    var remaining = linear
    var left = index(0)
    var right = index(0)
    [stage: "shape"]
    for reverse in 0..D {
      let axis = D - reverse - 1
      let coordinate = remaining % shape[axis]
      remaining /= shape[axis]
      left += coordinate * left_strides[axis]
      right += coordinate * right_strides[axis]
    }
    var value = a[left] == b[right]
    if Mode == 1 { value = a[left] < b[right] }
    if Mode == 2 { value = a[left] > b[right] }
    out[linear] = value
  }
  return view<bool, index, Y, Y, D>(out, shape)
}

fn ==<E: Ty>(a: tensor<E, []>, b: tensor<E, []>) -> tensor<bool, []> {
  return tensor<bool, []>(a[0] == b[0])
}

fn ==<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  return compare_runtime<E, S, S, S, len<S>, len<S>, len<S>, 0>(a, b)
}

fn ==<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  return compare_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 0>(a, b)
}

fn < <E: Ty>(a: tensor<E, []>, b: tensor<E, []>) -> tensor<bool, []> {
  return tensor<bool, []>(a[0] < b[0])
}

fn < <E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  return compare_runtime<E, S, S, S, len<S>, len<S>, len<S>, 1>(a, b)
}

fn < <
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  return compare_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 1>(a, b)
}

fn ><E: Ty>(a: tensor<E, []>, b: tensor<E, []>) -> tensor<bool, []> {
  return tensor<bool, []>(a[0] > b[0])
}

fn ><E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  return compare_runtime<E, S, S, S, len<S>, len<S>, len<S>, 2>(a, b)
}

fn ><
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  return compare_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 2>(a, b)
}
