local fn cast_runtime<A: Ty, B: Ty, S: list<int>, R: int>(
  x: tensor<A, S>
) -> tensor<B, S> {
  var shape = tensor<index, [R]>(index(0))
  var count = index(1)
  [stage: "shape"]
  for axis in 0..R {
    let extent = dim(x, index(axis))
    assert(extent >= index(0), "tensor.cast extent is negative")
    assert(count <= index(9223372036854775807) /
             (extent + index(extent == index(0))),
           "tensor.cast size overflows")
    shape[axis] = extent
    count *= extent
  }
  var out: tensor<B, S> = make(B(0), shape)
  for i in index(0)..count {
    out[i] = B(x[i])
  }
  return view(out, shape)
}

fn cast<A: Ty, B: Ty, S: list<int>>(
  x: tensor<A, S>
) -> tensor<B, S> {
  return cast_runtime<A, B, S, len<S>>(x)
}

fn fill<E: Ty, S: list<int>>(
  value: tensor<E, [1]>
) -> tensor<E, S> {
  return tensor<E, S>(value[0])
}

fn +<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] + b[i]
  }
  return out
}

fn -<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] - b[i]
  }
  return out
}

fn *<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] * b[i]
  }
  return out
}

fn /<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] / b[i]
  }
  return out
}

local fn compare_runtime<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>,
  P: int, Q: int, D: int, Mode: int
>(a: tensor<E, L>, b: tensor<E, R>) -> tensor<bool, Y> {
  let shape, left_strides, right_strides, count =
    broadcast_layout<E, E, L, R, P, Q, D>(a, b)
  var out: tensor<bool, Y> = make(false, shape)
  for linear in index(0)..count {
    var remaining = linear
    var left = index(0)
    var right = index(0)
    [stage: "shape"]
    for reverse in 0..D {
      let axis = D - reverse - 1
      let coordinate = remaining % shape[axis]
      remaining /= shape[axis]
      left += coordinate * left_strides[axis]
      right += coordinate * right_strides[axis]
    }
    var value = a[left] == b[right]
    if Mode == 1 { value = a[left] < b[right] }
    if Mode == 2 { value = a[left] > b[right] }
    out[linear] = value
  }
  return view<bool, index, Y, Y, D>(out, shape)
}

fn ==<E: Ty>(a: tensor<E, []>, b: tensor<E, []>) -> tensor<bool, []> {
  return tensor<bool, []>(a[0] == b[0])
}

fn ==<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  return compare_runtime<E, S, S, S, len<S>, len<S>, len<S>, 0>(a, b)
}

fn ==<
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  return compare_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 0>(a, b)
}

fn < <E: Ty>(a: tensor<E, []>, b: tensor<E, []>) -> tensor<bool, []> {
  return tensor<bool, []>(a[0] < b[0])
}

fn < <E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  return compare_runtime<E, S, S, S, len<S>, len<S>, len<S>, 1>(a, b)
}

fn < <
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  return compare_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 1>(a, b)
}

fn ><E: Ty>(a: tensor<E, []>, b: tensor<E, []>) -> tensor<bool, []> {
  return tensor<bool, []>(a[0] > b[0])
}

fn ><E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<bool, S> {
  return compare_runtime<E, S, S, S, len<S>, len<S>, len<S>, 2>(a, b)
}

fn ><
  E: Ty, L: list<int>, R: list<int>, Y: list<int>
>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<bool, Y> {
  return compare_runtime<E, L, R, Y, len<L>, len<R>, len<Y>, 2>(a, b)
}
