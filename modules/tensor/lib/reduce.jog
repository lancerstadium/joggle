fn matmul<E: Ty, M: int, N: int, K: int>(
  a: tensor<E, [M, K]>, b: tensor<E, [K, N]>
) -> tensor<E, [M, N]> {
  var out = tensor<E, [M, N]>(E(0))
  for i in 0..M, j in 0..N, k in 0..K {
    out[i, j] = out[i, j] + a[i, k] * b[k, j]
  }
  return out
}

fn matmul_offset(
  shape: list<int>, output: list<int>, batch: int, row: int, column: int
) -> int {
  let batch_rank = len(shape) - 2
  let output_rank = len(output) - 2
  let shift = output_rank - batch_rank
  var offset = row * shape[len(shape) - 1] + column
  var source_stride = shape[len(shape) - 2] * shape[len(shape) - 1]
  for reverse in 0..batch_rank {
    let source_axis = batch_rank - reverse - 1
    let output_axis = shift + source_axis
    var output_stride = 1
    for next in output_axis + 1..output_rank {
      output_stride *= output[next]
    }
    let coordinate = (batch / output_stride) % output[output_axis]
    if shape[source_axis] != 1 {
      offset += coordinate * source_stride
    }
    source_stride *= shape[source_axis]
  }
  return offset
}

fn valid_axes(axes: list<int>, rank: int) -> bool {
  if len(axes) == 0 {
    return false
  }
  for i in 0..len(axes) {
    if axes[i] < 0 || axes[i] >= rank {
      return false
    }
    for j in 0..i {
      if axes[i] == axes[j] {
        return false
      }
    }
  }
  return true
}

fn reduced(
  shape: list<Ty>, axes: list<int>, keep: bool
) -> list<Ty> {
  var out: list<Ty> = []
  for dim in 0..len(shape) {
    var selected = false
    for axis in axes {
      if axis == dim {
        selected = true
      }
    }
    if selected {
      if keep {
        out += [ty(1)]
      }
    } else {
      out += [shape[dim]]
    }
  }
  return out
}

fn reduce_offset(
  shape: list<int>, axes: list<int>, line: int, item: int
) -> int {
  var offset = 0
  var source_stride = 1
  var line_stride = 1
  var item_stride = 1
  for reverse in 0..len(shape) {
    let dim = len(shape) - reverse - 1
    var selected = false
    for axis in axes {
      if axis == dim {
        selected = true
      }
    }
    if selected {
      offset += (item / item_stride) % shape[dim] * source_stride
      item_stride *= shape[dim]
    } else {
      offset += (line / line_stride) % shape[dim] * source_stride
      line_stride *= shape[dim]
    }
    source_stride *= shape[dim]
  }
  return offset
}

fn mean<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  var count = 1
  for axis in axes {
    count *= S[axis]
  }
  var out = tensor<E, Y>(E(0))
  for line in 0..tensor.numel<Y>() {
    var sum = E(0)
    for item in 0..count {
      sum += x[reduce_offset(S, axes, line, item)]
    }
    out[line] = sum / E(count)
  }
  return out
}

fn sum<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  var count = 1
  for axis in axes {
    count *= S[axis]
  }
  var out = tensor<E, Y>(E(0))
  for line in 0..tensor.numel<Y>() {
    for item in 0..count {
      out[line] = out[line] + x[reduce_offset(S, axes, line, item)]
    }
  }
  return out
}

fn min<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  var count = 1
  for axis in axes {
    count *= S[axis]
  }
  var out = tensor<E, Y>(E(0))
  for line in 0..tensor.numel<Y>() {
    out[line] = x[reduce_offset(S, axes, line, 0)]
    for item in 1..count {
      let value = x[reduce_offset(S, axes, line, item)]
      if value < out[line] {
        out[line] = value
      }
    }
  }
  return out
}

fn max<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  var count = 1
  for axis in axes {
    count *= S[axis]
  }
  var out = tensor<E, Y>(E(0))
  for line in 0..tensor.numel<Y>() {
    out[line] = x[reduce_offset(S, axes, line, 0)]
    for item in 1..count {
      let value = x[reduce_offset(S, axes, line, item)]
      if value > out[line] {
        out[line] = value
      }
    }
  }
  return out
}

fn matmul<E: Ty, L: list<int>, R: list<int>, Y: list<int>>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<E, Y> {
  let m = L[len(L) - 2]
  let k_size = L[len(L) - 1]
  let n = R[len(R) - 1]
  let batches = numel<Y>() / (m * n)
  var out = tensor<E, Y>(E(0))
  for batch in 0..batches, i in 0..m, j in 0..n, k in 0..k_size {
    let ai = matmul_offset(L, Y, batch, i, k)
    let bi = matmul_offset(R, Y, batch, k, j)
    let oi = batch * m * n + i * n + j
    out[oi] = out[oi] + a[ai] * b[bi]
  }
  return out
}

fn matmul<E: Ty, L: list<int>, R: list<int>, Y: list<int>>(
  a: tensor<E, L>,
  b: tensor<E, R>,
  transpose_a: bool,
  transpose_b: bool,
  alpha: f64
) -> tensor<E, Y> {
  var m = L[len(L) - 2]
  var depth = L[len(L) - 1]
  var n = R[len(R) - 1]
  if transpose_a {
    m = L[len(L) - 1]
    depth = L[len(L) - 2]
  }
  if transpose_b {
    n = R[len(R) - 2]
  }
  let batches = numel<Y>() / (m * n)
  var out = tensor<E, Y>(E(0))
  for batch in 0..batches, row in 0..m, column in 0..n, k in 0..depth {
    var ar = row
    var ac = k
    var br = k
    var bc = column
    if transpose_a {
      ar = k
      ac = row
    }
    if transpose_b {
      br = column
      bc = k
    }
    let ai = matmul_offset(L, Y, batch, ar, ac)
    let bi = matmul_offset(R, Y, batch, br, bc)
    let oi = batch * m * n + row * n + column
    out[oi] = out[oi] + a[ai] * b[bi]
  }
  for batch in 0..batches, row in 0..m, column in 0..n {
    let oi = batch * m * n + row * n + column
    out[oi] = out[oi] * E(alpha)
  }
  return out
}
