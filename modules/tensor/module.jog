module tensor
use base

fn tensor<E: Ty, S: list<int>>() -> Ty;
fn tensor<E: Ty, S: list<int>>(fill: E) -> tensor<E, S>;

fn valid(type: Ty) -> bool {
  if name(type) != "tensor" {
    return false
  }
  if len(args(type)) != 2 {
    return false
  }
  return name(args(type)[1]) == "[]"
}

fn static(type: Ty) -> bool {
  if !valid(type) {
    return false
  }
  for dim in args(args(type)[1]) {
    if kind(dim) != "int" {
      return false
    }
  }
  return true
}

fn elem(type: Ty) -> Ty {
  return args(type)[0]
}

fn shape(type: Ty) -> list<int> {
  var out: list<int> = []
  for dim in args(args(type)[1]) {
    out += [int(dim)]
  }
  return out
}

fn dims(type: Ty) -> list<Ty> {
  return args(args(type)[1])
}

fn refined(current: Ty, candidate: Ty) -> Ty {
  if !valid(current) || !valid(candidate) {
    return ty("_")
  }
  var element = elem(current)
  if element == ty("_") {
    element = elem(candidate)
  } else {
    if elem(candidate) != ty("_") && elem(candidate) != element {
      return ty("_")
    }
  }
  let before = dims(current)
  let after = dims(candidate)
  if len(before) != len(after) {
    return ty("_")
  }
  var shape: list<Ty> = []
  for i in 0..len(before) {
    var dim = before[i]
    if dim == ty("_") {
      dim = after[i]
    } else {
      if after[i] != ty("_") && after[i] != dim {
        return ty("_")
      }
    }
    shape += [dim]
  }
  return ty("tensor", [element, ty("[]", shape)])
}

fn type(elem: Ty, shape: list<int>) -> Ty {
  var dims: list<Ty> = []
  for extent in shape {
    dims += [ty(extent)]
  }
  return ty("tensor", [elem, ty("[]", dims)])
}

fn type(elem: Ty, dims: list<Ty>) -> Ty {
  return ty("tensor", [elem, ty("[]", dims)])
}

fn product(dims: list<Ty>, first: int, last: int) -> Ty {
  if first < 0 || last < first || last > len(dims) {
    return ty("_")
  }
  var value = 1
  var symbol = ty("_")
  for i in first..last {
    if kind(dims[i]) == "int" {
      value *= int(dims[i])
    } else {
      if symbol != ty("_") {
        return ty("_")
      }
      symbol = dims[i]
    }
  }
  if symbol != ty("_") {
    if value != 1 {
      return ty("_")
    }
    return symbol
  }
  return ty(value)
}

fn quotient(numerator: list<Ty>, denominator: list<Ty>) -> Ty {
  var top = 1
  var bottom = 1
  var top_symbols: list<Ty> = []
  var bottom_symbols: list<Ty> = []
  for dim in numerator {
    if kind(dim) == "int" {
      if int(dim) < 0 {
        return ty("_")
      }
      top *= int(dim)
    } else {
      if dim == ty("_") {
        return ty("_")
      }
      top_symbols += [dim]
    }
  }
  for dim in denominator {
    if kind(dim) == "int" {
      if int(dim) <= 0 {
        return ty("_")
      }
      bottom *= int(dim)
    } else {
      if dim == ty("_") {
        return ty("_")
      }
      bottom_symbols += [dim]
    }
  }
  for symbol in bottom_symbols {
    var available = 0
    var required = 0
    for item in top_symbols {
      if item == symbol {
        available += 1
      }
    }
    for item in bottom_symbols {
      if item == symbol {
        required += 1
      }
    }
    if available < required {
      return ty("_")
    }
  }
  var remaining: list<Ty> = []
  for i in 0..len(top_symbols) {
    let symbol = top_symbols[i]
    var occurrence = 0
    var cancelled = 0
    for j in 0..i + 1 {
      if top_symbols[j] == symbol {
        occurrence += 1
      }
    }
    for item in bottom_symbols {
      if item == symbol {
        cancelled += 1
      }
    }
    if occurrence > cancelled {
      remaining += [symbol]
    }
  }
  if bottom == 0 || top % bottom != 0 || len(remaining) > 1 {
    return ty("_")
  }
  let scale = top / bottom
  if len(remaining) == 0 {
    return ty(scale)
  }
  if scale == 1 {
    return remaining[0]
  }
  return ty("_")
}

fn []<E: Ty, S: list<int>>(x: tensor<E, S>, i: index) -> E;
fn []<E: Ty, M: int, N: int>(
  x: tensor<E, [M, N]>, i: index, j: index
) -> E;
fn []<E: Ty, N: int, C: int, H: int, W: int>(
  x: tensor<E, [N, C, H, W]>, n: index, c: index, h: index, w: index
) -> E;
fn []=<E: Ty, S: list<int>>(
  x: tensor<E, S>, i: index, value: E
) -> tensor<E, S>;
fn []=<E: Ty, M: int, N: int>(
  x: tensor<E, [M, N]>, i: index, j: index, value: E
) -> tensor<E, [M, N]>;
fn []=<E: Ty, N: int, C: int, H: int, W: int>(
  x: tensor<E, [N, C, H, W]>,
  n: index,
  c: index,
  h: index,
  w: index,
  value: E
) -> tensor<E, [N, C, H, W]>;

fn numel<S: list<int>>() -> int {
  var size = 1
  for extent in S {
    size *= extent
  }
  return size
}

fn extent(shape: list<int>, axes: list<int>, axis: int) -> int {
  var out = 1
  for i in 0..len(shape) {
    if axes[i] == axis {
      out = shape[i]
    }
  }
  return out
}

fn offset<I: Ty>(
  shape: list<int>, axes: list<int>, coords: list<I>
) -> int {
  var out = 0
  var stride = 1
  for reverse in 0..len(shape) {
    let i = len(shape) - reverse - 1
    let axis = axes[i]
    if axis >= 0 {
      out += coords[axis] * stride
    }
    stride *= shape[i]
  }
  return out
}

fn coord(
  shape: list<int>, axes: list<int>, linear: int, axis: int
) -> int {
  var out = 0
  var stride = 1
  for reverse in 0..len(shape) {
    let i = len(shape) - reverse - 1
    if axes[i] == axis {
      out = (linear / stride) % shape[i]
    }
    stride *= shape[i]
  }
  return out
}

fn reshape<E: Ty, S: list<int>, T: list<int>>(
  x: tensor<E, S>
) -> tensor<E, T> {
  var out = tensor<E, T>(E(0))
  for i in 0..numel<T>() {
    out[i] = x[i]
  }
  return out
}

fn permutation(axes: list<int>, rank: int) -> bool {
  if len(axes) != rank {
    return false
  }
  for axis in 0..rank {
    var count = 0
    for item in axes {
      if item == axis {
        count += 1
      }
    }
    if count != 1 {
      return false
    }
  }
  return true
}

fn permuted(shape: list<int>, axes: list<int>) -> list<int> {
  var out: list<int> = []
  for axis in axes {
    out += [shape[axis]]
  }
  return out
}

fn permuted(shape: list<Ty>, axes: list<int>) -> list<Ty> {
  var out: list<Ty> = []
  for axis in axes {
    out += [shape[axis]]
  }
  return out
}

fn inserted(shape: list<Ty>, axis: int, dim: Ty) -> list<Ty> {
  var out: list<Ty> = []
  for i in 0..len(shape) + 1 {
    if i == axis {
      out += [dim]
    } else {
      var source = i
      if i > axis {
        source -= 1
      }
      out += [shape[source]]
    }
  }
  return out
}

fn replaced(shape: list<Ty>, axis: int, dim: Ty) -> list<Ty> {
  var out: list<Ty> = []
  for i in 0..len(shape) {
    if i == axis {
      out += [dim]
    } else {
      out += [shape[i]]
    }
  }
  return out
}

fn gathered(
  data: list<Ty>, indices: list<Ty>, axis: int
) -> list<Ty> {
  var out: list<Ty> = []
  for i in 0..axis {
    out += [data[i]]
  }
  out += indices
  for i in axis + 1..len(data) {
    out += [data[i]]
  }
  return out
}

fn permute<E: Ty, S: list<int>, T: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, T> {
  var inverse: list<int> = []
  var identity: list<int> = []
  for input_axis in 0..len(S) {
    var output_axis = -1
    for candidate in 0..len(axes) {
      if axes[candidate] == input_axis {
        output_axis = candidate
      }
    }
    inverse += [output_axis]
    identity += [input_axis]
  }
  var out = tensor<E, T>(E(0))
  for i in 0..numel<T>() {
    var coords: list<int> = []
    for axis in 0..len(T) {
      coords += [coord(T, identity, i, axis)]
    }
    out[i] = x[offset(S, inverse, coords)]
  }
  return out
}

fn broadcastable(from: list<int>, to: list<int>) -> bool {
  if len(from) > len(to) {
    return false
  }
  let shift = len(to) - len(from)
  for i in 0..len(from) {
    if from[i] != 1 && from[i] != to[shift + i] {
      return false
    }
  }
  return true
}

fn broadcastable(from: list<Ty>, to: list<Ty>) -> bool {
  if len(from) > len(to) {
    return false
  }
  let shift = len(to) - len(from)
  for i in 0..len(from) {
    if from[i] != ty(1) && from[i] != to[shift + i] {
      return false
    }
  }
  return true
}

fn broadcast_shape(left: list<int>, right: list<int>) -> list<int> {
  var rank = len(left)
  if len(right) > rank {
    rank = len(right)
  }
  var out: list<int> = []
  for axis in 0..rank {
    var l = 1
    var r = 1
    let li = axis - (rank - len(left))
    let ri = axis - (rank - len(right))
    if li >= 0 {
      l = left[li]
    }
    if ri >= 0 {
      r = right[ri]
    }
    if l != r && l != 1 && r != 1 {
      return []
    }
    if l == 1 {
      out += [r]
    } else {
      out += [l]
    }
  }
  return out
}

fn broadcast_shape(left: list<Ty>, right: list<Ty>) -> list<Ty> {
  var rank = len(left)
  if len(right) > rank {
    rank = len(right)
  }
  var out: list<Ty> = []
  for axis in 0..rank {
    var a = ty(1)
    var b = ty(1)
    if axis >= rank - len(left) {
      a = left[axis - (rank - len(left))]
    }
    if axis >= rank - len(right) {
      b = right[axis - (rank - len(right))]
    }
    if a == ty(1) {
      out += [b]
    } else {
      out += [a]
    }
  }
  return out
}

fn broadcast_offset(
  from: list<int>, to: list<int>, linear: int
) -> int {
  var out = 0
  var from_stride = 1
  var to_stride = 1
  let shift = len(to) - len(from)
  for reverse in 0..len(to) {
    let axis = len(to) - reverse - 1
    let source = axis - shift
    if source >= 0 {
      if from[source] != 1 {
        out += (linear / to_stride) % to[axis] * from_stride
      }
      from_stride *= from[source]
    }
    to_stride *= to[axis]
  }
  return out
}

fn broadcast<E: Ty, S: list<int>, T: list<int>>(
  x: tensor<E, S>
) -> tensor<E, T> {
  var out = tensor<E, T>(E(0))
  for i in 0..numel<T>() {
    out[i] = x[broadcast_offset(S, T, i)]
  }
  return out
}

fn cast<A: Ty, B: Ty, S: list<int>>(
  x: tensor<A, S>
) -> tensor<B, S> {
  var out = tensor<B, S>(B(0))
  for i in 0..numel<S>() {
    out[i] = B(x[i])
  }
  return out
}

fn +<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] + b[i]
  }
  return out
}

fn -<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] - b[i]
  }
  return out
}

fn *<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] * b[i]
  }
  return out
}

fn /<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] / b[i]
  }
  return out
}

fn matmul<E: Ty, M: int, N: int, K: int>(
  a: tensor<E, [M, K]>, b: tensor<E, [K, N]>
) -> tensor<E, [M, N]> {
  var out = tensor<E, [M, N]>(E(0))
  for i in 0..M, j in 0..N {
    var sum = E(0)
    for k in 0..K {
      sum += a[i, k] * b[k, j]
    }
    out[i, j] = sum
  }
  return out
}

fn matmul_offset(
  shape: list<int>, output: list<int>, batch: int, row: int, column: int
) -> int {
  let batch_rank = len(shape) - 2
  let output_rank = len(output) - 2
  let shift = output_rank - batch_rank
  var offset = row * shape[len(shape) - 1] + column
  var source_stride = shape[len(shape) - 2] * shape[len(shape) - 1]
  for reverse in 0..batch_rank {
    let source_axis = batch_rank - reverse - 1
    let output_axis = shift + source_axis
    var output_stride = 1
    for next in output_axis + 1..output_rank {
      output_stride *= output[next]
    }
    let coordinate = (batch / output_stride) % output[output_axis]
    if shape[source_axis] != 1 {
      offset += coordinate * source_stride
    }
    source_stride *= shape[source_axis]
  }
  return offset
}

fn line_offset(
  shape: list<int>, axis: int, line: int, item: int
) -> int {
  var offset = 0
  var source_stride = 1
  var line_stride = 1
  for reverse in 0..len(shape) {
    let dim = len(shape) - reverse - 1
    if dim == axis {
      offset += item * source_stride
    } else {
      offset += (line / line_stride) % shape[dim] * source_stride
      line_stride *= shape[dim]
    }
    source_stride *= shape[dim]
  }
  return offset
}

fn valid_axes(axes: list<int>, rank: int) -> bool {
  if len(axes) == 0 {
    return false
  }
  for i in 0..len(axes) {
    if axes[i] < 0 || axes[i] >= rank {
      return false
    }
    for j in 0..i {
      if axes[i] == axes[j] {
        return false
      }
    }
  }
  return true
}

fn reduced(
  shape: list<Ty>, axes: list<int>, keep: bool
) -> list<Ty> {
  var out: list<Ty> = []
  for dim in 0..len(shape) {
    var selected = false
    for axis in axes {
      if axis == dim {
        selected = true
      }
    }
    if selected {
      if keep {
        out += [ty(1)]
      }
    } else {
      out += [shape[dim]]
    }
  }
  return out
}

fn reduce_offset(
  shape: list<int>, axes: list<int>, line: int, item: int
) -> int {
  var offset = 0
  var source_stride = 1
  var line_stride = 1
  var item_stride = 1
  for reverse in 0..len(shape) {
    let dim = len(shape) - reverse - 1
    var selected = false
    for axis in axes {
      if axis == dim {
        selected = true
      }
    }
    if selected {
      offset += (item / item_stride) % shape[dim] * source_stride
      item_stride *= shape[dim]
    } else {
      offset += (line / line_stride) % shape[dim] * source_stride
      line_stride *= shape[dim]
    }
    source_stride *= shape[dim]
  }
  return offset
}

fn mean<E: Ty, S: list<int>, Y: list<int>>(
  x: tensor<E, S>, axes: list<int>
) -> tensor<E, Y> {
  var count = 1
  for axis in axes {
    count *= S[axis]
  }
  var out = tensor<E, Y>(E(0))
  for line in 0..tensor.numel<Y>() {
    var sum = E(0)
    for item in 0..count {
      sum += x[reduce_offset(S, axes, line, item)]
    }
    out[line] = sum / E(count)
  }
  return out
}

fn matmul<E: Ty, L: list<int>, R: list<int>, Y: list<int>>(
  a: tensor<E, L>, b: tensor<E, R>
) -> tensor<E, Y> {
  let m = L[len(L) - 2]
  let k_size = L[len(L) - 1]
  let n = R[len(R) - 1]
  let batches = numel<Y>() / (m * n)
  var out = tensor<E, Y>(E(0))
  for batch in 0..batches, i in 0..m, j in 0..n {
    var sum = E(0)
    for k in 0..k_size {
      let ai = matmul_offset(L, Y, batch, i, k)
      let bi = matmul_offset(R, Y, batch, k, j)
      sum += a[ai] * b[bi]
    }
    out[batch * m * n + i * n + j] = sum
  }
  return out
}

fn matmul<E: Ty, L: list<int>, R: list<int>, Y: list<int>>(
  a: tensor<E, L>,
  b: tensor<E, R>,
  transpose_a: bool,
  transpose_b: bool,
  alpha: f64
) -> tensor<E, Y> {
  var m = L[len(L) - 2]
  var depth = L[len(L) - 1]
  var n = R[len(R) - 1]
  if transpose_a {
    m = L[len(L) - 1]
    depth = L[len(L) - 2]
  }
  if transpose_b {
    n = R[len(R) - 2]
  }
  let batches = numel<Y>() / (m * n)
  var out = tensor<E, Y>(E(0))
  for batch in 0..batches, row in 0..m, column in 0..n {
    var sum = E(0)
    for k in 0..depth {
      var ar = row
      var ac = k
      var br = k
      var bc = column
      if transpose_a {
        ar = k
        ac = row
      }
      if transpose_b {
        br = column
        bc = k
      }
      let ai = matmul_offset(L, Y, batch, ar, ac)
      let bi = matmul_offset(R, Y, batch, br, bc)
      sum += a[ai] * b[bi]
    }
    out[batch * m * n + row * n + column] = sum * E(alpha)
  }
  return out
}
