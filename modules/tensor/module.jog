mod tensor
use base

fn tensor<E: Ty, S: list<int>>() -> Ty;
fn tensor<E: Ty, S: list<int>>(fill: E) -> tensor<E, S>;

// Runtime extents stay ordinary values.  `make` owns storage for the supplied
// logical shape; `view` gives existing storage a logical shape without changing
// its element representation.  Targets may keep these calls or prepare them
// into bounded storage, but dynamic dimensions never become a second tensor
// type.
fn make<E: Ty, I: Ty, S: list<int>, R: int>(
  fill: E, shape: tensor<I, [R]>
) -> tensor<E, S>;
fn view<E: Ty, I: Ty, S: list<int>, T: list<int>, R: int>(
  data: tensor<E, S>, shape: tensor<I, [R]>
) -> tensor<E, T>;
