module tensor
use base

fn tensor<E: Ty, S: list<int>>() -> Ty;
fn tensor<E: Ty, S: list<int>>(fill: E) -> tensor<E, S>;

fn valid(type: Ty) -> bool {
  if name(type) != "tensor" {
    return false
  }
  if len(args(type)) != 2 {
    return false
  }
  return name(args(type)[1]) == "[]"
}

fn static(type: Ty) -> bool {
  if !valid(type) {
    return false
  }
  for dim in args(args(type)[1]) {
    if kind(dim) != "int" {
      return false
    }
  }
  return true
}

fn elem(type: Ty) -> Ty {
  return args(type)[0]
}

fn shape(type: Ty) -> list<int> {
  var out: list<int> = []
  for dim in args(args(type)[1]) {
    out += [int(dim)]
  }
  return out
}

fn type(elem: Ty, shape: list<int>) -> Ty {
  var dims: list<Ty> = []
  for extent in shape {
    dims += [ty(extent)]
  }
  return ty("tensor", [elem, ty("[]", dims)])
}

fn []<E: Ty, S: list<int>>(x: tensor<E, S>, i: index) -> E;
fn []<E: Ty, M: int, N: int>(
  x: tensor<E, [M, N]>, i: index, j: index
) -> E;
fn []<E: Ty, N: int, C: int, H: int, W: int>(
  x: tensor<E, [N, C, H, W]>, n: index, c: index, h: index, w: index
) -> E;
fn []=<E: Ty, S: list<int>>(
  x: tensor<E, S>, i: index, value: E
) -> tensor<E, S>;
fn []=<E: Ty, M: int, N: int>(
  x: tensor<E, [M, N]>, i: index, j: index, value: E
) -> tensor<E, [M, N]>;
fn []=<E: Ty, N: int, C: int, H: int, W: int>(
  x: tensor<E, [N, C, H, W]>,
  n: index,
  c: index,
  h: index,
  w: index,
  value: E
) -> tensor<E, [N, C, H, W]>;

fn numel<S: list<int>>() -> int {
  var size = 1
  for extent in S {
    size *= extent
  }
  return size
}

fn extent(shape: list<int>, axes: list<int>, axis: int) -> int {
  var out = 1
  for i in 0..len(shape) {
    if axes[i] == axis {
      out = shape[i]
    }
  }
  return out
}

fn offset<I: Ty>(
  shape: list<int>, axes: list<int>, coords: list<I>
) -> int {
  var out = 0
  var stride = 1
  for reverse in 0..len(shape) {
    let i = len(shape) - reverse - 1
    let axis = axes[i]
    if axis >= 0 {
      out += coords[axis] * stride
    }
    stride *= shape[i]
  }
  return out
}

fn coord(
  shape: list<int>, axes: list<int>, linear: int, axis: int
) -> int {
  var out = 0
  var stride = 1
  for reverse in 0..len(shape) {
    let i = len(shape) - reverse - 1
    if axes[i] == axis {
      out = (linear / stride) % shape[i]
    }
    stride *= shape[i]
  }
  return out
}

fn reshape<E: Ty, S: list<int>, T: list<int>>(
  x: tensor<E, S>
) -> tensor<E, T> {
  var out = tensor<E, T>(E(0))
  for i in 0..numel<T>() {
    out[i] = x[i]
  }
  return out
}

fn broadcastable(from: list<int>, to: list<int>) -> bool {
  if len(from) > len(to) {
    return false
  }
  let shift = len(to) - len(from)
  for i in 0..len(from) {
    if from[i] != 1 && from[i] != to[shift + i] {
      return false
    }
  }
  return true
}

fn broadcast_shape(left: list<int>, right: list<int>) -> list<int> {
  var rank = len(left)
  if len(right) > rank {
    rank = len(right)
  }
  var out: list<int> = []
  for axis in 0..rank {
    var l = 1
    var r = 1
    let li = axis - (rank - len(left))
    let ri = axis - (rank - len(right))
    if li >= 0 {
      l = left[li]
    }
    if ri >= 0 {
      r = right[ri]
    }
    if l != r && l != 1 && r != 1 {
      return []
    }
    if l == 1 {
      out += [r]
    } else {
      out += [l]
    }
  }
  return out
}

fn broadcast_offset(
  from: list<int>, to: list<int>, linear: int
) -> int {
  var out = 0
  var from_stride = 1
  var to_stride = 1
  let shift = len(to) - len(from)
  for reverse in 0..len(to) {
    let axis = len(to) - reverse - 1
    let source = axis - shift
    if source >= 0 {
      if from[source] != 1 {
        out += (linear / to_stride) % to[axis] * from_stride
      }
      from_stride *= from[source]
    }
    to_stride *= to[axis]
  }
  return out
}

fn broadcast<E: Ty, S: list<int>, T: list<int>>(
  x: tensor<E, S>
) -> tensor<E, T> {
  var out = tensor<E, T>(E(0))
  for i in 0..numel<T>() {
    out[i] = x[broadcast_offset(S, T, i)]
  }
  return out
}

fn +<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] + b[i]
  }
  return out
}

fn -<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] - b[i]
  }
  return out
}

fn *<E: Ty, S: list<int>>(
  a: tensor<E, S>, b: tensor<E, S>
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..numel<S>() {
    out[i] = a[i] * b[i]
  }
  return out
}

fn matmul<E: Ty, M: int, N: int, K: int>(
  a: tensor<E, [M, K]>, b: tensor<E, [K, N]>
) -> tensor<E, [M, N]> {
  var out = tensor<E, [M, N]>(E(0))
  for i in 0..M, j in 0..N {
    var sum = E(0)
    for k in 0..K {
      sum += a[i, k] * b[k, j]
    }
    out[i, j] = sum
  }
  return out
}
