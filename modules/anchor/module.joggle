joggle 1;

module anchor@1.0.0 {
  import arith@2.0.0;
  import mem@1.0.0;
  import nn@2.0.0;
  import tensor@2.0.0;

  interface placement: fn;
  interface machine: type {
    lanes: int;
    macs_per_lane: int;
    local_bytes_per_cycle: int;
    external_bytes_per_cycle: int;
    scratch_capacity: int;
    launch_cycles: int;
  }

  type linear() : mem.layout;
  type tiled(rows: int, columns: int) : mem.layout;

  type io() : mem.space;
  type read_only() : mem.space;
  type local() : mem.space;

  type config(
    lanes: int,
    macs_per_lane: int,
    local_bytes_per_cycle: int,
    external_bytes_per_cycle: int,
    scratch_capacity: int,
    launch_cycles: int
  ) : machine;

  type timeline();

  type ref(
    element: type,
    shape: list<int>,
    layout: type,
    space: type
  ) : mem.reference {
    element_type = element;
    layout_type = layout;
    space_type = space;
  }

  fn constant<
    E: type,
    S: list<int>,
    L: mem.layout,
    P: mem.space
  >(resource: string) -> ref<E, S, L, P> : tensor.immutable_data;

  fn size(shape: list<int>) -> int {
    result = 1;
    for dimension in shape {
      result = result * dimension;
    }
    return result;
  }

  fn load<E: type, S: list<int>, L: mem.layout, P: mem.space>(
    source: ref<E, S, L, P>,
    offset: index
  ) -> E : mem.read;
  fn store<E: type, S: list<int>, L: mem.layout, P: mem.space>(
    destination: ref<E, S, L, P>,
    offset: index,
    value: E
  ) : mem.write;

  fn relu<
    E: prelude.numeric,
    S: list<int>,
    LI: mem.layout,
    PI: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(input: ref<E, S, LI, PI>) -> ref<E, S, LO, PO> : nn.activation {
    output: ref<E, S, LO, PO> = mem.alloc();
    for offset: index in range(size(S)) {
      value: E = load(input, offset);
      zero: E = 0;
      store(output, offset, arith.max(value, zero));
    }
    return output;
  }

  fn add<
    E: prelude.numeric,
    S: list<int>,
    LL: mem.layout,
    PL: mem.space,
    LR: mem.layout,
    PR: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    lhs: ref<E, S, LL, PL>,
    rhs: ref<E, S, LR, PR>
  ) -> ref<E, S, LO, PO> {
    output: ref<E, S, LO, PO> = mem.alloc();
    for offset: index in range(size(S)) {
      left: E = load(lhs, offset);
      right: E = load(rhs, offset);
      store(output, offset, left + right);
    }
    return output;
  }

  fn conv2d_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    O: int,
    KH: int,
    KW: int,
    SH: int,
    SW: int,
    DH: int,
    DW: int,
    PT: int,
    PL: int,
    PB: int,
    PR: int,
    LI: mem.layout,
    PI: mem.space,
    LW: mem.layout,
    PW: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, C, H, W], LI, PI>,
    weight: ref<E, [O, C, KH, KW], LW, PW>,
    stride_h: SH = 1,
    stride_w: SW = 1,
    dilation_h: DH = 1,
    dilation_w: DW = 1,
    pad_top: PT = 0,
    pad_left: PL = 0,
    pad_bottom: PB = 0,
    pad_right: PR = 0
  ) -> ref<
    E,
    [
      N,
      O,
      @nn.conv_extent(H, KH, SH, DH, PT, PB),
      @nn.conv_extent(W, KW, SW, DW, PL, PR)
    ],
    LO,
    PO
  > {
    output: ref<
      E,
      [
        N,
        O,
        @nn.conv_extent(H, KH, SH, DH, PT, PB),
        @nn.conv_extent(W, KW, SW, DW, PL, PR)
      ],
      LO,
      PO
    > = mem.alloc();
    input_channels: index = C;
    input_height: index = H;
    input_width: index = W;
    output_channels: index = O;
    output_height: index = @nn.conv_extent(H, KH, SH, DH, PT, PB);
    output_width: index = @nn.conv_extent(W, KW, SW, DW, PL, PR);
    kernel_height: index = KH;
    kernel_width: index = KW;
    stride_height: index = SH;
    stride_width: index = SW;
    dilation_height: index = DH;
    dilation_width: index = DW;
    padding_top: index = PT;
    padding_left: index = PL;
    for batch: index in range(N) {
      for output_channel: index in range(O) {
        for output_y: index in range(
          @nn.conv_extent(H, KH, SH, DH, PT, PB)
        ) {
          for output_x: index in range(
            @nn.conv_extent(W, KW, SW, DW, PL, PR)
          ) {
            accumulator: E = 0;
            for input_channel: index in range(C) {
              for kernel_y: index in range(KH) {
                input_y_padded: index = arith.add(
                  arith.mul(output_y, stride_height),
                  arith.mul(kernel_y, dilation_height)
                );
                if input_y_padded >= padding_top {
                  input_y: index = arith.sub(input_y_padded, padding_top);
                  if input_y < input_height {
                    for kernel_x: index in range(KW) {
                      input_x_padded: index = arith.add(
                        arith.mul(output_x, stride_width),
                        arith.mul(kernel_x, dilation_width)
                      );
                      if input_x_padded >= padding_left {
                        input_x: index = arith.sub(
                          input_x_padded,
                          padding_left
                        );
                        if input_x < input_width {
                          input_channel_offset: index = arith.add(
                            arith.mul(batch, input_channels),
                            input_channel
                          );
                          input_row_offset: index = arith.add(
                            arith.mul(input_channel_offset, input_height),
                            input_y
                          );
                          input_offset: index = arith.add(
                            arith.mul(input_row_offset, input_width),
                            input_x
                          );
                          weight_channel_offset: index = arith.add(
                            arith.mul(output_channel, input_channels),
                            input_channel
                          );
                          weight_row_offset: index = arith.add(
                            arith.mul(weight_channel_offset, kernel_height),
                            kernel_y
                          );
                          weight_offset: index = arith.add(
                            arith.mul(weight_row_offset, kernel_width),
                            kernel_x
                          );
                          input_value: E = load(input, input_offset);
                          weight_value: E = load(weight, weight_offset);
                          accumulator = arith.add(
                            accumulator,
                            arith.mul(input_value, weight_value)
                          );
                        }
                      }
                    }
                  }
                }
              }
            }
            output_channel_offset: index = arith.add(
              arith.mul(batch, output_channels),
              output_channel
            );
            output_row_offset: index = arith.add(
              arith.mul(output_channel_offset, output_height),
              output_y
            );
            output_offset: index = arith.add(
              arith.mul(output_row_offset, output_width),
              output_x
            );
            store(output, output_offset, accumulator);
          }
        }
      }
    }
    return output;
  }

  fn conv2d_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    O: int,
    KH: int,
    KW: int,
    SH: int,
    SW: int,
    DH: int,
    DW: int,
    PT: int,
    PL: int,
    PB: int,
    PR: int,
    LI: mem.layout,
    PI: mem.space,
    LW: mem.layout,
    PW: mem.space,
    LB: mem.layout,
    PBIAS: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, C, H, W], LI, PI>,
    weight: ref<E, [O, C, KH, KW], LW, PW>,
    bias: ref<E, [O], LB, PBIAS>,
    stride_h: SH = 1,
    stride_w: SW = 1,
    dilation_h: DH = 1,
    dilation_w: DW = 1,
    pad_top: PT = 0,
    pad_left: PL = 0,
    pad_bottom: PB = 0,
    pad_right: PR = 0
  ) -> ref<
    E,
    [
      N,
      O,
      @nn.conv_extent(H, KH, SH, DH, PT, PB),
      @nn.conv_extent(W, KW, SW, DW, PL, PR)
    ],
    LO,
    PO
  > {
    output: ref<
      E,
      [
        N,
        O,
        @nn.conv_extent(H, KH, SH, DH, PT, PB),
        @nn.conv_extent(W, KW, SW, DW, PL, PR)
      ],
      LO,
      PO
    > = conv2d_nchw(
      input,
      weight,
      stride_h = stride_h,
      stride_w = stride_w,
      dilation_h = dilation_h,
      dilation_w = dilation_w,
      pad_top = pad_top,
      pad_left = pad_left,
      pad_bottom = pad_bottom,
      pad_right = pad_right
    );
    output_channels: index = O;
    output_height: index = @nn.conv_extent(H, KH, SH, DH, PT, PB);
    output_width: index = @nn.conv_extent(W, KW, SW, DW, PL, PR);
    for batch: index in range(N) {
      for output_channel: index in range(O) {
        bias_value: E = load(bias, output_channel);
        channel_offset: index = arith.add(
          arith.mul(batch, output_channels),
          output_channel
        );
        for output_y: index in range(
          @nn.conv_extent(H, KH, SH, DH, PT, PB)
        ) {
          row_offset: index = arith.add(
            arith.mul(channel_offset, output_height),
            output_y
          );
          for output_x: index in range(
            @nn.conv_extent(W, KW, SW, DW, PL, PR)
          ) {
            output_offset: index = arith.add(
              arith.mul(row_offset, output_width),
              output_x
            );
            value: E = load(output, output_offset);
            store(output, output_offset, arith.add(value, bias_value));
          }
        }
      }
    }
    return output;
  }

  fn batch_norm_nchw<
    E: prelude.floating_point,
    N: int,
    C: int,
    H: int,
    W: int,
    LI: mem.layout,
    PI: mem.space,
    LS: mem.layout,
    PS: mem.space,
    LB: mem.layout,
    PB: mem.space,
    LM: mem.layout,
    PM: mem.space,
    LV: mem.layout,
    PV: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, C, H, W], LI, PI>,
    scale: ref<E, [C], LS, PS>,
    bias: ref<E, [C], LB, PB>,
    mean: ref<E, [C], LM, PM>,
    variance: ref<E, [C], LV, PV>,
    epsilon: real = 1e-05
  ) -> ref<E, [N, C, H, W], LO, PO> : nn.normalization {
    output: ref<E, [N, C, H, W], LO, PO> = mem.alloc();
    channels: index = C;
    input_height: index = H;
    input_width: index = W;
    epsilon_value: E = epsilon;
    for batch: index in range(N) {
      for channel: index in range(C) {
        scale_value: E = load(scale, channel);
        bias_value: E = load(bias, channel);
        mean_value: E = load(mean, channel);
        variance_value: E = load(variance, channel);
        denominator: E = arith.sqrt(
          arith.add(variance_value, epsilon_value)
        );
        channel_offset: index = arith.add(
          arith.mul(batch, channels),
          channel
        );
        for input_y: index in range(H) {
          row_offset: index = arith.add(
            arith.mul(channel_offset, input_height),
            input_y
          );
          for input_x: index in range(W) {
            offset: index = arith.add(
              arith.mul(row_offset, input_width),
              input_x
            );
            input_value: E = load(input, offset);
            normalized: E = arith.div(
              arith.sub(input_value, mean_value),
              denominator
            );
            value: E = arith.add(
              arith.mul(scale_value, normalized),
              bias_value
            );
            store(output, offset, value);
          }
        }
      }
    }
    return output;
  }

  fn max_pool2d_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    KH: int,
    KW: int,
    SH: int,
    SW: int,
    DH: int,
    DW: int,
    PT: int,
    PL: int,
    PB: int,
    PR: int,
    LI: mem.layout,
    PI: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, C, H, W], LI, PI>,
    kernel_h: KH,
    kernel_w: KW,
    stride_h: SH = 1,
    stride_w: SW = 1,
    dilation_h: DH = 1,
    dilation_w: DW = 1,
    pad_top: PT = 0,
    pad_left: PL = 0,
    pad_bottom: PB = 0,
    pad_right: PR = 0
  ) -> ref<
    E,
    [
      N,
      C,
      @nn.conv_extent(H, KH, SH, DH, PT, PB),
      @nn.conv_extent(W, KW, SW, DW, PL, PR)
    ],
    LO,
    PO
  > : nn.pooling {
    output: ref<
      E,
      [
        N,
        C,
        @nn.conv_extent(H, KH, SH, DH, PT, PB),
        @nn.conv_extent(W, KW, SW, DW, PL, PR)
      ],
      LO,
      PO
    > = mem.alloc();
    channels: index = C;
    input_height: index = H;
    input_width: index = W;
    output_height: index = @nn.conv_extent(H, KH, SH, DH, PT, PB);
    output_width: index = @nn.conv_extent(W, KW, SW, DW, PL, PR);
    stride_height: index = SH;
    stride_width: index = SW;
    dilation_height: index = DH;
    dilation_width: index = DW;
    padding_top: index = PT;
    padding_left: index = PL;
    for batch: index in range(N) {
      for channel: index in range(C) {
        for output_y: index in range(
          @nn.conv_extent(H, KH, SH, DH, PT, PB)
        ) {
          for output_x: index in range(
            @nn.conv_extent(W, KW, SW, DW, PL, PR)
          ) {
            accumulator: E = 0;
            initialized: i1 = false;
            for kernel_y: index in range(KH) {
              input_y_padded: index = arith.add(
                arith.mul(output_y, stride_height),
                arith.mul(kernel_y, dilation_height)
              );
              if input_y_padded >= padding_top {
                input_y: index = arith.sub(input_y_padded, padding_top);
                if input_y < input_height {
                  for kernel_x: index in range(KW) {
                    input_x_padded: index = arith.add(
                      arith.mul(output_x, stride_width),
                      arith.mul(kernel_x, dilation_width)
                    );
                    if input_x_padded >= padding_left {
                      input_x: index = arith.sub(
                        input_x_padded,
                        padding_left
                      );
                      if input_x < input_width {
                        channel_offset: index = arith.add(
                          arith.mul(batch, channels),
                          channel
                        );
                        row_offset: index = arith.add(
                          arith.mul(channel_offset, input_height),
                          input_y
                        );
                        input_offset: index = arith.add(
                          arith.mul(row_offset, input_width),
                          input_x
                        );
                        value: E = load(input, input_offset);
                        if initialized {
                          accumulator = arith.max(accumulator, value);
                        } else {
                          accumulator = value;
                          initialized = true;
                        }
                      }
                    }
                  }
                }
              }
            }
            output_channel_offset: index = arith.add(
              arith.mul(batch, channels),
              channel
            );
            output_row_offset: index = arith.add(
              arith.mul(output_channel_offset, output_height),
              output_y
            );
            output_offset: index = arith.add(
              arith.mul(output_row_offset, output_width),
              output_x
            );
            store(output, output_offset, accumulator);
          }
        }
      }
    }
    return output;
  }

  fn global_average_pool_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    LI: mem.layout,
    PI: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, C, H, W], LI, PI>
  ) -> ref<E, [N, C, 1, 1], LO, PO> : nn.pooling {
    output: ref<E, [N, C, 1, 1], LO, PO> = mem.alloc();
    channels: index = C;
    input_height: index = H;
    input_width: index = W;
    area_count = H * W;
    area: E = area_count;
    for batch: index in range(N) {
      for channel: index in range(C) {
        accumulator: E = 0;
        for input_y: index in range(H) {
          for input_x: index in range(W) {
            channel_offset: index = arith.add(
              arith.mul(batch, channels),
              channel
            );
            row_offset: index = arith.add(
              arith.mul(channel_offset, input_height),
              input_y
            );
            input_offset: index = arith.add(
              arith.mul(row_offset, input_width),
              input_x
            );
            value: E = load(input, input_offset);
            accumulator = arith.add(accumulator, value);
          }
        }
        output_offset: index = arith.add(
          arith.mul(batch, channels),
          channel
        );
        store(output, output_offset, arith.div(accumulator, area));
      }
    }
    return output;
  }

  fn flatten_nchw<
    E: prelude.numeric,
    N: int,
    C: int,
    H: int,
    W: int,
    LI: mem.layout,
    PI: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, C, H, W], LI, PI>
  ) -> ref<E, [N, C * H * W], LO, PO> {
    output: ref<E, [N, C * H * W], LO, PO> = mem.alloc();
    for offset: index in range(N * C * H * W) {
      store(output, offset, load(input, offset));
    }
    return output;
  }

  fn linear<
    E: prelude.numeric,
    N: int,
    K: int,
    M: int,
    LI: mem.layout,
    PI: mem.space,
    LW: mem.layout,
    PW: mem.space,
    LB: mem.layout,
    PB: mem.space,
    LO: mem.layout,
    PO: mem.space
  >(
    input: ref<E, [N, K], LI, PI>,
    weight: ref<E, [M, K], LW, PW>,
    bias: ref<E, [M], LB, PB>
  ) -> ref<E, [N, M], LO, PO> {
    output: ref<E, [N, M], LO, PO> = mem.alloc();
    input_width: index = K;
    output_width: index = M;
    for row: index in range(N) {
      for column: index in range(M) {
        accumulator: E = load(bias, column);
        for reduction: index in range(K) {
          input_offset: index = arith.add(arith.mul(row, input_width), reduction);
          weight_offset: index = arith.add(
            arith.mul(column, input_width),
            reduction
          );
          input_value: E = load(input, input_offset);
          weight_value: E = load(weight, weight_offset);
          accumulator = arith.add(
            accumulator,
            arith.mul(input_value, weight_value)
          );
        }
        output_offset: index = arith.add(arith.mul(row, output_width), column);
        store(output, output_offset, accumulator);
      }
    }
    return output;
  }

  fn place<R: mem.reference>(input: R, slot: int) -> R : placement, mem.alias;
  fn map(input: module, tile_rows: int = 8, tile_columns: int = 8) -> module;
  fn local_bytes_upper_bound(input: module) -> int;
  fn plan_storage(input: module) -> module;
  fn scratch_bytes(input: module) -> int;
  fn simulate(input: module, target: type) -> timeline;
  fn duration(input: timeline) -> int;
  fn trace(input: timeline) -> bytes;
  fn trace(input: module, target: type) -> bytes {
    return trace(simulate(input, target));
  }
  fn cycles(input: module, target: type) -> int {
    return duration(simulate(input, target));
  }
  fn emit(input: module, target: type) -> bytes;
}
