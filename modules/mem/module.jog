module mem
use base
use ir
use tensor

local fn elements(type: Ty) -> int {
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

local fn full_range(source: Val, count: int) -> bool {
  let range = ir.def(source)
  if !ir.live(range) || ir.kind(range) != "call" ||
     ir.callee(range) != "operator .." {
    return false
  }
  let bounds = ir.args(range)
  return len(bounds) == 2 && ir.is_const(bounds[0]) &&
         ir.is_const(bounds[1]) && ir.constant(bounds[0]) == 0 &&
         ir.constant(bounds[1]) == count
}

local fn full_overwrite(m: Mod, init: Op) -> bool {
  if ir.kind(init) != "call" {
    return false
  }
  let outputs = ir.outs(init)
  if len(outputs) != 1 || !tensor.valid(ir.type(outputs[0])) ||
     !tensor.static(ir.type(outputs[0])) {
    return false
  }
  let target = ir.resolve(m, init)
  if !ir.live(target) || ir.symbol(target) != "tensor.tensor" {
    return false
  }

  let users = ir.users(outputs[0])
  if len(users) != 1 || ir.kind(users[0]) != "loop" {
    return false
  }
  let loop = users[0]
  let inputs = ir.args(loop)
  let results = ir.outs(loop)
  let bodies = ir.blks(loop)
  let shape = tensor.shape(ir.type(outputs[0]))
  let iterators = len(inputs) - 1
  if iterators <= 0 || inputs[iterators] != outputs[0] || len(results) != 1 ||
     len(bodies) != 1 {
    return false
  }

  var covers = false
  if iterators == 1 && full_range(inputs[0], elements(ir.type(outputs[0]))) {
    covers = true
  }
  if iterators == len(shape) {
    var rectangular = true
    for i in 0..iterators {
      if !full_range(inputs[i], shape[i]) {
        rectangular = false
      }
    }
    covers = covers || rectangular
  }
  if !covers {
    return false
  }

  let args = ir.args(bodies[0])
  if len(args) != len(inputs) {
    return false
  }
  let carried = args[iterators]
  let carried_users = ir.users(carried)
  if len(carried_users) != 1 || ir.kind(carried_users[0]) != "call" ||
     ir.callee(carried_users[0]) != "operator []=" {
    return false
  }
  let store = carried_users[0]
  let store_args = ir.args(store)
  let store_outs = ir.outs(store)
  if len(store_args) != iterators + 2 || store_args[0] != carried ||
     len(store_outs) != 1 {
    return false
  }
  for i in 0..iterators {
    if store_args[i + 1] != args[i] {
      return false
    }
  }
  let stored_users = ir.users(store_outs[0])
  return len(stored_users) == 1 && ir.kind(stored_users[0]) == "yield" &&
         len(ir.args(stored_users[0])) == 1 &&
         ir.args(stored_users[0])[0] == store_outs[0]
}

local fn fills(m: Mod, fn: Fn) -> bool {
  var changed = false
  for op in ir.ops(fn) {
    if ir.kind(op) == "call" {
      if full_overwrite(m, op) {
        changed = ir.set(m, op, "mem.fill", false) || changed
      } else {
        if ir.has(op, "mem.fill") {
          changed = ir.unset(m, op, "mem.fill") || changed
        }
      }
    }
  }
  return changed
}

fn plan(m: Mod, fn: Fn) -> bool {
  let before = ir.revision(m)
  fills(m, fn)
  let ops = ir.ops(fn)
  let params = ir.params(fn)
  var parameters: dict = {}
  for param in params {
    if ir.name(param) != "" {
      parameters[ir.name(param)] = true
    }
  }
  var names: list<str> = []
  var bindings: dict = {}
  var types: list<Ty> = []
  var counts: list<int> = []
  var firsts: list<int> = []
  var returned: dict = {}
  for op in ops {
    if ir.kind(op) == "return" {
      for value in ir.args(op) {
        let name = ir.name(value)
        if tensor.valid(ir.type(value)) && name != "" {
          returned[name] = true
        }
      }
    }
  }

  for at in 0..len(ops) {
    for value in ir.outs(ops[at]) {
      let type = ir.type(value)
      let name = ir.name(value)
      if tensor.valid(type) && tensor.static(type) && name != "" &&
         !ir.is_const(value) && !has(parameters, name) &&
         !has(returned, name) && !has(bindings, name) {
        bindings[name] = len(names)
        names += [name]
        types += [tensor.elem(type)]
        counts += [elements(type)]
        firsts += [at]
      }
    }
  }

  var lasts = firsts
  for at in 0..len(ops) {
    let op = ops[at]
    let kind = ir.kind(op)
    if kind != "loop" && kind != "branch" && kind != "yield" {
      for value in ir.args(op) {
        let name = ir.name(value)
        if has(bindings, name) {
          let item = int(bindings[name])
          assert(tensor.valid(ir.type(value)) &&
                 tensor.elem(ir.type(value)) == types[item],
                 "mem: one binding changed tensor element type")
          if at > lasts[item] {
            lasts[item] = int(at)
          }
        }
      }
    }
  }

  var slot_types: list<Ty> = []
  var slot_counts: list<int> = []
  var slot_ends: list<int> = []
  var slots: list<int> = []
  for item in 0..len(names) {
    var selected = -1
    for slot in 0..len(slot_types) {
      if selected < 0 && slot_types[slot] == types[item] &&
         slot_ends[slot] < firsts[item] {
        selected = slot
      }
    }
    if selected < 0 {
      selected = len(slot_types)
      slot_types += [types[item]]
      slot_counts += [counts[item]]
      slot_ends += [lasts[item]]
    } else {
      if counts[item] > slot_counts[selected] {
        slot_counts[selected] = counts[item]
      }
      slot_ends[selected] = lasts[item]
    }
    slots += [selected]
  }

  var placed: dict = {}
  var values: list<Val> = []
  for value in params {
    let name = ir.name(value)
    if tensor.valid(ir.type(value)) && name != "" && !has(placed, name) {
      placed[name] = true
      values += [value]
    }
  }
  for body in ir.blks(fn) {
    for value in ir.args(body) {
      let name = ir.name(value)
      if tensor.valid(ir.type(value)) && name != "" && !has(placed, name) {
        placed[name] = true
        values += [value]
      }
    }
  }
  for op in ops {
    for value in ir.outs(op) {
      let name = ir.name(value)
      if tensor.valid(ir.type(value)) && name != "" && !has(placed, name) {
        placed[name] = true
        values += [value]
      }
    }
  }
  var assigned: list<Val> = []
  var assigned_slots: list<int> = []
  for value in values {
    let name = ir.name(value)
    if has(bindings, name) {
      assigned += [value]
      assigned_slots += [slots[int(bindings[name])]]
    } else {
      if ir.has(value, "mem.slot") {
        ir.unset(m, value, "mem.slot")
      }
    }
  }
  if len(assigned) != 0 {
    ir.set(m, assigned, "mem.slot", assigned_slots)
  }
  var type_names: list<str> = []
  for type in slot_types {
    type_names += [text(type)]
  }
  ir.set(m, fn, "mem.types", type_names)
  ir.set(m, fn, "mem.counts", slot_counts)
  return ir.revision(m) != before
}

fn plan(m: Mod) -> bool {
  var changed = false
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      changed = plan(m, fn) || changed
    }
  }
  return changed
}

fn planned(value: Val) -> bool {
  return ir.has(value, "mem.slot")
}

fn slot(value: Val) -> int {
  return int(ir.meta(value, "mem.slot"))
}

fn slots(fn: Fn) -> int {
  if !ir.has(fn, "mem.types") {
    return 0
  }
  return len(ir.meta(fn, "mem.types"))
}

fn type(fn: Fn, slot: int) -> Ty {
  return ty(str(ir.meta(fn, "mem.types")[slot]))
}

fn count(fn: Fn, slot: int) -> int {
  return int(ir.meta(fn, "mem.counts")[slot])
}

fn buffers(m: Mod) -> int {
  var out = 0
  for fn in ir.fns(m) {
    out += slots(fn)
  }
  return out
}
