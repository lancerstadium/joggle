module mem
use base
use bounds
use ir
use tensor

local fn elements(type: Ty) -> int {
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

local fn elements(shape: list<int>) -> int {
  var out = 1
  for extent in shape {
    if extent < 0 || (extent != 0 && out > 9223372036854775807 / extent) {
      return -1
    }
    out *= extent
  }
  return out
}

local fn interval(m: Mod, value: Val, known: dict) -> list<int> {
  let inferred = bounds.get(known, value)
  if len(inferred) == 2 {
    return inferred
  }
  if ir.is_const(value) && base.kind(ir.constant(value)) == "int" {
    let exact = base.int(ir.constant(value))
    return [exact, exact]
  }
  let cast = ir.def(value)
  if ir.live(cast) && ir.kind(cast) == "call" &&
     len(ir.args(cast)) == 1 &&
     (ir.callee(cast) == base.name(ir.type(value)) ||
      ir.target(m, cast) == "base." + base.name(ir.type(value))) {
    return interval(m, ir.args(cast)[0], known)
  }
  return []
}

local fn shape_values(
  m: Mod, shape: Val, known: dict
) -> list<Val> {
  let type = ir.type(shape)
  if !tensor.valid(type) || !tensor.static(type) ||
     len(tensor.shape(type)) != 1 {
    return []
  }
  let count = tensor.shape(type)[0]
  let source = ir.def(shape)
  if !ir.live(source) || ir.kind(source) != "call" {
    return []
  }
  let target = ir.target(m, source)
  let inputs = ir.args(source)
  if target == "tensor.tensor" && len(inputs) == 1 {
    var out: list<Val> = []
    for i in 0..count {
      out += [inputs[0]]
    }
    return out
  }
  if (target != "tensor.operator []=" &&
      ir.callee(source) != "operator []=") || len(inputs) != 3 {
    return []
  }
  var out = shape_values(m, inputs[0], known)
  let index = interval(m, inputs[1], known)
  if len(out) != count || len(index) != 2 || index[0] != index[1] ||
     index[0] < 0 || index[0] >= count {
    return []
  }
  out[index[0]] = inputs[2]
  return out
}

local fn capacity_with(
  m: Mod, value: Val, known: dict
) -> list<int> {
  let type = ir.type(value)
  if !tensor.valid(type) {
    return []
  }
  if tensor.static(type) {
    return tensor.shape(type)
  }
  let source = ir.def(value)
  if !ir.live(source) || ir.kind(source) != "call" ||
     (ir.target(m, source) != "tensor.make" &&
      ir.callee(source) != "tensor.make") || len(ir.args(source)) != 2 {
    return []
  }
  let values = shape_values(m, ir.args(source)[1], known)
  let dims = tensor.dims(type)
  if len(values) != len(dims) {
    return []
  }
  var out: list<int> = []
  for axis in 0..len(dims) {
    let extent = interval(m, values[axis], known)
    if len(extent) != 2 || extent[0] < 0 || extent[1] < extent[0] {
      return []
    }
    if base.kind(dims[axis]) == "int" {
      let fixed = base.int(dims[axis])
      if extent[0] != fixed || extent[1] != fixed {
        return []
      }
      out += [fixed]
    } else {
      out += [extent[1]]
    }
  }
  if elements(out) < 0 {
    return []
  }
  return out
}

fn capacity(m: Mod, value: Val) -> list<int> {
  if ir.has(value, "mem.capacity") {
    var recorded: list<int> = []
    for extent in ir.meta(value, "mem.capacity") {
      recorded += [base.int(extent)]
    }
    return recorded
  }
  let source = ir.def(value)
  if ir.live(source) && ir.kind(source) == "call" &&
     (ir.target(m, source) == "tensor.view" ||
      ir.callee(source) == "tensor.view") && len(ir.args(source)) == 2 {
    return capacity(m, ir.args(source)[0])
  }
  if ir.live(source) && ir.kind(source) == "call" &&
     (ir.target(m, source) == "base.copy" ||
      ir.target(m, source) == "tensor.write" ||
      ir.callee(source) == "base.copy" ||
      ir.callee(source) == "tensor.write") &&
     len(ir.args(source)) != 0 {
    return capacity(m, ir.args(source)[0])
  }
  let known = bounds.infer(m)
  let direct = capacity_with(m, value, known)
  if len(direct) != 0 || !ir.live(source) || ir.name(value) == "" {
    return direct
  }
  let fn = ir.owner(ir.blk(source))
  for candidate in ir.vals(fn) {
    if ir.name(candidate) == ir.name(value) {
      let inherited = capacity_with(m, candidate, known)
      if len(inherited) != 0 {
        return inherited
      }
    }
  }
  return []
}

fn bound(m: Mod) -> bool {
  let known = bounds.infer(m)
  var changed = false
  for fn in ir.fns(m) {
    var desired: dict = {}
    for value in ir.vals(fn) {
      let source = ir.def(value)
      let owns = ir.live(source) && ir.kind(source) == "call" &&
                  (ir.target(m, source) == "tensor.make" ||
                   ir.callee(source) == "tensor.make")
      if owns {
        let shape = capacity_with(m, value, known)
        if len(shape) != 0 && ir.name(value) != "" {
          desired[ir.name(value)] = shape
        }
      }
    }
    for value in ir.vals(fn) {
      let name = ir.name(value)
      if name != "" && base.has(desired, name) {
        changed = ir.set(
          m, value, "mem.capacity", desired[name]
        ) || changed
      } else {
        if ir.has(value, "mem.capacity") {
          changed = ir.unset(m, value, "mem.capacity") || changed
        }
      }
    }
  }
  return changed
}

local fn allocated(value: Val) -> int {
  let type = ir.type(value)
  if tensor.valid(type) && tensor.static(type) {
    return elements(type)
  }
  if ir.has(value, "mem.capacity") {
    var shape: list<int> = []
    for extent in ir.meta(value, "mem.capacity") {
      shape += [base.int(extent)]
    }
    return elements(shape)
  }
  return -1
}

local fn full_range(source: Val, count: int) -> bool {
  let range = ir.def(source)
  if !ir.live(range) || ir.kind(range) != "call" ||
     ir.callee(range) != "operator .." {
    return false
  }
  let bounds = ir.args(range)
  return len(bounds) == 2 && ir.is_const(bounds[0]) &&
         ir.is_const(bounds[1]) && ir.constant(bounds[0]) == 0 &&
         ir.constant(bounds[1]) == count
}

local fn full_overwrite(m: Mod, init: Op) -> bool {
  if ir.kind(init) != "call" {
    return false
  }
  let outputs = ir.outs(init)
  if len(outputs) != 1 || !tensor.valid(ir.type(outputs[0])) ||
     !tensor.static(ir.type(outputs[0])) {
    return false
  }
  let target = ir.resolve(m, init)
  if !ir.live(target) || ir.symbol(target) != "tensor.tensor" {
    return false
  }

  let users = ir.users(outputs[0])
  if len(users) != 1 || ir.kind(users[0]) != "loop" {
    return false
  }
  let loop = users[0]
  let inputs = ir.args(loop)
  let results = ir.outs(loop)
  let bodies = ir.blks(loop)
  let shape = tensor.shape(ir.type(outputs[0]))
  let iterators = len(inputs) - 1
  if iterators <= 0 || inputs[iterators] != outputs[0] || len(results) != 1 ||
     len(bodies) != 1 {
    return false
  }

  var covers = false
  if iterators == 1 && full_range(inputs[0], elements(ir.type(outputs[0]))) {
    covers = true
  }
  if iterators == len(shape) {
    var rectangular = true
    for i in 0..iterators {
      if !full_range(inputs[i], shape[i]) {
        rectangular = false
      }
    }
    covers = covers || rectangular
  }
  if !covers {
    return false
  }

  let args = ir.args(bodies[0])
  if len(args) != len(inputs) {
    return false
  }
  let carried = args[iterators]
  let carried_users = ir.users(carried)
  if len(carried_users) != 1 || ir.kind(carried_users[0]) != "call" ||
     ir.callee(carried_users[0]) != "operator []=" {
    return false
  }
  let store = carried_users[0]
  let store_args = ir.args(store)
  let store_outs = ir.outs(store)
  if len(store_args) != iterators + 2 || store_args[0] != carried ||
     len(store_outs) != 1 {
    return false
  }
  for i in 0..iterators {
    if store_args[i + 1] != args[i] {
      return false
    }
  }
  let stored_users = ir.users(store_outs[0])
  return len(stored_users) == 1 && ir.kind(stored_users[0]) == "yield" &&
         len(ir.args(stored_users[0])) == 1 &&
         ir.args(stored_users[0])[0] == store_outs[0]
}

local fn fills(m: Mod, fn: Fn) -> bool {
  var changed = false
  for op in ir.ops(fn) {
    if ir.kind(op) == "call" {
      if full_overwrite(m, op) {
        changed = ir.set(m, op, "mem.fill", false) || changed
      } else {
        if ir.has(op, "mem.fill") {
          changed = ir.unset(m, op, "mem.fill") || changed
        }
      }
    }
  }
  return changed
}

fn plan(m: Mod, fn: Fn) -> bool {
  let before = ir.revision(m)
  fills(m, fn)
  let ops = ir.ops(fn)
  let params = ir.params(fn)
  var parameters: dict = {}
  for param in params {
    if ir.name(param) != "" {
      parameters[ir.name(param)] = true
    }
  }
  var names: list<str> = []
  var bindings: dict = {}
  var types: list<Ty> = []
  var counts: list<int> = []
  var firsts: list<int> = []
  var returned: dict = {}
  for op in ops {
    if ir.kind(op) == "return" {
      for value in ir.args(op) {
        let name = ir.name(value)
        if tensor.valid(ir.type(value)) && name != "" {
          returned[name] = true
        }
      }
    }
  }

  for at in 0..len(ops) {
    for value in ir.outs(ops[at]) {
      let type = ir.type(value)
      let name = ir.name(value)
      let count = allocated(value)
      if tensor.valid(type) && count >= 0 && name != "" &&
         !ir.is_const(value) && !has(parameters, name) &&
         !has(returned, name) && !has(bindings, name) {
        bindings[name] = len(names)
        names += [name]
        types += [tensor.elem(type)]
        counts += [count]
        firsts += [at]
      }
    }
  }

  var lasts = firsts
  for at in 0..len(ops) {
    let op = ops[at]
    let kind = ir.kind(op)
    if kind != "loop" && kind != "branch" && kind != "yield" {
      for value in ir.args(op) {
        let name = ir.name(value)
        if has(bindings, name) {
          let item = int(bindings[name])
          assert(tensor.valid(ir.type(value)) &&
                 tensor.elem(ir.type(value)) == types[item],
                 "mem: one binding changed tensor element type")
          if at > lasts[item] {
            lasts[item] = int(at)
          }
        }
      }
    }
  }

  var slot_types: list<Ty> = []
  var slot_counts: list<int> = []
  var slot_ends: list<int> = []
  var slots: list<int> = []
  for item in 0..len(names) {
    var selected = -1
    for slot in 0..len(slot_types) {
      if selected < 0 && slot_types[slot] == types[item] &&
         slot_ends[slot] < firsts[item] {
        selected = slot
      }
    }
    if selected < 0 {
      selected = len(slot_types)
      slot_types += [types[item]]
      slot_counts += [counts[item]]
      slot_ends += [lasts[item]]
    } else {
      if counts[item] > slot_counts[selected] {
        slot_counts[selected] = counts[item]
      }
      slot_ends[selected] = lasts[item]
    }
    slots += [selected]
  }

  var placed: dict = {}
  var values: list<Val> = []
  for value in params {
    let name = ir.name(value)
    if tensor.valid(ir.type(value)) && name != "" && !has(placed, name) {
      placed[name] = true
      values += [value]
    }
  }
  for body in ir.blks(fn) {
    for value in ir.args(body) {
      let name = ir.name(value)
      if tensor.valid(ir.type(value)) && name != "" && !has(placed, name) {
        placed[name] = true
        values += [value]
      }
    }
  }
  for op in ops {
    for value in ir.outs(op) {
      let name = ir.name(value)
      if tensor.valid(ir.type(value)) && name != "" && !has(placed, name) {
        placed[name] = true
        values += [value]
      }
    }
  }
  var assigned: list<Val> = []
  var assigned_slots: list<int> = []
  for value in values {
    let name = ir.name(value)
    if has(bindings, name) {
      assigned += [value]
      assigned_slots += [slots[int(bindings[name])]]
    } else {
      if ir.has(value, "mem.slot") {
        ir.unset(m, value, "mem.slot")
      }
    }
  }
  if len(assigned) != 0 {
    ir.set(m, assigned, "mem.slot", assigned_slots)
  }
  var type_names: list<str> = []
  for type in slot_types {
    type_names += [text(type)]
  }
  ir.set(m, fn, "mem.types", type_names)
  ir.set(m, fn, "mem.counts", slot_counts)
  return ir.revision(m) != before
}

fn plan(m: Mod) -> bool {
  var changed = bound(m)
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      changed = plan(m, fn) || changed
    }
  }
  return changed
}

fn planned(value: Val) -> bool {
  return ir.has(value, "mem.slot")
}

fn slot(value: Val) -> int {
  return int(ir.meta(value, "mem.slot"))
}

local fn payload(value: Val) -> bool {
  return tensor.valid(ir.type(value)) && ir.is_const(value) &&
         base.kind(ir.constant(value)) == "bytes"
}

local fn separate(left: Val, right: Val) -> bool {
  if !tensor.valid(ir.type(left)) || !tensor.valid(ir.type(right)) ||
     left == right {
    return false
  }
  if planned(left) && planned(right) {
    return slot(left) != slot(right)
  }
  if planned(left) && payload(right) {
    return true
  }
  if payload(left) && planned(right) {
    return true
  }
  return payload(left) && payload(right)
}

local fn separate(values: list<Val>) -> bool {
  for i in 0..len(values) {
    if !tensor.valid(ir.type(values[i])) {
      return false
    }
    for j in i + 1..len(values) {
      if !separate(values[i], values[j]) {
        return false
      }
    }
  }
  return true
}

fn separate(op: Op) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  var values: list<Val> = []
  for value in ir.args(op) {
    if tensor.valid(ir.type(value)) {
      values += [value]
    }
  }
  for value in ir.outs(op) {
    if tensor.valid(ir.type(value)) {
      values += [value]
    }
  }
  return separate(values)
}

fn slots(fn: Fn) -> int {
  if !ir.has(fn, "mem.types") {
    return 0
  }
  return len(ir.meta(fn, "mem.types"))
}

fn type(fn: Fn, slot: int) -> Ty {
  return ty(str(ir.meta(fn, "mem.types")[slot]))
}

fn count(fn: Fn, slot: int) -> int {
  return int(ir.meta(fn, "mem.counts")[slot])
}

fn buffers(m: Mod) -> int {
  var out = 0
  for fn in ir.fns(m) {
    out += slots(fn)
  }
  return out
}
