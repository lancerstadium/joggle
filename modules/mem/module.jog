module mem
use base
use ir
use tensor

fn position(ops: list<Op>, target: Op) -> int {
  for i in 0..len(ops) {
    if ops[i] == target {
      return i
    }
  }
  return -1
}

fn values(fn: Fn) -> list<Val> {
  var out = ir.params(fn)
  for body in ir.blks(fn) {
    for value in ir.args(body) {
      var seen = false
      for prior in out {
        if prior == value {
          seen = true
        }
      }
      if !seen {
        out += [value]
      }
    }
  }
  for op in ir.ops(fn) {
    for value in ir.outs(op) {
      var seen = false
      for prior in out {
        if prior == value {
          seen = true
        }
      }
      if !seen {
        out += [value]
      }
    }
  }
  return out
}

fn parameter(params: list<Val>, name: str) -> bool {
  for param in params {
    if ir.name(param) == name {
      return true
    }
  }
  return false
}

fn group(names: list<str>, name: str) -> int {
  for i in 0..len(names) {
    if names[i] == name {
      return i
    }
  }
  return -1
}

fn plan(m: Mod, fn: Fn) -> bool {
  let ops = ir.ops(fn)
  let params = ir.params(fn)
  let vals = values(fn)
  var names: list<str> = []
  var types: list<Ty> = []
  var counts: list<int> = []
  var firsts: list<int> = []

  for at in 0..len(ops) {
    for value in ir.outs(ops[at]) {
      let type = ir.type(value)
      let name = ir.name(value)
      if tensor.valid(type) && tensor.static(type) && name != "" &&
         !ir.is_const(value) && !parameter(params, name) &&
         group(names, name) < 0 {
        names += [name]
        types += [tensor.elem(type)]
        var count = 1
        for extent in tensor.shape(type) {
          count *= extent
        }
        counts += [count]
        firsts += [at]
      }
    }
  }

  var lasts = firsts
  for value in vals {
    let at = group(names, ir.name(value))
    if at >= 0 {
      assert(tensor.valid(ir.type(value)) &&
             tensor.elem(ir.type(value)) == types[at],
             "mem: one binding changed tensor element type")
      for user in ir.users(value) {
        let kind = ir.kind(user)
        if kind != "loop" && kind != "branch" && kind != "yield" {
          let use = position(ops, user)
          if use > lasts[at] {
            lasts[at] = use
          }
        }
      }
    }
  }

  var slot_types: list<Ty> = []
  var slot_counts: list<int> = []
  var slot_ends: list<int> = []
  var slots: list<int> = []
  for item in 0..len(names) {
    var selected = -1
    for slot in 0..len(slot_types) {
      if selected < 0 && slot_types[slot] == types[item] &&
         slot_ends[slot] < firsts[item] {
        selected = slot
      }
    }
    if selected < 0 {
      selected = len(slot_types)
      slot_types += [types[item]]
      slot_counts += [counts[item]]
      slot_ends += [lasts[item]]
    } else {
      if counts[item] > slot_counts[selected] {
        slot_counts[selected] = counts[item]
      }
      slot_ends[selected] = lasts[item]
    }
    slots += [selected]
  }

  var changed = false
  for value in vals {
    let at = group(names, ir.name(value))
    if at >= 0 && tensor.valid(ir.type(value)) {
      changed = ir.set(m, value, "mem.slot", slots[at]) || changed
    } else {
      changed = ir.unset(m, value, "mem.slot") || changed
    }
  }
  var type_names: list<str> = []
  for type in slot_types {
    type_names += [text(type)]
  }
  changed = ir.set(m, fn, "mem.types", type_names) || changed
  changed = ir.set(m, fn, "mem.counts", slot_counts) || changed
  return changed
}

fn plan(m: Mod) -> bool {
  var changed = false
  for fn in ir.fns(m) {
    if len(ir.blks(fn)) != 0 {
      changed = plan(m, fn) || changed
    }
  }
  return changed
}

fn planned(value: Val) -> bool {
  return ir.has(value, "mem.slot")
}

fn slot(value: Val) -> int {
  return int(ir.meta(value, "mem.slot"))
}

fn slots(fn: Fn) -> int {
  if !ir.has(fn, "mem.types") {
    return 0
  }
  return len(ir.meta(fn, "mem.types"))
}

fn type(fn: Fn, slot: int) -> Ty {
  return ty(str(ir.meta(fn, "mem.types")[slot]))
}

fn count(fn: Fn, slot: int) -> int {
  return int(ir.meta(fn, "mem.counts")[slot])
}

fn buffers(m: Mod) -> int {
  var out = 0
  for fn in ir.fns(m) {
    out += slots(fn)
  }
  return out
}
