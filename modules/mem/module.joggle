joggle 1;

module mem@1.0.0 {
  interface layout: type;
  interface space: type;
  interface reference: type {
    element_type: type;
    shape: list<int>;
    layout_type: type;
    space_type: type;
  }
  interface read: fn;
  interface write: fn;
  interface allocate: fn;
  interface release: fn;
  interface alias: fn;

  type linear() : layout;
  type generic() : space;
  type ref(element: type, shape: list<int>, layout: type, space: type) : reference {
    element_type = element;
    layout_type = layout;
    space_type = space;
  }

  fn alloc<T: reference>() -> T : allocate;
  fn view<From: reference, To: reference>(
    source: From,
    offsets: list<int>,
    strides: list<int>
  ) -> To : alias;
  fn load<T: reference>(source: T, indices: index...) -> T.element_type : read;
  fn store<T: reference>(
    destination: T,
    value: T.element_type,
    indices: index...
  ) : write;
  fn copy<From: reference, To: reference>(source: From, destination: To) : read, write;
  fn dealloc<T: reference>(target: T) : release;
}
