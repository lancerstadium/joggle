module base

fn copy<T: Ty>(x: T) -> T;

fn len<T: Ty>(xs: list<T>) -> int;
fn len(xs: dict) -> int;
fn size(x: Attr) -> int;
fn byte(x: Attr, index: int) -> int;
fn keys(xs: dict) -> list<str>;
fn has(xs: dict, key: str) -> bool;
fn get(xs: dict, key: str) -> Attr;
fn get(xs: dict, key: str, fallback: Attr) -> Attr;
fn kind(x: Attr) -> str;
fn kind(x: Ty) -> str;

fn name(type: Ty) -> str;
fn args(type: Ty) -> list<Ty>;
fn int(type: Ty) -> int;
fn str(type: Ty) -> str;
fn ty(text: str) -> Ty;
fn ty(value: int) -> Ty;
fn ty(name: str, args: list<Ty>) -> Ty;

fn []<T: Ty>(xs: list<T>, index: int) -> T;
fn [](xs: dict, key: str) -> Attr;

fn +<T: Ty>(x: T) -> T;
fn +<A: Ty, B: Ty>(a: A, b: B) -> A;
fn -<T: Ty>(x: T) -> T;
fn -<A: Ty, B: Ty>(a: A, b: B) -> A;
fn !<T: Ty>(x: T) -> bool;
fn ~<T: Ty>(x: T) -> T;
fn *<A: Ty, B: Ty>(a: A, b: B) -> A;
fn /<A: Ty, B: Ty>(a: A, b: B) -> A;
fn %<A: Ty, B: Ty>(a: A, b: B) -> A;
fn |<T: Ty>(a: T, b: T) -> T;
fn ^<T: Ty>(a: T, b: T) -> T;
fn &<T: Ty>(a: T, b: T) -> T;
fn << <T: Ty>(a: T, b: int) -> T;
fn >><T: Ty>(a: T, b: int) -> T;
fn ==<A: Ty, B: Ty>(a: A, b: B) -> bool;
fn !=<A: Ty, B: Ty>(a: A, b: B) -> bool;
fn < <A: Ty, B: Ty>(a: A, b: B) -> bool;
fn <= <A: Ty, B: Ty>(a: A, b: B) -> bool;
fn ><A: Ty, B: Ty>(a: A, b: B) -> bool;
fn >=<A: Ty, B: Ty>(a: A, b: B) -> bool;
fn ..<A: Ty, B: Ty>(a: A, b: B) -> range;
