module base

fn copy<T: Ty>(x: T) -> T;

fn +<T: Ty>(x: T) -> T;
fn +<T: Ty>(a: T, b: T) -> T;
fn -<T: Ty>(x: T) -> T;
fn -<T: Ty>(a: T, b: T) -> T;
fn !<T: Ty>(x: T) -> bool;
fn ~<T: Ty>(x: T) -> T;
fn *<T: Ty>(a: T, b: T) -> T;
fn /<T: Ty>(a: T, b: T) -> T;
fn %<T: Ty>(a: T, b: T) -> T;
fn |<T: Ty>(a: T, b: T) -> T;
fn ^<T: Ty>(a: T, b: T) -> T;
fn &<T: Ty>(a: T, b: T) -> T;
fn << <T: Ty>(a: T, b: int) -> T;
fn >><T: Ty>(a: T, b: int) -> T;
fn ==<A: Ty, B: Ty>(a: A, b: B) -> bool;
fn !=<A: Ty, B: Ty>(a: A, b: B) -> bool;
fn < <A: Ty, B: Ty>(a: A, b: B) -> bool;
fn <= <A: Ty, B: Ty>(a: A, b: B) -> bool;
fn ><A: Ty, B: Ty>(a: A, b: B) -> bool;
fn >=<A: Ty, B: Ty>(a: A, b: B) -> bool;
fn &&(a: bool, b: bool) -> bool;
fn ||(a: bool, b: bool) -> bool;
fn ..<A: Ty, B: Ty>(a: A, b: B) -> range;
