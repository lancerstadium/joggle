module sat
use ir

fn sat<W: int>() -> Ty;
fn +<W: int>(a: sat<W>, b: sat<W>) -> sat<W>;
fn add<W: int>(a: sat<W>, b: sat<W>) -> sat<W>;

[role: "match"]
fn supports(type: str) -> bool;

[role: "sim"]
fn sim(width: int, a: int, b: int) -> int;

[role: "emit", format: "sv"]
fn emit(width: int) -> str;

[stage: "select"]
fn select(m: Mod) -> bool {
  var changed = false
  for f in ir.fns(m) {
    for b in ir.blks(f) {
      for op in ir.ops(b) {
        if ir.callee(op) == "operator +" {
          let outs = ir.outs(op)
          if ir.len(outs) == 1 {
            if sat.supports(ir.type(outs[0])) {
              changed = ir.rename(m, op, "sat.add")
            }
          }
        }
      }
    }
  }
  return changed
}
