module quant
use tensor
use math

fn param(
  shape: list<int>, params: list<int>, linear: int, axis: int
) -> int {
  if len(params) == 0 || params[0] == 1 {
    return 0
  }
  var stride = 1
  for dim in axis + 1..len(shape) {
    stride *= shape[dim]
  }
  return (linear / stride) % shape[axis]
}

fn dequantize<
  Q: Ty,
  E: Ty,
  S: list<int>,
  P: list<int>
>(
  x: tensor<Q, S>,
  scale: tensor<E, P>,
  zero: tensor<Q, P>,
  axis: int
) -> tensor<E, S> {
  var out = tensor<E, S>(E(0))
  for i in 0..tensor.numel<S>() {
    let p = param(S, P, i, axis)
    out[i] = (E(x[i]) - E(zero[p])) * scale[p]
  }
  return out
}

fn matmul<
  A: Ty,
  B: Ty,
  L: list<int>,
  R: list<int>,
  Y: list<int>,
  ZA: list<int>,
  ZB: list<int>
>(
  a: tensor<A, L>,
  b: tensor<B, R>,
  a_zero: tensor<A, ZA>,
  b_zero: tensor<B, ZB>
) -> tensor<i32, Y> {
  let m = L[len(L) - 2]
  let depth = L[len(L) - 1]
  let n = R[len(R) - 1]
  let batches = tensor.numel<Y>() / (m * n)
  var out = tensor<i32, Y>(i32(0))
  for batch in 0..batches, row in 0..m, column in 0..n {
    var sum = i32(0)
    var az = 0
    var bz = 0
    if tensor.numel<ZA>() != 1 {
      az = row
    }
    if tensor.numel<ZB>() != 1 {
      bz = column
    }
    for k in 0..depth {
      let ai = tensor.matmul_offset(L, Y, batch, row, k)
      let bi = tensor.matmul_offset(R, Y, batch, k, column)
      sum += (i32(a[ai]) - i32(a_zero[az])) *
             (i32(b[bi]) - i32(b_zero[bz]))
    }
    out[batch * m * n + row * n + column] = sum
  }
  return out
}

fn quantize<
  E: Ty,
  Q: Ty,
  S: list<int>,
  P: list<int>
>(
  x: tensor<E, S>,
  scale: tensor<E, P>,
  zero: tensor<Q, P>,
  axis: int,
  low: int,
  high: int
) -> tensor<Q, S> {
  var out = tensor<Q, S>(Q(0))
  for i in 0..tensor.numel<S>() {
    let p = param(S, P, i, axis)
    var value = round_even(x[i] / scale[p]) + E(zero[p])
    if value < E(low) {
      value = E(low)
    }
    if value > E(high) {
      value = E(high)
    }
    out[i] = Q(value)
  }
  return out
}

fn dynamic<E: Ty, S: list<int>>(
  x: tensor<E, S>
) -> (tensor<u8, S>, tensor<E, []>, tensor<u8, []>) {
  var low = E(0)
  var high = E(0)
  for i in 0..tensor.numel<S>() {
    if x[i] < low {
      low = x[i]
    }
    if x[i] > high {
      high = x[i]
    }
  }
  var scale_value = E(1)
  var zero_value = E(0)
  if high != low {
    scale_value = (high - low) / E(255)
    zero_value = round_even(-low / scale_value)
    if zero_value < E(0) {
      zero_value = E(0)
    }
    if zero_value > E(255) {
      zero_value = E(255)
    }
  }
  let scale = tensor<E, []>(scale_value)
  let zero = tensor<u8, []>(u8(zero_value))
  let values = quantize(x, scale, zero, 0, 0, 255)
  return values, scale, zero
}
