module onnx.nn
use onnx
use nn
use quant
use ir

local fn set_type(m: Mod, value: Val, type: Ty) -> bool {
  if type == ty("_") {
    return false
  }
  let current = ir.type(value)
  if current == ty("_") {
    return ir.type(m, value, type)
  }
  let refined = tensor.refined(current, type)
  if refined != ty("_") && refined != current {
    return ir.type(m, value, refined)
  }
  return false
}

local fn attrs(op: Op) -> Attr {
  return base.get(ir.meta(op), "onnx", {})
}

local fn refine_graph_ref(m: Mod, op: Op, ref: Attr) -> bool {
  if base.kind(ref) != "dict" || !base.has(ref, "fn") ||
     !base.has(ref, "inputs") || !base.has(ref, "captures") ||
     base.kind(ref["fn"]) != "str" ||
     base.kind(ref["inputs"]) != "int" ||
     base.kind(ref["captures"]) != "list" {
    return false
  }
  let graph = ir.find(m, base.str(ref["fn"]))
  if !ir.live(graph) {
    return false
  }
  let first = base.int(ref["inputs"])
  let params = ir.params(graph)
  let inputs = ir.args(op)
  if first < 0 || first + len(ref["captures"]) > len(params) {
    return false
  }
  for capture in ref["captures"] {
    if base.kind(capture) != "int" {
      return false
    }
    let index = base.int(capture)
    if index < 0 || index >= len(inputs) {
      return false
    }
  }
  var changed = false
  var offset = 0
  for capture in ref["captures"] {
    let index = base.int(capture)
    changed = set_type(
      m, params[first + offset], ir.type(inputs[index])
    ) || changed
    offset += 1
  }
  return changed
}

[phase: "infer", on: "*"]
local fn refine_graphs(m: Mod, op: Op) -> bool {
  var changed = false
  let meta = attrs(op)
  for key in base.keys(meta) {
    let value = meta[key]
    if base.kind(value) == "dict" {
      changed = refine_graph_ref(m, op, value) || changed
    }
    if base.kind(value) == "list" {
      for item in value {
        changed = refine_graph_ref(m, op, item) || changed
      }
    }
  }
  return changed
}

local fn shaped(elem: Ty, dims: list<Ty>) -> Ty {
  return ty("tensor", [elem, ty("[]", dims)])
}

local fn same_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 0 && len(outputs) == 1 {
    let type = ir.type(inputs[0])
    if tensor.valid(type) {
      return set_type(m, outputs[0], type)
    }
  }
  return false
}

local fn dropout_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 3 ||
     len(outputs) < 1 || len(outputs) > 2 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  var changed = set_type(m, outputs[0], input)
  if len(outputs) == 2 {
    changed = set_type(
      m, outputs[1], shaped(ty("bool"), tensor.dims(input))
    ) || changed
  }
  return changed
}

local fn unary_rules() -> list<list<str>> {
  return [
    ["onnx.Relu", "nn.relu"],
    ["onnx.Dropout", "base.copy"],
    ["onnx.Sqrt", "nn.sqrt"],
    ["onnx.Reciprocal", "nn.recip"],
    ["onnx.Tanh", "nn.tanh"],
    ["onnx.Exp", "nn.exp"],
    ["onnx.Floor", "nn.floor"],
    ["onnx.Log", "nn.log"],
    ["onnx.Erf", "nn.erf"],
    ["onnx.Sigmoid", "nn.sigmoid"],
    ["onnx.Ceil", "nn.ceil"],
    ["onnx.Round", "nn.round_even"]
  ]
}

[phase: "infer", on: [
  "onnx.Relu", "onnx.Dropout", "onnx.Sqrt", "onnx.Reciprocal",
  "onnx.Tanh", "onnx.Exp", "onnx.Floor", "onnx.Log", "onnx.Erf",
  "onnx.Sigmoid", "onnx.Ceil", "onnx.Round",
  "onnx.BatchNormalization", "onnx.LeakyRelu", "onnx.Softmax",
  "onnx.Identity", "onnx.Clip", "onnx.LRN"
]]
local fn infer_unary(m: Mod, op: Op) -> bool {
  let callee = ir.callee(op)
  if callee == "onnx.Dropout" {
    return dropout_type(m, op)
  }
  for rule in unary_rules() {
    if callee == rule[0] {
      return same_type(m, op)
    }
  }
  if callee == "onnx.BatchNormalization" ||
     callee == "onnx.LeakyRelu" || callee == "onnx.Softmax" ||
     callee == "onnx.Identity" || callee == "onnx.Clip" ||
     callee == "onnx.LRN" {
    return same_type(m, op)
  }
  return false
}

local fn spatial_pad(op: Op, kernel: list<int>) -> list<int> {
  var none: list<int> = []
  let inputs = ir.args(op)
  if len(inputs) == 0 || len(kernel) != 2 {
    return none
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return none
  }
  let shape = tensor.dims(input)
  if len(shape) != 4 || kernel[0] <= 0 || kernel[1] <= 0 {
    return none
  }
  let meta = attrs(op)
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(stride) != 2 || len(dilation) != 2 ||
     stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return none
  }
  let mode = base.get(meta, "auto_pad", "NOTSET")
  if mode == "NOTSET" {
    let pad = base.get(meta, "pads", [0, 0, 0, 0])
    if len(pad) == 4 {
      return pad
    }
    return none
  }
  if mode == "VALID" {
    return [0, 0, 0, 0]
  }
  if mode != "SAME_UPPER" && mode != "SAME_LOWER" {
    return none
  }
  if kind(shape[2]) != "int" || kind(shape[3]) != "int" {
    return none
  }
  let h = int(shape[2])
  let w = int(shape[3])
  let oh = (h + stride[0] - 1) / stride[0]
  let ow = (w + stride[1] - 1) / stride[1]
  let kh = dilation[0] * (kernel[0] - 1) + 1
  let kw = dilation[1] * (kernel[1] - 1) + 1
  var ph = (oh - 1) * stride[0] + kh - h
  var pw = (ow - 1) * stride[1] + kw - w
  if ph < 0 {
    ph = 0
  }
  if pw < 0 {
    pw = 0
  }
  var top = ph / 2
  var left = pw / 2
  if mode == "SAME_LOWER" {
    top = (ph + 1) / 2
    left = (pw + 1) / 2
  }
  return [top, left, ph - top, pw - left]
}

[phase: "infer", on: "onnx.QuantizeLinear"]
local fn quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  var elem = ty("u8")
  if len(inputs) == 3 {
    let zero = ir.type(inputs[2])
    if !tensor.valid(zero) {
      return false
    }
    elem = tensor.elem(zero)
  }
  return set_type(m, outputs[0], shaped(elem, tensor.dims(input)))
}

[phase: "infer", on: "onnx.DequantizeLinear"]
local fn dequant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(tensor.elem(scale), tensor.dims(input))
  )
}

local fn broadcast_type(m: Mod, op: Op, result_elem: Ty) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) {
    return false
  }
  let source_elem = tensor.elem(first)
  var shape: list<Ty> = tensor.dims(first)
  for input in inputs {
    let type = ir.type(input)
    if !tensor.valid(type) || tensor.elem(type) != source_elem {
      return false
    }
    let dims: list<Ty> = tensor.dims(type)
    let next: list<Ty> = tensor.broadcast_shape(shape, dims)
    if !tensor.broadcastable(shape, next) ||
       !tensor.broadcastable(dims, next) {
      return false
    }
    shape = next
  }
  var elem = result_elem
  if elem == ty("_") {
    elem = source_elem
  }
  return set_type(m, outputs[0], shaped(elem, shape))
}

[phase: "infer", on: ["onnx.Add", "onnx.Sub", "onnx.Mul", "onnx.Div", "onnx.Pow"]]
local fn binary_type(m: Mod, op: Op) -> bool {
  if len(ir.args(op)) != 2 {
    return false
  }
  return broadcast_type(m, op, ty("_"))
}

[phase: "infer", on: ["onnx.Equal", "onnx.Greater", "onnx.Less"]]
local fn compare_type(m: Mod, op: Op) -> bool {
  if len(ir.args(op)) != 2 {
    return false
  }
  return broadcast_type(m, op, ty("bool"))
}

[phase: "infer", on: ["onnx.Max", "onnx.Min"]]
local fn extrema_type(m: Mod, op: Op) -> bool {
  return broadcast_type(m, op, ty("_"))
}

local fn signed(data: Attr, offset: int, width: int) -> int {
  var value = base.byte(data, offset + width - 1)
  if value >= 128 {
    value -= 256
  }
  for reverse in 1..width {
    value = value * 256 + base.byte(data, offset + width - reverse - 1)
  }
  return value
}

local fn tensor_literal(op: Op) -> Attr {
  let meta = attrs(op)
  if !base.has(meta, "value") {
    return {}
  }
  let literal = meta["value"]
  if base.kind(literal) != "dict" ||
     !base.has(literal, "type") ||
     !base.has(literal, "shape") ||
     !base.has(literal, "data") ||
     base.kind(literal["type"]) != "int" ||
     base.kind(literal["shape"]) != "list" ||
     base.kind(literal["data"]) != "bytes" {
    return {}
  }
  return literal
}

local fn tensor_data(op: Op) -> Attr {
  let outputs = ir.outs(op)
  if ir.kind(op) == "constant" && len(outputs) == 1 &&
     tensor.valid(ir.type(outputs[0])) &&
     base.kind(ir.constant(outputs[0])) == "bytes" {
    return ir.constant(outputs[0])
  }
  if ir.callee(op) == "onnx.tensor" {
    let inputs = ir.args(op)
    let index = 2
    if len(inputs) > index && ir.is_const(inputs[index]) {
      return ir.constant(inputs[index])
    }
  }
  if ir.callee(op) == "onnx.Constant" {
    let literal = tensor_literal(op)
    if base.kind(literal) == "dict" {
      return literal["data"]
    }
  }
  return ir.meta(op)
}

local fn const_ints(value: Val) -> list<int> {
  var out: list<int> = []
  let type = ir.type(value)
  if !tensor.valid(type) {
    return out
  }
  var width = 0
  if tensor.elem(type) == ty("i32") {
    width = 4
  }
  if tensor.elem(type) == ty("i64") {
    width = 8
  }
  if width == 0 {
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let data = tensor_data(producer)
  if base.kind(data) != "bytes" {
    return out
  }
  if base.size(data) % width != 0 {
    return out
  }
  for i in 0..base.size(data) / width {
    out += [signed(data, i * width, width)]
  }
  return out
}

local fn int_vector_len(value: Val) -> int {
  let type = ir.type(value)
  if !tensor.valid(type) ||
     (tensor.elem(type) != ty("i32") && tensor.elem(type) != ty("i64")) {
    return -1
  }
  let shape = tensor.dims(type)
  if len(shape) != 1 || kind(shape[0]) != "int" || int(shape[0]) < 0 {
    return -1
  }
  return int(shape[0])
}

local fn attr_ints(value: Attr) -> list<int> {
  var out: list<int> = []
  if base.kind(value) != "list" {
    return out
  }
  for item in value {
    if base.kind(item) != "int" {
      var invalid: list<int> = []
      return invalid
    }
    out += [base.int(item)]
  }
  return out
}

local fn slice_starts(op: Op) -> list<int> {
  let inputs = ir.args(op)
  if len(inputs) >= 3 && len(inputs) <= 5 {
    return const_ints(inputs[1])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "starts") {
    return attr_ints(meta["starts"])
  }
  var missing: list<int> = []
  return missing
}

local fn slice_ends(op: Op) -> list<int> {
  let inputs = ir.args(op)
  if len(inputs) >= 3 && len(inputs) <= 5 {
    return const_ints(inputs[2])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "ends") {
    return attr_ints(meta["ends"])
  }
  var missing: list<int> = []
  return missing
}

local fn slice_axes(op: Op) -> list<int> {
  let inputs = ir.args(op)
  var out: list<int> = []
  if len(inputs) >= 4 && len(inputs) <= 5 {
    out = const_ints(inputs[3])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "axes") {
    out = attr_ints(meta["axes"])
  }
  if len(out) == 0 {
    for axis in 0..len(slice_starts(op)) {
      out += [axis]
    }
  }
  return out
}

local fn slice_steps(op: Op) -> list<int> {
  let inputs = ir.args(op)
  var out: list<int> = []
  if len(inputs) == 5 {
    out = const_ints(inputs[4])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "steps") {
    out = attr_ints(meta["steps"])
  }
  if len(out) == 0 {
    for start in slice_starts(op) {
      out += [1]
    }
  }
  return out
}

fn shape_terms(value: Val) -> list<Ty> {
  var out: list<Ty> = []
  let literal = const_ints(value)
  if len(literal) != 0 {
    for item in literal {
      out += [ty(item)]
    }
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let inputs = ir.args(producer)
  if ir.callee(producer) == "onnx.Shape" && len(inputs) == 1 {
    let input = ir.type(inputs[0])
    if tensor.valid(input) {
      return tensor.dims(input)
    }
  }
  if (ir.callee(producer) == "onnx.Cast" ||
      ir.callee(producer) == "onnx.Identity" ||
      ir.callee(producer) == "onnx.Squeeze" ||
      ir.callee(producer) == "onnx.Unsqueeze") && len(inputs) >= 1 {
    return shape_terms(inputs[0])
  }
  if ir.callee(producer) == "onnx.Gather" && len(inputs) == 2 &&
     base.get(attrs(producer), "axis", 0) == 0 {
    let source = shape_terms(inputs[0])
    let indices = const_ints(inputs[1])
    if len(source) == 0 || len(indices) == 0 {
      return out
    }
    for raw in indices {
      var index = raw
      if index < 0 {
        index += len(source)
      }
      if index < 0 || index >= len(source) {
        return []
      }
      out += [source[index]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Slice" && len(inputs) >= 1 {
    let source = shape_terms(inputs[0])
    let starts = slice_starts(producer)
    let ends = slice_ends(producer)
    let selected = slice_axes(producer)
    let steps = slice_steps(producer)
    if len(source) == 0 || len(starts) != 1 ||
       len(ends) != 1 || len(selected) != 1 || len(steps) != 1 ||
       selected[0] != 0 || steps[0] != 1 {
      return out
    }
    var first = starts[0]
    var last = ends[0]
    if first < 0 {
      first += len(source)
    }
    if last < 0 {
      last += len(source)
    }
    if first < 0 {
      first = 0
    }
    if last > len(source) {
      last = len(source)
    }
    if first > last || first >= len(source) {
      return out
    }
    for i in first..last {
      out += [source[i]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Concat" &&
     base.get(attrs(producer), "axis", 0) == 0 {
    for input in inputs {
      let part = shape_terms(input)
      if len(part) == 0 {
        return []
      }
      out += part
    }
    return out
  }
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.dims(type)
    var count = -1
    if len(shape) == 0 {
      count = 1
    }
    if len(shape) == 1 && kind(shape[0]) == "int" {
      count = int(shape[0])
    }
    if count >= 0 {
      for i in 0..count {
        out += [ty("_")]
      }
    }
  }
  return out
}

local fn element(code: int) -> Ty {
  var out = ty("_")
  if code == 1 {
    out = ty("f32")
  }
  if code == 2 {
    out = ty("u8")
  }
  if code == 3 {
    out = ty("i8")
  }
  if code == 4 {
    out = ty("u16")
  }
  if code == 5 {
    out = ty("i16")
  }
  if code == 6 {
    out = ty("i32")
  }
  if code == 7 {
    out = ty("i64")
  }
  if code == 9 {
    out = ty("bool")
  }
  if code == 10 {
    out = ty("f16")
  }
  if code == 11 {
    out = ty("f64")
  }
  if code == 12 {
    out = ty("u32")
  }
  if code == 13 {
    out = ty("u64")
  }
  if code == 16 {
    out = ty("bf16")
  }
  return out
}

local fn element_bytes(code: int) -> int {
  if code == 2 || code == 3 || code == 9 {
    return 1
  }
  if code == 4 || code == 5 || code == 10 || code == 16 {
    return 2
  }
  if code == 1 || code == 6 || code == 12 {
    return 4
  }
  if code == 7 || code == 11 || code == 13 {
    return 8
  }
  return 0
}

local fn constant_result(op: Op) -> Ty {
  let literal = tensor_literal(op)
  if base.kind(literal) != "dict" {
    return ty("_")
  }
  let code = base.int(literal["type"])
  let elem = element(code)
  let width = element_bytes(code)
  if elem == ty("_") || width == 0 {
    return ty("_")
  }
  let bytes = base.size(literal["data"])
  var count = 1
  var shape: list<Ty> = []
  for item in literal["shape"] {
    if base.kind(item) != "int" {
      return ty("_")
    }
    let dim = base.int(item)
    if dim < 0 {
      return ty("_")
    }
    if dim == 0 {
      count = 0
    } else {
      if count > bytes / width / dim {
        return ty("_")
      }
      count *= dim
    }
    shape += [ty(dim)]
  }
  if count * width != bytes {
    return ty("_")
  }
  return shaped(elem, shape)
}

[phase: "infer", on: "onnx.Constant"]
local fn constant_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], constant_result(op))
}

[phase: "infer", on: "onnx.Cast"]
local fn cast_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let elem = element(base.get(attrs(op), "to", 0))
  if !tensor.valid(input) || elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, tensor.dims(input)))
}

[phase: "infer", on: "onnx.Shape"]
local fn shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  let rank = len(tensor.dims(ir.type(inputs[0])))
  let shape: list<Ty> = [ty(rank)]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

local fn gather_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let data = ir.type(inputs[0])
  let indices = ir.type(inputs[1])
  if !tensor.valid(data) || !tensor.valid(indices) {
    return ty("_")
  }
  let shape = tensor.dims(data)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return ty("_")
  }
  return shaped(
    tensor.elem(data), tensor.gathered(shape, tensor.dims(indices), axis)
  )
}

[phase: "infer", on: "onnx.Gather"]
local fn gather_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], gather_result(op))
}

local fn axes(op: Op) -> list<int> {
  let meta = attrs(op)
  var out: list<int> = []
  if base.has(meta, "axes") {
    for axis in meta["axes"] {
      out += [axis]
    }
    return out
  }
  let inputs = ir.args(op)
  if len(inputs) >= 2 {
    return const_ints(inputs[1])
  }
  return out
}

local fn unsqueeze_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 && len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let raw = axes(op)
  let rank = len(source) + len(raw)
  var normalized: list<int> = []
  for value in raw {
    var axis = value
    if axis < 0 {
      axis += rank
    }
    normalized += [axis]
  }
  if !tensor.valid_axes(normalized, rank) {
    return ty("_")
  }
  var shape: list<Ty> = []
  var source_axis = 0
  for axis in 0..rank {
    var selected = false
    for value in normalized {
      if value == axis {
        selected = true
      }
    }
    if selected {
      shape += [ty(1)]
    } else {
      shape += [source[source_axis]]
      source_axis += 1
    }
  }
  return shaped(tensor.elem(input), shape)
}

local fn squeeze_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 && len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let raw = axes(op)
  var normalized: list<int> = []
  if len(raw) == 0 {
    for axis in 0..len(source) {
      if source[axis] == ty(1) {
        normalized += [axis]
      }
    }
  } else {
    for value in raw {
      var axis = value
      if axis < 0 {
        axis += len(source)
      }
      normalized += [axis]
    }
  }
  if !tensor.valid_axes(normalized, len(source)) {
    return ty("_")
  }
  var shape: list<Ty> = []
  for axis in 0..len(source) {
    var selected = false
    for value in normalized {
      if value == axis {
        selected = true
      }
    }
    if selected {
      if kind(source[axis]) == "int" && source[axis] != ty(1) {
        return ty("_")
      }
    } else {
      shape += [source[axis]]
    }
  }
  return shaped(tensor.elem(input), shape)
}

local fn unary_shape_type(m: Mod, op: Op, squeeze: bool) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  var result = unsqueeze_result(op)
  if squeeze {
    result = squeeze_result(op)
  }
  return set_type(m, outputs[0], result)
}

[phase: "infer", on: "onnx.Unsqueeze"]
local fn unsqueeze_type(m: Mod, op: Op) -> bool {
  return unary_shape_type(m, op, false)
}

[phase: "infer", on: "onnx.Squeeze"]
local fn squeeze_type(m: Mod, op: Op) -> bool {
  return unary_shape_type(m, op, true)
}

[phase: "infer", on: "onnx.Slice"]
local fn slice_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.sliced(
    tensor.dims(input), slice_starts(op), slice_ends(op),
    slice_axes(op), slice_steps(op)
  )
  if len(shape) != 0 {
    return set_type(m, outputs[0], shaped(tensor.elem(input), shape))
  }
  if len(inputs) < 3 || len(inputs) > 5 {
    return false
  }
  let count = int_vector_len(inputs[1])
  if count <= 0 || int_vector_len(inputs[2]) != count {
    return false
  }
  if len(inputs) >= 4 && int_vector_len(inputs[3]) != count {
    return false
  }
  if len(inputs) == 5 && int_vector_len(inputs[4]) != count {
    return false
  }
  let source = tensor.dims(input)
  if count > len(source) {
    return false
  }
  var open = source
  var selected = slice_axes(op)
  if len(inputs) == 3 {
    for axis in 0..count {
      selected += [axis]
    }
  } else {
    if len(selected) == 0 {
      for axis in 0..len(source) {
        open = tensor.replaced(open, axis, ty("_"))
      }
      return set_type(m, outputs[0], shaped(tensor.elem(input), open))
    }
  }
  if len(selected) != count {
    return false
  }
  for raw in selected {
    var axis = raw
    if axis < 0 {
      axis += len(source)
    }
    if axis < 0 || axis >= len(source) {
      return false
    }
    open = tensor.replaced(open, axis, ty("_"))
  }
  return set_type(m, outputs[0], shaped(tensor.elem(input), open))
}

local fn resize_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 4 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let shape = shape_terms(inputs[3])
  if len(shape) != len(tensor.dims(input)) {
    return ty("_")
  }
  for dim in shape {
    if kind(dim) == "int" && int(dim) <= 0 {
      return ty("_")
    }
  }
  return shaped(tensor.elem(input), shape)
}

[phase: "infer", on: "onnx.Resize"]
local fn resize_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], resize_result(op))
}

[phase: "infer", on: "onnx.NonZero"]
local fn nonzero_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  var rank = ty("_")
  if tensor.valid(input) {
    rank = ty(len(tensor.dims(input)))
  }
  let shape: list<Ty> = [rank, ty("_")]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

[phase: "infer", on: "onnx.Range"]
local fn range_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) || len(tensor.dims(first)) != 0 {
    return false
  }
  for input in inputs {
    let type = ir.type(input)
    if !tensor.valid(type) || len(tensor.dims(type)) != 0 ||
       tensor.elem(type) != tensor.elem(first) {
      return false
    }
  }
  let shape: list<Ty> = [ty("_")]
  return set_type(m, outputs[0], shaped(tensor.elem(first), shape))
}

[phase: "infer", on: "onnx.NonMaxSuppression"]
local fn nms_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 5 || len(outputs) != 1 {
    return false
  }
  let shape: list<Ty> = [ty("_"), ty(3)]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

[phase: "infer", on: "onnx.Expand"]
local fn expand_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let shape = shape_terms(inputs[1])
  if !tensor.valid(input) {
    return false
  }
  let source_shape = tensor.dims(input)
  if len(shape) < len(source_shape) {
    return false
  }
  for dim in shape {
    if kind(dim) == "int" && int(dim) < 0 {
      return false
    }
  }
  let shift = len(shape) - len(source_shape)
  for axis in 0..len(source_shape) {
    let source = source_shape[axis]
    let target = shape[shift + axis]
    if kind(source) == "int" && kind(target) == "int" &&
       source != ty(1) && source != target {
      return false
    }
  }
  return set_type(m, outputs[0], shaped(tensor.elem(input), shape))
}

[phase: "infer", on: "onnx.Tile"]
local fn tile_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let source = tensor.dims(input)
  let repeats = const_ints(inputs[1])
  if len(repeats) == 0 {
    let repeat_type = ir.type(inputs[1])
    if !tensor.valid(repeat_type) || tensor.elem(repeat_type) != ty("i64") {
      return false
    }
    let repeat_shape = tensor.dims(repeat_type)
    if len(repeat_shape) != 1 || repeat_shape[0] != ty(len(source)) {
      return false
    }
    var open: list<Ty> = []
    for dim in source {
      open += [ty("_")]
    }
    return set_type(m, outputs[0], shaped(tensor.elem(input), open))
  }
  if len(repeats) != len(source) {
    return false
  }
  var shape: list<Ty> = []
  for axis in 0..len(source) {
    if repeats[axis] < 0 {
      return false
    }
    if kind(source[axis]) == "int" {
      shape += [ty(int(source[axis]) * repeats[axis])]
    } else {
      if repeats[axis] == 1 {
        shape += [source[axis]]
      } else {
        shape += [ty("_")]
      }
    }
  }
  return set_type(m, outputs[0], shaped(tensor.elem(input), shape))
}

[phase: "infer", on: "onnx.TopK"]
local fn topk_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 2 {
    return false
  }
  let input = ir.type(inputs[0])
  let count = const_ints(inputs[1])
  if !tensor.valid(input) {
    return false
  }
  let source = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(source)
  }
  if axis < 0 || axis >= len(source) {
    return false
  }
  var extent = ty("_")
  if len(count) == 1 {
    if count[0] <= 0 ||
       (kind(source[axis]) == "int" && count[0] > int(source[axis])) {
      return false
    }
    extent = ty(count[0])
  } else {
    if int_vector_len(inputs[1]) != 1 ||
       tensor.elem(ir.type(inputs[1])) != ty("i64") {
      return false
    }
  }
  let shape = tensor.replaced(source, axis, extent)
  var changed = set_type(
    m, outputs[0], shaped(tensor.elem(input), shape)
  )
  changed = set_type(
    m, outputs[1], shaped(ty("i64"), shape)
  ) || changed
  return changed
}

local fn concat_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) == 0 {
    return ty("_")
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) {
    return ty("_")
  }
  let source = tensor.dims(first)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(source)
  }
  if axis < 0 || axis >= len(source) {
    return ty("_")
  }
  var shape = source
  for i in 1..len(inputs) {
    let input = inputs[i]
    let type = ir.type(input)
    if !tensor.valid(type) || tensor.elem(type) != tensor.elem(first) ||
       len(tensor.dims(type)) != len(source) {
      return ty("_")
    }
    shape = tensor.concatenated(shape, tensor.dims(type), axis)
    if len(shape) == 0 {
      return ty("_")
    }
  }
  return shaped(tensor.elem(first), shape)
}

[phase: "infer", on: "onnx.Concat"]
local fn concat_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], concat_result(op))
}

[phase: "infer", on: "onnx.Split"]
local fn split_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 1 && len(inputs) != 2) || len(outputs) == 0 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return false
  }
  var sizes: list<int> = []
  var symbolic = false
  if len(inputs) == 2 {
    sizes = const_ints(inputs[1])
  } else {
    let meta = attrs(op)
    if base.has(meta, "split") {
      for size in meta["split"] {
        sizes += [size]
      }
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) == "int" &&
     int(shape[axis]) % len(outputs) == 0 {
    let size = int(shape[axis]) / len(outputs)
    for output in outputs {
      sizes += [size]
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) != "int" {
    symbolic = true
    for output in outputs {
      sizes += [-1]
    }
  }
  if len(sizes) != len(outputs) {
    return false
  }
  var total = 0
  for size in sizes {
    if size < 0 && !symbolic {
      return false
    }
    if size >= 0 {
      total += size
    }
  }
  if kind(shape[axis]) == "int" && total != int(shape[axis]) {
    return false
  }
  var changed = false
  for i in 0..len(outputs) {
    var extent = ty("_")
    if sizes[i] >= 0 {
      extent = ty(sizes[i])
    }
    changed = set_type(
      m, outputs[i], shaped(
        tensor.elem(input), tensor.replaced(shape, axis, extent)
      )
    ) || changed
  }
  return changed
}

[phase: "infer", on: "onnx.OneHot"]
local fn one_hot_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let indices = ir.type(inputs[0])
  let values = ir.type(inputs[2])
  let depth = const_ints(inputs[1])
  if !tensor.valid(indices) || !tensor.valid(values) || len(depth) != 1 ||
     depth[0] <= 0 {
    return false
  }
  let value_shape = tensor.dims(values)
  if len(value_shape) != 1 || value_shape[0] != ty(2) {
    return false
  }
  let source = tensor.dims(indices)
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(source) + 1
  }
  if axis < 0 || axis > len(source) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(
      tensor.elem(values), tensor.inserted(source, axis, ty(depth[0]))
    )
  )
}

[phase: "infer", on: "onnx.DynamicQuantizeLinear"]
local fn dynamic_quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 3 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var changed = set_type(
    m, outputs[0], shaped(ty("u8"), shape)
  )
  changed = set_type(
    m, outputs[1], ty("tensor<f32, []>")
  ) || changed
  changed = set_type(
    m, outputs[2], ty("tensor<u8, []>")
  ) || changed
  return changed
}

[phase: "infer", on: "onnx.ConstantOfShape"]
local fn constant_shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let shape = shape_terms(inputs[0])
  if len(shape) == 0 {
    return false
  }
  var elem = ty("f32")
  let meta = attrs(op)
  if base.has(meta, "value") {
    elem = element(base.get(meta["value"], "type", 1))
  }
  if elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, shape))
}

local fn reshape_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let allowzero = base.get(attrs(op), "allowzero", 0)
  if allowzero != 0 && allowzero != 1 {
    return ty("_")
  }
  let requested = shape_terms(inputs[1])
  if len(requested) == 0 {
    let shape_type = ir.type(inputs[1])
    if !tensor.valid(shape_type) || tensor.elem(shape_type) != ty("i64") {
      return ty("_")
    }
    let shape_shape = tensor.dims(shape_type)
    if len(shape_shape) != 1 || kind(shape_shape[0]) != "int" ||
       int(shape_shape[0]) < 0 {
      return ty("_")
    }
    var open: list<Ty> = []
    for i in 0..int(shape_shape[0]) {
      open += [ty("_")]
    }
    return shaped(tensor.elem(input), open)
  }
  var inferred = -1
  var factors: list<Ty> = []
  for i in 0..len(requested) {
    if kind(requested[i]) == "int" {
      let extent = int(requested[i])
      if extent == -1 {
        if inferred != -1 {
          return ty("_")
        }
        inferred = i
      } else {
        if extent == 0 && allowzero == 0 {
          if i >= len(source) {
            return ty("_")
          }
          factors += [source[i]]
        } else {
          if extent >= 0 {
            factors += [requested[i]]
          } else {
            return ty("_")
          }
        }
      }
    } else {
      factors += [requested[i]]
    }
  }
  var missing = ty("_")
  if inferred != -1 {
    let source_total = tensor.product(source, 0, len(source))
    let factor_total = tensor.product(factors, 0, len(factors))
    if kind(source_total) == "int" && kind(factor_total) == "int" &&
       (int(factor_total) <= 0 ||
        int(source_total) % int(factor_total) != 0) {
      return ty("_")
    }
    missing = tensor.quotient(source, factors)
  }
  var shape: list<Ty> = []
  for i in 0..len(requested) {
    if kind(requested[i]) == "int" && int(requested[i]) == -1 {
      shape += [missing]
    } else {
      if kind(requested[i]) == "int" &&
         int(requested[i]) == 0 && allowzero == 0 {
        shape += [source[i]]
      } else {
        shape += [requested[i]]
      }
    }
  }
  let source_total = tensor.product(source, 0, len(source))
  let result_total = tensor.product(shape, 0, len(shape))
  if kind(source_total) == "int" && kind(result_total) == "int" &&
     source_total != result_total {
    return ty("_")
  }
  return shaped(tensor.elem(input), shape)
}

[phase: "infer", on: "onnx.Reshape"]
local fn reshape_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reshape_result(op))
}

local fn flattened(input: Ty, axis: int) -> Ty {
  let dims = tensor.dims(input)
  let outer = tensor.product(dims, 0, axis)
  let inner = tensor.product(dims, axis, len(dims))
  if outer == ty("_") || inner == ty("_") {
    return ty("_")
  }
  let shape: list<Ty> = [outer, inner]
  return shaped(tensor.elem(input), shape)
}

[phase: "infer", on: "onnx.Flatten"]
local fn infer_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let result = flattened(input, axis)
  if result == ty("_") {
    return false
  }
  return set_type(m, outputs[0], result)
}

local fn matmul_shape(
  left: Ty, right: Ty, transpose_left: bool, transpose_right: bool
) -> list<Ty> {
  var none: list<Ty> = []
  if !tensor.valid(left) || !tensor.valid(right) {
    return none
  }
  let ls = tensor.dims(left)
  let rs = tensor.dims(right)
  if len(ls) < 2 || len(rs) < 2 {
    return none
  }
  var rows = ls[len(ls) - 2]
  var left_depth = ls[len(ls) - 1]
  var right_depth = rs[len(rs) - 2]
  var columns = rs[len(rs) - 1]
  if transpose_left {
    rows = ls[len(ls) - 1]
    left_depth = ls[len(ls) - 2]
  }
  if transpose_right {
    right_depth = rs[len(rs) - 1]
    columns = rs[len(rs) - 2]
  }
  if left_depth != right_depth {
    return none
  }
  var left_batch: list<Ty> = []
  var right_batch: list<Ty> = []
  for i in 0..len(ls) - 2 {
    left_batch += [ls[i]]
  }
  for i in 0..len(rs) - 2 {
    right_batch += [rs[i]]
  }
  var shape: list<Ty> = []
  if len(left_batch) == 0 {
    shape = right_batch
  } else {
    if len(right_batch) == 0 {
      shape = left_batch
    } else {
      shape = tensor.broadcast_shape(left_batch, right_batch)
    }
  }
  if len(left_batch) != 0 {
    if !tensor.broadcastable(left_batch, shape) {
      return none
    }
  }
  if len(right_batch) != 0 {
    if !tensor.broadcastable(right_batch, shape) {
      return none
    }
  }
  shape += [rows, columns]
  return shape
}

local fn matmul_shape(left: Ty, right: Ty) -> list<Ty> {
  return matmul_shape(left, right, false, false)
}

local fn matmul_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return ty("_")
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return ty("_")
  }
  return shaped(tensor.elem(left), shape)
}

[phase: "infer", on: "onnx.MatMul"]
local fn matmul_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], matmul_result(op))
}

local fn gemm_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 && len(inputs) != 3 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) ||
     len(tensor.dims(left)) != 2 || len(tensor.dims(right)) != 2 {
    return ty("_")
  }
  let meta = attrs(op)
  let shape = matmul_shape(
    left, right,
    base.get(meta, "transA", 0) == 1,
    base.get(meta, "transB", 0) == 1
  )
  if len(shape) != 2 {
    return ty("_")
  }
  if len(inputs) == 3 {
    let bias = ir.type(inputs[2])
    if !tensor.valid(bias) || tensor.elem(bias) != tensor.elem(left) ||
       !tensor.broadcastable(tensor.dims(bias), shape) {
      return ty("_")
    }
  }
  return shaped(tensor.elem(left), shape)
}

[phase: "infer", on: "onnx.Gemm"]
local fn gemm_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], gemm_result(op))
}

[phase: "infer", on: "onnx.MatMulInteger"]
local fn integer_matmul_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 4 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) {
    return false
  }
  let le = tensor.elem(left)
  let re = tensor.elem(right)
  if (le != ty("i8") && le != ty("u8")) ||
     (re != ty("i8") && re != ty("u8")) {
    return false
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return false
  }
  return set_type(m, outputs[0], shaped(ty("i32"), shape))
}

local fn fused_matmul_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return ty("_")
  }
  let meta = attrs(op)
  let trans_a = base.get(meta, "transA", 0)
  let trans_b = base.get(meta, "transB", 0)
  if (trans_a != 0 && trans_a != 1) ||
     (trans_b != 0 && trans_b != 1) ||
     base.get(meta, "transBatchA", 0) != 0 ||
     base.get(meta, "transBatchB", 0) != 0 {
    return ty("_")
  }
  let shape = matmul_shape(left, right, trans_a == 1, trans_b == 1)
  if len(shape) == 0 {
    return ty("_")
  }
  return shaped(tensor.elem(left), shape)
}

[phase: "infer", on: "com_microsoft.FusedMatMul"]
local fn fused_matmul_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], fused_matmul_result(op))
}

local fn transpose_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "perm") {
    for axis in meta["perm"] {
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [rank - axis - 1]
    }
  }
  return axes
}

[phase: "infer", on: "onnx.Transpose"]
local fn transpose_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(
      tensor.elem(input), tensor.permuted(shape, axes)
    )
  )
}

local fn reduce_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "axes") {
    for value in meta["axes"] {
      var axis = value
      if axis < 0 {
        axis += rank
      }
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [axis]
    }
  }
  return axes
}

local fn reduce_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let shape = tensor.dims(input)
  let axes = reduce_axes(op, len(shape))
  if !tensor.valid_axes(axes, len(shape)) {
    return ty("_")
  }
  let keep = base.get(attrs(op), "keepdims", 1)
  if keep != 0 && keep != 1 {
    return ty("_")
  }
  return shaped(
    tensor.elem(input), tensor.reduced(shape, axes, keep == 1)
  )
}

[phase: "infer", on: "onnx.ReduceMean"]
local fn reduce_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reduce_result(op))
}

[phase: "infer", on: "onnx.Loop"]
local fn loop_type(m: Mod, op: Op) -> bool {
  let body = onnx.graph(m, op, "body")
  if !ir.live(body) {
    return false
  }
  let info = base.get(attrs(op), "body", {})
  let inputs = base.get(info, "inputs", -1)
  let params = ir.params(body)
  let results = ir.returns(body)
  let args = ir.args(op)
  let outputs = ir.outs(op)
  if inputs < 2 || len(params) < inputs ||
     len(args) < inputs {
    return false
  }
  var changed = set_type(m, params[0], ty("tensor<i64, []>"))
  changed = set_type(m, params[1], ty("tensor<bool, []>")) || changed
  for i in 2..inputs {
    changed = set_type(m, params[i], ir.type(args[i])) || changed
  }
  if len(results) != len(outputs) + 1 {
    return changed
  }
  let carried = inputs - 2
  if carried > len(outputs) {
    return changed
  }
  var types: list<Ty> = []
  for i in 0..len(outputs) {
    var type = results[i + 1]
    if !tensor.valid(type) {
      return changed
    }
    if i >= carried {
      type = shaped(
        tensor.elem(type), [ty("_")] + tensor.dims(type)
      )
    }
    types += [type]
  }
  for i in 0..len(outputs) {
    changed = set_type(m, outputs[i], types[i]) || changed
  }
  return changed
}

local fn positive(dim: Ty) -> bool {
  return kind(dim) == "int" && int(dim) > 0
}

local fn known_mismatch(left: Ty, right: Ty) -> bool {
  return kind(left) == "int" && kind(right) == "int" && left != right
}

local fn conv_inputs(x: Ty, weight: Ty, bias: Ty, groups: int) -> bool {
  if !tensor.valid(x) || !tensor.valid(weight) || groups <= 0 {
    return false
  }
  if tensor.elem(x) != tensor.elem(weight) {
    return false
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if len(xs) != 4 || len(ws) != 4 {
    return false
  }
  if groups == 1 {
    if known_mismatch(xs[1], ws[1]) {
      return false
    }
  } else {
    if kind(xs[1]) == "int" && int(xs[1]) <= 0 {
      return false
    }
    if kind(ws[1]) == "int" && int(ws[1]) <= 0 {
      return false
    }
    if positive(xs[1]) && positive(ws[1]) &&
       int(xs[1]) != int(ws[1]) * groups {
      return false
    }
  }
  if bias != ty("_") {
    if !tensor.valid(bias) || tensor.elem(bias) != tensor.elem(x) {
      return false
    }
    let bs = tensor.dims(bias)
    if len(bs) != 1 || known_mismatch(bs[0], ws[0]) {
      return false
    }
  }
  return true
}

local fn conv_extent(
  input: Ty, low: int, high: int,
  kernel: int, stride: int, dilation: int
) -> Ty {
  if kind(input) == "int" {
    let result = (int(input) + low + high -
                  dilation * (kernel - 1) - 1) / stride + 1
    if result > 0 {
      return ty(result)
    }
    return ty("_")
  }
  if stride == 1 && low + high == dilation * (kernel - 1) {
    return input
  }
  return ty("_")
}

local fn same_extent(input: Ty, stride: int) -> Ty {
  if kind(input) == "int" {
    return ty((int(input) + stride - 1) / stride)
  }
  if stride == 1 {
    return input
  }
  return ty("_")
}

local fn conv_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 && len(inputs) != 3 {
    return ty("_")
  }
  let x = ir.type(inputs[0])
  let weight = ir.type(inputs[1])
  var bias = ty("_")
  if len(inputs) == 3 {
    bias = ir.type(inputs[2])
  }
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  if !conv_inputs(x, weight, bias, groups) {
    return ty("_")
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if !positive(ws[2]) || !positive(ws[3]) ||
     (kind(xs[2]) == "int" && int(xs[2]) <= 0) ||
     (kind(xs[3]) == "int" && int(xs[3]) <= 0) {
    return ty("_")
  }
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(stride) != 2 || len(dilation) != 2 {
    return ty("_")
  }
  if stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return ty("_")
  }
  var h = ty("_")
  var w = ty("_")
  let mode = base.get(meta, "auto_pad", "NOTSET")
  if mode == "SAME_UPPER" || mode == "SAME_LOWER" {
    h = same_extent(xs[2], stride[0])
    w = same_extent(xs[3], stride[1])
  } else {
    let pad = spatial_pad(op, [int(ws[2]), int(ws[3])])
    if len(pad) != 4 {
      return ty("_")
    }
    h = conv_extent(
      xs[2], pad[0], pad[2], int(ws[2]), stride[0], dilation[0]
    )
    w = conv_extent(
      xs[3], pad[1], pad[3], int(ws[3]), stride[1], dilation[1]
    )
  }
  if (kind(xs[2]) == "int" && h == ty("_")) ||
     (kind(xs[3]) == "int" && w == ty("_")) {
    return ty("_")
  }
  let shape: list<Ty> = [xs[0], ws[0], h, w]
  return shaped(tensor.elem(x), shape)
}

[phase: "infer", on: "onnx.Conv"]
local fn conv_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], conv_result(op))
}

[phase: "infer", on: "onnx.GlobalAveragePool"]
local fn global_pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(1), ty(1)]
  return set_type(
    m, outputs[0], shaped(tensor.elem(x), result)
  )
}

[phase: "infer", on: ["onnx.AveragePool", "onnx.MaxPool"]]
local fn pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 || !positive(shape[2]) || !positive(shape[3]) {
    return false
  }
  let meta = attrs(op)
  if !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  let pad = spatial_pad(op, kernel)
  if len(kernel) != 2 || len(stride) != 2 || len(pad) != 4 ||
     len(dilation) != 2 {
    return false
  }
  if kernel[0] <= 0 || kernel[1] <= 0 ||
     stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return false
  }
  let h = (int(shape[2]) + pad[0] + pad[2] -
           dilation[0] * (kernel[0] - 1) - 1) / stride[0] + 1
  let w = (int(shape[3]) + pad[1] + pad[3] -
           dilation[1] * (kernel[1] - 1) - 1) / stride[1] + 1
  if h <= 0 || w <= 0 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(h), ty(w)]
  return set_type(
    m, outputs[0], shaped(tensor.elem(x), result)
  )
}

local fn infer_once(m: Mod, rules: list<Fn>) -> bool {
  var changed = false
  let selected = ir.where(rules, "phase", "infer")
  let common = ir.where(selected, "on", "*")
  for op in ir.ops(m) {
    let matches = common + ir.where(selected, "on", ir.callee(op))
    for rule in matches {
      changed = ir.invoke<bool>(m, op, rule) || changed
    }
  }
  return changed
}

fn infer(m: Mod, rules: list<Fn>) -> bool {
  var changed = false
  var again = true
  var exhausted = false
  let limit = len(ir.ops(m)) + 1
  for round in 0..limit {
    if again {
      let before = ir.revision(m)
      infer_once(m, rules)
      again = ir.revision(m) != before
      changed = again || changed
      if round == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "onnx.nn.infer did not converge")
  return changed
}

fn infer(m: Mod) -> bool {
  return infer(m, ir.fns("onnx.nn"))
}

local fn ints(m: Mod, before: Op, value: Attr) -> Val {
  var items: list<Val> = []
  for item in value {
    items += [ir.constant(m, before, item, ty("int"))]
  }
  return ir.call(m, before, "base.list", items, ty("list", [ty("int")]))
}

local fn convert_call(m: Mod, op: Op, callee: str) -> bool {
  if !ir.retarget(m, op, callee, ir.args(op)) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

local fn convert_call(
  m: Mod, op: Op, callee: str, inputs: list<Val>
) -> bool {
  if !ir.retarget(m, op, callee, inputs) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

[phase: "data", on: "onnx.tensor"]
local fn convert_tensor(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 ||
     !tensor.valid(ir.type(outputs[0])) || !ir.is_const(inputs[2]) ||
     base.kind(ir.constant(inputs[2])) != "bytes" {
    return false
  }
  let data = ir.constant(inputs[2])
  if !ir.replace(m, op, data) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

[phase: "cleanup", on: "onnx.model"]
local fn convert_model(m: Mod, op: Op) -> bool {
  for candidate in ir.ops(m) {
    if ir.live(candidate) && candidate != op && ir.has(candidate, "onnx") {
      return false
    }
  }
  return ir.erase(m, op)
}

local fn carry(m: Mod, source: Val, target: Val) -> bool {
  var changed = false
  let value_name = ir.name(source)
  if value_name != "" {
    changed = ir.rename(m, target, value_name) || changed
  }
  let metadata = ir.meta(source)
  for key in base.keys(metadata) {
    changed = ir.set(m, target, key, metadata[key]) || changed
  }
  return changed
}

local fn carry(m: Mod, source: Op, target: Op) -> bool {
  var changed = false
  let metadata = ir.meta(source)
  for key in base.keys(metadata) {
    if key != "onnx" {
      changed = ir.set(m, target, key, metadata[key]) || changed
    }
  }
  return changed
}

[phase: "shape", on: "onnx.Shape"]
local fn convert_shape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let output = ir.type(outputs[0])
  let metadata = attrs(op)
  if base.has(metadata, "start") || base.has(metadata, "end") ||
     !tensor.valid(input) ||
     output != shaped(ty("i64"), [ty(len(tensor.dims(input)))]) {
    return false
  }
  return convert_call(m, op, "tensor.shape")
}

[phase: "shape", on: "onnx.Gather"]
local fn convert_gather(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let expected = gather_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let rank = len(tensor.dims(ir.type(inputs[0])))
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += rank
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  return convert_call(m, op, "tensor.gather", inputs)
}

local fn convert_reshape_view(m: Mod, op: Op, expected: Ty) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 2 || len(outputs) != 1 ||
     expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let values: list<Val> = [inputs[0]]
  return convert_call(m, op, "tensor.reshape", values)
}

[phase: "shape", on: "onnx.Unsqueeze"]
local fn convert_unsqueeze(m: Mod, op: Op) -> bool {
  return convert_reshape_view(m, op, unsqueeze_result(op))
}

[phase: "shape", on: "onnx.Squeeze"]
local fn convert_squeeze(m: Mod, op: Op) -> bool {
  return convert_reshape_view(m, op, squeeze_result(op))
}

[phase: "shape", on: "onnx.Slice"]
local fn convert_slice(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let output = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(output) ||
     tensor.elem(input) != tensor.elem(output) {
    return false
  }
  let starts = slice_starts(op)
  let ends = slice_ends(op)
  let selected = slice_axes(op)
  let steps = slice_steps(op)
  let expected = tensor.sliced(
    tensor.dims(input), starts, ends, selected, steps
  )
  if len(expected) == 0 || tensor.dims(output) != expected {
    return false
  }
  var values: list<Val> = [inputs[0]]
  values += [ints(m, op, starts)]
  values += [ints(m, op, selected)]
  values += [ints(m, op, steps)]
  return convert_call(m, op, "tensor.slice", values)
}

[phase: "shape", on: "onnx.Concat"]
local fn convert_concat(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let expected = concat_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  if len(inputs) == 1 {
    let values: list<Val> = [inputs[0]]
    return convert_call(m, op, "base.copy", values)
  }
  let first = ir.type(inputs[0])
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(tensor.dims(first))
  }
  let axis_value = ir.constant(m, op, axis, ty("int"))
  var value = inputs[0]
  var type = first
  for i in 1..len(inputs) {
    let right = ir.type(inputs[i])
    let dims = tensor.concatenated(
      tensor.dims(type), tensor.dims(right), axis
    )
    type = shaped(tensor.elem(type), dims)
    value = ir.call(
      m, op, "tensor.concat", [value, inputs[i], axis_value], type
    )
  }
  carry(m, outputs[0], value)
  carry(m, op, ir.def(value))
  if !ir.replace(m, outputs[0], value) {
    return false
  }
  return ir.erase(m, op)
}

[phase: "shape", on: "onnx.Split"]
local fn convert_split(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 1 && len(inputs) != 2) || len(outputs) == 0 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return false
  }
  var sizes: list<int> = []
  if len(inputs) == 2 {
    sizes = const_ints(inputs[1])
  } else {
    let metadata = attrs(op)
    if base.has(metadata, "split") {
      for size in metadata["split"] {
        sizes += [size]
      }
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) == "int" &&
     int(shape[axis]) % len(outputs) == 0 {
    let size = int(shape[axis]) / len(outputs)
    for output in outputs {
      sizes += [size]
    }
  }
  if len(sizes) != len(outputs) {
    return false
  }
  var total = 0
  for size in sizes {
    if size < 0 {
      return false
    }
    total += size
  }
  if kind(shape[axis]) == "int" && total != int(shape[axis]) {
    return false
  }
  var start = 0
  for i in 0..len(outputs) {
    let expected = shaped(
      tensor.elem(input), tensor.replaced(shape, axis, ty(sizes[i]))
    )
    if ir.type(outputs[i]) != expected {
      return false
    }
  }
  for i in 0..len(outputs) {
    let next = ir.call(
      m, op, "tensor.slice",
      [inputs[0], ints(m, op, [start]), ints(m, op, [axis]),
       ints(m, op, [1])],
      ir.type(outputs[i])
    )
    carry(m, outputs[i], next)
    carry(m, op, ir.def(next))
    if !ir.replace(m, outputs[i], next) {
      return false
    }
    start += sizes[i]
  }
  return ir.erase(m, op)
}

[phase: "shape", on: "onnx.OneHot"]
local fn convert_one_hot(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let depth = const_ints(inputs[1])
  let indices = ir.type(inputs[0])
  let values = ir.type(inputs[2])
  let output = ir.type(outputs[0])
  if len(depth) != 1 || depth[0] <= 0 || !tensor.valid(indices) ||
     !tensor.valid(values) || !tensor.valid(output) ||
     tensor.dims(values) != [ty(2)] ||
     tensor.elem(values) != tensor.elem(output) {
    return false
  }
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(tensor.dims(indices)) + 1
  }
  if axis < 0 || axis > len(tensor.dims(indices)) {
    return false
  }
  let expected = shaped(
    tensor.elem(values),
    tensor.inserted(tensor.dims(indices), axis, ty(depth[0]))
  )
  if output != expected {
    return false
  }
  var values_in: list<Val> = [inputs[0]]
  values_in += [ir.constant(m, op, depth[0], ty("int"))]
  values_in += [inputs[2]]
  values_in += [ir.constant(m, op, axis, ty("int"))]
  return convert_call(m, op, "tensor.one_hot", values_in)
}

[phase: "shape", on: "onnx.ConstantOfShape"]
local fn convert_constant_shape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let output = ir.type(outputs[0])
  let metadata = attrs(op)
  if !base.has(metadata, "value") {
    if tensor.elem(output) != ty("f32") {
      return false
    }
    let zero = ir.constant(m, op, 0.0, tensor.elem(output))
    let values: list<Val> = [zero]
    return convert_call(m, op, "tensor.tensor", values)
  }
  let literal = metadata["value"]
  if base.kind(literal) != "dict" || !base.has(literal, "type") ||
     !base.has(literal, "shape") || !base.has(literal, "data") {
    return false
  }
  let code = base.int(literal["type"])
  let width = element_bytes(code)
  let literal_shape = literal["shape"]
  if len(literal_shape) != 1 || literal_shape[0] != 1 ||
     width == 0 || base.size(literal["data"]) != width ||
     element(code) != tensor.elem(output) ||
     base.kind(literal["data"]) != "bytes" {
    return false
  }
  let packed = ir.constant(
    m, op, literal["data"], shaped(tensor.elem(output), [ty(1)])
  )
  let values: list<Val> = [packed]
  return convert_call(m, op, "tensor.fill", values)
}

[phase: "shape", on: "onnx.Constant"]
local fn convert_constant(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  let literal = tensor_literal(op)
  let expected = constant_result(op)
  if len(outputs) != 1 || base.kind(literal) != "dict" ||
     expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  if !ir.replace(m, op, literal["data"]) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

local fn convert_unary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) || ir.type(outputs[0]) != input {
    return false
  }
  return convert_call(m, op, callee)
}

[phase: "compute", on: [
  "onnx.Relu", "onnx.Dropout", "onnx.Sqrt", "onnx.Reciprocal",
  "onnx.Tanh", "onnx.Exp", "onnx.Floor", "onnx.Log", "onnx.Erf",
  "onnx.Sigmoid", "onnx.Ceil", "onnx.Round"
]]
local fn convert_unary(m: Mod, op: Op) -> bool {
  let source = ir.callee(op)
  for rule in unary_rules() {
    if source == rule[0] {
      return convert_unary(m, op, rule[1])
    }
  }
  return false
}

[phase: "compute", on: "onnx.LeakyRelu"]
local fn convert_leaky_relu(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  let alpha = base.get(attrs(op), "alpha", 0.01)
  inputs += [ir.constant(m, op, alpha, ty("f64"))]
  return convert_call(m, op, "nn.leaky_relu", inputs)
}

[phase: "compute", on: "onnx.Conv"]
local fn convert_conv(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let biased = len(inputs) == 3
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  let expected = conv_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  inputs += [ints(m, op, base.get(meta, "strides", [1, 1]))]
  let weight = ir.type(inputs[1])
  if !tensor.valid(weight) || len(tensor.dims(weight)) != 4 {
    return false
  }
  let weights = tensor.dims(weight)
  let pad = spatial_pad(op, [int(weights[2]), int(weights[3])])
  if len(pad) != 4 {
    return false
  }
  inputs += [ints(m, op, pad)]
  inputs += [ints(m, op, base.get(meta, "dilations", [1, 1]))]
  inputs += [ir.constant(m, op, groups, ty("int"))]
  if biased {
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ir.constant(m, op, "NONE", ty("str"))]
  }
  return convert_call(m, op, "nn.conv2d", inputs)
}

[phase: "compute", on: "onnx.BatchNormalization"]
local fn convert_norm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 5 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "spatial", 1) != 1 {
    return false
  }
  inputs += [
    ir.constant(m, op, base.get(meta, "epsilon", 0.00001), ty("f64"))
  ]
  return convert_call(m, op, "nn.batch_norm", inputs)
}

[phase: "compute", on: "onnx.Softmax"]
local fn convert_softmax(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) {
    return false
  }
  let type = ir.type(inputs[0])
  if !tensor.valid(type) {
    return false
  }
  let rank = len(tensor.dims(type))
  let meta = attrs(op)
  let version = onnx.opset(m, "")
  if rank == 0 || version < 0 {
    return false
  }
  var axis = 1
  if version >= 13 {
    axis = -1
  }
  if base.has(meta, "axis") {
    axis = meta["axis"]
  }
  if axis < 0 {
    axis += rank
  }
  if axis < 0 || axis >= rank {
    return false
  }
  if version < 13 {
    var axes: list<int> = []
    for value in axis..rank {
      axes += [value]
    }
    inputs += [ints(m, op, axes)]
  } else {
    inputs += [ir.constant(m, op, axis, ty("int"))]
  }
  inputs += [ir.constant(m, op, 1.0, ty("f64"))]
  return convert_call(m, op, "nn.softmax", inputs)
}

[phase: "compute", on: "onnx.Reshape"]
local fn convert_reshape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let expected = reshape_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape", [inputs[0]])
}

local fn convert_binary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  let result = ir.type(outputs[0])
  if !tensor.valid(left) || !tensor.valid(right) ||
     !tensor.valid(result) {
    return false
  }
  if tensor.elem(left) != tensor.elem(right) ||
     tensor.elem(left) != tensor.elem(result) {
    return false
  }
  var left_ok = len(tensor.dims(left)) == 0
  var right_ok = len(tensor.dims(right)) == 0
  if !left_ok {
    left_ok = tensor.broadcastable(
      tensor.dims(left), tensor.dims(result)
    )
  }
  if !right_ok {
    right_ok = tensor.broadcastable(
      tensor.dims(right), tensor.dims(result)
    )
  }
  if !left_ok || !right_ok {
    return false
  }
  return convert_call(m, op, callee)
}

[phase: "compute", on: "onnx.Add"]
local fn convert_add(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.add")
}

[phase: "compute", on: "onnx.Sub"]
local fn convert_sub(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.sub")
}

[phase: "compute", on: "onnx.Mul"]
local fn convert_mul(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.mul")
}

[phase: "compute", on: "onnx.Div"]
local fn convert_div(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.div")
}

[phase: "compute", on: "onnx.Pow"]
local fn convert_pow(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.pow")
}

local fn quant_axis(op: Op, data: Ty, params: Ty) -> int {
  if !tensor.valid(data) || !tensor.valid(params) {
    return -1
  }
  let shape = tensor.dims(data)
  let parameter_shape = tensor.dims(params)
  if len(parameter_shape) == 0 ||
     (len(parameter_shape) == 1 && parameter_shape[0] == ty(1)) {
    return 0
  }
  if len(parameter_shape) != 1 {
    return -1
  }
  var axis = base.int(base.get(attrs(op), "axis", 1))
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) ||
     parameter_shape[0] != shape[axis] {
    return -1
  }
  return axis
}

local fn quant_bounds(elem: Ty) -> list<int> {
  if elem == ty("u8") {
    return [0, 255]
  }
  if elem == ty("i8") {
    return [-128, 127]
  }
  if elem == ty("u16") {
    return [0, 65535]
  }
  if elem == ty("i16") {
    return [-32768, 32767]
  }
  var unsupported: list<int> = []
  return unsupported
}

[phase: "compute", on: "onnx.QuantizeLinear"]
local fn convert_quantize(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let data = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  let zero = ir.type(inputs[2])
  let result = ir.type(outputs[0])
  if !tensor.valid(data) || !tensor.valid(scale) ||
     !tensor.valid(zero) || !tensor.valid(result) ||
     tensor.elem(scale) != tensor.elem(data) ||
     tensor.elem(zero) != tensor.elem(result) ||
     tensor.dims(zero) != tensor.dims(scale) ||
     tensor.dims(result) != tensor.dims(data) {
    return false
  }
  let axis = quant_axis(op, data, scale)
  let bounds = quant_bounds(tensor.elem(result))
  if axis < 0 || len(bounds) != 2 {
    return false
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  inputs += [ir.constant(m, op, bounds[0], ty("int"))]
  inputs += [ir.constant(m, op, bounds[1], ty("int"))]
  return convert_call(m, op, "quant.quantize", inputs)
}

[phase: "compute", on: "onnx.DequantizeLinear"]
local fn convert_dequantize(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let data = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  let zero = ir.type(inputs[2])
  let result = ir.type(outputs[0])
  if !tensor.valid(data) || !tensor.valid(scale) ||
     !tensor.valid(zero) || !tensor.valid(result) ||
     tensor.elem(zero) != tensor.elem(data) ||
     tensor.elem(scale) != tensor.elem(result) ||
     tensor.dims(zero) != tensor.dims(scale) ||
     tensor.dims(result) != tensor.dims(data) {
    return false
  }
  let axis = quant_axis(op, data, scale)
  if axis < 0 {
    return false
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  return convert_call(m, op, "quant.dequantize", inputs)
}

[phase: "compute", on: "onnx.DynamicQuantizeLinear"]
local fn convert_dynamic_quant(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 3 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  if ir.type(outputs[0]) != shaped(ty("u8"), shape) ||
     ir.type(outputs[1]) != ty("tensor<f32, []>") ||
     ir.type(outputs[2]) != ty("tensor<u8, []>") ||
     tensor.elem(input) != ty("f32") {
    return false
  }
  return convert_call(m, op, "quant.dynamic")
}

[phase: "shape", on: "onnx.Cast"]
local fn convert_cast(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) ||
     tensor.dims(input) != tensor.dims(result) ||
     tensor.elem(result) != element(base.get(attrs(op), "to", 0)) {
    return false
  }
  return convert_call(m, op, "tensor.cast")
}

local fn matmul_param(type: Ty, elem: Ty, extent: Ty) -> bool {
  if !tensor.valid(type) || tensor.elem(type) != elem {
    return false
  }
  let shape = tensor.dims(type)
  return len(shape) == 0 ||
         (len(shape) == 1 &&
          (shape[0] == ty(1) || shape[0] == extent))
}

[phase: "compute", on: "onnx.MatMulInteger"]
local fn convert_integer_matmul(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 4 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     len(tensor.dims(left)) < 2 || len(tensor.dims(right)) < 2 ||
     !matmul_param(
       ir.type(inputs[2]), tensor.elem(left),
       tensor.dims(left)[len(tensor.dims(left)) - 2]
     ) ||
     !matmul_param(
       ir.type(inputs[3]), tensor.elem(right),
       tensor.dims(right)[len(tensor.dims(right)) - 1]
     ) {
    return false
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 ||
     ir.type(outputs[0]) != shaped(ty("i32"), shape) {
    return false
  }
  return convert_call(m, op, "quant.matmul")
}

[phase: "compute", on: "com_microsoft.FusedMatMul"]
local fn convert_fused_matmul(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let expected = fused_matmul_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let meta = attrs(op)
  inputs += [
    ir.constant(m, op, base.get(meta, "transA", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "transB", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "alpha", 1.0), ty("f64"))
  ]
  return convert_call(m, op, "tensor.matmul", inputs)
}

[phase: "compute", on: "onnx.Flatten"]
local fn convert_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let expected = flattened(input, axis)
  if expected == ty("_") || result != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape")
}

[phase: "compute", on: "onnx.MatMul"]
local fn convert_matmul(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  let expected = matmul_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.matmul")
}

[phase: "compute", on: "onnx.Gemm"]
local fn convert_gemm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let expected = gemm_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let meta = attrs(op)
  inputs += [
    ir.constant(m, op, base.get(meta, "transA", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "transB", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "alpha", 1.0), ty("f64"))
  ]
  if len(ir.args(op)) == 3 {
    inputs += [
      ir.constant(m, op, base.get(meta, "beta", 1.0), ty("f64"))
    ]
  }
  return convert_call(m, op, "nn.gemm", inputs)
}

[phase: "compute", on: "onnx.Transpose"]
local fn convert_transpose(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  if result != shaped(tensor.elem(input), tensor.permuted(shape, axes)) {
    return false
  }
  inputs += [ints(m, op, axes)]
  return convert_call(m, op, "tensor.permute", inputs)
}

[phase: "compute", on: "onnx.ReduceMean"]
local fn convert_mean(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let expected = reduce_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let axes = reduce_axes(op, len(tensor.dims(ir.type(inputs[0]))))
  inputs += [ints(m, op, axes)]
  return convert_call(m, op, "tensor.mean", inputs)
}

local fn convert_pool(m: Mod, op: Op, callee: str) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  if callee == "nn.avg_pool2d" &&
     base.get(meta, "count_include_pad", 0) != 0 {
    return false
  }
  if callee == "nn.max_pool2d" &&
     base.get(meta, "storage_order", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  let pad = spatial_pad(op, kernel)
  if len(kernel) != 2 || len(stride) != 2 || len(pad) != 4 ||
     len(dilation) != 2 {
    return false
  }
  inputs += [ints(m, op, kernel)]
  inputs += [ints(m, op, stride)]
  inputs += [ints(m, op, pad)]
  inputs += [ints(m, op, dilation)]
  inputs += [ints(m, op, [0, 1, 2, 3])]
  return convert_call(m, op, callee, inputs)
}

[phase: "compute", on: "onnx.GlobalAveragePool"]
local fn convert_global_pool(m: Mod, op: Op) -> bool {
  return convert_call(m, op, "nn.global_avg_pool2d")
}

[phase: "compute", on: "onnx.AveragePool"]
local fn convert_avg_pool(m: Mod, op: Op) -> bool {
  return convert_pool(m, op, "nn.avg_pool2d")
}

[phase: "compute", on: "onnx.MaxPool"]
local fn convert_max_pool(m: Mod, op: Op) -> bool {
  return convert_pool(m, op, "nn.max_pool2d")
}

[phase: "shape", on: "onnx.Identity"]
local fn convert_identity(m: Mod, op: Op) -> bool {
  return convert_unary(m, op, "base.copy")
}

fn convert(m: Mod, rules: list<Fn>) -> bool {
  var changed = infer(m, rules)
  changed = ir.use(m, "nn") || changed
  changed = ir.use(m, "quant") || changed
  changed = ir.use(m, "tensor") || changed
  for phase in ["data", "compute", "shape", "cleanup"] {
    let selected = ir.where(rules, "phase", phase)
    for op in ir.ops(m) {
      for rule in ir.where(selected, "on", ir.callee(op)) {
        changed = ir.invoke<bool>(m, op, rule) || changed
      }
    }
  }
  return changed
}

fn convert(m: Mod) -> bool {
  return convert(m, ir.fns("onnx.nn"))
}
