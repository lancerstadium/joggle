module onnx.nn
use onnx
use nn
use quant
use ir

[memo]
local fn phase_rules(
  rules: list<Fn>, phase: str, callee: str
) -> list<Fn> {
  return ir.where(ir.where(rules, "phase", phase), "on", callee)
}

local fn set_type(m: Mod, value: Val, type: Ty) -> bool {
  if type == ty("_") {
    return false
  }
  let current = ir.type(value)
  if current == ty("_") {
    return ir.type(m, value, type)
  }
  let refined = tensor.refined(current, type)
  if refined != ty("_") && refined != current {
    return ir.type(m, value, refined)
  }
  return false
}

local fn attrs(op: Op) -> Attr {
  return base.get(ir.meta(op), "onnx", {})
}

local fn refine_graph_ref(m: Mod, op: Op, ref: Attr) -> bool {
  if base.kind(ref) != "dict" || !base.has(ref, "fn") ||
     !base.has(ref, "inputs") || !base.has(ref, "captures") ||
     base.kind(ref["fn"]) != "str" ||
     base.kind(ref["inputs"]) != "int" ||
     base.kind(ref["captures"]) != "list" {
    return false
  }
  let graph = ir.find(m, base.str(ref["fn"]))
  if !ir.live(graph) {
    return false
  }
  let first = base.int(ref["inputs"])
  let params = ir.params(graph)
  let inputs = ir.args(op)
  if first < 0 || first + len(ref["captures"]) > len(params) {
    return false
  }
  for capture in ref["captures"] {
    if base.kind(capture) != "int" {
      return false
    }
    let index = base.int(capture)
    if index < 0 || index >= len(inputs) {
      return false
    }
  }
  var changed = false
  var offset = 0
  for capture in ref["captures"] {
    let index = base.int(capture)
    changed = set_type(
      m, params[first + offset], ir.type(inputs[index])
    ) || changed
    offset += 1
  }
  return changed
}

[phase: "infer", on: "*"]
local fn refine_graphs(m: Mod, op: Op) -> bool {
  var changed = false
  let meta = attrs(op)
  for key in base.keys(meta) {
    let value = meta[key]
    if base.kind(value) == "dict" {
      changed = refine_graph_ref(m, op, value) || changed
    }
    if base.kind(value) == "list" {
      for item in value {
        changed = refine_graph_ref(m, op, item) || changed
      }
    }
  }
  return changed
}

local fn shaped(elem: Ty, dims: list<Ty>) -> Ty {
  return ty("tensor", [elem, ty("[]", dims)])
}

local fn same_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 0 && len(outputs) == 1 {
    let type = ir.type(inputs[0])
    if tensor.valid(type) {
      return set_type(m, outputs[0], type)
    }
  }
  return false
}

local fn dropout_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 3 ||
     len(outputs) < 1 || len(outputs) > 2 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  var changed = set_type(m, outputs[0], input)
  if len(outputs) == 2 {
    changed = set_type(
      m, outputs[1], shaped(ty("bool"), tensor.dims(input))
    ) || changed
  }
  return changed
}

local fn layer_norm_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 3 ||
     len(outputs) < 1 || len(outputs) > 3 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return false
  }
  var changed = set_type(m, outputs[0], input)
  if len(outputs) > 1 {
    var reduced = shape
    for dim in axis..len(shape) {
      reduced[dim] = ty(1)
    }
    let saved = shaped(ty("f32"), reduced)
    changed = set_type(m, outputs[1], saved) || changed
    if len(outputs) > 2 {
      changed = set_type(m, outputs[2], saved) || changed
    }
  }
  return changed
}

local fn unary_rules() -> list<list<str>> {
  return [
    ["onnx.Relu", "nn.relu"],
    ["onnx.Abs", "nn.abs"],
    ["onnx.Sqrt", "nn.sqrt"],
    ["onnx.Cos", "nn.cos"],
    ["onnx.Sin", "nn.sin"],
    ["onnx.Reciprocal", "nn.recip"],
    ["onnx.Tanh", "nn.tanh"],
    ["onnx.Exp", "nn.exp"],
    ["onnx.Floor", "nn.floor"],
    ["onnx.Log", "nn.log"],
    ["onnx.Erf", "nn.erf"],
    ["onnx.Sigmoid", "nn.sigmoid"],
    ["onnx.Ceil", "nn.ceil"],
    ["onnx.Round", "nn.round_even"]
  ]
}

[phase: "infer", on: [
  "onnx.Relu", "onnx.Abs", "onnx.Dropout", "onnx.Sqrt", "onnx.Reciprocal",
  "onnx.Cos", "onnx.Sin",
  "onnx.Tanh", "onnx.Exp", "onnx.Floor", "onnx.Log", "onnx.Erf",
  "onnx.Sigmoid", "onnx.Ceil", "onnx.Round",
  "onnx.BatchNormalization", "onnx.LeakyRelu", "onnx.Softmax",
  "onnx.Identity", "onnx.Clip", "onnx.LRN"
]]
local fn infer_unary(m: Mod, op: Op) -> bool {
  let callee = ir.callee(op)
  if callee == "onnx.Dropout" {
    return dropout_type(m, op)
  }
  for rule in unary_rules() {
    if callee == rule[0] {
      return same_type(m, op)
    }
  }
  if callee == "onnx.BatchNormalization" ||
     callee == "onnx.LeakyRelu" || callee == "onnx.Softmax" ||
     callee == "onnx.Identity" || callee == "onnx.Clip" ||
     callee == "onnx.LRN" {
    return same_type(m, op)
  }
  return false
}

[phase: "infer", on: "onnx.LayerNormalization"]
local fn infer_layer_norm(m: Mod, op: Op) -> bool {
  return layer_norm_type(m, op)
}

local fn spatial_pad(op: Op, kernel: list<int>) -> list<int> {
  var none: list<int> = []
  let inputs = ir.args(op)
  if len(inputs) == 0 || len(kernel) != 2 {
    return none
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return none
  }
  let shape = tensor.dims(input)
  if len(shape) != 4 || kernel[0] <= 0 || kernel[1] <= 0 {
    return none
  }
  let meta = attrs(op)
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(stride) != 2 || len(dilation) != 2 ||
     stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return none
  }
  let mode = base.get(meta, "auto_pad", "NOTSET")
  if mode == "NOTSET" {
    let pad = base.get(meta, "pads", [0, 0, 0, 0])
    if len(pad) == 4 {
      return pad
    }
    return none
  }
  if mode == "VALID" {
    return [0, 0, 0, 0]
  }
  if mode != "SAME_UPPER" && mode != "SAME_LOWER" {
    return none
  }
  if kind(shape[2]) != "int" || kind(shape[3]) != "int" {
    if stride[0] != 1 || stride[1] != 1 {
      return none
    }
    let ph = dilation[0] * (kernel[0] - 1)
    let pw = dilation[1] * (kernel[1] - 1)
    var top = ph / 2
    var left = pw / 2
    if mode == "SAME_LOWER" {
      top = (ph + 1) / 2
      left = (pw + 1) / 2
    }
    return [top, left, ph - top, pw - left]
  }
  let h = int(shape[2])
  let w = int(shape[3])
  let oh = (h + stride[0] - 1) / stride[0]
  let ow = (w + stride[1] - 1) / stride[1]
  let kh = dilation[0] * (kernel[0] - 1) + 1
  let kw = dilation[1] * (kernel[1] - 1) + 1
  var ph = (oh - 1) * stride[0] + kh - h
  var pw = (ow - 1) * stride[1] + kw - w
  if ph < 0 {
    ph = 0
  }
  if pw < 0 {
    pw = 0
  }
  var top = ph / 2
  var left = pw / 2
  if mode == "SAME_LOWER" {
    top = (ph + 1) / 2
    left = (pw + 1) / 2
  }
  return [top, left, ph - top, pw - left]
}

[phase: "infer", on: "onnx.QuantizeLinear"]
local fn quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  var elem = ty("u8")
  if len(inputs) == 3 {
    let zero = ir.type(inputs[2])
    if !tensor.valid(zero) {
      return false
    }
    elem = tensor.elem(zero)
  }
  return set_type(m, outputs[0], shaped(elem, tensor.dims(input)))
}

[phase: "infer", on: "onnx.DequantizeLinear"]
local fn dequant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(tensor.elem(scale), tensor.dims(input))
  )
}

local fn broadcast_type(m: Mod, op: Op, result_elem: Ty) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) {
    return false
  }
  let source_elem = tensor.elem(first)
  var shape: list<Ty> = tensor.dims(first)
  for input in inputs {
    let type = ir.type(input)
    if !tensor.valid(type) || tensor.elem(type) != source_elem {
      return false
    }
    let dims: list<Ty> = tensor.dims(type)
    let next: list<Ty> = tensor.broadcast_shape(shape, dims)
    if !tensor.broadcastable(shape, next) ||
       !tensor.broadcastable(dims, next) {
      return false
    }
    shape = next
  }
  var elem = result_elem
  if elem == ty("_") {
    elem = source_elem
  }
  return set_type(m, outputs[0], shaped(elem, shape))
}

[phase: "infer", on: ["onnx.Add", "onnx.Sub", "onnx.Mul", "onnx.Div", "onnx.Pow"]]
local fn binary_type(m: Mod, op: Op) -> bool {
  if len(ir.args(op)) != 2 {
    return false
  }
  return broadcast_type(m, op, ty("_"))
}

[phase: "infer", on: ["onnx.Equal", "onnx.Greater", "onnx.Less"]]
local fn compare_type(m: Mod, op: Op) -> bool {
  if len(ir.args(op)) != 2 {
    return false
  }
  return broadcast_type(m, op, ty("bool"))
}

[phase: "infer", on: "onnx.Where"]
local fn where_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let condition = ir.type(inputs[0])
  let left = ir.type(inputs[1])
  let right = ir.type(inputs[2])
  if !tensor.valid(condition) || tensor.elem(condition) != ty("bool") ||
     !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return false
  }
  var shape = tensor.broadcast_shape(
    tensor.dims(condition), tensor.dims(left)
  )
  if !tensor.broadcastable(tensor.dims(condition), shape) ||
     !tensor.broadcastable(tensor.dims(left), shape) {
    return false
  }
  let next = tensor.broadcast_shape(shape, tensor.dims(right))
  if !tensor.broadcastable(shape, next) ||
     !tensor.broadcastable(tensor.dims(right), next) {
    return false
  }
  return set_type(m, outputs[0], shaped(tensor.elem(left), next))
}

[phase: "infer", on: ["onnx.Max", "onnx.Min"]]
local fn extrema_type(m: Mod, op: Op) -> bool {
  return broadcast_type(m, op, ty("_"))
}

local fn signed(data: Attr, offset: int, width: int) -> int {
  var value = base.byte(data, offset + width - 1)
  if value >= 128 {
    value -= 256
  }
  for reverse in 1..width {
    value = value * 256 + base.byte(data, offset + width - reverse - 1)
  }
  return value
}

local fn tensor_literal(op: Op) -> Attr {
  let meta = attrs(op)
  if !base.has(meta, "value") {
    return {}
  }
  let literal = meta["value"]
  if base.kind(literal) != "dict" ||
     !base.has(literal, "type") ||
     !base.has(literal, "shape") ||
     !base.has(literal, "data") ||
     base.kind(literal["type"]) != "int" ||
     base.kind(literal["shape"]) != "list" ||
     base.kind(literal["data"]) != "bytes" {
    return {}
  }
  return literal
}

local fn tensor_data(op: Op) -> Attr {
  let outputs = ir.outs(op)
  if ir.kind(op) == "constant" && len(outputs) == 1 &&
     tensor.valid(ir.type(outputs[0])) &&
     base.kind(ir.constant(outputs[0])) == "bytes" {
    return ir.constant(outputs[0])
  }
  if ir.callee(op) == "onnx.tensor" {
    let inputs = ir.args(op)
    let index = 2
    if len(inputs) > index && ir.is_const(inputs[index]) {
      return ir.constant(inputs[index])
    }
  }
  if ir.callee(op) == "onnx.Constant" {
    let literal = tensor_literal(op)
    if base.kind(literal) == "dict" {
      return literal["data"]
    }
  }
  return ir.meta(op)
}

local fn literal_ints(value: Val) -> list<int> {
  var out: list<int> = []
  let type = ir.type(value)
  if !tensor.valid(type) {
    return out
  }
  var width = 0
  if tensor.elem(type) == ty("i32") {
    width = 4
  }
  if tensor.elem(type) == ty("i64") {
    width = 8
  }
  if width == 0 {
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let data = tensor_data(producer)
  if base.kind(data) != "bytes" {
    return out
  }
  if base.size(data) % width != 0 {
    return out
  }
  for i in 0..base.size(data) / width {
    out += [signed(data, i * width, width)]
  }
  return out
}

local fn static_count(type: Ty) -> int {
  if !tensor.valid(type) {
    return -1
  }
  var out = 1
  for dim in tensor.dims(type) {
    if kind(dim) != "int" || int(dim) < 0 {
      return -1
    }
    out *= int(dim)
  }
  return out
}

local fn splat(value: int, count: int) -> list<int> {
  var out: list<int> = []
  if count < 0 {
    return out
  }
  for i in 0..count {
    out += [value]
  }
  return out
}

local fn selected(values: list<int>, index: int, count: int) -> int {
  base.assert(
    len(values) == 1 || len(values) == count,
    "static tensor broadcast is incompatible"
  )
  if len(values) == 1 {
    return values[0]
  }
  return values[index]
}

local fn const_ints(value: Val) -> list<int> {
  let literal = literal_ints(value)
  if len(literal) != 0 {
    return literal
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return []
  }
  let callee = ir.callee(producer)
  let inputs = ir.args(producer)
  let count = static_count(ir.type(value))

  if callee == "base.list" {
    var out: list<int> = []
    for input in inputs {
      if !ir.is_const(input) || base.kind(ir.constant(input)) != "int" {
        return []
      }
      out += [base.int(ir.constant(input))]
    }
    return out
  }

  if callee == "tensor.shape" && len(inputs) == 1 {
    let input = ir.type(inputs[0])
    if !tensor.valid(input) {
      return []
    }
    var out: list<int> = []
    for dim in tensor.dims(input) {
      if kind(dim) != "int" || int(dim) < 0 {
        return []
      }
      out += [int(dim)]
    }
    return out
  }

  if (callee == "onnx.ConstantOfShape" || callee == "tensor.fill") &&
     count >= 0 {
    if callee == "tensor.fill" && len(inputs) == 1 {
      let fill = const_ints(inputs[0])
      if len(fill) == 1 {
        return splat(fill[0], count)
      }
      return []
    }
    let meta = attrs(producer)
    if !base.has(meta, "value") {
      return splat(0, count)
    }
    let value_attr = meta["value"]
    if base.kind(value_attr) != "dict" ||
       !base.has(value_attr, "data") ||
       base.kind(value_attr["data"]) != "bytes" {
      return []
    }
    let elem = tensor.elem(ir.type(value))
    var width = 0
    if elem == ty("i32") {
      width = 4
    }
    if elem == ty("i64") {
      width = 8
    }
    if width == 0 || base.size(value_attr["data"]) != width {
      return []
    }
    return splat(signed(value_attr["data"], 0, width), count)
  }

  if (callee == "onnx.Mul" || callee == "nn.mul" ||
      callee == "base.operator *") && len(inputs) == 2 && count >= 0 {
    let left = const_ints(inputs[0])
    let right = const_ints(inputs[1])
    if (len(left) != 1 && len(left) != count) ||
       (len(right) != 1 && len(right) != count) {
      return []
    }
    var out: list<int> = []
    for i in 0..count {
      out += [selected(left, i, count) * selected(right, i, count)]
    }
    return out
  }

  if (callee == "onnx.Equal" || callee == "operator ==") &&
     len(inputs) == 2 && count >= 0 {
    let left = const_ints(inputs[0])
    let right = const_ints(inputs[1])
    if (len(left) != 1 && len(left) != count) ||
       (len(right) != 1 && len(right) != count) {
      return []
    }
    var out: list<int> = []
    for i in 0..count {
      var equal = 0
      if selected(left, i, count) == selected(right, i, count) {
        equal = 1
      }
      out += [equal]
    }
    return out
  }

  if (callee == "onnx.Where" || callee == "nn.where") &&
     len(inputs) == 3 && count >= 0 {
    let condition = const_ints(inputs[0])
    let left = const_ints(inputs[1])
    let right = const_ints(inputs[2])
    if (len(condition) != 1 && len(condition) != count) ||
       (len(left) != 1 && len(left) != count) ||
       (len(right) != 1 && len(right) != count) {
      return []
    }
    var out: list<int> = []
    for i in 0..count {
      if selected(condition, i, count) != 0 {
        out += [selected(left, i, count)]
      } else {
        out += [selected(right, i, count)]
      }
    }
    return out
  }
  return []
}

local fn int_vector_len(value: Val) -> int {
  let type = ir.type(value)
  if !tensor.valid(type) ||
     (tensor.elem(type) != ty("i32") && tensor.elem(type) != ty("i64")) {
    return -1
  }
  let shape = tensor.dims(type)
  if len(shape) != 1 || kind(shape[0]) != "int" || int(shape[0]) < 0 {
    return -1
  }
  return int(shape[0])
}

local fn attr_ints(value: Attr) -> list<int> {
  var out: list<int> = []
  if base.kind(value) != "list" {
    return out
  }
  for item in value {
    if base.kind(item) != "int" {
      var invalid: list<int> = []
      return invalid
    }
    out += [base.int(item)]
  }
  return out
}

local fn slice_starts(op: Op) -> list<int> {
  let inputs = ir.args(op)
  if len(inputs) >= 3 && len(inputs) <= 5 {
    return const_ints(inputs[1])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "starts") {
    return attr_ints(meta["starts"])
  }
  var missing: list<int> = []
  return missing
}

local fn slice_ends(op: Op) -> list<int> {
  let inputs = ir.args(op)
  if len(inputs) >= 3 && len(inputs) <= 5 {
    return const_ints(inputs[2])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "ends") {
    return attr_ints(meta["ends"])
  }
  var missing: list<int> = []
  return missing
}

local fn slice_axes(op: Op) -> list<int> {
  let inputs = ir.args(op)
  var out: list<int> = []
  if len(inputs) >= 4 && len(inputs) <= 5 {
    out = const_ints(inputs[3])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "axes") {
    out = attr_ints(meta["axes"])
  }
  if len(out) == 0 {
    for axis in 0..len(slice_starts(op)) {
      out += [axis]
    }
  }
  return out
}

local fn slice_steps(op: Op) -> list<int> {
  let inputs = ir.args(op)
  var out: list<int> = []
  if len(inputs) == 5 {
    out = const_ints(inputs[4])
  }
  let meta = attrs(op)
  if len(inputs) == 1 && base.has(meta, "steps") {
    out = attr_ints(meta["steps"])
  }
  if len(out) == 0 {
    for start in slice_starts(op) {
      out += [1]
    }
  }
  return out
}

fn shape_terms(value: Val) -> list<Ty> {
  var out: list<Ty> = []
  let literal = const_ints(value)
  if len(literal) != 0 {
    for item in literal {
      out += [ty(item)]
    }
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let inputs = ir.args(producer)
  if ir.callee(producer) == "onnx.Shape" && len(inputs) == 1 {
    let input = ir.type(inputs[0])
    if tensor.valid(input) {
      return tensor.dims(input)
    }
  }
  if (ir.callee(producer) == "onnx.Cast" ||
      ir.callee(producer) == "onnx.Identity" ||
      ir.callee(producer) == "onnx.Squeeze" ||
      ir.callee(producer) == "onnx.Unsqueeze") && len(inputs) >= 1 {
    return shape_terms(inputs[0])
  }
  if ir.callee(producer) == "onnx.Gather" && len(inputs) == 2 &&
     base.get(attrs(producer), "axis", 0) == 0 {
    let source = shape_terms(inputs[0])
    let indices = const_ints(inputs[1])
    if len(source) == 0 || len(indices) == 0 {
      return out
    }
    for raw in indices {
      var index = raw
      if index < 0 {
        index += len(source)
      }
      if index < 0 || index >= len(source) {
        return []
      }
      out += [source[index]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Slice" && len(inputs) >= 1 {
    let source = shape_terms(inputs[0])
    let starts = slice_starts(producer)
    let ends = slice_ends(producer)
    let selected = slice_axes(producer)
    let steps = slice_steps(producer)
    if len(source) == 0 || len(starts) != 1 ||
       len(ends) != 1 || len(selected) != 1 || len(steps) != 1 ||
       selected[0] != 0 || steps[0] != 1 {
      return out
    }
    var first = starts[0]
    var last = ends[0]
    if first < 0 {
      first += len(source)
    }
    if last < 0 {
      last += len(source)
    }
    if first < 0 {
      first = 0
    }
    if last > len(source) {
      last = len(source)
    }
    if first > last || first >= len(source) {
      return out
    }
    for i in first..last {
      out += [source[i]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Concat" &&
     base.get(attrs(producer), "axis", 0) == 0 {
    for input in inputs {
      let part = shape_terms(input)
      if len(part) == 0 {
        return []
      }
      out += part
    }
    return out
  }
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.dims(type)
    var count = -1
    if len(shape) == 0 {
      count = 1
    }
    if len(shape) == 1 && kind(shape[0]) == "int" {
      count = int(shape[0])
    }
    if count >= 0 {
      for i in 0..count {
        out += [ty("_")]
      }
    }
  }
  return out
}

local fn element(code: int) -> Ty {
  var out = ty("_")
  if code == 1 {
    out = ty("f32")
  }
  if code == 2 {
    out = ty("u8")
  }
  if code == 3 {
    out = ty("i8")
  }
  if code == 4 {
    out = ty("u16")
  }
  if code == 5 {
    out = ty("i16")
  }
  if code == 6 {
    out = ty("i32")
  }
  if code == 7 {
    out = ty("i64")
  }
  if code == 9 {
    out = ty("bool")
  }
  if code == 10 {
    out = ty("f16")
  }
  if code == 11 {
    out = ty("f64")
  }
  if code == 12 {
    out = ty("u32")
  }
  if code == 13 {
    out = ty("u64")
  }
  if code == 16 {
    out = ty("bf16")
  }
  return out
}

local fn element_bytes(code: int) -> int {
  if code == 2 || code == 3 || code == 9 {
    return 1
  }
  if code == 4 || code == 5 || code == 10 || code == 16 {
    return 2
  }
  if code == 1 || code == 6 || code == 12 {
    return 4
  }
  if code == 7 || code == 11 || code == 13 {
    return 8
  }
  return 0
}

local fn constant_result(op: Op) -> Ty {
  let literal = tensor_literal(op)
  if base.kind(literal) != "dict" {
    return ty("_")
  }
  let code = base.int(literal["type"])
  let elem = element(code)
  let width = element_bytes(code)
  if elem == ty("_") || width == 0 {
    return ty("_")
  }
  let bytes = base.size(literal["data"])
  var count = 1
  var shape: list<Ty> = []
  for item in literal["shape"] {
    if base.kind(item) != "int" {
      return ty("_")
    }
    let dim = base.int(item)
    if dim < 0 {
      return ty("_")
    }
    if dim == 0 {
      count = 0
    } else {
      if count > bytes / width / dim {
        return ty("_")
      }
      count *= dim
    }
    shape += [ty(dim)]
  }
  if count * width != bytes {
    return ty("_")
  }
  return shaped(elem, shape)
}

[phase: "infer", on: "onnx.Constant"]
local fn constant_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], constant_result(op))
}

[phase: "infer", on: "onnx.Cast"]
local fn cast_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let elem = element(base.get(attrs(op), "to", 0))
  if !tensor.valid(input) || elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, tensor.dims(input)))
}

[phase: "infer", on: "onnx.Shape"]
local fn shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  let rank = len(tensor.dims(ir.type(inputs[0])))
  let shape: list<Ty> = [ty(rank)]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

local fn gather_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let data = ir.type(inputs[0])
  let indices = ir.type(inputs[1])
  if !tensor.valid(data) || !tensor.valid(indices) {
    return ty("_")
  }
  let shape = tensor.dims(data)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return ty("_")
  }
  return shaped(
    tensor.elem(data), tensor.gathered(shape, tensor.dims(indices), axis)
  )
}

[phase: "infer", on: "onnx.Gather"]
local fn gather_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], gather_result(op))
}

local fn axes(op: Op) -> list<int> {
  let meta = attrs(op)
  var out: list<int> = []
  if base.has(meta, "axes") {
    for axis in meta["axes"] {
      out += [axis]
    }
    return out
  }
  let inputs = ir.args(op)
  if len(inputs) >= 2 {
    return const_ints(inputs[1])
  }
  return out
}

local fn unsqueeze_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 && len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let raw = axes(op)
  let rank = len(source) + len(raw)
  var normalized: list<int> = []
  for value in raw {
    var axis = value
    if axis < 0 {
      axis += rank
    }
    normalized += [axis]
  }
  if !tensor.valid_axes(normalized, rank) {
    return ty("_")
  }
  var shape: list<Ty> = []
  var source_axis = 0
  for axis in 0..rank {
    var selected = false
    for value in normalized {
      if value == axis {
        selected = true
      }
    }
    if selected {
      shape += [ty(1)]
    } else {
      shape += [source[source_axis]]
      source_axis += 1
    }
  }
  return shaped(tensor.elem(input), shape)
}

local fn squeeze_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 && len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let raw = axes(op)
  var normalized: list<int> = []
  if len(raw) == 0 {
    for axis in 0..len(source) {
      if source[axis] == ty(1) {
        normalized += [axis]
      }
    }
  } else {
    for value in raw {
      var axis = value
      if axis < 0 {
        axis += len(source)
      }
      normalized += [axis]
    }
  }
  if !tensor.valid_axes(normalized, len(source)) {
    return ty("_")
  }
  var shape: list<Ty> = []
  for axis in 0..len(source) {
    var selected = false
    for value in normalized {
      if value == axis {
        selected = true
      }
    }
    if selected {
      if kind(source[axis]) == "int" && source[axis] != ty(1) {
        return ty("_")
      }
    } else {
      shape += [source[axis]]
    }
  }
  return shaped(tensor.elem(input), shape)
}

local fn unary_shape_type(m: Mod, op: Op, squeeze: bool) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  var result = unsqueeze_result(op)
  if squeeze {
    result = squeeze_result(op)
  }
  return set_type(m, outputs[0], result)
}

[phase: "infer", on: "onnx.Unsqueeze"]
local fn unsqueeze_type(m: Mod, op: Op) -> bool {
  return unary_shape_type(m, op, false)
}

[phase: "infer", on: "onnx.Squeeze"]
local fn squeeze_type(m: Mod, op: Op) -> bool {
  return unary_shape_type(m, op, true)
}

[phase: "infer", on: "onnx.Slice"]
local fn slice_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.sliced(
    tensor.dims(input), slice_starts(op), slice_ends(op),
    slice_axes(op), slice_steps(op)
  )
  if len(shape) != 0 {
    return set_type(m, outputs[0], shaped(tensor.elem(input), shape))
  }
  if len(inputs) < 3 || len(inputs) > 5 {
    return false
  }
  let count = int_vector_len(inputs[1])
  if count <= 0 || int_vector_len(inputs[2]) != count {
    return false
  }
  if len(inputs) >= 4 && int_vector_len(inputs[3]) != count {
    return false
  }
  if len(inputs) == 5 && int_vector_len(inputs[4]) != count {
    return false
  }
  let source = tensor.dims(input)
  if count > len(source) {
    return false
  }
  var open = source
  var selected = slice_axes(op)
  if len(inputs) == 3 {
    for axis in 0..count {
      selected += [axis]
    }
  } else {
    if len(selected) == 0 {
      for axis in 0..len(source) {
        open = tensor.replaced(open, axis, ty("_"))
      }
      return set_type(m, outputs[0], shaped(tensor.elem(input), open))
    }
  }
  if len(selected) != count {
    return false
  }
  for raw in selected {
    var axis = raw
    if axis < 0 {
      axis += len(source)
    }
    if axis < 0 || axis >= len(source) {
      return false
    }
    open = tensor.replaced(open, axis, ty("_"))
  }
  return set_type(m, outputs[0], shaped(tensor.elem(input), open))
}

local fn resize_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 3 && len(inputs) != 4 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  var shape: list<Ty> = []
  if len(inputs) == 4 {
    shape = shape_terms(inputs[3])
  }
  if len(shape) == len(source) {
    for dim in shape {
      if kind(dim) == "int" && int(dim) <= 0 {
        return ty("_")
      }
    }
    return shaped(tensor.elem(input), shape)
  }
  let scales = ir.type(inputs[2])
  if !tensor.valid(scales) || len(tensor.dims(scales)) != 1 ||
     tensor.dims(scales)[0] != ty(len(source)) {
    return ty("_")
  }
  for dim in source {
    shape += [ty("_")]
  }
  return shaped(tensor.elem(input), shape)
}

[phase: "infer", on: "onnx.Resize"]
local fn resize_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], resize_result(op))
}

[phase: "infer", on: "onnx.NonZero"]
local fn nonzero_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  var rank = ty("_")
  if tensor.valid(input) {
    rank = ty(len(tensor.dims(input)))
  }
  let shape: list<Ty> = [rank, ty("_")]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

[phase: "infer", on: "onnx.Range"]
local fn range_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) || len(tensor.dims(first)) != 0 {
    return false
  }
  for input in inputs {
    let type = ir.type(input)
    if !tensor.valid(type) || len(tensor.dims(type)) != 0 ||
       tensor.elem(type) != tensor.elem(first) {
      return false
    }
  }
  let shape: list<Ty> = [ty("_")]
  return set_type(m, outputs[0], shaped(tensor.elem(first), shape))
}

[phase: "infer", on: "onnx.NonMaxSuppression"]
local fn nms_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 5 || len(outputs) != 1 {
    return false
  }
  let shape: list<Ty> = [ty("_"), ty(3)]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

[phase: "infer", on: "onnx.Expand"]
local fn expand_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let shape = shape_terms(inputs[1])
  if !tensor.valid(input) {
    return false
  }
  let source_shape = tensor.dims(input)
  if len(shape) < len(source_shape) {
    return false
  }
  for dim in shape {
    if kind(dim) == "int" && int(dim) < 0 {
      return false
    }
  }
  let result = tensor.broadcast_shape(source_shape, shape)
  if len(result) == 0 {
    return false
  }
  return set_type(m, outputs[0], shaped(tensor.elem(input), result))
}

[phase: "infer", on: "onnx.Tile"]
local fn tile_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let source = tensor.dims(input)
  let repeats = const_ints(inputs[1])
  if len(repeats) == 0 {
    let repeat_type = ir.type(inputs[1])
    if !tensor.valid(repeat_type) || tensor.elem(repeat_type) != ty("i64") {
      return false
    }
    let repeat_shape = tensor.dims(repeat_type)
    if len(repeat_shape) != 1 || repeat_shape[0] != ty(len(source)) {
      return false
    }
    var open: list<Ty> = []
    for dim in source {
      open += [ty("_")]
    }
    return set_type(m, outputs[0], shaped(tensor.elem(input), open))
  }
  if len(repeats) != len(source) {
    return false
  }
  for repeat in repeats {
    if repeat < 0 {
      return false
    }
  }
  return set_type(
    m, outputs[0], shaped(tensor.elem(input), tensor.tiled(source, repeats))
  )
}

[phase: "infer", on: "onnx.TopK"]
local fn topk_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 2 {
    return false
  }
  let input = ir.type(inputs[0])
  let count = const_ints(inputs[1])
  if !tensor.valid(input) {
    return false
  }
  let source = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(source)
  }
  if axis < 0 || axis >= len(source) {
    return false
  }
  var extent = ty("_")
  if len(count) == 1 {
    if count[0] <= 0 ||
       (kind(source[axis]) == "int" && count[0] > int(source[axis])) {
      return false
    }
    extent = ty(count[0])
  } else {
    if int_vector_len(inputs[1]) != 1 ||
       tensor.elem(ir.type(inputs[1])) != ty("i64") {
      return false
    }
  }
  let shape = tensor.replaced(source, axis, extent)
  var changed = set_type(
    m, outputs[0], shaped(tensor.elem(input), shape)
  )
  changed = set_type(
    m, outputs[1], shaped(ty("i64"), shape)
  ) || changed
  return changed
}

local fn concat_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) == 0 {
    return ty("_")
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) {
    return ty("_")
  }
  let source = tensor.dims(first)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(source)
  }
  if axis < 0 || axis >= len(source) {
    return ty("_")
  }
  var shape = source
  for i in 1..len(inputs) {
    let input = inputs[i]
    let type = ir.type(input)
    if !tensor.valid(type) || tensor.elem(type) != tensor.elem(first) ||
       len(tensor.dims(type)) != len(source) {
      return ty("_")
    }
    shape = tensor.concatenated(shape, tensor.dims(type), axis)
    if len(shape) == 0 {
      return ty("_")
    }
  }
  return shaped(tensor.elem(first), shape)
}

[phase: "infer", on: "onnx.Concat"]
local fn concat_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], concat_result(op))
}

[phase: "infer", on: "onnx.Split"]
local fn split_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 1 && len(inputs) != 2) || len(outputs) == 0 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return false
  }
  var sizes: list<int> = []
  var symbolic = false
  if len(inputs) == 2 {
    sizes = const_ints(inputs[1])
  } else {
    let meta = attrs(op)
    if base.has(meta, "split") {
      for size in meta["split"] {
        sizes += [size]
      }
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) == "int" &&
     int(shape[axis]) % len(outputs) == 0 {
    let size = int(shape[axis]) / len(outputs)
    for output in outputs {
      sizes += [size]
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) != "int" {
    symbolic = true
    for output in outputs {
      sizes += [-1]
    }
  }
  if len(sizes) != len(outputs) {
    return false
  }
  var total = 0
  for size in sizes {
    if size < 0 && !symbolic {
      return false
    }
    if size >= 0 {
      total += size
    }
  }
  if kind(shape[axis]) == "int" && total != int(shape[axis]) {
    return false
  }
  var changed = false
  for i in 0..len(outputs) {
    var extent = ty("_")
    if sizes[i] >= 0 {
      extent = ty(sizes[i])
    }
    changed = set_type(
      m, outputs[i], shaped(
        tensor.elem(input), tensor.replaced(shape, axis, extent)
      )
    ) || changed
  }
  return changed
}

[phase: "infer", on: "onnx.OneHot"]
local fn one_hot_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let indices = ir.type(inputs[0])
  let values = ir.type(inputs[2])
  let depth = const_ints(inputs[1])
  if !tensor.valid(indices) || !tensor.valid(values) || len(depth) != 1 ||
     depth[0] <= 0 {
    return false
  }
  let value_shape = tensor.dims(values)
  if len(value_shape) != 1 || value_shape[0] != ty(2) {
    return false
  }
  let source = tensor.dims(indices)
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(source) + 1
  }
  if axis < 0 || axis > len(source) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(
      tensor.elem(values), tensor.inserted(source, axis, ty(depth[0]))
    )
  )
}

[phase: "infer", on: "onnx.DynamicQuantizeLinear"]
local fn dynamic_quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 3 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var changed = set_type(
    m, outputs[0], shaped(ty("u8"), shape)
  )
  changed = set_type(
    m, outputs[1], ty("tensor<f32, []>")
  ) || changed
  changed = set_type(
    m, outputs[2], ty("tensor<u8, []>")
  ) || changed
  return changed
}

[phase: "infer", on: "onnx.ConstantOfShape"]
local fn constant_shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let shape = shape_terms(inputs[0])
  if len(shape) == 0 {
    return false
  }
  var elem = ty("f32")
  let meta = attrs(op)
  if base.has(meta, "value") {
    elem = element(base.get(meta["value"], "type", 1))
  }
  if elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, shape))
}

local fn reshape_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let allowzero = base.get(attrs(op), "allowzero", 0)
  if allowzero != 0 && allowzero != 1 {
    return ty("_")
  }
  let requested = shape_terms(inputs[1])
  if len(requested) == 0 {
    let shape_type = ir.type(inputs[1])
    if !tensor.valid(shape_type) || tensor.elem(shape_type) != ty("i64") {
      return ty("_")
    }
    let shape_shape = tensor.dims(shape_type)
    if len(shape_shape) != 1 || kind(shape_shape[0]) != "int" ||
       int(shape_shape[0]) < 0 {
      return ty("_")
    }
    var open: list<Ty> = []
    for i in 0..int(shape_shape[0]) {
      open += [ty("_")]
    }
    return shaped(tensor.elem(input), open)
  }
  var inferred = -1
  var factors: list<Ty> = []
  for i in 0..len(requested) {
    if kind(requested[i]) == "int" {
      let extent = int(requested[i])
      if extent == -1 {
        if inferred != -1 {
          return ty("_")
        }
        inferred = i
      } else {
        if extent == 0 && allowzero == 0 {
          if i >= len(source) {
            return ty("_")
          }
          factors += [source[i]]
        } else {
          if extent >= 0 {
            factors += [requested[i]]
          } else {
            return ty("_")
          }
        }
      }
    } else {
      factors += [requested[i]]
    }
  }
  var missing = ty("_")
  if inferred != -1 {
    let source_total = tensor.product(source, 0, len(source))
    let factor_total = tensor.product(factors, 0, len(factors))
    if kind(source_total) == "int" && kind(factor_total) == "int" &&
       (int(factor_total) <= 0 ||
        int(source_total) % int(factor_total) != 0) {
      return ty("_")
    }
    missing = tensor.quotient(source, factors)
  }
  var shape: list<Ty> = []
  for i in 0..len(requested) {
    if kind(requested[i]) == "int" && int(requested[i]) == -1 {
      shape += [missing]
    } else {
      if kind(requested[i]) == "int" &&
         int(requested[i]) == 0 && allowzero == 0 {
        shape += [source[i]]
      } else {
        shape += [requested[i]]
      }
    }
  }
  let source_total = tensor.product(source, 0, len(source))
  let result_total = tensor.product(shape, 0, len(shape))
  if kind(source_total) == "int" && kind(result_total) == "int" &&
     source_total != result_total {
    return ty("_")
  }
  return shaped(tensor.elem(input), shape)
}

[phase: "infer", on: "onnx.Reshape"]
local fn reshape_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reshape_result(op))
}

local fn flattened(input: Ty, axis: int) -> Ty {
  let dims = tensor.dims(input)
  let outer = tensor.product(dims, 0, axis)
  let inner = tensor.product(dims, axis, len(dims))
  if outer == ty("_") || inner == ty("_") {
    return ty("_")
  }
  let shape: list<Ty> = [outer, inner]
  return shaped(tensor.elem(input), shape)
}

[phase: "infer", on: "onnx.Flatten"]
local fn infer_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let result = flattened(input, axis)
  if result == ty("_") {
    return false
  }
  return set_type(m, outputs[0], result)
}

local fn matmul_shape(
  left: Ty, right: Ty, transpose_left: bool, transpose_right: bool
) -> list<Ty> {
  var none: list<Ty> = []
  if !tensor.valid(left) || !tensor.valid(right) {
    return none
  }
  let ls = tensor.dims(left)
  let rs = tensor.dims(right)
  if len(ls) < 2 || len(rs) < 2 {
    return none
  }
  var rows = ls[len(ls) - 2]
  var left_depth = ls[len(ls) - 1]
  var right_depth = rs[len(rs) - 2]
  var columns = rs[len(rs) - 1]
  if transpose_left {
    rows = ls[len(ls) - 1]
    left_depth = ls[len(ls) - 2]
  }
  if transpose_right {
    right_depth = rs[len(rs) - 1]
    columns = rs[len(rs) - 2]
  }
  if left_depth != right_depth {
    return none
  }
  var left_batch: list<Ty> = []
  var right_batch: list<Ty> = []
  for i in 0..len(ls) - 2 {
    left_batch += [ls[i]]
  }
  for i in 0..len(rs) - 2 {
    right_batch += [rs[i]]
  }
  var shape: list<Ty> = []
  if len(left_batch) == 0 {
    shape = right_batch
  } else {
    if len(right_batch) == 0 {
      shape = left_batch
    } else {
      shape = tensor.broadcast_shape(left_batch, right_batch)
    }
  }
  if len(left_batch) != 0 {
    if !tensor.broadcastable(left_batch, shape) {
      return none
    }
  }
  if len(right_batch) != 0 {
    if !tensor.broadcastable(right_batch, shape) {
      return none
    }
  }
  shape += [rows, columns]
  return shape
}

local fn matmul_shape(left: Ty, right: Ty) -> list<Ty> {
  return matmul_shape(left, right, false, false)
}

local fn matmul_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return ty("_")
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return ty("_")
  }
  return shaped(tensor.elem(left), shape)
}

[phase: "infer", on: "onnx.MatMul"]
local fn matmul_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], matmul_result(op))
}

local fn gemm_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 && len(inputs) != 3 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) ||
     len(tensor.dims(left)) != 2 || len(tensor.dims(right)) != 2 {
    return ty("_")
  }
  let meta = attrs(op)
  let shape = matmul_shape(
    left, right,
    base.get(meta, "transA", 0) == 1,
    base.get(meta, "transB", 0) == 1
  )
  if len(shape) != 2 {
    return ty("_")
  }
  if len(inputs) == 3 {
    let bias = ir.type(inputs[2])
    if !tensor.valid(bias) || tensor.elem(bias) != tensor.elem(left) ||
       !tensor.broadcastable(tensor.dims(bias), shape) {
      return ty("_")
    }
  }
  return shaped(tensor.elem(left), shape)
}

[phase: "infer", on: "onnx.Gemm"]
local fn gemm_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], gemm_result(op))
}

[phase: "infer", on: "onnx.MatMulInteger"]
local fn integer_matmul_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 4 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) {
    return false
  }
  let le = tensor.elem(left)
  let re = tensor.elem(right)
  if (le != ty("i8") && le != ty("u8")) ||
     (re != ty("i8") && re != ty("u8")) {
    return false
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return false
  }
  return set_type(m, outputs[0], shaped(ty("i32"), shape))
}

[phase: "infer", on: "onnx.QLinearMatMul"]
local fn qlinear_matmul_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 8 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[3])
  let output_zero = ir.type(inputs[7])
  if !tensor.valid(left) || !tensor.valid(right) ||
     !tensor.valid(output_zero) {
    return false
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return false
  }
  return set_type(
    m, outputs[0], shaped(tensor.elem(output_zero), shape)
  )
}

[phase: "infer", on: "com_microsoft.QLinearAdd"]
local fn qlinear_add_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 8 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[3])
  let output_zero = ir.type(inputs[7])
  if !tensor.valid(left) || !tensor.valid(right) ||
     !tensor.valid(output_zero) {
    return false
  }
  let shape = tensor.broadcast_shape(
    tensor.dims(left), tensor.dims(right)
  )
  if len(shape) == 0 &&
     (len(tensor.dims(left)) != 0 || len(tensor.dims(right)) != 0) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(tensor.elem(output_zero), shape)
  )
}

local fn fused_matmul_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return ty("_")
  }
  let meta = attrs(op)
  let trans_a = base.get(meta, "transA", 0)
  let trans_b = base.get(meta, "transB", 0)
  if (trans_a != 0 && trans_a != 1) ||
     (trans_b != 0 && trans_b != 1) ||
     base.get(meta, "transBatchA", 0) != 0 ||
     base.get(meta, "transBatchB", 0) != 0 {
    return ty("_")
  }
  let shape = matmul_shape(left, right, trans_a == 1, trans_b == 1)
  if len(shape) == 0 {
    return ty("_")
  }
  return shaped(tensor.elem(left), shape)
}

[phase: "infer", on: "com_microsoft.FusedMatMul"]
local fn fused_matmul_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], fused_matmul_result(op))
}

local fn transpose_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "perm") {
    for axis in meta["perm"] {
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [rank - axis - 1]
    }
  }
  return axes
}

[phase: "infer", on: "onnx.Transpose"]
local fn transpose_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(
      tensor.elem(input), tensor.permuted(shape, axes)
    )
  )
}

local fn reduce_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  let inputs = ir.args(op)
  if len(inputs) == 2 {
    axes = const_ints(inputs[1])
    if len(axes) == 0 {
      let axes_type = ir.type(inputs[1])
      if !tensor.valid(axes_type) ||
         tensor.dims(axes_type) != [ty(0)] {
        return [rank]
      }
    }
  } else {
    if base.has(meta, "axes") {
      for value in meta["axes"] {
        axes += [value]
      }
    } else {
      for axis in 0..rank {
        axes += [axis]
      }
    }
  }
  if len(axes) == 0 && base.get(meta, "noop_with_empty_axes", 0) == 0 {
    for axis in 0..rank {
      axes += [axis]
    }
  }
  for index in 0..len(axes) {
    if axes[index] < 0 {
      axes[index] = axes[index] + rank
    }
  }
  return axes
}

local fn reduce_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) < 1 || len(inputs) > 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let shape = tensor.dims(input)
  let axes = reduce_axes(op, len(shape))
  if !tensor.valid_axes(axes, len(shape)) {
    return ty("_")
  }
  let keep = base.get(attrs(op), "keepdims", 1)
  if keep != 0 && keep != 1 {
    return ty("_")
  }
  return shaped(
    tensor.elem(input), tensor.reduced(shape, axes, keep == 1)
  )
}

[phase: "infer", on: [
  "onnx.ReduceMean", "onnx.ReduceSum", "onnx.ReduceMin", "onnx.ReduceMax"
]]
local fn reduce_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reduce_result(op))
}

[phase: "infer", on: "onnx.Loop"]
local fn loop_type(m: Mod, op: Op) -> bool {
  let body = onnx.graph(m, op, "body")
  if !ir.live(body) {
    return false
  }
  let info = base.get(attrs(op), "body", {})
  let inputs = base.get(info, "inputs", -1)
  let params = ir.params(body)
  let bodies = ir.blks(body)
  if len(bodies) != 1 {
    return false
  }
  let body_ops = ir.ops(bodies[0])
  if len(body_ops) == 0 ||
     ir.kind(body_ops[len(body_ops) - 1]) != "return" {
    return false
  }
  let returned = ir.args(body_ops[len(body_ops) - 1])
  let args = ir.args(op)
  let outputs = ir.outs(op)
  if inputs < 2 || len(params) < inputs ||
     len(args) < inputs {
    return false
  }
  var changed = set_type(m, params[0], ty("tensor<i64, []>"))
  changed = set_type(m, params[1], ty("tensor<bool, []>")) || changed
  for i in 2..inputs {
    changed = set_type(m, params[i], ir.type(args[i])) || changed
  }
  if len(returned) != len(outputs) + 1 {
    return changed
  }
  let carried = inputs - 2
  if carried > len(outputs) {
    return changed
  }
  var types: list<Ty> = []
  for i in 0..len(outputs) {
    var type = ir.type(returned[i + 1])
    if !tensor.valid(type) {
      return changed
    }
    if i >= carried {
      type = shaped(
        tensor.elem(type), [ty("_")] + tensor.dims(type)
      )
    }
    types += [type]
  }
  for i in 0..len(outputs) {
    changed = set_type(m, outputs[i], types[i]) || changed
  }
  return changed
}

local fn positive(dim: Ty) -> bool {
  return kind(dim) == "int" && int(dim) > 0
}

local fn known_mismatch(left: Ty, right: Ty) -> bool {
  return kind(left) == "int" && kind(right) == "int" && left != right
}

local fn conv_inputs(x: Ty, weight: Ty, bias: Ty, groups: int) -> bool {
  if !tensor.valid(x) || !tensor.valid(weight) || groups <= 0 {
    return false
  }
  if tensor.elem(x) != tensor.elem(weight) {
    return false
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if len(xs) != 4 || len(ws) != 4 {
    return false
  }
  if groups == 1 {
    if known_mismatch(xs[1], ws[1]) {
      return false
    }
  } else {
    if kind(xs[1]) == "int" && int(xs[1]) <= 0 {
      return false
    }
    if kind(ws[1]) == "int" && int(ws[1]) <= 0 {
      return false
    }
    if positive(xs[1]) && positive(ws[1]) &&
       int(xs[1]) != int(ws[1]) * groups {
      return false
    }
  }
  if bias != ty("_") {
    if !tensor.valid(bias) || tensor.elem(bias) != tensor.elem(x) {
      return false
    }
    let bs = tensor.dims(bias)
    if len(bs) != 1 || known_mismatch(bs[0], ws[0]) {
      return false
    }
  }
  return true
}

local fn conv_extent(
  input: Ty, low: int, high: int,
  kernel: int, stride: int, dilation: int
) -> Ty {
  if kind(input) == "int" {
    let result = (int(input) + low + high -
                  dilation * (kernel - 1) - 1) / stride + 1
    if result > 0 {
      return ty(result)
    }
    return ty("_")
  }
  if stride == 1 && low + high == dilation * (kernel - 1) {
    return input
  }
  return ty("_")
}

local fn same_extent(input: Ty, stride: int) -> Ty {
  if kind(input) == "int" {
    return ty((int(input) + stride - 1) / stride)
  }
  if stride == 1 {
    return input
  }
  return ty("_")
}

local fn conv_result(
  op: Op, x: Ty, weight: Ty, bias: Ty, elem: Ty
) -> Ty {
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  if !conv_inputs(x, weight, bias, groups) {
    return ty("_")
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if !positive(ws[2]) || !positive(ws[3]) ||
     (kind(xs[2]) == "int" && int(xs[2]) <= 0) ||
     (kind(xs[3]) == "int" && int(xs[3]) <= 0) {
    return ty("_")
  }
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(stride) != 2 || len(dilation) != 2 {
    return ty("_")
  }
  if stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return ty("_")
  }
  var h = ty("_")
  var w = ty("_")
  let mode = base.get(meta, "auto_pad", "NOTSET")
  if mode == "SAME_UPPER" || mode == "SAME_LOWER" {
    h = same_extent(xs[2], stride[0])
    w = same_extent(xs[3], stride[1])
  } else {
    let pad = spatial_pad(op, [int(ws[2]), int(ws[3])])
    if len(pad) != 4 {
      return ty("_")
    }
    h = conv_extent(
      xs[2], pad[0], pad[2], int(ws[2]), stride[0], dilation[0]
    )
    w = conv_extent(
      xs[3], pad[1], pad[3], int(ws[3]), stride[1], dilation[1]
    )
  }
  if (kind(xs[2]) == "int" && h == ty("_")) ||
     (kind(xs[3]) == "int" && w == ty("_")) {
    return ty("_")
  }
  let shape: list<Ty> = [xs[0], ws[0], h, w]
  return shaped(elem, shape)
}

local fn conv_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 && len(inputs) != 3 {
    return ty("_")
  }
  let x = ir.type(inputs[0])
  let weight = ir.type(inputs[1])
  var bias = ty("_")
  if len(inputs) == 3 {
    bias = ir.type(inputs[2])
  }
  if !tensor.valid(x) {
    return ty("_")
  }
  return conv_result(op, x, weight, bias, tensor.elem(x))
}

[phase: "infer", on: "onnx.Conv"]
local fn conv_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], conv_result(op))
}

[phase: "infer", on: "onnx.QLinearConv"]
local fn qlinear_conv_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 8 && len(inputs) != 9) || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  let weight = ir.type(inputs[3])
  let scale = ir.type(inputs[1])
  let output_zero = ir.type(inputs[7])
  if !tensor.valid(x) || !tensor.valid(weight) ||
     !tensor.valid(scale) || !tensor.valid(output_zero) {
    return false
  }
  let elem = tensor.elem(scale)
  let dequant_x = shaped(elem, tensor.dims(x))
  let dequant_weight = shaped(elem, tensor.dims(weight))
  var dequant_bias = ty("_")
  if len(inputs) == 9 {
    let bias = ir.type(inputs[8])
    if !tensor.valid(bias) {
      return false
    }
    dequant_bias = shaped(elem, tensor.dims(bias))
  }
  return set_type(
    m, outputs[0],
    conv_result(
      op, dequant_x, dequant_weight, dequant_bias,
      tensor.elem(output_zero)
    )
  )
}

[phase: "infer", on: "onnx.GlobalAveragePool"]
local fn global_pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(1), ty(1)]
  return set_type(
    m, outputs[0], shaped(tensor.elem(x), result)
  )
}

local fn pool_result(op: Op, x: Ty, elem: Ty) -> Ty {
  if !tensor.valid(x) {
    return ty("_")
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 ||
     (kind(shape[2]) == "int" && int(shape[2]) <= 0) ||
     (kind(shape[3]) == "int" && int(shape[3]) <= 0) {
    return ty("_")
  }
  let meta = attrs(op)
  if !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return ty("_")
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(kernel) != 2 || len(stride) != 2 || len(dilation) != 2 {
    return ty("_")
  }
  if kernel[0] <= 0 || kernel[1] <= 0 ||
     stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return ty("_")
  }
  var h = ty("_")
  var w = ty("_")
  let mode = base.get(meta, "auto_pad", "NOTSET")
  if mode == "SAME_UPPER" || mode == "SAME_LOWER" {
    h = same_extent(shape[2], stride[0])
    w = same_extent(shape[3], stride[1])
  } else {
    let pad = spatial_pad(op, kernel)
    if len(pad) != 4 {
      return ty("_")
    }
    h = conv_extent(
      shape[2], pad[0], pad[2], kernel[0], stride[0], dilation[0]
    )
    w = conv_extent(
      shape[3], pad[1], pad[3], kernel[1], stride[1], dilation[1]
    )
  }
  if (kind(shape[2]) == "int" && h == ty("_")) ||
     (kind(shape[3]) == "int" && w == ty("_")) {
    return ty("_")
  }
  let result: list<Ty> = [shape[0], shape[1], h, w]
  return shaped(elem, result)
}

[phase: "infer", on: ["onnx.AveragePool", "onnx.MaxPool"]]
local fn pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  return set_type(
    m, outputs[0],
    pool_result(op, ir.type(inputs[0]), tensor.elem(ir.type(inputs[0])))
  )
}

[phase: "infer", on: "com_microsoft.QLinearAveragePool"]
local fn qlinear_avg_pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 5 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  let output_zero = ir.type(inputs[4])
  if !tensor.valid(x) || !tensor.valid(scale) ||
     !tensor.valid(output_zero) {
    return false
  }
  let dequant = shaped(tensor.elem(scale), tensor.dims(x))
  return set_type(
    m, outputs[0],
    pool_result(op, dequant, tensor.elem(output_zero))
  )
}

local fn infer_once(m: Mod, rules: list<Fn>) -> bool {
  var changed = false
  let common = phase_rules(rules, "infer", "*")
  for op in ir.ops(m) {
    let matches = common + phase_rules(rules, "infer", ir.callee(op))
    for rule in matches {
      changed = ir.invoke<bool>(m, op, rule) || changed
    }
  }
  return changed
}

fn infer(m: Mod, rules: list<Fn>) -> bool {
  var changed = false
  var again = true
  var exhausted = false
  let limit = len(ir.ops(m)) + 1
  for round in 0..limit {
    if again {
      let before = ir.revision(m)
      infer_once(m, rules)
      again = ir.revision(m) != before
      changed = again || changed
      if round == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "onnx.nn.infer did not converge")
  return changed
}

fn infer(m: Mod) -> bool {
  return infer(m, ir.fns("onnx.nn"))
}
