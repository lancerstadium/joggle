module onnx.nn
use onnx
use nn
use ir

fn set_type(m: Mod, value: Val, type: Ty) -> bool {
  if type == ty("_") {
    return false
  }
  let current = ir.type(value)
  if current == ty("_") {
    return ir.type(m, value, type)
  }
  let refined = tensor.refined(current, type)
  if refined != ty("_") && refined != current {
    return ir.type(m, value, refined)
  }
  return false
}

fn attrs(op: Op) -> Attr {
  return base.get(ir.meta(op), "onnx", {})
}

fn shaped(elem: Ty, dims: list<Ty>) -> Ty {
  return ty("tensor", [elem, ty("[]", dims)])
}

fn same_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 0 && len(outputs) == 1 {
    let type = ir.type(inputs[0])
    if tensor.valid(type) {
      return set_type(m, outputs[0], type)
    }
  }
  return false
}

fn quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  var elem = ty("u8")
  if len(inputs) == 3 {
    let zero = ir.type(inputs[2])
    if !tensor.valid(zero) {
      return false
    }
    elem = tensor.elem(zero)
  }
  return set_type(m, outputs[0], shaped(elem, tensor.dims(input)))
}

fn dequant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(tensor.elem(scale), tensor.dims(input))
  )
}

fn binary_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) {
    return false
  }
  if tensor.elem(left) != tensor.elem(right) {
    return false
  }
  if len(tensor.dims(left)) == 0 {
    return set_type(m, outputs[0], right)
  }
  if len(tensor.dims(right)) == 0 {
    return set_type(m, outputs[0], left)
  }
  let shape = tensor.broadcast_shape(
    tensor.dims(left), tensor.dims(right)
  )
  if !tensor.broadcastable(tensor.dims(left), shape) ||
     !tensor.broadcastable(tensor.dims(right), shape) {
    return false
  }
  return set_type(m, outputs[0], shaped(tensor.elem(left), shape))
}

fn signed(data: Attr, offset: int, width: int) -> int {
  var value = base.byte(data, offset + width - 1)
  if value >= 128 {
    value -= 256
  }
  for reverse in 1..width {
    value = value * 256 + base.byte(data, offset + width - reverse - 1)
  }
  return value
}

fn const_ints(value: Val) -> list<int> {
  var out: list<int> = []
  let type = ir.type(value)
  if !tensor.valid(type) {
    return out
  }
  var width = 0
  if tensor.elem(type) == ty("i32") {
    width = 4
  }
  if tensor.elem(type) == ty("i64") {
    width = 8
  }
  if width == 0 {
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) || ir.callee(producer) != "onnx.tensor" {
    return out
  }
  let inputs = ir.args(producer)
  if len(inputs) != 3 || !ir.is_const(inputs[2]) {
    return out
  }
  let data = ir.constant(inputs[2])
  if base.size(data) % width != 0 {
    return out
  }
  for i in 0..base.size(data) / width {
    out += [signed(data, i * width, width)]
  }
  return out
}

fn shape_terms(value: Val) -> list<Ty> {
  var out: list<Ty> = []
  let literal = const_ints(value)
  if len(literal) != 0 {
    for item in literal {
      out += [ty(item)]
    }
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let inputs = ir.args(producer)
  if ir.callee(producer) == "onnx.Shape" && len(inputs) == 1 {
    let input = ir.type(inputs[0])
    if tensor.valid(input) {
      return tensor.dims(input)
    }
  }
  if (ir.callee(producer) == "onnx.Cast" ||
      ir.callee(producer) == "onnx.Identity" ||
      ir.callee(producer) == "onnx.Squeeze" ||
      ir.callee(producer) == "onnx.Unsqueeze") && len(inputs) >= 1 {
    return shape_terms(inputs[0])
  }
  if ir.callee(producer) == "onnx.Gather" && len(inputs) == 2 &&
     base.get(attrs(producer), "axis", 0) == 0 {
    let source = shape_terms(inputs[0])
    let indices = const_ints(inputs[1])
    if len(source) == 0 || len(indices) == 0 {
      return out
    }
    for raw in indices {
      var index = raw
      if index < 0 {
        index += len(source)
      }
      if index < 0 || index >= len(source) {
        return []
      }
      out += [source[index]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Slice" &&
     len(inputs) >= 3 && len(inputs) <= 5 {
    let source = shape_terms(inputs[0])
    let starts = const_ints(inputs[1])
    let ends = const_ints(inputs[2])
    var axes: list<int> = [0]
    var steps: list<int> = [1]
    if len(inputs) >= 4 {
      axes = const_ints(inputs[3])
    }
    if len(inputs) == 5 {
      steps = const_ints(inputs[4])
    }
    if len(source) == 0 || len(starts) != 1 || len(ends) != 1 ||
       len(axes) != 1 || len(steps) != 1 || axes[0] != 0 ||
       steps[0] != 1 {
      return out
    }
    var first = starts[0]
    var last = ends[0]
    if first < 0 {
      first += len(source)
    }
    if last < 0 {
      last += len(source)
    }
    if first < 0 {
      first = 0
    }
    if last > len(source) {
      last = len(source)
    }
    if first > last || first >= len(source) {
      return out
    }
    for i in first..last {
      out += [source[i]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Concat" &&
     base.get(attrs(producer), "axis", 0) == 0 {
    for input in inputs {
      let part = shape_terms(input)
      if len(part) == 0 {
        return []
      }
      out += part
    }
    return out
  }
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.dims(type)
    var count = -1
    if len(shape) == 0 {
      count = 1
    }
    if len(shape) == 1 && kind(shape[0]) == "int" {
      count = int(shape[0])
    }
    if count >= 0 {
      for i in 0..count {
        out += [ty("_")]
      }
    }
  }
  return out
}

fn element(code: int) -> Ty {
  var out = ty("_")
  if code == 1 {
    out = ty("f32")
  }
  if code == 2 {
    out = ty("u8")
  }
  if code == 3 {
    out = ty("i8")
  }
  if code == 4 {
    out = ty("u16")
  }
  if code == 5 {
    out = ty("i16")
  }
  if code == 6 {
    out = ty("i32")
  }
  if code == 7 {
    out = ty("i64")
  }
  if code == 9 {
    out = ty("bool")
  }
  if code == 10 {
    out = ty("f16")
  }
  if code == 11 {
    out = ty("f64")
  }
  if code == 12 {
    out = ty("u32")
  }
  if code == 13 {
    out = ty("u64")
  }
  if code == 16 {
    out = ty("bf16")
  }
  return out
}

fn cast_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let elem = element(base.get(attrs(op), "to", 0))
  if !tensor.valid(input) || elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, tensor.dims(input)))
}

fn shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  let rank = len(tensor.dims(ir.type(inputs[0])))
  let shape: list<Ty> = [ty(rank)]
  return set_type(m, outputs[0], shaped(ty("i64"), shape))
}

fn gather_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let data = ir.type(inputs[0])
  let indices = ir.type(inputs[1])
  if !tensor.valid(data) || !tensor.valid(indices) {
    return ty("_")
  }
  let shape = tensor.dims(data)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return ty("_")
  }
  return shaped(
    tensor.elem(data), tensor.gathered(shape, tensor.dims(indices), axis)
  )
}

fn gather_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], gather_result(op))
}

fn axes(op: Op) -> list<int> {
  let meta = attrs(op)
  var out: list<int> = []
  if base.has(meta, "axes") {
    for axis in meta["axes"] {
      out += [axis]
    }
    return out
  }
  let inputs = ir.args(op)
  if len(inputs) >= 2 {
    return const_ints(inputs[1])
  }
  return out
}

fn unsqueeze_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 && len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let raw = axes(op)
  let rank = len(source) + len(raw)
  var normalized: list<int> = []
  for value in raw {
    var axis = value
    if axis < 0 {
      axis += rank
    }
    normalized += [axis]
  }
  if !tensor.valid_axes(normalized, rank) {
    return ty("_")
  }
  var shape: list<Ty> = []
  var source_axis = 0
  for axis in 0..rank {
    var selected = false
    for value in normalized {
      if value == axis {
        selected = true
      }
    }
    if selected {
      shape += [ty(1)]
    } else {
      shape += [source[source_axis]]
      source_axis += 1
    }
  }
  return shaped(tensor.elem(input), shape)
}

fn squeeze_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 && len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let raw = axes(op)
  var normalized: list<int> = []
  if len(raw) == 0 {
    for axis in 0..len(source) {
      if source[axis] == ty(1) {
        normalized += [axis]
      }
    }
  } else {
    for value in raw {
      var axis = value
      if axis < 0 {
        axis += len(source)
      }
      normalized += [axis]
    }
  }
  if !tensor.valid_axes(normalized, len(source)) {
    return ty("_")
  }
  var shape: list<Ty> = []
  for axis in 0..len(source) {
    var selected = false
    for value in normalized {
      if value == axis {
        selected = true
      }
    }
    if selected {
      if source[axis] != ty(1) {
        return ty("_")
      }
    } else {
      shape += [source[axis]]
    }
  }
  return shaped(tensor.elem(input), shape)
}

fn unary_shape_type(m: Mod, op: Op, squeeze: bool) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  var result = unsqueeze_result(op)
  if squeeze {
    result = squeeze_result(op)
  }
  return set_type(m, outputs[0], result)
}

fn slice_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 3 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let values = shape_terms(outputs[0])
  if !tensor.valid(input) || len(tensor.dims(input)) != 1 ||
     len(values) == 0 {
    return false
  }
  let shape: list<Ty> = [ty(len(values))]
  return set_type(m, outputs[0], shaped(tensor.elem(input), shape))
}

fn concat_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) == 0 {
    return ty("_")
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) {
    return ty("_")
  }
  let source = tensor.dims(first)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(source)
  }
  if axis < 0 || axis >= len(source) {
    return ty("_")
  }
  var extent = 0
  for input in inputs {
    let type = ir.type(input)
    if !tensor.valid(type) || tensor.elem(type) != tensor.elem(first) ||
       len(tensor.dims(type)) != len(source) {
      return ty("_")
    }
    let shape = tensor.dims(type)
    for dim in 0..len(source) {
      if dim != axis && shape[dim] != source[dim] {
        return ty("_")
      }
    }
    if kind(shape[axis]) != "int" {
      return ty("_")
    }
    extent += int(shape[axis])
  }
  var shape: list<Ty> = []
  for dim in 0..len(source) {
    if dim == axis {
      shape += [ty(extent)]
    } else {
      shape += [source[dim]]
    }
  }
  return shaped(tensor.elem(first), shape)
}

fn concat_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], concat_result(op))
}

fn split_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 1 && len(inputs) != 2) || len(outputs) == 0 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return false
  }
  var sizes: list<int> = []
  if len(inputs) == 2 {
    sizes = const_ints(inputs[1])
  } else {
    let meta = attrs(op)
    if base.has(meta, "split") {
      for size in meta["split"] {
        sizes += [size]
      }
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) == "int" &&
     int(shape[axis]) % len(outputs) == 0 {
    let size = int(shape[axis]) / len(outputs)
    for output in outputs {
      sizes += [size]
    }
  }
  if len(sizes) != len(outputs) {
    return false
  }
  var total = 0
  for size in sizes {
    if size < 0 {
      return false
    }
    total += size
  }
  if kind(shape[axis]) == "int" && total != int(shape[axis]) {
    return false
  }
  var changed = false
  for i in 0..len(outputs) {
    changed = set_type(
      m, outputs[i], shaped(
        tensor.elem(input), tensor.replaced(shape, axis, ty(sizes[i]))
      )
    ) || changed
  }
  return changed
}

fn one_hot_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let indices = ir.type(inputs[0])
  let values = ir.type(inputs[2])
  let depth = const_ints(inputs[1])
  if !tensor.valid(indices) || !tensor.valid(values) || len(depth) != 1 ||
     depth[0] <= 0 {
    return false
  }
  let value_shape = tensor.dims(values)
  if len(value_shape) != 1 || value_shape[0] != ty(2) {
    return false
  }
  let source = tensor.dims(indices)
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(source) + 1
  }
  if axis < 0 || axis > len(source) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(
      tensor.elem(values), tensor.inserted(source, axis, ty(depth[0]))
    )
  )
}

fn dynamic_quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 3 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var changed = set_type(
    m, outputs[0], shaped(ty("u8"), shape)
  )
  changed = set_type(
    m, outputs[1], ty("tensor<f32, []>")
  ) || changed
  changed = set_type(
    m, outputs[2], ty("tensor<u8, []>")
  ) || changed
  return changed
}

fn constant_shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let shape = shape_terms(inputs[0])
  if len(shape) == 0 {
    return false
  }
  var elem = ty("f32")
  let meta = attrs(op)
  if base.has(meta, "value") {
    elem = element(base.get(meta["value"], "type", 1))
  }
  if elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, shape))
}

fn reshape_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let source = tensor.dims(input)
  let requested = shape_terms(inputs[1])
  if len(requested) == 0 {
    return ty("_")
  }
  let allowzero = base.get(attrs(op), "allowzero", 0)
  if allowzero != 0 && allowzero != 1 {
    return ty("_")
  }
  var inferred = -1
  var factors: list<Ty> = []
  for i in 0..len(requested) {
    if kind(requested[i]) == "int" {
      let extent = int(requested[i])
      if extent == -1 {
        if inferred != -1 {
          return ty("_")
        }
        inferred = i
      } else {
        if extent == 0 && allowzero == 0 {
          if i >= len(source) {
            return ty("_")
          }
          factors += [source[i]]
        } else {
          if extent >= 0 {
            factors += [requested[i]]
          } else {
            return ty("_")
          }
        }
      }
    } else {
      factors += [requested[i]]
    }
  }
  var missing = ty("_")
  if inferred != -1 {
    let source_total = tensor.product(source, 0, len(source))
    let factor_total = tensor.product(factors, 0, len(factors))
    if kind(source_total) == "int" && kind(factor_total) == "int" &&
       (int(factor_total) <= 0 ||
        int(source_total) % int(factor_total) != 0) {
      return ty("_")
    }
    missing = tensor.quotient(source, factors)
  }
  var shape: list<Ty> = []
  for i in 0..len(requested) {
    if kind(requested[i]) == "int" && int(requested[i]) == -1 {
      shape += [missing]
    } else {
      if kind(requested[i]) == "int" &&
         int(requested[i]) == 0 && allowzero == 0 {
        shape += [source[i]]
      } else {
        shape += [requested[i]]
      }
    }
  }
  let source_total = tensor.product(source, 0, len(source))
  let result_total = tensor.product(shape, 0, len(shape))
  if kind(source_total) == "int" && kind(result_total) == "int" &&
     source_total != result_total {
    return ty("_")
  }
  return shaped(tensor.elem(input), shape)
}

fn reshape_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reshape_result(op))
}

fn flattened(input: Ty, axis: int) -> Ty {
  let dims = tensor.dims(input)
  let outer = tensor.product(dims, 0, axis)
  let inner = tensor.product(dims, axis, len(dims))
  if outer == ty("_") || inner == ty("_") {
    return ty("_")
  }
  let shape: list<Ty> = [outer, inner]
  return shaped(tensor.elem(input), shape)
}

fn infer_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let result = flattened(input, axis)
  if result == ty("_") {
    return false
  }
  return set_type(m, outputs[0], result)
}

fn matmul_shape(
  left: Ty, right: Ty, transpose_left: bool, transpose_right: bool
) -> list<Ty> {
  var none: list<Ty> = []
  if !tensor.valid(left) || !tensor.valid(right) {
    return none
  }
  let ls = tensor.dims(left)
  let rs = tensor.dims(right)
  if len(ls) < 2 || len(rs) < 2 {
    return none
  }
  var rows = ls[len(ls) - 2]
  var left_depth = ls[len(ls) - 1]
  var right_depth = rs[len(rs) - 2]
  var columns = rs[len(rs) - 1]
  if transpose_left {
    rows = ls[len(ls) - 1]
    left_depth = ls[len(ls) - 2]
  }
  if transpose_right {
    right_depth = rs[len(rs) - 1]
    columns = rs[len(rs) - 2]
  }
  if left_depth != right_depth {
    return none
  }
  var left_batch: list<Ty> = []
  var right_batch: list<Ty> = []
  for i in 0..len(ls) - 2 {
    left_batch += [ls[i]]
  }
  for i in 0..len(rs) - 2 {
    right_batch += [rs[i]]
  }
  var shape: list<Ty> = []
  if len(left_batch) == 0 {
    shape = right_batch
  } else {
    if len(right_batch) == 0 {
      shape = left_batch
    } else {
      shape = tensor.broadcast_shape(left_batch, right_batch)
    }
  }
  if len(left_batch) != 0 {
    if !tensor.broadcastable(left_batch, shape) {
      return none
    }
  }
  if len(right_batch) != 0 {
    if !tensor.broadcastable(right_batch, shape) {
      return none
    }
  }
  shape += [rows, columns]
  return shape
}

fn matmul_shape(left: Ty, right: Ty) -> list<Ty> {
  return matmul_shape(left, right, false, false)
}

fn matmul_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return ty("_")
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return ty("_")
  }
  return shaped(tensor.elem(left), shape)
}

fn matmul_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], matmul_result(op))
}

fn integer_matmul_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 4 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) {
    return false
  }
  let le = tensor.elem(left)
  let re = tensor.elem(right)
  if (le != ty("i8") && le != ty("u8")) ||
     (re != ty("i8") && re != ty("u8")) {
    return false
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 {
    return false
  }
  return set_type(m, outputs[0], shaped(ty("i32"), shape))
}

fn fused_matmul_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     tensor.elem(left) != tensor.elem(right) {
    return false
  }
  let meta = attrs(op)
  let trans_a = base.get(meta, "transA", 0)
  let trans_b = base.get(meta, "transB", 0)
  if (trans_a != 0 && trans_a != 1) ||
     (trans_b != 0 && trans_b != 1) ||
     base.get(meta, "transBatchA", 0) != 0 ||
     base.get(meta, "transBatchB", 0) != 0 {
    return false
  }
  let shape = matmul_shape(left, right, trans_a == 1, trans_b == 1)
  if len(shape) == 0 {
    return false
  }
  return set_type(m, outputs[0], shaped(tensor.elem(left), shape))
}

fn transpose_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "perm") {
    for axis in meta["perm"] {
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [rank - axis - 1]
    }
  }
  return axes
}

fn transpose_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  return set_type(
    m, outputs[0], shaped(
      tensor.elem(input), tensor.permuted(shape, axes)
    )
  )
}

fn reduce_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "axes") {
    for value in meta["axes"] {
      var axis = value
      if axis < 0 {
        axis += rank
      }
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [axis]
    }
  }
  return axes
}

fn reduce_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let shape = tensor.dims(input)
  let axes = reduce_axes(op, len(shape))
  if !tensor.valid_axes(axes, len(shape)) {
    return ty("_")
  }
  let keep = base.get(attrs(op), "keepdims", 1)
  if keep != 0 && keep != 1 {
    return ty("_")
  }
  return shaped(
    tensor.elem(input), tensor.reduced(shape, axes, keep == 1)
  )
}

fn reduce_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reduce_result(op))
}

fn positive(dim: Ty) -> bool {
  return kind(dim) == "int" && int(dim) > 0
}

fn conv_inputs(x: Ty, weight: Ty, bias: Ty, groups: int) -> bool {
  if !tensor.valid(x) || !tensor.valid(weight) || groups <= 0 {
    return false
  }
  if tensor.elem(x) != tensor.elem(weight) {
    return false
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if len(xs) != 4 || len(ws) != 4 {
    return false
  }
  if groups == 1 {
    if xs[1] != ws[1] {
      return false
    }
  } else {
    if !positive(xs[1]) || !positive(ws[1]) ||
       int(xs[1]) != int(ws[1]) * groups {
      return false
    }
  }
  if bias != ty("_") {
    if !tensor.valid(bias) || tensor.elem(bias) != tensor.elem(x) {
      return false
    }
    let bs = tensor.dims(bias)
    if len(bs) != 1 || bs[0] != ws[0] {
      return false
    }
  }
  return true
}

fn conv_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 && len(inputs) != 3 {
    return ty("_")
  }
  let x = ir.type(inputs[0])
  let weight = ir.type(inputs[1])
  var bias = ty("_")
  if len(inputs) == 3 {
    bias = ir.type(inputs[2])
  }
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  if !conv_inputs(x, weight, bias, groups) {
    return ty("_")
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if !positive(xs[2]) || !positive(xs[3]) ||
     !positive(ws[2]) || !positive(ws[3]) {
    return ty("_")
  }
  if base.get(meta, "auto_pad", "NOTSET") != "NOTSET" {
    return ty("_")
  }
  let stride = base.get(meta, "strides", [1, 1])
  let pad = base.get(meta, "pads", [0, 0, 0, 0])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(stride) != 2 || len(pad) != 4 || len(dilation) != 2 {
    return ty("_")
  }
  if stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return ty("_")
  }
  let h = (int(xs[2]) + pad[0] + pad[2] -
           dilation[0] * (int(ws[2]) - 1) - 1) /
          stride[0] + 1
  let w = (int(xs[3]) + pad[1] + pad[3] -
           dilation[1] * (int(ws[3]) - 1) - 1) /
          stride[1] + 1
  if h <= 0 || w <= 0 {
    return ty("_")
  }
  let shape: list<Ty> = [xs[0], ws[0], ty(h), ty(w)]
  return shaped(tensor.elem(x), shape)
}

fn conv_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], conv_result(op))
}

fn global_pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(1), ty(1)]
  return set_type(
    m, outputs[0], shaped(tensor.elem(x), result)
  )
}

fn pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 || !positive(shape[2]) || !positive(shape[3]) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "auto_pad", "NOTSET") != "NOTSET" ||
     !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let pad = base.get(meta, "pads", [0, 0, 0, 0])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(kernel) != 2 || len(stride) != 2 || len(pad) != 4 ||
     len(dilation) != 2 {
    return false
  }
  if kernel[0] <= 0 || kernel[1] <= 0 ||
     stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return false
  }
  let h = (int(shape[2]) + pad[0] + pad[2] -
           dilation[0] * (kernel[0] - 1) - 1) / stride[0] + 1
  let w = (int(shape[3]) + pad[1] + pad[3] -
           dilation[1] * (kernel[1] - 1) - 1) / stride[1] + 1
  if h <= 0 || w <= 0 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(h), ty(w)]
  return set_type(
    m, outputs[0], shaped(tensor.elem(x), result)
  )
}

fn infer(m: Mod) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.callee(op) == "onnx.QuantizeLinear" {
      changed = quant_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.DequantizeLinear" {
      changed = dequant_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.DynamicQuantizeLinear" {
      changed = dynamic_quant_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.ConstantOfShape" {
      changed = constant_shape_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Conv" {
      changed = conv_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.BatchNormalization" ||
       ir.callee(op) == "onnx.Relu" ||
       ir.callee(op) == "onnx.Softmax" ||
       ir.callee(op) == "onnx.Sqrt" ||
       ir.callee(op) == "onnx.Reciprocal" ||
       ir.callee(op) == "onnx.Tanh" ||
       ir.callee(op) == "onnx.Identity" {
      changed = same_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Add" || ir.callee(op) == "onnx.Sub" ||
       ir.callee(op) == "onnx.Mul" || ir.callee(op) == "onnx.Div" ||
       ir.callee(op) == "onnx.Pow" {
      changed = binary_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Flatten" {
      changed = infer_flatten(m, op) || changed
    }
    if ir.callee(op) == "onnx.Reshape" {
      changed = reshape_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Cast" {
      changed = cast_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Shape" {
      changed = shape_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Gather" {
      changed = gather_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Unsqueeze" {
      changed = unary_shape_type(m, op, false) || changed
    }
    if ir.callee(op) == "onnx.Squeeze" {
      changed = unary_shape_type(m, op, true) || changed
    }
    if ir.callee(op) == "onnx.Slice" {
      changed = slice_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Concat" {
      changed = concat_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Split" {
      changed = split_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.OneHot" {
      changed = one_hot_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.MatMul" {
      changed = matmul_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.MatMulInteger" {
      changed = integer_matmul_type(m, op) || changed
    }
    if ir.callee(op) == "com_microsoft.FusedMatMul" {
      changed = fused_matmul_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Transpose" {
      changed = transpose_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.ReduceMean" {
      changed = reduce_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.GlobalAveragePool" {
      changed = global_pool_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.AveragePool" ||
       ir.callee(op) == "onnx.MaxPool" {
      changed = pool_type(m, op) || changed
    }
  }
  return changed
}

fn ints(m: Mod, before: Op, value: Attr) -> Val {
  var items: list<Val> = []
  for item in value {
    items += [ir.constant(m, before, item, "int")]
  }
  return ir.call(m, before, "base.list", items, "list<int>")
}

fn convert_call(m: Mod, op: Op, callee: str) -> bool {
  if !ir.retarget(m, op, callee, ir.args(op)) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

fn convert_call(
  m: Mod, op: Op, callee: str, inputs: list<Val>
) -> bool {
  if !ir.retarget(m, op, callee, inputs) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

fn convert_unary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) || ir.type(outputs[0]) != input {
    return false
  }
  return convert_call(m, op, callee)
}

fn convert_conv(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let biased = len(inputs) == 3
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  let expected = conv_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  inputs += [ints(m, op, base.get(meta, "strides", [1, 1]))]
  inputs += [ints(m, op, base.get(meta, "pads", [0, 0, 0, 0]))]
  inputs += [ints(m, op, base.get(meta, "dilations", [1, 1]))]
  inputs += [ir.constant(m, op, groups, "int")]
  if biased {
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ir.constant(m, op, "NONE", "str")]
  }
  return convert_call(m, op, "nn.conv2d", inputs)
}

fn convert_norm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 5 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "spatial", 1) != 1 {
    return false
  }
  inputs += [
    ir.constant(m, op, base.get(meta, "epsilon", 0.00001), "f64")
  ]
  return convert_call(m, op, "nn.batch_norm", inputs)
}

fn convert_softmax(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) {
    return false
  }
  let type = ir.type(inputs[0])
  if !tensor.valid(type) {
    return false
  }
  let rank = len(tensor.dims(type))
  let meta = attrs(op)
  if rank == 0 || !base.has(meta, "axis") {
    return false
  }
  var axis = meta["axis"]
  if axis < 0 {
    axis += rank
  }
  if axis < 0 || axis >= rank {
    return false
  }
  inputs += [ir.constant(m, op, axis, "int")]
  inputs += [ir.constant(m, op, 1.0, "f64")]
  return convert_call(m, op, "nn.softmax", inputs)
}

fn convert_reshape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let expected = reshape_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape", [inputs[0]])
}

fn convert_binary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  let result = ir.type(outputs[0])
  if !tensor.valid(left) || !tensor.valid(right) ||
     !tensor.valid(result) {
    return false
  }
  if tensor.elem(left) != tensor.elem(right) ||
     tensor.elem(left) != tensor.elem(result) {
    return false
  }
  var left_ok = len(tensor.dims(left)) == 0
  var right_ok = len(tensor.dims(right)) == 0
  if !left_ok {
    left_ok = tensor.broadcastable(
      tensor.dims(left), tensor.dims(result)
    )
  }
  if !right_ok {
    right_ok = tensor.broadcastable(
      tensor.dims(right), tensor.dims(result)
    )
  }
  if !left_ok || !right_ok {
    return false
  }
  return convert_call(m, op, callee)
}

fn convert_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let expected = flattened(input, axis)
  if expected == ty("_") || result != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape")
}

fn convert_matmul(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  let expected = matmul_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.matmul")
}

fn convert_transpose(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  if result != shaped(tensor.elem(input), tensor.permuted(shape, axes)) {
    return false
  }
  inputs += [ints(m, op, axes)]
  return convert_call(m, op, "tensor.permute", inputs)
}

fn convert_mean(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let expected = reduce_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let axes = reduce_axes(op, len(tensor.dims(ir.type(inputs[0]))))
  inputs += [ints(m, op, axes)]
  return convert_call(m, op, "tensor.mean", inputs)
}

fn convert_pool(m: Mod, op: Op, callee: str) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "auto_pad", "NOTSET") != "NOTSET" ||
     !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  if callee == "nn.avg_pool2d" &&
     base.get(meta, "count_include_pad", 0) != 0 {
    return false
  }
  if callee == "nn.max_pool2d" &&
     base.get(meta, "storage_order", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let pad = base.get(meta, "pads", [0, 0, 0, 0])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(kernel) != 2 || len(stride) != 2 || len(pad) != 4 ||
     len(dilation) != 2 {
    return false
  }
  inputs += [ints(m, op, kernel)]
  inputs += [ints(m, op, stride)]
  inputs += [ints(m, op, pad)]
  inputs += [ints(m, op, dilation)]
  inputs += [ints(m, op, [0, 1, 2, 3])]
  return convert_call(m, op, callee, inputs)
}

fn convert(m: Mod) -> bool {
  var changed = ir.use(m, "nn")
  for op in ir.ops(m) {
    if ir.callee(op) == "onnx.Conv" {
      changed = convert_conv(m, op) || changed
    }
    if ir.callee(op) == "onnx.BatchNormalization" {
      changed = convert_norm(m, op) || changed
    }
    if ir.callee(op) == "onnx.Softmax" {
      changed = convert_softmax(m, op) || changed
    }
    if ir.callee(op) == "onnx.Relu" {
      changed = convert_unary(m, op, "nn.relu") || changed
    }
    if ir.callee(op) == "onnx.Add" {
      changed = convert_binary(m, op, "nn.add") || changed
    }
    if ir.callee(op) == "onnx.Sub" {
      changed = convert_binary(m, op, "nn.sub") || changed
    }
    if ir.callee(op) == "onnx.Mul" {
      changed = convert_binary(m, op, "nn.mul") || changed
    }
    if ir.callee(op) == "onnx.Div" {
      changed = convert_binary(m, op, "nn.div") || changed
    }
    if ir.callee(op) == "onnx.Pow" {
      changed = convert_binary(m, op, "nn.pow") || changed
    }
    if ir.callee(op) == "onnx.Sqrt" {
      changed = convert_unary(m, op, "nn.sqrt") || changed
    }
    if ir.callee(op) == "onnx.Reciprocal" {
      changed = convert_unary(m, op, "nn.recip") || changed
    }
    if ir.callee(op) == "onnx.Tanh" {
      changed = convert_unary(m, op, "nn.tanh") || changed
    }
    if ir.callee(op) == "onnx.Flatten" {
      changed = convert_flatten(m, op) || changed
    }
    if ir.callee(op) == "onnx.MatMul" {
      changed = convert_matmul(m, op) || changed
    }
    if ir.callee(op) == "onnx.Transpose" {
      changed = convert_transpose(m, op) || changed
    }
    if ir.callee(op) == "onnx.ReduceMean" {
      changed = convert_mean(m, op) || changed
    }
    if ir.callee(op) == "onnx.GlobalAveragePool" {
      changed = convert_call(m, op, "nn.global_avg_pool2d") || changed
    }
    if ir.callee(op) == "onnx.AveragePool" {
      changed = convert_pool(m, op, "nn.avg_pool2d") || changed
    }
    if ir.callee(op) == "onnx.MaxPool" {
      changed = convert_pool(m, op, "nn.max_pool2d") || changed
    }
    if ir.callee(op) == "onnx.Reshape" {
      changed = convert_reshape(m, op) || changed
    }
  }
  return changed
}
