module onnx.nn
use onnx
use nn
use ir

fn set_type(m: Mod, value: Val, type: Ty) -> bool {
  if type == ty("_") {
    return false
  }
  if ir.type(value) != type {
    return ir.type(m, value, type)
  }
  return false
}

fn attrs(op: Op) -> Attr {
  return base.get(ir.meta(op), "onnx", {})
}

fn same_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 0 && len(outputs) == 1 {
    let type = ir.type(inputs[0])
    if tensor.valid(type) {
      return set_type(m, outputs[0], type)
    }
  }
  return false
}

fn quant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  var elem = ty("u8")
  if len(inputs) == 3 {
    let zero = ir.type(inputs[2])
    if !tensor.valid(zero) {
      return false
    }
    elem = tensor.elem(zero)
  }
  return set_type(m, outputs[0], tensor.type(elem, tensor.dims(input)))
}

fn dequant_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  if !tensor.valid(input) || !tensor.valid(scale) {
    return false
  }
  return set_type(
    m, outputs[0], tensor.type(tensor.elem(scale), tensor.dims(input))
  )
}

fn binary_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) {
    return false
  }
  if tensor.elem(left) != tensor.elem(right) {
    return false
  }
  let shape = tensor.broadcast_shape(
    tensor.dims(left), tensor.dims(right)
  )
  if !tensor.broadcastable(tensor.dims(left), shape) ||
     !tensor.broadcastable(tensor.dims(right), shape) {
    return false
  }
  return set_type(m, outputs[0], tensor.type(tensor.elem(left), shape))
}

fn flattened(input: Ty, axis: int) -> Ty {
  let dims = tensor.dims(input)
  let outer = tensor.product(dims, 0, axis)
  let inner = tensor.product(dims, axis, len(dims))
  if outer == ty("_") || inner == ty("_") {
    return ty("_")
  }
  let shape: list<Ty> = [outer, inner]
  return tensor.type(tensor.elem(input), shape)
}

fn infer_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let result = flattened(input, axis)
  if result == ty("_") {
    return false
  }
  return set_type(m, outputs[0], result)
}

fn matmul_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 {
    return ty("_")
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) {
    return ty("_")
  }
  if tensor.elem(left) != tensor.elem(right) {
    return ty("_")
  }
  let ls = tensor.dims(left)
  let rs = tensor.dims(right)
  if len(ls) < 2 || len(rs) < 2 {
    return ty("_")
  }
  if ls[len(ls) - 1] != rs[len(rs) - 2] {
    return ty("_")
  }
  var left_batch: list<Ty> = []
  var right_batch: list<Ty> = []
  for i in 0..len(ls) - 2 {
    left_batch += [ls[i]]
  }
  for i in 0..len(rs) - 2 {
    right_batch += [rs[i]]
  }
  var shape: list<Ty> = []
  if len(left_batch) != 0 || len(right_batch) != 0 {
    shape = tensor.broadcast_shape(left_batch, right_batch)
    if !tensor.broadcastable(left_batch, shape) ||
       !tensor.broadcastable(right_batch, shape) {
      return ty("_")
    }
  }
  shape += [ls[len(ls) - 2], rs[len(rs) - 1]]
  return tensor.type(tensor.elem(left), shape)
}

fn matmul_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], matmul_result(op))
}

fn transpose_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "perm") {
    for axis in meta["perm"] {
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [rank - axis - 1]
    }
  }
  return axes
}

fn transpose_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  return set_type(
    m, outputs[0], tensor.type(
      tensor.elem(input), tensor.permuted(shape, axes)
    )
  )
}

fn reduce_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  if base.has(meta, "axes") {
    for value in meta["axes"] {
      var axis = value
      if axis < 0 {
        axis += rank
      }
      axes += [axis]
    }
  } else {
    for axis in 0..rank {
      axes += [axis]
    }
  }
  return axes
}

fn reduce_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 1 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let shape = tensor.dims(input)
  let axes = reduce_axes(op, len(shape))
  if !tensor.valid_axes(axes, len(shape)) {
    return ty("_")
  }
  let keep = base.get(attrs(op), "keepdims", 1)
  if keep != 0 && keep != 1 {
    return ty("_")
  }
  return tensor.type(
    tensor.elem(input), tensor.reduced(shape, axes, keep == 1)
  )
}

fn reduce_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reduce_result(op))
}

fn positive(dim: Ty) -> bool {
  return kind(dim) == "int" && int(dim) > 0
}

fn conv_inputs(x: Ty, weight: Ty, bias: Ty, groups: int) -> bool {
  if !tensor.valid(x) || !tensor.valid(weight) || groups <= 0 {
    return false
  }
  if tensor.elem(x) != tensor.elem(weight) {
    return false
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if len(xs) != 4 || len(ws) != 4 {
    return false
  }
  if groups == 1 {
    if xs[1] != ws[1] {
      return false
    }
  } else {
    if !positive(xs[1]) || !positive(ws[1]) ||
       int(xs[1]) != int(ws[1]) * groups {
      return false
    }
  }
  if bias != ty("_") {
    if !tensor.valid(bias) || tensor.elem(bias) != tensor.elem(x) {
      return false
    }
    let bs = tensor.dims(bias)
    if len(bs) != 1 || bs[0] != ws[0] {
      return false
    }
  }
  return true
}

fn conv_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) != 2 && len(inputs) != 3 {
    return ty("_")
  }
  let x = ir.type(inputs[0])
  let weight = ir.type(inputs[1])
  var bias = ty("_")
  if len(inputs) == 3 {
    bias = ir.type(inputs[2])
  }
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  if !conv_inputs(x, weight, bias, groups) {
    return ty("_")
  }
  let xs = tensor.dims(x)
  let ws = tensor.dims(weight)
  if !positive(xs[2]) || !positive(xs[3]) ||
     !positive(ws[2]) || !positive(ws[3]) {
    return ty("_")
  }
  if base.get(meta, "auto_pad", "NOTSET") != "NOTSET" {
    return ty("_")
  }
  let stride = base.get(meta, "strides", [1, 1])
  let pad = base.get(meta, "pads", [0, 0, 0, 0])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(stride) != 2 || len(pad) != 4 || len(dilation) != 2 {
    return ty("_")
  }
  if stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return ty("_")
  }
  let h = (int(xs[2]) + pad[0] + pad[2] -
           dilation[0] * (int(ws[2]) - 1) - 1) /
          stride[0] + 1
  let w = (int(xs[3]) + pad[1] + pad[3] -
           dilation[1] * (int(ws[3]) - 1) - 1) /
          stride[1] + 1
  if h <= 0 || w <= 0 {
    return ty("_")
  }
  let shape: list<Ty> = [xs[0], ws[0], ty(h), ty(w)]
  return tensor.type(tensor.elem(x), shape)
}

fn conv_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], conv_result(op))
}

fn global_pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(1), ty(1)]
  return set_type(
    m, outputs[0], tensor.type(tensor.elem(x), result)
  )
}

fn pool_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let x = ir.type(inputs[0])
  if !tensor.valid(x) {
    return false
  }
  let shape = tensor.dims(x)
  if len(shape) != 4 || !positive(shape[2]) || !positive(shape[3]) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "auto_pad", "NOTSET") != "NOTSET" ||
     !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let pad = base.get(meta, "pads", [0, 0, 0, 0])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(kernel) != 2 || len(stride) != 2 || len(pad) != 4 ||
     len(dilation) != 2 {
    return false
  }
  if kernel[0] <= 0 || kernel[1] <= 0 ||
     stride[0] <= 0 || stride[1] <= 0 ||
     dilation[0] <= 0 || dilation[1] <= 0 {
    return false
  }
  let h = (int(shape[2]) + pad[0] + pad[2] -
           dilation[0] * (kernel[0] - 1) - 1) / stride[0] + 1
  let w = (int(shape[3]) + pad[1] + pad[3] -
           dilation[1] * (kernel[1] - 1) - 1) / stride[1] + 1
  if h <= 0 || w <= 0 {
    return false
  }
  let result: list<Ty> = [shape[0], shape[1], ty(h), ty(w)]
  return set_type(
    m, outputs[0], tensor.type(tensor.elem(x), result)
  )
}

fn infer(m: Mod) -> bool {
  var changed = false
  for op in ir.ops(m) {
    if ir.callee(op) == "onnx.QuantizeLinear" {
      changed = quant_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.DequantizeLinear" {
      changed = dequant_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Conv" {
      changed = conv_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.BatchNormalization" ||
       ir.callee(op) == "onnx.Relu" ||
       ir.callee(op) == "onnx.Softmax" ||
       ir.callee(op) == "onnx.Sqrt" ||
       ir.callee(op) == "onnx.Reciprocal" ||
       ir.callee(op) == "onnx.Tanh" {
      changed = same_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Add" || ir.callee(op) == "onnx.Sub" ||
       ir.callee(op) == "onnx.Mul" || ir.callee(op) == "onnx.Div" ||
       ir.callee(op) == "onnx.Pow" {
      changed = binary_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Flatten" {
      changed = infer_flatten(m, op) || changed
    }
    if ir.callee(op) == "onnx.MatMul" {
      changed = matmul_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.Transpose" {
      changed = transpose_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.ReduceMean" {
      changed = reduce_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.GlobalAveragePool" {
      changed = global_pool_type(m, op) || changed
    }
    if ir.callee(op) == "onnx.AveragePool" ||
       ir.callee(op) == "onnx.MaxPool" {
      changed = pool_type(m, op) || changed
    }
  }
  return changed
}

fn ints(m: Mod, before: Op, value: Attr) -> Val {
  var items: list<Val> = []
  for item in value {
    items += [ir.constant(m, before, item, "int")]
  }
  return ir.call(m, before, "base.list", items, "list<int>")
}

fn convert_call(m: Mod, op: Op, callee: str) -> bool {
  if !ir.rename(m, op, callee) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

fn convert_unary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) || ir.type(outputs[0]) != input {
    return false
  }
  return convert_call(m, op, callee)
}

fn convert_conv(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let biased = len(inputs) == 3
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  let expected = conv_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  inputs += [ints(m, op, base.get(meta, "strides", [1, 1]))]
  inputs += [ints(m, op, base.get(meta, "pads", [0, 0, 0, 0]))]
  inputs += [ints(m, op, base.get(meta, "dilations", [1, 1]))]
  inputs += [ir.constant(m, op, groups, "int")]
  if biased {
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ir.constant(m, op, "NONE", "str")]
  }
  if !ir.args(m, op, inputs) {
    return false
  }
  return convert_call(m, op, "nn.conv2d")
}

fn convert_norm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 5 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "spatial", 1) != 1 {
    return false
  }
  inputs += [
    ir.constant(m, op, base.get(meta, "epsilon", 0.00001), "f64")
  ]
  if !ir.args(m, op, inputs) {
    return false
  }
  return convert_call(m, op, "nn.batch_norm")
}

fn convert_softmax(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) {
    return false
  }
  let type = ir.type(inputs[0])
  if !tensor.valid(type) {
    return false
  }
  let rank = len(tensor.dims(type))
  let meta = attrs(op)
  if rank == 0 || !base.has(meta, "axis") {
    return false
  }
  var axis = meta["axis"]
  if axis < 0 {
    axis += rank
  }
  if axis < 0 || axis >= rank {
    return false
  }
  inputs += [ir.constant(m, op, axis, "int")]
  inputs += [ir.constant(m, op, 1.0, "f64")]
  if !ir.args(m, op, inputs) {
    return false
  }
  return convert_call(m, op, "nn.softmax")
}

fn convert_reshape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  if !ir.args(m, op, [inputs[0]]) {
    return false
  }
  return convert_call(m, op, "tensor.reshape")
}

fn convert_binary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  let result = ir.type(outputs[0])
  if !tensor.valid(left) || !tensor.valid(right) ||
     !tensor.valid(result) {
    return false
  }
  if tensor.elem(left) != tensor.elem(right) ||
     tensor.elem(left) != tensor.elem(result) {
    return false
  }
  if !tensor.broadcastable(tensor.dims(left), tensor.dims(result)) ||
     !tensor.broadcastable(tensor.dims(right), tensor.dims(result)) {
    return false
  }
  return convert_call(m, op, callee)
}

fn convert_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let expected = flattened(input, axis)
  if expected == ty("_") || result != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape")
}

fn convert_matmul(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  let expected = matmul_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.matmul")
}

fn convert_transpose(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  if result != tensor.type(tensor.elem(input), tensor.permuted(shape, axes)) {
    return false
  }
  inputs += [ints(m, op, axes)]
  if !ir.args(m, op, inputs) {
    return false
  }
  return convert_call(m, op, "tensor.permute")
}

fn convert_mean(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let expected = reduce_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let axes = reduce_axes(op, len(tensor.dims(ir.type(inputs[0]))))
  inputs += [ints(m, op, axes)]
  if !ir.args(m, op, inputs) {
    return false
  }
  return convert_call(m, op, "tensor.mean")
}

fn convert_pool(m: Mod, op: Op, callee: str) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "auto_pad", "NOTSET") != "NOTSET" ||
     !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  if callee == "nn.avg_pool2d" &&
     base.get(meta, "count_include_pad", 0) != 0 {
    return false
  }
  if callee == "nn.max_pool2d" &&
     base.get(meta, "storage_order", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let pad = base.get(meta, "pads", [0, 0, 0, 0])
  let dilation = base.get(meta, "dilations", [1, 1])
  if len(kernel) != 2 || len(stride) != 2 || len(pad) != 4 ||
     len(dilation) != 2 {
    return false
  }
  inputs += [ints(m, op, kernel)]
  inputs += [ints(m, op, stride)]
  inputs += [ints(m, op, pad)]
  inputs += [ints(m, op, dilation)]
  inputs += [ints(m, op, [0, 1, 2, 3])]
  if !ir.args(m, op, inputs) {
    return false
  }
  return convert_call(m, op, callee)
}

fn convert(m: Mod) -> bool {
  var changed = ir.use(m, "nn")
  for op in ir.ops(m) {
    if ir.callee(op) == "onnx.Conv" {
      changed = convert_conv(m, op) || changed
    }
    if ir.callee(op) == "onnx.BatchNormalization" {
      changed = convert_norm(m, op) || changed
    }
    if ir.callee(op) == "onnx.Softmax" {
      changed = convert_softmax(m, op) || changed
    }
    if ir.callee(op) == "onnx.Relu" {
      changed = convert_unary(m, op, "nn.relu") || changed
    }
    if ir.callee(op) == "onnx.Add" {
      changed = convert_binary(m, op, "nn.add") || changed
    }
    if ir.callee(op) == "onnx.Sub" {
      changed = convert_binary(m, op, "nn.sub") || changed
    }
    if ir.callee(op) == "onnx.Mul" {
      changed = convert_binary(m, op, "nn.mul") || changed
    }
    if ir.callee(op) == "onnx.Div" {
      changed = convert_binary(m, op, "nn.div") || changed
    }
    if ir.callee(op) == "onnx.Pow" {
      changed = convert_binary(m, op, "nn.pow") || changed
    }
    if ir.callee(op) == "onnx.Sqrt" {
      changed = convert_unary(m, op, "nn.sqrt") || changed
    }
    if ir.callee(op) == "onnx.Reciprocal" {
      changed = convert_unary(m, op, "nn.recip") || changed
    }
    if ir.callee(op) == "onnx.Tanh" {
      changed = convert_unary(m, op, "nn.tanh") || changed
    }
    if ir.callee(op) == "onnx.Flatten" {
      changed = convert_flatten(m, op) || changed
    }
    if ir.callee(op) == "onnx.MatMul" {
      changed = convert_matmul(m, op) || changed
    }
    if ir.callee(op) == "onnx.Transpose" {
      changed = convert_transpose(m, op) || changed
    }
    if ir.callee(op) == "onnx.ReduceMean" {
      changed = convert_mean(m, op) || changed
    }
    if ir.callee(op) == "onnx.GlobalAveragePool" {
      changed = convert_call(m, op, "nn.global_avg_pool2d") || changed
    }
    if ir.callee(op) == "onnx.AveragePool" {
      changed = convert_pool(m, op, "nn.avg_pool2d") || changed
    }
    if ir.callee(op) == "onnx.MaxPool" {
      changed = convert_pool(m, op, "nn.max_pool2d") || changed
    }
    if ir.callee(op) == "onnx.Reshape" {
      changed = convert_reshape(m, op) || changed
    }
  }
  return changed
}
