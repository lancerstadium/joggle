module onnx.nn
use onnx
use nn
use quant
use ir

fn shape_terms(value: Val) -> list<Ty> {
  var out: list<Ty> = []
  let literal = const_ints(value)
  if len(literal) != 0 {
    for item in literal {
      out += [ty(item)]
    }
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let inputs = ir.args(producer)
  if ir.callee(producer) == "onnx.Shape" && len(inputs) == 1 {
    let input = ir.type(inputs[0])
    if tensor.valid(input) {
      return tensor.dims(input)
    }
  }
  if (ir.callee(producer) == "onnx.Cast" ||
      ir.callee(producer) == "onnx.Identity" ||
      ir.callee(producer) == "onnx.Squeeze" ||
      ir.callee(producer) == "onnx.Unsqueeze") && len(inputs) >= 1 {
    return shape_terms(inputs[0])
  }
  if ir.callee(producer) == "onnx.Gather" && len(inputs) == 2 &&
     base.get(attrs(producer), "axis", 0) == 0 {
    let source = shape_terms(inputs[0])
    let indices = const_ints(inputs[1])
    if len(source) == 0 || len(indices) == 0 {
      return out
    }
    for raw in indices {
      var index = raw
      if index < 0 {
        index += len(source)
      }
      if index < 0 || index >= len(source) {
        return []
      }
      out += [source[index]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Slice" && len(inputs) >= 1 {
    let source = shape_terms(inputs[0])
    let starts = slice_starts(producer)
    let ends = slice_ends(producer)
    let selected = slice_axes(producer)
    let steps = slice_steps(producer)
    if len(source) == 0 || len(starts) != 1 ||
       len(ends) != 1 || len(selected) != 1 || len(steps) != 1 ||
       selected[0] != 0 || steps[0] != 1 {
      return out
    }
    var first = starts[0]
    var last = ends[0]
    if first < 0 {
      first += len(source)
    }
    if last < 0 {
      last += len(source)
    }
    if first < 0 {
      first = 0
    }
    if last > len(source) {
      last = len(source)
    }
    if first > last || first >= len(source) {
      return out
    }
    for i in first..last {
      out += [source[i]]
    }
    return out
  }
  if ir.callee(producer) == "onnx.Concat" &&
     base.get(attrs(producer), "axis", 0) == 0 {
    for input in inputs {
      let part = shape_terms(input)
      if len(part) == 0 {
        return []
      }
      out += part
    }
    return out
  }
  let type = ir.type(value)
  if tensor.valid(type) {
    let shape = tensor.dims(type)
    var count = -1
    if len(shape) == 0 {
      count = 1
    }
    if len(shape) == 1 && kind(shape[0]) == "int" {
      count = int(shape[0])
    }
    if count >= 0 {
      for i in 0..count {
        out += [ty("_")]
      }
    }
  }
  return out
}

fn infer(m: Mod, rules: list<Fn>) -> bool {
  var changed = false
  var again = true
  var exhausted = false
  let limit = len(ir.ops(m)) + 1
  for round in 0..limit {
    if again {
      let before = ir.revision(m)
      infer_once(m, rules)
      again = ir.revision(m) != before
      changed = again || changed
      if round == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "onnx.nn.infer did not converge")
  return changed
}

fn infer(m: Mod) -> bool {
  return infer(m, ir.fns("onnx.nn"))
}
