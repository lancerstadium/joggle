local fn ints(m: Mod, before: Op, value: Attr) -> Val {
  var items: list<Val> = []
  for item in value {
    items += [ir.constant(m, before, item, ty("int"))]
  }
  return ir.call(m, before, "base.list", items, ty("list", [ty("int")]))
}

local fn mapped(value: Val, old: list<Val>, next: list<Val>) -> Val {
  for i in 0..len(old) {
    if value == old[i] {
      return next[i]
    }
  }
  return value
}

local fn scalar(m: Mod, before: Op, value: Val) -> Val {
  let type = ir.type(value)
  assert(tensor.valid(type) && len(tensor.dims(type)) == 0,
         "onnx.nn: scalar tensor expected")
  let zero = ir.constant(m, before, 0, ty("index"))
  return ir.call(
    m, before, "operator []", [value, zero], tensor.elem(type)
  )
}

local fn shape_value(
  m: Mod, before: Op, dims: list<Ty>, leading: Val
) -> Val {
  assert(len(dims) != 0 && dims[0] == ty("_"),
         "onnx.nn: dynamic leading dimension expected")
  let shape_type = tensor.type(ty("index"), [len(dims)])
  let zero_literal = ir.constant(m, before, 0, ty("int"))
  let zero = ir.call(m, before, "index", [zero_literal], ty("index"))
  var shape = ir.call(m, before, "tensor.tensor", [zero], shape_type)
  var shape_name = local_name(before, "shape_", 0)
  assert(ir.live(shape) && shape_name != "" &&
         ir.rename(m, shape, shape_name),
         "onnx.nn: could not create runtime shape")
  for axis in 0..len(dims) {
    var extent = leading
    if axis != 0 {
      assert(base.kind(dims[axis]) == "int" && base.int(dims[axis]) >= 0,
             "onnx.nn: dynamic trailing dimension is unsupported")
      extent = ir.constant(
        m, before, base.int(dims[axis]), ty("index")
      )
    }
    let at = ir.constant(m, before, axis, ty("index"))
    let updated = ir.call(
      m, before, "tensor.operator []=", [shape, at, extent], shape_type
    )
    shape_name = local_name(before, "shape_", axis + 1)
    assert(ir.live(updated) && shape_name != "" &&
           ir.rename(m, updated, shape_name),
           "onnx.nn: could not update runtime shape")
    shape = updated
  }
  return shape
}

local fn zero(m: Mod, before: Op, type: Ty) -> Val {
  let name = base.name(type)
  if name == "f16" || name == "bf16" || name == "f32" || name == "f64" {
    return ir.constant(m, before, 0.0, type)
  }
  if name == "bool" {
    return ir.constant(m, before, false, type)
  }
  return ir.constant(m, before, 0, type)
}

local fn local_name(before: Op, stem: str, ordinal: int) -> str {
  let owner = ir.owner(ir.blk(before))
  var attempt = ordinal
  for unused in 0..len(ir.vals(owner)) + 2 {
    let candidate = stem + text(attempt)
    var taken = false
    for value in ir.vals(owner) {
      if ir.name(value) == candidate {
        taken = true
      }
    }
    if !taken {
      return candidate
    }
    attempt += 1
  }
  return ""
}

local fn local_copy(
  m: Mod, before: Op, value: Val, stem: str, ordinal: int
) -> Val {
  let copy = ir.call(m, before, "base.copy", [value], ir.type(value))
  let name = local_name(before, stem, ordinal)
  assert(ir.live(copy) && name != "" && ir.rename(m, copy, name),
         "onnx.nn: could not create loop state")
  return copy
}

local fn scalar_tensor(
  m: Mod, before: Op, element: Ty, stem: str, ordinal: int
) -> Val {
  let value = zero(m, before, element)
  let dims: list<int> = []
  let result_type = tensor.type(element, dims)
  let result = ir.call(m, before, "tensor.tensor", [value], result_type)
  let name = local_name(before, stem, ordinal)
  assert(ir.live(result) && name != "" && ir.rename(m, result, name),
         "onnx.nn: could not create an optional scalar")
  return result
}

local fn optional_scalar(
  m: Mod, before: Op, inputs: list<Val>, position: int,
  element: Ty, stem: str, ordinal: int
) -> Val {
  if position < len(inputs) && ir.type(inputs[position]) != ty("nil") {
    return inputs[position]
  }
  return scalar_tensor(m, before, element, stem, ordinal)
}

local fn convert_call(m: Mod, op: Op, callee: str) -> bool {
  if !ir.retarget(m, op, callee, ir.args(op)) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

local fn convert_call(
  m: Mod, op: Op, callee: str, inputs: list<Val>
) -> bool {
  if !ir.retarget(m, op, callee, inputs) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

[phase: "data", on: "onnx.tensor"]
local fn convert_tensor(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 ||
     !tensor.valid(ir.type(outputs[0])) || !ir.is_const(inputs[2]) ||
     base.kind(ir.constant(inputs[2])) != "bytes" {
    return false
  }
  let data = ir.constant(inputs[2])
  if !ir.replace(m, op, data) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

[phase: "cleanup", on: "onnx.model"]
local fn convert_model(m: Mod, op: Op) -> bool {
  for candidate in ir.ops(m) {
    if ir.live(candidate) && candidate != op && ir.has(candidate, "onnx") {
      return false
    }
  }
  return ir.erase(m, op)
}

local fn carry(m: Mod, source: Val, target: Val) -> bool {
  var changed = false
  let value_name = ir.name(source)
  if value_name != "" {
    changed = ir.rename(m, target, value_name) || changed
  }
  let metadata = ir.meta(source)
  for key in base.keys(metadata) {
    changed = ir.set(m, target, key, metadata[key]) || changed
  }
  return changed
}

local fn carry(m: Mod, source: Op, target: Op) -> bool {
  var changed = false
  let metadata = ir.meta(source)
  for key in base.keys(metadata) {
    if key != "onnx" {
      changed = ir.set(m, target, key, metadata[key]) || changed
    }
  }
  return changed
}

[phase: "shape", on: "onnx.Shape"]
local fn convert_shape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let output = ir.type(outputs[0])
  let metadata = attrs(op)
  if base.has(metadata, "start") || base.has(metadata, "end") ||
     !tensor.valid(input) ||
     output != shaped(ty("i64"), [ty(len(tensor.dims(input)))]) {
    return false
  }
  return convert_call(m, op, "tensor.shape")
}

[phase: "shape", on: "onnx.Gather"]
local fn convert_gather(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let expected = gather_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let rank = len(tensor.dims(ir.type(inputs[0])))
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += rank
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  return convert_call(m, op, "tensor.gather", inputs)
}

local fn convert_reshape_view(m: Mod, op: Op, expected: Ty) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 2 || len(outputs) != 1 ||
     expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let values: list<Val> = [inputs[0]]
  return convert_call(m, op, "tensor.reshape", values)
}

[phase: "shape", on: "onnx.Unsqueeze"]
local fn convert_unsqueeze(m: Mod, op: Op) -> bool {
  return convert_reshape_view(m, op, unsqueeze_result(op))
}

[phase: "shape", on: "onnx.Squeeze"]
local fn convert_squeeze(m: Mod, op: Op) -> bool {
  return convert_reshape_view(m, op, squeeze_result(op))
}

[phase: "shape", on: "onnx.Slice"]
local fn convert_slice(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let output = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(output) ||
     tensor.elem(input) != tensor.elem(output) {
    return false
  }
  let starts = slice_starts(op)
  let ends = slice_ends(op)
  let selected = slice_axes(op)
  let steps = slice_steps(op)
  let expected = tensor.sliced(
    tensor.dims(input), starts, ends, selected, steps
  )
  if len(expected) != 0 && tensor.dims(output) == expected {
    var values: list<Val> = [inputs[0]]
    values += [ints(m, op, starts)]
    values += [ints(m, op, selected)]
    values += [ints(m, op, steps)]
    return convert_call(m, op, "tensor.slice", values)
  }
  if len(inputs) < 3 || len(inputs) > 5 {
    return false
  }
  let control = ir.type(inputs[1])
  if !tensor.valid(control) || len(tensor.dims(control)) != 1 {
    return false
  }
  for i in 2..len(inputs) {
    if ir.type(inputs[i]) != control {
      return false
    }
  }
  return convert_call(m, op, "tensor.slice")
}

[phase: "compute", on: "onnx.NonZero"]
local fn convert_nonzero(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let source = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(source) || !tensor.valid(result) ||
     tensor.elem(result) != ty("i64") ||
     len(tensor.dims(result)) != 2 ||
     tensor.dims(result)[0] != ty(len(tensor.dims(source))) {
    return false
  }
  return convert_call(m, op, "nn.nonzero")
}

[phase: "compute", on: "onnx.Range"]
local fn convert_range(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let result = ir.type(outputs[0])
  if !tensor.valid(result) || tensor.dims(result) != [ty("_")] {
    return false
  }
  let element = tensor.elem(result)
  if element != ty("i16") && element != ty("i32") &&
     element != ty("i64") && element != ty("f32") &&
     element != ty("f64") {
    return false
  }
  return convert_call(m, op, "tensor.range")
}

[phase: "shape", on: "onnx.Concat"]
local fn convert_concat(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  let expected = concat_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  if len(inputs) == 1 {
    let values: list<Val> = [inputs[0]]
    return convert_call(m, op, "base.copy", values)
  }
  let first = ir.type(inputs[0])
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(tensor.dims(first))
  }
  let axis_value = ir.constant(m, op, axis, ty("int"))
  var value = inputs[0]
  var type = first
  for i in 1..len(inputs) {
    let right = ir.type(inputs[i])
    let dims = tensor.concatenated(
      tensor.dims(type), tensor.dims(right), axis
    )
    type = shaped(tensor.elem(type), dims)
    let next = ir.call(
      m, op, "tensor.concat", [value, inputs[i], axis_value], type
    )
    if !ir.live(next) || !ir.type(m, next, type) {
      return false
    }
    if i + 1 < len(inputs) &&
       !ir.rename(m, next, ir.name(outputs[0]) + "_" + text(i)) {
      return false
    }
    value = next
  }
  carry(m, outputs[0], value)
  carry(m, op, ir.def(value))
  if !ir.replace(m, outputs[0], value) {
    return false
  }
  return ir.erase(m, op)
}

[phase: "shape", on: "onnx.Split"]
local fn convert_split(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 1 && len(inputs) != 2) || len(outputs) == 0 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 0)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) {
    return false
  }
  var sizes: list<int> = []
  if len(inputs) == 2 {
    sizes = const_ints(inputs[1])
  } else {
    let metadata = attrs(op)
    if base.has(metadata, "split") {
      for size in metadata["split"] {
        sizes += [size]
      }
    }
  }
  if len(sizes) == 0 && kind(shape[axis]) == "int" &&
     int(shape[axis]) % len(outputs) == 0 {
    let size = int(shape[axis]) / len(outputs)
    for output in outputs {
      sizes += [size]
    }
  }
  if len(sizes) != len(outputs) {
    return false
  }
  var total = 0
  for size in sizes {
    if size < 0 {
      return false
    }
    total += size
  }
  if kind(shape[axis]) == "int" && total != int(shape[axis]) {
    return false
  }
  var start = 0
  for i in 0..len(outputs) {
    let expected = shaped(
      tensor.elem(input), tensor.replaced(shape, axis, ty(sizes[i]))
    )
    if ir.type(outputs[i]) != expected {
      return false
    }
  }
  for i in 0..len(outputs) {
    let next = ir.call(
      m, op, "tensor.slice",
      [inputs[0], ints(m, op, [start]), ints(m, op, [axis]),
       ints(m, op, [1])],
      ir.type(outputs[i])
    )
    carry(m, outputs[i], next)
    carry(m, op, ir.def(next))
    if !ir.replace(m, outputs[i], next) {
      return false
    }
    start += sizes[i]
  }
  return ir.erase(m, op)
}

[phase: "shape", on: "onnx.OneHot"]
local fn convert_one_hot(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let depth = const_ints(inputs[1])
  let indices = ir.type(inputs[0])
  let values = ir.type(inputs[2])
  let output = ir.type(outputs[0])
  if len(depth) != 1 || depth[0] <= 0 || !tensor.valid(indices) ||
     !tensor.valid(values) || !tensor.valid(output) ||
     tensor.dims(values) != [ty(2)] ||
     tensor.elem(values) != tensor.elem(output) {
    return false
  }
  var axis = base.get(attrs(op), "axis", -1)
  if axis < 0 {
    axis += len(tensor.dims(indices)) + 1
  }
  if axis < 0 || axis > len(tensor.dims(indices)) {
    return false
  }
  let expected = shaped(
    tensor.elem(values),
    tensor.inserted(tensor.dims(indices), axis, ty(depth[0]))
  )
  if output != expected {
    return false
  }
  var values_in: list<Val> = [inputs[0]]
  values_in += [ir.constant(m, op, depth[0], ty("int"))]
  values_in += [inputs[2]]
  values_in += [ir.constant(m, op, axis, ty("int"))]
  return convert_call(m, op, "tensor.one_hot", values_in)
}

[phase: "shape", on: "onnx.ConstantOfShape"]
local fn convert_constant_shape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let output = ir.type(outputs[0])
  let metadata = attrs(op)
  if !base.has(metadata, "value") {
    if tensor.elem(output) != ty("f32") {
      return false
    }
    let zero = ir.constant(m, op, 0.0, tensor.elem(output))
    let values: list<Val> = [zero]
    return convert_call(m, op, "tensor.tensor", values)
  }
  let literal = metadata["value"]
  if base.kind(literal) != "dict" || !base.has(literal, "type") ||
     !base.has(literal, "shape") || !base.has(literal, "data") {
    return false
  }
  let code = base.int(literal["type"])
  let width = element_bytes(code)
  let literal_shape = literal["shape"]
  if len(literal_shape) != 1 || literal_shape[0] != 1 ||
     width == 0 || base.size(literal["data"]) != width ||
     element(code) != tensor.elem(output) ||
     base.kind(literal["data"]) != "bytes" {
    return false
  }
  let packed = ir.constant(
    m, op, literal["data"], shaped(tensor.elem(output), [ty(1)])
  )
  let values: list<Val> = [packed]
  return convert_call(m, op, "tensor.fill", values)
}

[phase: "shape", on: "onnx.Constant"]
local fn convert_constant(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  let literal = tensor_literal(op)
  let expected = constant_result(op)
  if len(outputs) != 1 || base.kind(literal) != "dict" ||
     expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  if !ir.replace(m, op, literal["data"]) {
    return false
  }
  ir.unset(m, op, "onnx")
  return true
}

local fn convert_unary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) || ir.type(outputs[0]) != input {
    return false
  }
  return convert_call(m, op, callee)
}

[phase: "compute", on: [
  "onnx.Relu", "onnx.Abs", "onnx.Sqrt", "onnx.Reciprocal",
  "onnx.Cos", "onnx.Sin",
  "onnx.Tanh", "onnx.Exp", "onnx.Floor", "onnx.Log", "onnx.Erf",
  "onnx.Sigmoid", "onnx.Ceil", "onnx.Round"
]]
local fn convert_unary(m: Mod, op: Op) -> bool {
  let source = ir.callee(op)
  for rule in unary_rules() {
    if source == rule[0] {
      return convert_unary(m, op, rule[1])
    }
  }
  return false
}

[phase: "compute", on: "onnx.Where"]
local fn convert_where(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  return convert_call(m, op, "nn.where")
}

[phase: "compute", on: "onnx.LayerNormalization"]
local fn convert_layer_norm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 2 || len(inputs) > 3 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) || tensor.elem(input) != ty("f32") ||
     ir.type(outputs[0]) != input {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "stash_type", 1) != 1 {
    return false
  }
  var axis = base.get(meta, "axis", -1)
  let rank = len(tensor.dims(input))
  if axis < 0 {
    axis += rank
  }
  if axis < 0 || axis >= rank {
    return false
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  inputs += [
    ir.constant(m, op, base.get(meta, "epsilon", 0.00001), ty("f64"))
  ]
  return convert_call(m, op, "nn.layer_norm", inputs)
}

[phase: "compute", on: "onnx.Dropout"]
local fn convert_dropout(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 3 ||
     len(outputs) < 1 || len(outputs) > 2 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) {
    return false
  }
  if len(inputs) == 3 {
    if !ir.is_const(inputs[2]) ||
       base.kind(ir.constant(inputs[2])) != "bool" ||
       ir.constant(inputs[2]) == true {
      return false
    }
  }
  if len(outputs) == 2 && len(ir.users(outputs[1])) != 0 {
    return false
  }
  let copied = ir.call(
    m, op, "base.copy", [inputs[0]], ir.type(outputs[0])
  )
  if !ir.live(copied) {
    return false
  }
  carry(m, outputs[0], copied)
  if !ir.replace(m, outputs[0], copied) {
    return false
  }
  return ir.erase(m, op)
}

[phase: "compute", on: "onnx.LeakyRelu"]
local fn convert_leaky_relu(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  let alpha = base.get(attrs(op), "alpha", 0.01)
  inputs += [ir.constant(m, op, alpha, ty("f64"))]
  return convert_call(m, op, "nn.leaky_relu", inputs)
}

[phase: "compute", on: "onnx.Conv"]
local fn convert_conv(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let biased = len(inputs) == 3
  let meta = attrs(op)
  let groups = base.get(meta, "group", 1)
  let expected = conv_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  inputs += [ints(m, op, base.get(meta, "strides", [1, 1]))]
  let weight = ir.type(inputs[1])
  if !tensor.valid(weight) || len(tensor.dims(weight)) != 4 {
    return false
  }
  let weights = tensor.dims(weight)
  let pad = spatial_pad(op, [int(weights[2]), int(weights[3])])
  if len(pad) != 4 {
    return false
  }
  inputs += [ints(m, op, pad)]
  inputs += [ints(m, op, base.get(meta, "dilations", [1, 1]))]
  inputs += [ir.constant(m, op, groups, ty("int"))]
  if biased {
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ints(m, op, [0, 1, 2, 3])]
    inputs += [ir.constant(m, op, "NONE", ty("str"))]
  }
  return convert_call(m, op, "nn.conv2d", inputs)
}

[phase: "compute", on: "onnx.BatchNormalization"]
local fn convert_norm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 5 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "spatial", 1) != 1 {
    return false
  }
  inputs += [
    ir.constant(m, op, base.get(meta, "epsilon", 0.00001), ty("f64"))
  ]
  return convert_call(m, op, "nn.batch_norm", inputs)
}

[phase: "compute", on: "onnx.LRN"]
local fn convert_lrn(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) ||
     !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  let shape = tensor.dims(ir.type(inputs[0]))
  let meta = attrs(op)
  let size = base.get(meta, "size", 0)
  if len(shape) < 2 || size <= 0 {
    return false
  }
  inputs += [ir.constant(m, op, size, ty("int"))]
  inputs += [
    ir.constant(m, op, base.get(meta, "alpha", 0.0001), ty("f64"))
  ]
  inputs += [ir.constant(m, op, base.get(meta, "beta", 0.75), ty("f64"))]
  inputs += [ir.constant(m, op, base.get(meta, "bias", 1.0), ty("f64"))]
  return convert_call(m, op, "nn.lrn", inputs)
}

[phase: "compute", on: "onnx.Softmax"]
local fn convert_softmax(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 ||
     ir.type(inputs[0]) != ir.type(outputs[0]) {
    return false
  }
  let type = ir.type(inputs[0])
  if !tensor.valid(type) {
    return false
  }
  let rank = len(tensor.dims(type))
  let meta = attrs(op)
  let version = onnx.opset(m, "")
  if rank == 0 || version < 0 {
    return false
  }
  var axis = 1
  if version >= 13 {
    axis = -1
  }
  if base.has(meta, "axis") {
    axis = meta["axis"]
  }
  if axis < 0 {
    axis += rank
  }
  if axis < 0 || axis >= rank {
    return false
  }
  if version < 13 {
    var axes: list<int> = []
    for value in axis..rank {
      axes += [value]
    }
    inputs += [ints(m, op, axes)]
  } else {
    inputs += [ir.constant(m, op, axis, ty("int"))]
  }
  inputs += [ir.constant(m, op, 1.0, ty("f64"))]
  return convert_call(m, op, "nn.softmax", inputs)
}

[phase: "compute", on: "onnx.Reshape"]
local fn convert_reshape(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let expected = reshape_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape", [inputs[0]])
}

[phase: "compute", on: "onnx.Expand"]
local fn convert_expand(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  let shape = shape_terms(inputs[1])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let expanded = tensor.broadcast_shape(tensor.dims(input), shape)
  let literal = const_ints(inputs[1])
  if len(literal) == len(shape) && len(literal) != 0 &&
     tensor.static(result) && len(expanded) != 0 &&
     result == shaped(tensor.elem(input), expanded) &&
     tensor.broadcastable(tensor.dims(input), expanded) {
    return convert_call(m, op, "tensor.broadcast", [inputs[0]])
  }
  return convert_call(m, op, "tensor.broadcast")
}

[phase: "compute", on: "onnx.Tile"]
local fn convert_tile(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  let repeats = const_ints(inputs[1])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  if len(repeats) == 0 {
    let repeat_type = ir.type(inputs[1])
    if !tensor.valid(repeat_type) ||
       len(tensor.dims(repeat_type)) != 1 ||
       tensor.dims(repeat_type)[0] != ty(len(tensor.dims(input))) {
      return false
    }
    return convert_call(m, op, "tensor.tile")
  }
  if !tensor.static(input) || !tensor.static(result) ||
     len(repeats) != len(tensor.dims(input)) {
    return false
  }
  for repeat in repeats {
    if repeat < 0 {
      return false
    }
  }
  if result != shaped(
       tensor.elem(input), tensor.tiled(tensor.dims(input), repeats)
     ) {
    return false
  }
  return convert_call(m, op, "tensor.tile", [inputs[0]])
}

[phase: "compute", on: "onnx.Clip"]
local fn convert_clip(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 3 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) || ir.type(outputs[0]) != input {
    return false
  }
  var values: list<Val> = [inputs[0]]
  var callee = "base.copy"
  if len(inputs) > 1 && ir.type(inputs[1]) != ty("nil") {
    let lower = ir.type(inputs[1])
    if !tensor.valid(lower) || tensor.elem(input) != tensor.elem(lower) ||
       !tensor.broadcastable(tensor.dims(lower), tensor.dims(input)) {
      return false
    }
    values += [inputs[1]]
    callee = "nn.maximum"
  }
  if len(inputs) > 2 && ir.type(inputs[2]) != ty("nil") {
    let upper = ir.type(inputs[2])
    if !tensor.valid(upper) || tensor.elem(input) != tensor.elem(upper) ||
       !tensor.broadcastable(tensor.dims(upper), tensor.dims(input)) {
      return false
    }
    values += [inputs[2]]
    if len(values) == 3 {
      callee = "nn.clip"
    } else {
      callee = "nn.minimum"
    }
  }
  return convert_call(m, op, callee, values)
}

local fn convert_binary_result(
  m: Mod, op: Op, callee: str, output_elem: Ty
) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  let result = ir.type(outputs[0])
  if !tensor.valid(left) || !tensor.valid(right) ||
     !tensor.valid(result) {
    return false
  }
  if tensor.elem(left) != tensor.elem(right) ||
     tensor.elem(result) != output_elem {
    return false
  }
  var left_ok = len(tensor.dims(left)) == 0
  var right_ok = len(tensor.dims(right)) == 0
  if !left_ok {
    left_ok = tensor.broadcastable(
      tensor.dims(left), tensor.dims(result)
    )
  }
  if !right_ok {
    right_ok = tensor.broadcastable(
      tensor.dims(right), tensor.dims(result)
    )
  }
  if !left_ok || !right_ok {
    return false
  }
  return convert_call(m, op, callee)
}

local fn convert_binary(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  if len(inputs) != 2 || !tensor.valid(ir.type(inputs[0])) {
    return false
  }
  return convert_binary_result(
    m, op, callee, tensor.elem(ir.type(inputs[0]))
  )
}

local fn extrema_types(inputs: list<Val>) -> list<Ty> {
  if len(inputs) == 0 {
    return []
  }
  let first = ir.type(inputs[0])
  if !tensor.valid(first) {
    return []
  }
  let elem = tensor.elem(first)
  var shape: list<Ty> = tensor.dims(first)
  var types: list<Ty> = []
  for i in 1..len(inputs) {
    let right = ir.type(inputs[i])
    if !tensor.valid(right) || tensor.elem(right) != elem {
      return []
    }
    let dims: list<Ty> = tensor.dims(right)
    let next: list<Ty> = tensor.broadcast_shape(shape, dims)
    if !tensor.broadcastable(shape, next) ||
       !tensor.broadcastable(dims, next) {
      return []
    }
    shape = next
    types += [shaped(elem, shape)]
  }
  return types
}

local fn convert_extrema(m: Mod, op: Op, callee: str) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) == 0 || len(outputs) != 1 {
    return false
  }
  if len(inputs) == 1 {
    if ir.type(inputs[0]) != ir.type(outputs[0]) {
      return false
    }
    return convert_call(m, op, "base.copy")
  }
  let types = extrema_types(inputs)
  if len(types) + 1 != len(inputs) ||
     types[len(types) - 1] != ir.type(outputs[0]) {
    return false
  }
  var current = inputs[0]
  for i in 1..len(inputs) {
    if i + 1 < len(inputs) {
      let next = ir.call(m, op, callee, [current, inputs[i]], types[i - 1])
      if !ir.live(next) {
        return false
      }
      current = next
    }
  }
  return convert_call(
    m, op, callee, [current, inputs[len(inputs) - 1]]
  )
}

[phase: "compute", on: "onnx.Add"]
local fn convert_add(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.add")
}

[phase: "compute", on: "onnx.Sub"]
local fn convert_sub(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.sub")
}

[phase: "compute", on: "onnx.Mul"]
local fn convert_mul(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.mul")
}

[phase: "compute", on: "onnx.Div"]
local fn convert_div(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.div")
}

[phase: "compute", on: "onnx.Pow"]
local fn convert_pow(m: Mod, op: Op) -> bool {
  return convert_binary(m, op, "nn.pow")
}

[phase: "compute", on: "onnx.Equal"]
local fn convert_equal(m: Mod, op: Op) -> bool {
  return convert_binary_result(m, op, "operator ==", ty("bool"))
}

[phase: "compute", on: "onnx.Greater"]
local fn convert_greater(m: Mod, op: Op) -> bool {
  return convert_binary_result(m, op, "operator >", ty("bool"))
}

[phase: "compute", on: "onnx.Less"]
local fn convert_less(m: Mod, op: Op) -> bool {
  return convert_binary_result(m, op, "operator <", ty("bool"))
}

[phase: "compute", on: "onnx.Max"]
local fn convert_max(m: Mod, op: Op) -> bool {
  return convert_extrema(m, op, "nn.maximum")
}

[phase: "compute", on: "onnx.Min"]
local fn convert_min(m: Mod, op: Op) -> bool {
  return convert_extrema(m, op, "nn.minimum")
}

local fn quant_axis(op: Op, data: Ty, params: Ty) -> int {
  if !tensor.valid(data) || !tensor.valid(params) {
    return -1
  }
  let shape = tensor.dims(data)
  let parameter_shape = tensor.dims(params)
  if len(parameter_shape) == 0 ||
     (len(parameter_shape) == 1 && parameter_shape[0] == ty(1)) {
    return 0
  }
  if len(parameter_shape) != 1 {
    return -1
  }
  var axis = base.int(base.get(attrs(op), "axis", 1))
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis >= len(shape) ||
     parameter_shape[0] != shape[axis] {
    return -1
  }
  return axis
}

local fn quant_bounds(elem: Ty) -> list<int> {
  if elem == ty("u8") {
    return [0, 255]
  }
  if elem == ty("i8") {
    return [-128, 127]
  }
  if elem == ty("u16") {
    return [0, 65535]
  }
  if elem == ty("i16") {
    return [-32768, 32767]
  }
  var unsupported: list<int> = []
  return unsupported
}

[phase: "compute", on: "onnx.QuantizeLinear"]
local fn convert_quantize(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let data = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  let zero = ir.type(inputs[2])
  let result = ir.type(outputs[0])
  if !tensor.valid(data) || !tensor.valid(scale) ||
     !tensor.valid(zero) || !tensor.valid(result) ||
     tensor.elem(scale) != tensor.elem(data) ||
     tensor.elem(zero) != tensor.elem(result) ||
     tensor.dims(zero) != tensor.dims(scale) ||
     tensor.dims(result) != tensor.dims(data) {
    return false
  }
  let axis = quant_axis(op, data, scale)
  let bounds = quant_bounds(tensor.elem(result))
  if axis < 0 || len(bounds) != 2 {
    return false
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  inputs += [ir.constant(m, op, bounds[0], ty("int"))]
  inputs += [ir.constant(m, op, bounds[1], ty("int"))]
  return convert_call(m, op, "quant.quantize", inputs)
}

[phase: "compute", on: "onnx.DequantizeLinear"]
local fn convert_dequantize(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 {
    return false
  }
  let data = ir.type(inputs[0])
  let scale = ir.type(inputs[1])
  let zero = ir.type(inputs[2])
  let result = ir.type(outputs[0])
  if !tensor.valid(data) || !tensor.valid(scale) ||
     !tensor.valid(zero) || !tensor.valid(result) ||
     tensor.elem(zero) != tensor.elem(data) ||
     tensor.elem(scale) != tensor.elem(result) ||
     tensor.dims(zero) != tensor.dims(scale) ||
     tensor.dims(result) != tensor.dims(data) {
    return false
  }
  let axis = quant_axis(op, data, scale)
  if axis < 0 {
    return false
  }
  inputs += [ir.constant(m, op, axis, ty("int"))]
  return convert_call(m, op, "quant.dequantize", inputs)
}

[phase: "compute", on: "onnx.DynamicQuantizeLinear"]
local fn convert_dynamic_quant(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 3 {
    return false
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return false
  }
  let shape = tensor.dims(input)
  if ir.type(outputs[0]) != shaped(ty("u8"), shape) ||
     ir.type(outputs[1]) != ty("tensor<f32, []>") ||
     ir.type(outputs[2]) != ty("tensor<u8, []>") ||
     tensor.elem(input) != ty("f32") {
    return false
  }
  return convert_call(m, op, "quant.dynamic")
}

[phase: "shape", on: "onnx.Cast"]
local fn convert_cast(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) ||
     tensor.dims(input) != tensor.dims(result) ||
     tensor.elem(result) != element(base.get(attrs(op), "to", 0)) {
    return false
  }
  return convert_call(m, op, "tensor.cast")
}

local fn matmul_param(type: Ty, elem: Ty, extent: Ty) -> bool {
  if !tensor.valid(type) || tensor.elem(type) != elem {
    return false
  }
  let shape = tensor.dims(type)
  return len(shape) == 0 ||
         (len(shape) == 1 &&
          (shape[0] == ty(1) || shape[0] == extent))
}

[phase: "compute", on: "onnx.MatMulInteger"]
local fn convert_integer_matmul(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 4 || len(outputs) != 1 {
    return false
  }
  let left = ir.type(inputs[0])
  let right = ir.type(inputs[1])
  if !tensor.valid(left) || !tensor.valid(right) ||
     len(tensor.dims(left)) < 2 || len(tensor.dims(right)) < 2 ||
     !matmul_param(
       ir.type(inputs[2]), tensor.elem(left),
       tensor.dims(left)[len(tensor.dims(left)) - 2]
     ) ||
     !matmul_param(
       ir.type(inputs[3]), tensor.elem(right),
       tensor.dims(right)[len(tensor.dims(right)) - 1]
     ) {
    return false
  }
  let shape = matmul_shape(left, right)
  if len(shape) == 0 ||
     ir.type(outputs[0]) != shaped(ty("i32"), shape) {
    return false
  }
  return convert_call(m, op, "quant.matmul")
}

[phase: "compute", on: "com_microsoft.FusedMatMul"]
local fn convert_fused_matmul(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 2 || len(outputs) != 1 {
    return false
  }
  let expected = fused_matmul_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let meta = attrs(op)
  inputs += [
    ir.constant(m, op, base.get(meta, "transA", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "transB", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "alpha", 1.0), ty("f64"))
  ]
  return convert_call(m, op, "tensor.matmul", inputs)
}

[phase: "compute", on: "onnx.Flatten"]
local fn convert_flatten(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  var axis = base.get(attrs(op), "axis", 1)
  if axis < 0 {
    axis += len(shape)
  }
  if axis < 0 || axis > len(shape) {
    return false
  }
  let expected = flattened(input, axis)
  if expected == ty("_") || result != expected {
    return false
  }
  return convert_call(m, op, "tensor.reshape")
}

[phase: "compute", on: "onnx.MatMul"]
local fn convert_matmul(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  let expected = matmul_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  return convert_call(m, op, "tensor.matmul")
}

[phase: "compute", on: "onnx.Gemm"]
local fn convert_gemm(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if (len(inputs) != 2 && len(inputs) != 3) || len(outputs) != 1 {
    return false
  }
  let expected = gemm_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let meta = attrs(op)
  inputs += [
    ir.constant(m, op, base.get(meta, "transA", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "transB", 0) == 1, ty("bool"))
  ]
  inputs += [
    ir.constant(m, op, base.get(meta, "alpha", 1.0), ty("f64"))
  ]
  if len(ir.args(op)) == 3 {
    inputs += [
      ir.constant(m, op, base.get(meta, "beta", 1.0), ty("f64"))
    ]
  }
  return convert_call(m, op, "nn.gemm", inputs)
}

[phase: "compute", on: "onnx.Transpose"]
local fn convert_transpose(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let input = ir.type(inputs[0])
  let result = ir.type(outputs[0])
  if !tensor.valid(input) || !tensor.valid(result) {
    return false
  }
  let shape = tensor.dims(input)
  let axes = transpose_axes(op, len(shape))
  if !tensor.permutation(axes, len(shape)) {
    return false
  }
  if result != shaped(tensor.elem(input), tensor.permuted(shape, axes)) {
    return false
  }
  inputs += [ints(m, op, axes)]
  return convert_call(m, op, "tensor.permute", inputs)
}

[phase: "compute", on: [
  "onnx.ReduceMean", "onnx.ReduceSum", "onnx.ReduceMin", "onnx.ReduceMax"
]]
local fn convert_mean(m: Mod, op: Op) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) < 1 || len(inputs) > 2 || len(outputs) != 1 {
    return false
  }
  let expected = reduce_result(op)
  if expected == ty("_") || ir.type(outputs[0]) != expected {
    return false
  }
  let axes = reduce_axes(op, len(tensor.dims(ir.type(inputs[0]))))
  inputs = [inputs[0]]
  inputs += [ints(m, op, axes)]
  var callee = "tensor.mean"
  if ir.callee(op) == "onnx.ReduceSum" {
    callee = "tensor.sum"
  }
  if ir.callee(op) == "onnx.ReduceMin" {
    callee = "tensor.min"
  }
  if ir.callee(op) == "onnx.ReduceMax" {
    callee = "tensor.max"
  }
  return convert_call(m, op, callee, inputs)
}

local fn convert_pool(m: Mod, op: Op, callee: str) -> bool {
  var inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  if !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) {
    return false
  }
  let meta = attrs(op)
  if !base.has(meta, "kernel_shape") ||
     base.get(meta, "ceil_mode", 0) != 0 {
    return false
  }
  if callee == "nn.avg_pool2d" &&
     base.get(meta, "count_include_pad", 0) != 0 {
    return false
  }
  if callee == "nn.max_pool2d" &&
     base.get(meta, "storage_order", 0) != 0 {
    return false
  }
  let kernel = meta["kernel_shape"]
  let stride = base.get(meta, "strides", [1, 1])
  let dilation = base.get(meta, "dilations", [1, 1])
  let pad = spatial_pad(op, kernel)
  if len(kernel) != 2 || len(stride) != 2 || len(dilation) != 2 {
    return false
  }
  inputs += [ints(m, op, kernel)]
  inputs += [ints(m, op, stride)]
  if len(pad) == 4 {
    inputs += [ints(m, op, pad)]
  } else {
    let mode = base.get(meta, "auto_pad", "NOTSET")
    if mode != "SAME_UPPER" && mode != "SAME_LOWER" {
      return false
    }
    inputs += [ir.constant(m, op, mode, ty("str"))]
  }
  inputs += [ints(m, op, dilation)]
  inputs += [ints(m, op, [0, 1, 2, 3])]
  return convert_call(m, op, callee, inputs)
}

[phase: "compute", on: "onnx.GlobalAveragePool"]
local fn convert_global_pool(m: Mod, op: Op) -> bool {
  return convert_call(m, op, "nn.global_avg_pool2d")
}

[phase: "compute", on: "onnx.AveragePool"]
local fn convert_avg_pool(m: Mod, op: Op) -> bool {
  return convert_pool(m, op, "nn.avg_pool2d")
}

[phase: "compute", on: "onnx.MaxPool"]
local fn convert_max_pool(m: Mod, op: Op) -> bool {
  return convert_pool(m, op, "nn.max_pool2d")
}

[phase: "compute", on: "onnx.Resize"]
local fn convert_resize(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 3 || len(outputs) != 1 ||
     !tensor.valid(ir.type(inputs[0])) ||
     !tensor.valid(ir.type(outputs[0])) ||
     ir.type(inputs[2]) != ty("tensor<f32, [4]>") {
    return false
  }
  let meta = attrs(op)
  if base.get(meta, "mode", "nearest") != "nearest" ||
     base.get(meta, "coordinate_transformation_mode", "half_pixel") !=
       "asymmetric" ||
     base.get(meta, "nearest_mode", "round_prefer_floor") != "floor" {
    return false
  }
  return convert_call(
    m, op, "nn.resize2d", [
      inputs[0], inputs[2], ints(m, op, [0, 1, 2, 3])
    ]
  )
}

[phase: "compute", on: "onnx.NonMaxSuppression"]
local fn convert_nms(m: Mod, op: Op) -> bool {
  let source_inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(source_inputs) < 2 || len(source_inputs) > 5 || len(outputs) != 1 {
    return false
  }
  let boxes = ir.type(source_inputs[0])
  let scores = ir.type(source_inputs[1])
  let result = ir.type(outputs[0])
  if !tensor.valid(boxes) || !tensor.valid(scores) ||
     !tensor.valid(result) || len(tensor.dims(boxes)) != 3 ||
     len(tensor.dims(scores)) != 3 ||
     tensor.elem(boxes) != tensor.elem(scores) ||
     tensor.dims(boxes)[2] != ty(4) ||
     known_mismatch(tensor.dims(boxes)[0], tensor.dims(scores)[0]) ||
     known_mismatch(tensor.dims(boxes)[1], tensor.dims(scores)[2]) ||
     result != shaped(ty("i64"), [ty("_"), ty(3)]) {
    return false
  }
  var inputs: list<Val> = [source_inputs[0], source_inputs[1]]
  let maximum_value = optional_scalar(
    m, op, source_inputs, 2, ty("i64"), "nms_default_", 0
  )
  let overlap_value = optional_scalar(
    m, op, source_inputs, 3, tensor.elem(boxes), "nms_default_", 1
  )
  let score_value = optional_scalar(
    m, op, source_inputs, 4, tensor.elem(boxes), "nms_default_", 2
  )
  if !ir.live(maximum_value) || !ir.live(overlap_value) ||
     !ir.live(score_value) {
    return false
  }
  inputs += [maximum_value, overlap_value, score_value]
  let maximum = ir.type(maximum_value)
  if !tensor.valid(maximum) || len(tensor.dims(maximum)) != 0 ||
     tensor.elem(maximum) != ty("i64") {
    return false
  }
  for i in 3..5 {
    let threshold = ir.type(inputs[i])
    if !tensor.valid(threshold) || len(tensor.dims(threshold)) != 0 ||
       tensor.elem(threshold) != tensor.elem(boxes) {
      return false
    }
  }
  let center = base.get(attrs(op), "center_point_box", 0)
  if center != 0 && center != 1 {
    return false
  }
  inputs += [ir.constant(m, op, center, ty("int"))]
  return convert_call(m, op, "nn.nms", inputs)
}

[phase: "shape", on: "onnx.Identity"]
local fn convert_identity(m: Mod, op: Op) -> bool {
  return convert_unary(m, op, "base.copy")
}

[phase: "control", on: "onnx.Loop"]
local fn convert_loop(m: Mod, op: Op) -> bool {
  let body = onnx.graph(m, op, "body")
  if !ir.live(body) {
    return false
  }
  let info = base.get(attrs(op), "body", {})
  let input_count = base.int(base.get(info, "inputs", -1))
  let captures = base.get(info, "captures", [])
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let params = ir.params(body)
  let bodies = ir.blks(body)
  if input_count < 2 || len(inputs) < input_count ||
     len(params) != input_count + len(captures) || len(bodies) != 1 {
    return false
  }
  let body_ops = ir.ops(bodies[0])
  if len(body_ops) == 0 ||
     ir.kind(body_ops[len(body_ops) - 1]) != "return" {
    return false
  }
  for i in 0..len(body_ops) - 1 {
    if ir.kind(body_ops[i]) == "return" ||
       base.replace(ir.callee(body_ops[i]), "onnx.", "") !=
         ir.callee(body_ops[i]) {
      return false
    }
  }

  let returned = ir.args(body_ops[len(body_ops) - 1])
  let carried_count = input_count - 2
  let scan_count = len(outputs) - carried_count
  if scan_count < 0 || len(returned) != 1 + carried_count + scan_count {
    return false
  }
  let trip_type = ir.type(inputs[0])
  let condition_type = ir.type(inputs[1])
  if !tensor.valid(trip_type) || len(tensor.dims(trip_type)) != 0 ||
     !tensor.valid(condition_type) || len(tensor.dims(condition_type)) != 0 ||
     tensor.elem(condition_type) != ty("bool") {
    return false
  }
  for i in 0..carried_count {
    if ir.type(inputs[i + 2]) != ir.type(outputs[i]) ||
       ir.type(returned[i + 1]) != ir.type(outputs[i]) {
      return false
    }
  }
  for i in 0..scan_count {
    let output_type = ir.type(outputs[carried_count + i])
    let sample_type = ir.type(returned[1 + carried_count + i])
    if !tensor.valid(output_type) || !tensor.valid(sample_type) ||
       tensor.elem(output_type) != tensor.elem(sample_type) {
      return false
    }
    let dims = tensor.dims(output_type)
    if len(dims) != len(tensor.dims(sample_type)) + 1 ||
       len(dims) == 0 || dims[0] != ty("_") {
      return false
    }
    for axis in 1..len(dims) {
      if dims[axis] != tensor.dims(sample_type)[axis - 1] ||
         base.kind(dims[axis]) != "int" {
        return false
      }
    }
  }

  let trip = scalar(m, op, inputs[0])
  let condition = scalar(m, op, inputs[1])
  if !ir.live(trip) || !ir.live(condition) {
    return false
  }
  var trip_index = trip
  if ir.type(trip) != ty("index") {
    trip_index = ir.call(m, op, "index", [trip], ty("index"))
  }
  let begin = ir.constant(m, op, 0, ty("index"))
  let range = ir.call(
    m, op, "operator ..", [begin, trip_index], ty("range")
  )

  var state: list<Val> = []
  let condition_state = local_copy(
    m, op, inputs[1], "loop_condition_", 0
  )
  if !ir.live(condition_state) {
    return false
  }
  state += [condition_state]
  for i in 0..carried_count {
    let carried = local_copy(
      m, op, inputs[i + 2], "loop_value_", i
    )
    if !ir.live(carried) {
      return false
    }
    state += [carried]
  }
  for i in 0..scan_count {
    let output_type = ir.type(outputs[carried_count + i])
    let shape = shape_value(m, op, tensor.dims(output_type), trip_index)
    if !ir.live(shape) {
      return false
    }
    let fill = zero(m, op, tensor.elem(output_type))
    let storage = ir.call(
      m, op, "tensor.make", [fill, shape], output_type
    )
    if !ir.live(storage) {
      return false
    }
    let storage_name = local_name(op, "loop_scan_", i)
    if storage_name == "" || !ir.rename(m, storage, storage_name) {
      return false
    }
    state += [storage]
  }
  let count_index = len(state)
  let count = ir.constant(m, op, 0, ty("index"))
  let count_name = local_name(op, "loop_count_", 0)
  if count_name == "" || !ir.rename(m, count, count_name) {
    return false
  }
  state += [count]

  let loop = ir.loop(m, op, ["iteration"], [range], state)
  if !ir.live(loop) {
    return false
  }
  carry(m, op, loop)
  let loop_body = ir.blks(loop)[0]
  let loop_args = ir.args(loop_body)
  let loop_yield = ir.ops(loop_body)[0]
  let active = scalar(m, loop_yield, loop_args[1])
  if !ir.live(active) {
    return false
  }
  var current: list<Val> = []
  for i in 1..len(loop_args) {
    current += [loop_args[i]]
  }
  let branch = ir.branch(m, loop_yield, active, current)
  if !ir.live(branch) {
    return false
  }
  let then_body = ir.blks(branch)[0]
  let then_args = ir.args(then_body)
  let then_yield = ir.ops(then_body)[0]

  var old: list<Val> = []
  var next: list<Val> = []
  let iteration_i64 = ir.call(
    m, then_yield, "i64", [loop_args[0]], ty("i64")
  )
  let iteration = ir.call(
    m, then_yield, "tensor.tensor", [iteration_i64], ir.type(params[0])
  )
  old += [params[0], params[1]]
  next += [iteration, then_args[0]]
  for i in 0..carried_count {
    old += [params[i + 2]]
    next += [then_args[i + 1]]
  }
  for i in 0..len(captures) {
    let position = base.int(captures[i])
    if position < 0 || position >= len(inputs) {
      return false
    }
    old += [params[input_count + i]]
    next += [inputs[position]]
  }
  for i in 0..len(body_ops) - 1 {
    let copy = ir.clone(m, body_ops[i], then_yield, old, next)
    if !ir.live(copy) {
      return false
    }
    old += ir.outs(body_ops[i])
    next += ir.outs(copy)
  }

  var yielded: list<Val> = [mapped(returned[0], old, next)]
  for i in 0..carried_count {
    yielded += [mapped(returned[i + 1], old, next)]
  }
  let written_at = then_args[count_index]
  for i in 0..scan_count {
    let storage = then_args[1 + carried_count + i]
    let sample = mapped(returned[1 + carried_count + i], old, next)
    let written = ir.call(
      m, then_yield, "tensor.write", [storage, written_at, sample],
      ir.type(storage)
    )
    if !ir.live(written) {
      return false
    }
    yielded += [written]
  }
  let one = ir.constant(m, then_yield, 1, ty("index"))
  yielded += [ir.call(
    m, then_yield, "operator +", [written_at, one], ty("index")
  )]
  if !ir.args(m, then_yield, yielded) ||
     !ir.args(m, loop_yield, ir.outs(branch)) {
    return false
  }

  let loop_outputs = ir.outs(loop)
  var replacements: list<Val> = []
  for i in 0..carried_count {
    replacements += [loop_outputs[i + 1]]
  }
  for i in 0..scan_count {
    let output_type = ir.type(outputs[carried_count + i])
    let shape = shape_value(
      m, op, tensor.dims(output_type), loop_outputs[count_index]
    )
    let viewed = ir.call(
      m, op, "tensor.view",
      [loop_outputs[1 + carried_count + i], shape], output_type
    )
    if !ir.live(viewed) {
      return false
    }
    replacements += [viewed]
  }
  for i in 0..len(outputs) {
    carry(m, outputs[i], replacements[i])
  }
  if !ir.replace(m, outputs, replacements) || !ir.erase(m, op) ||
     !ir.erase(m, body) {
    return false
  }
  return true
}

fn convert(m: Mod, rules: list<Fn>) -> bool {
  var changed = infer(m, rules)
  changed = ir.use(m, "nn") || changed
  changed = ir.use(m, "quant") || changed
  changed = ir.use(m, "tensor") || changed
  for phase in ["data", "compute", "shape", "control", "cleanup"] {
    let selected = ir.where(rules, "phase", phase)
    for op in ir.ops(m) {
      for rule in ir.where(selected, "on", ir.callee(op)) {
        changed = ir.invoke<bool>(m, op, rule) || changed
      }
    }
  }
  return changed
}

fn convert(m: Mod) -> bool {
  return convert(m, ir.fns("onnx.nn"))
}
