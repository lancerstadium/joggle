fn convert(m: Mod, rules: list<Fn>) -> bool {
  var changed = infer(m, rules)
  changed = ir.use(m, "nn") || changed
  changed = ir.use(m, "quant") || changed
  changed = ir.use(m, "tensor") || changed
  var again = true
  var exhausted = false
  let limit = len(ir.ops(m)) + 1
  for round in 0..limit {
    if again {
      var round_changed = false
      for phase in ["data", "compute", "shape", "control", "cleanup"] {
        for op in ir.ops(m) {
          for rule in phase_rules(rules, phase, ir.callee(op)) {
            round_changed = ir.invoke<bool>(m, op, rule) || round_changed
          }
        }
      }
      again = round_changed
      changed = again || changed
      if round == limit - 1 && again {
        exhausted = true
      }
    }
  }
  base.assert(!exhausted, "onnx.nn.convert did not converge")
  return changed
}

fn convert(m: Mod) -> bool {
  return convert(m, ir.fns("onnx.nn"))
}
