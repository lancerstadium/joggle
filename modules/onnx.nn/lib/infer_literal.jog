local fn tensor_literal(op: Op) -> Attr {
  let meta = attrs(op)
  if !base.has(meta, "value") {
    return {}
  }
  let literal = meta["value"]
  if base.kind(literal) != "dict" ||
     !base.has(literal, "type") ||
     !base.has(literal, "shape") ||
     !base.has(literal, "data") ||
     base.kind(literal["type"]) != "int" ||
     base.kind(literal["shape"]) != "list" ||
     base.kind(literal["data"]) != "bytes" {
    return {}
  }
  return literal
}

local fn tensor_data(op: Op) -> Attr {
  let outputs = ir.outs(op)
  if ir.kind(op) == "constant" && len(outputs) == 1 &&
     tensor.valid(ir.type(outputs[0])) &&
     base.kind(ir.constant(outputs[0])) == "bytes" {
    return ir.constant(outputs[0])
  }
  if ir.callee(op) == "onnx.tensor" {
    let inputs = ir.args(op)
    let index = 2
    if len(inputs) > index && ir.is_const(inputs[index]) {
      return ir.constant(inputs[index])
    }
  }
  if ir.callee(op) == "onnx.Constant" {
    let literal = tensor_literal(op)
    if base.kind(literal) == "dict" {
      return literal["data"]
    }
  }
  return ir.meta(op)
}

// Decode only integral, finite IEEE values. Shape specialization must not
// replace a rounded floating-point computation with integer arithmetic.
local fn integral_real(data: Attr, offset: int, width: int) -> list<int> {
  var fraction = 0
  var exponent = 0
  var sign = 0
  var unit = 8388608
  var bias = 150
  var maximum = 255
  if width == 4 {
    fraction = base.byte(data, offset) + base.byte(data, offset + 1) * 256 +
               (base.byte(data, offset + 2) % 128) * 65536
    exponent = base.byte(data, offset + 2) / 128 +
               (base.byte(data, offset + 3) % 128) * 2
    sign = base.byte(data, offset + 3) / 128
  } else {
    var factor = 1
    for i in 0..6 {
      fraction += base.byte(data, offset + i) * factor
      factor *= 256
    }
    fraction += (base.byte(data, offset + 6) % 16) * factor
    exponent = base.byte(data, offset + 6) / 16 +
               (base.byte(data, offset + 7) % 128) * 16
    sign = base.byte(data, offset + 7) / 128
    unit = 4503599627370496
    bias = 1075
    maximum = 2047
  }
  if exponent == 0 {
    if fraction == 0 { return [0] }
    return []
  }
  if exponent == maximum { return [] }
  var value = unit + fraction
  let shift = exponent - bias
  if shift < 0 {
    for i in 0..(0 - shift) {
      if value % 2 != 0 { return [] }
      value /= 2
    }
  } else {
    for i in 0..shift {
      if value > 9223372036854775807 / 2 { return [] }
      value *= 2
    }
  }
  if sign != 0 { value = 0 - value }
  return [value]
}

local fn literal_ints(value: Val) -> list<int> {
  var out: list<int> = []
  let type = ir.type(value)
  if !tensor.valid(type) {
    return out
  }
  var width = 0
  let elem = tensor.elem(type)
  let floating = elem == ty("f32") || elem == ty("f64")
  if elem == ty("i32") || elem == ty("f32") {
    width = 4
  }
  if elem == ty("i64") || elem == ty("f64") {
    width = 8
  }
  if width == 0 {
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let data = tensor_data(producer)
  if base.kind(data) != "bytes" {
    return out
  }
  if base.size(data) % width != 0 {
    return out
  }
  // Bound structural evaluation; large tensor constants remain data.
  if floating && base.size(data) / width > 256 { return [] }
  for i in 0..base.size(data) / width {
    if floating {
      let exact = integral_real(data, i * width, width)
      if len(exact) != 1 { return [] }
      out += exact
    } else {
      out += [signed(data, i * width, width)]
    }
  }
  return out
}

local fn scaled_floor(dim: int, data: Attr, offset: int) -> int {
  // floor(dim * scale) for a little-endian IEEE-754 binary32 scale, in integer
  // arithmetic only: the compile-time evaluator has no float constructor and the
  // language has no shifts, so powers of two are built by repeated doubling.
  let bits = base.byte(data, offset) + base.byte(data, offset + 1) * 256 +
             base.byte(data, offset + 2) * 65536 +
             base.byte(data, offset + 3) * 16777216
  let exponent = (bits / 8388608) % 256
  if exponent == 0 || exponent == 255 {
    return -1
  }
  let mantissa = 8388608 + bits % 8388608
  let shift = 150 - exponent
  var power = 1
  if shift > 0 {
    for i in 0..shift {
      power *= 2
    }
    return dim * mantissa / power
  }
  for i in 0..(0 - shift) {
    power *= 2
  }
  return dim * mantissa * power
}

local fn resize_extents(source: list<Ty>, value: Val) -> list<Ty> {
  var out: list<Ty> = []
  let type = ir.type(value)
  if !tensor.valid(type) || tensor.elem(type) != ty("f32") {
    return out
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return out
  }
  let data = tensor_data(producer)
  if base.kind(data) != "bytes" || base.size(data) != len(source) * 4 {
    return out
  }
  for i in 0..len(source) {
    let dim = source[i]
    if kind(dim) != "int" || int(dim) <= 0 {
      return []
    }
    let extent = scaled_floor(int(dim), data, i * 4)
    if extent <= 0 {
      return []
    }
    out += [ty(extent)]
  }
  return out
}

local fn static_count(type: Ty) -> int {
  if !tensor.valid(type) {
    return -1
  }
  var out = 1
  for dim in tensor.dims(type) {
    if kind(dim) != "int" || int(dim) < 0 {
      return -1
    }
    out *= int(dim)
  }
  return out
}

local fn splat(value: int, count: int) -> list<int> {
  var out: list<int> = []
  if count < 0 {
    return out
  }
  for i in 0..count {
    out += [value]
  }
  return out
}

local fn selected(values: list<int>, index: int, count: int) -> int {
  base.assert(
    len(values) == 1 || len(values) == count,
    "static tensor broadcast is incompatible"
  )
  if len(values) == 1 {
    return values[0]
  }
  return values[index]
}

local fn exact_arithmetic(op: str, a: int, b: int) -> list<int> {
  let low = -9223372036854775807 - 1
  let high = 9223372036854775807
  if op == "add" {
    if (b > 0 && a > high - b) || (b < 0 && a < low - b) { return [] }
    return [a + b]
  }
  if op == "sub" {
    if (b > 0 && a < low + b) || (b < 0 && a > high + b) { return [] }
    return [a - b]
  }
  if op == "div" {
    if b == 0 || (a == low && b == -1) { return [] }
    if a % b != 0 { return [] }
    return [a / b]
  }
  if a > 0 {
    if (b > 0 && a > high / b) || (b < 0 && b < low / a) { return [] }
  }
  if a < 0 {
    if (b > 0 && a < low / b) || (b < 0 && a < high / b) { return [] }
  }
  return [a * b]
}

local fn const_ints(value: Val) -> list<int> {
  let literal = literal_ints(value)
  if len(literal) != 0 {
    return literal
  }
  let producer = ir.def(value)
  if !ir.live(producer) {
    return []
  }
  let callee = ir.callee(producer)
  let inputs = ir.args(producer)
  let count = static_count(ir.type(value))

  // Integer shape controls often pass through Cast before Slice/Reshape.
  // Preserve their values only when the conversion is lossless; a narrowing
  // overflow must remain a runtime cast, not a guessed shape constant.
  if (callee == "onnx.Cast" || callee == "tensor.cast") &&
     len(inputs) == 1 && tensor.valid(ir.type(value)) &&
     tensor.valid(ir.type(inputs[0])) {
    let source = tensor.elem(ir.type(inputs[0]))
    let target = tensor.elem(ir.type(value))
    if (source == ty("i32") || source == ty("i64") ||
        source == ty("f32") || source == ty("f64")) &&
       (target == ty("i32") || target == ty("i64") ||
        target == ty("f32") || target == ty("f64")) {
      let values = const_ints(inputs[0])
      for item in values {
        if target == ty("i32") && (item < -2147483648 || item > 2147483647) {
          return []
        }
        if target == ty("f32") && (item < -16777216 || item > 16777216) {
          return []
        }
        if target == ty("f64") &&
           (item < -9007199254740992 || item > 9007199254740992) { return [] }
      }
      return values
    }
  }

  if callee == "base.list" {
    var out: list<int> = []
    for input in inputs {
      if !ir.is_const(input) || base.kind(ir.constant(input)) != "int" {
        return []
      }
      out += [base.int(ir.constant(input))]
    }
    return out
  }

  // Concatenated rank-one integer controls are common shape/repeat vectors.
  if (callee == "onnx.Concat" || callee == "tensor.concat") && count >= 0 &&
     tensor.valid(ir.type(value)) && len(tensor.dims(ir.type(value))) == 1 {
    var axis = base.get(attrs(producer), "axis", 0)
    var parts = inputs
    if callee == "tensor.concat" {
      if len(inputs) != 3 || !ir.is_const(inputs[2]) { return [] }
      axis = ir.constant(inputs[2])
      parts = [inputs[0], inputs[1]]
    }
    if axis != 0 && axis != -1 { return [] }
    var out: list<int> = []
    for part in parts {
      if !tensor.valid(ir.type(part)) || len(tensor.dims(ir.type(part))) != 1 {
        return []
      }
      let values = const_ints(part)
      if len(values) != static_count(ir.type(part)) { return [] }
      out += values
    }
    if len(out) == count { return out }
    return []
  }

  if (callee == "tensor.shape" || callee == "onnx.Shape") && len(inputs) == 1 {
    if callee == "onnx.Shape" &&
       (base.has(attrs(producer), "start") || base.has(attrs(producer), "end")) {
      return []
    }
    let input = ir.type(inputs[0])
    if !tensor.valid(input) {
      return []
    }
    var out: list<int> = []
    for dim in tensor.dims(input) {
      if kind(dim) != "int" || int(dim) < 0 {
        return []
      }
      out += [int(dim)]
    }
    return out
  }

  if (callee == "onnx.Identity" || callee == "base.copy" ||
      callee == "onnx.Reshape" || callee == "tensor.reshape" ||
      callee == "onnx.Squeeze" || callee == "onnx.Unsqueeze" ||
      callee == "onnx.Ceil" || callee == "nn.ceil" ||
      callee == "onnx.Floor" || callee == "nn.floor") && len(inputs) >= 1 {
    return const_ints(inputs[0])
  }

  if (callee == "onnx.Slice" || callee == "tensor.slice") &&
     len(inputs) >= 1 && tensor.static(ir.type(inputs[0])) &&
     tensor.static(ir.type(value)) {
    let data = const_ints(inputs[0])
    if len(data) != static_count(ir.type(inputs[0])) { return [] }
    var starts = slice_starts(producer)
    var axes = slice_axes(producer)
    var steps = slice_steps(producer)
    if callee == "tensor.slice" && len(inputs) == 4 {
      starts = const_ints(inputs[1])
      axes = const_ints(inputs[2])
      steps = const_ints(inputs[3])
    }
    if len(starts) == 0 || len(starts) != len(axes) ||
       len(starts) != len(steps) { return [] }
    for step in steps { if step == 0 { return [] } }
    var out: list<int> = []
    for i in 0..count {
      let at = tensor.slice_offset(tensor.shape(ir.type(inputs[0])),
          tensor.shape(ir.type(value)), starts, axes, steps, i)
      if at < 0 || at >= len(data) { return [] }
      out += [data[at]]
    }
    return out
  }

  if (callee == "onnx.ConstantOfShape" || callee == "tensor.fill") &&
     count >= 0 {
    if callee == "tensor.fill" && len(inputs) == 1 {
      let fill = const_ints(inputs[0])
      if len(fill) == 1 {
        return splat(fill[0], count)
      }
      return []
    }
    let meta = attrs(producer)
    if !base.has(meta, "value") {
      return splat(0, count)
    }
    let value_attr = meta["value"]
    if base.kind(value_attr) != "dict" ||
       !base.has(value_attr, "data") ||
       base.kind(value_attr["data"]) != "bytes" {
      return []
    }
    let elem = tensor.elem(ir.type(value))
    var width = 0
    if elem == ty("i32") {
      width = 4
    }
    if elem == ty("i64") {
      width = 8
    }
    if width == 0 || base.size(value_attr["data"]) != width {
      return []
    }
    return splat(signed(value_attr["data"], 0, width), count)
  }

  var arithmetic = ""
  if callee == "onnx.Mul" || callee == "nn.mul" || callee == "base.operator *" {
    arithmetic = "mul"
  }
  if callee == "onnx.Add" || callee == "nn.add" { arithmetic = "add" }
  if callee == "onnx.Sub" || callee == "nn.sub" { arithmetic = "sub" }
  if callee == "onnx.Div" || callee == "nn.div" { arithmetic = "div" }
  if arithmetic != "" && len(inputs) == 2 && count >= 0 {
    let left = const_ints(inputs[0])
    let right = const_ints(inputs[1])
    if (len(left) != 1 && len(left) != count) ||
       (len(right) != 1 && len(right) != count) {
      return []
    }
    var out: list<int> = []
    for i in 0..count {
      let exact = exact_arithmetic(arithmetic,
          selected(left, i, count), selected(right, i, count))
      if len(exact) != 1 { return [] }
      let elem = tensor.elem(ir.type(value))
      if elem == ty("i32") && (exact[0] < -2147483648 || exact[0] > 2147483647) {
        return []
      }
      if elem == ty("f32") && (exact[0] < -16777216 || exact[0] > 16777216) {
        return []
      }
      if elem == ty("f64") &&
         (exact[0] < -9007199254740992 || exact[0] > 9007199254740992) { return [] }
      out += exact
    }
    return out
  }

  if (callee == "onnx.Equal" || callee == "operator ==") &&
     len(inputs) == 2 && count >= 0 {
    let left = const_ints(inputs[0])
    let right = const_ints(inputs[1])
    if (len(left) != 1 && len(left) != count) ||
       (len(right) != 1 && len(right) != count) {
      return []
    }
    var out: list<int> = []
    for i in 0..count {
      var equal = 0
      if selected(left, i, count) == selected(right, i, count) {
        equal = 1
      }
      out += [equal]
    }
    return out
  }

  if (callee == "onnx.Where" || callee == "nn.where") &&
     len(inputs) == 3 && count >= 0 {
    let condition = const_ints(inputs[0])
    let left = const_ints(inputs[1])
    let right = const_ints(inputs[2])
    if (len(condition) != 1 && len(condition) != count) ||
       (len(left) != 1 && len(left) != count) ||
       (len(right) != 1 && len(right) != count) {
      return []
    }
    var out: list<int> = []
    for i in 0..count {
      if selected(condition, i, count) != 0 {
        out += [selected(left, i, count)]
      } else {
        out += [selected(right, i, count)]
      }
    }
    return out
  }
  return []
}

local fn int_vector_len(value: Val) -> int {
  let type = ir.type(value)
  if !tensor.valid(type) ||
     (tensor.elem(type) != ty("i32") && tensor.elem(type) != ty("i64")) {
    return -1
  }
  let shape = tensor.dims(type)
  if len(shape) != 1 || kind(shape[0]) != "int" || int(shape[0]) < 0 {
    return -1
  }
  return int(shape[0])
}

local fn attr_ints(value: Attr) -> list<int> {
  var out: list<int> = []
  if base.kind(value) != "list" {
    return out
  }
  for item in value {
    if base.kind(item) != "int" {
      var invalid: list<int> = []
      return invalid
    }
    out += [base.int(item)]
  }
  return out
}

local fn element(code: int) -> Ty {
  var out = ty("_")
  if code == 1 {
    out = ty("f32")
  }
  if code == 2 {
    out = ty("u8")
  }
  if code == 3 {
    out = ty("i8")
  }
  if code == 4 {
    out = ty("u16")
  }
  if code == 5 {
    out = ty("i16")
  }
  if code == 6 {
    out = ty("i32")
  }
  if code == 7 {
    out = ty("i64")
  }
  if code == 9 {
    out = ty("bool")
  }
  if code == 10 {
    out = ty("f16")
  }
  if code == 11 {
    out = ty("f64")
  }
  if code == 12 {
    out = ty("u32")
  }
  if code == 13 {
    out = ty("u64")
  }
  if code == 16 {
    out = ty("bf16")
  }
  return out
}

local fn element_bytes(code: int) -> int {
  if code == 2 || code == 3 || code == 9 {
    return 1
  }
  if code == 4 || code == 5 || code == 10 || code == 16 {
    return 2
  }
  if code == 1 || code == 6 || code == 12 {
    return 4
  }
  if code == 7 || code == 11 || code == 13 {
    return 8
  }
  return 0
}

local fn constant_result(op: Op) -> Ty {
  let literal = tensor_literal(op)
  if base.kind(literal) != "dict" {
    return ty("_")
  }
  let code = base.int(literal["type"])
  let elem = element(code)
  let width = element_bytes(code)
  if elem == ty("_") || width == 0 {
    return ty("_")
  }
  let bytes = base.size(literal["data"])
  var count = 1
  var shape: list<Ty> = []
  for item in literal["shape"] {
    if base.kind(item) != "int" {
      return ty("_")
    }
    let dim = base.int(item)
    if dim < 0 {
      return ty("_")
    }
    if dim == 0 {
      count = 0
    } else {
      if count > bytes / width / dim {
        return ty("_")
      }
      count *= dim
    }
    shape += [ty(dim)]
  }
  if count * width != bytes {
    return ty("_")
  }
  return shaped(elem, shape)
}

[phase: "infer", on: "onnx.Constant"]
local fn constant_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], constant_result(op))
}

[phase: "infer", on: "onnx.ConstantOfShape"]
local fn constant_shape_type(m: Mod, op: Op) -> bool {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  if len(inputs) != 1 || len(outputs) != 1 {
    return false
  }
  let shape = shape_terms(inputs[0])
  if len(shape) == 0 {
    return false
  }
  var elem = ty("f32")
  let meta = attrs(op)
  if base.has(meta, "value") {
    elem = element(base.get(meta["value"], "type", 1))
  }
  if elem == ty("_") {
    return false
  }
  return set_type(m, outputs[0], shaped(elem, shape))
}
