local fn reduce_axes(op: Op, rank: int) -> list<int> {
  let meta = attrs(op)
  var axes: list<int> = []
  let inputs = ir.args(op)
  if len(inputs) == 2 {
    axes = const_ints(inputs[1])
    if len(axes) == 0 {
      let axes_type = ir.type(inputs[1])
      if !tensor.valid(axes_type) ||
         tensor.dims(axes_type) != [ty(0)] {
        return [rank]
      }
    }
  } else {
    if base.has(meta, "axes") {
      for value in meta["axes"] {
        axes += [value]
      }
    } else {
      for axis in 0..rank {
        axes += [axis]
      }
    }
  }
  if len(axes) == 0 && base.get(meta, "noop_with_empty_axes", 0) == 0 {
    for axis in 0..rank {
      axes += [axis]
    }
  }
  for index in 0..len(axes) {
    if axes[index] < 0 {
      axes[index] = axes[index] + rank
    }
  }
  return axes
}

local fn reduce_result(op: Op) -> Ty {
  let inputs = ir.args(op)
  if len(inputs) < 1 || len(inputs) > 2 {
    return ty("_")
  }
  let input = ir.type(inputs[0])
  if !tensor.valid(input) {
    return ty("_")
  }
  let shape = tensor.dims(input)
  let axes = reduce_axes(op, len(shape))
  if !tensor.valid_axes(axes, len(shape)) {
    return ty("_")
  }
  let keep = base.get(attrs(op), "keepdims", 1)
  if keep != 0 && keep != 1 {
    return ty("_")
  }
  return shaped(
    tensor.elem(input), tensor.reduced(shape, axes, keep == 1)
  )
}

[phase: "infer", on: [
  "onnx.ReduceMean", "onnx.ReduceSum", "onnx.ReduceMin", "onnx.ReduceMax",
  "onnx.ReduceL2"
]]
local fn reduce_type(m: Mod, op: Op) -> bool {
  let outputs = ir.outs(op)
  if len(outputs) != 1 {
    return false
  }
  return set_type(m, outputs[0], reduce_result(op))
}

[phase: "infer", on: "onnx.Loop"]
local fn loop_type(m: Mod, op: Op) -> bool {
  let body = onnx.graph(m, op, "body")
  if !ir.live(body) {
    return false
  }
  let info = base.get(attrs(op), "body", {})
  let inputs = base.get(info, "inputs", -1)
  let params = ir.params(body)
  let bodies = ir.blks(body)
  if len(bodies) != 1 {
    return false
  }
  let body_ops = ir.ops(bodies[0])
  if len(body_ops) == 0 ||
     ir.kind(body_ops[len(body_ops) - 1]) != "return" {
    return false
  }
  let returned = ir.args(body_ops[len(body_ops) - 1])
  let args = ir.args(op)
  let outputs = ir.outs(op)
  if inputs < 2 || len(params) < inputs ||
     len(args) < inputs {
    return false
  }
  var changed = set_type(m, params[0], ty("tensor<i64, []>"))
  changed = set_type(m, params[1], ty("tensor<bool, []>")) || changed
  for i in 2..inputs {
    changed = set_type(m, params[i], ir.type(args[i])) || changed
  }
  if len(returned) != len(outputs) + 1 {
    return changed
  }
  let carried = inputs - 2
  if carried > len(outputs) {
    return changed
  }
  var types: list<Ty> = []
  for i in 0..len(outputs) {
    var type = ir.type(returned[i + 1])
    if !tensor.valid(type) {
      return changed
    }
    if i >= carried {
      type = shaped(
        tensor.elem(type), [ty("_")] + tensor.dims(type)
      )
    }
    types += [type]
  }
  for i in 0..len(outputs) {
    changed = set_type(m, outputs[i], types[i]) || changed
  }
  return changed
}
