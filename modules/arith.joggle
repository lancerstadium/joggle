joggle 1;

module arith@2.0.0 {
  interface elementwise: fn;
  interface commutative: fn;
  interface comparison: fn;

  fn constant<T: prelude.scalar>(value: attr) -> T : prelude.literal;
  fn integer_literal<T: prelude.integer>(value: int) -> T : prelude.literal;
  fn real_literal<T: prelude.floating_point>(value: real) -> T : prelude.literal;
  fn real_integer_literal<T: prelude.floating_point>(value: int) -> T : prelude.literal;
  fn logical_literal<T: prelude.logical>(value: bool) -> T : prelude.literal;
  fn cast<From: prelude.scalar, To: prelude.scalar>(input: From) -> To : elementwise;
  fn negate<T: prelude.numeric>(input: T) -> T as - : elementwise;
  fn add<T: prelude.numeric>(lhs: T, rhs: T) -> T as + : elementwise, commutative;
  fn sub<T: prelude.numeric>(lhs: T, rhs: T) -> T as - : elementwise;
  fn mul<T: prelude.numeric>(lhs: T, rhs: T) -> T as * : elementwise, commutative;
  fn div<T: prelude.numeric>(lhs: T, rhs: T) -> T as / : elementwise;
  fn remainder<T: prelude.integer>(lhs: T, rhs: T) -> T as % : elementwise;
  fn bitwise_not<T: prelude.integer>(input: T) -> T as ~ : elementwise;
  fn bitwise_and<T: prelude.integer>(
    lhs: T,
    rhs: T
  ) -> T as & : elementwise, commutative;
  fn bitwise_or<T: prelude.integer>(lhs: T, rhs: T) -> T as | : elementwise, commutative;
  fn bitwise_xor<T: prelude.integer>(
    lhs: T,
    rhs: T
  ) -> T as ^ : elementwise, commutative;
  fn shift_left<T: prelude.integer>(input: T, amount: T) -> T as << : elementwise;
  fn shift_right<T: prelude.integer>(input: T, amount: T) -> T as >> : elementwise;
  fn logical_not<T: prelude.logical>(input: T) -> T as ! : elementwise;
  fn logical_and<T: prelude.logical>(
    lhs: T,
    rhs: T
  ) -> T as && : elementwise, commutative;
  fn logical_or<T: prelude.logical>(
    lhs: T,
    rhs: T
  ) -> T as || : elementwise, commutative;
  fn logical_xor<T: prelude.logical>(lhs: T, rhs: T) -> T : elementwise, commutative;
  fn min<T: prelude.numeric>(lhs: T, rhs: T) -> T : elementwise, commutative;
  fn max<T: prelude.numeric>(lhs: T, rhs: T) -> T : elementwise, commutative;
  fn equal<T: prelude.numeric>(
    lhs: T,
    rhs: T
  ) -> i1 as == : elementwise, comparison, commutative;
  fn logical_equal<T: prelude.logical>(
    lhs: T,
    rhs: T
  ) -> i1 as == : elementwise, comparison, commutative;
  fn not_equal<T: prelude.numeric>(
    lhs: T,
    rhs: T
  ) -> i1 as != : elementwise, comparison, commutative;
  fn logical_not_equal<T: prelude.logical>(
    lhs: T,
    rhs: T
  ) -> i1 as != : elementwise, comparison, commutative;
  fn less<T: prelude.numeric>(lhs: T, rhs: T) -> i1 as < : elementwise, comparison;
  fn less_equal<T: prelude.numeric>(
    lhs: T,
    rhs: T
  ) -> i1 as <= : elementwise, comparison;
  fn greater<T: prelude.numeric>(lhs: T, rhs: T) -> i1 as > : elementwise, comparison;
  fn greater_equal<T: prelude.numeric>(
    lhs: T,
    rhs: T
  ) -> i1 as >= : elementwise, comparison;
  fn select<T: type>(condition: i1, true_value: T, false_value: T) -> T : elementwise;
}
