module vm
use base
use ir
use opt
use tensor

fn run(image: str, entry: str, input: bytes) -> (bytes, int);

local fn scalar_name(name: str) -> bool {
  return name == "bool" || name == "i64" || name == "index" ||
         name == "int" || name == "f32" || name == "f64"
}

local fn scalar(type: Ty) -> bool {
  return scalar_name(base.name(type))
}

local fn format(type: Ty) -> str {
  let name = base.name(type)
  if name == "f32" || name == "f64" {
    return name
  }
  assert(name == "bool" || name == "i64" || name == "index" ||
         name == "int", "vm: unsupported scalar format " + text(type))
  return "i64"
}

local fn width(type: Ty) -> int {
  if format(type) == "f32" {
    return 4
  }
  return 8
}

local fn supported(type: Ty) -> bool {
  if scalar(type) {
    return true
  }
  return tensor.static(type) && scalar(tensor.elem(type))
}

local fn count(type: Ty) -> int {
  if !tensor.valid(type) {
    return 1
  }
  assert(tensor.static(type), "vm: tensor shape must be static: " + text(type))
  var out = 1
  for extent in tensor.shape(type) {
    out *= extent
  }
  return out
}

local fn storage(type: Ty) -> str {
  assert(supported(type), "vm: unsupported value type " + text(type))
  if tensor.valid(type) {
    return "t " + format(tensor.elem(type)) + " " + text(count(type))
  }
  return "s " + format(type)
}

local fn reg(value: Val) -> str {
  return text(ir.key(value))
}

local fn binary(name: str) -> str {
  let ops = {
    "operator +": "add", "operator -": "sub", "operator *": "mul",
    "operator /": "div", "operator %": "rem", "operator &": "and",
    "operator |": "or", "operator ^": "xor", "operator <<": "shl",
    "operator >>": "shr", "operator ==": "eq", "operator !=": "ne",
    "operator <": "lt", "operator <=": "le", "operator >": "gt",
    "operator >=": "ge", "operator &&": "land", "operator ||": "lor"
  }
  if has(ops, name) {
    return str(ops[name])
  }
  return ""
}

local fn unary(name: str) -> str {
  let ops = {
    "base.copy": "copy", "operator +": "copy", "operator -": "neg",
    "operator !": "lnot", "operator ~": "bnot"
  }
  if has(ops, name) {
    return str(ops[name])
  }
  return ""
}

local fn binding(fn: Fn) -> str {
  if !ir.live(fn) || !ir.has(fn, "vm") {
    return ""
  }
  let code = ir.meta(fn, "vm")
  assert(base.kind(code) == "str", "vm: binding opcode must be a string")
  return base.str(code)
}

local fn binary(m: Mod, op: Op) -> str {
  let direct = binary(ir.callee(op))
  if direct != "" {
    return direct
  }
  let target = ir.resolve(m, op)
  if ir.live(target) {
    return binding(target)
  }
  return ""
}

local fn unary(m: Mod, op: Op) -> str {
  let direct = unary(ir.callee(op))
  if direct != "" {
    return direct
  }
  let target = ir.resolve(m, op)
  if ir.live(target) {
    return binding(target)
  }
  return ""
}

local fn float_unary(code: str) -> bool {
  return code == "copy" || code == "neg" || code == "abs" ||
         code == "ceil" || code == "erf" || code == "exp" ||
         code == "floor" || code == "log" || code == "sqrt" ||
         code == "tanh"
}

local fn float_binary(code: str) -> bool {
  return code == "add" || code == "sub" || code == "mul" ||
         code == "div" || code == "rem" || code == "pow" ||
         code == "eq" || code == "ne" ||
         code == "lt" || code == "le" || code == "gt" || code == "ge"
}

fn accepts(m: Mod, op: Op) -> bool {
  if !ir.live(op) || ir.kind(op) != "call" {
    return false
  }
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let name = ir.callee(op)
  if name == "operator .." || name == "base.list" {
    return true
  }
  if name == "base.copy" {
    return len(inputs) == 1 && len(outputs) == 1 &&
           supported(ir.type(outputs[0])) &&
           ir.type(inputs[0]) == ir.type(outputs[0])
  }
  if name == "operator []" {
    if len(inputs) < 2 || len(outputs) != 1 ||
       !scalar(ir.type(outputs[0])) {
      return false
    }
    let type = ir.type(inputs[0])
    if base.name(type) == "list" {
      let types = base.args(type)
      let source = ir.def(inputs[0])
      return len(inputs) == 2 && len(types) == 1 && scalar(types[0]) &&
             ir.live(source) && ir.callee(source) == "base.list"
    }
    return tensor.static(type) && scalar(tensor.elem(type))
  }
  if name == "operator []=" {
    return len(inputs) >= 3 && len(outputs) == 1 &&
           tensor.static(ir.type(inputs[0])) &&
           ir.type(inputs[0]) == ir.type(outputs[0]) &&
           scalar(tensor.elem(ir.type(outputs[0])))
  }
  let target = ir.resolve(m, op)
  if len(inputs) == 1 && len(outputs) == 1 &&
     supported(ir.type(outputs[0])) && ir.live(target) &&
     ir.symbol(target) == "tensor.tensor" {
    return scalar(ir.type(inputs[0])) &&
           ir.type(inputs[0]) == tensor.elem(ir.type(outputs[0]))
  }
  if len(inputs) == 1 && len(outputs) == 1 &&
     tensor.static(ir.type(outputs[0])) && ir.is_const(inputs[0]) &&
     base.kind(ir.constant(inputs[0])) == "bytes" && ir.live(target) &&
     ir.symbol(target) == "tensor.literal" {
    return base.size(ir.constant(inputs[0])) ==
           count(ir.type(outputs[0])) * width(tensor.elem(ir.type(outputs[0])))
  }
  if len(inputs) == 1 && len(outputs) == 1 && scalar_name(name) &&
     scalar(ir.type(inputs[0])) {
    return true
  }
  if len(outputs) != 1 || !scalar(ir.type(outputs[0])) {
    return false
  }
  if len(inputs) == 1 && scalar(ir.type(inputs[0])) {
    let opcode = unary(m, op)
    if opcode == "" {
      return false
    }
    let type = format(ir.type(inputs[0]))
    return type == "i64" || float_unary(opcode)
  }
  if len(inputs) == 2 && scalar(ir.type(inputs[0])) &&
     scalar(ir.type(inputs[1])) {
    let opcode = binary(m, op)
    if opcode == "" {
      return false
    }
    let type = format(ir.type(inputs[0]))
    if opcode != "shl" && opcode != "shr" &&
       format(ir.type(inputs[1])) != type {
      return false
    }
    return type == "i64" || float_binary(opcode)
  }
  return false
}

local fn describe(op: Op) -> str {
  var out = ir.callee(op) + "("
  let inputs = ir.args(op)
  for i in 0..len(inputs) {
    if i != 0 {
      out += ", "
    }
    out += text(ir.type(inputs[i]))
  }
  out += ") -> ("
  let outputs = ir.outs(op)
  for i in 0..len(outputs) {
    if i != 0 {
      out += ", "
    }
    out += text(ir.type(outputs[i]))
  }
  return out + ")"
}

fn prepare(m: Mod) -> bool {
  let changed = opt.expose(m, ir.find("vm.accepts"), len(ir.ops(m)) + 1)
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "call" {
      assert(accepts(m, op),
             "vm: unsupported call remains: " + describe(op))
    }
  }
  return changed
}

local fn access(op: Op, store: bool) -> str {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  assert(len(outputs) == 1, "vm: tensor access must have one result")
  var indices = len(inputs) - 1
  if store {
    indices -= 1
  }
  assert(indices >= 1, "vm: tensor access needs an index")
  let type = ir.type(inputs[0])
  if base.name(type) == "list" {
    let types = base.args(type)
    assert(!store && indices == 1 && len(types) == 1 && scalar(types[0]),
           "vm: only scalar list reads are supported")
    let source = ir.def(inputs[0])
    assert(ir.live(source) && ir.kind(source) == "call" &&
           ir.callee(source) == "base.list",
           "vm: list read requires a literal list")
    let items = ir.args(source)
    var out = "pick " + format(types[0]) + " " +
              reg(outputs[0]) + " " +
              reg(inputs[1]) + " " + text(len(items))
    for item in items {
      out += " " + reg(item)
    }
    return out + "\n"
  }
  assert(tensor.static(type),
         "vm: tensor access requires a static tensor, got " + text(type))
  var shape = tensor.shape(type)
  if indices == 1 {
    shape = [count(type)]
  } else {
    assert(indices == len(shape), "vm: tensor index rank is inconsistent")
  }
  var out = "load "
  if store {
    out = "store "
  }
  out += reg(outputs[0]) + " " + reg(inputs[0]) +
         " " + text(len(shape))
  for extent in shape {
    out += " " + text(extent)
  }
  for i in 0..indices {
    out += " " + reg(inputs[i + 1])
  }
  if store {
    out += " " + reg(inputs[len(inputs) - 1])
  }
  return out + "\n"
}

local fn call(m: Mod, op: Op) -> str {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let name = ir.callee(op)
  if name == "operator .." || name == "base.list" {
    return ""
  }
  assert(accepts(m, op), "vm: call must be prepared: " + name)
  if name == "base.copy" {
    return "copy " + reg(outputs[0]) + " " + reg(inputs[0]) + "\n"
  }
  if name == "operator []" {
    return access(op, false)
  }
  if name == "operator []=" {
    return access(op, true)
  }
  assert(len(outputs) == 1,
         "vm: scalar instruction must have one result")
  let result = outputs[0]
  let target = ir.resolve(m, op)
  if tensor.valid(ir.type(result)) && ir.live(target) &&
     ir.symbol(target) == "tensor.tensor" {
    assert(len(inputs) == 1,
           "vm: tensor construction requires one fill value")
    return "alloc " + format(tensor.elem(ir.type(result))) + " " +
           reg(result) + " " +
           text(count(ir.type(result))) + " " +
           reg(inputs[0]) + "\n"
  }
  if tensor.valid(ir.type(result)) && ir.live(target) &&
     ir.symbol(target) == "tensor.literal" {
    assert(len(inputs) == 1 && ir.is_const(inputs[0]) &&
           base.kind(ir.constant(inputs[0])) == "bytes",
           "vm: tensor literal requires constant bytes")
    let data = ir.constant(inputs[0])
    assert(base.size(data) == count(ir.type(result)) *
           width(tensor.elem(ir.type(result))),
           "vm: tensor literal byte size does not match its type")
    return "literal " + format(tensor.elem(ir.type(result))) + " " +
           reg(result) + " " + text(count(ir.type(result))) +
           " " + text(data) + "\n"
  }
  if len(inputs) == 1 && scalar_name(name) && scalar(ir.type(inputs[0])) {
    return "cast " + format(ty(name)) + " " +
           reg(result) + " " +
           reg(inputs[0]) + "\n"
  }
  assert(scalar(ir.type(result)),
         "vm: unsupported result type " + text(ir.type(result)) +
         " from " + name)
  if len(inputs) == 1 {
    let opcode = unary(m, op)
    assert(opcode != "", "vm: unsupported unary call " + name)
    let type = format(ir.type(inputs[0]))
    assert(type == "i64" || float_unary(opcode),
           "vm: unsupported floating unary call " + name)
    if opcode == "copy" {
      return "copy " + reg(result) + " " +
             reg(inputs[0]) + "\n"
    }
    return opcode + " " + type + " " + reg(result) + " " +
           reg(inputs[0]) + "\n"
  }
  if len(inputs) == 2 {
    let opcode = binary(m, op)
    assert(opcode != "", "vm: unsupported binary call " + name)
    let type = format(ir.type(inputs[0]))
    assert(scalar(ir.type(inputs[1])),
           "vm: binary operands must be scalar")
    if opcode != "shl" && opcode != "shr" {
      assert(format(ir.type(inputs[1])) == type,
             "vm: binary operand formats must match")
    }
    assert(type == "i64" || float_binary(opcode),
           "vm: unsupported floating binary call " + name)
    return opcode + " " + type + " " + reg(result) + " " +
           reg(inputs[0]) + " " + reg(inputs[1]) +
           "\n"
  }
  assert(false, "vm: unsupported call " + name)
  return ""
}

local fn constant(op: Op) -> str {
  let outputs = ir.outs(op)
  assert(len(outputs) == 1, "vm: constant must have one result")
  let result = outputs[0]
  if !scalar(ir.type(result)) {
    assert(ir.type(result) == ty("bytes") &&
           base.kind(ir.constant(result)) == "bytes",
           "vm: unsupported constant type " + text(ir.type(result)))
    return ""
  }
  return "const " + format(ir.type(result)) + " " +
         reg(result) + " " + text(ir.constant(result)) + "\n"
}

local fn arm(m: Mod, body: Blk, carried: list<Val>,
       outputs: list<Val>) -> str {
  let args = ir.args(body)
  assert(len(args) == len(carried),
         "vm: branch carried values are inconsistent")
  var out = ""
  for i in 0..len(args) {
    out += "copy " + reg(args[i]) + " " +
           reg(carried[i]) + "\n"
  }
  out += block(m, body)
  let ops = ir.ops(body)
  assert(len(ops) != 0 && ir.kind(ops[len(ops) - 1]) == "yield",
         "vm: branch arm must yield")
  let yielded = ir.args(ops[len(ops) - 1])
  assert(len(yielded) == len(outputs),
         "vm: branch result count is inconsistent")
  for i in 0..len(outputs) {
    out += "copy " + reg(outputs[i]) + " " +
           reg(yielded[i]) + "\n"
  }
  return out
}

local fn branch(m: Mod, op: Op) -> str {
  let inputs = ir.args(op)
  let outputs = ir.outs(op)
  let bodies = ir.blks(op)
  assert(len(inputs) >= 1 && len(bodies) == 2,
         "vm: invalid branch structure")
  var carried: list<Val> = []
  for i in 1..len(inputs) {
    carried += [inputs[i]]
  }
  return "if " + reg(inputs[0]) + "\n" +
         arm(m, bodies[0], carried, outputs) + "else\n" +
         arm(m, bodies[1], carried, outputs) + "end\n"
}

local fn loop(m: Mod, op: Op) -> str {
  let bodies = ir.blks(op)
  assert(len(bodies) == 1, "vm: loop must have one body")
  let body = bodies[0]
  let args = ir.args(body)
  let sources = ir.args(op)
  let outputs = ir.outs(op)
  let iterators = len(args) - len(outputs)
  assert(iterators >= 1 && len(sources) == iterators + len(outputs),
         "vm: loop interface is inconsistent")
  var out = ""
  for i in 0..len(outputs) {
    out += "copy " + reg(outputs[i]) + " " +
           reg(sources[iterators + i]) + "\n"
  }
  for i in 0..iterators {
    let source = ir.def(sources[i])
    assert(ir.live(source) && ir.kind(source) == "call",
           "vm: loop source must be a call")
    let items = ir.args(source)
    if ir.callee(source) == "operator .." {
      assert(len(items) == 2, "vm: range must have two bounds")
      out += "loop " + reg(args[i]) + " " +
             reg(items[0]) + " " + reg(items[1]) +
             "\n"
    } else {
      assert(ir.callee(source) == "base.list",
             "vm: loop source must be a range or scalar list")
      out += "each " + reg(args[i]) + " " +
             format(ir.type(args[i])) + " " + text(len(items))
      for item in items {
        out += " " + reg(item)
      }
      out += "\n"
    }
  }
  for i in 0..len(outputs) {
    out += "copy " + reg(args[iterators + i]) + " " +
           reg(outputs[i]) + "\n"
  }
  out += block(m, body)
  let ops = ir.ops(body)
  assert(len(ops) != 0 && ir.kind(ops[len(ops) - 1]) == "yield",
         "vm: loop body must yield")
  let yielded = ir.args(ops[len(ops) - 1])
  assert(len(yielded) == len(outputs),
         "vm: loop result count is inconsistent")
  for i in 0..len(outputs) {
    out += "copy " + reg(outputs[i]) + " " +
           reg(yielded[i]) + "\n"
  }
  for i in 0..iterators {
    out += "end\n"
  }
  return out
}

local fn block(m: Mod, body: Blk) -> str {
  var out = ""
  for op in ir.ops(body) {
    let kind = ir.kind(op)
    if kind == "constant" {
      out += constant(op)
    } else {
      if kind == "call" {
        out += call(m, op)
      } else {
        if kind == "loop" {
          out += loop(m, op)
        } else {
          if kind == "branch" {
            out += branch(m, op)
          } else {
            if kind == "return" {
              let values = ir.args(op)
              assert(len(values) == 1,
                     "vm: function must return one value")
              out += "ret " + reg(values[0]) + " " +
                     storage(ir.type(values[0])) + "\n"
            } else {
              assert(kind == "yield", "vm: unsupported operation " + kind)
            }
          }
        }
      }
    }
  }
  return out
}

local fn definition(m: Mod, function: Fn) -> str {
  assert(len(ir.generics(function)) == 0,
         "vm: generic function must be specialized")
  let returns = ir.returns(function)
  assert(len(returns) == 1 && supported(returns[0]),
         "vm: function must return one supported value")
  var out = "fn " + ir.name(function) + "\n"
  for param in ir.params(function) {
    assert(supported(ir.type(param)),
           "vm: unsupported parameter type " + text(ir.type(param)))
    out += "param " + reg(param) + " " +
           storage(ir.type(param)) + "\n"
  }
  out += block(m, ir.blks(function)[0])
  return out + "endfn\n"
}

fn image(m: Mod) -> str {
  var out = "joggle-vm 3\n"
  var count = 0
  for function in ir.fns(m) {
    if len(ir.blks(function)) != 0 {
      out += definition(m, function)
      count += 1
    }
  }
  assert(count != 0, "vm: module has no executable function")
  return out
}

fn image(m: Mod, entry: str) -> str {
  let function = ir.find(m, entry)
  assert(ir.live(function) && len(ir.blks(function)) != 0,
         "vm: executable entry not found: " + entry)
  return "joggle-vm 3\n" + definition(m, function)
}
