joggle 1;

module bitpack@1.0.0 {
  import tensor@1 as t;

  type integer(bits: int, signed: bool = false) {
    storage_bits: int = bits;
  }
  type packed(
    logical: type,
    storage: type,
    axis: int,
    lanes: int,
    order: string = "lsb"
  );

  fn constant<T>(content: string) -> T {
    return t.constant(content);
  }
  fn conv<X, W, Y>(
    input: X,
    weight: W,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y {
    return t.conv(input, weight, strides, pads, dilations, group);
  }
  fn conv<X, W, B, Y>(
    input: X,
    weight: W,
    bias: B,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y {
    convolved: Y = t.conv(input, weight, bias, strides, pads, dilations, group);
    return convolved;
  }
  fn relu<T>(input: T) -> T {
    return t.relu(input);
  }
  fn max_pool<X, Y>(
    input: X,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    ceil_mode: bool
  ) -> Y {
    return t.max_pool(input, kernel, strides, pads, ceil_mode);
  }
  fn average_pool<X, Y>(
    input: X,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    ceil_mode: bool
  ) -> Y {
    return t.average_pool(input, kernel, strides, pads, ceil_mode);
  }
  fn concat<L, R, Y>(lhs: L, rhs: R, axis: int) -> Y {
    return t.concat(lhs, rhs, axis);
  }
  fn reshape<X, Y>(input: X, shape: list<int>) -> Y {
    return t.reshape(input, shape);
  }
  fn softmax<T>(input: T, axis: int) -> T {
    return t.softmax(input, axis);
  }
  fn encode(
    values: list<int>,
    element: type,
    storage: type,
    order: string = "lsb"
  ) -> bytes;
  fn decode(
    input: bytes,
    element: type,
    storage: type,
    order: string = "lsb"
  ) -> list<int>;
  fn run(input: function, storage: type, axis: int, order: string = "lsb") -> function;
}
