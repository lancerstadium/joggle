joggle 1;

mod nn@3.2.0 {
  import arith@2 as a;
  import tensor@8 as t;

  fn product(values: list<int>) -> int {
    result = 1;
    for value in values {
      result = result * value;
    }
    return result;
  }
  fn axis(value: int, rank: int) -> int {
    if value < 0 {
      return value + rank;
    }
    return value;
  }
  fn spatial_pads(
    input: list<int>,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    auto_pad: string
  ) -> list<int> {
    if auto_pad == "VALID" {
      return [0, 0, 0, 0];
    }
    if auto_pad == "SAME_UPPER" || auto_pad == "SAME_LOWER" {
      output_height = ceildiv(input[2], strides[0]);
      output_width = ceildiv(input[3], strides[1]);
      effective_height = dilations[0] * (kernel[0] - 1) + 1;
      effective_width = dilations[1] * (kernel[1] - 1) + 1;
      total_height = max(
        (output_height - 1) * strides[0] + effective_height - input[2],
        0
      );
      total_width = max((output_width - 1) * strides[1] + effective_width - input[3], 0);
      begin_height = total_height // 2;
      begin_width = total_width // 2;
      if auto_pad == "SAME_LOWER" {
        begin_height = total_height - begin_height;
        begin_width = total_width - begin_width;
      }
      return [
        begin_height,
        begin_width,
        total_height - begin_height,
        total_width - begin_width
      ];
    }
    return pads;
  }
  fn conv_pads(
    input: list<int>,
    weight: list<int>,
    kernel_shape: list<int>,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    auto_pad: string
  ) -> list<int> {
    kernel = kernel_shape;
    if length(kernel) == 0 {
      kernel = [weight[2], weight[3]];
    }
    return spatial_pads(input, kernel, strides, pads, dilations, auto_pad);
  }
  fn conv_shape(
    input: list<int>,
    weight: list<int>,
    kernel_shape: list<int>,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    auto_pad: string
  ) -> list<int> {
    kernel = kernel_shape;
    if length(kernel) == 0 {
      kernel = [weight[2], weight[3]];
    }
    actual_pads = conv_pads(input, weight, kernel, strides, pads, dilations, auto_pad);
    height = (input[2] + actual_pads[0] + actual_pads[2] -
       dilations[0] * (kernel[0] - 1) -
       1) //
      strides[0] +
      1;
    width = (input[3] + actual_pads[1] + actual_pads[3] - dilations[1] * (kernel[1] - 1) -
       1) //
      strides[1] +
      1;
    return [input[0], weight[0], height, width];
  }
  fn conv_step<E, X: list<int>, W: list<int>, S: list<int>, P: list<int>, D: list<int>>(
    input: t.tensor<E, X>,
    weight: t.tensor<E, W>,
    batch: index,
    output_channel: index,
    output_row: index,
    output_column: index,
    channel: index,
    kernel_row: index,
    kernel_column: index,
    strides: S,
    pads: P,
    dilations: D,
    group: int,
    sum: E
  ) -> E {
    zero: index = a.literal(0);
    one: index = a.literal(1);
    input_height: index = a.literal(X[2]);
    input_width: index = a.literal(X[3]);
    stride_row: index = a.literal(S[0]);
    stride_column: index = a.literal(S[1]);
    pad_row: index = a.literal(P[0]);
    pad_column: index = a.literal(P[1]);
    dilation_row: index = a.literal(D[0]);
    dilation_column: index = a.literal(D[1]);
    channels_per_group: index = a.literal(W[1]);
    outputs_per_group: index = a.literal(W[0] // group);
    group_index = output_channel // outputs_per_group;
    input_channel = group_index * channels_per_group + channel;
    input_row = output_row * stride_row + kernel_row * dilation_row - pad_row;
    input_column = output_column * stride_column + kernel_column * dilation_column -
      pad_column;
    safe_row = a.min(a.max(input_row, zero), input_height - one);
    safe_column = a.min(a.max(input_column, zero), input_width - one);
    valid_row = input_row == safe_row;
    valid_column = input_column == safe_column;
    input_value = input[batch, input_channel, safe_row, safe_column];
    weight_value = weight[output_channel, channel, kernel_row, kernel_column];
    product = input_value * weight_value;
    return sum + a.select(valid_row && valid_column, product, a.zero(product));
  }
  fn conv_sum<
    E,
    X: list<int>,
    W: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    D: list<int>
  >(
    input: t.tensor<E, X>,
    weight: t.tensor<E, W>,
    batch: index,
    output_channel: index,
    output_row: index,
    output_column: index,
    kernel_shape: K,
    strides: S,
    pads: P,
    dilations: D,
    group: int,
    initial: E
  ) -> E {
    kernel = K;
    if length(kernel) == 0 {
      kernel = [W[2], W[3]];
    }
    return t.reduce(
      W[1],
      initial,
      (sum_channel, channel) =>
        t.reduce(
          kernel[0],
          sum_channel,
          (sum_row, kernel_row) =>
            t.reduce(
              kernel[1],
              sum_row,
              (sum, kernel_column) =>
                conv_step(
                  input,
                  weight,
                  batch,
                  output_channel,
                  output_row,
                  output_column,
                  channel,
                  kernel_row,
                  kernel_column,
                  S,
                  P,
                  D,
                  group,
                  sum
                )
            )
        )
    );
  }
  fn pool_shape(
    input: list<int>,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    ceil_mode: int,
    auto_pad: string
  ) -> list<int> {
    actual_pads = spatial_pads(input, kernel, strides, pads, dilations, auto_pad);
    height_size = input[2] + actual_pads[0] + actual_pads[2] -
      dilations[0] * (kernel[0] - 1) -
      1;
    width_size = input[3] + actual_pads[1] + actual_pads[3] -
      dilations[1] * (kernel[1] - 1) -
      1;
    height = height_size // strides[0] + 1;
    width = width_size // strides[1] + 1;
    if ceil_mode == 1 {
      height = ceildiv(height_size, strides[0]) + 1;
      width = ceildiv(width_size, strides[1]) + 1;
      if (height - 1) * strides[0] >= input[2] + actual_pads[0] {
        height = height - 1;
      }
      if (width - 1) * strides[1] >= input[3] + actual_pads[1] {
        width = width - 1;
      }
    }
    return [input[0], input[1], height, width];
  }
  fn pool_point<E, X: list<int>, S: list<int>, P: list<int>, D: list<int>>(
    input: t.tensor<E, X>,
    batch: index,
    channel: index,
    output_row: index,
    output_column: index,
    kernel_row: index,
    kernel_column: index,
    strides: S,
    pads: P,
    dilations: D
  ) -> (E, i1) {
    zero: index = a.literal(0);
    one: index = a.literal(1);
    input_height: index = a.literal(X[2]);
    input_width: index = a.literal(X[3]);
    stride_row: index = a.literal(S[0]);
    stride_column: index = a.literal(S[1]);
    pad_row: index = a.literal(P[0]);
    pad_column: index = a.literal(P[1]);
    dilation_row: index = a.literal(D[0]);
    dilation_column: index = a.literal(D[1]);
    input_row = output_row * stride_row + kernel_row * dilation_row - pad_row;
    input_column = output_column * stride_column + kernel_column * dilation_column -
      pad_column;
    safe_row = a.min(a.max(input_row, zero), input_height - one);
    safe_column = a.min(a.max(input_column, zero), input_width - one);
    valid = input_row == safe_row && input_column == safe_column;
    return input[batch, channel, safe_row, safe_column], valid;
  }
  fn max_pool_value<
    E,
    X: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    D: list<int>
  >(
    input: t.tensor<E, X>,
    batch: index,
    channel: index,
    output_row: index,
    output_column: index,
    kernel: K,
    strides: S,
    pads: P,
    dilations: D
  ) -> E {
    zero: index = a.literal(0);
    initial, valid = pool_point(
      input,
      batch,
      channel,
      output_row,
      output_column,
      zero,
      zero,
      S,
      P,
      D
    );
    return t.reduce(
      K[0],
      initial,
      (row_max, kernel_row) =>
        t.reduce(
          K[1],
          row_max,
          (value_max, kernel_column) => {
            value, point_valid = pool_point(
              input,
              batch,
              channel,
              output_row,
              output_column,
              kernel_row,
              kernel_column,
              S,
              P,
              D
            );
            return a.max(value_max, value);
          }
        )
    );
  }
  fn average_pool_sum<
    E,
    X: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    D: list<int>
  >(
    input: t.tensor<E, X>,
    batch: index,
    channel: index,
    output_row: index,
    output_column: index,
    kernel: K,
    strides: S,
    pads: P,
    dilations: D,
    count: bool
  ) -> E {
    initial: E = a.zero();
    return t.reduce(
      K[0],
      initial,
      (row_sum, kernel_row) =>
        t.reduce(
          K[1],
          row_sum,
          (sum, kernel_column) => {
            value, valid = pool_point(
              input,
              batch,
              channel,
              output_row,
              output_column,
              kernel_row,
              kernel_column,
              S,
              P,
              D
            );
            contribution = a.select(valid, value, a.zero(value));
            if count {
              one: E = a.literal(1);
              contribution = a.select(valid, one, a.zero(one));
            }
            return sum + contribution;
          }
        )
    );
  }
  fn concat_shape(lhs: list<int>, rhs: list<int>, selected_axis: int) -> list<int> {
    selected = axis(selected_axis, length(lhs));
    result: list<int> = [];
    for position in range(length(lhs)) {
      extent = lhs[position];
      if position == selected {
        extent = extent + rhs[position];
      }
      result = append(result, extent);
    }
    return result;
  }
  fn reshape_shape(input: list<int>, requested: list<int>) -> list<int> {
    known = 1;
    for position in range(length(requested)) {
      extent = requested[position];
      if extent == 0 {
        extent = input[position];
      }
      if extent != -1 {
        known = known * extent;
      }
    }
    count = product(input);
    result: list<int> = [];
    for position in range(length(requested)) {
      extent = requested[position];
      if extent == 0 {
        extent = input[position];
      }
      if extent == -1 {
        extent = count // known;
      }
      result = append(result, extent);
    }
    return result;
  }
  fn flatten_shape(input: list<int>, selected_axis: int) -> list<int> {
    selected = axis(selected_axis, length(input));
    outer = 1;
    inner = 1;
    for position in range(length(input)) {
      if position < selected {
        outer = outer * input[position];
      } else {
        inner = inner * input[position];
      }
    }
    return [outer, inner];
  }
  pub fn matmul<E, M: int, K: int, N: int>(
    lhs: t.tensor<E, [M, K]>,
    rhs: t.tensor<E, [K, N]>
  ) -> t.tensor<E, [M, N]> {
    return t.tensor(
      [M, N],
      (row, column) => {
        initial: E = a.zero();
        return t.reduce(
          K,
          initial,
          (sum, inner) => sum + lhs[row, inner] * rhs[inner, column]
        );
      }
    );
  }
  pub fn relu<E, S: list<int>>(input: t.tensor<E, S>) -> t.tensor<E, S> {
    return t.map(input, (value) => a.max(value, a.zero(value)));
  }
  pub fn conv<
    E,
    X: list<int>,
    W: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    D: list<int>,
    A: string
  >(
    input: t.tensor<E, X>,
    weight: t.tensor<E, W>,
    kernel_shape: K = [],
    strides: S = [1, 1],
    pads: P = [0, 0, 0, 0],
    dilations: D = [1, 1],
    group: int = 1,
    auto_pad: A = "NOTSET"
  ) -> t.tensor<E, @conv_shape(X, W, K, S, P, D, A)> {
    actual_pads = @conv_pads(X, W, K, S, P, D, auto_pad);
    return t.tensor(
      @conv_shape(X, W, K, S, actual_pads, D, "NOTSET"),
      (batch, output_channel, row, column) =>
        conv_sum(
          input,
          weight,
          batch,
          output_channel,
          row,
          column,
          K,
          S,
          actual_pads,
          D,
          group,
          a.zero()
        )
    );
  }
  pub fn conv<
    E,
    X: list<int>,
    W: list<int>,
    B: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    D: list<int>,
    A: string
  >(
    input: t.tensor<E, X>,
    weight: t.tensor<E, W>,
    bias: t.tensor<E, B>,
    kernel_shape: K = [],
    strides: S = [1, 1],
    pads: P = [0, 0, 0, 0],
    dilations: D = [1, 1],
    group: int = 1,
    auto_pad: A = "NOTSET"
  ) -> t.tensor<E, @conv_shape(X, W, K, S, P, D, A)> {
    actual_pads = @conv_pads(X, W, K, S, P, D, auto_pad);
    return t.tensor(
      @conv_shape(X, W, K, S, actual_pads, D, "NOTSET"),
      (batch, output_channel, row, column) =>
        conv_sum(
          input,
          weight,
          batch,
          output_channel,
          row,
          column,
          K,
          S,
          actual_pads,
          D,
          group,
          bias[output_channel]
        )
    );
  }
  pub fn max_pool<
    E,
    X: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    C: int,
    A: string,
    D: list<int>
  >(
    input: t.tensor<E, X>,
    kernel_shape: K,
    strides: S = [1, 1],
    pads: P = [0, 0, 0, 0],
    ceil_mode: C = 0,
    auto_pad: A = "NOTSET",
    dilations: D = [1, 1],
    storage_order: int = 0
  ) -> t.tensor<E, @pool_shape(X, K, S, P, D, C, A)> {
    actual_pads = @spatial_pads(X, K, S, P, D, auto_pad);
    return t.tensor(
      @pool_shape(X, K, S, actual_pads, D, ceil_mode, "NOTSET"),
      (batch, channel, row, column) =>
        max_pool_value(input, batch, channel, row, column, K, S, actual_pads, D)
    );
  }
  pub fn average_pool<
    E,
    X: list<int>,
    K: list<int>,
    S: list<int>,
    P: list<int>,
    C: int,
    A: string
  >(
    input: t.tensor<E, X>,
    kernel_shape: K,
    strides: S = [1, 1],
    pads: P = [0, 0, 0, 0],
    ceil_mode: C = 0,
    auto_pad: A = "NOTSET",
    count_include_pad: int = 0
  ) -> t.tensor<E, @pool_shape(X, K, S, P, [1, 1], C, A)> {
    actual_pads = @spatial_pads(X, K, S, P, [1, 1], auto_pad);
    return t.tensor(
      @pool_shape(X, K, S, actual_pads, [1, 1], ceil_mode, "NOTSET"),
      (batch, channel, row, column) => {
        sum = average_pool_sum(
          input,
          batch,
          channel,
          row,
          column,
          K,
          S,
          actual_pads,
          [1, 1],
          false
        );
        divisor: E = a.literal(K[0] * K[1]);
        if count_include_pad == 0 {
          divisor = average_pool_sum(
            input,
            batch,
            channel,
            row,
            column,
            K,
            S,
            actual_pads,
            [1, 1],
            true
          );
        }
        return sum / divisor;
      }
    );
  }
  pub fn global_average_pool<E, X: list<int>>(
    input: t.tensor<E, X>
  ) -> t.tensor<E, [X[0], X[1], 1, 1]> {
    return average_pool(input, [X[2], X[3]]);
  }
  pub fn concat<E, L: list<int>, R: list<int>, A: int>(
    lhs: t.tensor<E, L>,
    rhs: t.tensor<E, R>,
    axis: A
  ) -> t.tensor<E, @concat_shape(L, R, A)>;
  pub fn reshape<E, X: list<int>, R: list<int>>(
    input: t.tensor<E, X>,
    shape: R
  ) -> t.tensor<E, @reshape_shape(X, R)>;
  pub fn flatten<E, X: list<int>, A: int>(
    input: t.tensor<E, X>,
    axis: A = 1
  ) -> t.tensor<E, @flatten_shape(X, A)>;
  pub fn softmax<E, X: list<int>>(
    input: t.tensor<E, X>,
    axis: int = -1
  ) -> t.tensor<E, X>;
  pub fn dropout<T>(input: T, ratio: real = 0.5) -> T {
    return input;
  }
}
