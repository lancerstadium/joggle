joggle 1;

mod tensor@5.0.0 {
  type tensor(element: type, shape: list<int>);

  fn compute<E, S: list<int>>(
    shape: S,
    body: (list<index>) -> E
  ) -> tensor<E, S>;
  fn ([])<E, S: list<int>>(
    input: tensor<E, S>,
    indices: index...
  ) -> E;
  fn ([])<E, S: list<int>>(
    input: tensor<E, S>,
    indices: list<index>
  ) -> E;
  fn ([])(indices: list<index>, position: int) -> index;
}
