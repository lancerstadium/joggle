joggle 1;

mod tensor@3.0.0 {
  type tensor(element: type, shape: list<int>);
  type coord(shape: list<int>);

  fn coord<S: list<int>>(shape: S, values: index...) -> coord<S>;
  fn ([])<S: list<int>>(position: coord<S>, axis: int) -> index;
  fn build<E, S: list<int>>(shape: S, body: (coord<S>) -> E) -> tensor<E, S>;
  fn at<E, S: list<int>>(input: tensor<E, S>, position: coord<S>) -> E;
  fn ([])<E, S: list<int>>(input: tensor<E, S>, position: coord<S>) -> E {
    return at(input, position);
  }
  fn fold<A, S: list<int>>(initial: A, body: (A, coord<S>) -> A, shape: S) -> A;
  fn map<E, S: list<int>, R>(input: tensor<E, S>, body: (E) -> R) -> tensor<R, S> {
    return build(S, (position: coord<S>) => body(at(input, position)));
  }
}
