joggle 1;

mod tensor@2.0.0 {
  type tensor(element: type, shape: list<int>);
  type coord(shape: list<int>);

  fn build<E, S: list<int>>(
    body: (coord<S>) -> E
  ) -> tensor<E, S>;
  fn at<E, S: list<int>>(
    input: tensor<E, S>,
    position: coord<S>
  ) -> E;
  fn fold<A, S: list<int>>(
    initial: A,
    body: (A, coord<S>) -> A,
    shape: S
  ) -> A;

  fn map<E, S: list<int>, R>(
    input: tensor<E, S>,
    body: (E) -> R
  ) -> tensor<R, S> {
    return build(
      (position: coord<S>) => body(at(input, position))
    );
  }
}
