joggle 1;

mod tensor@1.1.0 {
  type tensor(element: type, shape: list<int>);
  type coord(shape: list<int>);

  fn generate<E, S: list<int>>(
    body: (coord<S>) -> E
  ) -> tensor<E, S>;
  fn at<E, S: list<int>>(
    input: tensor<E, S>,
    position: coord<S>
  ) -> E;
  fn zero<T>(like: T) -> T;
  fn max<T>(lhs: T, rhs: T) -> T;

  fn map<E, S: list<int>, R>(
    input: tensor<E, S>,
    body: (E) -> R
  ) -> tensor<R, S> {
    return generate(
      (position: coord<S>) => body(at(input, position))
    );
  }

  fn relu_value<T>(input: T) -> T {
    return max(input, zero(input));
  }

  fn constant<T>(content: string) -> T;
  fn conv<X, W, Y>(
    input: X,
    weight: W,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y;
  fn conv<X, W, B, Y>(
    input: X,
    weight: W,
    bias: B,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y;
  fn relu<E, S: list<int>>(
    input: tensor<E, S>
  ) -> tensor<E, S> {
    return generate(
      (position: coord<S>) =>
        relu_value(at(input, position))
    );
  }
  fn max_pool<X, Y>(
    input: X,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    ceil_mode: bool
  ) -> Y;
  fn average_pool<X, Y>(
    input: X,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    ceil_mode: bool
  ) -> Y;
  fn concat<L, R, Y>(lhs: L, rhs: R, axis: int) -> Y;
  fn reshape<X, Y>(input: X, shape: list<int>) -> Y;
  fn softmax<T>(input: T, axis: int) -> T;
  fn (+)<L, R, Y>(lhs: L, rhs: R) -> Y;
  fn (*)<L, R, Y>(lhs: L, rhs: R) -> Y;
}
