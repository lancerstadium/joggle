joggle 1;

mod onnx@2.0.0 {
  import arith@1 as a;
  import tensor@2 as t;

  fn read(input: bytes, name: string = "model") -> mod;

  fn Constant<T>(content: string) -> T;
  fn Conv<X, W, Y>(
    input: X,
    weight: W,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y;
  fn Conv<X, W, B, Y>(
    input: X,
    weight: W,
    bias: B,
    strides: list<int>,
    pads: list<int>,
    dilations: list<int>,
    group: int
  ) -> Y;
  fn Relu<E, S: list<int>>(
    input: t.tensor<E, S>
  ) -> t.tensor<E, S> {
    return t.map(
      input,
      (value: E) => a.max(value, a.zero(value))
    );
  }
  fn MaxPool<X, Y>(
    input: X,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    ceil_mode: bool
  ) -> Y;
  fn AveragePool<X, Y>(
    input: X,
    kernel: list<int>,
    strides: list<int>,
    pads: list<int>,
    ceil_mode: bool
  ) -> Y;
  fn Concat<L, R, Y>(lhs: L, rhs: R, axis: int) -> Y;
  fn Reshape<X, Y>(input: X, shape: list<int>) -> Y;
  fn Softmax<T>(input: T, axis: int) -> T;
}
