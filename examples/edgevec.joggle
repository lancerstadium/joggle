joggle 1;

module edgevec@1.0.0 {
  import tensor@1;
  import nn@1;

  interface lane_op: op {
    lanes() -> i64;
    cycles() -> i64;
  }

  op dot<E: type, N: i64, K: i64, M: i64>(
    input: tensor.tensor<E, [N, K]>,
    weight: tensor.tensor<E, [M, K]>,
    bias: tensor.tensor<E, [M]>,
    lanes: i64 = 4
  ) -> tensor.tensor<E, [N, M]> : lane_op;
  op clamp<E: type, S: list<i64>>(
    input: tensor.tensor<E, S>,
    lanes: i64 = 4
  ) -> tensor.tensor<E, S> : lane_op;

  pass lower;
}
