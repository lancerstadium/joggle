joggle 1;

module miniai@1.0.0 {
  import bitmath@1 as math;

  type tensor(element: type, shape: list<i64>);
  attr tensor_data(values: list<i64>);

  op input<E: type, S: list<i64>>(name: string) -> tensor<E, S>;
  op parameter<E: type, S: list<i64>>(name: string, data: attr) -> tensor<E, S>;
  op reshape<E: type, From: list<i64>, To: list<i64>>(
    input: tensor<E, From>,
    shape: To
  ) -> tensor<E, To>;
  op dense<E: type, N: i64, K: i64, M: i64>(
    input: tensor<E, [N, K]>,
    weight: tensor<E, [M, K]>,
    bias: tensor<E, [M]>
  ) -> tensor<E, [N, M]>;
  op relu<E: type, S: list<i64>>(
    input: tensor<E, S>
  ) -> tensor<E, S> : math.elementwise;

  pass simplify {
    relu(relu($input)) => relu($input);
  }
  pass optimize = simplify, math.canonicalize;
}
