module compact
use ir
use nn
use opt
use tensor

[impl: "compact"]
fn nn.conv2d<
  E: Ty,
  X: list<int>, K: list<int>, B: list<int>, Y: list<int>
>(
  x: tensor<E, X>,
  weight: tensor<E, K>,
  values: tensor<E, B>,
  stride: list<int>,
  pad: list<int>,
  dilation: list<int>,
  groups: int,
  x_axes: list<int>,
  weight_axes: list<int>,
  out_axes: list<int>,
  activation: str
) -> tensor<E, Y> {
  let n_size = tensor.extent(X, x_axes, 0)
  let h_size = tensor.extent(X, x_axes, 2)
  let w_size = tensor.extent(X, x_axes, 3)
  let m_size = tensor.extent(Y, out_axes, 1)
  let q_size = tensor.extent(K, weight_axes, 1)
  let r_size = tensor.extent(K, weight_axes, 2)
  let s_size = tensor.extent(K, weight_axes, 3)
  let oh_size = tensor.extent(Y, out_axes, 2)
  let ow_size = tensor.extent(Y, out_axes, 3)
  var out = tensor<E, Y>(E(0))
  for n in 0..n_size, m in 0..m_size, q in 0..q_size,
      r in 0..r_size, s in 0..s_size,
      oh in 0..oh_size, ow in 0..ow_size {
    let h = oh * stride[0] + r * dilation[0] - pad[0]
    let w = ow * stride[1] + s * dilation[1] - pad[1]
    if h >= 0 && h < h_size && w >= 0 && w < w_size {
      let c = (m / (m_size / groups)) * q_size + q
      let xi = tensor.offset(X, x_axes, [n, c, h, w])
      let wi = tensor.offset(K, weight_axes, [m, q, r, s])
      let yi = tensor.offset(Y, out_axes, [n, m, oh, ow])
      out[yi] = out[yi] + x[xi] * weight[wi]
    }
  }
  for i in 0..tensor.numel<Y>() {
    let channel = tensor.coord(Y, out_axes, i, 1)
    var value = out[i] + values[channel]
    if activation == "RELU" || activation == "RELU6" {
      if value < E(0) {
        value = E(0)
      }
    }
    if activation == "RELU6" {
      if value > E(6) {
        value = E(6)
      }
    }
    if activation == "RELU_N1_TO_1" {
      if value < E(-1) {
        value = E(-1)
      }
      if value > E(1) {
        value = E(1)
      }
    }
    out[i] = value
  }
  return out
}

fn impls() -> list<Fn> {
  return ir.where(ir.fns("compact"), "impl", "compact")
}

fn apply(m: Mod) -> bool {
  return opt.instantiate(m, impls())
}
