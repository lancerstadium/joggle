joggle 1;

module nn@1.0.0 {
  import arith@1;
  import tensor@1;

  op linear<E: type, N: i64, K: i64, M: i64>(
    input: tensor.tensor<E, [N, K]>,
    weight: tensor.tensor<E, [M, K]>,
    bias: tensor.tensor<E, [M]>
  ) -> tensor.tensor<E, [N, M]>;
  op relu<E: type, S: list<i64>>(
    input: tensor.tensor<E, S>
  ) -> tensor.tensor<E, S> : arith.elementwise;

  pass canonicalize {
    relu(relu($input)) => relu($input);
  }
}
