module edge
use ir
use opt
use tensor

[c: {name: "edge_matmul"}]
fn matmul<E: Ty, M: int, N: int, K: int>(
  a: tensor<E, [M, K]>,
  b: tensor<E, [K, N]>,
  rows: int,
  columns: int,
  inner: int
) -> tensor<E, [M, N]>;

fn tensor.matmul<E: Ty, M: int, N: int, K: int>(
  a: tensor<E, [M, K]>, b: tensor<E, [K, N]>
) -> tensor<E, [M, N]> {
  return matmul(a, b, M, N, K)
}

[c: {name: "edge_extrema"}]
fn model.measure(x: tensor<f32, [4]>) -> (f32, f32);

fn apply(m: Mod) -> bool {
  return opt.apply(m, ir.fns("edge"))
}
