joggle 1;

mod matmul_relu@1.0.0 {
  import nn@2 as n;
  import tensor@7 as t;

  fn model(
    lhs: t.tensor<f32, [2, 4]>,
    rhs: t.tensor<f32, [4, 3]>
  ) -> t.tensor<f32, [2, 3]> {
    product = n.matmul(lhs, rhs);
    return n.relu(product);
  }

  fn prepare(input: fn) -> fn {
    fused = @t.fuse(input);
    return @t.loops(fused);
  }
}
