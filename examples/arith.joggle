joggle 1;

module arith@1.0.0 {
  interface numeric_format: type {
    storage_bits() -> i64;
    is_signed() -> bool;
  }
  interface elementwise: op;
  interface commutative: op;

  type integer(width: i64, signed: bool = false) : numeric_format;

  op cast<T: type>(input: T) -> T : elementwise;
  op add<T: type>(lhs: T, rhs: T) -> T : elementwise, commutative;

  pass canonicalize {
    cast($input) => $input;
  }
}
