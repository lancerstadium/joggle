module spatial
use ir
use opt
use tile

local fn block_order(m: Mod, op: Op, inner: int) -> list<int> {
  let state = tile.state_axes(m, op)
  let extents = tile.extents(m, op)
  if inner <= 0 || len(state) <= inner ||
     len(extents) <= len(state) {
    return []
  }
  var reduction: list<int> = []
  var state_index = 0
  for axis in 0..len(extents) {
    if state_index < len(state) && state[state_index] == axis {
      state_index += 1
    } else {
      reduction += [axis]
    }
  }
  var out: list<int> = []
  for i in 0..len(state) - inner {
    out += [state[i]]
  }
  out += reduction
  for i in len(state) - inner..len(state) {
    out += [state[i]]
  }
  return out
}

local fn same_order(left: list<int>, right: list<int>) -> bool {
  if len(left) != len(right) {
    return false
  }
  for i in 0..len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}

local fn interleave(
  state: list<int>, reduction: list<int>, inner: int
) -> list<int> {
  var out: list<int> = []
  for i in 0..len(state) - inner {
    out += [state[i]]
  }
  out += reduction
  for i in len(state) - inner..len(state) {
    out += [state[i]]
  }
  return out
}

local fn locality_scores(m: Mod, op: Op) -> list<int> {
  let axes = len(tile.extents(m, op))
  let forms = tile.read_forms(m, op) + tile.write_forms(m, op)
  if axes == 0 || len(forms) == 0 {
    return []
  }
  var scores: list<int> = []
  for axis in 0..axes {
    scores += [0]
  }
  for form in forms {
    if len(form) != axes + 1 {
      return []
    }
    for axis in 0..axes {
      let coefficient = form[axis + 1]
      if coefficient == 1 || coefficient == -1 {
        scores[axis] = scores[axis] + 3
      } else {
        if coefficient == 0 {
          scores[axis] = scores[axis] + 1
        }
      }
    }
  }
  return scores
}

local fn locality(order: list<int>, scores: list<int>) -> int {
  var out = 0
  for position in 0..len(order) {
    out += (position + 1) * scores[order[position]]
  }
  return out
}

fn choose(m: Mod, op: Op) -> list<int> {
  let state = tile.state_axes(m, op)
  let reduction = tile.reduction_axes(m, op)
  let scores = locality_scores(m, op)
  if len(state) == 0 || len(reduction) == 0 || len(scores) == 0 {
    return []
  }
  var identity: list<int> = []
  for axis in 0..len(scores) {
    identity += [axis]
  }
  var best = identity
  var best_score = locality(identity, scores)
  for inner in 0..len(state) + 1 {
    let candidate = interleave(state, reduction, inner)
    let score = locality(candidate, scores)
    if score > best_score && tile.can_reorder(m, op, candidate) {
      best = candidate
      best_score = score
    }
  }
  if !same_order(best, identity) {
    return best
  }
  return []
}

local fn axis_names(op: Op, order: list<int>) -> list<str> {
  let body = ir.blks(op)[0]
  let args = ir.args(body)
  var out: list<str> = []
  for axis in order {
    out += [ir.name(args[axis])]
  }
  return out
}

// Describe every loop for which the locality policy has enough structural
// evidence. The result is serializable compile-time data, not a schedule IR.
fn plan(m: Mod) -> dict {
  let before = ir.revision(m)
  var rows: list<dict> = []
  for fn in ir.fns(m) {
    for op in ir.ops(fn) {
      if ir.kind(op) == "loop" {
        let state = tile.state_axes(m, op)
        let reduction = tile.reduction_axes(m, op)
        let scores = locality_scores(m, op)
        if len(state) != 0 && len(reduction) != 0 && len(scores) != 0 {
          var current: list<int> = []
          for axis in 0..len(scores) {
            current += [axis]
          }
          var selected = choose(m, op)
          let changed = len(selected) != 0
          if !changed {
            selected = current
          }
          var row: dict = {}
          row["fn"] = ir.name(fn)
          row["current"] = axis_names(op, current)
          row["selected"] = axis_names(op, selected)
          row["extents"] = tile.extents(m, op)
          row["scores"] = scores
          row["reads"] = tile.read_forms(m, op)
          row["writes"] = tile.write_forms(m, op)
          row["scalar_cost"] = tile.scalar_cost(m, op)
          row["changed"] = changed
          rows += [row]
        }
      }
    }
  }
  var out: dict = {}
  out["revision"] = before
  out["candidates"] = len(rows)
  out["loops"] = rows
  assert(ir.revision(m) == before,
         "spatial.plan changed the module")
  return out
}

fn apply(m: Mod) -> bool {
  return tile.reorder(m, ir.find("spatial.choose"))
}

// Strip-mine the innermost result and reduction axes of ordinary rank-three
// contractions. This is policy: structural legality remains in tile and the
// factors remain explicit experimental choices.
fn cache(m: Mod, columns: int, depth: int) -> bool {
  assert(columns > 1 && depth > 1,
         "spatial.cache requires factors greater than one")
  let candidates = ir.ops(m)
  var changed = false
  for source in candidates {
    if ir.live(source) && ir.kind(source) == "loop" &&
       tile.state_axes(m, source) == [0, 1] &&
       tile.reduction_axes(m, source) == [2] {
      let shape = tile.extents(m, source)
      if len(shape) == 3 && shape[1] % columns == 0 &&
         shape[2] % depth == 0 {
        let column_tiles = tile.split(m, source, 1, columns)
        let depth_tiles = tile.split(m, column_tiles, 3, depth)
        let ordered = tile.reorder(m, depth_tiles, [0, 1, 3, 4, 2])
        assert(ir.live(ordered),
               "spatial.cache could not order a selected contraction")
        changed = true
      }
    }
  }
  if changed {
    opt.dce(m, [])
  }
  return changed
}

[memo]
local fn factor(extent: int, factors: list<int>) -> int {
  var tail = 1
  for candidate in factors {
    if extent > 0 && extent % candidate == 0 {
      return candidate
    }
    if tail == 1 && extent > candidate {
      tail = candidate
    }
  }
  return tail
}

local fn block(
  m: Mod, factors: list<int>, limit: int, bounded: bool
) -> bool {
  assert(len(factors) > 0,
         "spatial.block requires at least one factor")
  for candidate in factors {
    assert(candidate > 1,
           "spatial.block requires factors greater than one")
  }
  let candidates = ir.ops(m)
  var changed = false
  var spent = 0
  for source in candidates {
    if ir.live(source) && ir.kind(source) == "loop" &&
       len(ir.outs(source)) == 1 {
      let state = tile.state_axes(m, source)
      let extents = tile.extents(m, source)
      if len(state) > 0 && len(extents) > len(state) {
        let axis = state[len(state) - 1]
        let selected_factor = factor(extents[axis], factors)
        let full_cost = tile.scalar_cost(m, source, extents[axis])
        var unit = 0
        if full_cost > 0 && extents[axis] > 0 {
          unit = full_cost / extents[axis]
        }
        var fits = unit > 0
        if bounded && fits {
          fits = unit <= (limit - spent) / selected_factor
        }
        if selected_factor > 1 && fits {
          let axes = len(extents)
          var selected = source
          if extents[axis] % selected_factor != 0 {
            let parts = tile.peel(m, source, axis, selected_factor)
            assert(len(parts) == 2,
                   "spatial.block could not peel a selected loop")
            selected = parts[0]
          }
          let split = tile.split(m, selected, axis, selected_factor)
          assert(ir.live(split),
                 "spatial.block could not split a selected loop")
          let next_order = block_order(m, split, 1)
          assert(len(next_order) == axes + 1,
                 "spatial.block could not order a selected tile")
          let reordered = tile.reorder(m, split, next_order)
          assert(ir.live(reordered),
                 "spatial.block could not reorder a selected tile")
          assert(ir.live(tile.scalarize(m, reordered, selected_factor)),
                 "spatial.block could not promote a selected tile")
          if bounded {
            spent += unit * selected_factor
          }
          changed = true
        }
      }
    }
  }
  if changed {
    opt.dce(m, [])
  }
  return changed
}

fn block(m: Mod, factors: list<int>, limit: int) -> bool {
  assert(limit >= 0,
         "spatial.block requires a nonnegative cost limit")
  return block(m, factors, limit, true)
}

fn block(m: Mod, factors: list<int>) -> bool {
  return block(m, factors, 0, false)
}

fn block(m: Mod, factor: int, limit: int) -> bool {
  return block(m, [factor], limit)
}

fn block(m: Mod, factor: int) -> bool {
  return block(m, [factor])
}
