module spatial
use ir
use tile

local fn order() -> list<int> {
  return [0, 1, 4, 5, 6, 2, 3]
}

fn choose(m: Mod, op: Op) -> list<int> {
  let selected = order()
  if ir.kind(op) == "loop" &&
     len(ir.args(op)) - len(ir.outs(op)) == len(selected) &&
     tile.can_reorder(m, op, selected) {
    return selected
  }
  return []
}

fn apply(m: Mod) -> bool {
  return tile.reorder(m, ir.find("spatial.choose"))
}
