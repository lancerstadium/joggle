module spatial
use ir
use tile

local fn order(op: Op, inner: int) -> list<int> {
  let state = tile.state_axes(op)
  let reduction = tile.reduction_axes(op)
  if inner <= 0 || len(state) <= inner || len(reduction) == 0 {
    return []
  }
  var out: list<int> = []
  for i in 0..len(state) - inner {
    out += [state[i]]
  }
  out += reduction
  for i in len(state) - inner..len(state) {
    out += [state[i]]
  }
  return out
}

fn choose(m: Mod, op: Op) -> list<int> {
  let selected = order(op, 2)
  if len(selected) != 0 && tile.can_reorder(m, op, selected) {
    return selected
  }
  return []
}

fn apply(m: Mod) -> bool {
  return tile.reorder(m, ir.find("spatial.choose"))
}
