module spatial
use ir
use tile

local fn order() -> list<int> {
  return [0, 1, 4, 5, 6, 2, 3]
}

fn apply(m: Mod) -> bool {
  var changed = false
  let selected = order()
  for op in ir.ops(m) {
    if ir.live(op) && ir.kind(op) == "loop" &&
       len(ir.args(op)) - len(ir.outs(op)) == len(selected) &&
       tile.can_reorder(m, op, selected) {
      changed = tile.reorder(m, op, selected) || changed
    }
  }
  return changed
}
