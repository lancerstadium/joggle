joggle 1;

mod native_plugin@1.0.0 {
  pub type positive(value: int);

  pub fn source() -> positive<1>;
  pub fn cached(value: int) -> int;
  pub fn cache_probe<N: int>(seed: N, input: positive<@cached(N)>) -> positive<@cached(N)> {
    return input;
  }
  pub fn noop(input: fn) -> fn;
  pub fn reverse(input: bytes) -> bytes;
  pub fn read_model(input: bytes) -> mod;
  pub fn normalize_model(input: mod) -> mod;
  pub fn specialize_model(input: mod) -> mod;
  pub fn reject_model(input: mod) -> mod;
  pub fn emit_model(input: mod) -> bytes;
  pub fn main() -> positive<1> {
    value = source();
    return value;
  }
}
