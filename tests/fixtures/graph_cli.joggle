joggle 1;

module graph_cli@1.0.0 {
  type word();

  fn source<T: type>() -> T;
  fn identity<T: type>(input: T) -> T;
  fn simplify(input: graph) -> graph {
    return rewrite(input) {
      identity($input) => $input;
    };
  }
  fn main() -> word {
    value: word = source();
    result = identity(value);
    return result;
  }
}
