joggle 1;

module function_cli@1.0.0 {
  import behavior_plugin@1;

  fn pipeline(input: bytes) -> bytes {
    return behavior_plugin.reverse(input);
  }
  fn read_model(input: bytes) -> module {
    return behavior_plugin.read_model(input);
  }
  fn optimize_model(input: module) -> module {
    normalized = behavior_plugin.normalize_model(input);
    return behavior_plugin.specialize_model(normalized);
  }
  fn failing_model(input: module) -> module {
    normalized = behavior_plugin.normalize_model(input);
    return behavior_plugin.reject_model(normalized);
  }
  fn emit_model(input: module) -> bytes {
    return behavior_plugin.emit_model(input);
  }
  fn wrong_boundary(input: bytes) -> int {
    return 1;
  }
}
