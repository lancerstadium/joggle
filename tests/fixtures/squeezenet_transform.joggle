joggle 1;

mod squeezenet_transform@1.0.0 {
  import tensor@1 as t;
  import transform@1 as tr;

  fn conv_relu(
    input: t.tensor<f32, [1, 3, 224, 224]>,
    weight: t.tensor<f32, [64, 3, 3, 3]>,
    bias: t.tensor<f32, [64]>
  ) -> t.tensor<f32, [1, 64, 111, 111]> {
    convolved: t.tensor<f32, [1, 64, 111, 111]> = t.conv(
      input, weight, bias, [2, 2], [0, 0, 0, 0], [1, 1], 1
    );
    return t.relu(convolved);
  }

  fn fuse_first(input: mod) -> mod {
    return @tr.replace(
      input,
      (
        value: t.tensor<f32, [1, 3, 224, 224]>,
        weight: t.tensor<f32, [64, 3, 3, 3]>,
        bias: t.tensor<f32, [64]>
      ) -> t.tensor<f32, [1, 64, 111, 111]> => t.relu(t.conv(
        value, weight, bias, [2, 2], [0, 0, 0, 0], [1, 1], 1
      )),
      (
        value: t.tensor<f32, [1, 3, 224, 224]>,
        weight: t.tensor<f32, [64, 3, 3, 3]>,
        bias: t.tensor<f32, [64]>
      ) -> t.tensor<f32, [1, 64, 111, 111]> => conv_relu(
        value, weight, bias
      )
    );
  }
}
