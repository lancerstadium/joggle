mod external@1.0.0 {
  pub type scalar(bits: int);

  pub fn make<N: int>(bits: N) -> scalar<N>;
  pub fn keep<T>(input: T) -> T;
  pub fn converted<T>(input: T) -> T;
  pub fn convert(input: fn) -> fn;
  pub fn main(input: scalar<8>) -> scalar<8> {
    output = keep(input);
    return output;
  }
